<?xml version="1.0"?>
<!DOCTYPE gallery [
  <!NOTATION jpeg PUBLIC "-//IMAGE/JPEG">
  <!NOTATION gif SYSTEM "image/gif">
  <!ENTITY pic1 SYSTEM "a.jpg" NDATA jpeg>
  <!ENTITY pic2 SYSTEM "b.gif" NDATA gif>
  <!ELEMENT gallery (pic)*>
  <!ELEMENT pic EMPTY>
  <!ATTLIST pic ref ENTITY #REQUIRED>
]>
<gallery>
  <pic ref="pic1"/>
  <pic ref="pic2"/>
</gallery>
