<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE note [
  <!ENTITY writer "John Doe">
  <!ENTITY copyright "All rights reserved">
  <!ENTITY content "Detailed entity text expansion payload">
  <!NOTATION png SYSTEM "image/png">
  <!ELEMENT note (to, from, body)>
  <!ELEMENT to (#PCDATA)>
  <!ELEMENT from (#PCDATA)>
  <!ELEMENT body (#PCDATA)>
  <!ATTLIST note category CDATA #IMPLIED>
]>
<note category="reminder">
  <to>Tove</to>
  <from>&writer;</from>
  <body>&content; &copyright;</body>
</note>