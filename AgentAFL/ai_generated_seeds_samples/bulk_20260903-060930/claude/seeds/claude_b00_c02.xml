<?xml version="1.0"?>
<!DOCTYPE catalog SYSTEM "catalog.dtd" [
  <!ELEMENT catalog (item)*>
  <!ELEMENT item EMPTY>
  <!ATTLIST item
    id CDATA #REQUIRED
    type (book|cd|dvd) "book"
    status (active|inactive) #FIXED "active"
  >
  <!ENTITY % items_pe "<!ELEMENT extra (#PCDATA)>">
  %items_pe;
]>
<catalog>
  <item id="1" type="cd"/>
  <item id="2" type="dvd" status="active"/>
  <item id="3"/>
  <extra>Extra content parsed via parameter entity declared element</extra>
  <!-- test conditional-like structure without real conditional section -->
  <item id="4" type="book">
  </item>
</catalog>