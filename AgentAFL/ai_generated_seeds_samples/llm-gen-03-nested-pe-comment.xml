     with special chars: & < > ]]> end -->
<!DOCTYPE r [
  <!ENTITY % c1 "<!-- level 1 comment entity -->">
  <!ENTITY % c2 "%c1;%c1;">
  <!ENTITY % c3 "%c2;%c2;">
  %c3;
  <!ENTITY gent "text &amp; entities &lt;here&gt;">
  <!NOTATION fmt SYSTEM "application/x-fmt">
  <!ELEMENT r (a*)>
  <!ELEMENT a (#PCDATA)>
  <!ATTLIST a
    xmlns:p CDATA #IMPLIED
    xml:lang CDATA #IMPLIED>
]>
<!-- pre-root comment -->
<r xmlns="http://root.ns/" xmlns:q="http://q.ns/">
  <a xmlns:p="http://p.ns/" xml:lang="en">
    <![CDATA[cdata in a with namespace context]]>
    <!-- inner comment -->
    &gent;
  </a>
  <!-- between elements -->
  <?mid-pi?>
  <a xmlns="">
    <![CDATA[default ns unset: ]] double-bracket boundary test]]>
  </a>
  <![CDATA[root-level cdata after child elements]]>
</r>
<?post-pi after root?>
