<archive xmlns="http://example.org/archive" xmlns:atom="http://www.w3.org/2005/Atom">
  <!-- Archive metadata comment -->
  <atom:record>
    <![CDATA[
      CDATA block containing markup <record>&macroEnt;</record>
    ]]>
  </atom:record>
  <record>&ref;</record>
</archive>