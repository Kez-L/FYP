<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE catalog [
  <!ELEMENT catalog (book*)>
  <!ELEMENT book (title, desc)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT desc (#PCDATA)>
  <!ENTITY % param "<!ENTITY gen 'General Entity'>">
  %param;
  <!NOTATION pdf SYSTEM "application/pdf">
  <!ENTITY sample-file SYSTEM "sample.pdf" NDATA pdf>
]>
<?pi-target processing-instruction-data="true"?>
<catalog xmlns="http://example.org/catalog" xmlns:pub="http://example.org/pub" xmlns:xlink="http://www.w3.org/1999/xlink">
  <!-- Root level comment -->
  <book pub:id="b1">
    <title>XML Parsing &gen;</title>
    <desc>
      <![CDATA[
        Detailed description with <tags> and &gen; inside CDATA.
      ]]>
    </desc>
  </book>
</catalog>