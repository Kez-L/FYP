<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE inventory [
  <!ELEMENT inventory (item*)>
  <!ELEMENT item (#PCDATA)>
  <!ENTITY brand "Acme Corp">
  <!ENTITY copyright "Copyright &brand;">
  <!NOTATION png SYSTEM "image/png">
  <!ENTITY logo SYSTEM "logo.png" NDATA png>
  <!ENTITY % remote-decl "<!-- DTD Parameter Entity Comment -->">
  %remote-decl;
]>
<?xml-log level="debug" target="stdout"?>
<inventory xmlns="http://example.com/inv" xmlns:store="http://example.com/store">
  <!-- Pre-item comment block -->
  <store:item code="X-100">
    <![CDATA[
      <store:details>
        Manufacturer: &brand;
      </store:details>
    ]]>
  </store:item>
  <item>&copyright;</item>
</inventory>