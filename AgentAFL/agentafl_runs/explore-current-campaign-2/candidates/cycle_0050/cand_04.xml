<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE document [
  <!ELEMENT document (section*)>
  <!ELEMENT section (paragraph*)>
  <!ELEMENT paragraph (#PCDATA)>
  <!ENTITY sec-title "Section Entity">
  <!ENTITY % entity-macro "<!ENTITY macro-ent 'Macro Text'>">
  %entity-macro;
  <!NOTATION html SYSTEM "text/html">
  <!ENTITY ext-doc SYSTEM "doc.html" NDATA html>
]>
<?xml-stylesheet type="text/css" href="style.css"?>
<document xmlns="http://example.com/doc" xmlns:sec="http://example.com/sec">
  <!-- Document root comment for structure verification -->
  <sec:section id="sec-1">
    <paragraph>
      <![CDATA[
        Paragraph CDATA containing &macro-ent; and markup like <b>bold</b>.
      ]]>
    </paragraph>
    <paragraph>&macro-ent;</paragraph>
  </sec:section>
</document>