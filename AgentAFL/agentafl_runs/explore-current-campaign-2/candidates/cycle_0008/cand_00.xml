<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="transform.xsl"?>
<!DOCTYPE root [
  <!ELEMENT root (child)*>
  <!ELEMENT child (#PCDATA)>
  <!ENTITY % pe " <!ENTITY ent 'parsed-entity-value'> ">
  %pe;
  <!ENTITY ext SYSTEM "nonexistent.ent">
]>
<root xmlns="http://example.com/ns" xmlns:sub="http://example.com/sub">
  <!-- Top level comment covering DTD and namespace interaction -->
  <sub:child>
    <?sub:pi data="processing-instruction-value"?>
    <![CDATA[
      CDATA section containing unparsed markup <tag>&ent;</tag>
    ]]>
  </sub:child>
</root>