<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet href="default.xsl" type="text/xsl"?>
<!DOCTYPE inventory [
  <!ELEMENT inventory (item*)>
  <!ELEMENT item (#PCDATA)>
  <!ENTITY code "A109-B">
  <!ENTITY desc "Standard Inventory Item &code;">
  <!ENTITY % local_override "<!ENTITY code 'OVERRIDDEN'>">
  %local_override;
]>
<inventory xmlns="urn:inventory:base" xmlns:inv="urn:inventory:extension">
  <!-- Inventory header comment -->
  <inv:item>
    <?inv:action log="true"?>
    <![CDATA[
      Internal warehouse logs: &desc;
    ]]>
  </inv:item>
</inventory>