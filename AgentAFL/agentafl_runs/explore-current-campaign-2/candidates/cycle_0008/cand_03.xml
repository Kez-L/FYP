<?xml version="1.0"?>
<?target-pi instruction="init"?>
<!DOCTYPE document [
  <!ELEMENT document (section)*>
  <!ELEMENT section (#PCDATA)>
  <!ENTITY greeting "Hello">
  <!ENTITY targetEntity "&greeting; World!">
  <!ENTITY % dtd-decl "<!ELEMENT section (#PCDATA)>">
  %dtd-decl;
]>
<document xmlns="http://example.org/doc" xmlns:ns="http://example.org/ns">
  <!-- Document level comment with nested entity and namespace test -->
  <ns:section>
    <?ns:pi data="load"?>
    <![CDATA[
      CDATA block executing &targetEntity; checks.
    ]]>
  </ns:section>
</document>