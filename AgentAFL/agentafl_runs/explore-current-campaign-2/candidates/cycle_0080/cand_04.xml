<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE document [
  <!ELEMENT document (section*)>
  <!ELEMENT section (#PCDATA)>
  <!ENTITY base "BaseEntityValue">
  <!ENTITY derived "&base; Extended">
  <!ENTITY % p-macro "<!ENTITY param-ent 'ParameterEntityValue'>">
  %p-macro;
  <!NOTATION txt SYSTEM "text/plain">
  <!ENTITY doc-ext SYSTEM "doc.txt" NDATA txt>
  <?xml-debug level="verbose"?>
]>
<document xmlns="http://doc.org/ns" xmlns:xlink="http://www.w3.org/1999/xlink">
  <!-- Comment before section elements and CDATA -->
  <section xlink:type="simple">
    <?xlink-action load?>
    <![CDATA[
      Complex CDATA with unparsed entities &derived; and &param-ent; blocks.
    ]]>
  </section>
  <section>&derived; and &param-ent;</section>
</document>