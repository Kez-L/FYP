<?xml version="1.0"?>
<!DOCTYPE database [
  <!ELEMENT database (record*)>
  <!ELEMENT record (#PCDATA)>
  <!ENTITY % internal_macro "<!ELEMENT record (#PCDATA | sub)*>">
  %internal_macro;
  <!ELEMENT sub (#PCDATA)>
  <!ENTITY company "ACME Corp &trade;">
  <!ENTITY trade "Trademark">
  <?db-info cache="true" version="2.0"?>
]>
<database xmlns="urn:db" xmlns:xlink="http://www.w3.org/1999/xlink" xlink:type="extended">
  <!-- Database record containing comments and CDATA sections -->
  <record xlink:label="r1">
    <![CDATA[
      CDATA block containing arbitrary data: <record>test</record> &company;
    ]]>
  </record>
  <record>&company; - &trade;</record>
</database>