<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE catalog [
  <!ELEMENT catalog (item+)>
  <!ELEMENT item (#PCDATA)>
  <!ENTITY base "Catalog Item">
  <!ENTITY ref "&base; Reference">
  <!NOTATION pdf SYSTEM "application/pdf">
  <!ENTITY manual SYSTEM "manual.pdf" NDATA pdf>
  <?catalog-control mode="strict" refresh="always"?>
]>
<catalog xmlns="http://example.org/catalog" xmlns:m="http://example.org/meta" m:version="1.0">
  <!-- Catalog section comment -->
  <m:header>
    <?m-action type="validate"?>
    <![CDATA[
      Meta-data section with CDATA: &ref;
    ]]>
  </m:header>
  <item>&ref;</item>
</catalog>