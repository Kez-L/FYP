<?xml version="1.0"?>
<!DOCTYPE database [
  <!ELEMENT database (table*)>
  <!ELEMENT table (#PCDATA)>
  <!ENTITY db-name "ProductionDB">
  <!ENTITY ref-name "&db-name;-Replica">
  <!ENTITY % dtd-macro "<!ENTITY macro-ent 'Macro Value'>">
  %dtd-macro;
]>
<?db-control action="init" mode="safe"?>
<database xmlns="http://example.org/db" xmlns:sql="http://example.org/sql">
  <!-- Database definition and structure comment -->
  <sql:table id="t1">
    <![CDATA[
      SQL Dump &macro-ent; inside CDATA block.
    ]]>
  </sql:table>
  <table name="main">&ref-name;</table>
</database>