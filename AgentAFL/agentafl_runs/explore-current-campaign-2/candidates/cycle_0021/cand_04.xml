  <!ENTITY % ext-macro SYSTEM "http://localhost/external.dtd">
  %ext-macro;
  <?suite-directive action="initialize"?>
]>
<suite xmlns="http://test.org/suite" xmlns:reporter="http://test.org/reporter" xmlns:cfg="http://test.org/cfg">
