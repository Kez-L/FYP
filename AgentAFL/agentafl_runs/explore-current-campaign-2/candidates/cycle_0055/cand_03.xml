<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE archive [
  <!ELEMENT archive (record*)>
  <!ELEMENT record (#PCDATA)>
  <!ENTITY refA "Reference Alpha">
  <!ENTITY refB "&refA; - Reference Beta">
  <!ENTITY % macroDEF "<!ENTITY macroEnt 'Macro-expanded Text'>">
  %macroDEF;
]>
<?xml-stylesheet type="text/css" href="style.css"?>
<archive xmlns="http://schema.example.org/archive" xmlns:meta="http://schema.example.org/meta" xmlns:xlink="http://www.w3.org/1999/xlink">
  <!-- Archival root comment block -->
  <meta:record xlink:type="simple">
    <?meta:action type="verify"?>
    <![CDATA[
      <record>Nested pseudo-xml inside CDATA</record>
    ]]>
  </meta:record>
  <record>&refB; and &macroEnt;</record>
</archive>