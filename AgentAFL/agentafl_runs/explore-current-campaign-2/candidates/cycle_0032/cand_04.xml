<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE config [
  <!ELEMENT config (setting)*>
  <!ELEMENT setting (#PCDATA)>
  <!ENTITY default-val "enabled">
  <!ENTITY override-val "disabled">
  <!NOTATION conf SYSTEM "text/plain">
  <!ENTITY external-conf SYSTEM "config.txt" NDATA conf>
]>
<?xml-app-info name="fuzzer-target" version="1.0"?>
<config xmlns="http://config.org/schema" xmlns:cfg="http://config.org/schema/setting">
  <!-- Configuration block comment with parameters -->
  <cfg:setting name="mode">
    <![CDATA[
      Mode is set via CDATA: <setting>&default-val;</setting>
    ]]>
  </cfg:setting>
  <setting>&override-val;</setting>
</config>