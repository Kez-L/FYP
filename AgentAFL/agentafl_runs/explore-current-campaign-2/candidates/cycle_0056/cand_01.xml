<?xml version="1.0"?>
<!DOCTYPE catalog [
  <!ELEMENT catalog (book*)>
  <!ELEMENT book (#PCDATA)>
  <!ENTITY internal "internal value">
  <!ENTITY % ext_param SYSTEM "http://example.com/dtd">
  %ext_param;
  <!NOTATION png SYSTEM "image/png">
  <!ENTITY logo SYSTEM "logo.png" NDATA png>
]>
<?xml-stylesheet type="text/xsl" href="style.xsl"?>
<catalog xmlns="http://xml.org/catalog" xmlns:xlink="http://www.w3.org/1999/xlink">
  <!-- Comment containing markup-like strings <book>&internal;</book> -->
  <book xlink:type="simple">
    <![CDATA[ Nested CDATA with <tag> and &internal; ]]>
  </book>
</catalog>