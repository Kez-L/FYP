<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE document [
  <!ELEMENT document (section)*>
  <!ELEMENT section (#PCDATA)>
  <!ENTITY ent1 "First entity">
  <!ENTITY ent2 "&ent1; Second entity">
  <!ENTITY % subst "<!ENTITY complex '&ent2; Complex'>">
  %subst;
]>
<?pi-target processing-instruction-data?>
<document xmlns="http://example.org/doc" xmlns:m="http://example.org/meta">
  <!-- Multi-line comment
       spanning several lines
       with entities &ent2; -->
  <m:section>
    <![CDATA[ <p>Unparsed data block</p> ]]>
  </m:section>
  <section>&complex;</section>
</document>