<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE database [
  <!ELEMENT database (record)*>
  <!ELEMENT record (#PCDATA)>
  <!ENTITY % param "<!ENTITY record_ent 'ParamContent'>">
  %param;
  <?db-control action="init"?>
]>
<database xmlns="http://example.org/db" xmlns:xlink="http://www.w3.org/1999/xlink">
  <!-- Comment detailing database schema -->
  <record xlink:type="locator">
    <![CDATA[
      Record data containing entities: &record_ent;
    ]]>
  </record>
  <record>&record_ent;</record>
</database>