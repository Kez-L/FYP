<?xml version="1.0" encoding="ISO-8859-1"?>
<!DOCTYPE doc [
  <!ELEMENT doc ANY>
  <!ENTITY company "Acme Corp">
  <!ENTITY copy "Copyright &company;">
  <?pi-in-dtd processing instruction inside dtd?>
]>
<doc xmlns="http://www.w3.org/1999/xhtml" xmlns:xlink="http://www.w3.org/1999/xlink">
  <!-- Leading comment before PI -->
  <?xml-stylesheet type="text/css" href="print.css"?>
  <div xlink:type="simple">
    <p>
      &copy;
    </p>
    <![CDATA[
      Raw text section with markup-like characters <foo bar="baz"/>
    ]]>
  </div>
</doc>