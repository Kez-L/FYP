<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE library [
  <!ELEMENT library (book)*>
  <!ELEMENT book (#PCDATA)>
  <!ENTITY book-title "XML Parsing Techniques">
  <!ENTITY % local-ent "<!ENTITY author 'Anonymous'>">
  %local-ent;
]>
<?xml-stylesheet type="text/xsl" href="lib.xsl"?>
<library xmlns="http://xml.example.org/lib" xmlns:bib="http://xml.example.org/bib">
  <!-- Library section comment -->
  <bib:book bib:id="b1">
    <![CDATA[
      Book description by &author;: &book-title;
    ]]>
  </bib:book>
</library>