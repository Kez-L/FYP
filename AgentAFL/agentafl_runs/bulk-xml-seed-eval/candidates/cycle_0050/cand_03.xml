<?xml version="1.0"?>
<!DOCTYPE archive [
  <!ELEMENT archive (file)*>
  <!ELEMENT file (#PCDATA)>
  <!ENTITY file-ent "FileEntityContent">
  <!ENTITY % p-ent "<!ENTITY file-param 'ParamContent'>">
  %p-ent;
  <!NOTATION txt SYSTEM "text/plain">
  <!ENTITY raw-ext SYSTEM "data.txt" NDATA txt>
]>
<?xml-debug level="high" mode="verbose"?>
<archive xmlns="http://example.org/archive" xmlns:arc="http://example.org/arc">
  <!-- Archive description comment -->
  <arc:file name="test.txt">
    <![CDATA[
      Content with <brackets> and &file-param; inside CDATA.
    ]]>
    &file-ent;
  </arc:file>
</archive>