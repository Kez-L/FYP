<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE repository [
  <!ELEMENT repository (artifact*)>
  <!ELEMENT artifact (#PCDATA)>
  <!ENTITY art1 "Artifact 1">
  <!ENTITY art2 "&art1; Reference">
  <?repo-sync mode="auto"?>
  <!NOTATION zip SYSTEM "application/zip">
  <!ENTITY bundle SYSTEM "repo.zip" NDATA zip>
  <!ENTITY % paramMacro "<!ATTLIST artifact id ID #IMPLIED>">
  %paramMacro;
]>
<repository xmlns="http://repo.org/schema" xmlns:m="http://repo.org/meta">
  <!-- Repository artifact metadata comment -->
  <artifact id="a1">
    <![CDATA[
      Artifact payload CDATA: &art2; <artifact>
    ]]>
  </artifact>
  <artifact id="a2">&art2;</artifact>
</repository>