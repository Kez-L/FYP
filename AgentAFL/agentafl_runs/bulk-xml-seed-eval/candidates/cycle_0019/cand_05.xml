<?xml version="1.0"?>
<!DOCTYPE registry [
  <!ELEMENT registry (entry*)>
  <!ELEMENT entry (#PCDATA)>
  <!ENTITY val1 "Value One">
  <!ENTITY val2 "&val1; and Value Two">
  <?registry-log level="debug"?>
  <!ENTITY % pEntity "<!ENTITY nestedEntity 'Nested Text'>">
  %pEntity;
]>
<registry xmlns="http://registry.org/ns" xmlns:pub="http://registry.org/pub">
  <!-- Comment inside registry root -->
  <pub:entry>
    <![CDATA[
      CDATA content section: &nestedEntity; &val2;
    ]]>
  </pub:entry>
  <entry>&nestedEntity;</entry>
</registry>