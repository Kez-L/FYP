<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE config [
  <!ELEMENT config (setting)*>
  <!ELEMENT setting (#PCDATA)>
  <!ENTITY setting-val "True">
  <!NOTATION conf-not SYSTEM "config.bin">
  <!ENTITY conf-bin SYSTEM "config.dat" NDATA conf-not>
]>
<?xml-config-pi mode="secure"?>
<config xmlns="http://example.com/config" xmlns:cfg="http://example.com/config/ns">
  <!-- Configuration file comment block -->
  <cfg:setting name="enabled">
    <![CDATA[
      Setting state: &setting-val;
    ]]>
  </cfg:setting>
  <setting>&setting-val;</setting>
</config>