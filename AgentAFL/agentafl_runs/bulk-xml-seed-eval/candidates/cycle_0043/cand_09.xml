<?xml version="1.0"?>
<!DOCTYPE application [
  <!ELEMENT application (module)*>
  <!ELEMENT module (#PCDATA)>
  <!ENTITY mod-name "CoreModule">
  <!ENTITY % pe "<!ENTITY pe-val 'Parameter Entity Text'>">
  %pe;
]>
<?xml-stylesheet type="text/css" href="style.css"?>
<application xmlns="http://example.com/app" xmlns:ui="http://example.com/app/ui">
  <!-- Top-level application comment testing namespaces and entities -->
  <ui:module name="main">
    <![CDATA[
      UI Module CDATA content with reference &mod-name;
    ]]>
  </ui:module>
  <module>&mod-name; - &pe-val;</module>
</application>