<?xml version="1.0"?>
<!DOCTYPE report [
  <!ELEMENT report (summary, details)>
  <!ELEMENT summary (#PCDATA)>
  <!ELEMENT details (#PCDATA)>
  <!ENTITY summaryText "Executive Summary">
  <!ENTITY % detailsMacro "<!ENTITY detailText 'Detailed breakdown of metrics.'>">
  %detailsMacro;
]>
<?xml-metrics cpu="true" memory="true"?>
<report xmlns="http://report.org/ns" xmlns:rep="http://report.org/ns/rep">
  <!-- Annual report top-level comment -->
  <summary>&summaryText;</summary>
  <rep:details>
    <![CDATA[
      &detailText;
      Contains markup symbols: <summary>, &summaryText;, etc.
    ]]>
  </rep:details>
</report>