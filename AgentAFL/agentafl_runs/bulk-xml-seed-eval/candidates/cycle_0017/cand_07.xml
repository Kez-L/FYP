<!DOCTYPE repository [
  <!ELEMENT repository (artifact)*>
  <!ELEMENT artifact (#PCDATA)>
  <!ENTITY % macro-repo "<!ENTITY art-ent 'ArtifactContent'>">
  %macro-repo;
  <!ENTITY ext-repo SYSTEM "artifact.dat">
]>
<?xml-meta author="tester" version="1.0"?>
