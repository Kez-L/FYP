<?xml version="1.0"?>
<!DOCTYPE library [
  <!ELEMENT library (book)*>
  <!ELEMENT book (#PCDATA)>
  <!ENTITY book-ent "BookEntity">
  <!ENTITY % param-ent "<!ENTITY inner-ent 'InnerValue'>">
  %param-ent;
]>
<?xml-stylesheet type="text/xsl" href="lib.xsl"?>
<library xmlns="http://library.example.org" xmlns:lib="http://library.example.org/lib">
  <!-- Comment before books -->
  <lib:book lib:isbn="000-0000000000">
    <![CDATA[
      Book summary with &inner-ent; and &book-ent; inside CDATA.
    ]]>
  </lib:book>
</library>