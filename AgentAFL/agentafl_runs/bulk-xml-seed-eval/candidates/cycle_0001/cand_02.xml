<?xml version="1.0"?>
<!DOCTYPE document [
  <!ELEMENT document (section)*>
  <!ELEMENT section (#PCDATA)>
  <!ENTITY e1 "Value One">
  <!ENTITY e2 "Value Two &e1;">
  <!ENTITY % p "<!ELEMENT section (#PCDATA)>">
  %p;
]>
<?xml-model href="schema.rng" type="application/xml-relax-ng"?>
<document xmlns="urn:test:doc" xmlns:m="urn:test:meta">
  <!-- Comment before complex CDATA block -->
  <m:section m:lang="en">
    <![CDATA[
      Some raw text with nested tags <m:section> &e2; </m:section>
    ]]>
  </m:section>
</document>