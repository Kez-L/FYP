<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE archive [
  <!ELEMENT archive (record)*>
  <!ELEMENT record (#PCDATA)>
  <!ENTITY rec-ent "RecordEntity">
  <!NOTATION pdf SYSTEM "application/pdf">
  <!ENTITY doc-pdf SYSTEM "document.pdf" NDATA pdf>
]>
<?xml-target data="processing-instruction-content"?>
<archive xmlns="http://schema.example.com/archive" xmlns:xlink="http://www.w3.org/1999/xlink">
  <!-- Comprehensive comment block -->
  <record xlink:type="simple" xlink:href="document.pdf">
    <![CDATA[
      CDATA containing &rec-ent; and markup: <record>test</record>
    ]]>
  </record>
</archive>