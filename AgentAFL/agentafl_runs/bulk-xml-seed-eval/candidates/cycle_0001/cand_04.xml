<?xml version="1.0"?>
<!DOCTYPE config [
  <!ELEMENT config (setting)*>
  <!ELEMENT setting (#PCDATA)>
  <!ENTITY sys-ent SYSTEM "file:///etc/hosts">
  <!ENTITY % local-macro "<!ENTITY macro-res 'ExpandedMacro'>">
  %local-macro;
]>
<?xml-stylesheet type="text/css" href="style.css"?>
<config xmlns="http://ns.example.com/config" xmlns:cfg="http://ns.example.com/cfg">
  <!-- Comment verifying entity expansion in CDATA context -->
  <cfg:setting cfg:name="test">
    <![CDATA[
      &sys-ent; and &macro-res; inside CDATA block.
    ]]>
  </cfg:setting>
</config>