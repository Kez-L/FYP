<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE site [
  <!ELEMENT site (page*)>
  <!ELEMENT page (#PCDATA)>
  <!ENTITY % ext-macro "<!ENTITY site-name 'WebSite'>">
  %ext-macro;
  <!ENTITY full-name "The &site-name; Portal">
]>
<?xml-stylesheet href="default.css" type="text/css"?>
<site xmlns="http://example.org/site" xmlns:nav="http://example.org/site/nav">
  <!-- Navigation and site structure comment -->
  <nav:menu>
    <?nav-action target="load"?>
    <![CDATA[
      Navigation CDATA block for &full-name;
    ]]>
  </nav:menu>
  <page>&full-name;</page>
</site>