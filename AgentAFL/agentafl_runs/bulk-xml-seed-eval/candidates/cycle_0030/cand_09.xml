<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE feed [
  <!ELEMENT feed (entry*)>
  <!ELEMENT entry (#PCDATA)>
  <!ENTITY % feed-param "<!ENTITY feed-type 'Atom'>">
  %feed-param;
  <!ENTITY feed-desc "Standard &feed-type; feed">
]>
<?xml-model href="feed-schema.sch" type="application/xml-schematron"?>
<feed xmlns="http://example.org/feed" xmlns:atom="http://example.org/feed/atom">
  <!-- Atom feed comment containing XML-like tags -->
  <atom:entry atom:id="e1">
    <?atom-process step="validate"?>
    <![CDATA[
      Feed CDATA section with description: &feed-desc;
    ]]>
  </atom:entry>
  <entry>&feed-desc;</entry>
</feed>