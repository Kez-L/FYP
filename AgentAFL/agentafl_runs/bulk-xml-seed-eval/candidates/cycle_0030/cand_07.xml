<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE workspace [
  <!ELEMENT workspace (project*)>
  <!ELEMENT project (#PCDATA)>
  <!ENTITY % ws-macro "<!ENTITY ws-name 'WorkspaceEntity'>">
  %ws-macro;
  <?ws-logger active="true"?>
]>
<workspace xmlns="http://example.org/ws" xmlns:t="http://example.org/ws/task">
  <!-- Workspace top-level comment -->
  <t:task t:id="t1">
    <?task-exec mode="async"?>
    <![CDATA[
      Task CDATA block with entity reference &ws-name;
    ]]>
  </t:task>
  <project>&ws-name;</project>
</workspace>