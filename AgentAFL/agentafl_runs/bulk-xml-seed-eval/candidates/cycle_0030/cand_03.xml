<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE inventory [
  <!ELEMENT inventory (product*)>
  <!ELEMENT product (#PCDATA)>
  <!ENTITY prod-ent "Standard Product">
  <!NOTATION jpeg SYSTEM "image/jpeg">
  <!ENTITY banner SYSTEM "banner.jpg" NDATA jpeg>
]>
<?xml-stylesheet type="text/css" href="style.css"?>
<inventory xmlns="http://example.org/inv" xmlns:p="http://example.org/inv/product">
  <!-- Inventory top level comment -->
  <p:product p:code="A01">
    <?inventory-log action="verify"?>
    <![CDATA[
      CDATA details about &prod-ent; and unparsed banner &banner;
    ]]>
  </p:product>
</inventory>