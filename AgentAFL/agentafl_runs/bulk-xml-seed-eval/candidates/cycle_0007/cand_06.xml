<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE config [
  <!ELEMENT config (setting*)>
  <!ELEMENT setting (#PCDATA)>
  <!ENTITY global-setting "Enabled">
  <?config-tool version="2.0"?>
]>
<config xmlns="http://config.org/schema" xmlns:sys="http://config.org/sys">
  <!-- System configuration comment -->
  <sys:setting sys:name="mode">
    <![CDATA[
      Value configuration: &global-setting;
    ]]>
  </sys:setting>
  <setting>&global-setting;</setting>
</config>