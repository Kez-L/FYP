<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE registry [
  <!ELEMENT registry (entry*)>
  <!ELEMENT entry (#PCDATA)>
  <!ENTITY reg-key "SoftwareKey">
  <!ENTITY reg-val "Registry Value &reg-key;">
  <?registry-sync status="syncing"?>
]>
<registry xmlns="http://registry.org/ns" xmlns:reg="http://registry.org/reg">
  <!-- Registry description comment -->
  <reg:entry reg:type="string">
    <![CDATA[
      Raw registry entry data containing &reg-val;
    ]]>
  </reg:entry>
  <entry>&reg-val;</entry>
</registry>