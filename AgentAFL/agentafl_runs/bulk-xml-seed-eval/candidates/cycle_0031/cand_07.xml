<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE notes [
  <!ELEMENT notes (note*)>
  <!ELEMENT note (#PCDATA)>
  <!ENTITY n1 "First Note">
  <!ENTITY n2 "Second Note: &n1;">
  <!ENTITY % core-defs "<!ATTLIST note author CDATA #IMPLIED>">
  %core-defs;
]>
<?note-editor app="vim" version="9.0"?>
<notes xmlns="http://notes.org/ns" xmlns:author="http://notes.org/author" xmlns:date="http://notes.org/date">
  <!-- Archival notes collection comment block -->
  <note author:name="John Doe" date:created="2023-10-01">
    <?date-format pattern="YYYY-MM-DD"?>
    <![CDATA[
      Note content featuring special characters: <tag>, &n2;, and quotes "" ''
    ]]>
    &n2;
  </note>
</notes>