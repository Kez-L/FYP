<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite [
  <!ELEMENT suite (test*)>
  <!ELEMENT test (#PCDATA)>
  <!ENTITY testEnt "TestEntity">
  <!ENTITY % suiteMacro "<!ELEMENT test (#PCDATA)>">
  %suiteMacro;
]>
<?xml-model href="schema.sch" type="application/xml-sch"?>
<suite xmlns="http://example.org/suite" xmlns:runner="http://example.org/runner">
  <!-- Suite-level comment before runner tags -->
  <runner:test>
    <![CDATA[
      <![CDATA[ Nested CDATA simulation ]]>
      &testEnt;
    ]]>
  </runner:test>
</suite>