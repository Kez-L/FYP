<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE forum [
  <!ELEMENT forum (post*)>
  <!ELEMENT post (#PCDATA)>
  <!ENTITY sig "Author Signature">
  <!ENTITY message "Hello World &sig;">
  <!NOTATION html-notation SYSTEM "text/html">
  <!ENTITY html-doc SYSTEM "doc.html" NDATA html-notation>
]>
<?xml-stylesheet type="text/xsl" href="forum.xsl"?>
<forum xmlns="http://xml.org/forum" xmlns:user="http://xml.org/forum/user">
  <!-- Discussion forum XML document with rich features -->
  <?user-pi status="active"?>
  <user:profile>
    <![CDATA[
      User profile CDATA block with entity reference: &message;
    ]]>
  </user:profile>
  <post>&message;</post>
</forum>