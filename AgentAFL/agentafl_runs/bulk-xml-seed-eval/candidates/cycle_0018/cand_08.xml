<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE roadmap [
  <!ELEMENT roadmap (phase*)>
  <!ELEMENT phase (#PCDATA)>
  <!ENTITY phase1 "Planning">
  <!ENTITY phase2 "Execution">
  <!ENTITY phase3 "Review">
  <!ENTITY timeline "&phase1; -> &phase2; -> &phase3;">
  <!ENTITY % dtdMacro "<!ENTITY milestone 'Release Candidate 1'>">
  %dtdMacro;
]>
<?xml-roadmap version="2.0"?>
<roadmap xmlns="http://roadmap.example.com/ns" xmlns:rm="http://roadmap.example.com/ns/rm">
  <!-- Roadmap definition comment block -->
  <rm:phase order="1">
    <![CDATA[
      Phase details:
      - Requirements gathering
      - Architecture design
      - Risk assessment
    ]]>
  </rm:phase>
  <phase>&timeline; : &milestone;</phase>
</roadmap>