<?xml version="1.0"?>
<!DOCTYPE project [
  <!ELEMENT project (module)*>
  <!ELEMENT module (#PCDATA)>
  <!ENTITY mod-name "ProjectModule">
  <!ENTITY full-name "&mod-name; Core">
  <!NOTATION json SYSTEM "application/json">
  <!ENTITY config SYSTEM "conf.json" NDATA json>
]>
<?xml-build tool="make" target="all"?>
<project xmlns="http://project.org/ns" xmlns:m="http://project.org/metadata">
  <!-- Project top-level comment -->
  <module m:level="1">
    <![CDATA[
      Entity reference &full-name; inside CDATA with special chars <>&"'
    ]]>
  </module>
</project>