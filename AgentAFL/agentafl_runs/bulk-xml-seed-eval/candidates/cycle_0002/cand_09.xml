<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE workspace [
  <!ELEMENT workspace (node)*>
  <!ELEMENT node (#PCDATA)>
  <!ENTITY primary "Primary Node">
  <!ENTITY secondary "Secondary &primary;">
  <!ENTITY % dtd-mixin "<!ENTITY mixin-data 'Mixin Value'>">
  %dtd-mixin;
  <!NOTATION ps SYSTEM "application/postscript">
  <!ENTITY ps-file "output.ps" NDATA ps>
]>
<?xml-stylesheet href="workspace.css" type="text/css"?>
<workspace xmlns="http://workspace.org/ns" xmlns:ws="http://workspace.org/ns/ws">
  <!-- Workspace configuration comment block -->
  <ws:node id="ws-1">
    <?ws-action execute="true"?>
    <![CDATA[
      Workspace CDATA payload containing &secondary; and &mixin-data;
    ]]>
  </ws:node>
  <node>&secondary;</node>
</workspace>