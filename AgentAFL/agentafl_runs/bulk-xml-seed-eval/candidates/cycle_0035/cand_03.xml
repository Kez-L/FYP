<?xml version="1.0"?>
<!DOCTYPE inventory [
  <!ELEMENT inventory (product)*>
  <!ELEMENT product (#PCDATA)>
  <!ENTITY prod-a "Alpha">
  <!ENTITY prod-b "Beta &prod-a;">
  <!ENTITY % dtd-decl "<!ATTLIST product code ID #REQUIRED>">
  %dtd-decl;
]>
<?xml-stylesheet href="inventory.css" type="text/css"?>
<inventory xmlns="http://xml.org/inventory" xmlns:ns="http://xml.org/ns">
  <!-- Inventory main container comment -->
  <ns:product code="p1">
    <![CDATA[
      CDATA containing special characters: <, >, &, ', " and entity &prod-b;
    ]]>
  </ns:product>
  <product code="p2">&prod-b;</product>
</inventory>