<?xml version="1.0"?>
<!DOCTYPE portal [
  <!ELEMENT portal (widget)*>
  <!ELEMENT widget (#PCDATA)>
  <!ENTITY w-base "Widget Base">
  <!ENTITY w-ext "Extended &w-base;">
  <!ENTITY % pe-block "<!ENTITY pe-val 'Parameter Entity Content'>">
  %pe-block;
]>
<?xml-params cache="false" timeout="30"?>
<portal xmlns="http://portal.org/ns" xmlns:ui="http://portal.org/ui">
  <!-- Top-level comment describing the widget layout -->
  <ui:widget>
    <![CDATA[
      CDATA section with markup-like strings: <widget id="test">&w-ext;</widget>
    ]]>
  </ui:widget>
  <widget>&pe-val; &w-ext;</widget>
</portal>