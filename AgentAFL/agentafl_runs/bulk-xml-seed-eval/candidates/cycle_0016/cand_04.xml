<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE document [
  <!ELEMENT document (section)*>
  <!ELEMENT section (#PCDATA)>
  <!ENTITY sec-title "Section Title">
  <!ENTITY sec-body "Body text containing &sec-title;">
  <!ENTITY % macro-def "<!ENTITY macro-val 'Macro Value'>">
  %macro-def;
  <?doc-info author="Tester"?>
  <!NOTATION bin SYSTEM "application/octet-stream">
  <!ENTITY raw-data SYSTEM "data.bin" NDATA bin>
]>
<document xmlns="http://example.org/doc" xmlns:ns="http://example.org/ns">
  <!-- Comment block before namespaces and CDATA -->
  <ns:section ns:attr="value">
    <![CDATA[
      <p>HTML-like snippet inside CDATA</p>
    ]]>
    &sec-body;
    &macro-val;
  </ns:section>
</document>