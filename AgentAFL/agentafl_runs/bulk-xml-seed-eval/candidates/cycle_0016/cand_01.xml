<?xml version="1.0"?>
<!DOCTYPE library [
  <!ELEMENT library (book*)>
  <!ELEMENT book (#PCDATA)>
  <!ENTITY auth "Jane Doe">
  <!ENTITY book-ref "&auth;'s Masterpiece">
  <!NOTATION pdf SYSTEM "application/pdf">
  <!ENTITY doc SYSTEM "manual.pdf" NDATA pdf>
  <?book-pi status="active"?>
]>
<library xmlns="http://xml.org/library" xmlns:pub="http://xml.org/publisher">
  <!-- Comment in library root -->
  <pub:book pub:genre="fiction">
    <![CDATA[
      CDATA start
      Some text data inside CDATA section with entities like &book-ref; which are not expanded here.
      CDATA end
    ]]>
    &book-ref;
  </pub:book>
</library>