<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE archive [
  <!ELEMENT archive (record)*>
  <!ELEMENT record (#PCDATA)>
  <!ENTITY r1 "Record One">
  <!ENTITY r2 "Record Two with &r1;">
  <!ENTITY % pe "<!ENTITY pe-val 'Parameter entity string'>">
  %pe;
  <?archive-log level="debug"?>
  <!NOTATION txt SYSTEM "text/plain">
  <!ENTITY notes SYSTEM "notes.txt" NDATA txt>
]>
<archive xmlns="http://example.org/archive" xmlns:meta="http://example.org/meta">
  <!-- Comment on archive structure -->
  <meta:record meta:id="rec-001">
    <![CDATA[
      CDATA block with <xml> markup and &r2; reference.
    ]]>
    &pe-val;
    &r2;
  </meta:record>
</archive>