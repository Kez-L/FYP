<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE catalog [
  <!ELEMENT catalog (item)*>
  <!ELEMENT item (#PCDATA)>
  <!ENTITY % internal-macro "<!ENTITY item-ent 'Expanded via internal parameter'>">
  %internal-macro;
  <!ENTITY base-ent "Base entity value">
  <?catalog-control mode="strict"?>
  <!NOTATION tiff SYSTEM "image/tiff">
  <!ENTITY cover SYSTEM "cover.tiff" NDATA tiff>
]>
<catalog xmlns="http://example.org/catalog" xmlns:xlink="http://www.w3.org/1999/xlink">
  <!-- Comment before complex CDATA and namespaces -->
  <item xlink:type="simple" xlink:href="http://example.org">
    <![CDATA[
      <item-data>
        Nested tags within CDATA: &base-ent;
      </item-data>
    ]]>
    &item-ent;
  </item>
</catalog>