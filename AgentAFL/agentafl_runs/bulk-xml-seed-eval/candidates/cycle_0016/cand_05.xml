<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE inventory [
  <!ELEMENT inventory (stock)*>
  <!ELEMENT stock (#PCDATA)>
  <!ENTITY s1 "Stock item alpha">
  <!ENTITY s2 "Stock item beta: &s1;">
  <!ENTITY % p-ent "<!ENTITY p-res 'Parameter result'>">
  %p-ent;
  <?inventory-mgmt action="audit"?>
  <!NOTATION ps SYSTEM "application/postscript">
  <!ENTITY flyer SYSTEM "flyer.ps" NDATA ps>
]>
<inventory xmlns="http://example.org/inv" xmlns:loc="http://example.org/loc">
  <!-- Inventory comments -->
  <loc:stock loc:warehouse="central">
    <![CDATA[
      Raw inventory log:
      [STATUS] OK
      [ENTITY] &s2;
    ]]>
    &p-res;
  </loc:stock>
</inventory>