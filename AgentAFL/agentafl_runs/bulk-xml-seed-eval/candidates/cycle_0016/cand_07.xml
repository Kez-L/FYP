<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE registry [
  <!ELEMENT registry (entry)*>
  <!ELEMENT entry (#PCDATA)>
  <!ENTITY e-key "Registry Key">
  <!ENTITY e-val "Registry Value for &e-key;">
  <!ENTITY % param-reg "<!ENTITY param-expanded 'Parameter expansion text'>">
  %param-reg;
  <?registry-sync status="pending"?>
  <!NOTATION zip SYSTEM "application/zip">
  <!ENTITY backup SYSTEM "backup.zip" NDATA zip>
]>
<registry xmlns="http://example.org/reg" xmlns:val="http://example.org/val">
  <!-- Comment in registry root -->
  <val:entry val:scope="global">
    <![CDATA[
      [Section]
      Key=&e-val;
    ]]>
    &param-expanded;
  </val:entry>
</registry>