<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE inventory [
  <!ELEMENT inventory (book*)>
  <!ELEMENT book (title, author)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT author (#PCDATA)>
  <!ENTITY b1 "XML Guide">
  <!ENTITY b2 "&b1; Advanced Edition">
  <!ENTITY % extdecl "<!ENTITY authorname 'Jane Doe'>">
  %extdecl;
]>
<?target data?><inventory xmlns="http://example.org/inv" xmlns:lib="http://example.org/lib">
  <!-- Comment section -->
  <lib:book>
    <title>&b2;</title>
    <author>
      <![CDATA[
        Author name: &authorname;
      ]]>
    </author>
  </lib:book>
</inventory>