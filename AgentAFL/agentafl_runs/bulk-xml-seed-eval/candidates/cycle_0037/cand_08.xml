<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE configuration [
  <!ELEMENT configuration (setting*)>
  <!ELEMENT setting (#PCDATA)>
  <!ENTITY host "localhost">
  <!ENTITY port "8080">
  <!ENTITY server "&host;:&port;">
  <!ENTITY % local_def "<!ENTITY timeout '30'>">
  %local_def;
]>
<?xml-params debug="true"?>
<configuration xmlns="http://example.org/config" xmlns:cfg="http://example.org/config/schema">
  <!-- Server configuration comment -->
  <cfg:setting cfg:name="server">&server;</cfg:setting>
  <setting>
    <![CDATA[
      Timeout configuration: &timeout; seconds.
    ]]>
  </setting>
</configuration>