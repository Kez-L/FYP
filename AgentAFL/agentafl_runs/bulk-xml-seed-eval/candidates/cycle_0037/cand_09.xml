<?xml version="1.0"?>
<!DOCTYPE message [
  <!ELEMENT message (header, body)>
  <!ELEMENT header (#PCDATA)>
  <!ELEMENT body (#PCDATA)>
  <!ENTITY sender "System Admin">
  <!ENTITY text "Routine Maintenance">
  <!NOTATION log SYSTEM "text/plain">
  <!ENTITY logfile SYSTEM "sys.log" NDATA log>
]>
<?xml-app run="background"?>
<message xmlns="http://example.com/msg" xmlns:m="http://example.com/msg/meta">
  <!-- Message header comment -->
  <header>&sender;</header>
  <m:body m:priority="high">
    <![CDATA[
      Message body content: &text; with unparsed external log reference.
    ]]>
  </m:body>
</message>