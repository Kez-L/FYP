<?xml version="1.0"?>
<!DOCTYPE database [
  <!ELEMENT database (record*)>
  <!ELEMENT record (#PCDATA)>
  <!ENTITY rec "Default Record">
  <!ENTITY ref "&rec; &rec;">
  <!NOTATION binary SYSTEM "application/octet-stream">
  <!ENTITY blob SYSTEM "data.bin" NDATA binary>
]>
<?xml-stylesheet type="text/css" href="style.css"?>
<database xmlns="http://example.com/db" xmlns:db="http://example.com/db/ext">
  <!-- Database entry comment -->
  <db:record db:id="999">
    <![CDATA[
      Binary pointer reference: &ref; inside CDATA.
    ]]>
  </db:record>
</database>