<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE catalog [
  <!ELEMENT catalog (book)*>
  <!ELEMENT book (title, author)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT author (#PCDATA)>
  <!ENTITY author-default "Anonymous">
  <!ENTITY % ext-sys SYSTEM "external.ent">
  %ext-sys;
]>
<?xml-debug level="verbose"?>
<catalog xmlns="http://schemas.example.org/catalog" xmlns:xlink="http://www.w3.org/1999/xlink">
  <!-- Catalog comment -->
  <book xlink:type="simple">
    <title>
      <![CDATA[ CDATA Title with <tags> & references ]]>
    </title>
    <author>&author-default;</author>
  </book>
</catalog>