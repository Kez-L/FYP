<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE config [
  <!ELEMENT config (setting)*>
  <!ELEMENT setting (#PCDATA)>
  <!ENTITY default-val "enabled">
  <!ENTITY combined "&default-val; and active">
  <!ENTITY % param-macro "<!ENTITY macro-ent 'macro-text'>">
  %param-macro;
]>
<?xml-params mode="test" debug="1"?>
<config xmlns="http://config.org/ns" xmlns:cfg="http://config.org/ns/cfg">
  <!-- Configuration parameters comment -->
  <cfg:setting name="mode">
    <![CDATA[
      CDATA block content: <setting>value</setting> &macro-ent;
    ]]>
  </cfg:setting>
  <setting>&combined;</setting>
</config>