<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite [
  <!ELEMENT suite (test)*>
  <!ELEMENT test (#PCDATA)>
  <!ENTITY pass "SUCCESS">
  <!ENTITY report "Test Status: &pass;">
  <!ENTITY % dtd-snippet "<!ENTITY snippet-ent 'snippet'>">
  %dtd-snippet;
]>
<?xml-log level="info" target="stdout"?>
<suite xmlns="http://test.org/suite" xmlns:t="http://test.org/types">
  <!-- Test suite comment -->
  <t:test id="t1">
    <![CDATA[
      CDATA details for test run &snippet-ent; <br/>
    ]]>
  </t:test>
  <test>&report;</test>
</suite>