<?xml version="1.0"?>
<!DOCTYPE database [
  <!ELEMENT database (record)*>
  <!ELEMENT record (#PCDATA)>
  <!ENTITY % p1 "<!ENTITY ent1 'Entity 1'>">
  <!ENTITY % p2 "<!ENTITY ent2 'Entity 2 &ent1;'>">
  %p1;
  %p2;
]>
<?db-control action="reindex"?>
<database xmlns="http://db.example.org/schema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <!-- Database record entries -->
  <record xsi:nil="false">
    <![CDATA[
      Record content with entity expansion: &ent2;
    ]]>
  </record>
</database>