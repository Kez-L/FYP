<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE document [
  <!ELEMENT document (section)*>
  <!ELEMENT section (#PCDATA)>
  <!ENTITY % paramEntity "<!ELEMENT note (#PCDATA)>">
  %paramEntity;
  <!ENTITY ent "Standard Entity">
]>
<?xml-model href="schema.rng" type="application/xml-relax-ng"?>
<document xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:html="http://www.w3.org/1999/xhtml">
  <!-- Top comment for svg-xhtml wrapper -->
  <section xlink:href="http://example.com">
    &ent;
    <![CDATA[
      Unparsed <HTML> snippet inside SVG/XML mix
    ]]>
  </section>
</document>