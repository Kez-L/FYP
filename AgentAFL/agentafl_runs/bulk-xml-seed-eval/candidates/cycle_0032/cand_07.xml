<?xml version="1.0"?>
<!DOCTYPE config [
  <!ELEMENT config (setting*)>
  <!ELEMENT setting (#PCDATA)>
  <!ENTITY debug-mode "true">
  <!ENTITY timeout "5000">
  <!ENTITY % macro-settings "<!ELEMENT setting EMPTY>">
  %macro-settings;
  <?config-action reload="true"?>
]>
<!-- Configuration File for Parser Testing -->
<config xmlns="http://example.com/config" xmlns:cfg="http://example.com/config/local">
  <cfg:setting name="debug">&debug-mode;</cfg:setting>
  <cfg:setting name="timeout">&timeout;</cfg:setting>
  <setting>
    <![CDATA[
      Raw configuration block with special symbols: <, >, &, ", '
    ]]>
  </setting>
</config>