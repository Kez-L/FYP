<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE catalog [
  <!ELEMENT catalog (item*)>
  <!ELEMENT item (#PCDATA)>
  <!ATTLIST item id ID #REQUIRED>
  <!ENTITY base-ent "Base entity text">
  <!ENTITY complex "&base-ent; extended with &base-ent;">
  <!NOTATION pdf SYSTEM "application/pdf">
  <!ENTITY doc SYSTEM "file.pdf" NDATA pdf>
  <?xml-stylesheet type="text/css" href="style.css"?>
]>
<?pi-target attr="value"?>
<catalog xmlns="http://schemas.example.org/catalog" xmlns:meta="http://schemas.example.org/meta">
  <!-- Nested namespace and entity stress test -->
  <meta:details>
    <![CDATA[
      <!-- CDATA comment-like structure inside -->
      Special chars: <>&"'
    ]]>
  </meta:details>
  <item id="i1">&complex;</item>
</catalog>