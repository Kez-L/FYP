<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE inventory [
  <!ELEMENT inventory (item)*>
  <!ELEMENT item (#PCDATA)>
  <!ATTLIST item code CDATA #REQUIRED>
  <!ENTITY stock "In Stock">
  <!ENTITY out "Out of Stock">
  <?inventory-audit status="pending"?>
]>
<?xml-stylesheet href="inventory.css" type="text/css"?>
<inventory xmlns="http://inventory.org/ns" xmlns:v="http://inventory.org/ns/view">
  <!-- Inventory manifest comment -->
  <v:summary>
    <![CDATA[
      Summary CDATA block: Status is &stock;
    ]]>
  </v:summary>
  <item code="A123">&stock;</item>
  <item code="B456">&out;</item>
</inventory>