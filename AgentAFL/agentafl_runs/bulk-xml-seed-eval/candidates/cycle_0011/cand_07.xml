<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE metrics [
  <!ELEMENT metrics (datapoint)*>
  <!ELEMENT datapoint (#PCDATA)>
  <!ENTITY % metric-macro "<!ENTITY m-ent 'Metric Value'>">
  %metric-macro;
  <?metrics-engine version="2.0"?>
]>
<?xml-stylesheet href="metrics.xsl" type="text/xsl"?>
<metrics xmlns="http://metrics.org/schema" xmlns:m="http://metrics.org/schema/m">
  <!-- Metrics collection comment -->
  <m:datapoint time="12345">
    <![CDATA[
      Raw data: &m-ent; with special characters <>&"'
    ]]>
  </m:datapoint>
  <datapoint>&m-ent;</datapoint>
</metrics>