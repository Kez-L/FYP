<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE document [
  <!ELEMENT document (node)*>
  <!ELEMENT node (#PCDATA)>
  <!ENTITY % ext-macro SYSTEM "external.dtd">
  %ext-macro;
  <!ENTITY alpha "Alpha">
  <!ENTITY beta "&alpha; &gamma;">
  <!ENTITY gamma "Gamma">
  <?xml-debug level="verbose"?>
]>
<?target-action command="execute"?>
<document xmlns="http://xml.example.com/doc" xmlns:ns="http://xml.example.com/ns">
  <!-- Multi-entity reference chain comment -->
  <ns:node>
    <![CDATA[
      CDATA containing entity references: &beta;
    ]]>
  </ns:node>
  <node>&beta;</node>
</document>