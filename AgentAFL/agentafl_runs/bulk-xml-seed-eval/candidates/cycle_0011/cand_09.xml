<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE simulation [
  <!ELEMENT simulation (state)*>
  <!ELEMENT state (#PCDATA)>
  <!ENTITY % sim-param "<!ENTITY state-ent 'Active Simulation State'>">
  %sim-param;
  <!NOTATION bmp SYSTEM "image/bmp">
  <!ENTITY icon SYSTEM "icon.bmp" NDATA bmp>
  <?simulation-runner mode="test"?>
]>
<?xml-stylesheet href="sim.css" type="text/css"?>
<simulation xmlns="http://simulation.org/ns" xmlns:sim="http://simulation.org/ns/sim">
  <!-- Simulation initialization comment -->
  <sim:state id="s0">
    <![CDATA[
      Simulation CDATA trace: <sim:state>&state-ent;</sim:state>
    ]]>
  </sim:state>
  <state>&state-ent;</state>
</simulation>