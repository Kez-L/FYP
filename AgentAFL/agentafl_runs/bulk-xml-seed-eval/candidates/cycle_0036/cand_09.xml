<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE response [
  <!ELEMENT response (payload*)>
  <!ELEMENT payload (#PCDATA)>
  <!ENTITY respEntity "ResponseData">
  <!ENTITY % internalMacro "<!ELEMENT payload (#PCDATA | error)*>">
  %internalMacro;
  <!ELEMENT error (#PCDATA)>
]>
<?xml-log level="debug" target="stdout"?>
<response xmlns="http://example.org/resp" xmlns:soap="http://schemas.xmlsoap.org/soap/envelope/">
  <!-- Comment detailing SOAP-like response structure -->
  <payload soap:encodingStyle="http://schemas.xmlsoap.org/soap/encoding/">
    <![CDATA[
      Raw payload data containing &respEntity; and tags <payload>
    ]]>
    <error>None</error>
  </payload>
  <payload>&respEntity;</payload>
</response>