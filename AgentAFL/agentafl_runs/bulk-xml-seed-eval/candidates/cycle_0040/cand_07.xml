<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE library [
  <!ELEMENT library (book*)>
  <!ELEMENT book (#PCDATA)>
  <!ENTITY bookEnt "The Art of Fuzzing">
  <!ENTITY % bookMacro "<!ATTLIST book isbn CDATA #IMPLIED>">
  %bookMacro;
  <!NOTATION pdf SYSTEM "application/pdf">
  <!ENTITY samplePdf SYSTEM "sample.pdf" NDATA pdf>
  <?xml-stylesheet href="library.css" type="text/css"?>
]>
<!-- Library catalog root comment -->
<library xmlns="http://example.org/library" xmlns:lib="http://example.org/lib" xmlns:xlink="http://www.w3.org/1999/xlink">
  <?lib-action type="index"?>
  <book isbn="978-1-2345-6789-0" xlink:type="simple">
    <![CDATA[
      Book CDATA content with markup: <book>&bookEnt;</book>
    ]]>
  </book>
  <book isbn="978-0-9876-5432-1">&bookEnt;</book>
</library>