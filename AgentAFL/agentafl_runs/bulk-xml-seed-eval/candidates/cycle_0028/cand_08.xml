<?xml version="1.0"?>
<!DOCTYPE configuration [
  <!ELEMENT configuration (setting)*>
  <!ELEMENT setting (#PCDATA)>
  <!ENTITY set-name "Global Configuration">
  <!ENTITY set-val "Enabled">
  <!NOTATION conf-notation SYSTEM "conf/notation">
  <!ENTITY ext-conf SYSTEM "external.conf" NDATA conf-notation>
]>
<?xml-stylesheet href="style.css" type="text/css"?>
<configuration xmlns="http://config.org/ns" xmlns:cfg="http://config.org/ns/settings">
  <!-- Configuration parameters comment -->
  <cfg:setting name="&set-name;">
    <![CDATA[
      Setting status: &set-val;
    ]]>
  </cfg:setting>
</configuration>