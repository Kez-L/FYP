<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE library [
  <!ELEMENT library (book)*>
  <!ELEMENT book (#PCDATA)>
  <!ENTITY book-title "XML Parsing Techniques">
  <!ENTITY book-desc "A comprehensive guide to parsing &book-title; safely.">
]>
<?xml-processing instruction-data="value"?>
<library xmlns="http://library.org/ns" xmlns:lib="http://library.org/ns/meta">
  <!-- Library manifest comment -->
  <lib:book id="b1">
    <![CDATA[
      CDATA description block: &book-desc;
    ]]>
    &book-title;
  </lib:book>
</library>