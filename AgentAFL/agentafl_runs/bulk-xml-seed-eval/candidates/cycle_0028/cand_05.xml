<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE archive [
  <!ELEMENT archive (file)*>
  <!ELEMENT file (#PCDATA)>
  <!ENTITY ref1 "File Reference 1">
  <!ENTITY ref2 "&ref1; and Reference 2">
]>
<?xml-debug level="high" mode="verbose"?>
<archive xmlns="http://archive.org/ns" xmlns:xlink="http://www.w3.org/1999/xlink">
  <!-- Comment explaining archive format -->
  <file xlink:type="locator" xlink:href="http://example.com">
    <![CDATA[
      Archive entry data block with CDATA.
    ]]>
    &ref2;
  </file>
</archive>