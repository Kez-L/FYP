<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE inventory [
  <!ELEMENT inventory (product*)>
  <!ELEMENT product (#PCDATA)>
  <!ENTITY % net_decl "<!ENTITY network 'Local Network'>">
  %net_decl;
  <!ENTITY site "http://example.com">
]>
<?xml-processing-instruction target="compiler" data="optimize=true"?>
<inventory xmlns="http://example.org/inv" xmlns:inv="http://example.org/inv" xmlns:xlink="http://www.w3.org/1999/xlink">
  <!-- Comment about inventory items -->
  <inv:product xlink:href="&site;">
    <![CDATA[
      CD-ROM content &network; with markup <tag/>
    ]]>
  </inv:product>
  <product>&network;</product>
</inventory>