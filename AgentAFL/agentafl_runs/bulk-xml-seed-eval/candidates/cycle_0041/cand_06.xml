<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE notes [
  <!ELEMENT notes (note+)>
  <!ELEMENT note (#PCDATA)>
  <!ENTITY e_alpha "Alpha">
  <!ENTITY e_beta "&e_alpha; Beta">
  <!ENTITY e_gamma "&e_beta; Gamma">
]>
<?xml-stylesheet href="print.xsl" type="text/xsl"?>
<notes xmlns="http://example.org/notes" xmlns:xhtml="http://www.w3.org/1999/xhtml">
  <!-- Comment before notes container -->
  <note>
    <?xhtml-pi action="display"?>
    <![CDATA[
      <![CDATA[ Nested CDATA-like text &e_gamma; ]]>
    ]]>
  </note>
  <note>&e_gamma;</note>
</notes>