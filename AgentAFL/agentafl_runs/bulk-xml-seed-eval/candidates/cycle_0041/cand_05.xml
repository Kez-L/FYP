<?xml version="1.0"?>
<!DOCTYPE config [
  <!ELEMENT config (setting*)>
  <!ELEMENT setting (#PCDATA)>
  <!ENTITY admin "root@localhost">
  <!ENTITY contact "Admin: &admin;">
  <!NOTATION shell SYSTEM "/bin/sh">
  <!ENTITY term SYSTEM "console" NDATA shell>
]>
<?xml-space preserve?>
<config xmlns="http://example.org/config" xmlns:cfg="http://example.org/config">
  <!-- Configuration parameters comment -->
  <cfg:setting name="admin">&contact;</cfg:setting>
  <setting>
    <![CDATA[
      Some raw configuration data: <setting>debug=true</setting>
    ]]>
  </setting>
</config>