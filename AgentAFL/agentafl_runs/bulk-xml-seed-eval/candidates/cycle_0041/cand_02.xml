<?xml version="1.0" encoding="ISO-8859-1"?>
<!DOCTYPE archive [
  <!ELEMENT archive (record+)>
  <!ELEMENT record (#PCDATA)>
  <!ENTITY % param '
    <!ENTITY rec_ent "Record Entity">
    <!NOTATION txt SYSTEM "text/plain">
  '>
  %param;
]>
<?xml-model href="schema.rng" type="application/xml-relax-ng"?>
<archive xmlns="http://example.org/archive" xmlns:dc="http://purl.org/dc/elements/1.1/">
  <!-- Archive description comment -->
  <record dc:identifier="001">
    <![CDATA[
      Raw text data with &rec_ent; inside CDATA.
    ]]>
  </record>
  <record>&rec_ent;</record>
</archive>