<?xml version="1.0"?>
<!DOCTYPE feed [
  <!ELEMENT feed (entry*)>
  <!ELEMENT entry (#PCDATA)>
  <!ENTITY % ext_macro "<!ENTITY ent_ext 'External Extension'>">
  %ext_macro;
  <!NOTATION html SYSTEM "text/html">
  <!ENTITY page SYSTEM "index.html" NDATA html>
]>
<?xml-stylesheet alternate="yes" href="alt.css" type="text/css"?>
<feed xmlns="http://www.w3.org/2005/Atom" xmlns:atom="http://www.w3.org/2005/Atom">
  <!-- Feed items comment -->
  <atom:entry>
    <![CDATA[
      HTML snippet inside CDATA: <div>&ent_ext;</div>
    ]]>
  </atom:entry>
  <entry>&ent_ext;</entry>
</feed>