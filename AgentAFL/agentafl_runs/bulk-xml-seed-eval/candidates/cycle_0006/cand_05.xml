<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE enterprise [
  <!ELEMENT enterprise (department)*>
  <!ELEMENT department (#PCDATA)>
  <!ENTITY corp "Global Corp">
  <!ENTITY branch "&corp; Branch Office">
  <!NOTATION pdf SYSTEM "application/pdf">
  <!ENTITY report SYSTEM "annual.pdf" NDATA pdf>
  <?xml-audit logged="true" user="admin"?>
]>
<!-- Multi-line comment covering enterprise schema validation rules
     and namespace declarations. Ensure all namespaces are processed correctly. -->
<enterprise xmlns="http://enterprise.org/ns" xmlns:hr="http://enterprise.org/ns/hr">
  <hr:department code="HR-01">
    <![CDATA[
      Department details with unparsed entity reference &report; inside CDATA
    ]]>
  </hr:department>
  <department>&branch;</department>
</enterprise>