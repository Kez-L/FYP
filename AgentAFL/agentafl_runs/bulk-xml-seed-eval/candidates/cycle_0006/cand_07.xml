<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE registry [
  <!ELEMENT registry (entry)*>
  <!ELEMENT entry (#PCDATA)>
  <!ENTITY token "RegistryToken2025">
  <!ENTITY secure "&token;-SECURE">
  <?xml-process engine="fast" mode="strict"?>
]>
<!-- Comment before registry element providing security guidelines -->
<registry xmlns="http://registry.xml.net/schema" xmlns:ext="http://registry.xml.net/ext">
  <ext:entry level="1">
    <![CDATA[
      <ext:payload>
        Data payload with entity &secure;
      </ext:payload>
    ]]>
  </ext:entry>
  <entry>&secure;</entry>
</registry>