<?xml version="1.0"?>
<!DOCTYPE portal [
  <!ELEMENT portal (page)*>
  <!ELEMENT page (#PCDATA)>
  <!ENTITY site "WebPortal">
  <!ENTITY welcome "Welcome to &site;!">
  <!NOTATION html SYSTEM "text/html">
  <!ENTITY guide SYSTEM "guide.html" NDATA html>
  <?xml-stylesheet href="portal.css" type="text/css"?>
]>
<!-- Comment describing portal layout and namespace usage -->
<portal xmlns="http://portal.org/ns/main" xmlns:ui="http://portal.org/ns/ui">
  <ui:page name="home">
    <![CDATA[
      UI Page CDATA section containing HTML-like markup: <b>Bold Title</b>
    ]]>
  </ui:page>
  <page>&welcome;</page>
</portal>