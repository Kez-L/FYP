<?xml version="1.0"?>
<!DOCTYPE notes [
  <!ELEMENT notes (note)*>
  <!ELEMENT note (#PCDATA)>
  <!ENTITY greeting "Hello">
  <!ENTITY target "World">
  <!ENTITY message "&greeting;, &target;!">
  <?xml-client action="refresh" interval="30"?>
]>
<!-- Comment detailing notes database configuration -->
<notes xmlns="http://example.net/notes" xmlns:core="http://example.net/core">
  <core:note priority="high">
    <![CDATA[
      CDATA block enclosing markup: <note>Urgent task</note>
    ]]>
  </core:note>
  <note>&message;</note>
</notes>