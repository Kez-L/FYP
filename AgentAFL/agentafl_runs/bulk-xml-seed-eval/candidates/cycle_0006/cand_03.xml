<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE document [
  <!ELEMENT document (section)*>
  <!ELEMENT section (#PCDATA)>
  <!ENTITY % param "<!ENTITY ent_param 'Parameter Entity Expanded'>">
  %param;
  <!ENTITY standard "Standard Entity Value">
  <?xml-stylesheet type="text/css" href="style.css"?>
]>
<!-- Top level comment before document element -->
<document xmlns="http://www.w3.org/1999/xhtml" xmlns:svg="http://www.w3.org/2000/svg">
  <section id="sec1">
    <![CDATA[
      <!-- Nested comment-like string inside CDATA -->
      <svg:svg width="100" height="100">
        <svg:circle cx="50" cy="50" r="40"/>
      </svg:svg>
    ]]>
  </section>
  <section>&ent_param; and &standard;</section>
</document>