<?xml version="1.0"?>
<!DOCTYPE catalog [
  <!ELEMENT catalog (book)*>
  <!ELEMENT book (#PCDATA)>
  <!ATTACHMENT note CDATA #IMPLIED>
  <!ENTITY author "Jane Doe">
  <!ENTITY bio "Author &author; writes technical books.">
  <?pi-target processing instruction data with &entities;?>
]>
<!-- Comprehensive comment for catalog structure -->
<catalog xmlns="http://schemas.example.org/catalog" xmlns:xlink="http://www.w3.org/1999/xlink">
  <book xlink:type="simple" xlink:href="http://example.com/book1">
    <![CDATA[
      Book 1 overview with special characters: <script>alert(1)</script>
    ]]>
  </book>
  <book>&bio;</book>
</catalog>