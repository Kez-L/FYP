<?xml version="1.0"?>
<!DOCTYPE inventory [
  <!ELEMENT inventory (product*)>
  <!ELEMENT product (#PCDATA)>
  <!ATTLIST product sku ID #REQUIRED>
  <!ENTITY e-base "Base">
  <!ENTITY e-ext "&e-base; Extended">
]>
<?xml-debug level="debug"?>
<inventory xmlns="http://example.com/inv" xmlns:store="http://example.com/store">
  <!-- Inventory root comment -->
  <store:product sku="P001">
    <![CDATA[
      CDATA block inside store product.
    ]]>
  </store:product>
  <store:product sku="P002">&e-ext;</store:product>
</inventory>