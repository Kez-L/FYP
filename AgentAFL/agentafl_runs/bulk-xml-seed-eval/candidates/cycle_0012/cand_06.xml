<?xml version="1.0"?>
<!DOCTYPE document [
  <!ELEMENT document (chapter*)>
  <!ELEMENT chapter (#PCDATA)>
  <!ENTITY ref "ReferenceValue">
  <!NOTATION pdf SYSTEM "application/pdf">
  <!ENTITY docfile SYSTEM "doc.pdf" NDATA pdf>
]>
<?pi-name pi-data?>
<document xmlns="http://example.org/ns/doc" xmlns:html="http://www.w3.org/1999/xhtml">
  <!-- Multi-line
       comment block
       with &ref; -->
  <html:chapter>
    <![CDATA[
      <html><body><h1>HTML inside CDATA</h1></body></html>
    ]]>
  </html:chapter>
  <html:chapter>&ref;</html:chapter>
</document>