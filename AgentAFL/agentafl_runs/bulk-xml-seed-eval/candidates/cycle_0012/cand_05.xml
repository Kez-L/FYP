<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE database [
  <!ELEMENT database (record*)>
  <!ELEMENT record (#PCDATA)>
  <!ENTITY % ext-macro SYSTEM "external.dtd">
  %ext-macro;
  <!ENTITY token "SecretToken">
]>
<?xml-stylesheet type="text/css" href="style.css"?>
<database xmlns="http://xml.org/db" xmlns:xlink="http://www.w3.org/1999/xlink">
  <!-- Comment highlighting database state -->
  <record xlink:type="locator">
    <![CDATA[
      Record data containing token: &token;
    ]]>
  </record>
</database>