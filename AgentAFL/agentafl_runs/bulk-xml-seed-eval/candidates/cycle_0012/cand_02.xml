<?xml version="1.0"?>
<!DOCTYPE system [
  <!ELEMENT system (node*)>
  <!ELEMENT node (#PCDATA)>
  <!ENTITY ent1 "First Entity">
  <!ENTITY ent2 "Second &ent1; Entity">
  <!NOTATION txt SYSTEM "text/plain">
  <!ENTITY file SYSTEM "data.txt" NDATA txt>
]>
<?target-pi data-attr="val"?>
<system xmlns="http://xml.org/system" xmlns:ns="http://xml.org/ns">
  <!-- Complex comment with hyphens -- and entities &ent1; -->
  <ns:node>
    <![CDATA[
      <ns:node>Nested markup inside CDATA</ns:node>
    ]]>
  </ns:node>
  <ns:node>&ent2;</ns:node>
</system>