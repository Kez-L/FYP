<?xml version="1.0"?>
<!DOCTYPE config [
  <!ELEMENT config (setting*)>
  <!ELEMENT setting (#PCDATA)>
  <!ENTITY defaultVal "true">
  <!ENTITY % ext_macro "<!ENTITY override 'false'>">
  %ext_macro;
]>
<?config-processor status="active"?>
<config xmlns="http://config.org/schema" xmlns:cfg="http://config.org/schema/sub">
  <!-- Comment: Configuration parameters root -->
  <cfg:setting name="debug">
    <![CDATA[
      <setting active="&defaultVal;">&override;</setting>
    ]]>
  </cfg:setting>
</config>