<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite [
  <!ELEMENT suite (test)*>
  <!ELEMENT test (#PCDATA)>
  <!ENTITY pass "Test Passed">
  <!ENTITY fail "Test Failed">
  <!NOTATION pdf SYSTEM "application/pdf">
  <!ENTITY reportDoc SYSTEM "report.pdf" NDATA pdf>
]>
<?xml-log level="debug" target="stdout"?>
<suite xmlns="http://suite.org/ns" xmlns:qa="http://suite.org/ns/qa">
  <!-- Comment: Quality Assurance Test Suite -->
  <qa:test id="t1">
    <![CDATA[
      Result: &pass; or &fail; depending on execution.
    ]]>
  </qa:test>
  <test>&pass;</test>
</suite>