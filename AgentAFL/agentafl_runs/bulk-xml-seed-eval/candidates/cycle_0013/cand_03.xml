<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE inventory [
  <!ELEMENT inventory (product*)>
  <!ELEMENT product (#PCDATA)>
  <!ENTITY corp "Acme Corp">
  <!ENTITY desc "High quality &corp; product">
  <!NOTATION jpeg SYSTEM "image/jpeg">
  <!ENTITY logo SYSTEM "logo.jpg" NDATA jpeg>
]>
<?xml-stylesheet type="text/css" href="style.css"?>
<inventory xmlns="http://inventory.org/schema" xmlns:inv="http://inventory.org/schema/v2">
  <!-- Comment detailing inventory items -->
  <inv:product id="p1">
    <![CDATA[
      Special characters inside CDATA: <product> &desc; </product>
    ]]>
  </inv:product>
</inventory>