<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE database [
  <!ELEMENT database (table*)>
  <!ELEMENT table (#PCDATA)>
  <!ENTITY dbName "SQLDatabase">
  <!ENTITY fullRef "&dbName; v2.0">
  <!NOTATION sql SYSTEM "text/sql">
  <!ENTITY initScript SYSTEM "init.sql" NDATA sql>
]>
<?db-control action="optimize"?>
<database xmlns="http://db.org/schema" xmlns:sql="http://db.org/sql">
  <!-- Database DTD and entity mapping comment -->
  <sql:table name="users">
    <![CDATA[
      SELECT * FROM users WHERE name = 'test';
    ]]>
  </sql:table>
  <table>&fullRef;</table>
</database>