<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE archive [
  <!ELEMENT archive (record*)>
  <!ELEMENT record (#PCDATA)>
  <!ENTITY base "BaseValue">
  <!ENTITY ref "&base;Extended">
  <!ENTITY % extMacro "<!ENTITY internal 'MacroVal'>">
  %extMacro;
]>
<?xml-stylesheet href="default.css" type="text/css"?>
<archive xmlns="http://archive.org/ns" xmlns:dc="http://purl.org/dc/elements/1.1/">
  <!-- Archive comment explaining structure -->
  <dc:record>
    <![CDATA[
      <!-- Nested comment-like string inside CDATA -->
      <record>Content</record>
    ]]>
  </dc:record>
  <record>&ref; and &internal;</record>
</archive>