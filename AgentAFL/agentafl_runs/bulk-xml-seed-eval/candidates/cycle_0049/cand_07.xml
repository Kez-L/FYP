<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE library [
  <!ELEMENT library (book*)>
  <!ELEMENT book (#PCDATA)>
  <!ENTITY bTitle "XML Parsing Techniques">
  <!ENTITY bAuthor "Jane Doe">
  <!ENTITY % entityDef "<!ENTITY copyright '2023'>">
  %entityDef;
]>
<?xml-meta author="Jane" version="1.0"?>
<library xmlns="http://library.org/ns" xmlns:lib="http://library.org/ns/books">
  <!-- Library catalog description comment -->
  <lib:book id="b1">
    <![CDATA[
      Book summary: &bTitle; by &bAuthor; (&copyright;)
    ]]>
  </lib:book>
  <book>&bTitle;</book>
</library>