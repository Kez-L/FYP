<?xml version="1.0"?>
<!DOCTYPE site [
  <!ELEMENT site (page*)>
  <!ELEMENT page (#PCDATA)>
  <!ENTITY siteTitle "Portal Home">
  <!NOTATION pdf SYSTEM "application/pdf">
  <!ENTITY brochure SYSTEM "brochure.pdf" NDATA pdf>
]>
<?xml-process-instruction step="init"?>
<site xmlns="http://site.org/schema" xmlns:web="http://site.org/web">
  <!-- Top-level site configuration comment -->
  <web:page path="/index.html">
    <![CDATA[
      HTML-like payload inside CDATA: <div class="main">Welcome</div>
    ]]>
  </web:page>
  <page>&siteTitle;</page>
</site>