<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE configuration [
  <!ELEMENT configuration (setting*)>
  <!ELEMENT setting (#PCDATA)>
  <!ENTITY cfgVal "ProductionMode">
  <!ENTITY % nestedMacro "<!ENTITY internalCfg 'SecureToken'>">
  %nestedMacro;
]>
<?cfg-logger level="debug" destination="stdout"?>
<configuration xmlns="http://config.org/ns" xmlns:env="http://config.org/env">
  <!-- Configuration parameters and security tokens comment -->
  <env:setting name="mode">
    <![CDATA[
      Raw configuration block: debug=false; token=&internalCfg;
    ]]>
  </env:setting>
  <setting>&cfgVal;</setting>
</configuration>