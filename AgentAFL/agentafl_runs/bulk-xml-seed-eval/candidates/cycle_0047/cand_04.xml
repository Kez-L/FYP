<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE inventory [
  <!ELEMENT inventory (item*)>
  <!ELEMENT item (#PCDATA)>
  <!ENTITY i1 "ItemAlpha">
  <!ENTITY i2 "&i1; Beta">
  <!ENTITY % extMacro "<!ENTITY i3 'MacroExpanded'>">
  %extMacro;
]>
<?xml-stylesheet type="text/css" href="inventory.css"?>
<inventory xmlns="http://example.org/inv" xmlns:v="http://example.org/v">
  <!-- Inventory header comment -->
  <v:item>
    <![CDATA[
      Inventory notes: &i2; with <v:item> tags.
    ]]>
  </v:item>
  <item>&i3;</item>
</inventory>