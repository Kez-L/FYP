<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE inventory [
  <!ELEMENT inventory (item*)>
  <!ELEMENT item (#PCDATA)>
  <!ENTITY shared "SharedEntity">
  <!ENTITY % pe "<!ENTITY local-pe 'Parameter Entity Value'>">
  %pe;
]>
<?xml-processing-instruction data="value"?>
<inventory xmlns="http://example.com/inv" xmlns:store="http://example.com/store">
  <!-- Inventory root comment -->
  <store:item>
    <![CDATA[
      CDATA block containing &shared; and text.
    ]]>
  </store:item>
  <item>&local-pe;</item>
</inventory>