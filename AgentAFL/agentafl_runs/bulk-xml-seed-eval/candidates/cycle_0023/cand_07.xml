<?xml version="1.0"?>
<!DOCTYPE project [
  <!ELEMENT project (task)*>
  <!ELEMENT task (#PCDATA)>
  <!ENTITY task-ent "TaskContent">
  <!ENTITY % ext-macro "<!ELEMENT subtask (#PCDATA)>">
  %ext-macro;
]>
<?xml-model href="schema.rng" type="application/xml-relax-ng"?>
<project xmlns="http://example.com/proj" xmlns:p="http://example.com/p">
  <!-- Project description comment -->
  <p:subtask>
    <![CDATA[
      Subtask data containing &task-ent; and markup.
    ]]>
  </p:subtask>
  <task>&task-ent;</task>
</project>