<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE database [
  <!ELEMENT database (record)*>
  <!ELEMENT record (#PCDATA)>
  <!ENTITY db-ent "Database Entity">
  <!ENTITY % remote SYSTEM "http://localhost/dtd.dtd">
  %remote;
]>
<?xml-debug level="high" mode="verbose"?>
<database xmlns="http://example.org/db" xmlns:meta="http://example.org/meta">
  <!-- Top level comment block -->
  <meta:info>
    <?meta-pi action="init"?>
    <![CDATA[
      <!-- Nested comment inside CDATA --><record>&db-ent;</record>
    ]]>
  </meta:info>
  <record>&db-ent;</record>
</database>