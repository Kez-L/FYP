<?xml version="1.0"?>
<!DOCTYPE conference [
  <!ELEMENT conference (session)*>
  <!ELEMENT session (#PCDATA)>
  <!ENTITY conf-ent "ConferenceSession">
  <!ENTITY % conf-macro "<!ELEMENT speaker (#PCDATA)>">
  %conf-macro;
]>
<?xml-header version="2.0"?>
<conference xmlns="http://example.com/conf" xmlns:v="http://example.com/venue">
  <!-- Conference schedule comment -->
  <v:speaker>
    <![CDATA[
      Speaker bio with &conf-ent; and <tags>.
    ]]>
  </v:speaker>
  <session>&conf-ent;</session>
</conference>