<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE workspace [
  <!ELEMENT workspace (workspace-item*)>
  <!ELEMENT workspace-item (#PCDATA)>
  <!ENTITY ws-name "Default Workspace">
  <!ENTITY % ws-decl "<!ELEMENT workspace-item (#PCDATA)>">
  %ws-decl;
]>
<?xml-stylesheet type="text/css" href="workspace.css"?>
<workspace xmlns="http://example.com/workspace" xmlns:ws="http://example.com/workspace/ns">
  <!-- Workspace environment variables and layout -->
  <?ws-meta creator="automated-script"?>
  <workspace-item ws:id="item-01">
    <![CDATA[
      Workspace item data: &ws-name; with <workspace-item/> elements.
    ]]>
  </workspace-item>
  <workspace-item>&ws-name;</workspace-item>
</workspace>