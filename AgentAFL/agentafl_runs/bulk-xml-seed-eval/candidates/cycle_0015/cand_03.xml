<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE inventory [
  <!ELEMENT inventory (product*)>
  <!ELEMENT product (#PCDATA)>
  <!ENTITY prod-code "PROD-999">
  <!ENTITY % prod-macro "<!ENTITY prod-desc 'Description for &prod-code;'>">
  %prod-macro;
  <?inventory-audit status="verified"?>
]>
<inventory xmlns="http://inventory.org/ns" xmlns:inv="http://inventory.org/ns/inv">
  <!-- Inventory tracking comment block -->
  <inv:product inv:id="001">
    <![CDATA[
      Product specifications &prod-desc; inside CDATA.
    ]]>
  </inv:product>
  <product>&prod-desc;</product>
</inventory>