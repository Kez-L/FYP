<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE project [
  <!ELEMENT project (task*)>
  <!ELEMENT task (#PCDATA)>
  <!ENTITY task-ent "Task Item">
  <!ENTITY % task-macro "<!ENTITY task-ext 'Extended Task Details'>">
  %task-macro;
  <?project-tracker system="jira"?>
]>
<project xmlns="http://project.org/ns" xmlns:p="http://project.org/ns/p">
  <!-- Project tracking initialization comment -->
  <p:task p:assignee="developer">
    <![CDATA[
      Task CDATA block detailing &task-ext; with markup <p>.
    ]]>
  </p:task>
  <task>&task-ent; : &task-ext;</task>
</project>