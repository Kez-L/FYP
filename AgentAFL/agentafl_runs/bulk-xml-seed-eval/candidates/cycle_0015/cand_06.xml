<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE registry [
  <!ELEMENT registry (entry*)>
  <!ELEMENT entry (#PCDATA)>
  <!ENTITY reg-ent "Registry Item">
  <!ENTITY % reg-macro "<!ENTITY reg-meta 'Metadata Value'>">
  %reg-macro;
  <?registry-config mode="active"?>
]>
<registry xmlns="http://registry.org/ns" xmlns:reg="http://registry.org/ns/meta">
  <!-- Registry comments about security policy -->
  <reg:entry reg:status="valid">
    <![CDATA[
      Registry CDATA block: &reg-meta; <xml-tag>
    ]]>
  </reg:entry>
  <entry>&reg-ent; : &reg-meta;</entry>
</registry>