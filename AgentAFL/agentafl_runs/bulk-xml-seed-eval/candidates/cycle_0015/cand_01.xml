<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE catalog [
  <!ELEMENT catalog (item*)>
  <!ELEMENT item (#PCDATA)>
  <!ENTITY e1 "Value One">
  <!ENTITY e2 "&e1; and Value Two">
  <!ENTITY % param "<!ENTITY e3 'Param Entity Value'>">
  %param;
  <?xml-stylesheet type="text/xsl" href="style.xsl"?>
]>
<catalog xmlns="http://catalog.org/ns" xmlns:xlink="http://www.w3.org/1999/xlink" xlink:type="extended">
  <!-- Dataset Header Comment -->
  <item xlink:type="locator" xlink:href="#item1">
    <![CDATA[
      Some raw CDATA payload with &e3; reference inside.
    ]]>
  </item>
  <item>&e2; and &e3;</item>
</catalog>