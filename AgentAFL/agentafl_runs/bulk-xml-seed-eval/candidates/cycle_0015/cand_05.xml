<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE report [
  <!ELEMENT report (summary*)>
  <!ELEMENT summary (#PCDATA)>
  <!ENTITY sum-ent "Summary Info">
  <!ENTITY % sum-param "<!ENTITY sum-ext 'External Summary'>">
  %sum-param;
  <?report-tool name="generator" version="1.0"?>
]>
<report xmlns="http://report.org/ns" xmlns:rep="http://report.org/ns/rep">
  <!-- Report execution log comment -->
  <rep:summary rep:category="audit">
    <![CDATA[
      Log data: &sum-ext; with <brackets> & ampersands.
    ]]>
  </rep:summary>
  <summary>&sum-ent; - &sum-ext;</summary>
</report>