<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE database [
  <!ELEMENT database (record*)>
  <!ELEMENT record (#PCDATA)>
  <!ENTITY db-ent "Database Record">
  <!ENTITY % db-macro "<!ENTITY db-ext 'External Database Record'>">
  %db-macro;
  <?db-optimizer level="3"?>
]>
<database xmlns="http://database.org/ns" xmlns:db="http://database.org/ns/db">
  <!-- Database layout comment section -->
  <db:record db:index="1">
    <![CDATA[
      Database CDATA payload: &db-ext; [RAW DATA]
    ]]>
  </db:record>
  <record>&db-ent; - &db-ext;</record>
</database>