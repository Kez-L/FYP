<?xml version="1.0"?>
<!DOCTYPE inventory [
  <!ELEMENT inventory (item)*>
  <!ELEMENT item (#PCDATA)>
  <!ENTITY item-code "X-999">
  <!ENTITY full-desc "Item code is &item-code;">
  <!NOTATION pdf SYSTEM "application/pdf">
  <!ENTITY manual SYSTEM "manual.pdf" NDATA pdf>
]>
<?inventory-log level="debug"?>
<inventory xmlns="http://example.org/inv" xmlns:data="http://example.org/inv/data">
  <!-- Inventory tracking comment -->
  <data:record>
    <![CDATA[
      [CDATA block with code: &full-desc;
    ]]>
  </data:record>
  <item>&full-desc;</item>
</inventory>