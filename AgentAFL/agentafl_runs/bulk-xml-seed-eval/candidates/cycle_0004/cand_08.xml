<?xml version="1.0"?>
<!DOCTYPE tree [
  <!ELEMENT tree (branch)*>
  <!ELEMENT branch (#PCDATA)>
  <!ENTITY leaf-ent "LeafNode">
  <!ENTITY tree-ent "Branch &leaf-ent;">
  <!NOTATION txt SYSTEM "text/plain">
  <!ENTITY readme SYSTEM "readme.txt" NDATA txt>
]>
<?tree-render mode="hierarchical"?>
<tree xmlns="http://example.org/tree" xmlns:node="http://example.org/tree/node">
  <!-- Tree structure comment -->
  <node:branch id="b1">
    <![CDATA[
      Data inside CDATA with entity &tree-ent;
    ]]>
  </node:branch>
  <branch>&tree-ent;</branch>
</tree>