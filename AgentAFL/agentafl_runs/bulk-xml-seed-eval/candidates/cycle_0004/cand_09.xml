<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE library [
  <!ELEMENT library (book)*>
  <!ELEMENT book (#PCDATA)>
  <!ENTITY author "John Doe">
  <!ENTITY book-ref "Authored by &author;">
  <!ENTITY % book-macro "<!ELEMENT book (title, author_elem)> <!ELEMENT title (#PCDATA)> <!ELEMENT author_elem (#PCDATA)>">
  %book-macro;
]>
<?library-status open="yes"?>
<library xmlns="http://example.com/library" xmlns:lib="http://example.com/lib">
  <!-- Library catalogue comment block -->
  <lib:book>
    <![CDATA[
      <title>XML Parsing</title>
      <author_elem>&author;</author_elem>
    ]]>
  </lib:book>
  <book>&book-ref;</book>
</library>