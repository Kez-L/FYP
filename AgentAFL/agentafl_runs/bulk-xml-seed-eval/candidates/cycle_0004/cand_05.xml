<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE database [
  <!ELEMENT database (table)*>
  <!ELEMENT table (#PCDATA)>
  <!ENTITY db-name "TestDB">
  <!ENTITY % layout "<!ELEMENT table (row*)> <!ELEMENT row (#PCDATA)>">
  %layout;
]>
<?db-control action="connect"?>
<database xmlns="http://example.com/db" xmlns:sql="http://example.com/sql">
  <!-- Database definition comment -->
  <sql:query>
    <![CDATA[
      SELECT * FROM &db-name;;
    ]]>
  </sql:query>
  <table>&db-name;</table>
</database>