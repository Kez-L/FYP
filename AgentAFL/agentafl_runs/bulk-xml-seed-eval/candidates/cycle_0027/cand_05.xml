<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE inventory [
  <!ELEMENT inventory (item)*>
  <!ELEMENT item (#PCDATA)>
  <!ENTITY ent-a "Apple">
  <!ENTITY ent-b "&ent-a; Banana">
  <!ENTITY ent-c "&ent-b; Cherry">
  <!NOTATION jpeg SYSTEM "image/jpeg">
  <!ENTITY cover "cover.jpg" NDATA jpeg>
  <!ENTITY % decl "<!ATTLIST item category CDATA 'general'>">
  %decl;
]>
<?xml-stylesheet href="inv.xsl" type="text/xsl"?>
<inventory xmlns="http://inventory.org/ns" xmlns:inv="http://inventory.org/ns/inv">
  <!-- Inventory manifest comment block -->
  <inv:item category="fruits">
    <?inv-action type="refresh"?>
    <![CDATA[
      Inventory details: <item>&ent-c;</item>
    ]]>
    &ent-c;
  </inv:item>
</inventory>