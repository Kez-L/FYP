<?xml version="1.0"?>
<!DOCTYPE configuration [
  <!ELEMENT configuration (setting)*>
  <!ELEMENT setting (#PCDATA)>
  <!ENTITY cfg-key "Timeout">
  <!ENTITY cfg-val "30seconds">
  <!ENTITY cfg-combo "&cfg-key; = &cfg-val;">
  <!NOTATION conf SYSTEM "text/plain">
  <!ENTITY cfg-file "config.txt" NDATA conf>
  <!ENTITY % attr-decl "<!ATTLIST setting status CDATA #REQUIRED>">
  %attr-decl;
]>
<?xml-properties version="2.0"?>
<configuration xmlns="http://config.org/ns" xmlns:cfg="http://config.org/ns/cfg">
  <!-- Configuration parameters root comment -->
  <cfg:setting status="active">
    <?cfg-target action="load-config"?>
    <![CDATA[
      Configuration block: <setting>&cfg-combo;</setting>
    ]]>
    &cfg-combo;
  </cfg:setting>
</configuration>