<?xml version="1.0"?>
<!DOCTYPE project [
  <!ELEMENT project (module)*>
  <!ELEMENT module (#PCDATA)>
  <!ENTITY mod-name "CoreModule">
  <!ENTITY % macro-def "<!ENTITY mod-desc 'Module Description'>">
  %macro-def;
  <!NOTATION pdf SYSTEM "application/pdf">
  <!ENTITY manual "manual.pdf" NDATA pdf>
]>
<?xml-log level="info" destination="file"?>
<project xmlns="http://project.org/schema" xmlns:p="http://project.org/schema/p">
  <!-- Project root comment -->
  <p:module name="core">
    <?p-action type="compile"?>
    <![CDATA[
      Module source data: <module>&mod-name; - &mod-desc;</module>
    ]]>
    &mod-name;
    &mod-desc;
  </p:module>
</project>