<?xml version="1.0" encoding="ISO-8859-1"?>
<!DOCTYPE catalog [
  <!ELEMENT catalog (item*)>
  <!ELEMENT item (description)*>
  <!ELEMENT description (#PCDATA)>
  <!ENTITY base-ent "BaseEntity">
  <!ENTITY ref-ent "&base-ent; Extended">
  <!ENTITY % ent-macro "<!ENTITY macro-ent 'MacroValue'>">
  %ent-macro;
  <!NOTATION txt SYSTEM "text/plain">
  <!ENTITY file-sys SYSTEM "data.txt" NDATA txt>
]>
<?xml-model href="schema.rng" type="application/xml-relax-ng"?>
<catalog xmlns="urn:catalog:root" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:dc="http://purl.org/dc/elements/1.1/">
  <!-- Metadata and Entity combination comment -->
  <item xlink:type="simple" xlink:href="http://example.com">
    <description>
      <![CDATA[
        Nested CDATA with special characters: <item>&ref-ent;</item>
      ]]>
      &ref-ent; &macro-ent;
    </description>
  </item>
</catalog>