<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE notes [
  <!ELEMENT notes (note+)>
  <!ELEMENT note (to, from, heading, body)>
  <!ELEMENT to (#PCDATA)>
  <!ELEMENT from (#PCDATA)>
  <!ELEMENT heading (#PCDATA)>
  <!ELEMENT body (#PCDATA)>
  <!ENTITY copy "&#169;">
  <!ENTITY reg "&#174;">
  <!ENTITY trade "&#8482;">
]>
<notes>
  <note>
    <to>Fuzzer Team</to>
    <from>Automation</from>
    <heading>Unicode &amp; Entity Stress Test</heading>
    <body>Testing special symbols: &copy; &reg; &trade; alongside complex markup structures. &lt;script&gt;alert('test');&lt;/script&gt;</body>
  </note>
</notes>