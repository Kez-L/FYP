<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE root [
  <!NOTATION png SYSTEM "image/png">
  <!ENTITY ext-ent SYSTEM "http://localhost/external.ent">
  <!ELEMENT root (data)>
  <!ELEMENT data (#PCDATA)>
  <!ATTLIST data type NOTATION (png) #REQUIRED>
]>
<root>
  <data type="png">Some Data</data>
</root>