<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE root [
  <!ELEMENT root (#PCDATA|child)*>
  <!ELEMENT child (#PCDATA)>
  <!ENTITY base "Entity replacement text">
  <!ENTITY recursive "&base; &base; &base; &base; &base;">
]>
<root>
  <child>&recursive;</child>
  CDATA section test: <![CDATA[ <tag> &amp; unparsed text inside cdata section ]]>
</root>