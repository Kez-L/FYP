<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE catalog [
  <!ELEMENT catalog (book+)>
  <!ELEMENT book (title, author)>
  <!ATTLIST book id ID #REQUIRED>
  <!ENTITY author-entity "Jane Doe">
] >
<catalog xmlns="http://example.org/ns/catalog">
  <book id="b1">
    <title>XML Parsing &amp; Validation</title>
    <author>&author-entity;</author>
  </book>
</catalog>