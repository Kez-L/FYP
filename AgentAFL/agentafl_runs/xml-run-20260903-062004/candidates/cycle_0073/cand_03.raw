<?xml version="1.0" encoding="UTF-8"?>
<soap:Envelope xmlns:soap="http://schemas.xmlsoap.org/soap/envelope/">
  <soap:Header>
    <t:Transaction xmlns:t="http://example.org/ts" soap:mustUnderstand="1">5</t:Transaction>
  </soap:Header>
  <soap:Body>
    <m:GetPrice xmlns:m="http://example.org/stock">
      <m:StockName>ALL</m:StockName>
    </m:GetPrice>
  </soap:Body>
</soap:Envelope>