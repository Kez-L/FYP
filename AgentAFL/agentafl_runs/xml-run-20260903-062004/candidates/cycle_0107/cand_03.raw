<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE inventory [
  <!ELEMENT inventory (item+)>
  <!ELEMENT item (#PCDATA)>
  <!ENTITY store "Central Warehouse">
  <!NOTATION png SYSTEM "image/png">
  <!NOTATION jpg SYSTEM "image/jpeg">
  <!ATTLIST item id ID #REQUIRED>
  <!ATTLIST item cat (hardware|software) "hardware">
]>
<inventory>
  <item id="i1" cat="hardware">Item in &store;</item>
</inventory>