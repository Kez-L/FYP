<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE note [
  <!ENTITY writer "John Doe">
  <!ENTITY copyright "© 2026 XML Consortium">
  <!ENTITY company SYSTEM "https://example.com/company.dtd">
  %company;
]>
<note xmlns="http://example.com/schema" xmlns:author="http://example.com/author">
  <author:name>&writer;</author:name>
  <body xml:lang="en">This document tests entity expansion combined with default namespaces and processing instructions. <?target data?><!-- comment --></body>
  <footer>&copyright;</footer>
</note>