<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE inventory [
  <!ELEMENT inventory (item+)>
  <!ELEMENT item (name, stock)>
  <!ATTLIST item code CDATA #REQUIRED>
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT stock (#PCDATA)>
  <!ENTITY stock_status "In Stock">
]>
<inventory>
  <item code="A-100">
    <name>Widget A</name>
    <stock>&stock_status;</stock>
  </item>
</inventory>