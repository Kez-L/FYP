<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE root [
  <!ELEMENT root (child)>
  <!ELEMENT child (#PCDATA)>
  <!NOTATION png SYSTEM "image/png">
  <!ENTITY pic SYSTEM "image.png" NDATA png>
  <!PI pi-target "processing instruction content">
]>
<root>
  <?pi-target data?>
  <child>Text with &pic;</child>
</root>