<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE doc [
  <!ELEMENT doc (section+)>
  <!ELEMENT section (title, content)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT content (#PCDATA)>
  <!NOTATION png SYSTEM "image/png">
  <!ENTITY logo SYSTEM "logo.png" NDATA png>
  <!ENTITY % internal.ent "INCLUDE">
  <![%internal.ent;[
    <!ENTITY dynamic-text "Expanded via conditional section">
  ]]>
]>
<doc>
  <section>
    <title>Conditional and Entity Test</title>
    <content>&dynamic-text;</content>
  </section>
</doc>