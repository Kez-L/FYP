<?xml version="1.0" encoding="ISO-8859-1"?>
<!DOCTYPE catalog [
  <!ELEMENT catalog (book+)>
  <!ELEMENT book (title, author, price)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT author (#PCDATA)>
  <!ELEMENT price (#PCDATA)>
  <!NOTATION cals SYSTEM "http://www.iso.org/cals">
  <!ENTITY sample-ent "Sample Entity">
  <!_unsupported_decl "test">
]>
<catalog>
  <book>
    <title>&sample-ent;</title>
    <author>Jane Doe</author>
    <price>29.99</price>
  </book>
</catalog>