<?xml version="1.0" encoding="UTF-16"?>
<root xmlns="http://example.com/ns/root"
      xmlns:sub="http://example.com/ns/sub"
      xmlns:xlink="http://www.w3.org/1999/xlink">
    <sub:item xlink:type="simple" xlink:href="http://example.com">
        <sub:name>Test Namespace Item</sub:name>
        <sub:value>12345</sub:value>
    </sub:item>
    <other-item xmlns="">
        <default-ns-child>No namespace here</default-ns-child>
    </other-item>
</root>