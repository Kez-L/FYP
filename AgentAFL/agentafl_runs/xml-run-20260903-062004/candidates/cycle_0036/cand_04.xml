<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE test [
  <!ELEMENT test (note)*>
  <!ELEMENT note (to, from, heading, body)>
  <!ELEMENT to (#PCDATA)>
  <!ELEMENT from (#PCDATA)>
  <!ELEMENT heading (#PCDATA)>
  <!ELEMENT body (#PCDATA)>
  <!ENTITY writer "Tove">
  <!ENTITY viewer "Jani">
  <!ENTITY % parameter-entity "<!ENTITY internal 'internal-value'>">
  %parameter-entity;
]>
<test>
  <note>
    <to>&viewer;</to>
    <from>&writer;</from>
    <heading>Reminder</heading>
    <body>Don't forget the meeting this weekend! &internal;</body>
  </note>
</test>