<?xml version="1.0" encoding="ISO-8859-1"?>
<root xmlns="http://example.org/ns/base"
      xmlns:sub="http://example.org/ns/sub"
      xmlns:xlink="http://www.w3.org/1999/xlink">
  <sub:container xlink:type="simple" xlink:href="http://example.com">
    <sub:item id="i1">Text node with normal content</sub:item>
    <sub:item id="i2">Another node</sub:item>
  </sub:container>
</root>