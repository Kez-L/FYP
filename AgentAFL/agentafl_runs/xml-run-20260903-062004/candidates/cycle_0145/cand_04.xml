<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE inventory [
  <!ELEMENT inventory (item*)>
  <!ELEMENT item EMPTY>
  <!ATTLIST item
    sku CDATA #REQUIRED
    category (hardware|software|service) "hardware"
    stock CDATA #IMPLIED
    barcode ID #IMPLIED>
]>
<inventory>
  <item sku="SKU-001" category="hardware" stock="15"/>
  <item sku="SKU-002" category="software" stock="100"/>
  <item sku="SKU-003" category="service" stock="0"/>
</inventory>