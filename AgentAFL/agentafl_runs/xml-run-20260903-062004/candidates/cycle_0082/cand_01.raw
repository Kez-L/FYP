<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE root [
  <!ELEMENT root (child*)>
  <!ELEMENT child (#PCDATA)>
  <!ATTLIST child id ID #REQUIRED>
  <!NOTATION png SYSTEM "image/png">
  <!ENTITY img-entity SYSTEM "image.png" NDATA png>
]>
<root>
  <child id="id1">First</child>
  <child id="id2">Second</child>
</root>