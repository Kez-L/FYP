<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE map [
  <!ELEMENT map (node*)>
  <!ELEMENT node (key, value, node*)>
  <!ELEMENT key (#PCDATA)>
  <!ELEMENT value (#PCDATA|node)*>
  <!ATTLIST node id ID #IMPLIED ref IDREF #IMPLIED>
]>
<map>
  <node id="root">
    <key>configuration</key>
    <value>
      <node id="child-a">
        <key>mode</key>
        <value>safe</value>
      </node>
      <node id="child-b" ref="child-a">
        <key>alias</key>
        <value>child-a</value>
      </node>
    </value>
    <node>
      <key>empty</key>
      <value/>
    </node>
  </node>
</map>