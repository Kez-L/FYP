<?xml version="1.0"?>
<!DOCTYPE catalog [
  <!ENTITY % common "id ID #REQUIRED status (new|old|archived) 'new'">
  <!ELEMENT catalog ANY>
  <!ELEMENT entry (title, meta?, value*)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT meta EMPTY>
  <!ELEMENT value (#PCDATA|emph|ref)*>
  <!ELEMENT emph (#PCDATA)>
  <!ELEMENT ref EMPTY>
  <!ATTLIST entry %common;>
  <!ATTLIST meta source CDATA #IMPLIED xml:space (default|preserve) "default">
  <!ATTLIST ref target IDREF #REQUIRED>
  <!NOTATION bin SYSTEM "application/octet-stream">
  <!ENTITY payload "A &amp; B &#x1F; C">
]>
<catalog>
  <entry id="e1" status="new">
    <title>Boundary &lt;case&gt;</title>
    <meta source="generated"/>
    <value>left<emph>center</emph>right<ref target="e1"/></value>
    <value>&payload;</value>
  </entry>
</catalog>