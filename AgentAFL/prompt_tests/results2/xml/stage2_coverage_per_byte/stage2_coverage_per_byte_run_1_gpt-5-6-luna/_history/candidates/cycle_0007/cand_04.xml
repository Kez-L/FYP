<?xml version="1.0"?>
<!DOCTYPE batch [
  <!ELEMENT batch (job*)>
  <!ELEMENT job (input, output?)>
  <!ELEMENT input (#PCDATA)>
  <!ELEMENT output (#PCDATA)>
  <!ATTLIST job priority NMTOKEN #IMPLIED enabled (true|false) "true">
]>
<batch>
  <job priority="007" enabled="false">
    <input>file:///tmp/a&amp;b.txt</input>
    <output>ok&#13;&#10;done</output>
  </job>
  <job priority="high">
    <input><![CDATA[&not-an-entity; <payload/>]]></input>
  </job>
  <job enabled="maybe">
    <input>unterminated
</batch>