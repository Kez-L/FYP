<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE map [
  <!ELEMENT map (node*)>
  <!ELEMENT node (key, value|node)*>
  <!ELEMENT key (#PCDATA)>
  <!ELEMENT value (#PCDATA)>
  <!ATTLIST node id ID #IMPLIED ref IDREF #IMPLIED>
]>
<map>
  <node id="root">
    <key>root</key>
    <node id="child" ref="root">
      <key>child</key>
      <value>first</value>
      <value><![CDATA[second]]></value>
    </node>
    <node ref="missing">
      <key>orphan</key>
      <value>5 &lt; 9</value>
    </node>
  </node>
  <node id="leaf"><key>leaf</key></node>
</map>