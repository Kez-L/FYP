<?xml version="1.0"?>
<!DOCTYPE map [
  <!ENTITY % pair "(key, value)">
  <!ELEMENT map (pairset, comment?)>
  <!ELEMENT pairset (pair+)>
  <!ELEMENT pair %pair;>
  <!ELEMENT key (#PCDATA)>
  <!ELEMENT value (#PCDATA|list)*>
  <!ELEMENT list (item*)>
  <!ELEMENT item (#PCDATA)>
  <!ELEMENT comment (#PCDATA)>
  <!ATTLIST pair kind (scalar|compound) "scalar">
  <!ATTLIST item n NMTOKEN #IMPLIED>
]>
<map>
  <pairset>
    <pair kind="scalar">
      <key>path</key>
      <value>/var/tmp</value>
    </pair>
    <pair kind="compound">
      <key>options</key>
      <value>
        <list>
          <item n="0">fast</item>
          <item n="1">safe</item>
          <item n="2"/>
        </list>
      </value>
    </pair>
  </pairset>
  <comment>after the final pair</comment>
</map>