<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE envelope [
  <!ENTITY % common "id ID #IMPLIED role CDATA 'message'">
  <!ELEMENT envelope (meta, payload)>
  <!ELEMENT meta EMPTY>
  <!ATTLIST meta %common;>
  <!ELEMENT payload (#PCDATA|part|link)*>
  <!ELEMENT part (#PCDATA)>
  <!ATTLIST part kind (text|binary|unknown) "text">
  <!ELEMENT link EMPTY>
  <!ATTLIST link href URI #REQUIRED>
]>
<envelope>
  <meta id="m1"/>
  <payload>
    lead
    <part kind="unknown">A&amp;B</part>
    <link href="urn:x:y"/>
    tail
  </payload>
</envelope>