<!DOCTYPE envelope [
  <!ELEMENT envelope (header, body, signature)>
  <!ELEMENT header (sender, recipient, timestamp)>
  <!ELEMENT sender (#PCDATA)>
  <!ELEMENT recipient (#PCDATA)>
  <!ELEMENT timestamp (#PCDATA)>
  <!ELEMENT body ANY>
  <!ELEMENT signature EMPTY>
  <!ATTLIST signature algorithm CDATA #IMPLIED value CDATA #REQUIRED>
]>
<envelope>
  <header>
    <sender>alice@example.invalid</sender>
    <recipient>bob@example.invalid</recipient>
    <timestamp>2026-09-22T12:34:56Z</timestamp>
  </header>
  <body>
    <message priority="high">Use &quot;quoted&quot; text &amp; symbols.</message>
    <attachment type="application/octet-stream"><![CDATA[
      A+B/C== 
    ]]></attachment>
  </body>
  <signature algorithm="none" value=""/>
</envelope>