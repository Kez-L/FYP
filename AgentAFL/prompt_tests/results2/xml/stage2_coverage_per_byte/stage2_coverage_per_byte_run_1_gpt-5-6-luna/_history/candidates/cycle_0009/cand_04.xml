<?xml version="1.0"?>
<!DOCTYPE form [
  <!ELEMENT form (field | group)+>
  <!ELEMENT group (field*)>
  <!ATTLIST group label CDATA #IMPLIED>
  <!ELEMENT field (#PCDATA|option)*>
  <!ATTLIST field name CDATA #REQUIRED kind (text|select|flag) "text" required (true|false) "false">
  <!ELEMENT option (#PCDATA)>
  <!ATTLIST option value CDATA #REQUIRED selected (true|false) "false">
]>
<form>
  <group label="account">
    <field name="user" required="true">alice</field>
    <field name="mode" kind="select">
      <option value="a">A</option>
      <option value="b" selected="true">B &amp; B</option>
    </field>
  </group>
  <field name="enabled" kind="flag">true</field>
  <field name="comment"><![CDATA[unclosed-looking ]]]]><![CDATA[> text]]></field>
</form>