<?xml version="1.0"?>
<!DOCTYPE packet [
  <!ELEMENT packet (preamble?, payload, checksum?)>
  <!ELEMENT preamble (#PCDATA|part)*>
  <!ELEMENT payload (part+)>
  <!ELEMENT part (#PCDATA|part)*>
  <!ELEMENT checksum EMPTY>
  <!ATTLIST packet mode (fast|safe) "safe" xmlns CDATA #IMPLIED>
  <!ATTLIST part index NMTOKEN #REQUIRED compressed (yes|no) #IMPLIED>
  <!ATTLIST checksum algorithm CDATA #REQUIRED value CDATA #REQUIRED>
  <!ENTITY left "[[">
  <!ENTITY right "]]">
]>
