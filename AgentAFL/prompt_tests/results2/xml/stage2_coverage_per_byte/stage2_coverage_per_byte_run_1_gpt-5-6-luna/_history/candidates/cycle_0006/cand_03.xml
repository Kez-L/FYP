  <preamble>start<part index="p0">intro</part>end</preamble>
  <payload>
    <part index="1" compressed="no">alpha<part index="1.1"><![CDATA[&lt;raw&gt;]]></part>omega</part>
    <part index="2" compressed="yes">&left;encoded&right;</part>
  </payload>
  <checksum algorithm="sha256" value=""/>
</packet>