<!DOCTYPE map [
  <!NOTATION jpeg SYSTEM "image/jpeg">
  <!ENTITY logo SYSTEM "logo.jpg" NDATA jpeg>
  <!ELEMENT map (entry+)>
  <!ELEMENT entry (key, value?, ref*)>
  <!ATTLIST entry code ID #REQUIRED>
  <!ELEMENT key (#PCDATA)>
  <!ELEMENT value (#PCDATA)>
  <!ELEMENT ref EMPTY>
  <!ATTLIST ref target IDREF #IMPLIED>
]>
<map>
  <entry code="first">
    <key>one</key>
    <value>1</value>
    <ref target="second"/>
  </entry>
  <entry code="second">
    <key>two</key>
  </entry>
</map>