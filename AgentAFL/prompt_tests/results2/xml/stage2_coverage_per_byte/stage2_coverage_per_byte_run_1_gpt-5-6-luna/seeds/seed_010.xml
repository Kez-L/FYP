<?xml version="1.0"?>
<!DOCTYPE catalog [
  <!ENTITY % common "<!ELEMENT catalog (entry+)><!ELEMENT entry (name,price,meta?)>">
  %common;
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT price (#PCDATA)>
  <!ELEMENT meta EMPTY>
  <!ATTLIST entry
    id ID #REQUIRED
    state (new|used|archived) "new"
    ref IDREF #IMPLIED>
  <!ATTLIST meta
    key CDATA #REQUIRED
    value CDATA #IMPLIED>
  <!NOTATION bin SYSTEM "application/octet-stream">
  <!ENTITY payload SYSTEM "blob.bin" NDATA bin>
]>
<catalog>
  <entry id="a1" state="new">
    <name>alpha &amp; beta</name>
    <price>19.95</price>
    <meta key="source" value="&quot;import&quot;"/>
  </entry>
  <entry id="b2" ref="a1" state="archived">
    <name><![CDATA[delta < epsilon]]></name>
  </entry>
</catalog>