<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE archive [
  <!ENTITY % common "id ID #IMPLIED category NMTOKENS #IMPLIED">
  <!ELEMENT archive (record+, trailer?)>
  <!ELEMENT record (title, body, link*)>
  <!ATTLIST record %common; status (new|held|closed) "new">
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT body (#PCDATA|em|code|br)*>
  <!ELEMENT em (#PCDATA)>
  <!ELEMENT code (#PCDATA)>
  <!ELEMENT br EMPTY>
  <!ELEMENT link EMPTY>
  <!ATTLIST link href URI #REQUIRED rel CDATA "related">
  <!ELEMENT trailer (#PCDATA)>
  <!ENTITY notice "Use &lt;record&gt; elements only.">
]>
<archive>
  <record id="r-7" category="alpha beta" status="held">
    <title>First &amp; Final</title>
    <body>Text <em>with emphasis</em><br/><code>a&lt;b</code>.</body>
    <link href="urn:item:7"/>
  </record>
  <record category="gamma">
    <title>Second</title>
    <body>&notice;</body>
  </record>
  <trailer>done</trailer>
</archive>