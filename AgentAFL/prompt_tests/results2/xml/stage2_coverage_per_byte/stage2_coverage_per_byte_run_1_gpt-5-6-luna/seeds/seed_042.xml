<?xml version="1.0" encoding="ISO-8859-1"?>
<!DOCTYPE message [
  <!ELEMENT message (header, payload)>
  <!ELEMENT header (from, to, subject?)>
  <!ELEMENT from (#PCDATA)>
  <!ELEMENT to (#PCDATA)>
  <!ELEMENT subject (#PCDATA)>
  <!ELEMENT payload (#PCDATA|part)*>
  <!ELEMENT part (#PCDATA)>
  <!ATTLIST part type (text|binary|unknown) "text">
  <!ENTITY quoted "&#34;quoted&#34;">
]>
<message>
  <header>
    <from>sender@example.test</from>
    <to>receiver@example.test</to>
    <subject>&quoted;</subject>
  </header>
  <payload>prefix<part type="text">line one&#x0A;line two</part>suffix</payload>
</message>