<?xml version="1.0"?>
<!DOCTYPE catalog [
  <!ENTITY % flags "enabled">
  <!ELEMENT catalog (entry+, audit?)>
  <!ELEMENT entry (#PCDATA|name|value)*>
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT value EMPTY>
  <!ATTLIST entry id ID #REQUIRED state CDATA "%flags;">
  <!ATTLIST value kind NOTATION (plain|binary) "plain">
  <!NOTATION plain SYSTEM "text/plain">
  <!NOTATION binary SYSTEM "application/octet-stream">
  <![IGNORE[
    <!ELEMENT ignored ANY>
    <!ENTITY ghost "not expanded">
  ]]>
]>
<catalog>
  <entry id="e1"><name>alpha</name>prefix<value kind="plain"/>suffix</entry>
  <entry id="e2" state="disabled"><name>beta</name><value/></entry>
  <audit>created&#xD;&#xA;updated</audit>
</catalog>