<!DOCTYPE envelope [
  <!ELEMENT envelope ANY>
  <!ENTITY left "<part role='open'>">
  <!ENTITY right "</part>">
  <!ENTITY quote "&quot;&apos;&amp;&lt;&gt;">
  <!ENTITY % injected "<!ATTLIST part level CDATA 'implicit'>">
  %injected;
]>
<envelope>
  &left;
  <part level="explicit">inside &quote;</part>
  &right;
  <part><![CDATA[raw ]]> text ]]> trailing</part>
</envelope>