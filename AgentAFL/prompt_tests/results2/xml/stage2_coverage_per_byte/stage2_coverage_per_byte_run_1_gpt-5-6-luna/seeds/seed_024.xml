<?xml version="1.1"?>
<!DOCTYPE package [
  <!ELEMENT package (manifest, data)>
  <!ELEMENT manifest (name, item*)>
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT item EMPTY>
  <!ELEMENT data (blob|text|blob)*>
  <!ELEMENT blob (#PCDATA)>
  <!ELEMENT text (#PCDATA)>
  <!ATTLIST item path CDATA #REQUIRED kind (file|directory) "file" size NMTOKEN #IMPLIED>
  <!ATTLIST blob encoding (hex|base64) #REQUIRED>
]>
<package>
  <manifest>
    <name>sample.pkg</name>
    <item path="bin/run" kind="file" size="12"/>
    <item path="var/cache" kind="directory"/>
    <item path="README" size="0"/>
  </manifest>
  <data>
    <blob encoding="hex">00ff10aa</blob>
    <text>alpha &lt; beta &#13;&#10; gamma</text>
    <blob encoding="base64"><![CDATA[YWJjZA==]]></blob>
  </data>
</package>