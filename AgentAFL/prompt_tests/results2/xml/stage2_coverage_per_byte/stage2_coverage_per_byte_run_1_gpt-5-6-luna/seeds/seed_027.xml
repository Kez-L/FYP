<!DOCTYPE archive [
  <!ELEMENT archive (folder|record|empty)*>
  <!ELEMENT folder (folder|record|empty)*>
  <!ELEMENT record (#PCDATA)>
  <!ELEMENT empty EMPTY>
  <!ATTLIST archive version CDATA "0">
  <!ATTLIST folder name CDATA #REQUIRED level NMTOKEN #IMPLIED>
  <!ATTLIST record key ID #IMPLIED kind (text|binary|unknown) "unknown">
  <!ENTITY quote "&#34;quoted&#34;">
  <!ENTITY nested "&quote; &amp; &#x20;">
]>
<archive version="999999999999999999999999">
  <folder name="root" level="0">
    <folder name="branch-A" level="01">
      <record key="r-a" kind="text">one &nested;</record>
      <empty/>
    </folder>
    <folder name="branch-B">
      <record kind="binary"><![CDATA[00 FF 7F 80]]></record>
      <record>tail</record>
    </folder>
  </folder>
</archive>