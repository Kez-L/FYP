<?xml version="1.0"?>
<!DOCTYPE report [
  <!ELEMENT report (section*)>
  <!ELEMENT section (heading?, entry*)>
  <!ATTLIST section name CDATA #REQUIRED>
  <!ELEMENT heading (#PCDATA)>
  <!ELEMENT entry EMPTY>
  <!ATTLIST entry key CDATA #REQUIRED value CDATA #IMPLIED flag (yes|no) "no">
  <!ENTITY amp "&#38;">
  <!ENTITY nested "left-&amp;-right">
]>
<report>
  <section name="empty"/>
  <section name="metrics">
    <heading>Totals</heading>
    <entry key="count" value="42" flag="yes"/>
    <entry key="ratio" value="0.00"/>
    <entry key="literal" value="&lt;not-an-element&gt;"/>
  </section>
  <section name="mixed">
    <heading>Names &amp; Values</heading>
    <entry key="entity" value="&nested;"/>
  </section>
</report>