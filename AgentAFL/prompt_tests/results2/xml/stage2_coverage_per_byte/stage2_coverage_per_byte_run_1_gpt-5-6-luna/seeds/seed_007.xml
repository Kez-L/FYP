<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE feed [
  <!ELEMENT feed (channel)>
  <!ELEMENT channel (title, link, description, record*)>
  <!ATTLIST channel xml:base URI #IMPLIED>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT link EMPTY>
  <!ATTLIST link href CDATA #REQUIRED rel CDATA "alternate">
  <!ELEMENT description (#PCDATA|em|br)*>
  <!ELEMENT em (#PCDATA)>
  <!ELEMENT br EMPTY>
  <!ELEMENT record (guid, published?, body)>
  <!ELEMENT guid (#PCDATA)>
  <!ATTLIST guid isPermaLink (true|false) "false">
  <!ELEMENT published (#PCDATA)>
  <!ELEMENT body (#PCDATA|em|br|linkref)*>
  <!ELEMENT linkref EMPTY>
  <!ATTLIST linkref href CDATA #REQUIRED>
]>
<feed>
  <channel xml:base="https://example.invalid/root/">
    <title>Signals</title>
    <link href="https://example.invalid/feed" rel="self"/>
    <description>alpha<em>beta</em><br/>gamma</description>
    <record>
      <guid isPermaLink="true">https://example.invalid/items/1</guid>
      <published>2026-01-01T00:00:00+00:00</published>
      <body><![CDATA[start]]><linkref href="urn:x:y"/><em>end</em></body>
    </record>
  </channel>
</feed>