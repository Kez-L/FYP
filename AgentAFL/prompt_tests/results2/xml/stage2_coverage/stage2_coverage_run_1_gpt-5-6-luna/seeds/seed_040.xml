<?xml version="1.0"?>
<!DOCTYPE catalog [
  <!ELEMENT catalog (section+)>
  <!ELEMENT section (heading, item*)>
  <!ELEMENT heading (#PCDATA)>
  <!ELEMENT item (name, price, stock?, description?)>
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT price (#PCDATA)>
  <!ELEMENT stock (#PCDATA)>
  <!ELEMENT description (#PCDATA|em|code|br)*>
  <!ELEMENT em (#PCDATA)>
  <!ELEMENT code (#PCDATA)>
  <!ELEMENT br EMPTY>
  <!ATTLIST section key ID #REQUIRED>
  <!ATTLIST item sku ID #REQUIRED ref IDREFS #IMPLIED>
  <!ENTITY dash "&#x2014;">
  <!ENTITY note "half &dash; price">
]>
<catalog>
  <section key="s1">
    <heading>Hardware</heading>
    <item sku="i1" ref="i2">
      <name>Widget &note;</name>
      <price>19.95</price>
      <stock>7</stock>
      <description>small <em>blue</em> unit<br/>with <code>USB</code> port</description>
    </item>
    <item sku="i2">
      <name>Adapter</name>
      <price>0</price>
      <description>legacy &amp; replacement</description>
    </item>
  </section>
  <section key="s2">
    <heading>Empty section</heading>
  </section>
</catalog>