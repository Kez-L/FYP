<?xml version="1.1"?>
<!DOCTYPE envelope [
  <!ELEMENT envelope (header, payload)>
  <!ELEMENT header (stamp, flag?)>
  <!ELEMENT stamp (#PCDATA)>
  <!ELEMENT flag EMPTY>
  <!ATTLIST flag enabled (yes|no) "yes">
  <!ELEMENT payload (chunk+)>
  <!ELEMENT chunk (#PCDATA|chunk)*>
  <!ATTLIST chunk depth NMTOKEN #IMPLIED>
]>
<envelope xmlns="urn:envelope:main" xmlns:x="urn:envelope:aux">
  <header><stamp>2026-09-22T00:00:00Z</stamp><flag enabled="no"/></header>
  <payload>
    <chunk depth="0">outer<chunk depth="1">inner<chunk>leaf</chunk></chunk></chunk>
  </payload>
</envelope>