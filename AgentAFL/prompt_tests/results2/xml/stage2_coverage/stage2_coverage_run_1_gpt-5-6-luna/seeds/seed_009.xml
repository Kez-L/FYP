<?xml version="1.0"?>
<!DOCTYPE archive [
  <!ELEMENT archive (folder|file|link)*>
  <!ELEMENT folder (folder|file|link)*>
  <!ATTLIST folder name CDATA #REQUIRED hidden (true|false) "false">
  <!ELEMENT file (#PCDATA)>
  <!ATTLIST file name CDATA #REQUIRED size NMTOKEN #IMPLIED mode NMTOKEN #IMPLIED>
  <!ELEMENT link EMPTY>
  <!ATTLIST link name CDATA #REQUIRED target CDATA #REQUIRED>
  <!ENTITY amp "&amp;">
  <!ENTITY quoted "&quot;quoted&quot;">
]>
<archive>
  <folder name=".config" hidden="true">
    <file name="settings.ini" size="00000042" mode="0644">key=value&amp;other=&quot;x&quot;</file>
    <link name="current" target="../latest"/>
  </folder>
  <folder name="empty"/>
  <file name="README&#x2E;txt" mode="0444">
    line-one
    line-two
    &lt;literal&gt;
    &amp;quoted;
  </file>
  <link name="root" target="folder/.config/../"/>
</archive>