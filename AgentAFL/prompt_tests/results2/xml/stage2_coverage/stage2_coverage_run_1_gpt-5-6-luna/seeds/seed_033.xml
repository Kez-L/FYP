<?xml version="1.0"?>
<!DOCTYPE report [
  <!ELEMENT report (header, section+, signature)>
  <!ATTLIST report version NMTOKEN #REQUIRED>
  <!ELEMENT header (subject, timestamp, author)>
  <!ELEMENT subject (#PCDATA)>
  <!ELEMENT timestamp (#PCDATA)>
  <!ELEMENT author (#PCDATA)>
  <!ELEMENT section (heading, paragraph+, table?)>
  <!ATTLIST section code NMTOKEN #REQUIRED>
  <!ELEMENT heading (#PCDATA)>
  <!ELEMENT paragraph (#PCDATA|term|reference|break)*>
  <!ELEMENT term (#PCDATA)>
  <!ATTLIST term id ID #IMPLIED>
  <!ELEMENT reference EMPTY>
  <!ATTLIST reference target IDREF #REQUIRED>
  <!ELEMENT break EMPTY>
  <!ELEMENT table (caption?, row+)>
  <!ELEMENT caption (#PCDATA)>
  <!ELEMENT row (entry+)>
  <!ATTLIST row kind (header|body|total) "body">
  <!ELEMENT entry (#PCDATA|emphasis)*>
  <!ATTLIST entry span NMTOKEN "1">
  <!ELEMENT emphasis (#PCDATA)>
  <!ELEMENT signature (#PCDATA)>
]>
