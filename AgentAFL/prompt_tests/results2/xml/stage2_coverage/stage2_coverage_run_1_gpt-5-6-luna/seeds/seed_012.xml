  <!ELEMENT note (#PCDATA|em|code|link)*>
  <!ELEMENT em (#PCDATA)>
  <!ELEMENT code (#PCDATA)>
  <!ELEMENT link (#PCDATA)>
  <!ATTLIST link href CDATA #REQUIRED>
  <!ENTITY open "<em>">
  <!ENTITY close "</em>">
]>
