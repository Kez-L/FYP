<?xml version="1.0"?>
<!DOCTYPE matrix [
  <!ELEMENT matrix (row+)>
  <!ELEMENT row (cell+)>
  <!ELEMENT cell (#PCDATA)>
  <!ATTLIST matrix
    dimensions NMTOKEN #REQUIRED
    xmlns:q CDATA #IMPLIED>
  <!ATTLIST row
    index NUMBER #IMPLIED
    checksum CDATA #IMPLIED>
  <!ATTLIST cell
    id ID #IMPLIED
    ref IDREF #IMPLIED
    span NMTOKEN "1">
  <!ENTITY nbsp "&#160;">
  <!ENTITY recursive "&recursive;">
]>
<matrix dimensions="2x3" xmlns:q="urn:q">
  <row index="0" checksum="sha256:&nbsp;">
    <cell id="a" span="1">1</cell>
    <cell id="b" ref="a">2 &amp; &lt; 3</cell>
    <cell>4</cell>
  </row>
  <row index="1">
    <cell id="c" ref="missing" span="0">five</cell>
    <cell q:kind="x">six</cell>
  </row>
</matrix>