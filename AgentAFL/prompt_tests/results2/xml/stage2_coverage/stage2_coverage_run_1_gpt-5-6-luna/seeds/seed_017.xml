<?xml version="1.0"?>
<!DOCTYPE report [
  <!ENTITY left "[">
  <!ENTITY right "]">
  <!ELEMENT report (header, data, footer)>
  <!ELEMENT header (field+)>
  <!ELEMENT field (#PCDATA)>
  <!ATTLIST field name CDATA #REQUIRED>
  <!ELEMENT data (row*)>
  <!ELEMENT row (cell+)>
  <!ATTLIST row number NMTOKEN #REQUIRED>
  <!ELEMENT cell (#PCDATA|value)*>
  <!ATTLIST cell kind (text|number|empty) "text">
  <!ELEMENT value (#PCDATA)>
  <!ELEMENT footer (#PCDATA)>
]>
<report>
  <header>
    <field name="source">sensor-7</field>
    <field name="window">2026-09-22T00:00:00Z</field>
  </header>
  <data>
    <row number="01">
      <cell kind="text">alpha &lt; beta</cell>
      <cell kind="number"><value>0042</value></cell>
      <cell kind="empty"/>
    </row>
    <row number="02">
      <cell>line one
line two &#x0A; line three</cell>
      <cell kind="text">&left;literal&right;</cell>
    </row>
  </data>
  <footer>checksum: 7&amp;9</footer>
</report>