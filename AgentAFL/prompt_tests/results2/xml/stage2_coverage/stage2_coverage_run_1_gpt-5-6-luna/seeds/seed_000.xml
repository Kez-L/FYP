<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE catalog [
  <!ELEMENT catalog (section+)>
  <!ELEMENT section (title, item*)>
  <!ATTLIST section code ID #REQUIRED>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT item (#PCDATA|link|note)*>
  <!ATTLIST item ref IDREF #IMPLIED state (new|old|archived) "new">
  <!ELEMENT link EMPTY>
  <!ATTLIST link target CDATA #REQUIRED>
  <!ELEMENT note (#PCDATA)>
  <!ENTITY label "catalog-entry">
]>
<catalog>
  <section code="s-alpha">
    <title>&label; &amp; index</title>
    <item ref="s-alpha" state="old">first<link target="urn:x"/>second<note><![CDATA[a < b && c > d]]></note></item>
  </section>
</catalog>