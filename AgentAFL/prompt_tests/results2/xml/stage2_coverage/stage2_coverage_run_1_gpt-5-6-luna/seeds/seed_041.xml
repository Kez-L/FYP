<?xml version="1.1"?>
<!DOCTYPE ledger [
  <!ELEMENT ledger (account+)>
  <!ELEMENT account (owner, entry+)>
  <!ELEMENT owner (#PCDATA)>
  <!ELEMENT entry EMPTY>
  <!ATTLIST account number NMTOKEN #REQUIRED>
  <!ATTLIST entry
    id ID #REQUIRED
    account IDREF #REQUIRED
    amount CDATA #REQUIRED
    cleared (yes|no) "no">
  <!ENTITY % flags "(cleared|pending)">
  <!ELEMENT marker %flags;>
]>
<ledger>
  <account number="A-001">
    <owner>R&amp;D</owner>
    <entry id="e01" account="A-001" amount="-12.50" cleared="yes"/>
    <entry id="e02" account="A-001" amount="&#x2B;12.50"/>
  </account>
  <account number="A_002">
    <owner>Operations&#x85;Team</owner>
    <entry id="e03" account="missing" amount="NaN" cleared="no"></entry>
    <entry id="e04" account="A_002" amount="1&#x0D;2"/>
  </account>
</ledger>