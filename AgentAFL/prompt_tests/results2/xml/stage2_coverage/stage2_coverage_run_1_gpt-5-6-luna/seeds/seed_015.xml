<?xml version="1.0"?>
<!DOCTYPE catalog [
  <!NOTATION jpeg SYSTEM "image/jpeg">
  <!ENTITY logo SYSTEM "logo.jpg" NDATA jpeg>
  <!ELEMENT catalog (section+)>
  <!ELEMENT section (title, entry*)>
  <!ATTLIST section
    id ID #REQUIRED
    xml:lang NMTOKEN #IMPLIED>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT entry (name, price?, details)>
  <!ATTLIST entry
    sku ID #REQUIRED
    featured (yes|no) "no">
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT price (#PCDATA)>
  <!ELEMENT details (#PCDATA|em|code|br)*>
  <!ELEMENT em (#PCDATA)>
  <!ELEMENT code (#PCDATA)>
  <!ELEMENT br EMPTY>
]>
<catalog>
  <section id="hardware" xml:lang="en">
    <title>Tools &amp; Components</title>
    <entry sku="A-17" featured="yes">
      <name>Socket <em>Delta</em></name>
      <price>19.95</price>
      <details>Fits <code>RX-4</code><br/>Limited batch.</details>
    </entry>
    <entry sku="B-08">
      <name>Washer</name>
      <details>Plain steel</details>
    </entry>
  </section>
</catalog>