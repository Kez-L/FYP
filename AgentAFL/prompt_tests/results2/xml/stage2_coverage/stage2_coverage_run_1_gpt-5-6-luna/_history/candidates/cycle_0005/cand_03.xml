<?xml version="1.0"?>
<!DOCTYPE graph [
  <!ELEMENT graph (vertex*,edge*)>
  <!ELEMENT vertex (caption?,property*)>
  <!ATTLIST vertex ident ID #REQUIRED>
  <!ELEMENT caption (#PCDATA)>
  <!ELEMENT property (#PCDATA|value)*>
  <!ATTLIST property key NMTOKEN #REQUIRED>
  <!ELEMENT value (#PCDATA)>
  <!ELEMENT edge EMPTY>
  <!ATTLIST edge source IDREF #REQUIRED target IDREF #REQUIRED weight CDATA #IMPLIED>
  <!ENTITY nbsp "&#160;">
  <!ENTITY marker "<value>embedded markup</value>">
]>
<graph>
  <vertex ident="v&amp;1">
    <caption>root &nbsp;</caption>
    <property key="color"><value>blue</value></property>
    <property key="raw">&marker;</property>
  </vertex>
  <vertex ident="v2">
    <caption><![CDATA[second vertex]]></caption>
    <property key="tags"><value>one</value><value>two</value></property>
  </vertex>
  <edge source="v1" target="v2" weight="0.00"/>
</graph>