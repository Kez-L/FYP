<?xml version="1.0"?>
<!DOCTYPE form [
  <!ELEMENT form (intro?, choice+, note?)>
  <!ELEMENT intro (#PCDATA|strong|i|br)*>
  <!ELEMENT strong (#PCDATA)>
  <!ELEMENT i (#PCDATA)>
  <!ELEMENT br EMPTY>
  <!ELEMENT choice (caption, option+)>
  <!ATTLIST choice id ID #REQUIRED multiple (true|false) "false">
  <!ELEMENT caption (#PCDATA)>
  <!ELEMENT option (#PCDATA)>
  <!ATTLIST option value CDATA #REQUIRED selected (yes|no) "no">
  <!ELEMENT note (#PCDATA)>
]>
<form>
  <intro>Please select <strong>one</strong><br/>or more items.</intro>
  <choice id="colors" multiple="true">
    <caption>Preferred colors</caption>
    <option value="r" selected="yes">red</option>
    <option value="g">green</option>
    <option value="b" selected="yes">blue</option>
  </choice>
  <choice id="sizes">
    <caption>Size</caption>
    <option value="s">small</option>
    <option value="m" selected="yes">medium</option>
    <option value="l">large</option>
  </choice>
  <note>Use &lt;reset&gt; to clear the form.</note>
</form>