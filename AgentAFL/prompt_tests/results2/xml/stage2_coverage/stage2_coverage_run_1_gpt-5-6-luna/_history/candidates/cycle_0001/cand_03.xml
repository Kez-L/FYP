<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE matrix [
  <!ELEMENT matrix (row+)>
  <!ELEMENT row (cell+)>
  <!ATTLIST row index (zero|one|two) #REQUIRED>
  <!ELEMENT cell (#PCDATA)>
  <!ATTLIST cell x CDATA #IMPLIED y CDATA #IMPLIED kind (text|number|empty) "text">
  <!ENTITY left "[" >
  <!ENTITY right "]" >
]>
<matrix xmlns:m="urn:matrix">
  <row index="zero">
    <cell x="0" y="0" kind="text">&left;alpha&#x20;beta&right;</cell>
    <cell x="1" y="0" kind="number">0007</cell>
  </row>
  <row index="one">
    <cell x="0" y="1" kind="empty"/>
    <cell x="1" y="1"><![CDATA[<not-an-element/>]]></cell>
  </row>
</matrix>