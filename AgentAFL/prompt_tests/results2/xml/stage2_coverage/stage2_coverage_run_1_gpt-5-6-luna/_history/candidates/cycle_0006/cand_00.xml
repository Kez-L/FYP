<?xml version="1.0"?>
<!DOCTYPE library [
  <!ELEMENT library (shelf+)>
  <!ATTLIST library xml:lang NMTOKEN "en">
  <!ELEMENT shelf (book*)>
  <!ATTLIST shelf name CDATA #REQUIRED>
  <!ELEMENT book (title,author,summary?,keyword*)>
  <!ATTLIST book code ID #REQUIRED genre (fiction|essay|poetry) "essay" xml:space (default|preserve) "default">
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT author (#PCDATA)>
  <!ELEMENT summary (#PCDATA|strong|quote)*>
  <!ELEMENT strong (#PCDATA)>
  <!ELEMENT quote (#PCDATA)>
  <!ELEMENT keyword (#PCDATA)>
  <!ENTITY imprint "North &amp; River">
  <!ENTITY year "2026">
]>
<library xmlns="urn:archive:library" xmlns:meta="urn:archive:metadata" xml:lang="en-GB">
  <shelf name="special-collections">
    <book code="b001" genre="poetry" xml:space="preserve">
      <title>Signals &amp; Silences</title>
      <author xml:lang="fr">Élise Martin</author>
      <summary>A record from &imprint; published in &year;.
        <strong>Annotated</strong>
        <quote>“Between lines”</quote>
      </summary>
      <keyword>epistolary</keyword>
      <keyword>rare</keyword>
    </book>
  </shelf>
  <shelf name="new-arrivals">
    <book code="b002">
      <title>Geometry of Rain</title>
      <author><meta:name>R. Chen</meta:name></author>
    </book>
  </shelf>
</library>