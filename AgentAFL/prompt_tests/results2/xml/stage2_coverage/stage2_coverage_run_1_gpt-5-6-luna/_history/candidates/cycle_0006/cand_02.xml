<?xml version="1.1" standalone="yes"?>
<!DOCTYPE ledger [
  <!ELEMENT ledger (account+)>
  <!ATTLIST ledger currency (EUR|JPY|USD) "USD">
  <!ELEMENT account (owner, note?, transaction*)>
  <!ATTLIST account number ID #REQUIRED links IDREFS #IMPLIED>
  <!ELEMENT owner (#PCDATA)>
  <!ELEMENT note (#PCDATA|mark)*>
  <!ELEMENT mark (#PCDATA)>
  <!ELEMENT transaction EMPTY>
  <!ATTLIST transaction id ID #REQUIRED
            kind (credit|debit|transfer) #REQUIRED
            amount NMTOKEN #REQUIRED
            from IDREF #IMPLIED
            to IDREF #IMPLIED>
]>
<ledger xmlns="urn:finance:ledger" currency="JPY">
  <account number="acct-main" links="acct-savings acct-vault">
    <owner>東京営業所</owner>
    <note>Review&nbsp;<mark>quarterly</mark>&#x85; records.</note>
    <transaction id="tx-1" kind="credit" amount="100000" to="acct-main"/>
    <transaction id="tx-2" kind="transfer" amount="2500" from="acct-main" to="acct-savings"/>
  </account>
  <account number="acct-savings">
    <owner>Zoë &amp; 李</owner>
    <transaction id="tx-3" kind="debit" amount="700" from="acct-savings"/>
  </account>
  <account number="acct-vault">
    <owner>vault</owner>
  </account>
</ledger>