<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE workspace [
  <!ELEMENT workspace (folder|file|shortcut)*>
  <!ELEMENT folder (folder|file|shortcut)*>
  <!ELEMENT file EMPTY>
  <!ELEMENT shortcut EMPTY>
  <!ATTLIST workspace
    xmlns:meta CDATA #IMPLIED
    profile (minimal|full) "full">
  <!ATTLIST folder
    name CDATA #REQUIRED
    open (true|false) "true">
  <!ATTLIST file
    id ID #REQUIRED
    name CDATA #REQUIRED
    checksum CDATA #IMPLIED
    owner IDREF #IMPLIED
    flags NMTOKENS #IMPLIED>
  <!ATTLIST shortcut
    target IDREF #REQUIRED
    label CDATA #IMPLIED>
  <!ENTITY left "&lt;">
  <!ENTITY right "&gt;">
  <!ENTITY % optional "INCLUDE">
  <![%optional;[
    <!ATTLIST file executable (yes|no) "no">
  ]]>
]>
<workspace xmlns:meta="urn:meta" profile="full">
  <folder name="src" open="true">
    <file id="f-1" name="main&amp;test.c" owner="f-2" flags="read write" executable="yes"/>
    <folder name="nested" open="false">
      <file id="f-2" name="helper.h" checksum="&left;abc&right;" executable="no"/>
      <shortcut target="f-1" label="entry point"/>
    </folder>
  </folder>
  <file id="f-3" name="README.txt" flags="read"/>
</workspace>