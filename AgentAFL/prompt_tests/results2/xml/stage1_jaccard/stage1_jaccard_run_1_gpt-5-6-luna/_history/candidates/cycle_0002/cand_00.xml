<?xml version="1.0"?>
<!DOCTYPE archive [
  <!ENTITY % common "<!ELEMENT record (title, body, link?)>">
  %common;
  <!ELEMENT archive (record+)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT body (#PCDATA|em|br)*>
  <!ELEMENT em (#PCDATA)>
  <!ELEMENT br EMPTY>
  <!ELEMENT link EMPTY>
  <!ATTLIST record key ID #REQUIRED status (draft|final) "draft">
  <!ATTLIST link href CDATA #REQUIRED>
  <!ENTITY copyright "&#169; 2026">
]>
<archive>
  <record key="r001" status="final">
    <title>Quarterly &copyright;</title>
    <body>Plain <em>emphasis</em><br/>continued text.</body>
    <link href="urn:record:r001"/>
  </record>
  <record key="r002">
    <title>Second entry</title>
    <body>Words and symbols: &lt; &amp; &gt;.</body>
  </record>
</archive>