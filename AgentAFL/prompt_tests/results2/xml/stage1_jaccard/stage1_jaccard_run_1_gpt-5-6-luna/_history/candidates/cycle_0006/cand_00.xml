<?xml version="1.0"?>
<!DOCTYPE catalog [
  <!NOTATION gif SYSTEM "image/gif">
  <!ENTITY logo SYSTEM "logo.gif" NDATA gif>
  <!ELEMENT catalog (item*, note?)>
  <!ELEMENT item EMPTY>
  <!ATTLIST item
    id ID #REQUIRED
    ref IDREFS #IMPLIED
    media ENTITY #IMPLIED
    enabled (yes|no) "yes">
  <!ELEMENT note (#PCDATA)>
]>
<catalog>
  <item id="first" ref="second third" media="logo"/>
  <item id="second" enabled="no"/>
  <item id="third"/>
  <note>catalog-end</note>
</catalog>