<?xml version="1.1"?>
<!DOCTYPE catalog [
  <!ELEMENT catalog (record*)>
  <!ELEMENT record (label, data?, link*)>
  <!ATTLIST record code ID #REQUIRED state (new|old|void) #IMPLIED>
  <!ELEMENT label (#PCDATA)>
  <!ELEMENT data ANY>
  <!ELEMENT link EMPTY>
  <!ATTLIST link rel CDATA #REQUIRED destination CDATA #REQUIRED>
  <!ENTITY left "&lt;&lt;">
  <!ENTITY right "&gt;&gt;">
  <!ENTITY pair "&left;core&right;">
]>
<catalog>
  <record code="r-a" state="new">
    <label>first &pair;</label>
    <data>
      <unknown xmlns="urn:foreign"><foreign:node attr="x"/></unknown>
      <?local instruction?>
      <!-- data boundary -->
    </data>
    <link rel="self" destination="urn:item:r-a"/>
  </record>
  <record code="r-b">
    <label><![CDATA[unescaped ]]> characters]]></label>
    <link rel="next" destination="../r-a#part"/>
    <link rel="alternate" destination="mailto:a@b.example"/>
  </record>
</catalog>