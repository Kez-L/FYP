<?xml version="1.0"?>
<!DOCTYPE catalog [
  <!NOTATION jpg SYSTEM "image/jpeg">
  <!ENTITY logo SYSTEM "logo.jpg" NDATA jpg>
  <!ELEMENT catalog (entry+)>
  <!ELEMENT entry (title,price?,details)>
  <!ATTLIST entry
    id ID #REQUIRED
    kind (book|video|audio) "book"
    cover ENTITY #IMPLIED>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT price (#PCDATA)>
  <!ELEMENT details (#PCDATA|link)*>
  <!ELEMENT link (#PCDATA)>
  <!ENTITY brand "A&amp;B Supplies">
]>
<catalog>
  <entry id="e1" kind="video" cover="logo">
    <title>&brand; &quot;Archive&quot;</title>
    <price>19.95</price>
    <details>disc <link>region-0</link> restored</details>
  </entry>
</catalog>