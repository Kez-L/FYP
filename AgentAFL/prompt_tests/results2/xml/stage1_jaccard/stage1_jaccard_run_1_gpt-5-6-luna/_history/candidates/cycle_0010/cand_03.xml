<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE scene [
  <!ELEMENT scene (layer+)>
  <!ELEMENT layer (object*)>
  <!ELEMENT object (transform?,shape,property*)>
  <!ELEMENT transform EMPTY>
  <!ELEMENT shape (point+)>
  <!ELEMENT point EMPTY>
  <!ELEMENT property (#PCDATA|value)*>
  <!ELEMENT value (#PCDATA)>
  <!ATTLIST layer name CDATA #REQUIRED z NMTOKEN "0">
  <!ATTLIST object name CDATA #IMPLIED visible (true|false) "true">
  <!ATTLIST transform matrix CDATA #REQUIRED>
  <!ATTLIST shape type (polygon|polyline|path) #REQUIRED>
  <!ATTLIST point x CDATA #REQUIRED y CDATA #REQUIRED>
  <!ATTLIST property key CDATA #REQUIRED>
  <!ATTLIST value lang NMTOKEN #IMPLIED>
]>
<scene xmlns:xlink="http://www.w3.org/1999/xlink">
  <layer name="background" z="-1">
    <object name="gradient" visible="false">
      <transform matrix="1 0 0 1 0 0"/>
      <shape type="polygon">
        <point x="-0.0000000000000000001" y="+INF"/>
        <point x="NaN" y="-&#x221E;"/>
      </shape>
      <property key="description"><value lang="en">line one</value><value lang="und"/><value>tail</value></property>
    </object>
  </layer>
  <layer name="foreground" z="0000000000000000000000000000000000007">
    <object xlink:href="urn:object:7" name="&quot;quoted&quot;">
      <shape type="path">
        <point x="0" y="0"/><point x="1e309" y="-1e309"/>
      </shape>
      <property key="path"><![CDATA[M 0,0 L 1,1 Z]]></property>
    </object>
  </layer>
</scene>