<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE vault [
  <!ELEMENT vault (section+)>
  <!ELEMENT section (title, entry*)>
  <!ATTLIST section id ID #REQUIRED mode (open|sealed|archived) "open">
  <!ELEMENT title (#PCDATA|emph|mark)*>
  <!ELEMENT emph (#PCDATA)>
  <!ELEMENT mark (#PCDATA)>
  <!ELEMENT entry (key, value, note?)>
  <!ATTLIST entry ref IDREF #IMPLIED>
  <!ELEMENT key (#PCDATA)>
  <!ELEMENT value (#PCDATA|emph|mark|br)*>
  <!ELEMENT note (#PCDATA)>
  <!ELEMENT br EMPTY>
  <!ENTITY nbsp "&#160;">
  <!ENTITY stamp "vault-&nbsp;-record">
]>
<vault>
  <section id="s1" mode="sealed">
    <title>alpha <emph>encrypted</emph> <mark>zone</mark></title>
    <entry ref="s2">
      <key>name</key>
      <value>first<br/>value &stamp;</value>
      <note>line one<!-- embedded comment -->line two</note>
    </entry>
  </section>
  <section id="s2">
    <title>second</title>
    <entry>
      <key>checksum</key>
      <value><![CDATA[9f00<raw>&opaque]]></value>
    </entry>
  </section>
</vault>