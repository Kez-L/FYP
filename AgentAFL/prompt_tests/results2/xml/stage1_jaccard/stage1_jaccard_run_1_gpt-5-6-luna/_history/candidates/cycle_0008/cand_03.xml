<?xml version="1.0"?>
<!DOCTYPE scene [
  <!ELEMENT scene (layer+)>
  <!ELEMENT layer (group|shape|use|text)*>
  <!ATTLIST layer name CDATA #REQUIRED visible (true|false) "true">
  <!ELEMENT group (group|shape|use|text)*>
  <!ATTLIST group transform CDATA #IMPLIED>
  <!ELEMENT shape EMPTY>
  <!ATTLIST shape id ID #IMPLIED type (rect|circle|path|line) #REQUIRED data CDATA #IMPLIED>
  <!ELEMENT use EMPTY>
  <!ATTLIST use ref IDREF #REQUIRED opacity NMTOKEN #IMPLIED>
  <!ELEMENT text (#PCDATA)>
  <!ATTLIST text align (left|center|right) "left">
  <!ENTITY mark "<text align='center'>A &amp; B</text>">
]>
<scene xmlns="urn:scene" xmlns:g="urn:graphic" xmlns:xlink="http://www.w3.org/1999/xlink">
  <layer name="background" visible="false">
    <g:shape id="back" type="rect" data="0,0,640,480"/>
  </layer>
  <layer name="foreground">
    <group transform="translate(4.5,-2)">
      <shape id="circle1" type="circle" data="32,32,8"/>
      <use ref="circle1" opacity="0.50"/>
      &mark;
      <text align="right">x &lt; y &amp;&amp; y &gt; z</text>
    </group>
    <g:group>
      <g:shape type="path" data="M0 0 L1 1 Z"/>
    </g:group>
  </layer>
</scene>