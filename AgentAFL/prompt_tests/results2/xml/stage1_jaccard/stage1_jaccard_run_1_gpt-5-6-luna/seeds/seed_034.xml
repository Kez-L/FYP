<?xml version="1.0"?>
<!DOCTYPE stream [
  <!ELEMENT stream (record*)>
  <!ELEMENT record (key,value,blob?)>
  <!ELEMENT key (#PCDATA)>
  <!ELEMENT value (#PCDATA)>
  <!ELEMENT blob (#PCDATA)>
  <!ATTLIST record
    index ID #REQUIRED
    flags NMTOKENS #IMPLIED>
  <!ENTITY tab "&#9;">
  <!ENTITY line "&#10;">
  <!ENTITY mark "&#x1F642;">
]>
<stream>
  <record index="r001" flags="fast checked">
    <key>alpha</key>
    <value>one&tab;two&line;three</value>
    <blob>prefix &mark; suffix</blob>
  </record>
  <record index="r002" flags="quoted">
    <key>beta</key>
    <value> <![CDATA[ angle < brackets > and ]]]]><![CDATA[> split ]]></value>
  </record>
  <record index="r003">
    <key>gamma</key>
    <value>last</value>
  </record>
</stream>