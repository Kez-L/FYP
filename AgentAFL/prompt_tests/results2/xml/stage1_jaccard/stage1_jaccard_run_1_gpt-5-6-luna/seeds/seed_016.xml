<?xml version="1.0"?>
<!DOCTYPE shell [
  <!ENTITY % common "<!ELEMENT shell (header, body, footer?)>">
  %common;
  <!ELEMENT header (#PCDATA)>
  <!ELEMENT body (entry | branch)*>
  <!ELEMENT branch (entry*)>
  <!ELEMENT entry EMPTY>
  <!ELEMENT footer (#PCDATA)>
  <!ATTLIST entry key CDATA #IMPLIED>
  <![IGNORE[
    <!ELEMENT never (anything)>
    <!ENTITY hidden "not expanded">
  ]]>
  <![INCLUDE[
    <!ENTITY visible "included">
  ]]>
]>
<shell>
  <header>&visible;</header>
  <body>
    <branch><entry key="a"/><branch><entry/><entry key="c"/></branch></branch>
    <entry key="outside"/>
  </body>
  <footer>done</footer>
</shell>