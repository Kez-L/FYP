<?xml version="1.0"?>
<!DOCTYPE map [
  <!ELEMENT map (section+)>
  <!ELEMENT section (header, point*)>
  <!ELEMENT header (#PCDATA)>
  <!ELEMENT point (#PCDATA)>
  <!ATTLIST section xml:lang NMTOKEN #IMPLIED>
  <!ATTLIST point ref IDREF #IMPLIED kind NMTOKEN "note">
]>
<map xmlns="urn:example:map" xmlns:g="urn:example:geo">
  <section xml:lang="fr">
    <header>Repères</header>
    <point ref="missing" kind="warning">Unresolved reference</point>
    <point g:lat="48.8566" g:lon="2.3522">Paris</point>
  </section>
  <section xml:lang="ja">
    <header>地点</header>
    <point kind="label">東京</point>
  </section>
</map>