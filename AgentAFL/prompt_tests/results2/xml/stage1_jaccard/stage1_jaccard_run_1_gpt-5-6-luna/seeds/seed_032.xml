<?xml version="1.0"?>
<!DOCTYPE envelope [
  <!ELEMENT envelope (meta,body,tail)>
  <!ELEMENT meta EMPTY>
  <!ELEMENT body (chunk+)>
  <!ELEMENT chunk (#PCDATA|chunk)*>
  <!ELEMENT tail (#PCDATA)>
  <!ATTLIST meta
    timestamp CDATA #REQUIRED
    active (yes|no) "yes">
  <!ENTITY open "<chunk level='generated'>">
  <!ENTITY close "</chunk>">
  <!ENTITY text "nested &amp; material">
]>
<envelope>
  <meta timestamp="2026-09-22T00:00:00Z" active="yes"/>
  <body>
    <chunk level="root">start <chunk level="inner">&text;</chunk> finish</chunk>
    &open;payload &text;&close;
  </body>
  <tail>after-body</tail>
</envelope>