<?xml version="1.0"?>
<!DOCTYPE report [
  <!ELEMENT report (section+)>
  <!ELEMENT section (heading, item*)>
  <!ELEMENT heading (#PCDATA)>
  <!ELEMENT item (#PCDATA)>
  <!ATTLIST section
    code ID #IMPLIED
    level NMTOKEN "1">
  <!ENTITY % switches '
    <!ATTLIST item
      state (new|old|unknown) "unknown"
      note CDATA #IMPLIED>
  '>
  %switches;
  <![IGNORE[
    <!ELEMENT discarded EMPTY>
    <!ENTITY hidden "not expanded">
  ]]>
  <![INCLUDE[
    <!ENTITY visible "included-value">
  ]]>
]>
<report>
  <section code="s-a" level="2">
    <heading>Summary</heading>
    <item state="new" note="x &amp; y">alpha &visible;</item>
    <item>beta</item>
  </section>
  <section>
    <heading>Details</heading>
    <item state="old">gamma</item>
  </section>
</report>