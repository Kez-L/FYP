<?xml version="1.0" encoding="ISO-8859-1"?>
<!DOCTYPE report [
  <!ELEMENT report (section+)>
  <!ELEMENT section (title,table|warning|empty)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT table (row+)>
  <!ELEMENT row (cell*)>
  <!ELEMENT cell (#PCDATA|b|i|br)*>
  <!ELEMENT b (#PCDATA)>
  <!ELEMENT i (#PCDATA)>
  <!ELEMENT br EMPTY>
  <!ELEMENT warning (#PCDATA)>
  <!ELEMENT empty EMPTY>
  <!ATTLIST report generated CDATA #IMPLIED>
  <!ATTLIST section id ID #IMPLIED level NMTOKEN #IMPLIED>
  <!ATTLIST table columns NMTOKEN #REQUIRED>
  <!ATTLIST row index NMTOKEN #IMPLIED>
  <!ATTLIST cell colspan NMTOKEN "1" rowspan NMTOKEN "1">
  <!ENTITY nbsp "&#160;">
  <!ENTITY percent "&#37;">
  <!ENTITY markup "&lt;b&gt;not markup&lt;/b&gt;">
]>
<report generated="yes">
  <section id="s1" level="0">
    <title>Measurements &nbsp; &percent;</title>
    <table columns="3">
      <row index="1"><cell colspan="2">A<b>bold</b><br/>B</cell><cell>&markup;</cell></row>
      <row index="2"><cell><![CDATA[<i>literal</i>]]></cell><cell rowspan="2">C</cell><cell/></row>
    </table>
  </section>
  <section id="s2" level="1">
    <title>Warnings</title>
    <warning>unclosed-looking text: &lt;tag attr="x"&gt;</warning>
  </section>
</report>