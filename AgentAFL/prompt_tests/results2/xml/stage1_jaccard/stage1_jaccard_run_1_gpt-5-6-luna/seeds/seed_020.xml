<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!DOCTYPE catalog [
  <!NOTATION gif SYSTEM "image/gif">
  <!NOTATION jpg PUBLIC "-//JPEG//" "image/jpeg">
  <!ELEMENT catalog (section+)>
  <!ELEMENT section (title, item*)>
  <!ATTLIST section
    code ID #REQUIRED
    kind (hardware|software|other) "other">
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT item EMPTY>
  <!ATTLIST item
    id ID #REQUIRED
    ref IDREFS #IMPLIED
    media ENTITY #IMPLIED
    status (new|used|retired) "new">
  <!ENTITY logo SYSTEM "logo.gif" NDATA gif>
  <!ENTITY photo SYSTEM "photo.jpg" NDATA jpg>
]>
<catalog>
  <section code="s-main" kind="hardware">
    <title>Devices &amp; Accessories</title>
    <item id="i-one" media="logo" status="new"/>
    <item id="i-two" ref="i-one" status="used"/>
  </section>
  <section code="s-extra">
    <title>Miscellaneous</title>
    <item id="i-three" ref="i-one i-two"/>
  </section>
</catalog>