<?xml version="1.0"?>
<!DOCTYPE canvas [
  <!ELEMENT canvas (layer|guide|alias)*>
  <!ELEMENT layer (shape+)>
  <!ATTLIST layer name CDATA #REQUIRED visible (yes|no) "yes">
  <!ELEMENT shape EMPTY>
  <!ATTLIST shape kind (line|arc|polygon) #REQUIRED points CDATA #IMPLIED>
  <!ELEMENT guide (#PCDATA)>
  <!ELEMENT alias EMPTY>
  <!ATTLIST alias target ENTITY #REQUIRED>
  <!NOTATION svg SYSTEM "image/svg+xml">
  <!ENTITY drawing SYSTEM "sketch.svg" NDATA svg>
  <!ENTITY % extras "<!ELEMENT metadata (#PCDATA)>">
  %extras;
]>
<canvas>
  <layer name="foreground" visible="no">
    <shape kind="polygon" points="0,0 4,9 8,1"/>
    <shape kind="arc" points="5,5;3,2"/>
  </layer>
  <guide>north<!--cut-->east &amp; west</guide>
  <alias target="drawing"/>
  <metadata><![CDATA[<layer fake="yes"/>]]></metadata>
</canvas>