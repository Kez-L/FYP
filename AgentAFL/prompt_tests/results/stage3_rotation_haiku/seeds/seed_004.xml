<!DOCTYPE document [
  <!ELEMENT document (section*)>
  <!ELEMENT section (title, para+)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT para (#PCDATA | ref)*>
  <!ELEMENT ref EMPTY>
  <!ATTLIST ref id IDREF #REQUIRED>
  <!ENTITY nbsp "&#160;">
  <!ENTITY copy "&#169;">
]>
<document>
  <section>
    <title>Test&nbsp;Title</title>
    <para>Paragraph with&copy; symbol and <ref id="r1"/> reference.</para>
  </section>
</document>