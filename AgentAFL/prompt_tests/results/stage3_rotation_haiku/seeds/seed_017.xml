<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE catalog [
  <!ELEMENT catalog (product+)>
  <!ELEMENT product (name, price)>
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT price (#PCDATA)>
  <!ENTITY currency "USD">
  <!ENTITY tax "0.08">
]>
<catalog>
  <product>
    <name>Item1</name>
    <price>&currency;</price>
  </product>
  <product>
    <name>Item2</name>
    <price>&tax;</price>
  </product>
</catalog>