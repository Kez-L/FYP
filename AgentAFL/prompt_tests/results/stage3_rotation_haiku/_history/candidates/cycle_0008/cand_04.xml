<?xml version="1.0"?>
<!DOCTYPE mixed [
  <!ENTITY simple "text">
  <!ENTITY chain "&simple;&simple;&simple;">
  <!ENTITY expanded "&chain;&chain;">
  <!ELEMENT mixed (a|b)*>
  <!ELEMENT a (#PCDATA)>
  <!ELEMENT b (#PCDATA)>
  <!ATTLIST a href CDATA #IMPLIED>
]>
<mixed>
  <a href="&expanded;">&simple;</a>
  <b>&chain;&chain;</b>
  <a>&expanded;</a>
</mixed>