<?xml version="1.0"?>
<!DOCTYPE catalog [
  <!ELEMENT catalog (entry|folder)*>
  <!ELEMENT folder (entry|folder)*>
  <!ELEMENT entry EMPTY>
  <!ATTLIST catalog xmlns:meta CDATA #IMPLIED>
  <!ATTLIST folder name CDATA "default">
  <!ATTLIST entry
            id ID #REQUIRED
            kind (alpha|beta|gamma) "alpha"
            ref IDREFS #IMPLIED
            enabled (yes|no) "yes">
  <!ENTITY nbsp "&#160;">
  <!ENTITY stamp "2026-&amp;-&nbsp;">
]>
<catalog xmlns:meta="urn:metadata" meta:version="&stamp;">
  <folder name="outer">
    <entry id="e1" kind="beta" enabled="no"/>
    <folder name="inner">
      <entry id="e2" ref="e1" kind="gamma"/>
    </folder>
  </folder>
</catalog>