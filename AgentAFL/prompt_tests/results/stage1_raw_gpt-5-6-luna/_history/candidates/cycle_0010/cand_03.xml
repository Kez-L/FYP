<?xml version="1.0"?>
<!DOCTYPE report [
  <!ELEMENT report (header, body, footer)>
  <!ELEMENT header (label, generated)>
  <!ELEMENT body (paragraph | table | separator)*>
  <!ELEMENT footer (#PCDATA)>
  <!ELEMENT label (#PCDATA)>
  <!ELEMENT generated (#PCDATA)>
  <!ELEMENT paragraph (#PCDATA | bold | italic | br)*>
  <!ELEMENT bold (#PCDATA)>
  <!ELEMENT italic (#PCDATA)>
  <!ELEMENT br EMPTY>
  <!ELEMENT table (tr+)>
  <!ELEMENT tr (th*, td+)>
  <!ELEMENT th (#PCDATA)>
  <!ELEMENT td (#PCDATA)>
  <!ELEMENT separator EMPTY>
  <!ATTLIST report lang NMTOKEN #IMPLIED>
  <!ATTLIST table columns NMTOKEN #REQUIRED>
  <!ENTITY newline "&#10;">
]>
<report lang="en-US">
  <header>
    <label>Quarterly &quot;report&quot;</label>
    <generated>2026-09-17&newline;UTC</generated>
  </header>
  <body>
    <paragraph>one <bold>bold</bold><br/>two <italic>italic</italic> three</paragraph>
    <separator/>
    <table columns="2">
      <tr><th>A</th><th>B</th></tr>
      <tr><td>left</td><td>right &amp; more</td></tr>
      <tr><td><![CDATA[<raw>]]></td><td/></tr>
    </table>
  </body>
  <footer>fin</footer>
</report>