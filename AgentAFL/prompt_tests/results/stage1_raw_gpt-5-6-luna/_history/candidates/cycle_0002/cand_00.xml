<?xml version="1.0"?>
<!DOCTYPE catalog [
  <!ELEMENT catalog (entry+, note?)>
  <!ELEMENT entry (name, description, price)>
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT description (#PCDATA|emph|br)*>
  <!ELEMENT emph (#PCDATA)>
  <!ELEMENT br EMPTY>
  <!ELEMENT price (#PCDATA)>
  <!ELEMENT note (#PCDATA)>
  <!ATTLIST entry
    sku ID #REQUIRED
    state (new|used|archived) "new"
    ref IDREF #IMPLIED>
  <!ATTLIST price currency CDATA #FIXED "EUR">
  <!ENTITY company "North &amp; South">
  <!ENTITY mark "&#x2605;">
  <!NOTATION bin SYSTEM "application/octet-stream">
  <!ENTITY payload SYSTEM "blob.dat" NDATA bin>
]>
<catalog>
  <entry sku="p001">
    <name>&company; &mark;</name>
    <description>solid <emph>oak</emph><br/>table</description>
    <price>19.95</price>
  </entry>
  <entry sku="p002" state="used" ref="p001">
    <name>Replacement</name>
    <description><![CDATA[<raw> & unescaped ]]></description>
    <price>4.50</price>
  </entry>
  <note>End of catalog &#13;&#10;section.</note>
</catalog>