  <!ENTITY weird "A&#x0A;B&#x9;C&#xD;D">
]>
<archive>
  <folder name="root">
    <file>prefix &amp; &lt; &quot; &apos; &amp; suffix</file>
    <folder name="nested">
      <file><![CDATA[raw <xml> ]]]]><![CDATA[> text]]></file>
      <file>one<chunk/>two<chunk>three</chunk>four</file>
    </folder>
  </folder>
</archive>