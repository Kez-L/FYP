<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE report [
  <!ENTITY % common "(header,section+,footer?)">
  <!ELEMENT report %common;>
  <!ELEMENT header (#PCDATA)>
  <!ELEMENT section (title, data*)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT data (#PCDATA|chunk)*>
  <!ELEMENT chunk (#PCDATA)>
  <!ELEMENT footer (#PCDATA)>
  <!ATTLIST section code ID #IMPLIED>
  <!ENTITY nbsp "&#160;">
]>
<report>
  <header>Quarterly&nbsp;Summary</header>
  <section code="s1">
    <title>First</title>
    <data>alpha<chunk>beta</chunk>gamma</data>
    <data><![CDATA[x < y && y < z]]></data>
  </section>
  <section>
    <title>Second</title>
    <data>&lt;escaped&gt;</data>
  </section>
  <footer>End&#x2E;</footer>
</report>