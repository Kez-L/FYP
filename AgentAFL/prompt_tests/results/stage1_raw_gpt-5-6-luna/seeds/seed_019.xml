<?xml version="1.1" encoding="UTF-8"?>
<!DOCTYPE dashboard [
  <!ELEMENT dashboard (widget*, note?)>
  <!ELEMENT widget (label, value, detail?)>
  <!ELEMENT label (#PCDATA)>
  <!ELEMENT value (#PCDATA)>
  <!ELEMENT detail (#PCDATA|b|i)*>
  <!ELEMENT b (#PCDATA)>
  <!ELEMENT i (#PCDATA)>
  <!ELEMENT note (#PCDATA)>
  <!ATTLIST widget name ID #REQUIRED state (on|off|unknown) "unknown">
  <!ATTLIST value units CDATA #IMPLIED>
  <!ENTITY amp "&#38;">
  <!ENTITY quote "&#34;">
]>
<dashboard xml:space="preserve" xml:lang="x-klingon">
  <widget name="cpu" state="on">
    <label>CPU &amp; load</label>
    <value units="%">99&#x25;</value>
    <detail><b>hot</b><i> &amp; rising</i></detail>
  </widget>
  <widget name="disk" state="unknown">
    <label>Disk</label>
    <value units="bytes">18446744073709551615</value>
    <detail><![CDATA[
      <threshold low="10" high="90"/>
      raw & text
    ]]></detail>
  </widget>
  <note>Use &amp;quot;style markers: &quote;quoted&quote; &amp;amp; &amp;.</note>
</dashboard>