<?xml version="1.0"?>
<!DOCTYPE matrix [
  <!ELEMENT matrix (row+)>
  <!ELEMENT row (cell+)>
  <!ELEMENT cell (#PCDATA)>
  <!ATTLIST row index NMTOKEN #REQUIRED>
  <!ATTLIST cell coord NMTOKENS #IMPLIED kind (number|text|empty) "text">
  <!ENTITY left "[" >
  <!ENTITY right "]" >
  <!ENTITY % cellattrs '<!ATTLIST cell generated CDATA "yes">'>
  %cellattrs;
]>
<matrix>
  <row index="01 02">
    <cell coord="a1 b2" kind="number">1&lt;2</cell>
    <cell coord="c3" generated="no">x &left; y &right;</cell>
  </row>
  <row index="last">
    <cell kind="empty"/>
    <cell coord="z9" generated="maybe">line
break&#x0A;value</cell>
  </row>
</matrix>