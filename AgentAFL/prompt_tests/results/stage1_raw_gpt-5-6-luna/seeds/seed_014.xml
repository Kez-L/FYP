<?xml version="1.0"?>
<!DOCTYPE scene [
  <!ELEMENT scene (svg:canvas)>
  <!ELEMENT svg:canvas (svg:layer+)>
  <!ELEMENT svg:layer (svg:shape*)>
  <!ELEMENT svg:shape (svg:point*)>
  <!ELEMENT svg:point EMPTY>
  <!ATTLIST svg:canvas width CDATA #REQUIRED height CDATA #REQUIRED>
  <!ATTLIST svg:layer name CDATA #IMPLIED>
  <!ATTLIST svg:shape kind (line|polygon|circle) #REQUIRED>
  <!ATTLIST svg:point x CDATA #REQUIRED y CDATA #REQUIRED>
]>
<scene xmlns:svg="urn:svg:test" xmlns:meta="urn:metadata">
  <svg:canvas width="640" height="480">
    <svg:layer name="background">
      <svg:shape kind="polygon">
        <svg:point x="0" y="0"/>
        <svg:point x="640" y="0"/>
        <svg:point x="640" y="480"/>
        <svg:point x="0" y="480"/>
      </svg:shape>
    </svg:layer>
    <svg:layer name="foreground">
      <svg:shape kind="circle" meta:id="café">
        <svg:point x="320" y="240"/>
      </svg:shape>
      <svg:shape kind="line">
        <svg:point x="-1" y="1"/>
        <svg:point x="1e3" y="2E-2"/>
      </svg:shape>
    </svg:layer>
  </svg:canvas>
</scene>