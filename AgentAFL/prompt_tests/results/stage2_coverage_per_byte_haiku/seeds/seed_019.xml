<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE configuration [
  <!ELEMENT configuration (settings|data)*>
  <!ELEMENT settings (option+)>
  <!ELEMENT data (#PCDATA)>
  <!ELEMENT option EMPTY>
  <!ATTLIST option name CDATA #REQUIRED value CDATA #REQUIRED>
]>
<configuration>
  <settings>
    <option name="key1" value="val1"/>
  </settings>
  <data>test</data>
</configuration>