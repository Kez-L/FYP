<!DOCTYPE catalog [
  <!ELEMENT catalog (book+)>
  <!ELEMENT book (title,author)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT author (#PCDATA)>
  <!ATTLIST book year CDATA #REQUIRED isbn CDATA #FIXED "0000">
  <!ENTITY % paramEntity "restricted">
]>
<catalog>
  <book year="2020" isbn="0000">
    <title>Test</title>
    <author>Name</author>
  </book>
</catalog>