<?xml version="1.0" encoding="ISO-8859-1"?>
<!DOCTYPE library [
<!ELEMENT library (shelf+)>
<!ELEMENT shelf (book*, magazine*, newspaper*)>
<!ELEMENT book (title, author+, isbn, pages, category+, availability)>
<!ELEMENT magazine (title, issue, publication_date, pages)>
<!ELEMENT newspaper (title, date, sections)>
<!ELEMENT author (name, birth_year?)>
<!ELEMENT name (#PCDATA)>
<!ELEMENT birth_year (#PCDATA)>
<!ELEMENT title (#PCDATA)>
<!ELEMENT isbn (#PCDATA)>
<!ELEMENT pages (#PCDATA)>
<!ELEMENT category (#PCDATA)>
<!ELEMENT availability EMPTY>
<!ELEMENT issue (#PCDATA)>
<!ELEMENT publication_date (#PCDATA)>
<!ELEMENT date (#PCDATA)>
<!ELEMENT sections (section+)>
<!ELEMENT section (headline, content?)>
<!ELEMENT headline (#PCDATA)>
<!ELEMENT content (#PCDATA)>
<!ATTLIST shelf location CDATA #REQUIRED section (fiction|nonfiction|reference) #IMPLIED>
<!ATTLIST book language (en|fr|de|es) "en" edition CDATA #IMPLIED>
<!ATTLIST magazine language (en|fr|de) "en" volume CDATA #IMPLIED>
<!ATTLIST newspaper language (en|fr|de) "en">
<!ATTLIST availability status (available|checked_out|reserved) "available" check_out_date CDATA #IMPLIED>
<!ATTLIST section type (local|international|sports|business) "local">
]>
<library>
  <shelf location="A1" section="fiction">
    <book language="en" edition="2nd">
      <title>The Great Novel</title>
      <author>
        <name>Jane Smith</name>
        <birth_year>1975</birth_year>
      </author>
      <author>
        <name>John Writer</name>
      </author>
      <isbn>978-0-123456-78-9</isbn>
      <pages>450</pages>
      <category>Literary Fiction</category>
      <category>Drama</category>
      <availability status="available"/>
    </book>
  </shelf>
  <shelf location="B2" section="reference">
    <magazine language="en" volume="45">
      <title>Tech Weekly</title>
      <issue>Issue 12</issue>
      <publication_date>2024-01-10</publication_date>
      <pages>120</pages>
    </magazine>
    <newspaper language="en">
      <title>Daily News</title>
      <date>2024-01-15</date>
      <sections>
        <section type="local">
          <headline>City Council Meeting</headline>
          <content>Local government discusses new policies</content>
        </section>
        <section type="international">
          <headline>Global Updates</headline>
        </section>
      </sections>
    </newspaper>
  </shelf>
</library>