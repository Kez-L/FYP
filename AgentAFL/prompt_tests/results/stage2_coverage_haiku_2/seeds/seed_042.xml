<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE book [
<!ELEMENT book (metadata, chapters)>
<!ELEMENT metadata (title, author+, publisher, isbn)>
<!ELEMENT title (#PCDATA)>
<!ELEMENT author (#PCDATA)>
<!ELEMENT publisher (#PCDATA)>
<!ELEMENT isbn (#PCDATA)>
<!ELEMENT chapters (chapter+)>
<!ELEMENT chapter (section+)>
<!ELEMENT section (#PCDATA|emphasis|strong)*>
<!ELEMENT emphasis (#PCDATA)>
<!ELEMENT strong (#PCDATA)>
<!ATTLIST book version CDATA #FIXED "2.0" lang (en|fr|de|es) "en">
<!ATTLIST author role CDATA #IMPLIED>
<!ATTLIST chapter number CDATA #REQUIRED>
<!ATTLIST section title CDATA #REQUIRED>
]>
<book version="2.0" lang="en">
  <metadata>
    <title>Advanced XML Parsing</title>
    <author role="primary">Dr. Smith</author>
    <author role="contributor">Jane Doe</author>
    <publisher>Tech Press Inc.</publisher>
    <isbn>978-0-123456-78-9</isbn>
  </metadata>
  <chapters>
    <chapter number="1">
      <section title="Introduction">This is <emphasis>important</emphasis> content.</section>
      <section title="Basics">Learn <strong>fundamental</strong> concepts.</section>
    </chapter>
  </chapters>
</book>