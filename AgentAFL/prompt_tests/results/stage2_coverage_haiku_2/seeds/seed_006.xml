<?xml version="1.0"?>
<!DOCTYPE doc [
<!ELEMENT doc (section*)>
<!ELEMENT section (title, paragraph+)>
<!ELEMENT title (#PCDATA)>
<!ELEMENT paragraph (#PCDATA|emphasis|strong)*>
<!ELEMENT emphasis (#PCDATA)>
<!ELEMENT strong (#PCDATA)>
<!ATTLIST section class NMTOKEN #IMPLIED level (1|2|3) "1">
]>
<doc>
  <section level="1" class="intro">
    <title>Introduction</title>
    <paragraph>This is <emphasis>important</emphasis> and <strong>bold</strong>.</paragraph>
  </section>
  <section level="2">
    <title>Details</title>
    <paragraph>More content here.</paragraph>
    <paragraph>And more.</paragraph>
  </section>
</doc>