<!DOCTYPE config [
<!ELEMENT config (section*)>
<!ELEMENT section (param*)>
<!ELEMENT param EMPTY>
<!ATTLIST config version CDATA #REQUIRED timestamp CDATA #IMPLIED>
<!ATTLIST section name CDATA #REQUIRED enabled (true|false) "true">
<!ATTLIST param key CDATA #REQUIRED value CDATA #IMPLIED default CDATA #IMPLIED>
<!NOTATION jpeg PUBLIC "image/jpeg">
<!ENTITY logo SYSTEM "logo.jpg" NDATA jpeg>
]>
<config version="1.2.3">
  <section name="database" enabled="true">
    <param key="host" value="localhost" default="127.0.0.1"/>
    <param key="port" value="5432"/>
    <param key="timeout" default="30"/>
  </section>
  <section name="cache" enabled="false">
    <param key="type" value="redis"/>
  </section>
</config>