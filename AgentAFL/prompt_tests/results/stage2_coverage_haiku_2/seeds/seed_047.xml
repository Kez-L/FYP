<?xml version="1.0"?>
<!DOCTYPE feed [
<!ELEMENT feed (title, link, updated, entry*)>
<!ELEMENT title (#PCDATA)>
<!ELEMENT link EMPTY>
<!ELEMENT updated (#PCDATA)>
<!ELEMENT entry (id, title, published, author?, summary, content?)>
<!ELEMENT id (#PCDATA)>
<!ELEMENT published (#PCDATA)>
<!ELEMENT author (name, email?)>
<!ELEMENT name (#PCDATA)>
<!ELEMENT email (#PCDATA)>
<!ELEMENT summary (#PCDATA)>
<!ELEMENT content (#PCDATA|code)*>
<!ELEMENT code (#PCDATA)>
<!ATTLIST feed xmlns CDATA #FIXED "http://www.w3.org/2005/Atom" version CDATA "1.0">
<!ATTLIST link rel (alternate|self|via) #REQUIRED href CDATA #REQUIRED type CDATA #IMPLIED>
<!ATTLIST content type (text|html|xhtml) "text">
<!ATTLIST author role (author|editor|contributor) "author">
]>
<feed xmlns="http://www.w3.org/2005/Atom" version="1.0">
  <title>Example Feed</title>
  <link rel="alternate" href="http://example.org/" type="text/html"/>
  <link rel="self" href="http://example.org/feed.xml" type="application/atom+xml"/>
  <updated>2024-01-15T12:00:00Z</updated>
  <entry>
    <id>urn:uuid:entry-001</id>
    <title>First Entry</title>
    <published>2024-01-15T10:00:00Z</published>
    <author role="author">
      <name>John Doe</name>
      <email>john@example.org</email>
    </author>
    <summary>A summary of the first entry</summary>
    <content type="html">Content with <code>embedded code</code> block</content>
  </entry>
</feed>