<?xml version="1.0"?>
<!DOCTYPE library [
  <!ELEMENT library (book|magazine)*>
  <!ELEMENT book (title, author+, isbn, published)>
  <!ELEMENT magazine (title, issue, pages)>
  <!ELEMENT author (name, birth?)>
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT birth (#PCDATA)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT isbn (#PCDATA)>
  <!ELEMENT issue (#PCDATA)>
  <!ELEMENT pages (#PCDATA)>
  <!ELEMENT published (#PCDATA)>
  <!ATTLIST book id ID #REQUIRED lang (en|fr|de|es) "en">
  <!ATTLIST magazine id ID #REQUIRED volume NMTOKEN #REQUIRED>
]>
<library>
  <book id="b001" lang="en">
    <title>XML Parsing Guide</title>
    <author>
      <name>Jane Smith</name>
      <birth>1985</birth>
    </author>
    <isbn>978-0-123456-78-9</isbn>
    <published>2020</published>
  </book>
  <magazine id="m001" volume="42">
    <title>Tech Monthly</title>
    <issue>3</issue>
    <pages>120</pages>
  </magazine>
</library>