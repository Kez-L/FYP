<!DOCTYPE library [
<!ELEMENT library (book*)>
<!ELEMENT book (author, title, isbn)>
<!ELEMENT author (#PCDATA)>
<!ELEMENT title (#PCDATA)>
<!ELEMENT isbn (#PCDATA)>
<!ATTLIST book published CDATA #REQUIRED year NMTOKEN #IMPLIED category (fiction|nonfiction) #REQUIRED>
<!ATTLIST author nationality CDATA #IMPLIED>
]>
<library>
  <book published="2020-01-15" year="2020" category="fiction">
    <author nationality="US">John Smith</author>
    <title>A Great Novel</title>
    <isbn>978-0-123456-78-9</isbn>
  </book>
  <book published="2019-06-30" category="nonfiction">
    <author>Jane Doe</author>
    <title>Science Facts</title>
    <isbn>978-0-987654-32-1</isbn>
  </book>
</library>