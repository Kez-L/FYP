<?xml version="1.0"?>
<!DOCTYPE config [
<!ELEMENT config (database|security|logging)*>
<!ELEMENT database EMPTY>
<!ELEMENT security (encryption, authentication)>
<!ELEMENT encryption (#PCDATA)>
<!ELEMENT authentication (#PCDATA)>
<!ELEMENT logging (level, format)>
<!ELEMENT level (#PCDATA)>
<!ELEMENT format (#PCDATA)>
<!ATTLIST database host CDATA #REQUIRED port CDATA #DEFAULT "5432" ssl (yes|no) "no">
<!ATTLIST security enabled CDATA #REQUIRED>
<!ATTLIST logging timestamp CDATA #IMPLIED>
]>
<config>
  <database host="localhost" port="5432" ssl="yes"/>
  <security enabled="true">
    <encryption>AES-256</encryption>
    <authentication>LDAP</authentication>
  </security>
  <logging timestamp="2024-01-15">
    <level>DEBUG</level>
    <format>JSON</format>
  </logging>
</config>