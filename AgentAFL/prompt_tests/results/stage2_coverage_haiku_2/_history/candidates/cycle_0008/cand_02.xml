<?xml version="1.0" encoding="ISO-8859-1"?>
<!DOCTYPE html [
<!ELEMENT html (head, body)>
<!ELEMENT head (title, meta*)>
<!ELEMENT title (#PCDATA)>
<!ELEMENT meta EMPTY>
<!ELEMENT body (div+)>
<!ELEMENT div (p|span|ul)*>
<!ELEMENT p (#PCDATA|span)*>
<!ELEMENT span (#PCDATA)>
<!ELEMENT ul (li+)>
<!ELEMENT li (#PCDATA)>
<!ATTLIST html lang CDATA #REQUIRED>
<!ATTLIST meta name CDATA #REQUIRED content CDATA #REQUIRED>
<!ATTLIST div class CDATA #IMPLIED id CDATA #IMPLIED>
]>
<html lang="en">
  <head>
    <title>Test Document</title>
    <meta name="charset" content="UTF-8"/>
    <meta name="viewport" content="width=device-width"/>
  </head>
  <body>
    <div class="container" id="main">
      <p>Hello <span>world</span></p>
      <ul>
        <li>Item 1</li>
        <li>Item 2</li>
      </ul>
    </div>
  </body>
</html>