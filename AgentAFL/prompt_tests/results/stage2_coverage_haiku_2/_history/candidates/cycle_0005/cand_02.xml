<?xml version="1.0" standalone="no"?>
<!DOCTYPE library [
<!ELEMENT library (book*)>
<!ELEMENT book (author+, isbn, pages)>
<!ELEMENT author (#PCDATA)>
<!ELEMENT isbn (#PCDATA)>
<!ELEMENT pages (#PCDATA)>
<!ATTLIST book id ID #REQUIRED category CDATA #REQUIRED published CDATA #IMPLIED>
<!ATTLIST author role (primary|editor|translator) #IMPLIED>
<!ENTITY nbsp "&#160;">
<!ENTITY mdash "&#8212;">
]>
<library>
  <book id="b001" category="fiction" published="2020">
    <author role="primary">Alice Author</author>
    <author role="editor">Bob Editor</author>
    <isbn>978-1234567890</isbn>
    <pages>320</pages>
  </book>
  <book id="b002" category="technical">
    <author>Charlie Dev</author>
    <isbn>978-0987654321</isbn>
    <pages>512</pages>
  </book>
</library>