<?xml version="1.0"?>
<!DOCTYPE message [
  <!ELEMENT message (header, body)>
  <!ELEMENT header (from,to)>
  <!ELEMENT from (#PCDATA)>
  <!ELEMENT to (#PCDATA)>
  <!ELEMENT body ANY>
  <!ATTLIST message version CDATA #FIXED "2">
]>
<message version="2">
  <header>
    <from>alice@example.com</from>
    <to>bob@example.com</to>
  </header>
  <body>
    <payload xmlns:x="urn:x">
      <x:item x:flag="true">payload</x:item>
      <?pi target?>
    </payload>
  </body>
</message>