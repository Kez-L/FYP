<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE library [
  <!ELEMENT library (book+)>
  <!ELEMENT book (title,author,meta?)>
  <!ATTLIST book id ID #REQUIRED>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT author (#PCDATA)>
  <!ELEMENT meta EMPTY>
  <!ATTLIST meta lang CDATA #IMPLIED>
]>
<library>
  <book id="b1">
    <title>One</title>
    <author>Alice</author>
    <meta lang="en"/>
  </book>
  <book id="b2">
    <title>Two</title>
    <author>Bob</author>
  </book>
</library>