  <!ENTITY quote "&#34;quoted&#34;">
]>
<book>
  <title>&author; &quote;</title>
  <chapter>
    <para>alpha</para>
    <note/>
    <para>beta <![CDATA[ ]]> gamma</para>
  </chapter>
</book>