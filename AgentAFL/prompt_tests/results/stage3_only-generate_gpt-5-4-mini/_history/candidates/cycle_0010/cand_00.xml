<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE catalog [
  <!ELEMENT catalog (book+, note?)>
  <!ELEMENT book (title, author, meta?)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT author (#PCDATA)>
  <!ELEMENT meta ANY>
  <!ATTLIST book id ID #REQUIRED lang NMTOKEN "en">
  <!ENTITY % pe "<!ELEMENT injected ANY>">
  %pe;
]>
<catalog>
  <book id="b1" lang="en">
    <title>XML &amp; Parsers</title>
    <author>Anne</author>
    <meta><![CDATA[<raw attr='1'>&invisible;</raw>]]></meta>
  </book>
  <book id="b2" lang="fr">
    <title>Étude</title>
    <author>Bob</author>
  </book>
  <note>tail</note>
</catalog>