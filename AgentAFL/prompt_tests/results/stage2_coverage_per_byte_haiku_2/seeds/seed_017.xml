<?xml version="1.0"?>
<!DOCTYPE manifest [
  <!ELEMENT manifest (entry*, permissions?)>
  <!ELEMENT entry (path, checksum?, metadata*)>
  <!ELEMENT path (#PCDATA)>
  <!ELEMENT checksum (#PCDATA)>
  <!ELEMENT metadata (#PCDATA)>
  <!ELEMENT permissions (allow | deny)*>
  <!ELEMENT allow EMPTY>
  <!ELEMENT deny EMPTY>
  <!ATTLIST allow user CDATA #REQUIRED action (read|write|execute) "read">
  <!ATTLIST deny group CDATA #REQUIRED>
]>
<manifest>
  <entry>
    <path>/etc/config</path>
    <checksum>abc123</checksum>
    <metadata>important</metadata>
  </entry>
  <permissions>
    <allow user="root" action="write"/>
    <deny group="guests"/>
  </permissions>
</manifest>