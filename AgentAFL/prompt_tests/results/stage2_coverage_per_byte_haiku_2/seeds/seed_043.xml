<?xml version="1.0"?>
<!DOCTYPE matrix [
  <!ELEMENT matrix (row+)>
  <!ELEMENT row (col+)>
  <!ELEMENT col (#PCDATA)>
  <!ATTLIST matrix cols CDATA #REQUIRED rows CDATA #REQUIRED>
  <!ATTLIST col index CDATA #REQUIRED>
]>
<matrix rows="3" cols="2">
  <row>
    <col index="0">1</col>
    <col index="1">2</col>
  </row>
  <row>
    <col index="0">3</col>
    <col index="1">4</col>
  </row>
  <row>
    <col index="0">5</col>
    <col index="1">6</col>
  </row>
</matrix>