<!DOCTYPE test [
  <!ELEMENT test (a | b | c)*>
  <!ELEMENT a (#PCDATA | nested)*>
  <!ELEMENT b EMPTY>
  <!ELEMENT c (#PCDATA)>
  <!ELEMENT nested (#PCDATA)>
  <!ATTLIST a id ID #REQUIRED ref IDREF #IMPLIED>
  <!ATTLIST b href CDATA #FIXED "http://test">
  <!NOTATION jpeg PUBLIC "image/jpeg">
]>
<test>
  <a id="first">
    <nested>content</nested>
  </a>
  <b href="http://test"/>
  <c>text</c>
  <a id="second" ref="first">mixed</a>
</test>