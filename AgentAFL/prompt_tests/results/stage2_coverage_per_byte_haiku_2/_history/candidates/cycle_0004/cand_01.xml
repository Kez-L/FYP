<!DOCTYPE data [
  <!ELEMENT data (record*)>
  <!ELEMENT record (field | comment)*>
  <!ELEMENT field (#PCDATA)>
  <!ELEMENT comment (#PCDATA)>
  <!ATTLIST record version NMTOKEN "1.0" status (active|inactive) "active">
  <!ATTLIST field name CDATA #REQUIRED encrypted (yes|no) #IMPLIED>
]>
<data>
  <record version="2.1" status="inactive">
    <field name="username" encrypted="yes">admin</field>
    <comment>test user</comment>
  </record>
</data>