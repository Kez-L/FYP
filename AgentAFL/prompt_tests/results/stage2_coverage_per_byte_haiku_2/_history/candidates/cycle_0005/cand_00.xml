<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE root [
  <!ELEMENT root (item+)>
  <!ELEMENT item (name, value)>
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT value (#PCDATA)>
  <!ENTITY % internal "<!ELEMENT internal (#PCDATA)>">
  %internal;
]>
<root>
  <item>
    <name>test</name>
    <value>123</value>
  </item>
</root>