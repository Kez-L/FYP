<?xml version="1.0"?>
<!DOCTYPE message [
  <!ELEMENT message (header, body)>
  <!ELEMENT header (from, to)>
  <!ELEMENT body (#PCDATA)>
  <!ELEMENT from (#PCDATA)>
  <!ELEMENT to (#PCDATA)>
  <!ENTITY sender "alice@example.com">
  <!ENTITY recipient "bob@example.com">
]>
<message>
  <header>
    <from>&sender;</from>
    <to>&recipient;</to>
  </header>
  <body>Test message with mixed &sender; and &recipient; references</body>
</message>