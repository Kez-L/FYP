<?xml version="1.0"?>
<!DOCTYPE message [
  <!ELEMENT message (header, body)>
  <!ELEMENT header (to, from, subject)>
  <!ELEMENT body (#PCDATA)>
  <!ELEMENT to (#PCDATA)>
  <!ELEMENT from (#PCDATA)>
  <!ELEMENT subject (#PCDATA)>
]>
<message>
  <header>
    <to>user@example.com</to>
    <from>admin@example.com</from>
    <subject>Test</subject>
  </header>
  <body>Message content here</body>
</message>