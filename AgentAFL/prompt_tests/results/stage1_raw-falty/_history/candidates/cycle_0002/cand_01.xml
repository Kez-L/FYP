<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE doc [
  <!ENTITY % param1 "value1">
  <!ENTITY % param2 "value2">
  <!ELEMENT doc (section+)>
  <!ELEMENT section (title, body)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT body (#PCDATA)>
]>
<doc>
  <section>
    <title>First Section</title>
    <body>Content with special chars: &lt; &gt; &amp;</body>
  </section>
  <section>
    <title>Second Section</title>
    <body>More content here</body>
  </section>
</doc>