<!DOCTYPE envelope [
  <!ENTITY left "&#x3C;">
  <!ENTITY right "&#x3E;">
  <!ENTITY amp "&#38;">
  <!NOTATION bin SYSTEM "urn:example:binary">
  <!ELEMENT envelope (header, body, footer?)>
  <!ELEMENT header EMPTY>
  <!ELEMENT body ANY>
  <!ELEMENT footer (#PCDATA)>
  <!ATTLIST header version CDATA #IMPLIED>
  <!ATTLIST body format NOTATION (bin) #IMPLIED>
]>
<envelope>
  <header version="&quot;2&quot;"/>
  <body format="bin">
    &left;opaque&right;&amp;
    <data><![CDATA[&left;not-expanded&right;]]></data>
  </body>
  <footer>checksum:&amp;:&quot;:&apos;</footer>
</envelope>