  <!ELEMENT payload ANY>
  <!ENTITY left-brace "{">
  <!ENTITY right-brace "}">
  <!ENTITY quoted "&quot;quoted&quot;">
]>
<envelope>
  <header>
    <source>unit-test</source>
    <timestamp>2026-09-17T00:00:00Z</timestamp>
  </header>
  <payload>
    <map>
      <entry key="empty"></entry>
      <entry key="entities">&left-brace;key&right-brace; &quoted;</entry>
      <entry key="mixed"><![CDATA[a]]><value/>b</entry>
    </map>
  </payload>
</envelope>