<?xml version="1.0"?>
<!DOCTYPE message [
  <!NOTATION jpeg SYSTEM "image/jpeg">
  <!ENTITY logo SYSTEM "logo.jpg" NDATA jpeg>
  <!ENTITY text "line-one&#10;line-two">
  <!ELEMENT message (header, body, attachment?)>
  <!ELEMENT header (#PCDATA)>
  <!ELEMENT body ANY>
  <!ELEMENT attachment EMPTY>
  <!ATTLIST attachment href ENTITY #IMPLIED>
]>
<message>
  <header>&text;</header>
  <body>
    <section level="1">
      <p>First paragraph</p>
      <p>Second <b>paragraph</b><br/></p>
    </section>
  </body>
  <attachment href="logo"/>
</message>