<?xml version="1.0"?>
<!DOCTYPE catalog [
  <!ELEMENT catalog (entry*)>
  <!ELEMENT entry (title,meta?,payload)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT meta EMPTY>
  <!ELEMENT payload (#PCDATA|chunk)*>
  <!ELEMENT chunk (#PCDATA)>
  <!ATTLIST entry id ID #REQUIRED status (new|old|unknown) "unknown">
  <!ATTLIST meta key CDATA #IMPLIED>
  <!ENTITY greeting "Hello &amp; welcome">
]>
<catalog>
  <entry id="e-1" status="new">
    <title>&greeting; <![CDATA[<not-an-element>]]></title>
    <meta key="a&amp;b"/>
    <payload>left<chunk><![CDATA[x]]></chunk>right</payload>
  </entry>
  <entry id="e-2">
    <title>mixed <![CDATA[content]]> text</title>
    <payload><![CDATA[&greeting; <raw>]]></payload>
  </entry>
</catalog>