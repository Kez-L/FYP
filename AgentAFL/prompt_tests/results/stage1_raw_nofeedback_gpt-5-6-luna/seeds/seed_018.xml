<?xml version="1.0"?>
<!DOCTYPE store [
  <!ELEMENT store (section|note)*>
  <!ELEMENT section (label,record+)>
  <!ELEMENT label (#PCDATA)>
  <!ELEMENT record EMPTY>
  <!ATTLIST record
    code NMTOKEN #REQUIRED
    quantity NMTOKEN "0"
    tags NMTOKENS #IMPLIED
    ref IDREF #IMPLIED
  >
  <!ELEMENT note (#PCDATA)>
  <!ATTLIST section kind CDATA #IMPLIED>
]>
<store>
  <section kind="inventory">
    <label>Hardware</label>
    <record code="A_01" quantity="0007" tags="red fragile" ref="missing"/>
    <record code="B-02" tags="single"/>
  </section>
  <note><![CDATA[
    whitespace
    and line endings
  ]]></note>
  <section>
    <label>Empty-ish</label>
    <record code="C.03" quantity="+1"/>
  </section>
</store>