<?xml version="1.0"?>
<!DOCTYPE map [
  <!ENTITY word "north">
  <!ENTITY pair "&word;-east">
  <!NOTATION bin SYSTEM "application/octet-stream">
  <!ELEMENT map (node+, note?)>
  <!ELEMENT node (label, node*)>
  <!ELEMENT label (#PCDATA)>
  <!ELEMENT note (#PCDATA)>
  <!ATTLIST node
            id ID #IMPLIED
            ref IDREF #IMPLIED
            kind (leaf|branch) "leaf">
]>
<map>
  <node id="root" kind="branch">
    <label>&pair;</label>
    <node id="child" ref="root">
      <label>leaf &apos;value&apos;</label>
    </node>
  </node>
  <note>entities: &lt; &gt; &amp; &quot;</note>
</map>