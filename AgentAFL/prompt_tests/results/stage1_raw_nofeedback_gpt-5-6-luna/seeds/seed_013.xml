<?xml version="1.0"?>
<?processing instruction-data?>
<!DOCTYPE report [
  <!ELEMENT report (section*)>
  <!ELEMENT section (title, content)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT content (#PCDATA|table|row|cell|comment)*>
  <!ELEMENT table (row+)>
  <!ELEMENT row (cell+)>
  <!ELEMENT cell (#PCDATA|bold)*>
  <!ELEMENT bold (#PCDATA)>
  <!ELEMENT comment (#PCDATA)>
  <!ATTLIST section key NMTOKEN #IMPLIED>
]>
<!-- deliberately mixed content with CDATA boundaries -->
<report>
  <section key="r-1">
    <title>Report</title>
    <content>
      <![CDATA[before <markup> and ]]> 
      <table>
        <row><cell>1</cell><cell><bold>two</bold></cell></row>
        <row><cell><![CDATA[three & four]]></cell><cell>five</cell></row>
      </table>
      <comment>after table</comment>
    </content>
  </section>
</report>