<!DOCTYPE r [
  <!ENTITY hello "hello">
  <!ENTITY world "world">
  <!NOTATION bin SYSTEM "application/octet-stream">
  <!ELEMENT r (message|blob|message)*>
  <!ELEMENT message (#PCDATA)>
  <!ELEMENT blob EMPTY>
  <!ATTLIST blob format NOTATION (bin) "bin">
]>
<r>
  <message>&hello;, &world;!</message>
  <blob format="bin"/>
  <message>before <![CDATA[&hello;]]> after</message>
</r>