<?xml version="1.0"?>
<!DOCTYPE report [
  <!ELEMENT report (section+)>
  <!ELEMENT section (title, paragraph*, table?)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT paragraph (#PCDATA|em|br)*>
  <!ELEMENT em (#PCDATA)>
  <!ELEMENT br EMPTY>
  <!ELEMENT table (row+)>
  <!ELEMENT row (cell+)>
  <!ELEMENT cell (#PCDATA)>
  <!ATTLIST section index NMTOKEN #REQUIRED>
]>
<report>
  <section index="01">
    <title>Mixed content</title>
    <paragraph>alpha<em>beta</em><br/>gamma</paragraph>
    <paragraph><![CDATA[raw ]]>tail</paragraph>
    <table>
      <row><cell>1</cell><cell>2</cell></row>
      <row><cell><![CDATA[x<y]]></cell><cell/></row>
    </table>
  </section>
</report>