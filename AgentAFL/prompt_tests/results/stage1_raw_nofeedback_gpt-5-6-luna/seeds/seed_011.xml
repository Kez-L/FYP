<?xml version="1.0"?>
<!DOCTYPE message [
  <!ENTITY % declarations "
    <!ELEMENT message (header, body)>
    <!ELEMENT header (sender, receiver, timestamp)>
    <!ELEMENT sender (#PCDATA)>
    <!ELEMENT receiver (#PCDATA)>
    <!ELEMENT timestamp (#PCDATA)>
    <!ELEMENT body (paragraph+)>
    <!ELEMENT paragraph (#PCDATA|link)*>
    <!ELEMENT link (#PCDATA)>
  ">
  %declarations;
  <!ATTLIST message priority (low|normal|high) "normal">
  <!ATTLIST link href URI #IMPLIED>
]>
<message priority="high">
  <header>
    <sender>alpha@example.test</sender>
    <receiver>beta@example.test</receiver>
    <timestamp>2026-09-17T12:34:56Z</timestamp>
  </header>
  <body>
    <paragraph>Read the <link href="https://example.test/a?x=1&amp;y=2">first link</link>.</paragraph>
    <paragraph>A second paragraph with <link>no target</link>.</paragraph>
  </body>
</message>