<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE catalog [
  <!ELEMENT catalog (item+, note?)>
  <!ELEMENT item (name, description, price)>
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT description (#PCDATA|em|br)*>
  <!ELEMENT em (#PCDATA)>
  <!ELEMENT br EMPTY>
  <!ELEMENT price (#PCDATA)>
  <!ELEMENT note (#PCDATA)>
  <!ATTLIST item id ID #REQUIRED category CDATA "general">
  <!ENTITY currency "€">
]>
<catalog>
  <item id="i001" category="special">
    <name>Nested &amp; Escaped</name>
    <description>Text <em>with emphasis</em><br/>and a symbol &currency;.</description>
    <price>19.95</price>
  </item>
  <item id="i002">
    <name><![CDATA[Raw <tag> content]]></name>
    <description>Second item</description>
    <price>0</price>
  </item>
  <note xml:lang="en">End of catalog.</note>
</catalog>