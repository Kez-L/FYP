<?xml version="1.0"?>
<!DOCTYPE archive [
  <!ELEMENT archive (folder*)>
  <!ELEMENT folder (folder|file|alias)*>
  <!ATTLIST folder name CDATA #REQUIRED>
  <!ELEMENT file (metadata?, content)>
  <!ATTLIST file path CDATA #REQUIRED mode NMTOKEN "0644">
  <!ELEMENT metadata (property*)>
  <!ELEMENT property EMPTY>
  <!ATTLIST property key CDATA #REQUIRED value CDATA #IMPLIED>
  <!ELEMENT content (#PCDATA)>
  <!ELEMENT alias EMPTY>
  <!ATTLIST alias ref IDREF #REQUIRED>
  <!ENTITY line "&#10;">
]>
<archive>
  <folder name="root">
    <folder name="docs">
      <file path="docs/readme.txt" mode="0600">
        <metadata>
          <property key="owner" value="qa"/>
          <property key="checksum"/>
        </metadata>
        <content>First line&line;Second line&#x0A;終端</content>
      </file>
      <alias ref="missing"/>
    </folder>
    <folder name="empty"/>
  </folder>
</archive>