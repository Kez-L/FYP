<?xml version="1.0"?>
<!DOCTYPE archive [
  <!ELEMENT archive (record+)>
  <!ELEMENT record (key, value, metadata?)>
  <!ELEMENT key (#PCDATA)>
  <!ELEMENT value (#PCDATA|part)*>
  <!ELEMENT part (#PCDATA)>
  <!ELEMENT metadata EMPTY>
  <!ATTLIST record status (new|old|deleted) "new">
  <!ATTLIST metadata checksum CDATA #REQUIRED>
]>
<archive>
  <record status="old">
    <key>k-001</key>
    <value>prefix<part>middle</part>suffix</value>
    <metadata checksum="sha256:0000"/>
  </record>
  <record status="deleted">
    <key>k-002</key>
    <value><part>孤立</part></value>
  </record>
</archive>