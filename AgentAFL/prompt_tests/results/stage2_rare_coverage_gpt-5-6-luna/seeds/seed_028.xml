<?xml version="1.0"?>
<!DOCTYPE graph [
  <!ELEMENT graph (node+, edge*)>
  <!ELEMENT node (label?, property*)>
  <!ELEMENT edge EMPTY>
  <!ELEMENT label (#PCDATA)>
  <!ELEMENT property (#PCDATA)>
  <!ATTLIST node id ID #REQUIRED>
  <!ATTLIST edge from IDREF #REQUIRED to IDREF #REQUIRED weight CDATA "1">
  <!ATTLIST property name CDATA #REQUIRED>
]>
<graph>
  <node id="n0">
    <label>Root</label>
    <property name="color">blue</property>
    <property name="empty"/>
  </node>
  <node id="n1">
    <label>Leaf &quot;A&quot;</label>
  </node>
  <node id="n2">
    <label><![CDATA[Line one
Line two]]></label>
    <property name="quote">' &amp; "</property>
  </node>
  <edge from="n0" to="n1" weight="0"/>
  <edge from="n1" to="n2" weight="-3.14"/>
  <edge from="n2" to="n0" weight="1e309"/>
</graph>