<?xml version="1.0"?>
<!DOCTYPE laboratory [
  <!ELEMENT laboratory (experiment+, conclusion?)>
  <!ELEMENT experiment (input, process, result)>
  <!ATTLIST experiment id ID #REQUIRED status (planned|running|complete) "planned">
  <!ELEMENT input (sample+)>
  <!ELEMENT sample (#PCDATA)>
  <!ATTLIST sample ref IDREF #IMPLIED>
  <!ELEMENT process (#PCDATA|step)*>
  <!ELEMENT step (#PCDATA)>
  <!ELEMENT result (#PCDATA)>
  <!ELEMENT conclusion (#PCDATA)>
]>
<laboratory>
  <experiment id="expA" status="complete">
    <input>
      <sample ref="sampleA">water</sample>
    </input>
    <process>prepare<step>filter</step>measure<step>record</step></process>
    <result>stable</result>
  </experiment>
  <experiment id="expB">
    <input>
      <sample id="sampleA">sediment</sample>
      <sample>air</sample>
    </input>
    <process><step>collect</step><![CDATA[ / ]]><step>compare</step></process>
    <result>pending</result>
  </experiment>
  <conclusion><![CDATA[Further analysis required.]]></conclusion>
</laboratory>