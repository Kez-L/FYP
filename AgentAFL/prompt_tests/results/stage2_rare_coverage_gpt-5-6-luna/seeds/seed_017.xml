<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE report [
  <!ELEMENT report (summary, details)>
  <!ELEMENT summary (#PCDATA)>
  <!ELEMENT details (line+)>
  <!ELEMENT line (#PCDATA)>
  <!ATTLIST line n NMTOKEN #REQUIRED>
  <!ENTITY warning "Use &quot;care&quot; when reading.">
]>
<report>
  <summary>&warning;</summary>
  <details>
    <line n="1">leading spaces</line>
    <line n="2">text with&#10;an embedded newline</line>
    <line n="3"><![CDATA[ ]]></line>
    <line n="4">trailing spaces   </line>
  </details>
</report>