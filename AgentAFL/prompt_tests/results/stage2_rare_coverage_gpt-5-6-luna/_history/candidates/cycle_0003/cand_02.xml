<?xml version="1.0" standalone="yes"?>
<!DOCTYPE dialogue [
  <!ELEMENT dialogue (scene+)>
  <!ELEMENT scene (speaker, line+, cue*)>
  <!ELEMENT speaker (#PCDATA)>
  <!ELEMENT line (#PCDATA | aside | quote | mark)*>
  <!ELEMENT aside (#PCDATA | mark)*>
  <!ELEMENT quote (#PCDATA)>
  <!ELEMENT mark (#PCDATA)>
  <!ELEMENT cue EMPTY>
  <!ATTLIST scene number NMTOKEN #REQUIRED mood CDATA "neutral">
  <!ATTLIST speaker role (human|machine|unknown) "unknown">
  <!ATTLIST cue kind (sound|light|pause) #REQUIRED duration CDATA #IMPLIED>
  <!ENTITY greeting "Hello, &amp; welcome.">
  <!ENTITY nested "<mark>inside an entity</mark>">
  <!ENTITY % common "xml:space (default|preserve) 'default'">
  <!ATTLIST line %common;>
]>
<dialogue>
  <scene number="01" mood="tense">
    <speaker role="machine">UNIT-9</speaker>
    <line xml:space="preserve">  &greeting; <aside>(whispered)</aside> &nested; </line>
    <line><quote>Do you copy?</quote><mark>!</mark></line>
    <cue kind="sound" duration="00:00:02"/>
  </scene>
  <scene number="02">
    <speaker role="human">Operator</speaker>
    <line>Signal received<!-- split -->and decoded.</line>
    <cue kind="pause"/>
    <cue kind="light" duration="flash"/>
  </scene>
</dialogue>