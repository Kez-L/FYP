<?xml version="1.0"?>
<!DOCTYPE report [
  <!ELEMENT report (meta, body)>
  <!ELEMENT meta (owner, generated, flag?)>
  <!ELEMENT owner (#PCDATA)>
  <!ELEMENT generated (#PCDATA)>
  <!ELEMENT flag EMPTY>
  <!ELEMENT body (section+)>
  <!ELEMENT section (heading, (p | list | figure)+)>
  <!ELEMENT heading (#PCDATA)>
  <!ELEMENT p (#PCDATA | b | i | ref)*>
  <!ELEMENT b (#PCDATA)>
  <!ELEMENT i (#PCDATA)>
  <!ELEMENT ref EMPTY>
  <!ELEMENT list (entry+)>
  <!ELEMENT entry (#PCDATA)>
  <!ELEMENT figure EMPTY>
  <!ATTLIST report id ID #REQUIRED status (draft|final|sealed) "draft">
  <!ATTLIST section key ID #IMPLIED>
  <!ATTLIST ref target IDREF #REQUIRED>
  <!ATTLIST figure format (svg|png|bin) #REQUIRED>
  <!ENTITY company "R&amp;D &quot;Operations&quot;">
  <!ENTITY emphasis "<b>important</b>">
  <!NOTATION raw SYSTEM "application/octet-stream">
  <!ENTITY payload SYSTEM "payload.bin" NDATA raw>
]>
<report id="r-main" status="final">
  <meta>
    <owner>&company;</owner>
    <generated>2026-09-17T00:00:00Z</generated>
    <flag/>
  </meta>
  <body>
    <section key="s-1">
      <heading>Entity expansion</heading>
      <p>Plain <b>bold</b>, <i>italic</i>, and &emphasis; text.</p>
      <list>
        <entry>first</entry>
        <entry>second</entry>
      </list>
      <figure format="svg"/>
    </section>
  </body>
</report>