<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE museum [
  <!ENTITY ampersand "&#38;">
  <!ENTITY label "Ancient &amp; Modern">
  <!ELEMENT museum (wing+)>
  <!ELEMENT wing (caption, exhibit*)>
  <!ELEMENT caption (#PCDATA)>
  <!ELEMENT exhibit (name, description, link?)>
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT description (#PCDATA|em|ref)*>
  <!ELEMENT em (#PCDATA)>
  <!ELEMENT ref EMPTY>
  <!ELEMENT link (#PCDATA)>
  <!ATTLIST wing code ID #REQUIRED>
  <!ATTLIST exhibit code ID #REQUIRED related IDREF #IMPLIED>
]>
<museum xml:lang="en">
  <wing code="north">
    <caption>&label; &amp; Collections</caption>
    <exhibit code="n-1">
      <name>Clockwork Bird</name>
      <description>A mechanical <em>songbird</em> with a <ref/> hidden spring.</description>
      <link>gallery://north/clockwork</link>
    </exhibit>
    <exhibit code="n-2" related="n-1">
      <name>Restored Dial</name>
      <description><![CDATA[Etched markings: < > & " ']]></description>
    </exhibit>
  </wing>
</museum>