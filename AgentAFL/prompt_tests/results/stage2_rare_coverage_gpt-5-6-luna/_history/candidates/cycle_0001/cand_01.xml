<?xml version="1.0"?>
<!DOCTYPE warehouse [
  <!ELEMENT warehouse (zone+)>
  <!ELEMENT zone (bin+)>
  <!ELEMENT bin (product*)>
  <!ELEMENT product (#PCDATA)>
  <!ATTLIST zone name CDATA #REQUIRED>
  <!ATTLIST bin code ID #REQUIRED>
]>
<warehouse>
  <zone name="north">
    <bin code="N1">
      <product>bolt</product>
      <product>washer</product>
    </bin>
    <bin code="N2"/>
  </zone>
  <zone name="south">
    <bin code="S1"><product>nut</product></bin>
  </zone>
</warehouse>