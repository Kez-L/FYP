<?xml version="1.0"?>
<!DOCTYPE report [
  <!ELEMENT report (meta, chapter*)>
  <!ELEMENT meta EMPTY>
  <!ELEMENT chapter (heading, paragraph+)>
  <!ELEMENT heading (#PCDATA)>
  <!ELEMENT paragraph (#PCDATA|em|code|break)*>
  <!ELEMENT em (#PCDATA|code)*>
  <!ELEMENT code (#PCDATA)>
  <!ELEMENT break EMPTY>
  <!ATTLIST report xml:lang NMTOKEN #IMPLIED>
  <!ATTLIST chapter number NMTOKEN #REQUIRED>
  <!ATTLIST meta generated CDATA #REQUIRED>
  <!ENTITY % optional "<!ELEMENT appendix (#PCDATA)>">
  %optional;
]>
<report xml:lang="fr">
  <meta generated="yes"/>
  <chapter number="I">
    <heading>Syntax &amp; Semantics</heading>
    <paragraph>Text with <em>nested <code>markup</code></em><break/> and a tail.</paragraph>
    <paragraph><![CDATA[Characters such as <, >, and & remain literal here.]]></paragraph>
  </chapter>
  <chapter number="II">
    <heading>Empty cases</heading>
    <paragraph><code/></paragraph>
  </chapter>
</report>