<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE root [
  <!ELEMENT root (section+, tail)>
  <!ELEMENT section (heading, body)>
  <!ELEMENT heading (#PCDATA)>
  <!ELEMENT body (#PCDATA | part | br)*>
  <!ELEMENT part (#PCDATA)>
  <!ELEMENT br EMPTY>
  <!ELEMENT tail (#PCDATA)>
  <!ATTLIST section
    id ID #REQUIRED
    kind (primary | secondary) "primary">
  <!ATTLIST part role CDATA #IMPLIED>
  <!ENTITY fragment "<part role='generated'>X &amp; Y</part><br/>">
  <!ENTITY apos "&#39;">
]>
<root>
  <section id="s1" kind="primary">
    <heading>First &apos;section&apos;</heading>
    <body>Before &fragment; after <part role="manual">Z</part>.</body>
  </section>
  <section id="s2">
    <heading>Second</heading>
    <body><![CDATA[raw ]]> text <br/> ending</body>
  </section>
  <tail>document tail</tail>
</root>