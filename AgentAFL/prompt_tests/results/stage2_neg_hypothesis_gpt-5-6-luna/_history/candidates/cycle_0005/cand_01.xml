<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE catalog [
  <!ENTITY % itemDecl '
    <!ELEMENT item (name, value?)>
    <!ATTLIST item
      code NMTOKEN #REQUIRED
      state (new | old) "new">
  '>
  %itemDecl;
  <!ELEMENT catalog (item*)>
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT value (#PCDATA)>
  <!ENTITY note "line one&#x0A;line two">
]>
<catalog>
  <item code="A-17">
    <name>Alpha</name>
    <value>&note;</value>
  </item>
  <item code="B_204" state="old">
    <name>Beta</name>
  </item>
</catalog>