<!DOCTYPE report [
  <!ELEMENT report (header, entry+, footer?)>
  <!ELEMENT header (#PCDATA)>
  <!ELEMENT entry (key, value, value?)>
  <!ELEMENT key (#PCDATA)>
  <!ELEMENT value (#PCDATA|emph|break)*>
  <!ELEMENT emph (#PCDATA)>
  <!ELEMENT break EMPTY>
  <!ELEMENT footer (#PCDATA)>
  <!ATTLIST report mode (brief|full|audit) "brief">
  <!ATTLIST entry ident ID #REQUIRED status (new|old|hold) "new">
  <!ATTLIST break width NMTOKEN #IMPLIED>
]>
<report mode="audit">
  <header>Run <emph>42</emph></header>
  <entry ident="e1" status="hold">
    <key>k</key>
    <value>one<break width="80"/>two</value>
    <value>alternate</value>
  </entry>
  <footer>complete</footer>
</report>