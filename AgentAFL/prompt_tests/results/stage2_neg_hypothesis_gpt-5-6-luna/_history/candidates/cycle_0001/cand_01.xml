<!DOCTYPE report [
  <!ELEMENT report (header, section+)>
  <!ELEMENT header (#PCDATA)>
  <!ELEMENT section (name, data*)>
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT data (#PCDATA|chunk)*>
  <!ELEMENT chunk (#PCDATA)>
  <!ATTLIST section level NMTOKEN #IMPLIED>
  <!ENTITY local "alpha &amp; beta">
]>
<report>
  <header>Run &local;</header>
  <section level="001">
    <name>first</name>
    <data>left<chunk>middle</chunk>right</data>
    <data><![CDATA[x < y && y > z]]></data>
  </section>
  <section level="two">
    <name>second</name>
  </section>
</report>