<?xml version="1.0"?>
<!DOCTYPE report [
  <!ELEMENT report (section*)>
  <!ELEMENT section (heading, body)>
  <!ELEMENT heading (#PCDATA)>
  <!ELEMENT body (#PCDATA|link|image)*>
  <!ELEMENT link (#PCDATA)>
  <!ELEMENT image EMPTY>
  <!ATTLIST section kind (alpha|beta|gamma) "alpha">
  <!ATTLIST link href URI #REQUIRED>
  <!ATTLIST image src CDATA #REQUIRED alt CDATA #IMPLIED>
  <!NOTATION png SYSTEM "image/png">
  <!ENTITY % common "<!ENTITY marker 'parameter-expanded'>">
  %common;
  <![IGNORE[
    <!ELEMENT ignored (never, parsed)>
    <!ENTITY hidden "not expanded">
  ]]>
  <![INCLUDE[
    <!ENTITY included "included-value">
  ]]>
]>
<report>
  <section kind="gamma">
    <heading>&marker; &included;</heading>
    <body>
      <link href="urn:x?a=1&amp;b=2">jump</link>
      <image src="pixel.png" alt="tiny"/>
      tail
    </body>
  </section>
</report>