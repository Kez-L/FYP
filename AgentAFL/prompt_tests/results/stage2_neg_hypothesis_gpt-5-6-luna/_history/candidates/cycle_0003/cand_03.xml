<ns:envelope
    xmlns:ns="urn:outer"
    xmlns:a="urn:alpha"
    xmlns:b="urn:beta"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:type="a:Envelope">
  <ns:payload>
    <a:item a:id="A-1" b:flag="yes">
      <b:item b:id="B-1">
        <a:value><![CDATA[<not-an-element>&still-text;</not-an-element>]]></a:value>
      </b:item>
      <a:item xmlns:a="" xmlns:local="urn:local">
        <local:child local:attr="v"/>
      </a:item>
    </a:item>
  </ns:payload>
  <ns:payload xmlns="urn:default">
    <entry xml:id="entry-2" xml:lang="und"/>
  </ns:payload>
</ns:envelope>