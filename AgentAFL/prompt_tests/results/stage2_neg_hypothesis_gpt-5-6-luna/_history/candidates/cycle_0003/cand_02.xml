<?xml version="1.0"?>
<!DOCTYPE report [
  <!ELEMENT report (metadata, data)>
  <!ELEMENT metadata (author?, timestamp?)>
  <!ELEMENT author (#PCDATA)>
  <!ELEMENT timestamp (#PCDATA)>
  <!ELEMENT data (record*)>
  <!ELEMENT record (field+)>
  <!ATTLIST record key ID #IMPLIED>
  <!ELEMENT field (#PCDATA)>
  <!ATTLIST field
    kind (text|number|date|flag) "text"
    xmlns:aux CDATA #FIXED "urn:aux">
  <!NOTATION bin SYSTEM "application/octet-stream">
  <!ENTITY payload SYSTEM "sample.bin" NDATA bin>
]>
<report>
  <metadata>
    <author>tester</author>
    <timestamp>2026-09-17T00:00:00Z</timestamp>
  </metadata>
  <data>
    <record key="r1">
      <field kind="number">00000000000000000042</field>
      <field kind="flag">true</field>
    </record>
    <record>
      <field>&#x0A;&#x0D;&#x09;trim-sensitive&#x20;</field>
    </record>
  </data>
</report>