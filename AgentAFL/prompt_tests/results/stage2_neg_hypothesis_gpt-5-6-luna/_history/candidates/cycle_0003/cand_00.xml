<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE catalog [
  <!ELEMENT catalog (section+)>
  <!ELEMENT section (title, item*)>
  <!ATTLIST section
    id ID #REQUIRED
    visibility (public|private|archived) "public">
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT item (#PCDATA|em|code)*>
  <!ATTLIST item ref IDREF #IMPLIED>
  <!ELEMENT em (#PCDATA)>
  <!ELEMENT code (#PCDATA)>
]>
<catalog>
  <section id="s-main" visibility="private">
    <title>Mixed content inventory</title>
    <item ref="s-main">alpha <em>bold</em> <code>one&lt;two</code> omega</item>
  </section>
</catalog>