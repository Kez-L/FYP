<?xml version="1.1" encoding="UTF-8" standalone="no"?>
<!DOCTYPE report [
  <!NOTATION bin SYSTEM "application/octet-stream">
  <!ENTITY picture SYSTEM "blob.dat" NDATA bin>
  <!ENTITY mark "A&#x0D;&#x0A;B">
  <!ELEMENT report (header, entry+)>
  <!ELEMENT header (#PCDATA)>
  <!ELEMENT entry (#PCDATA | b | i)*>
  <!ELEMENT b (#PCDATA)>
  <!ELEMENT i (#PCDATA)>
  <!ATTLIST report
    ref ID #IMPLIED
    xml:lang NMTOKEN #IMPLIED
    mode (draft | final) "draft">
  <!ATTLIST entry
    id ID #REQUIRED
    link IDREF #IMPLIED
    payload ENTITY #IMPLIED>
]>
<report ref="r1" xml:lang="en" mode="final">
  <header>Generated&#xA;report</header>
  <entry id="e1" payload="picture">
    Prefix <b>bold</b> and <i>italic</i>; &mark; suffix.
  </entry>
  <entry id="e2" link="e1">Second entry</entry>
</report>