<?xml version="1.0"?>
<!DOCTYPE root [
  <!ENTITY % declarations '
    <!ELEMENT root (item+, summary)>
    <!ELEMENT item (name, value, details?)>
    <!ATTLIST item code ID #REQUIRED status (new|old|hold) "new">
    <!ELEMENT name (#PCDATA)>
    <!ELEMENT value (#PCDATA)>
    <!ELEMENT details (line*)>
    <!ELEMENT line (#PCDATA)>
    <!ELEMENT summary (#PCDATA)>
  '>
  %declarations;
  <!ENTITY nbsp "&#160;">
]>
<root>
  <item code="i-a">
    <name>alpha&nbsp;</name>
    <value>001</value>
    <details>
      <line>first</line>
      <line><![CDATA[second & third]]></line>
    </details>
  </item>
  <item code="i-b" status="hold">
    <name>beta</name>
    <value>002</value>
  </item>
  <summary>two items</summary>
</root>