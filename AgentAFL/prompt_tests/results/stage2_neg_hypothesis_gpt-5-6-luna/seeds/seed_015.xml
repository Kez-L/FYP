<?xml version="1.0" standalone="yes"?>
<!DOCTYPE catalog [
  <!ELEMENT catalog (entry+)>
  <!ELEMENT entry (#PCDATA|title|tag|payload)*>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT tag EMPTY>
  <!ELEMENT payload EMPTY>
  <!ATTLIST entry
    id ID #REQUIRED
    refs IDREFS ""
    words NMTOKENS #IMPLIED
    kind (book|film|other) "other"
    attachment ENTITY #IMPLIED>
  <!ATTLIST tag name NMTOKEN #REQUIRED>
  <!NOTATION gif SYSTEM "image/gif">
  <!ENTITY cover SYSTEM "cover.gif" NDATA gif>
  <!ENTITY marker "<tag name='generated'/>">
]>
<catalog>
  <entry id="e1" refs="e2" words="alpha beta" kind="book" attachment="cover">
    <title>Encoded &amp; generated content</title>
    &marker;
    <payload/>
  </entry>
  <entry id="e2" refs="e1" words="gamma">
    <title>Second entry</title>
    <tag name="tail"/>
  </entry>
</catalog>