<?xml version="1.0"?>
<!DOCTYPE catalog [
  <!ELEMENT catalog (item+, note?)>
  <!ELEMENT item (title, description, metadata)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT description (#PCDATA|em|br)*>
  <!ELEMENT em (#PCDATA)>
  <!ELEMENT br EMPTY>
  <!ELEMENT metadata EMPTY>
  <!ATTLIST item id ID #REQUIRED xml:lang NMTOKEN #IMPLIED>
  <!ATTLIST metadata key CDATA #REQUIRED value CDATA #IMPLIED>
  <!ENTITY company "A &amp; B">
]>
<catalog xmlns="urn:example:catalog" xmlns:m="urn:example:meta" xml:space="preserve">
  <?catalog mode="compact"?>
  <!-- mixed content with an empty element and nested namespace -->
  <item id="i-1" xml:lang="en">
    <title>&company; &lt;edition&gt;</title>
    <description>Text <em>with emphasis</em><br/> and trailing data.</description>
    <metadata m:key="status" key="state" value="draft"/>
  </item>
  <item id="i-2">
    <title><![CDATA[raw ]]>]]&gt;<![CDATA[ delimiters]]></title>
    <description>alternate <em>content</em> only</description>
    <metadata key="priority"/>
  </item>
  <note>last child</note>
</catalog>