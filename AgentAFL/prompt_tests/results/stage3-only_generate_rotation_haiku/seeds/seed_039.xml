<?xml version="1.0"?>
<!DOCTYPE config [
  <!ELEMENT config (section*)>
  <!ELEMENT section (item+)>
  <!ELEMENT item (#PCDATA)>
  <!ATTLIST section name NMTOKEN #REQUIRED>
  <!ENTITY % start "<![CDATA[">
  <!ENTITY % end "]]>">
  <!ENTITY textblock "%start;Some CDATA content%end;">
]>
<config>
  <section name="test1">
    <item>&textblock;</item>
    <item>Normal text</item>
  </section>
  <section name="test2">
    <item>More content</item>
  </section>
</config>