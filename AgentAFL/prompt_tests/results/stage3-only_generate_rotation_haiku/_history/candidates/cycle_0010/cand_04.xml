<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE message [
  <!ELEMENT message (header, body)>
  <!ELEMENT header (from, to)>
  <!ELEMENT body (#PCDATA)>
  <!ELEMENT from (#PCDATA)>
  <!ELEMENT to (#PCDATA)>
  <!ENTITY sender "alice@example.com">
  <!ENTITY recipient "bob@example.com">
  <!ENTITY % entities "<!ENTITY msg 'Hello &sender; to &recipient;'>">
  %entities;
]>
<message>
  <header>
    <from>&sender;</from>
    <to>&recipient;</to>
  </header>
  <body>&msg;</body>
</message>