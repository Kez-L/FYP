<?xml version="1.0"?>
<!DOCTYPE config [
  <!ELEMENT config (setting+)>
  <!ELEMENT setting (key, value)>
  <!ELEMENT key (#PCDATA)>
  <!ELEMENT value (#PCDATA)>
  <!ENTITY % internal SYSTEM "file:///etc/hosts">
  <!ENTITY % remote SYSTEM "http://localhost:8080/schema.xml">
]>
<config>
  <setting>
    <key>timeout</key>
    <value>&internal;</value>
  </setting>
  <setting>
    <key>endpoint</key>
    <value>&remote;</value>
  </setting>
</config>