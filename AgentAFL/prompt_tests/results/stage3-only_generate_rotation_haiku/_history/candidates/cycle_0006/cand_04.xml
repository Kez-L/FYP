<?xml version="1.0"?>
<!DOCTYPE message [
  <!ELEMENT message (header,body)>
  <!ELEMENT header (from,to,subject)>
  <!ELEMENT body (paragraph+)>
  <!ELEMENT from (#PCDATA)>
  <!ELEMENT to (#PCDATA)>
  <!ELEMENT subject (#PCDATA)>
  <!ELEMENT paragraph (#PCDATA|emphasis)*>
  <!ELEMENT emphasis (#PCDATA)>
  <!ENTITY sender "user@domain.com">
  <!ENTITY receiver "admin@domain.com">
  <!ATTLIST message version CDATA #FIXED "1.0">
]>
<message version="1.0">
  <header>
    <from>&sender;</from>
    <to>&receiver;</to>
    <subject>Test Message</subject>
  </header>
  <body>
    <paragraph>This is a <emphasis>complex</emphasis> structure.</paragraph>
    <paragraph>With multiple nested entities and deep hierarchy.</paragraph>
  </body>
</message>