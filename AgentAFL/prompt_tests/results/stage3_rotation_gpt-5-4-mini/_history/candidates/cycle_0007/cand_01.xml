<?xml version="1.0"?>
<!DOCTYPE data [
  <!ELEMENT data (section*, payload)>
  <!ELEMENT section (item*)>
  <!ELEMENT item (#PCDATA)>
  <!ELEMENT payload (#PCDATA)>
  <!ENTITY x "X">
  <!ENTITY y "Y">
  <!ENTITY combo "&x;:&y;">
]>
<data>
  <section>
    <item attr="1">one</item>
    <item attr="2">two &combo;</item>
  </section>
  <section>
    <item>three</item>
  </section>
  <payload>&x; &y; &combo;</payload>
</data>