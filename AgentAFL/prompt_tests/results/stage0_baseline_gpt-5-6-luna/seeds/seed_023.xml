<?xml version="1.1" encoding="UTF-8"?>
<configuration>
  <server enabled="true" port="0" host="localhost">
    <limits max-connections="100" timeout-ms="0"/>
    <paths>
      <path type="data">./data</path>
      <path type="cache">/tmp/cache</path>
      <path type="empty"></path>
    </paths>
  </server>
  <features>
    <feature name="logging">true</feature>
    <feature name="compression">false</feature>
    <feature name="experimental"/>
  </features>
  <!-- A comment containing symbols: < > & and quotes -->
</configuration>