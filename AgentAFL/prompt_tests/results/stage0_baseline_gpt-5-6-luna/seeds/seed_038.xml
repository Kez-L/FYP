<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE message [
  <!ELEMENT message (header, body)>
  <!ELEMENT header (from, to)>
  <!ELEMENT body (#PCDATA)>
  <!ELEMENT from (#PCDATA)>
  <!ELEMENT to (#PCDATA)>
]>
<message>
  <header>
    <from>sender@example.com</from>
    <to>receiver@example.com</to>
  </header>
  <body>Use &lt; and &gt; safely, with an apostrophe and a quote.</body>
</message>