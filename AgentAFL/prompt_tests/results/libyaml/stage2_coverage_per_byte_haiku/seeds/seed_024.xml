---
special_strings:
  plain: hello world
  single_quoted: 'it''s a test'
  double_quoted: "escaped \"quotes\" here"
  literal: |
    Block literal
    Preserves newlines
  chomp_strip: |-
    No trailing newline
  chomp_keep: |+
    Keeps trailing newlines

  folded_keep: >+
    Folds text but
    keeps final newline
numbers_and_bools:
  integer: 42
  octal: 0o755
  hex: 0xFF
  float: 1.23e-4
  inf: .inf
  nan: .nan
  yes_bool: yes
  no_bool: no
  on_bool: on
  off_bool: off