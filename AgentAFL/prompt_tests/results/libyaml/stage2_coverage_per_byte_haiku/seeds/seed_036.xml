---
# Sparse tree with mixed implicit/explicit typing
!!map
  plain_scalar: unquoted text
  "quoted_key": !!str 123
  numeric_like: !!str 0xFF
  mixed_array: !!seq
    - !!int "999"
    - !!float ".inf"
    - !!float "-.inf"
    - !!float ".nan"
  null_tests:
    explicit_null: !!null
    implicit_null:
    tilde: ~
    empty_string: ""