---
# Special string cases and empty values
null_values:
  explicit_null: null
  tilde_null: ~
  implicit_null: 
  colon_only: :
empty_collections:
  empty_list: []
  empty_map: {}
  empty_block_list:
  empty_block_map:
strings_with_special:
  quoted_string: "value with: colons"
  single_quoted: 'literal: no expansion'
  unquoted_plain: plain scalar value
  number_string: "123"
  bool_string: "true"
  multiline_plain: >
    plain multiline
    scalar here
booleans:
  true_val: true
  false_val: false
  yes_val: yes
  no_val: no
numbers:
  integer: 42
  float: 3.14
  scientific: 1e-3
  hex: 0x1A
  octal: 0o755