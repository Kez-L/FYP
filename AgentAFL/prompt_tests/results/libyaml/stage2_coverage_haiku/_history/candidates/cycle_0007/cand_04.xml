---
complex_block_scalars:
  folded_strip: >-
    Line one continues
    to line two and folds
    into single paragraph
  literal_keep: |+
    Line one
    Line two


  literal_clip: |-
    Last line
    no trailing
multiline_dict_keys:
  ? |
    This is a
    multiline key
  : |
    This is a
    multiline value
anchors_and_aliases:
  base: &base_anchor
    - item1
    - item2
  refs:
    - *base_anchor
    - *base_anchor
  override: &override
    setting: changed
  applied: *override