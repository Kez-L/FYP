%TAG !! tag:internal,2024:
---
!!map
complex_keys:
  ? !!str "key with spaces"
  : !!int 100
  ? {map: key}
  : [sequence, value]
  ? - sequence
    - key
  : scalar_value
quoted_strings:
  single: 'single quoted'
  double: "double quoted"
  literal: |
    literal block
    preserves newlines
  folded: >
    folded block
    collapses newlines