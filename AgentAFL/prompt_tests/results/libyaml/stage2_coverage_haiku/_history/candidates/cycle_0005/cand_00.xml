---
%YAML 1.2
%TAG !! tag:yaml.org,2002:
%TAG !e! tag:example.com,2000:
!e!document
nested_anchors:
  - &anchor1
    key1: value1
    recursive: &anchor2
      deep: *anchor1
  - *anchor2
  - &anchor3 [*anchor1, *anchor2, *anchor3]
multiline_strings: |
  Line 1
  Line 2
   Indented Line 3
folded_text: >
  This is a long
  folded text that
  spans multiple lines
  and should be parsed correctly.
special_chars: "!@#$%^&*()_+-=[]{}|;:',.<>?/~`"