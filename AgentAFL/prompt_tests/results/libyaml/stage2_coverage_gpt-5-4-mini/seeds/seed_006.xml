---
!!map {
  ? !!str "key:with:colons"
  : !!seq [
      !!int 1,
      !!int 2,
      !!int 3,
      !!map {
        nested: !!str "value",
        empty: !!null ""
      }
    ],
  ? !!str "quoted # not comment"
  : !!str "text",
  ? !!str "multiline"
  : |
      first line
      second line
      third line
}
