---
sequence:
  - &N {name: node, left: null, right: null}
  - &L
    name: left
    child: *N
  - &R
    name: right
    child: *N
document:
  root:
    left: *L
    right: *R
  comment: '# not a comment inside quotes'
  literal: |
    ! not a tag here
    & not an anchor here
    * not an alias here
