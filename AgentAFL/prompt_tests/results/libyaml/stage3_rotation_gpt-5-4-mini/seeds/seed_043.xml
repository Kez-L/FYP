---
# explicit tags and non-string keys
? !!str "key:with:colons"
: !!seq
  - !!int "0"
  - !!int "1"
  - !!int "2"

? !!set
  ? alpha
  ? beta
  ? gamma
: !!map
  nested: yes

? [!!int 1, !!int 2, !!int 3]
: tuple-like key

? { a: 1, b: 2 }
: flow-map-key

typed:
  timestamp: !!timestamp "2001-12-15T02:59:43.1Z"
  binary: !!binary |
    QUJDREVGR0gK
  omap: !!omap
    - one: 1
    - two: 2