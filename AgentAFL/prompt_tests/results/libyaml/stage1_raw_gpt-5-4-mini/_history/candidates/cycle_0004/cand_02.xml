%YAML 1.2
---
top:
  ? simple key
  : simple value
  ? "quoted key with : colon"
  : >
    folded value
    spanning lines
  ? ? nested question
    : nested mapping key
  : [a, b, c]
sequence:
  - ? a: 1
    : b
  - - nested
    - sequence
    - item
  - {m: n, o: p}
tags:
  explicit_str: !!str 1234
  explicit_int: !!int "42"
  explicit_float: !!float ".nan"
  explicit_bool: !!bool "True"