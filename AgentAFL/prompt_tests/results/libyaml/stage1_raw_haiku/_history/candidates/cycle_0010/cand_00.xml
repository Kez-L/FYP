# Stress-test multiline string parsing with mixed indicators
plain_multiline: this is a plain scalar that spans
  multiple lines with inconsistent
    indentation levels and no indicators
nested_anchors: &root
  level1: &l1
    level2: &l2
      value: deep
      ref_to_root: *root
      ref_to_l1: *l1
  sibling: *l2