# Test scalar edge cases and special sequences
scalars:
  plain_with_hash: text with # inside no quotes
  quoted_escape: "tab:\t newline:\n quote:\" backslash:\\"
  literal_indicator: |
    line 1
    line 2
    
    line 4 after blank
  folded_indicator: >
    this text will
    be folded into
    a single line
comments_and_colons:
  "key:colon": "value:colon"
  regular_key: |
    : starts with colon
    - starts with dash
    ? starts with question