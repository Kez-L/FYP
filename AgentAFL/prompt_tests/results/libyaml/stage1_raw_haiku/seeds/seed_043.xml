special_scalar_contexts:
  literal_block: |
    Line 1 | pipe
    Line 2 : colon
    Line 3 - dash
    Line 4 # hash
    Line 5 & ampersand
    Line 6 * asterisk
    Line 7 ? question
    Line 8 { bracket
    Line 9 } bracket
  folded_with_indicators: >+
    This folds to
    one long line
    
    
    but preserves final newlines
  chomping_keep: |+
    keep trailing
    
  chomping_strip: |-
    strip trailing