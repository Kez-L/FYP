# Multiline scalars with special characters
literal: |
  Line with \backslash
  Line with "quotes"
  Line with 'apostrophe'
  Line with \n escape
  Line with \r carriage
  Line with \t tabs
  
folded_text: >
  This folds onto
  multiple lines with
  
  paragraph breaks and
  special chars: @#$%^&*()
  
chomp_strip: |-
  No final newline
  
chomp_keep: |+
  Keep final newlines