# Test case 5: Whitespace sensitivity and comment interactions
key1: value1  # inline comment
key2:
  # standalone comment
  subkey: |
    multiline
    value
  # another comment
  subkey2: >
    folded value
    with comments # not parsed as comment
  
  # section separator
  subkey3:
    - item # comment after item
    - another_item  # another comment
    # comment before next
    - final_item

empty_mappings:
  map1: {}
  map2: null
  map3:

empty_sequences:
  seq1: []
  seq2: []
  seq3: [~, null, ]