anchors:
  base: &base
    name: example
    values: [10, 20, 30]
    flags:
      enabled: yes
      strict: no
  copy1: *base
  copy2:
    <<: *base
    name: override
    values:
      - 99
      - 100
aliases:
  first: &first {id: 1, next: *base}
  second: &second {id: 2, prev: *first}
  third: {link: *second, root: *base}
