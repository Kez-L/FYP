%YAML 1.1
---
document:
  version: 1
  tags:
    - !<tag:yaml.org,2002:str> "alpha"
    - !<tag:yaml.org,2002:int> "12345"
    - !<tag:yaml.org,2002:seq> [a, b, c]
  weird_scalars:
    plain_colon: foo:bar
    quoted_colon: "foo: bar"
    hash_in_single: 'value # not comment'
    slashy: "path\\to\\file"
    tabs: "a\tb\tc"
  nested_docs:
    child1:
      a: 1
      b:
        c: 2
        d:
          - 3
          - 4
          - 5
    child2: &anchor2
      x: yes
      y: no
    child3:
      <<: *anchor2
      z: maybe
...