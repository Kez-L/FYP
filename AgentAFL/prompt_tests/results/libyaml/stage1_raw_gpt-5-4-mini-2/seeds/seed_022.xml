---
block_styles:
  literal_keep: |+
    line 1
      indented line
    line 3

  literal_strip: |-
    alpha
    beta

  folded_keep: >+
    folded one
      more indent
    folded three

  folded_strip: >-
    x
    y
    z

  chomping_mix: |
    a

    b
    c
    d
text_edges:
  leading_space: "  starts with spaces"
  trailing_space: "ends with spaces  "
  special_chars: "!@#$%^&*()[]{}<>?,.:;|\\/"
...