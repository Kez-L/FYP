%YAML 1.2
---
null_plain: ~
empty: ""
bools:
  yes_like: yes
  no_like: no
  on_like: on
  off_like: off
numbers:
  int_dec: 42
  int_hex: 0x2A
  int_oct: 052
  float_exp: 6.022e23
  negative_inf: -.inf
  nan_val: .NaN
timestamp: 2001-12-15T02:59:43.1Z
mapping_key:
  ? [a, b, c]
  : "sequence key"
  ? {x: 1, y: 2}
  : "map key"
...