---
# tabs, spaces, and indentation edge cases
root:
  "tab\tkey": "value\twith\ttabs"
  "space key": "  leading and trailing  "
  literal: |-
    first
      indented
    third
  folded: >+
    alpha
      beta
    gamma

    delta
  inline:
    - {a: 1, b: 2, c: [3, 4, 5]}
    - [!!str "0xFF", !!int "0777", !!float "-12.5e-2"]
    - {empty_map: {}, empty_seq: []}
...