%YAML 1.1
---
mapping:
  ? !!str "?"
  : "question key"
  ? !!str ":"
  : "colon key"
  ? !!str "#"
  : "hash key"
  ? !!str "null"
  : null
  ? !!str "yes"
  : yes
  ? !!str "no"
  : no
  ? !!str "on"
  : on
  ? !!str "off"
  : off
list:
  - { a: 1, b: 2, c: 3 }
  - [!!int 0, !!int -1, !!int +2, 03]
  - [!!float 1.0, !!float -2.5, !!float 6.022e23]
...