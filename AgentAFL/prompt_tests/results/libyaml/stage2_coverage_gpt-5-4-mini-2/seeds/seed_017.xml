%YAML 1.2
---
anchors:
  base: &base
    name: base-item
    flags:
      - on
      - off
      - maybe
  derived1:
    <<: *base
    name: derived-one
  derived2:
    <<: *base
    name: derived-two
    flags:
      - yes
      - no
sequence:
  - &item { id: 1, data: [a, b, c] }
  - *item
  - { id: 2, data: { nested: { depth: 3 } } }
...