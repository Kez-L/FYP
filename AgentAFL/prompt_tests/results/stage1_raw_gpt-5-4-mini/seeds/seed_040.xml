<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE library [
  <!ELEMENT library (section+, note?)>
  <!ELEMENT section (book*, magazine?)>
  <!ELEMENT book (title, author, year, isbn?)>
  <!ELEMENT magazine (title, issue)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT author (#PCDATA)>
  <!ELEMENT year (#PCDATA)>
  <!ELEMENT isbn (#PCDATA)>
  <!ELEMENT issue (#PCDATA)>
  <!ELEMENT note (#PCDATA)>
  <!ATTLIST book id ID #REQUIRED
                lang NMTOKEN #IMPLIED
                format (hardcover|paperback|ebook) "paperback">
  <!ENTITY pub "AFL Press">
]>
<library>
  <section>
    <book id="b1" lang="en" format="ebook">
      <title>&pub; Alpha</title>
      <author>Jane Doe</author>
      <year>2024</year>
      <isbn>978-0-0000-0000-1</isbn>
    </book>
    <book id="b2">
      <title>Beta</title>
      <author>John Roe</author>
      <year>2025</year>
    </book>
    <magazine>
      <title>Scan</title>
      <issue>42</issue>
    </magazine>
  </section>
  <note>catalog complete</note>
</library>