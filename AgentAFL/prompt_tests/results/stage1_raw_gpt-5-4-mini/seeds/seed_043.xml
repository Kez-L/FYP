<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE catalog [
  <!ELEMENT catalog (meta, itemlist)>
  <!ELEMENT meta (name, version, flags?)>
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT version (#PCDATA)>
  <!ELEMENT flags (flag*)>
  <!ELEMENT flag EMPTY>
  <!ELEMENT itemlist (item+)>
  <!ELEMENT item (label, data)>
  <!ELEMENT label (#PCDATA)>
  <!ELEMENT data (#PCDATA)>
  <!ATTLIST item index CDATA #REQUIRED status (new|old|archived) "new">
]>
<catalog>
  <meta>
    <name>demo</name>
    <version>1.2.3</version>
    <flags>
      <flag/>
      <flag/>
    </flags>
  </meta>
  <itemlist>
    <item index="0" status="new">
      <label>A</label>
      <data><![CDATA[<x>&y;]]></data>
    </item>
    <item index="1">
      <label>B</label>
      <data>plain text</data>
    </item>
  </itemlist>
</catalog>