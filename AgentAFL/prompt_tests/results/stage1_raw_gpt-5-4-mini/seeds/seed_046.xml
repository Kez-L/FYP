<?xml version="1.0"?>
<!DOCTYPE library [
  <!ELEMENT library (book+, note?)>
  <!ELEMENT book (title, author, meta*)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT author (#PCDATA)>
  <!ELEMENT meta EMPTY>
  <!ATTLIST book isbn CDATA #REQUIRED>
  <!ATTLIST meta key CDATA #REQUIRED value CDATA #IMPLIED>
]>
<library>
  <book isbn="978-1-4028-9462-6">
    <title xml:lang="en">A &lt;Weird&gt; Tale</title>
    <author>Jane Doe</author>
    <meta key="genre" value="fiction"/>
    <meta key="pages"/>
  </book>
  <book isbn="000-0-00-000000-0">
    <title>Second</title>
    <author>John Roe</author>
  </book>
  <note>catalog checksum: 0xDEAD</note>
</library>