<?xml version="1.0"?>
<!DOCTYPE catalog [
  <!ELEMENT catalog (book+)>
  <!ELEMENT book (title, author, meta?)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT author (#PCDATA)>
  <!ELEMENT meta EMPTY>
  <!ATTLIST book id ID #REQUIRED>
  <!ATTLIST book lang CDATA "en">
]>
<catalog>
  <book id="b1">
    <title>Alpha</title>
    <author>Ada</author>
    <meta/>
  </book>
  <book id="b2" lang="fr">
    <title>Beta</title>
    <author>Bob</author>
  </book>
</catalog>