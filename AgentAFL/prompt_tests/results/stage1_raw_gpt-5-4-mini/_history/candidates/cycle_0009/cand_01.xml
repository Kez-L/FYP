<!DOCTYPE config [
  <!ELEMENT config (entry+, group?)>
  <!ELEMENT entry EMPTY>
  <!ELEMENT group (entry*)>
  <!ATTLIST entry key CDATA #REQUIRED
                  value CDATA #IMPLIED
                  enabled (true|false) "true">
  <!ENTITY hex "&#x41;&#x42;&#x43;">
]>
<config>
  <entry key="alpha" value="&hex;" enabled="true"/>
  <entry key="beta" value="&#10;&#9;line"/>
  <group>
    <entry key="gamma" enabled="false"/>
    <entry key="delta" value="&amp;&lt;&gt;&quot;&apos;"/>
  </group>
  <entry key="epsilon" value="end"/>
</config>