<?xml version="1.0"?>
<!DOCTYPE message [
  <!ELEMENT message (header, body)>
  <!ELEMENT header (from, to)>
  <!ELEMENT body (#PCDATA)>
  <!ELEMENT from (#PCDATA)>
  <!ELEMENT to (#PCDATA)>
  <!ENTITY sender "alice">
  <!ENTITY recipient "bob">
]>
<message>
  <header>
    <from>&sender;</from>
    <to>&recipient;</to>
  </header>
  <body>Hello</body>
</message>