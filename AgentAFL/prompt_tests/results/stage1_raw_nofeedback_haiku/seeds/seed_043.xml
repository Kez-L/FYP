<?xml version="1.0"?>
<!DOCTYPE document [
  <!ELEMENT document (chapter+)>
  <!ELEMENT chapter (title, section*)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT section (#PCDATA | emphasis)*>
  <!ELEMENT emphasis (#PCDATA)>
]>
<document>
  <chapter>
    <title>First</title>
    <section>Text with <emphasis>emphasis</emphasis> here</section>
  </chapter>
</document>