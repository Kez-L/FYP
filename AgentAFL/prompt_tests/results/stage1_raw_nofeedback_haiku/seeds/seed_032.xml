<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE message [
  <!ELEMENT message (header, body)>
  <!ELEMENT header (from, to)>
  <!ELEMENT body (content)>
  <!ELEMENT from (#PCDATA)>
  <!ELEMENT to (#PCDATA)>
  <!ELEMENT content (#PCDATA)>
]>
<message>
  <header>
    <from>sender</from>
    <to>receiver</to>
  </header>
  <body>
    <content>Hello World</content>
  </body>
</message>