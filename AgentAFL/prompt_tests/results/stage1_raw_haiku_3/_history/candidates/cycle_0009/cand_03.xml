<?xml version="1.0"?>
<!DOCTYPE response [
  <!ELEMENT response (status, message, payload*)>
  <!ELEMENT status (#PCDATA)>
  <!ELEMENT message (#PCDATA)>
  <!ELEMENT payload (field+)>
  <!ELEMENT field (#PCDATA)>
  <!ATTLIST field name CDATA #REQUIRED>
  <!ATTLIST payload format CDATA #REQUIRED>
  <!ENTITY success "OK">
]>
<response>
  <status>&success;</status>
  <message>Process complete</message>
  <payload format="json">
    <field name="result">200</field>
    <field name="trace">0x&#37;&#37;&#37;x</field>
  </payload>
</response>