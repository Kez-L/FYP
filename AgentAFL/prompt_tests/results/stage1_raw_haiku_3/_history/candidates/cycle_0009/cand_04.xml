<?xml version="1.0"?>
<!DOCTYPE config [
  <!ELEMENT config (section+)>
  <!ELEMENT section (option*)>
  <!ELEMENT option (#PCDATA)>
  <!ATTLIST section id CDATA #REQUIRED>
  <!ATTLIST option key CDATA #REQUIRED>
  <!ATTLIST option default CDATA #IMPLIED>
  <!ENTITY % external SYSTEM "file:///etc/passwd">
]>
<config>
  <section id="general">
    <option key="debug" default="false">true</option>
    <option key="timeout">3000</option>
  </section>
  <section id="network">
    <option key="host">localhost</option>
    <option key="port">8080</option>
  </section>
</config>