<?xml version="1.0"?>
<!DOCTYPE messages [
  <!ELEMENT messages (message*)>
  <!ELEMENT message (from, to, body)>
  <!ELEMENT from (#PCDATA)>
  <!ELEMENT to (#PCDATA)>
  <!ELEMENT body (#PCDATA)>
  <!ATTLIST message id CDATA #IMPLIED>
  <!ENTITY sender "alice">
]>
<messages>
  <message id="1">
    <from>&sender;</from>
    <to>bob</to>
    <body>Hello</body>
  </message>
</messages>