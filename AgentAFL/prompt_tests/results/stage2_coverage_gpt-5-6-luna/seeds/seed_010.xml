<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE canvas [
  <!ELEMENT canvas (layer*)>
  <!ELEMENT layer (shape|group|text)*>
  <!ELEMENT group (shape|group|text)*>
  <!ELEMENT shape EMPTY>
  <!ELEMENT text (#PCDATA|em|strong|br)*>
  <!ELEMENT em (#PCDATA|strong)*>
  <!ELEMENT strong (#PCDATA)>
  <!ELEMENT br EMPTY>
  <!ATTLIST canvas width CDATA #REQUIRED height CDATA #REQUIRED>
  <!ATTLIST layer id ID #REQUIRED opacity CDATA "1.0">
  <!ATTLIST group id ID #IMPLIED transform CDATA #IMPLIED>
  <!ATTLIST shape kind (rect|circle|path) #REQUIRED x CDATA #IMPLIED y CDATA #IMPLIED>
  <!ATTLIST text id ID #IMPLIED>
  <!ENTITY nbsp "&#160;">
]>
<canvas width="800" height="600">
  <layer id="background">
    <shape kind="rect" x="0" y="0"/>
  </layer>
  <layer id="foreground" opacity="0.75">
    <group id="cluster" transform="rotate(12)">
      <shape kind="circle" x="40" y="50"/>
      <shape kind="path" x="10" y="20"/>
      <text id="caption">A <em>small</em> <strong>vector</strong><br/>drawing&nbsp;sample.</text>
    </group>
  </layer>
</canvas>