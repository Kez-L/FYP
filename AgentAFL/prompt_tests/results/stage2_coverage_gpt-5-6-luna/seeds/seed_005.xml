<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE catalog [
  <!ENTITY % itemdecl "<!ELEMENT item (name, price, note?)>
    <!ATTLIST item sku ID #REQUIRED state (new|used|refurbished) 'new'>">
  %itemdecl;
  <!ENTITY % mode "INCLUDE">
  <![%mode;[
    <!ELEMENT note (#PCDATA)>
  ]]>
  <!ELEMENT catalog (section+)>
  <!ELEMENT section (title, item+)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT price (#PCDATA)>
  <!ATTLIST catalog generated CDATA #IMPLIED>
  <!ATTLIST section code NMTOKEN #REQUIRED>
  <!ENTITY company "A &amp; B Trading">
  <!ENTITY dash "&#x2014;">
]>
