<?xml version="1.0"?>
<!DOCTYPE media [
  <!ELEMENT media (record*)>
  <!ELEMENT record (title, creator+, payload?)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT creator (#PCDATA)>
  <!ELEMENT payload EMPTY>
  <!ATTLIST media
    version CDATA #REQUIRED
    format NOTATION (binary|text) "text">
  <!ATTLIST record
    code ID #REQUIRED
    related IDREFS #IMPLIED
    category (audio|video|image) #REQUIRED>
  <!ATTLIST payload
    source ENTITY #REQUIRED
    checksum CDATA #IMPLIED>
  <!NOTATION binary SYSTEM "application/octet-stream">
  <!NOTATION text SYSTEM "text/plain">
  <!ENTITY cover SYSTEM "cover.dat" NDATA binary>
  <!ENTITY poster SYSTEM "poster.txt" NDATA text>
  <!ENTITY copyright "Copyright © 2026">
]>
<media version="2" format="text">
  <record code="r1" category="audio" related="r2">
    <title>Signals &amp; Noise</title>
    <creator>Ævar Jónsson</creator>
    <payload source="cover" checksum="sha256:deadbeef"/>
  </record>
  <record code="r2" category="image" related="r1">
    <title>Cover &copyright;</title>
    <creator>Studio Delta</creator>
    <payload source="poster"/>
  </record>
</media>