<?xml version="1.0"?>
<!DOCTYPE inventory [
  <!ELEMENT inventory (asset*, bundle?)>
  <!ELEMENT asset EMPTY>
  <!ELEMENT bundle (asset+)>
  <!ATTLIST asset
    src ENTITY #IMPLIED
    format NOTATION (gif|svg) #IMPLIED
    checksum NMTOKEN #IMPLIED>
  <!ATTLIST bundle id ID #REQUIRED>
  <!NOTATION gif SYSTEM "image/gif">
  <!NOTATION svg PUBLIC "-//W3C//DTD SVG 1.1//EN" "http://www.w3.org/Graphics/SVG/1.1/DTD/svg11.dtd">
  <!ENTITY logo SYSTEM "images/logo.gif" NDATA gif>
  <!ENTITY mark SYSTEM "images/mark.svg" NDATA svg>
]>
<inventory>
  <asset src="logo" format="gif" checksum="a1b2c3"/>
  <bundle id="media-pack">
    <asset src="mark" format="svg"/>
    <asset src="logo" format="gif"/>
  </bundle>
</inventory>