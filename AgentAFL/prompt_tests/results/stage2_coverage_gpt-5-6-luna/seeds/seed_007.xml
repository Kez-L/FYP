<?xml version="1.0" encoding="UTF-8"?>
<workspace xmlns="urn:example:workspace"
           xmlns:ui="urn:example:ui"
           xmlns:data="urn:example:data"
           xml:lang="fr"
           xml:space="preserve">
  <!-- whitespace inside this element is significant -->
  <?render mode="compact"?>
  <header ui:role="banner" data:version="v1.0">
    <ui:label><![CDATA[Résumé & détails]]></ui:label>
    <ui:shortcut key="Ctrl+S" action="save"/>
  </header>
  <panel id="main" ui:collapsed="false">
    <title>Éléments sélectionnés</title>
    <description>Text before <emphasis>inline markup</emphasis> and after.</description>
    <data:table data:rows="2">
      <data:row data:index="0"><data:cell><![CDATA[A < B]]></data:cell></data:row>
      <data:row data:index="1"><data:cell>Δ &amp; Ω</data:cell></data:row>
    </data:table>
  </panel>
  <footer xmlns:ui="">
    <copyright>2026</copyright>
  </footer>
</workspace>