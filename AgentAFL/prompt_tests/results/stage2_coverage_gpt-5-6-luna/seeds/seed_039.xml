<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE package [
  <!ENTITY % optional '
    <!ELEMENT metadata (creator, tag*)>
    <!ELEMENT creator (#PCDATA)>
    <!ELEMENT tag (#PCDATA)>
  '>
  <!ENTITY % enableMeta "INCLUDE">
  <![%enableMeta;[
    %optional;
  ]]>
  <!ELEMENT package (metadata?, manifest, content)>
  <!ATTLIST package
    id ID #REQUIRED
    profile (minimal|full) "full">
  <!ELEMENT manifest (file+)>
  <!ELEMENT file EMPTY>
  <!ATTLIST file
    id ID #REQUIRED
    path CDATA #REQUIRED
    kind (resource|document|index) "resource"
    size NMTOKEN #IMPLIED>
  <!ELEMENT content (section+)>
  <!ELEMENT section (heading, block*)>
  <!ATTLIST section
    file IDREF #REQUIRED
    level (1|2|3) "1">
  <!ELEMENT heading (#PCDATA)>
  <!ELEMENT block (text|list|table)>
  <!ELEMENT text (#PCDATA|strong|link|entityref)*>
  <!ELEMENT strong (#PCDATA)>
  <!ELEMENT link (#PCDATA)>
  <!ATTLIST link href CDATA #REQUIRED>
  <!ELEMENT entityref EMPTY>
  <!ATTLIST entityref name NMTOKEN #REQUIRED>
  <!ELEMENT list (item+)>
  <!ELEMENT item (#PCDATA|strong|link)*>
  <!ELEMENT table (tr+)>
  <!ELEMENT tr (td+)>
  <!ELEMENT td (#PCDATA)>
  <!ENTITY copyright "&#169;">
]>
