<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE dashboard [
  <!ENTITY % common '
    <!ELEMENT value (#PCDATA)>
    <!ATTLIST value unit CDATA #IMPLIED>
  '>
  %common;
  <!ELEMENT dashboard (panel*)>
  <!ELEMENT panel (caption?, value*, item*)>
  <!ATTLIST panel name CDATA #REQUIRED>
  <!ELEMENT caption (#PCDATA)>
  <!ELEMENT item EMPTY>
  <!ATTLIST item
    key NMTOKEN #REQUIRED
    priority (low|normal|urgent) "normal"
    active (yes|no) "yes">
  <!ENTITY nbsp "&#160;">
]>
<dashboard>
  <panel name="system">
    <caption>Load&nbsp;average</caption>
    <value unit="ms">12.5</value>
    <value unit="%" >87</value>
    <item key="cpu" priority="urgent"/>
    <item key="io" active="no"/>
  </panel>
  <panel name="user &quot;events&quot;">
    <value>alpha &amp; beta</value>
    <item key="x9"/>
  </panel>
</dashboard>