<?xml version="1.0"?>
<!DOCTYPE catalog [
  <!ELEMENT catalog (section+)>
  <!ELEMENT section (title, item*)>
  <!ATTLIST section
    id ID #REQUIRED
    kind (hardware|software|service) "software">
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT item (name, description?, link*)>
  <!ATTLIST item
    id ID #REQUIRED
    related IDREFS #IMPLIED
    status (new|active|retired) "active">
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT description (#PCDATA|em|code)*>
  <!ELEMENT em (#PCDATA)>
  <!ELEMENT code (#PCDATA)>
  <!ELEMENT link EMPTY>
  <!ATTLIST link
    target IDREF #REQUIRED
    rel CDATA #IMPLIED>
  <!ENTITY product "XML &amp; validation">
]>
<catalog>
  <section id="s1" kind="software">
    <title>Parser tools</title>
    <item id="i1" status="new">
      <name>&product;</name>
      <description>Utilities for <em>structured</em> data and <code>schemas</code>.</description>
      <link target="i2" rel="dependency"/>
    </item>
    <item id="i2" related="i1">
      <name>Tokenizer</name>
      <description><![CDATA[accepts <tags>, quotes, and ]]> markers]]></description>
    </item>
  </section>
</catalog>