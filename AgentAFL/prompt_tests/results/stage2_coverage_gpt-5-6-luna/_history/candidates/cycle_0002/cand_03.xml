<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE report [
  <!ELEMENT report (heading, body, appendix?)>
  <!ELEMENT heading (#PCDATA)>
  <!ELEMENT body (section+)>
  <!ELEMENT section (heading, (paragraph|list|table|section)*)>
  <!ELEMENT paragraph (#PCDATA|b|i|code)*>
  <!ELEMENT b (#PCDATA)>
  <!ELEMENT i (#PCDATA)>
  <!ELEMENT code (#PCDATA)>
  <!ELEMENT list (item+)>
  <!ELEMENT item (#PCDATA|b|i|code)*>
  <!ELEMENT table (row+)>
  <!ELEMENT row (cell+)>
  <!ELEMENT cell (#PCDATA)>
  <!ELEMENT appendix ANY>
  <!ATTLIST section level NMTOKEN "1">
  <!ATTLIST row key ID #IMPLIED>
  <!ENTITY product "parser">
  <!ENTITY phrase "coverage &amp; diagnostics">
  <!ENTITY % extra "audit CDATA #IMPLIED">
  <!ATTLIST report %extra;>
]>
<report audit="nightly">
  <heading>&product; &phrase;</heading>
  <body>
    <section level="1">
      <heading>Overview</heading>
      <paragraph>This <b>report</b> contains <i>mixed</i> content and <code>markup</code>.</paragraph>
      <list>
        <item>first item</item>
        <item>second item with <b>emphasis</b></item>
      </list>
      <table>
        <row key="r1"><cell>left</cell><cell>right</cell></row>
        <row><cell>one</cell><cell>two</cell><cell>three</cell></row>
      </table>
    </section>
    <section level="2">
      <heading>Nested section</heading>
      <section level="3"><heading>Leaf</heading><paragraph>End.</paragraph></section>
    </section>
  </body>
  <appendix><raw><![CDATA[unparsed <payload> & symbols]]></raw></appendix>
</report>