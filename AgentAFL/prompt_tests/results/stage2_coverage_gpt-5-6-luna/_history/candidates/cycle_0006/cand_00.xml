<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE catalog [
  <!ELEMENT catalog (section+)>
  <!ELEMENT section (title, item*)>
  <!ATTLIST section
    id ID #REQUIRED
    kind (hardware|software|mixed) "mixed">
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT item (name, description?, price)>
  <!ATTLIST item
    ref ID #REQUIRED
    related IDREFS #IMPLIED
    active (yes|no) "yes">
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT description (#PCDATA|link)*>
  <!ELEMENT link (#PCDATA)>
  <!ELEMENT price (#PCDATA)>
  <!ENTITY currency "€">
  <!ENTITY note "Use &lt; and &amp; literally.">
]>
<catalog>
  <section id="s-alpha" kind="hardware">
    <title>Devices &amp; Accessories</title>
    <item ref="i-1" active="yes">
      <name>Sensor</name>
      <description>Compact <link>network</link> sensor. &note;</description>
      <price>19.95 &currency;</price>
    </item>
    <item ref="i-2" related="i-1">
      <name>Mount</name>
      <price>4.00 &currency;</price>
    </item>
  </section>
  <section id="s-beta" kind="software">
    <title>Tools</title>
    <item ref="i-3" related="i-1 i-2" active="no">
      <name>Inspector</name>
      <description><![CDATA[raw <markup> and ]]> delimiters]]></description>
      <price>0 &currency;</price>
    </item>
  </section>
</catalog>