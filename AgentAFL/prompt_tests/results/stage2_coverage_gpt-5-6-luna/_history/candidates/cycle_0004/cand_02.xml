<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE report [
  <!ENTITY % feature "INCLUDE">
  <!ENTITY % diagnostics "IGNORE">
  <!ELEMENT report (header, body, appendix?)>
  <!ELEMENT header (generated, source)>
  <!ELEMENT generated (#PCDATA)>
  <!ELEMENT source (#PCDATA)>
  <!ELEMENT body (paragraph|warning|table)*>
  <!ELEMENT paragraph (#PCDATA|em|code)*>
  <!ELEMENT warning (#PCDATA)>
  <!ELEMENT table (row+)>
  <!ELEMENT row (cell+)>
  <!ELEMENT cell (#PCDATA)>
  <!ELEMENT appendix (#PCDATA)>
  <!ELEMENT em (#PCDATA)>
  <!ELEMENT code (#PCDATA)>
  <!ATTLIST warning level (low|medium|high) "medium">
  <![%feature;[
    <!ATTLIST report profile CDATA "standard">
    <!ENTITY marker "enabled">
  ]]>
  <![%diagnostics;[
    <!ELEMENT trace (#PCDATA)>
    <!ATTLIST trace channel CDATA #IMPLIED>
  ]]>
]>
<report profile="extended">
