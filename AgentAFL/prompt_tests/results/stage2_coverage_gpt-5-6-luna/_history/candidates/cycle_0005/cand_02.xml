<?xml version="1.0"?>
<!DOCTYPE envelope [
  <!ELEMENT envelope (header, body)>
  <!ELEMENT header EMPTY>
  <!ATTLIST header version CDATA #FIXED "2">
  <!ELEMENT body (message|fault)+>
  <!ELEMENT message (#PCDATA|part)*>
  <!ELEMENT part (#PCDATA)>
  <!ELEMENT fault (code, detail?)>
  <!ELEMENT code (#PCDATA)>
  <!ELEMENT detail (#PCDATA)>
  <!ENTITY left "(">
  <!ENTITY right ")">
]>
<envelope>
  <header version="2"/>
  <body>
    <message>before &left;<part><![CDATA[inside]]></part>&right; after</message>
    <fault>
      <code>W-000</code>
      <detail>unexpected &lt;token&gt; in stream</detail>
    </fault>
  </body>
</envelope>