<?xml version="1.0"?>
<!DOCTYPE map [
  <!ELEMENT map (pair*)>
  <!ELEMENT pair (key, value)>
  <!ELEMENT key (#PCDATA)>
  <!ELEMENT value (#PCDATA|pair|list)*>
  <!ELEMENT list (item*)>
  <!ELEMENT item (#PCDATA|list)*>
  <!ATTLIST pair type (scalar|object|array) "scalar">
]>
<map>
  <pair type="object">
    <key>profile</key>
    <value>
      <pair><key>name</key><value>Zoë &amp; Co.</value></pair>
      <pair type="array">
        <key>tags</key>
        <value>
          <list>
            <item>one</item>
            <item><list><item>nested</item></list></item>
            <item><![CDATA[two & three]]></item>
          </list>
        </value>
      </pair>
    </value>
  </pair>
</map>