<?xml version="1.0"?>
<!DOCTYPE root [
  <!ELEMENT root (chapter+)>
  <!ELEMENT chapter (heading, section+)>
  <!ATTLIST chapter xml:lang NMTOKEN #IMPLIED>
  <!ELEMENT heading (#PCDATA)>
  <!ELEMENT section (para|list|section)*>
  <!ATTLIST section number NMTOKEN #IMPLIED>
  <!ELEMENT para (#PCDATA|em|code|br)*>
  <!ELEMENT em (#PCDATA|em)*>
  <!ELEMENT code (#PCDATA)>
  <!ELEMENT br EMPTY>
  <!ELEMENT list (li+)>
  <!ELEMENT li (#PCDATA|para|list)*>
]>
<root>
  <chapter xml:lang="fr">
    <heading>Résumé</heading>
    <section number="1">
      <para>Text <em>with <em>nested</em> emphasis</em><br/> after.</para>
      <list>
        <li>first</li>
        <li><para>second</para><list><li>inner</li></list></li>
      </list>
      <section number="1.1">
        <para><code>&lt;sample/&gt;</code></para>
      </section>
    </section>
  </chapter>
</root>