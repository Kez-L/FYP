<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE catalog [
  <!ENTITY % commonAttrs '
    xml:lang CDATA #IMPLIED
    revision CDATA "1"
  '>
  <!ELEMENT catalog (section+)>
  <!ATTLIST catalog
    %commonAttrs;
    mode (draft|published|archived) "draft">
  <!ELEMENT section (title, entry*)>
  <!ATTLIST section
    key ID #REQUIRED
    %commonAttrs;>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT entry (label, value, note?)>
  <!ATTLIST entry
    id ID #REQUIRED
    state (new|active|retired) "new">
  <!ELEMENT label (#PCDATA)>
  <!ELEMENT value (#PCDATA|emph|code)*>
  <!ELEMENT emph (#PCDATA)>
  <!ELEMENT code (#PCDATA)>
  <!ELEMENT note (#PCDATA)>
  <!ENTITY nbsp "&#160;">
  <![IGNORE[
    <!ELEMENT discarded EMPTY>
  ]]>
]>
<catalog xmlns="urn:example:catalog" mode="published" revision="7">
  <section key="s-main" xml:lang="en">
    <title>Symbols &amp; Names</title>
    <entry id="e-one" state="active">
      <label>Markup</label>
      <value>Use <emph>escaped</emph> text and <code>&lt;tag&gt;</code>.</value>
      <note>Spacing&nbsp;is significant.</note>
    </entry>
    <entry id="e-two">
      <label>Unicode</label>
      <value>naïve café — 東京 — 🐡</value>
    </entry>
  </section>
</catalog>