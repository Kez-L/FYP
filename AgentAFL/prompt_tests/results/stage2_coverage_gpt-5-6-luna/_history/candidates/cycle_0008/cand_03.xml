<?xml version="1.0"?>
<!DOCTYPE journal [
  <!ELEMENT journal (day+)>
  <!ATTLIST journal
    year NMTOKEN #REQUIRED
    xmlns:meta CDATA #FIXED "urn:journal:meta">
  <!ELEMENT day (date, weather?, paragraph+, attachment*)>
  <!ATTLIST day
    id ID #REQUIRED
    mood (calm|busy|uncertain) #IMPLIED>
  <!ELEMENT date (#PCDATA)>
  <!ELEMENT weather (temperature, condition)>
  <!ELEMENT temperature (#PCDATA)>
  <!ATTLIST temperature unit (C|F|K) "C">
  <!ELEMENT condition (#PCDATA)>
  <!ELEMENT paragraph (#PCDATA|quote|place|person|br)*>
  <!ELEMENT quote (#PCDATA|br)*>
  <!ELEMENT place (#PCDATA)>
  <!ELEMENT person (#PCDATA)>
  <!ELEMENT br EMPTY>
  <!ELEMENT attachment EMPTY>
  <!ATTLIST attachment
    name CDATA #REQUIRED
    media CDATA "application/octet-stream"
    checksum CDATA #IMPLIED>
  <!ENTITY dash "&#x2014;">
  <!ENTITY note "Remember to verify the source.">
]>
<journal xmlns="urn:journal:main" xmlns:meta="urn:journal:meta" year="2026">
  <day id="d-0917" mood="uncertain">
    <date>2026-09-17</date>
    <weather>
      <temperature unit="K">289.15</temperature>
      <condition>partly cloudy</condition>
    </weather>
    <paragraph>
      The first observation was <place>North Pier</place>.
      <br/>
      <quote>Small changes become visible when measured.</quote>
      &dash; <person>R. Analyst</person>
    </paragraph>
    <paragraph>Note: &note;</paragraph>
    <attachment name="field-notes.txt" media="text/plain" checksum="sha256:abc123"/>
  </day>
</journal>