<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE museum [
  <!ELEMENT museum (exhibit+, curator?)>
  <!ATTLIST museum
    xmlns CDATA #IMPLIED
    founded NMTOKEN #IMPLIED>
  <!ELEMENT exhibit (#PCDATA|artifact|caption|link)*>
  <!ATTLIST exhibit
    code ID #REQUIRED
    era (ancient|modern|future) "modern"
    featured (yes|no) "no">
  <!ELEMENT artifact EMPTY>
  <!ATTLIST artifact
    ref IDREF #IMPLIED
    material CDATA #IMPLIED>
  <!ELEMENT caption (#PCDATA)>
  <!ELEMENT link EMPTY>
  <!ATTLIST link
    target URI #REQUIRED>
  <!ELEMENT curator (#PCDATA)>
  <!NOTATION jpeg SYSTEM "image/jpeg">
  <!ENTITY mark "&#x2605;">
]>
<museum xmlns="urn:example:museum" founded="2024">
  <exhibit code="x1" era="ancient" featured="yes">
    &mark; <caption>Stone &amp; bronze</caption>
    <artifact ref="a1" material="granite"/>
    <link target="https://example.invalid/exhibits/x1"/>
  </exhibit>
  <exhibit code="x2">
    <caption><![CDATA[Modern <design> and ]]> details]]></caption>
    <artifact ref="a1"/>
  </exhibit>
  <curator>Zoë &amp; 李</curator>
</museum>