<?xml version="1.1"?>
<!DOCTYPE feed [
  <!ELEMENT feed (head, item*)>
  <!ATTLIST feed xmlns CDATA #IMPLIED xmlns:x CDATA #IMPLIED>
  <!ELEMENT head (name, link+, generated?)>
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT link EMPTY>
  <!ATTLIST link rel (self|alternate|archive) #REQUIRED href CDATA #REQUIRED>
  <!ELEMENT generated (#PCDATA)>
  <!ELEMENT item (title, summary, content, tag*)>
  <!ATTLIST item key ID #REQUIRED xml:lang NMTOKEN #IMPLIED>
  <!ELEMENT title (#PCDATA|x:mark)*>
  <!ELEMENT summary (#PCDATA|x:mark|x:br)*>
  <!ELEMENT content (#PCDATA|x:mark|x:code|x:br)*>
  <!ELEMENT tag (#PCDATA)>
  <!ATTLIST tag primary (yes|no) "no">
  <!ENTITY punctuation " &amp; ">
]>
<feed xmlns="urn:example:feed" xmlns:x="urn:example:format">
  <head>
    <name>Signal &amp; Noise</name>
    <link rel="self" href="urn:feed:current"/>
    <link rel="alternate" href="https://example.invalid/stream"/>
    <generated>2026-09-17T12:00:00Z</generated>
  </head>
  <item key="entry-1" xml:lang="en">
    <title>Namespaced <x:mark>markup</x:mark></title>
    <summary>Text with<x:br/>line boundaries&punctuation;entities.</summary>
    <content><![CDATA[raw <payload> remains literal]]> <x:code>if (x &lt; 4) return;</x:code></content>
    <tag primary="yes">xml</tag>
    <tag>fuzzing</tag>
  </item>
</feed>