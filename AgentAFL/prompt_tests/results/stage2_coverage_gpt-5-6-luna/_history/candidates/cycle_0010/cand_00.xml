<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE canvas [
  <!NOTATION png SYSTEM "image/png">
  <!ENTITY brand "Vector &amp; Raster">
  <!ENTITY copy "&#169;">
  <!ENTITY % shapes "circle|path|text">
  <!ELEMENT canvas (metadata?, layer+)>
  <!ATTLIST canvas
    xmlns CDATA #FIXED "urn:graphics:canvas"
    width NMTOKEN #REQUIRED
    height NMTOKEN #REQUIRED
    background CDATA "white">
  <!ELEMENT metadata (#PCDATA)>
  <!ELEMENT layer (title?, (%shapes;)*)>
  <!ATTLIST layer id ID #REQUIRED visible (yes|no) "yes">
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT circle EMPTY>
  <!ATTLIST circle cx CDATA #REQUIRED cy CDATA #REQUIRED r CDATA #REQUIRED>
  <!ELEMENT path (#PCDATA)>
  <!ELEMENT text (#PCDATA)>
  <!ATTLIST text x CDATA #IMPLIED y CDATA #IMPLIED>
  <!ENTITY sample SYSTEM "sample.png" NDATA png>
]>
<canvas xmlns="urn:graphics:canvas" width="640" height="480">
  <metadata>&brand; &copy;</metadata>
  <layer id="background">
    <title>Backdrop</title>
    <circle cx="320" cy="240" r="200"/>
  </layer>
  <layer id="foreground" visible="yes">
    <path><![CDATA[M0 0 L640 480 Z]]></path>
    <text x="24" y="48">Layered <![CDATA[<vector>]]> output</text>
  </layer>
</canvas>