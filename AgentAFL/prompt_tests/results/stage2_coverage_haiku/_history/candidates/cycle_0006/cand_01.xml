<!DOCTYPE data [
<!ELEMENT data (record*)>
<!ELEMENT record (field+)>
<!ELEMENT field (#PCDATA|nested)*>
<!ELEMENT nested (#PCDATA)>
<!ATTLIST record status (active|inactive|pending) "active">
<!ATTLIST field name CDATA #REQUIRED index CDATA #IMPLIED>
<!ATTLIST nested level CDATA "0">
<!ENTITY % common "xmlns CDATA #FIXED 'http://example.org'">
]>
<data>
  <record status="active">
    <field name="f1" index="0">Value1<nested level="1">Nested</nested></field>
    <field name="f2">Value2</field>
  </record>
  <record status="inactive">
    <field name="f3">&#160;&#160;</field>
  </record>
</data>