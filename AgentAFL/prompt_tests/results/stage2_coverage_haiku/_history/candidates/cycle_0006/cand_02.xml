<?xml version="1.0"?>
<!DOCTYPE manifest [
<!ELEMENT manifest (component+, dependencies?)>
<!ELEMENT component (description?, metadata*)>
<!ELEMENT description (#PCDATA)>
<!ELEMENT metadata EMPTY>
<!ELEMENT dependencies (require+)>
<!ELEMENT require EMPTY>
<!ATTLIST component name CDATA #REQUIRED version CDATA #REQUIRED>
<!ATTLIST metadata key CDATA #REQUIRED value CDATA #REQUIRED>
<!ATTLIST require module CDATA #REQUIRED minVersion CDATA #IMPLIED maxVersion CDATA #IMPLIED>
]>
<manifest>
  <component name="core" version="2.1">
    <description>Core functionality module</description>
    <metadata key="author" value="dev"/>
    <metadata key="license" value="MIT"/>
  </component>
  <component name="ui" version="1.5"/>
  <dependencies>
    <require module="core" minVersion="2.0"/>
    <require module="stdlib"/>
  </dependencies>
</manifest>