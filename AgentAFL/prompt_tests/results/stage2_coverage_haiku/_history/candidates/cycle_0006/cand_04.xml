<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE feed [
<!ELEMENT feed (title, link*, entry*)>
<!ELEMENT title (#PCDATA)>
<!ELEMENT link EMPTY>
<!ELEMENT entry (id, title, author?, content, published)>
<!ELEMENT id (#PCDATA)>
<!ELEMENT author (#PCDATA)>
<!ELEMENT content (#PCDATA|span)*>
<!ELEMENT span (#PCDATA)>
<!ELEMENT published (#PCDATA)>
<!ATTLIST feed xmlns CDATA #FIXED "http://www.w3.org/2005/Atom" version CDATA "1.0">
<!ATTLIST link rel CDATA #REQUIRED href CDATA #REQUIRED type CDATA #IMPLIED>
<!ATTLIST entry updated CDATA #IMPLIED>
<!ATTLIST content type (text|html|xhtml) "text">
<!ATTLIST span class CDATA #IMPLIED>
]>
<feed xmlns="http://www.w3.org/2005/Atom" version="1.0">
  <title>Example Feed</title>
  <link rel="self" href="http://example.org/feed" type="application/atom+xml"/>
  <entry updated="2024-01-01T00:00:00Z">
    <id>urn:uuid:1234</id>
    <title>First Entry</title>
    <author>John</author>
    <content type="html">Hello <span class="highlight">World</span></content>
    <published>2024-01-01T00:00:00Z</published>
  </entry>
</feed>