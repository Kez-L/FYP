<!DOCTYPE config [
<!ELEMENT config (section*)>
<!ELEMENT section (param+)>
<!ELEMENT param EMPTY>
<!ATTLIST section name CDATA #REQUIRED>
<!ATTLIST param key CDATA #REQUIRED value CDATA #IMPLIED default CDATA #FIXED "null">
<!ELEMENT nested (deep*)>
<!ELEMENT deep (#PCDATA | nested)*>
]>
<config>
  <section name="database">
    <param key="host" value="localhost" default="null"/>
    <param key="port" value="5432" default="null"/>
  </section>
  <section name="logging">
    <param key="level" value="DEBUG" default="null"/>
  </section>
</config>