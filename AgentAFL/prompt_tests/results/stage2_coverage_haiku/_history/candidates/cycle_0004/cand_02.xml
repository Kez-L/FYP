<?xml version="1.0"?>
<!DOCTYPE html [
<!ELEMENT html (head, body)>
<!ELEMENT head (title, meta*)>
<!ELEMENT title (#PCDATA)>
<!ELEMENT meta EMPTY>
<!ELEMENT body (div+)>
<!ELEMENT div (p | span)*>
<!ELEMENT p (#PCDATA | span | br)*>
<!ELEMENT span (#PCDATA)>
<!ELEMENT br EMPTY>
<!ATTLIST meta name CDATA #REQUIRED content CDATA #REQUIRED>
<!ATTLIST div class CDATA #IMPLIED id ID #IMPLIED>
<!ATTLIST span style CDATA #IMPLIED>
]>
<html>
  <head>
    <title>Test Page</title>
    <meta name="charset" content="utf-8"/>
  </head>
  <body>
    <div id="main" class="container">
      <p>Hello <span style="color:red">World</span><br/></p>
    </div>
  </body>
</html>