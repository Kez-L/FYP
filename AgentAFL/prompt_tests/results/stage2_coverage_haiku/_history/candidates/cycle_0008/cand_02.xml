<?xml version="1.0" encoding="ISO-8859-1"?>
<!DOCTYPE catalog [
<!ELEMENT catalog (product+)>
<!ELEMENT product (name, price, stock)>
<!ELEMENT name (#PCDATA)>
<!ELEMENT price (#PCDATA)>
<!ELEMENT stock (#PCDATA)>
<!ATTLIST product sku CDATA #REQUIRED>
<!ATTLIST product inStock (yes|no) "yes">
<!ATTLIST price currency (USD|EUR|GBP) "USD">
<!ENTITY discount "0.15">
]>
<catalog>
  <product sku="PROD001" inStock="yes">
    <name>Widget</name>
    <price currency="USD">29.99</price>
    <stock>100</stock>
  </product>
  <product sku="PROD002" inStock="no">
    <name>Gadget</name>
    <price currency="EUR">49.50</price>
    <stock>0</stock>
  </product>
</catalog>