<?xml version="1.0"?>
<!DOCTYPE svg [
<!ELEMENT svg (circle | rect | polygon)*>
<!ELEMENT circle EMPTY>
<!ELEMENT rect EMPTY>
<!ELEMENT polygon EMPTY>
<!ATTLIST circle cx CDATA #REQUIRED cy CDATA #REQUIRED r CDATA #REQUIRED fill CDATA #IMPLIED>
<!ATTLIST rect x CDATA #REQUIRED y CDATA #REQUIRED width CDATA #REQUIRED height CDATA #REQUIRED>
<!ATTLIST polygon points CDATA #REQUIRED>
]>
<svg>
  <circle cx="50" cy="50" r="40" fill="red"/>
  <rect x="10" y="10" width="100" height="50"/>
  <polygon points="0,0 100,0 50,100"/>
</svg>