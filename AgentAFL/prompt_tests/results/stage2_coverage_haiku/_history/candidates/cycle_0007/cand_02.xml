<?xml version="1.0" encoding="ISO-8859-1"?>
<!DOCTYPE message [
<!ELEMENT message (header, body, footer?)>
<!ELEMENT header (from, to, subject)>
<!ELEMENT body (paragraph+)>
<!ELEMENT footer EMPTY>
<!ELEMENT from (#PCDATA)>
<!ELEMENT to (#PCDATA)>
<!ELEMENT subject (#PCDATA)>
<!ELEMENT paragraph (#PCDATA | emphasis)*>
<!ELEMENT emphasis (#PCDATA)>
<!ATTLIST message priority (high|normal|low) "normal" timestamp CDATA #IMPLIED>
<!ATTLIST footer generated CDATA #IMPLIED>
]>
<message priority="high" timestamp="2024-01-15T10:30:00Z">
  <header>
    <from>sender@example.com</from>
    <to>recipient@example.com</to>
    <subject>Important Update</subject>
  </header>
  <body>
    <paragraph>This is the first paragraph with <emphasis>emphasized text</emphasis>.</paragraph>
    <paragraph>Second paragraph content here.</paragraph>
  </body>
  <footer generated="true"/>
</message>