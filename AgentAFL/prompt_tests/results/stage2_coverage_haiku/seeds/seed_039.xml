<?xml version="1.0"?>
<!DOCTYPE metadata [
<!ELEMENT metadata (item+)>
<!ELEMENT item (key, value)>
<!ELEMENT key (#PCDATA)>
<!ELEMENT value (#PCDATA | nested)*>
<!ELEMENT nested (#PCDATA)>
<!ATTLIST metadata version CDATA #REQUIRED>
<!ATTLIST item index NMTOKEN #REQUIRED>
<!ATTLIST value type (string|number|boolean) "string">
<!ENTITY ns "http://namespace.example.org/">
]>
<metadata version="2.0">
  <item index="1">
    <key>setting_one</key>
    <value type="string">enabled</value>
  </item>
  <item index="2">
    <key>setting_two</key>
    <value type="number">42<nested>inner</nested></value>
  </item>
</metadata>