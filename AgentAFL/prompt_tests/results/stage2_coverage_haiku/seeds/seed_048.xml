<?xml version="1.0"?>
<!DOCTYPE library [
<!ELEMENT library (book | magazine)*>
<!ELEMENT book (title, author+, isbn, pages, edition?, reviews?)>
<!ELEMENT magazine (title, issue, articles)>
<!ELEMENT title (#PCDATA)>
<!ELEMENT author (firstname, lastname, email?)>
<!ELEMENT firstname (#PCDATA)>
<!ELEMENT lastname (#PCDATA)>
<!ELEMENT email (#PCDATA)>
<!ELEMENT isbn (#PCDATA)>
<!ELEMENT pages (#PCDATA)>
<!ELEMENT edition (#PCDATA)>
<!ELEMENT issue (#PCDATA)>
<!ELEMENT articles (article*)>
<!ELEMENT article (headline, wordcount)>
<!ELEMENT headline (#PCDATA)>
<!ELEMENT wordcount (#PCDATA)>
<!ELEMENT reviews (review+)>
<!ELEMENT review (#PCDATA)>
<!ATTLIST book lang (en|fr|de|es) "en" published CDATA #REQUIRED>
<!ATTLIST magazine issueNum CDATA #REQUIRED month (Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec) #IMPLIED>
<!ATTLIST author role (primary|secondary) "primary">
<!ATTLIST review rating (1|2|3|4|5) #REQUIRED reviewer CDATA #IMPLIED>
<!ENTITY copyright "Copyright 2024">
]>
<library>
  <book lang="en" published="2023">
    <title>Advanced XML Parsing</title>
    <author role="primary">
      <firstname>John</firstname>
      <lastname>Doe</lastname>
      <email>john@example.com</email>
    </author>
    <author role="secondary">
      <firstname>Jane</firstname>
      <lastname>Smith</lastname>
    </author>
    <isbn>978-0-123456-78-9</isbn>
    <pages>512</pages>
    <edition>2nd</edition>
    <reviews>
      <review rating="5" reviewer="Expert1">Excellent coverage</review>
      <review rating="4" reviewer="Expert2">Very good</review>
    </reviews>
  </book>
  <magazine issueNum="42" month="Mar">
    <title>Tech Weekly</title>
    <issue>March 2024</issue>
    <articles>
      <article>
        <headline>XML Security Best Practices</headline>
        <wordcount>3500</wordcount>
      </article>
      <article>
        <headline>Fuzzing Strategies</headline>
        <wordcount>2800</wordcount>
      </article>
    </articles>
  </magazine>
</library>