<?xml version="1.0"?>
<!DOCTYPE article [
<!ELEMENT article (title, body)>
<!ELEMENT title (#PCDATA)>
<!ELEMENT body (section+)>
<!ELEMENT section (h2, p+)>
<!ELEMENT h2 (#PCDATA)>
<!ELEMENT p (#PCDATA|emphasis)*>
<!ELEMENT emphasis (#PCDATA)>
<!ATTLIST article version CDATA #REQUIRED status (draft|final) "draft">
<!NOTATION jpeg SYSTEM "image/jpeg">
<!ENTITY fig1 SYSTEM "image.jpg" NDATA jpeg>
]>
<article version="1.0" status="final">
  <title>Test Article</title>
  <body>
    <section>
      <h2>Introduction</h2>
      <p>This is a <emphasis>test</emphasis> paragraph.</p>
      <p>Another paragraph with content.</p>
    </section>
  </body>
</article>