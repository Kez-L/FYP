<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE library [
<!ELEMENT library (book*, magazine*)>
<!ELEMENT book (title, author+, isbn)>
<!ELEMENT magazine (title, issue, pages)>
<!ELEMENT title (#PCDATA)>
<!ELEMENT author (#PCDATA)>
<!ELEMENT isbn (#PCDATA)>
<!ELEMENT issue (#PCDATA)>
<!ELEMENT pages (#PCDATA)>
<!ATTLIST book published CDATA #REQUIRED category (fiction|nonfiction) #REQUIRED>
<!ATTLIST magazine frequency (weekly|monthly|quarterly) "monthly">
<!ATTLIST author role (primary|secondary) "primary">
]>
<library>
  <book published="2020" category="fiction">
    <title>Novel Title</title>
    <author role="primary">John Doe</author>
    <author role="secondary">Jane Smith</author>
    <isbn>978-0-123456-78-9</isbn>
  </book>
  <magazine frequency="weekly">
    <title>Tech Weekly</title>
    <issue>42</issue>
    <pages>50</pages>
  </magazine>
</library>