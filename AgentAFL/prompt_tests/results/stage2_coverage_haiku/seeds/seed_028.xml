<!DOCTYPE svg [
<!ELEMENT svg (defs?, (rect|circle|path)+)>
<!ELEMENT defs (style|pattern)*>
<!ELEMENT style (#PCDATA)>
<!ELEMENT pattern (rect+)>
<!ELEMENT rect EMPTY>
<!ELEMENT circle EMPTY>
<!ELEMENT path EMPTY>
<!ATTLIST svg viewBox CDATA #REQUIRED width CDATA #IMPLIED height CDATA #IMPLIED>
<!ATTLIST rect x CDATA "0" y CDATA "0" width CDATA #REQUIRED height CDATA #REQUIRED fill CDATA #IMPLIED>
<!ATTLIST circle cx CDATA #REQUIRED cy CDATA #REQUIRED r CDATA #REQUIRED fill CDATA "blue">
<!ATTLIST path d CDATA #REQUIRED stroke CDATA #IMPLIED strokeWidth CDATA "1">
<!ATTLIST defs id CDATA #IMPLIED>
]>
<svg viewBox="0 0 100 100" width="100" height="100">
  <defs id="d1">
    <style>rect { fill: red; }</style>
  </defs>
  <rect x="10" y="10" width="20" height="30" fill="green"/>
  <circle cx="50" cy="50" r="15" fill="yellow"/>
  <path d="M 0 0 L 100 100" stroke="black" strokeWidth="2"/>
</svg>