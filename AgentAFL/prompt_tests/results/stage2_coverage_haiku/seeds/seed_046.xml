<?xml version="1.0"?>
<!DOCTYPE document [
<!ELEMENT document (section+)>
<!ELEMENT section (title, content, subsection*)>
<!ELEMENT title (#PCDATA)>
<!ELEMENT content (p | list)*>
<!ELEMENT p (#PCDATA | emphasis)*>
<!ELEMENT emphasis (#PCDATA)>
<!ELEMENT list (entry+)>
<!ELEMENT entry (#PCDATA)>
<!ELEMENT subsection (title, content)>
<!ATTLIST section id ID #REQUIRED class CDATA #IMPLIED weight (low|medium|high) "medium">
<!ATTLIST list ordered (yes|no) "no">
<!ATTLIST entry priority CDATA #IMPLIED>
<!NOTATION gif SYSTEM "image/gif">
<!ENTITY logo SYSTEM "logo.gif" NDATA gif>
]>
<document>
  <section id="sec1" class="primary" weight="high">
    <title>Main Section</title>
    <content>
      <p>Paragraph with <emphasis>emphasis</emphasis> text.</p>
      <list ordered="yes">
        <entry priority="1">First item</entry>
        <entry priority="2">Second item</entry>
      </list>
    </content>
    <subsection>
      <title>Subsection A</title>
      <content>
        <p>Nested content here.</p>
      </content>
    </subsection>
  </section>
  <section id="sec2" weight="low">
    <title>Secondary Section</title>
    <content>
      <p>More content.</p>
    </content>
  </section>
</document>