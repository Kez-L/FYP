<!DOCTYPE report [
  <!ELEMENT report (header, body, footer)>
  <!ELEMENT header (title, meta*)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT meta EMPTY>
  <!ATTLIST meta name CDATA #REQUIRED value CDATA #IMPLIED>
  <!ELEMENT body (para|table|break)*>
  <!ELEMENT para (#PCDATA|b|i|br)*>
  <!ELEMENT b (#PCDATA|i)*>
  <!ELEMENT i (#PCDATA|b)*>
  <!ELEMENT br EMPTY>
  <!ELEMENT table (row+)>
  <!ELEMENT row (cell+)>
  <!ELEMENT cell (#PCDATA|b|i|br)*>
  <!ELEMENT break EMPTY>
  <!ELEMENT footer (#PCDATA)>
]>
<report>
  <header>
    <title>Mixed <b>inline <i>markup</i></b> and <![CDATA[raw ]]> text</title>
    <meta name="empty"/>
    <meta name="quoted" value="&quot;&apos;&amp;&lt;&gt;"/>
  </header>
  <body>
    <para>a<b>b<i>c</i>b</b><br/>d</para>
    <table><row><cell>1</cell><cell><i>2</i></cell></row></table>
    <break/>
  </body>
  <footer>done&#x0D;&#x0A;</footer>
</report>