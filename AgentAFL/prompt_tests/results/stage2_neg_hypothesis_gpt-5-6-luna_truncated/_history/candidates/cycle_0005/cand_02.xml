<?xml version="1.0"?>
<!DOCTYPE switch [
  <!ELEMENT switch (on|off|branch)>
  <!ELEMENT on EMPTY>
  <!ELEMENT off EMPTY>
  <!ELEMENT branch (#PCDATA|on|off)*>
  <!ATTLIST switch mode (fast|slow|unknown) "unknown">
  <!ENTITY % optional "<!ATTLIST branch state CDATA #IMPLIED>">
  %optional;
  <![IGNORE[
    <!ELEMENT ignored EMPTY>
    <!ENTITY hidden "not expanded">
  ]]>
]>
<switch mode="fast">
  <branch state="mixed">before<on/>middle<off/>after</branch>
</switch>