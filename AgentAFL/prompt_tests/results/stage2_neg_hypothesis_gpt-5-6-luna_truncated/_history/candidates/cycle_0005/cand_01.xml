<?xml version="1.0"?>
<!DOCTYPE catalog [
  <!NOTATION jpeg SYSTEM "image/jpeg">
  <!NOTATION text SYSTEM "text/plain">
  <!ELEMENT catalog (entry+, note?)>
  <!ELEMENT entry EMPTY>
  <!ELEMENT note (#PCDATA)>
  <!ATTLIST entry
            id ID #REQUIRED
            kind (image|text|other) "other"
            format NOTATION (jpeg|text) #IMPLIED
            ref ENTITY #IMPLIED>
  <!ENTITY logo SYSTEM "logo.jpg" NDATA jpeg>
  <!ENTITY words "alpha &amp; beta">
]>
<catalog>
  <entry id="e1" kind="image" format="jpeg" ref="logo"/>
  <entry id="e2" kind="text"/>
  <note>&words; &#x2028; <![CDATA[unparsed-looking ]]> text</note>
</catalog>