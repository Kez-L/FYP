<?xml version="1.0"?>
<!DOCTYPE article [
  <!ELEMENT article (title, section+)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT section (heading, p+)>
  <!ELEMENT heading (#PCDATA)>
  <!ELEMENT p (#PCDATA|em|br)*>
  <!ELEMENT em (#PCDATA)>
  <!ELEMENT br EMPTY>
  <!ATTLIST article xml:space (default|preserve) "default">
  <!ENTITY emph "<em>generated emphasis</em>">
]>
<!-- document prologue comment -->
<?index priority="high"?>
<article xml:space="preserve">
  <title>Mixed content &amp; markup</title>
  <section>
    <heading>One</heading>
    <p>Plain text, &emph;, and a line break<br/>followed by <![CDATA[ literal <data> ]]></p>
    <p>Nested-looking text: <em>direct emphasis</em> with numeric &#x20AC; value.</p>
  </section>
  <section>
    <heading>Two</heading>
    <p><?note kind="inline"?>tail<!-- embedded comment -->content</p>
  </section>
</article>