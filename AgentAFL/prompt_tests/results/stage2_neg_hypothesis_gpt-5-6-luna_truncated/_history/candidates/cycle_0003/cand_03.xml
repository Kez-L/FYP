<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE archive [
  <!ELEMENT archive (entry*)>
  <!ELEMENT entry (key, value, metadata?)>
  <!ELEMENT key (#PCDATA)>
  <!ELEMENT value (#PCDATA|linebreak)*>
  <!ELEMENT linebreak EMPTY>
  <!ELEMENT metadata (created, updated?)>
  <!ELEMENT created (#PCDATA)>
  <!ELEMENT updated (#PCDATA)>
  <!ATTLIST entry type (text|binary|link) "text">
  <!ATTLIST entry ident ID #IMPLIED>
  <!ENTITY nbsp "&#160;">
]>
<archive>
  <entry ident="e1" type="text">
    <key>greeting</key>
    <value>Hello&nbsp;world<linebreak/>Next line</value>
    <metadata>
      <created>2026-01-01</created>
      <updated>2026-09-17</updated>
    </metadata>
  </entry>
  <entry ident="e2" type="link">
    <key>target</key>
    <value>https://example.invalid/a?x=1&amp;y=2</value>
  </entry>
  <entry type="binary">
    <key>empty</key>
    <value><![CDATA[AAECAwQFBgcICQ==]]></value>
  </entry>
</archive>