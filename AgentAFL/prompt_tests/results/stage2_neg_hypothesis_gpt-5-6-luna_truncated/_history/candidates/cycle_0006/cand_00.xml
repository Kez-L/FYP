<?xml version="1.0"?>
<!DOCTYPE catalog [
  <!ELEMENT catalog (entry+, note?)>
  <!ELEMENT entry (title, description, link)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT description (#PCDATA|em|br)*>
  <!ELEMENT em (#PCDATA)>
  <!ELEMENT br EMPTY>
  <!ELEMENT link EMPTY>
  <!ATTLIST entry
    id ID #REQUIRED
    status (draft|published|archived) "draft"
  >
  <!ATTLIST link
    href CDATA #REQUIRED
    rel NMTOKENS "related external"
  >
  <!NOTATION text SYSTEM "text/plain">
]>
<catalog>
  <entry id="e1" status="published">
    <title>Alpha</title>
    <description>before <em>inside</em><br/>after</description>
    <link href="urn:example:one" rel="primary"/>
  </entry>
  <entry id="e2">
    <title>Beta</title>
    <description>mixed <em>content</em> with <br/> empty elements</description>
    <link href="#e1"/>
  </entry>
  <note>catalog-end</note>
</catalog>