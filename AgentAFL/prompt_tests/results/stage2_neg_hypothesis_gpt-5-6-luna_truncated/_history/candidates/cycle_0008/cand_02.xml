<?xml version="1.0"?>
<!DOCTYPE report [
  <!ELEMENT report (header, item*)>
  <!ELEMENT header (#PCDATA)>
  <!ELEMENT item (#PCDATA|link)*>
  <!ELEMENT link (#PCDATA)>
  <!ATTLIST item kind (alpha|beta|gamma) "alpha">
  <!ATTLIST link href CDATA #IMPLIED>
  <!ENTITY left  "&#x3C;">
  <!ENTITY right "&#x3E;">
  <!ENTITY quoted "&quot;quoted&quot;">
]>
<report>
  <header>&left;header&right; &quoted;</header>
  <item kind="beta">one<link href="urn:x">two</link>three</item>
  <item kind="gamma">&left;raw-looking&right;</item>
</report>