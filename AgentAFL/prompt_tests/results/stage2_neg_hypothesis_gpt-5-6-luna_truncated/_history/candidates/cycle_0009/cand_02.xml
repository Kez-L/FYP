<?xml version="1.0"?>
<!DOCTYPE root [
  <!ELEMENT root (item|group)*>
  <!ELEMENT item EMPTY>
  <!ELEMENT group (item|group)*>
  <!ATTLIST item
    key NMTOKEN #IMPLIED
    enabled (yes|no) "yes">
  <!ENTITY % feature "<!ELEMENT extra (#PCDATA)>">
  %feature;
]>
<root>
  <group>
    <item key="a"/>
    <group>
      <item key="b" enabled="no"/>
      <extra>conditionally declared</extra>
    </group>
  </group>
  <item key="c"></item>
</root>