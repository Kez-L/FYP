<!DOCTYPE r [
  <!ELEMENT r ANY>
  <!ENTITY plain "alpha">
  <!ENTITY quoted "x&apos;y&quot;z">
  <!ENTITY nested "&plain;:&quoted;:&amp;:&lt;:&gt;">
  <!ATTLIST r
    fixed CDATA #FIXED "a&#x20;b"
    token NMTOKENS "one two&#x20;three"
    required CDATA #REQUIRED>
]>
<r required="&nested;" fixed="a b" token="red green blue">
  <?inside data?>
  <![CDATA[first ]]> second ]]> third]]>
  &plain;
</r>