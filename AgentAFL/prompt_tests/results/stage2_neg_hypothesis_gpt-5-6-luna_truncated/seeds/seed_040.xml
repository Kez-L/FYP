<?xml version="1.1"?>
<!DOCTYPE catalog [
  <!ELEMENT catalog (entry+)>
  <!ELEMENT entry (title, description, metadata?)>
  <!ATTLIST entry
    id ID #REQUIRED
    state (draft|published|retired) "draft"
    ref IDREF #IMPLIED>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT description (#PCDATA|em|code|br)*>
  <!ELEMENT metadata (created, tags?)>
  <!ELEMENT created (#PCDATA)>
  <!ELEMENT tags (tag+)>
  <!ELEMENT tag (#PCDATA)>
  <!ELEMENT em (#PCDATA)>
  <!ELEMENT code (#PCDATA)>
  <!ELEMENT br EMPTY>
]>
<catalog>
  <entry id="e1" state="published">
    <title>Parser &amp; Boundary Tests</title>
    <description>mixed <em>content</em><br/><code>&lt;token&gt;</code> after</description>
    <metadata><created>2026-09-17</created><tags><tag>xml</tag><tag>fuzz</tag></tags></metadata>
  </entry>
  <entry id="e2" ref="e1">
    <title>Second</title>
    <description>text <![CDATA[ ]]> tail</description>
  </entry>
</catalog>