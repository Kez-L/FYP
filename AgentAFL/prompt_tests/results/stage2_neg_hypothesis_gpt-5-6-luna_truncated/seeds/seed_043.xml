<!DOCTYPE envelope [
  <!NOTATION png SYSTEM "image/png">
  <!NOTATION text PUBLIC "-//example//NOTATION Text//EN">
  <!ELEMENT envelope (header, payload, trailer)>
  <!ELEMENT header EMPTY>
  <!ELEMENT payload (#PCDATA)>
  <!ELEMENT trailer (#PCDATA)>
  <!ATTLIST envelope
    schema NOTATION (png|text) "text"
    attachment ENTITY #IMPLIED>
  <!ENTITY logo SYSTEM "logo.png" NDATA png>
  <!ENTITY note SYSTEM "note.txt">
]>
<envelope schema="text" attachment="logo">
  <header/>
  <payload>external references are declared but not expanded here</payload>
  <trailer>done</trailer>
</envelope>