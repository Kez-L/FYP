<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE catalog [
  <!ELEMENT catalog (item+)>
  <!ELEMENT item (label, file)>
  <!ELEMENT label (#PCDATA)>
  <!ELEMENT file EMPTY>
  <!ATTLIST item id ID #REQUIRED category (text|image|binary) #IMPLIED>
  <!ATTLIST file data ENTITY #IMPLIED format NMTOKEN #IMPLIED>
  <!NOTATION bin SYSTEM "application/octet-stream">
  <!ENTITY payload SYSTEM "payload.bin" NDATA bin>
]>
<catalog>
  <item id="record-a" category="binary">
    <label>External payload reference</label>
    <file data="payload" format="bin"/>
  </item>
  <item id="record-b" category="text">
    <label><![CDATA[<not-an-element> & still text]]></label>
    <file format="plain"/>
  </item>
</catalog>