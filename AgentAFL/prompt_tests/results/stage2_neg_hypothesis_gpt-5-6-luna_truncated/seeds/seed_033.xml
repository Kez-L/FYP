<?xml version="1.0"?>
<!DOCTYPE envelope [
  <!ELEMENT envelope (section*, tail?)>
  <!ELEMENT section (name, value?, value?)>
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT value (#PCDATA|mark)*>
  <!ELEMENT mark (#PCDATA)>
  <!ELEMENT tail (#PCDATA)>
  <!ENTITY p "prefix">
  <!ENTITY q "&p;:middle">
  <!ENTITY r "&q;:suffix">
  <!ATTLIST section id ID #IMPLIED>
]>
<envelope>
  <section id="s1">
    <name>&r;</name>
    <value>&p;<mark><![CDATA[inside]]></mark>&q;</value>
    <value>before&#x0A;after&#x20;&amp;</value>
  </section>
  <section>
    <name>second</name>
    <value>solo</value>
  </section>
  <tail>trailing text</tail>
</envelope>