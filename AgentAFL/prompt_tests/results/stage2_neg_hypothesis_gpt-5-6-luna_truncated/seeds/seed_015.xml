<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE manifest [
  <!ELEMENT manifest (header, entry+)>
  <!ELEMENT header (#PCDATA)>
  <!ELEMENT entry (name, value?)>
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT value (#PCDATA)>
  <!ATTLIST entry key NMTOKEN #REQUIRED flags NMTOKENS #IMPLIED>
  <!ENTITY ampword "A &amp; B">
  <!ENTITY quote "&quot;quoted&quot;">
]>
<?build profile="debug"?>
<manifest>
  <!-- metadata before the entries -->
  <header>Release &amp; &amp;word: &amp;word;</header>
  <entry key="alpha" flags="fast checked">
    <name>First &quote;</name>
    <value><![CDATA[raw <value> with ]]> and symbols]]></value>
  </entry>
  <entry key="beta">
    <name>Second</name>
    <value>line one&#x0A;line two &amp;word;</value>
  </entry>
</manifest>