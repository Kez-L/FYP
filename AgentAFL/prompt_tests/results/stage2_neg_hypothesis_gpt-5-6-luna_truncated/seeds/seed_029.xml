<?xml version="1.1"?>
<!DOCTYPE document [
  <!ENTITY % common "<!ELEMENT document (section, trailer)>">
  <!ENTITY % section "<!ELEMENT section (heading, body)>">
  <!ENTITY % body "<!ELEMENT body (#PCDATA|line|mark)*>">
  %common;
  %section;
  %body;
  <!ELEMENT heading (#PCDATA)>
  <!ELEMENT line EMPTY>
  <!ELEMENT mark (#PCDATA)>
  <!ELEMENT trailer EMPTY>
  <!ATTLIST section id ID #REQUIRED>
  <![IGNORE[
    <!ELEMENT ignored EMPTY>
    <!ATTLIST ignored value CDATA #IMPLIED>
  ]]>
  <![INCLUDE[
    <!ENTITY tag "runtime">
  ]]>
]>
<document>
  <section id="s-main">
    <heading>Header &tag;</heading>
    <body>one<line/>two<mark>three</mark>four</body>
  </section>
  <trailer/>
</document>