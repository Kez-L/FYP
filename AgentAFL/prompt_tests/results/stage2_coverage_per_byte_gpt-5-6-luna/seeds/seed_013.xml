<?xml version="1.0" standalone="yes"?>
<!DOCTYPE dashboard [
  <!ELEMENT dashboard (title, panel+)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT panel (heading?, widget*)>
  <!ELEMENT heading (#PCDATA)>
  <!ELEMENT widget (#PCDATA|value)*>
  <!ELEMENT value (#PCDATA)>
  <!ATTLIST panel id ID #REQUIRED>
  <!ATTLIST widget type (text|number|flag) "text">
]>
<dashboard>
