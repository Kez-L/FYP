    <heading><![CDATA[Status ]]> <![CDATA[& health]]></heading>
    <widget type="number"><value>42</value><value>7</value></widget>
    <widget type="flag">true<value><![CDATA[<nested>]]></value></widget>
  </panel>
</dashboard>