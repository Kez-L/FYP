<?xml version="1.0"?>
<!DOCTYPE catalog [
  <!NOTATION svg SYSTEM "image/svg+xml">
  <!ENTITY logo SYSTEM "logo.dat" NDATA svg>
  <!ENTITY part "<part role='generated'>x&amp;y</part>">
  <!ELEMENT catalog (section+, logo?)>
  <!ELEMENT section (entry*)>
  <!ELEMENT entry (#PCDATA|ref|part)*>
  <!ELEMENT ref EMPTY>
  <!ELEMENT part (#PCDATA)>
  <!ELEMENT logo EMPTY>
  <!ATTLIST catalog
    xml:lang NMTOKEN "en"
    asset ENTITY #IMPLIED>
  <!ATTLIST section name ID #REQUIRED>
  <!ATTLIST ref target IDREF #IMPLIED>
]>
<catalog xml:lang="fr" asset="logo">
  <section name="intro">
    <entry>before<ref target="missing"/>&part;after</entry>
  </section>
  <logo/>
</catalog>