<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!DOCTYPE report [
  <!ELEMENT report (title, record*)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT record (field+)>
  <!ELEMENT field (#PCDATA|emph)*>
  <!ELEMENT emph (#PCDATA)>
  <!ATTLIST record rid ID #REQUIRED status (new|old) "new">
  <!ATTLIST field name CDATA #IMPLIED>
  <!ENTITY begin-emph "<emph>">
  <!ENTITY end-emph "</emph>">
  <!ENTITY nbsp "&#160;">
]>
<report>
  <title>Daily&nbsp;summary</title>
  <record rid="r-001">
    <field name="intro">plain text, &begin-emph;highlighted&end-emph; text</field>
    <field name="empty"/>
  </record>
  <record rid="r-002" status="old">
    <field name="body">A &begin-emph;second&nbsp;entry&end-emph;.</field>
  </record>
</report>