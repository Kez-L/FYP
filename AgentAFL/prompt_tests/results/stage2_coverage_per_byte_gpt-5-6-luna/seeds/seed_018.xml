<?xml version="1.0"?>
<!DOCTYPE matrix [
  <!ELEMENT matrix (row+)>
  <!ELEMENT row (cell+)>
  <!ELEMENT cell (#PCDATA)>
  <!ATTLIST matrix dimensions CDATA #FIXED "2x2">
  <!ATTLIST row number NMTOKEN #REQUIRED>
  <!ATTLIST cell kind (literal|computed) "literal"
                note CDATA "&amp;">
  <!ENTITY amp "&amp;">
  <!ENTITY twice "&amp;&amp;">
]>
<matrix dimensions="2x2">
  <row number="first">
    <cell kind="computed">1 &twice; 2</cell>
    <cell note="A &amp; B">plain</cell>
  </row>
  <row number="second">
    <cell><![CDATA[3 < 4]]></cell>
    <cell>5 &amp; 6</cell>
  </row>
</matrix>