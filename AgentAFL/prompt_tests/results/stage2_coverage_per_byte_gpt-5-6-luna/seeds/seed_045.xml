<?xml version="1.0"?>
<!DOCTYPE map [
  <!ELEMENT map ANY>
  <!ELEMENT node ANY>
  <!ATTLIST node
    key ID #IMPLIED
    ref IDREF #IMPLIED
    kind (leaf|branch|ghost) "leaf">
  <!ENTITY local "A&amp;B&lt;C">
  <!ENTITY nested "&local;::&local;">
]>
<map>
  <node key="root" kind="branch">
    &nested;
    <node key="child" ref="root">payload</node>
    <node kind="ghost"/>
  </node>
</map>