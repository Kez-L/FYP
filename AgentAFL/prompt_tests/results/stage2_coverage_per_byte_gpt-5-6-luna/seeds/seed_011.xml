<?xml version="1.0"?>
<!DOCTYPE archive [
  <!ELEMENT archive (record*, binary)>
  <!ELEMENT record EMPTY>
  <!ATTLIST record key ID #REQUIRED ref IDREF #IMPLIED>
  <!ELEMENT binary EMPTY>
  <!ATTLIST binary source ENTITY #IMPLIED format NOTATION #IMPLIED>
  <!NOTATION png SYSTEM "image/png">
  <!ENTITY payload SYSTEM "unavailable.dat" NDATA png>
]>
<archive xmlns:a="urn:archive" a:mode="cold">
  <record key="first"/>
  <record key="second" ref="first"/>
  <binary source="payload" format="png"/>
</archive>