<!DOCTYPE graph [
  <!ELEMENT graph (vertex+, edge*)>
  <!ELEMENT vertex EMPTY>
  <!ELEMENT edge EMPTY>
  <!ATTLIST vertex
    id ID #REQUIRED
    label CDATA #IMPLIED
    hidden (yes|no) "no">
  <!ATTLIST edge
    from IDREF #REQUIRED
    to IDREF #REQUIRED
    weight CDATA "1.0">
]>
<graph>
  <vertex id="v1" label="left &amp; right" hidden="yes"/>
  <vertex id="v2" label="line&#10;break"/>
  <vertex id="v3"/>
  <edge from="v1" to="v2" weight="-0.0"/>
  <edge from="v2" to="v3" weight="NaN"/>
  <edge from="missing" to="v1"/>
</graph>