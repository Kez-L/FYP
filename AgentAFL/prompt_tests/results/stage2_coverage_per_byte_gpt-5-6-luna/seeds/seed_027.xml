<?xml version="1.0"?>
<!DOCTYPE transfer [
  <!NOTATION bin SYSTEM "application/octet-stream">
  <!ENTITY blob SYSTEM "blob.dat" NDATA bin>
  <!ENTITY pct "percent">
  <!ENTITY pair "&pct;:&pct;">
  <!ELEMENT transfer (header, records, trailer?)>
  <!ELEMENT header (source, destination, checksum?)>
  <!ELEMENT source (#PCDATA)>
  <!ELEMENT destination (#PCDATA)>
  <!ELEMENT checksum EMPTY>
  <!ELEMENT records (record*)>
  <!ELEMENT record (field|attachment)*>
  <!ELEMENT field (#PCDATA)>
  <!ELEMENT attachment EMPTY>
  <!ELEMENT trailer (#PCDATA)>
  <!ATTLIST transfer mode (push|pull|mirror) "mirror" stamp CDATA #IMPLIED>
  <!ATTLIST source id ID #REQUIRED>
  <!ATTLIST destination ref IDREF #REQUIRED>
  <!ATTLIST record rid ID #REQUIRED parent IDREF #IMPLIED>
  <!ATTLIST attachment src ENTITY #IMPLIED media NOTATION bin>
]>
<transfer mode="push" stamp="&pair;">
  <header>
    <source id="origin">node-A</source>
    <destination ref="origin">node-B</destination>
    <checksum algorithm="sha256"/>
  </header>
  <records>
    <record rid="r1">
      <field>alpha &amp; beta</field>
      <attachment src="blob" media="bin"/>
      <field><![CDATA[x]]></field>
    </record>
    <record rid="r2" parent="r1">
      <field>line one
line two</field>
    </record>
  </records>
  <trailer>done</trailer>
</transfer>