<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<!DOCTYPE graph [
  <!ELEMENT graph (node+, edge*)>
  <!ELEMENT node EMPTY>
  <!ATTLIST node
    id ID #REQUIRED
    label CDATA #IMPLIED
    refs IDREFS #IMPLIED
    icon ENTITY #IMPLIED>
  <!ELEMENT edge EMPTY>
  <!ATTLIST edge
    from IDREF #REQUIRED
    to IDREF #REQUIRED
    weight NMTOKEN "1">
  <!NOTATION png SYSTEM "image/png">
  <!ENTITY unused SYSTEM "asset.png" NDATA png>
]>
<graph>
  <node id="n1" label="root" refs="n2 n3"/>
  <node id="n2" label="left"/>
  <node id="n3" label="right"/>
  <edge from="n1" to="n2" weight="0x10"/>
  <edge from="n1" to="n3"/>
</graph>