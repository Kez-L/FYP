<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE envelope [
  <!ELEMENT envelope (header, body)>
  <!ELEMENT header (token, timestamp)>
  <!ELEMENT token (#PCDATA)>
  <!ELEMENT timestamp (#PCDATA)>
  <!ELEMENT body (section*)>
  <!ELEMENT section (name, item*)>
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT item (#PCDATA)>
]>
<envelope>
  <header>
    <token>abc&amp;def</token>
    <timestamp>2026-09-17T00:00:00Z</timestamp>
  </header>
  <body>
    <section>
      <name>one</name>
      <item>alpha</item>
      <item>beta</item>
    </section>
  </body>
</envelope>