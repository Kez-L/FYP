<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE report [
  <!ELEMENT report (section|note)+>
  <!ELEMENT section (heading, para+)>
  <!ELEMENT heading (#PCDATA)>
  <!ELEMENT para (#PCDATA|link)*>
  <!ELEMENT link (#PCDATA)>
  <!ELEMENT note (#PCDATA)>
  <!ATTLIST link href URI #IMPLIED>
  <!ENTITY % switch "<!ELEMENT injected EMPTY>">
  %switch;
]>
<report>
  <note xml:lang="fr">Résumé &quot;test&quot;</note>
  <section>
    <heading>Overview</heading>
    <para>See <link href="urn:x:y">details</link> now.</para>
    <para><![CDATA[x < y && y > z]]></para>
  </section>
</report>