<?xml version="1.0"?>
<!DOCTYPE catalog [
  <!ELEMENT catalog (section+)>
  <!ELEMENT section (title, product*)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT product EMPTY>
  <!ATTLIST section
    id ID #REQUIRED
    hidden (yes|no) "no">
  <!ATTLIST product
    sku ID #REQUIRED
    category NMTOKENS #IMPLIED
    discontinued (true|false) "false"
    price CDATA #IMPLIED>
]>
<catalog>
  <section id="s-main" hidden="no">
    <title>Seasonal &amp; clearance</title>
    <product sku="p-1" category="home kitchen" price="19.95"/>
    <product sku="p-2" category="outdoor" discontinued="true" price="0"/>
  </section>
  <section id="s-empty" hidden="yes">
    <title>Nothing here</title>
  </section>
</catalog>