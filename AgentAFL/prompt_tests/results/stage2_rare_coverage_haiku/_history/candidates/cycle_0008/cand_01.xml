<!DOCTYPE root [
<!ELEMENT root (item)*>
<!ELEMENT item (subelement)*>
<!ELEMENT subelement EMPTY>
<!ATTLIST item id ID #REQUIRED name CDATA #IMPLIED>
<!ATTLIST subelement ref IDREF #IMPLIED type (A|B|C) "A">
]>
<root>
  <item id="item1" name="first">
    <subelement ref="item1" type="A"/>
    <subelement ref="item1" type="B"/>
  </item>
  <item id="item2" name="second">
    <subelement ref="item2" type="C"/>
  </item>
</root>