<?xml version="1.0"?>
<config>
  <database host="localhost" port="5432" username="admin" password="secret">
    <connection timeout="30" retries="3"/>
    <pool min="5" max="20" idle="10"/>
  </database>
  <logging level="DEBUG">
    <appender name="file" path="/var/log/app.log"/>
    <appender name="console" format="json"/>
  </logging>
  <features>
    <feature enabled="true">cache</feature>
    <feature enabled="false">experimental</feature>
  </features>
</config>