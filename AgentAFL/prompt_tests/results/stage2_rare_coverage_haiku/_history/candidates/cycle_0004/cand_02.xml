<?xml version="1.0" encoding="UTF-8"?>
<config>
  <database host="localhost" port="5432" user="admin" password="secret" timeout="30">
    <connection poolsize="100" maxwait="5000"/>
    <credentials encrypted="true" hash="md5"/>
  </database>
  <logging level="debug" format="json">
    <appender type="file" path="/var/log/app.log"/>
    <appender type="console" color="true"/>
  </logging>
  <security>
    <ssl enabled="true" protocol="TLSv1.2" cipher="AES256"/>
    <cors origin="*" methods="GET,POST,PUT,DELETE" credentials="true"/>
  </security>
</config>