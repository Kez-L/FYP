<!DOCTYPE root [
<!ELEMENT root (item)*>
<!ELEMENT item (value, attr1, attr2, attr3)>
<!ELEMENT value (#PCDATA)>
<!ELEMENT attr1 (#PCDATA)>
<!ELEMENT attr2 (#PCDATA)>
<!ELEMENT attr3 (#PCDATA)>
<!ATTLIST item id ID #REQUIRED name CDATA #REQUIRED>
]>
<root>
  <item id="i1" name="first">
    <value>content1</value>
    <attr1>a1val</attr1>
    <attr2>a2val</attr2>
    <attr3>a3val</attr3>
  </item>
  <item id="i2" name="second">
    <value>content2</value>
    <attr1>b1val</attr1>
    <attr2>b2val</attr2>
    <attr3>b3val</attr3>
  </item>
</root>