<!DOCTYPE doc [
<!ELEMENT doc (item*)>
<!ELEMENT item (name, value)>
<!ELEMENT name (#PCDATA)>
<!ELEMENT value (#PCDATA)>
<!ATTLIST item id ID #REQUIRED>
<!ATTLIST item type CDATA #IMPLIED>
]>
<doc>
  <item id="i1" type="type1">
    <name>Item One</name>
    <value>Value One</value>
  </item>
  <item id="i2" type="type2">
    <name>Item Two</name>
    <value>Value Two</value>
  </item>
</doc>