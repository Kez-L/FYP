<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Strict//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">
<head><title>XHTML-ish</title></head>
<body>
  <div>
    <p>alpha
    <p>beta
    <section><header>head<footer>foot</section>
    <address><a href="http://[::1">bad url</address>
  </div>
  <ol start="999999999999999999999999" reversed="0" type="Q">
    <li value="nan">first
    <li value="--2">second
  </ol>
  <dl compact="no">
    <dt>term
    <dd>definition
    <dt><dt><dd>
  </dl>
  <table>
    <tr><td>A</tr></td>
    <tr><th>B<td>C
  </table>
  <form><fieldset disabled="0"><legend>legend</legend>
    <input type="file" accept="image/*,," multiple="false">
    <button type="unknown">go</button>
  </fieldset></form>
</body>
</html>