<!doctype html>
<html>
<head><title>forms</title></head>
<body>
  <form action="http://[::ffff:192.0.2.1" method="get" enctype="multipart/form-data" accept-charset="">
    <fieldset disabled="false">
      <legend><input name=legend value="x"> legend</legend>
      <input name=a type=text value="one" maxlength="-999999999999" minlength="999999999999" size="0">
      <input name=b type=file accept="image/*,,," multiple="maybe">
      <input name=c type=checkbox checked="no" required="0">
      <input name=d type=number min="Infinity" max="-Infinity" step="any" value="1e999">
      <input name=e type=date min="2024-99-99" max="0000-00-00" value="not-a-date">
      <textarea name=t rows="-1" cols="999999999" wrap="sideways">one
      <select name=s multiple="false" size="-3">
        <optgroup label="group" disabled="no">
          <option selected="false" value="&amp;broken">one
          <option label="unterminated value="two>two
        </optgroup>
        <option>three
      </select>
      <button type="reset" formaction="javascript:/*" formmethod="sideways">submit</button>
    </fieldset>
  </form>
  <form><input form="missing" name=x><output for="a b c">result</output></form>
  <object data="data:text/html,<p>x" type="application/x-unknown" width="-1" height="NaN">
    <param name="movie" value="&quot;">
    fallback<object>
  </object>
</body>
</html>