<!doctype html>
<html>
<head>
  <title>tables and forms</title>
</head>
<body>
  <table border="999999999999999999" cellpadding="-4">
    <caption><form><input name="caption"></form>caption</caption>
    <colgroup span="0"><col span="abc"><col width="1e309"></colgroup>
    <thead><tr><th rowspan="-1" colspan="999999999">A<th>B</thead>
    <tbody>
      <tr><td><form action=""><input name="x"></td><td>unclosed
      <tr><td colspan="nope"><select name="s" multiple="sometimes">
        <option selected="maybe" value="&bad">first
        <optgroup label="group"><option>second</select>
    </tbody>
    <tfoot><tr><td><div>footer</div></td></tr></tfoot>
  </table>
  <form id="outer" method="INVALID" enctype="bad/type">
    <fieldset disabled="false">
      <legend><button form="missing" formaction="javascript:void(0)">Legend action</button></legend>
      <input type="email" required="no" minlength="-2" maxlength="9999999999999" pattern="[">
      <textarea rows="-1" cols="NaN" wrap="strange">text</textarea>
      <select size="-9"><option label="x" disabled>broken<option value="y">y</select>
      <output for="a b c">result</output>
    </fieldset>
  </form>
</body>
</html>