<!doctype html>
<html>
<head><title>math and svg</title></head>
<body>
  <svg width="NaN" height="-Infinity" viewBox="0 0 0 0">
    <foreignObject><div xmlns="http://www.w3.org/1999/xhtml"><p>x</foreignObject>
    <g transform="translate(1e999,-1e999) rotate(foo)">
      <path d="M0 0 LNaN Infinity Q-1e999 0 0 0 Z" fill="url(#missing">
      <use href="#x" xlink:href="javascript:alert(1)"></use>
    </g>
    <text><tspan dx="1 2 bad">broken</text></tspan>
  </svg>
  <math display="sideways">
    <mrow><mi>x</mi><mo>&InvisibleTimes;</mo><mfrac><mn>1</mn><mn>0</mn></mfrac>
    <annotation-xml encoding="application/xhtml+xml"><div><b>unclosed
  </math>
  <p><svg><script>&lt;/script&gt;</script></svg>
</body>
</html>