<!doctype html>
<html>
<head>
  <title>namespace switching</title>
</head>
<body>
  <p>before
  <svg width="1e999" height="-Infinity" preserveAspectRatio="none none">
    <title>svg title</title>
    <g transform="translate(NaN,Infinity) rotate(9999999999)">
      <a href="javascript:alert(1)" target="&quot;">
        <text x="NaN" y="1e-999">svg <tspan dx="bad">text</tspan></text>
      </a>
      <foreignObject>
        <table xmlns="http://www.w3.org/1999/xhtml">
          <tr><td>html table in foreign object</td></tr>
        </table>
      </foreignObject>
    </g>
  </svg>
  <math xmlns="http://www.w3.org/1998/Math/MathML">
    <annotation-xml encoding="application/xhtml+xml">
      <div xmlns="http://www.w3.org/1999/xhtml"><form><input name=q></form></div>
    </annotation-xml>
    <semantics><mi>x</mi><annotation encoding="text/plain">&lt;/math&gt;</annotation></semantics>
  </math>
  <p>after namespaces
  <table>
    <caption><svg><circle r="NaN"></circle></svg></caption>
    <tr><td><math><mi><span>html in mi</span></mi></math></td></tr>
  </table>
  <p><a href="http://example.com/%ZZ?x=%00" ping="http://[::">broken navigation</a>
  <img src="data:image/png;base64,%%%%" width="18446744073709551615" height="-9223372036854775808"
       loading="lazy" decoding="maybe" referrerpolicy="invalid">
  <picture>
    <source media="(min-width:" srcset="a 1x, b 2q">
    <source type="image/svg+xml" srcset="">
    <img alt="fallback">
  </picture>
  <p><bdi dir="invalid">abc</bdi><bdo dir="auto">xyz</bdo><wbr>
</body>
</html>