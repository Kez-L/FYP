<!DOCTYPE html>
<html>
<head>
  <title>Interactive controls</title>
</head>
<body>
  <dialog open="yes" inert="maybe">
    <form method="dialog" action="%%%/" enctype="multipart/form-data; boundary=">
      <input type="text" name="a" required="false" minlength="-1" maxlength="999999999999999999999" pattern="[">
      <input type="number" min="NaN" max="-Infinity" step="0" value="1e309">
      <input type="date" value="2024-02-31" min="9999-99-99">
      <input type="checkbox" checked="no" indeterminate="true">
      <input type="file" accept="image/*,,text/" multiple="sometimes">
      <button type="submit" formaction="javascript:/*" disabled="0">send</button>
      <output for="a b c">result</output>
    </form>
    <menu><li><button popovertarget="p">open</button><li>orphan
    <select name="s" size="-999" required>
      <optgroup label="group"><option value="&bad;" label="x">one<option>two
      <option disabled>three
    </select>
  </dialog>
  <popover id="p" anchor="missing"><template shadowrootmode="open"><style>:host{--x:}</style><slot name="n"></slot></template>
    <p slot="n">popover</p>
  </popover>
  <textarea wrap="sideways" minlength="10" maxlength="2">a&amp;b</textarea>
</body>
</html>