<!doctype html>
<html>
<head>
  <meta charset="utf-16">
  <title>attributes &amp; entities</title>
</head>
<body>
  <form id="f" action="/submit" method="PoSt" accept-charset=",,">
    <fieldset disabled>
      <legend><b>Account</legend>
      <input name="user" value="&unknown; &#x110000; &#999999999999999999999;">
      <input type="email" multiple list="choices" required>
      <datalist id="choices"><option value="a@b"><option value="&quot;">
    </fieldset>
    <fieldset>
      <input type="file" accept="image/*,,text/plain" capture="invalid">
      <input type="number" min="NaN" max="1e999" step="0">
      <input type="date" value="2024-99-99">
      <button name="x" value="&notanentity" disabled>send</button>
    </fieldset>
  </form>
  <p title="unterminated < &quot; >">a &copy b &amp; c &#0; d</p>
  <div class=x y=z=bad =empty data-a='single"quote>payload
</body>
</html>