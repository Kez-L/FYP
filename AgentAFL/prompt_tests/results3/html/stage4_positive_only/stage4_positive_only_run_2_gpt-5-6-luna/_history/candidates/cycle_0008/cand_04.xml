<!DOCTYPE html>
<html>
<head><title>Tables and lists</title></head>
<body>
  <table>
    <tr><td>A</td></tr>
    text outside
    <colgroup span="0"><col span="-4"></colgroup>
    <tbody><tr><td>one</tbody>
    <tfoot><tr><th><table><tr><td>nested</table></th></tr></tfoot>
    <caption><div>caption div</caption>
  </table>
  <ul start="999999999999999999999"><li>first<ol type="?" reversed start="-999"><li value="NaN">nested<li>next</ol><li>last</ul>
  <dl>
    <div><dt>wrapped term<dd>wrapped description</div>
    <dt>term without description
    <dd><dd>double description
  </dl>
  <p><ins datetime="not-a-date"><del cite="http://[bad" datetime="">edited <mark>text</ins> tail</del>
  <pre><code>one</pre></code>
  <blockquote><p>quote</blockquote><p>after
  <hr><hr><br><br />
</body>
</html>