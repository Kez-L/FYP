<!DOCTYPE html>
<html>
<head><title>Form controls</title></head>
<body>
<form action="/submit?x=1&amp;y=2" method=PoSt enctype="multipart/form-data">
<fieldset disabled>
<legend><label for=q>Search <input id=q name=q value="a&b"></label></legend>
<input type="text" name="one" maxlength="999999999999999999999" minlength="-4">
<input type="number" min=10 max=2 step=0 value=nan>
<textarea name=notes cols=0 rows=999 wrap=sideways>first
second
</textarea>
<select name=items multiple size=-1>
<option selected selected value=1>one
<option value="2" label="two">two</option>
<optgroup disabled label="&copy; group"><option>three
</select>
<output for="q missing">result</output>
<progress value=2 max=1>bad</progress>
<input type=image src=x alt=y formaction=/other>
</fieldset>
<fieldset><input name=x><input type="file" accept=",,,image/*,,"></fieldset>
<button type=invalid formaction="&#x22;/><svg onload=alert(1)>">send</button>
</form>
<iframe srcdoc="<p class='x'>embedded &amp; text</p><img src=x>"></iframe>
</body>
</html>