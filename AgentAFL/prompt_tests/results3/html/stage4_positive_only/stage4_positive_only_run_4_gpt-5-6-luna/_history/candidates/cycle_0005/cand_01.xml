<!DOCTYPE HTML>
<html>
<head><title>Foreign content stress</title></head>
<body>
  <svg width="100%" viewBox="0 0 400 200">
    <defs><linearGradient id="g"><stop offset="0%"/><stop offset="110%"></linearGradient></defs>
    <g transform="translate(10,20) rotate(foo)">
      <rect x="0" y="0" width="300" height="100" fill="url(#g)"></rect>
      <text x="4" y="40">SVG text <tspan dx="bad">piece</tspan></text>
      <foreignObject width="200" height="80">
        <div xmlns="http://www.w3.org/1999/xhtml"><p>HTML inside SVG
      </foreignObject>
    </g>
  </svg>
  <math display="block">
    <mrow><mi>x</mi><mo>=</mo><mfrac><mi>a</mi><mn>0</mn></mfrac>
    <annotation-xml encoding="application/xhtml+xml"><p>embedded math HTML</p></annotation-xml>
  </math>
  <p>After foreign content <bdi dir="sideways">text</bdi><br><wbr>
  <iframe srcdoc="<p>inner &amp; <b>document</b>"></iframe>
</body>
</html>