<!DOCTYPE html>
<html>
<head><title>Form nesting</title></head>
<body>
<form action="/submit" method=post enctype="multipart/form-data">
<fieldset disabled="false"><legend>Account</legend>
<label for=u>User <input id=u name=user value="&notanentity;"></label>
<label>Password <input type=password name=p maxlength=0 minlength=999></label>
<select name=mode multiple size=0>
<option selected value=a>A
<option value=b>B
<optgroup disabled label="x"><option>C
</select>
<textarea name=notes placeholder="&quot;&#xD800;" wrap=invalid>text</textarea>
<button type=submit formaction="x" formmethod=dialog>Send</button>
</fieldset>
<input type=file accept="image/*,.bad," multiple>
</form>
<form><input name=outside><button><form><input name=deep></form></button></form>
</body>
</html>