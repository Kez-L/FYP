<!doctype HTML PUBLIC "-//W3C//DTD HTML 4.01 Frameset//EN">
<html>
<head>
<title>Frames and declarations
<meta name=viewport content="width=device-width,initial-scale=1">
</head>
<frameset cols="*,0,invalid" rows="50%,*">
<frame src="about:blank" name=a noresize>
<frameset>
<frame srcdoc="<p>nested &amp; broken" scrolling=maybe>
<noframes><body>
<h2>Fallback</h2>
<table>
<tr><th>A<th>B
<tr><td rowspan="-1">1<td>2
</table>
</body></noframes>
</frameset>
</frameset>
<base href="http://example.test/" target=_blank>
</html>