<!DOCTYPE html>
<html>
<head><title>Media and interactive fragments</title></head>
<body>
  <map name=mainmap>
    <area shape=poly coords="0,0,10,10,20" href=/one alt=one>
    <area shape=circle coords="a,b,c" href="/two">
  </map>
  <picture>
    <source media="(min-width: )" srcset="a 1x, b 2q, c">
    <source type="image/avif" srcset>
    <img usemap="#mainmap" srcset="x 100w, y" sizes="calc(100%-foo)" alt>
  </picture>
  <video controls autoplay="false" width=-4 height=huge poster=x>
    <track kind=subtitles srclang=xx default src=vtt>
    <source src="movie.mp4" type="video/unknown">
    fallback <a href=video>video</a>
  </video>
  <audio preload=perhaps><source src=a><source src=b></audio>
  <dialog open=closed><form method=dialog><button>Close</button></form>
    <p>Dialog <mark>text</dialog>
  <menu type=context><menuitem label="A" command="x"><li>not menuitem</menu>
  <canvas width=NaN height=-1>Canvas fallback <span>content</canvas>
  <p contenteditable="maybe" spellcheck="sometimes">End &copy &#x110000; &#12;
</body>
</html>