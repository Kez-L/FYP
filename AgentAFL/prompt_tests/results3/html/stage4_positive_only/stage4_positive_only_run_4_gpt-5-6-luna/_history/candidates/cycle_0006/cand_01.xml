<!DOCTYPE html>
<html>
<head><title>Forms and templates</title></head>
<body>
<form id=f action="javascript:alert(1)" method=POST enctype="multipart/form-data">
<label for=i>Name <input id=i type=text value="a&quot;b" maxlength="--1"></label>
<input type=image src=x alt=bad formaction=/next>
<select multiple size="0">
<option selected>alpha<option disabled>beta
<optgroup><option label="x&#x110000;">gamma
</select>
<textarea name=t wrap=hard>line one
line two</textarea>
<output for="i missing">result</output>
<fieldset disabled><legend>Legend</fieldset>
<button formaction="/x" formmethod=dialog>send
</form>
<template id=t><table><tr><td>A</template><div>after template
<datalist id=d><option value=x><option value=y></datalist>
<input list=d required="0" pattern="[">
</body>
</html>