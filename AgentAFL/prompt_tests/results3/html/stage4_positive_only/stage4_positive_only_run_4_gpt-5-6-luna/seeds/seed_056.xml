<!DOCTYPE html>
<html>
<head><title>Form state</title></head>
<body>
<form action="/submit?x=1&y=2" method="get" enctype="multipart/form-data">
<fieldset disabled>
<legend><label for="u">User <input id=u name=user value="a<b"></label></legend>
<input type=text name=a required=required checked=maybe>
<input type=radio name=r value=1 checked><input type=radio name=r value=2 checked>
<select name=pick multiple size=zero>
<option selected value=one>One
<option value=two selected="selected">Two
</select>
<textarea name=note wrap=side rows=NaN cols=0>line one
line two</textarea>
<button type=submit formaction="javascript:alert(1)">send</button>
</fieldset>
<input type=file accept="image/*,.x" capture>
<output for="u a">unclosed
<progress value="999" max="-1">bad
<meter min="10" max="2" low="x" high="y" optimum="z">meter</meter>
</form>
<form><input name=x><form><input name=y></form></form>
</body>
</html>