<!doctype html>
<head>
<title>Frames and declarations</title>
<noscript><meta http-equiv=content-type content=text/plain></noscript>
</head>
<frameset rows="*,2*,">
<frame src="one.html" name="main" scrolling="maybe">
<frameset cols="25%,75%">
<frame src="two.html">
<noframes>
<body>
<pre><code>&lt;tag attr="unterminated&gt;
</code></pre>
<blockquote cite=http://example.com/a?x=1&y=2>
<dir compact><li>first<li><dl><dt>term<dd>definition
</dir></dl>
<hr />
<address><a href=mailto:test@example.com>mail</address>
</body>
</noframes>
</frameset>
</frameset>