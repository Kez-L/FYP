<html><head><title>form controls</title></head><body>
<form id=f enctype="multipart/form-data" accept-charset="UTF-999" novalidate>
<label for=q>Query<label><input id=q name=q value="&notanentity; &#x110000;">
<select name=items multiple size=zero>
<option selected=selected>one<option disabled>two
<optgroup label="A"><option value="v">three
</select>
<fieldset disabled><legend>Legend<input name=x></fieldset>
<textarea name=t wrap=unknown maxlength=-4>first
second &amp; third</textarea>
<input type=file accept="image/*,,audio/" capture=maybe>
<input type=number min=inf max=-inf step=0 value=1e309>
<output for="q missing">result</output>
<datalist id=dl><option value=a><option label=b></datalist>
<button formaction="http://[bad" formmethod=INVALID>Send</button>
</form>
<iframe sandbox="allow-scripts allow-scripts" srcdoc="<!doctype html><html><body><p>nested"></iframe>
</body></html>