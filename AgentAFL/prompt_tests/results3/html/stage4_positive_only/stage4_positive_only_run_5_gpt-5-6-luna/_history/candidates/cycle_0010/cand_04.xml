<!doctype html>
<html>
<head>
<title>forms</title>
</head>
<body>
<form id="f" method="dialog" enctype="multipart/form-data">
<label for="q">Query</label>
<input id="q" name="q" required minlength="999" pattern="[a-" value="&notanentity;">
<select name="s" multiple size="-1">
<option selected>one
<optgroup label="group"><option disabled>two</optgroup>
</select>
<textarea name="t" cols="0" rows="-3">text
<output for="q s">result</output>
<button formaction="/x" formmethod="get">submit</button>
<fieldset disabled><legend>legend</legend><input type="checkbox" checked></fieldset>
</form>
<object data="x" type="application/pdf"><param name="x" value="&copy"><embed src="y"></object>
<iframe srcdoc="<p><b>inside</p>" sandbox="allow-scripts"></iframe>
</body>
</html>