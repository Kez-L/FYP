<!DOCTYPE HTML PUBLIC "-//W3C//DTD HTML 4.01 Transitional//EN">
<html>
<head>
  <title>Objects and maps</title>
  <style type="text/css">
    body { background: url("x"); }
    @media screen and (max-width: 2px) { p { color: red; } }
  </style>
  <script type="text/javascript">
    if (a && b) { /* </script> */ document.write("<div>"); }
  </script>
</head>
<body bgcolor="#ggg" text="rgb(1,2,3)">
  <p><img src="image" usemap="#map" ismap border="999" alt="A & B">
  <map name="map">
    <area shape="rect" coords="0,0,10" href="one">
    <area shape="poly" coords="1,2,3,4,5" nohref>
  </map>
  <object classid="clsid:x" codebase="." type="application/x-test" width="0" height="-1">
    <param name="movie" value="a&amp;b">
    <table border="x"><tr><td>fallback</td></tr></table>
  </object>
  <p><b><i><u><s>crossed formatting</b></i></u></s>
</body>
</html>