<!DOCTYPE html>
<html>
<head><title>lists and tables</title></head>
<body>
  <ol start="999999999999999999999999" reversed type="i">
    <li value="-999999999999">first
      <ul><li>nested
        <ol><li>deep</ol>
      </ul>
    <li>second
  </ol>
  <table>
    <colgroup span="NaN"></colgroup>
    <tbody>
      <tr><td rowspan="0">a<td colspan="999999999999999999999">b
      <tr><th><a href="#x">head</a><td>
    </tbody>
    <tfoot><tr><td>foot</tbody>
    <caption align="sideways">late caption</caption>
  </table>
  <figure>
    <img alt="&notanentity; &#; &#x; &#x110000;" width="-" height="+">
    <figcaption><del><ins>caption</del></ins></figcaption>
  </figure>
  <hr noshade="false"><br><wbr>
</body>
</html>