<!DOCTYPE html>
<html>
<head><title>Media and Templates</title></head>
<body>
<picture>
<source media="(min-width: 1px)" srcset="a 1x, b 2x">
<source type="image/webp">
<img srcset="large.jpg 100w, small.jpg -2w" sizes="calc(100% - 1px)" alt="picture">
</picture>
<video controls autoplay muted width="999999" height="-4">
<source src="movie.mp4" type="video/mp4">
<track kind=subtitles srclang=en label=English default>
fallback text
</video>
<audio preload=garbage loop><source src="sound.ogg"></audio>
<details open><summary>summary</summary><p>hidden content</p></details>
<template id=t><section><slot name=x>default</slot><svg viewBox="0 0 10 10"><path d="M0 0 L10 10"/></svg></section></template>
</body>
</html>