<!doctype HTML>
<head>
<title>Malformed Forms</title>
<base href="https://example.invalid/a/">
<meta http-equiv=refresh content="0;url=next">
</head>
<body>
<form action="/submit" method=post enctype="multipart/form-data">
<label for=q>Query</label>
<input id=q type=text required minlength=0 maxlength=-2 value="&amp;broken">
<select name=choice multiple size=999>
<option selected>first
<option value=2>second
<optgroup label="group"><option>third</select>
<textarea name=note rows="-1" cols="NaN">text &copy; &unknown;</textarea>
<output name=result for=q>old</output>
<input type=image src="x" alt="submit">
</form>
<p><button type=reset><b><i>reset</button></p>
</body>