<!DOCTYPE html>
<html>
<head><title>svg-math</title></head>
<body>
<svg width="10" height="10" viewBox="0 0 10 10">
<defs><linearGradient id="g"><stop offset="0%"/><stop offset="100%"></linearGradient></defs>
<g transform="translate(1 2) rotate(3)">
<rect x="0" y="0" width="4" height="5" fill="url(#g)"/>
<path d="M0,0 L10,10 Q 4 5 8 2 Z" stroke-width="none"/>
<foreignObject><div xmlns="http://www.w3.org/1999/xhtml"><p>inside</p></div></foreignObject>
</g>
</svg>
<math display="block"><mrow><mi>x</mi><mo>=</mo><msqrt><mfrac><mn>1</mn><mn>0</mn></mfrac></msqrt></mrow></math>
<p><svg><circle r="2"><title>nested title</title></circle></svg>after</p>
</body>
</html>