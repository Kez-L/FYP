<!doctype html>
<html>
<head><title>Interactive controls</title></head>
<body>
  <form id="outer" action="/submit" method="post" enctype="multipart/form-data">
    <label for="q">Query<label>
    <input id="q" name="q" type="search" value="&quot;quoted" maxlength="-2">
    <select name="choice" multiple size="0">
      <optgroup label="Group" disabled>
        <option selected value=one>One
        <option value="two">Two
      <optgroup label='Second>
        <option>Three
    </select>
    <textarea name=notes rows="0" cols="-4">raw <b>text</textarea>
    <button type=button><span>push</button>
    <output for="q choice">result</output>
    <fieldset>
      <legend><b>Details</legend>
      <input type=checkbox checked="false" name=c>
      <input type=radio name=r value=1>
      <input type=radio name=r value=2 checked>
    </fieldset>
  </form>
  <form action=x><input name=outside></form>
  <p><label>orphan <input type=file accept="image/*,.x" multiple></label>
</body>
</html>