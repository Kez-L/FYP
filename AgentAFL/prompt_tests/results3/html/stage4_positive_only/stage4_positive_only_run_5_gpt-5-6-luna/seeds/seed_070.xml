<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Lists and Tables</title>
</head>
<body>
<header><h1>Inventory</h1></header>
<nav><ul><li><a href="/one">One</a><li><a href="/two">Two</a></ul></nav>
<main>
<ol start="-3" reversed>
<li>alpha
<li>beta<dl><dt>term<dd>definition</dl>
</ol>
<table border="1">
<caption>Values</caption>
<tbody>
<tr><th scope=row>A<td colspan="3">1
<tr><td rowspan="4">B<td>2<td>3
<tfoot><tr><td>total<td><input type=number value=abc>
</tfoot>
</table>
</main>
<footer><address>contact@example.invalid</address></footer>
</body>
</html>