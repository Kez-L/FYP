<!DOCTYPE html>
<html>
<head>
  <title>Mixed embedded content</title>
  <script type="text/javascript">
    if (a < b && c > d) { document.write("<p>x</p>"); }
    // </script> is text here
  </script>
  <noscript><div>no script <em>fallback</noscript>
</head>
<body>
  <p>before
  <object data="movie.swf" type="application/x-shockwave-flash">
    <param name=movie value=x.swf>
    <embed src=x.swf hidden>
    <p>object fallback
  </object>
  <video controls autoplay>
    <source src="a.mp4" type=video/mp4>
    <track kind=subtitles src=a.vtt>
    video fallback
  </video>
  <map name=map1><area shape=rect coords="0,0,10,10" href=#x></map>
  <img src=x usemap="#map1" alt="a" />
</body>
</html>