<!DOCTYPE html>
<html>
<head>
  <base href="http://example.invalid/">
  <title>Frameset test</title>
</head>
<frameset cols="20%,*,bad" onload="x<y">
  <frame src="a.html" name=left>
  <frameset rows="*,0">
    <frame src="b.html">
    <noframes>
      <body>
        <p>Fallback content
        <iframe srcdoc="<p>nested &amp; broken" scrolling=yes>
          fallback
        </iframe>
      </body>
    </noframes>
  </frameset>
  <frame>
</frameset>
</html>