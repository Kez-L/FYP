<!doctype html>
<html>
<head><title>template and forms</title></head>
<body>
<template shadowrootmode="open"><style>p{color:red}</style><p>template <slot name=x>fallback</slot></template>
<form id=f action="/submit" method="INVALID" enctype="x" accept-charset="UTF-999">
<input type=text name=a value="&notanentity" required readonly disabled>
<input type=number min="abc" max="-" step="0" value="1e309">
<input type=date min="2020-99-99" value="0000-00-00">
<textarea rows="-1" cols="99999999999999999999" maxlength="-4">text</textarea>
<select><option><option selected><option label="&amp;copy;">label</select>
<output for="a b c">result</output>
<meter min="10" max="2" low="NaN" high="-1" optimum="Infinity" value="3">meter</meter>
<progress max="-4" value="999">progress</progress>
<button type=submit formnovalidate>submit</button>
</form>
<label><input type=checkbox checked=maybe>check</label>
<fieldset form=f><legend><b>legend</fieldset>
<table><tr><td><template><tr><td>nested</template>after</td></tr></table>
</body>
</html>