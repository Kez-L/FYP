<html><head>
  <title>misnested formatting
  <meta charset="utf-8"></head>
<body>
  <b><i><u>one <em>two</b> three</u> four</i>
  <p><a href="x"><strong>link <span>text</a> tail</strong></span>
  <table border="1">
    <caption>caption
    <colgroup><col span="2"><tbody>
    <tr><td rowspan="999">A<td>B
    <tfoot><tr><th>C</table>
  <p>after table
  <select name="choice">
    <option value="1">one
    <optgroup label="group"><option selected>two</select>
  <textarea rows="2" cols="3">raw <b> text &amp; more</textarea>
  <p><button type="submit"><label for=x>button</button></label>
</body></html>