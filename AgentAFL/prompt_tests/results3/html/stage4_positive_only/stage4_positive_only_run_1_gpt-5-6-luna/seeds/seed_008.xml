<!doctype html>
<html>
<head>
  <title>Form controls</title>
</head>
<body>
  <form method="POST" action="/submit" enctype="multipart/form-data">
    <fieldset disabled>
      <legend>Account <b>details</legend>
      <label for=user>Name</label>
      <input id=user name=user value="a&b" type=text required>
      <select name=role multiple size=2>
        <option value=one selected>One
        <option value=two>Two
        <optgroup label=other><option>Three</optgroup>
      </select>
      <textarea name=notes rows=2 cols=3>one
two</textarea>
    </fieldset>
    <input type=file accept="image/*,.x" />
    <button type=submit>Send</button>
    <button type=reset disabled>Reset
  </form>
  <input form=missing type=number min=10 max=1 step=0>
</body>
</html>