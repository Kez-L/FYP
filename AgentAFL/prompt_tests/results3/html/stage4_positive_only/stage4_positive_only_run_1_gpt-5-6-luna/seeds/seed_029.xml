<!DOCTYPE HTML>
<html>
<head>
<title>media and embedded resources</title>
</head>
<body>
<picture>
<source media="(min-width: 0px)" type="image/avif" srcset="x 0w, y -1w">
<source srcset="data:image/svg+xml,%3Csvg%3E">
<img src="fallback" width="-1" height="999999999999999999999" loading="lazy">
</picture>
<audio autoplay controls loop preload="nonsense">
<source src="a.ogg" type="audio/ogg"><track kind="subtitles" src="s.vtt" default>
</audio>
<video controls poster="" width="abc" height="-8"><source src="v.mp4"><track></video>
<iframe srcdoc="<p><b>inner</p>" sandbox="allow-scripts allow-scripts" width="0"></iframe>
<object data="x" type="application/x-unknown"><param name="a" value="b"><p>fallback</p></object>
<embed src="x" type="x/y" width="-999">
<map name="m"><area shape="poly" coords="0,1,broken" href="#x"></map>
<img src="#none" usemap="#m" ismap>
</body>
</html>