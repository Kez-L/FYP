<!doctype html>
<html>
<head><title>interactive controls</title></head>
<body>
<form id="outer" action="/submit" enctype="multipart/form-data">
<label for="u">user</label><input id="u" name="u" type="email" required pattern="[" minlength="-5" maxlength="999999999999999">
<input type="file" accept="image/*,.x" multiple>
<output name="result" for="u missing">result</output>
<meter min="10" max="-10" low="20" high="-20" optimum="abc" value="999">meter</meter>
<progress max="0" value="-3">progress</progress>
<fieldset><legend>group</legend>
<input type="radio" name="r" checked><input type="radio" name="r" checked="false">
<textarea name="t" rows="-1" cols="999999999999999999">text</textarea>
<select name="v"><option value="a" label="A">A<option disabled>Ｂ<optgroup><option>C</optgroup></select>
</fieldset>
<button type="submit" disabled="no">send</button>
</form>
<form action="/second"><input name="outside"><button formaction="" formmethod="get">go</button></form>
<menu type="toolbar"><button>tool</button><input type="checkbox">check</menu>
</body>
</html>