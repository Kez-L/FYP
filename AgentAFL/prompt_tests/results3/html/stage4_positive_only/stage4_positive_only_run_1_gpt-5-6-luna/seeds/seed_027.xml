<!doctype html>
<html>
<head><title>forms and controls</title></head>
<body>
<form id="outer" action="/submit" method="post">
<label for="u">User</label><input id="u" name="user" required pattern="[">
<fieldset name="group"><legend>Options</legend>
<input type="checkbox" checked="false" name="c">
<input type="radio" name="r" value="1"><input type="radio" name="r" value="2" checked>
<textarea name="note" rows="-10" cols="999999999999999999">unclosed
<select id="pick" name="pick" size="-1">
<option value="a" selected>alpha
<option value="b">beta
<optgroup label="broken"><option disabled>gamma
</select>
<button type="submit" formaction="/one">Send</button>
<button type="reset">Reset</button>
</fieldset>
</form>
<form action="/second">
<input type="file" multiple accept="image/*,.x">
<output name="result" for="u pick">old</output>
<progress value="10" max="-2">10</progress>
<meter min="10" max="1" low="-4" high="999" value="abc">meter</meter>
<input type="image" src=x alt=y>
</form>
</body>
</html>