<!doctype html>
<html>
<head>
  <title>Frameset experiment</title>
  <base href="http://example.invalid/a/">
  <meta charset="windows-1252">
</head>
<frameset rows="25%,*,0" border="bogus">
  <frame src="one.html" name="left" scrolling="maybe">
  <frameset cols="50%,50%">
    <frame src="two.html">
    <frame src="three.html" noresize="noresize">
  </frameset>
  <noframes>
    <body>
      <table border="1">
        <caption>fallback</caption>
        <colgroup span="2"><col width="x"><col></colgroup>
        <thead><tr><th colspan="4">A<th>B</tr></thead>
        <tbody>
          <tr><td rowspan="3">1<td>2
          <tr><td>3</td></tr>
        </tbody>
        <tfoot><tr><td>last</td></tr></tfoot>
      </table>
    </body>
  </noframes>
</frameset>
</html>