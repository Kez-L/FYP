<!DOCTYPE HTML PUBLIC "-//W3C//DTD HTML 4.01 Transitional//EN">
<html>
<head><title>media and metadata</title></head>
<body>
<object data="movie.bin" type="application/octet-stream" width="1" height="1">
  <param name=autoplay value=true>
  <param name=loop value=0>
  <embed src="legacy.swf" type="application/x-shockwave-flash">
  <p>Object fallback <img srcset="a 1x, b 2x," sizes="(x) 10px" alt="fallback">
</object>
<picture>
  <source media="(min-width: 1px)" srcset="small.png 1x, large.png 2x">
  <source type=image/webp srcset="image.webp">
  <img src="final.jpg" loading=lazy decoding=async alt="picture">
</picture>
<video controls autoplay muted poster="p.jpg">
  <source src="one.mp4" type="video/mp4">
  <track kind=subtitles srclang=en label=English default src="sub.vtt">
  video fallback
</video>
<audio preload=none><source src="sound.ogg"><source src="sound.mp3"></audio>
<map id=weird><area href="javascript:void(0)" coords="1,2,3,4" shape=poly><area nohref></map>
<img src="x" usemap="#weird">
<meta name=viewport content="width=device-width,initial-scale=1">
<basefont size=7><center><font face="serif" color="#ggg">legacy</font></center>
</body>
</html>