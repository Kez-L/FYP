<!DOCTYPE html>
<html>
  <head>
    <title>frameset experiment</title>
  </head>
  <frameset rows="20%,*,0" border=0>
    <frame src="left.html" name=left scrolling=no>
    <frameset cols="30%,70%">
      <frame src="right.html" frameborder=maybe>
      <noframes>
        <body>
          <h1>Fallback</h1>
          <iframe srcdoc="<p>quoted &amp; inner</p>" src="fallback">
            <object data="x">
              <param name=movie value=test>
              <embed src=x>
            </object>
          </iframe>
        </body>
      </noframes>
    </frameset>
    <frame>
  </frameset>
</html>