<!doctype html>
<html>
<head><title>form controls</title></head>
<body>
  <form id=f action method=post enctype=multipart/form-data>
    <fieldset disabled>
      <legend><label for=q>Search</legend>
      <input id=q name=q type=search required readonly aria-required=true>
      <input type=hidden name=token value>
    </fieldset>
    <label>Choice <select name=choice><optgroup label=Group disabled>
      <option value=1>one
      <option value=2 selected=maybe>two
    </optgroup><option>outside</select></label>
    <textarea name=notes rows=-1 cols=999 wrap=soft>line one
line two
    <button type=submit formaction=//host/%22 formtarget=_blank>Submit</button>
    <output for="q missing">result</output>
    <progress value=2 max=1><meter min=10 low=2 high=1 optimum=-5 value=NaN>fallback</meter>
  </form>
  <form><input name=a><form><input name=b></form></form>
  <iframe srcdoc="<p title='x'>embedded</p>" sandbox="allow-scripts allow-scripts"></iframe>
  <object data="x" type="text/html"><param name=name value=v><embed src=x></object>
</body>
</html>