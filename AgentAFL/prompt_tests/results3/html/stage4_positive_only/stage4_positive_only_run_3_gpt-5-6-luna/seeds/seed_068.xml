<html>
<head><title>forms and lists</title></head>
<body>
  <form id=f1>
    <fieldset disabled><legend><legend>Account</legend>
      <input name=a required minlength=-4 maxlength=99999999999999999999>
      <select name=s><optgroup label=x disabled><option value=1>one<option value=2>two</optgroup>
      <textarea rows=999999999 cols=-1>unterminated
    </fieldset>
    <output for="a b">result</output>
  </form>
  <form id=f2><input form=f1><button formaction=/x formmethod=invalid>send</button></form>
  <ol start=abc reversed><li value=999999999999999999999999>first
    <ul><li><dl><dt>term<dd><ol><li>deep</ol></dl></li></ul>
  </ol>
  <p><label>label <input type=image src></label>
  <p><input type=file accept=",,," multiple><input type=date value=2024-99-99>
</body>
</html>