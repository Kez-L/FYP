<!DOCTYPE HTML>
<html lang="en">
<head>
  <title>Forms and lists</title>
</head>
<body>
<form method="POST" action="/submit" enctype="multipart/form-data">
  <fieldset disabled="false">
    <legend>Account <small>details</small></legend>
    <label for="u">User
      <input id="u" name="user" type="text" value="&quot;broken" maxlength="-1">
    </label>
    <label>Password <input name="p" type="password"></label>
    <select name="choice" multiple size="0">
      <optgroup label="Group" disabled>
        <option selected value="a">A
        <option value="b">B</option>
      </optgroup>
      <option>C</select>
    <textarea name="notes" rows="x" cols="-2">one
two</textarea>
    <button type="submit"><span>Send</button>
    <input type="file"><input type="image" src="">
  </fieldset>
</form>
<ol start="NaN" reversed>
  <li value="3">first
  <li>second<ul><li>nested</ol>
<dl compact><dt>term<dd>definition<dt><dd>empty</dd></dl>
<menu><li>menu item</menu>
</body>
</html>