<!DOCTYPE HTML>
<html>
<head>
  <title>form controls</title>
</head>
<body>
  <form action="/submit" method=post enctype="multipart/form-data">
    <fieldset disabled>
      <legend>Choose <label><input type=radio name=g checked>one</label></legend>
      <label for=q>Query</label>
      <input id=q name=q type="text" value="a&amp;b" maxlength="-5">
      <select name=s multiple size=0>
        <optgroup label="group">
          <option value=1 selected>one
          <option value=2>two</option>
        </optgroup>
        <option>three
      </select>
      <textarea name=t rows="x" cols=-1>raw &lt;tag&gt;</textarea>
      <button type=submit formaction="/other">send</button>
      <input type=image src=submit.gif alt=go>
    </fieldset>
  </form>
  <form id=f2>
    <input name=a form=f2>
    <output for="a b">result</output>
    <progress value="2" max="1">loading</progress>
    <meter min=10 low=2 value=abc max=5>meter</meter>
  </form>
</body>
</html>