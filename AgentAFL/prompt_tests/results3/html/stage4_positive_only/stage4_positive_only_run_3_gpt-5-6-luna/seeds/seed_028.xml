<!DOCTYPE html>
<html>
<head>
  <!-- unterminated-looking comment with -- oddities -- >
  <title>forms</title>
</head>
<body>
  <form method=post enctype="multipart/form-data" action="/submit">
    <fieldset disabled>
      <legend>Account &amp; options</legend>
      <label for=u>User</label>
      <input id=u name=user value="a&amp;b" required>
      <select name=kind multiple size=3>
        <option value=one selected>One
        <option value=two>Two</option>
        <optgroup label="Group"><option>Three</optgroup>
      </select>
    </fieldset>
    <fieldset>
      <input type=checkbox name=c checked>
      <input type=radio name=r value=x>
      <input type=radio name=r value=y checked>
      <textarea name=note rows=2 cols=8>less-than: &lt; end</textarea>
      <button type=submit><span>Send</span></button>
      <input type=image src="submit.gif" alt=go>
    </fieldset>
  </form>
  <details open><summary>More</summary><p>hidden-ish content</p></details>
  <dialog open>dialog text</dialog>
</body>
</html>