<!doctype HTML PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN"
  "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">
<head>
  <title>mixed namespaces</title>
</head>
<body>
  <svg width="20" height="20" viewBox="0 0 20 20">
    <foreignObject x="0" y="0" width="20" height="20">
      <div xmlns="http://www.w3.org/1999/xhtml">x</div>
    </foreignObject>
    <path d="M0 0 L10 10" fill="none"></path>
  </svg>
  <math display="block">
    <mrow><mi>x</mi><mo>&lt;</mo><msup><mi>y</mi><mn>2</mn></msup></mrow>
  </math>
  <div xmlns:foo="urn:test"><foo:bar data-x="1">namespaced</foo:bar></div>
  <iframe srcdoc="<p>inner &amp; text</p>" sandbox="allow-scripts"></iframe>
</body>
</html>