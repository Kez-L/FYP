<!DOCTYPE html>
<html>
<head>
<title>frameset transition</title>
<link rel=stylesheet href="x.css">
<style>body{background:url("x")}</style>
</head>
<frameset rows="20%,*,0" border=3 frameborder=yes>
  <frame src="top.html" name=top scrolling=auto>
  <frameset cols="30%,70%">
    <frame src="left.html" name=left noresize>
    <frame srcdoc="<p>inline &amp; frame</p>" name=right>
  </frameset>
  <noframes>
    <body>
      <h1>Fallback</h1>
      <p>Frames are unavailable.
      <iframe src="fallback.html" sandbox="allow-scripts allow-forms" width="0" height="0">
        fallback iframe text
      </iframe>
    </body>
  </noframes>
</frameset>
<script>
if (a < b && c > d) { document.write("<div class='x'>write</div>"); }
</script>
</html>