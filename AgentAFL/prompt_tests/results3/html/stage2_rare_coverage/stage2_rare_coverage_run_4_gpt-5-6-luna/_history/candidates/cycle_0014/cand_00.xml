<!DOCTYPE HTML PUBLIC "-//W3C//DTD HTML 3.2 Final//EN">
<html>
<head>
<meta http-equiv="Content-Type" content="text/html; charset=windows-1252">
<base href="http://example.invalid/a/">
<title>Frames and tables</title>
</head>
<frameset cols="20%,*,0" border="7" frameborder="maybe">
  <frame name="left" src="left.html" scrolling="yes" noresize>
  <frameset rows="15%,*,15%">
    <frame src="top.html">
    <frame src="main.html" marginwidth="x" marginheight="-4">
    <frame src="bottom.html">
  </frameset>
  <noframes>
    <body bgcolor=#gg00ff text="black">
      <table border="2" cellpadding=3 cellspacing="bad" width="100%">
        <caption align=side>Fallback &copy; table</caption>
        <colgroup span="x"><col width="25%"><col></colgroup>
        <thead><tr><th rowspan="0">A<th colspan="-1">B</tr></thead>
        <tbody>
          <tr><td><table><tr><td>nested<tr><td>broken</table>
          <td valign=middle><img src alt=missing width=none height=-2>
        </tbody>
        <tfoot><tr><td>tail</tfoot>
      </table>
    </body>
  </noframes>
</frameset>
</html>