<!DOCTYPE HTML>
<html>
<head>
  <title>Raw text and comments</title>
  <style type="text/css">
    body { background: url("x"); }
    /* </style> appears in a comment */
    p::before { content: "<tag>&"; }
  </style>
  <script language="javascript">
    if (a < b && c > d) {
      document.write("</script><p>injected</p>");
    }
    // </script>
  </script>
</head>
<body>
  <noscript><p>fallback <b>content</b></noscript>
  <iframe src="about:blank" name="f">fallback</iframe>
  <object data="movie" type="application/octet-stream">
    <param name="movie" value="x">
    <embed src="x" pluginspage="about:blank">
    fallback <a href="x">object link</a>
  </object>
  <script>var s = "<!-- still script -->";</script>
</body>
</html>