<!DOCTYPE html>
<html>
<head>
  <title>Table recovery case</title>
</head>
<body>
  <table border="1">
    <caption><b>Rows</caption>
    <colgroup span="2"><col width="20%"><col></colgroup>
    <thead><tr><th scope=col>A<th>B</thead>
    <tbody>
      <tr><td rowspan="2">one<td>two
      <tr><td colspan=3>three</td></tr>
    </tbody>
    <tfoot><tr><td>tail</table>
  <p>after table<table><tr><td><div>nested cell</tr></table></div>
  <select name="choice">
    <optgroup label="Group"><option selected>Alpha<option value=2>Beta
    <option>Gamma
  </select>
  <textarea rows=2 cols=4>raw <b>text</textarea>
</body>