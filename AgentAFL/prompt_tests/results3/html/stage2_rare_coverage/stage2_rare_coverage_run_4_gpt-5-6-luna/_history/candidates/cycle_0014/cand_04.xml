<!DOCTYPE html SYSTEM "about:legacy-compat">
<html>
<head><title>Mixed document recovery</title></head>
<body>
  <header><nav>
    <ol start="zero" reversed="false">
      <li value="NaN">first
      <li>second
        <ol type="i"><li>nested
    </ol>
  </nav></header>
  <main>
    <article>
      <h2>Article <time datetime="not-a-date">today</h2>
      <section>
        <p>One <span>two <div>three <p>four
        <address>mail &lt;user@example.com&gt;<br>Road</address>
      </section>
      <aside>
        <table>
          <tr><td>A<td>B
          <tr><th>C<th>D</th></tr>
          <tbody><tr><td>E</tbody>
          <caption>caption after rows</caption>
        </table>
      </aside>
    </article>
    <hr noshade="false" size="giant">
    <figure>
      <img srcset="a 1x, b 2q, c" sizes="(min-width: 1px) nope" alt="">
      <figcaption>image <small>caption</small></figcaption>
    </figure>
  </main>
  <footer>
    <p>End <wbr>of <data value="">document</data>
    <form><button>submit</button></form>
  </footer>
  </body>
</html>