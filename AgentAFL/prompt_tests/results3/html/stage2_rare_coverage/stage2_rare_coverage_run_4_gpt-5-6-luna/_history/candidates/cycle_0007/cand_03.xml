<!DOCTYPE html>
<html>
<head>
  <title>Foreign content boundaries</title>
  <style type="text/css">
    <![CDATA[
      body > x\:y { color: red; }
      @media (x) { a { content: "</style>"; } }
    ]]>
  </style>
</head>
<body>
  <svg width="1e309" height="-Infinity" viewBox="0 0 10 10">
    <title>svg title</title>
    <foreignObject><div xmlns="http://www.w3.org/1999/xhtml">
      <p>html in foreign <svg><desc>nested svg</desc><use href="#x"/></svg>
    </div></foreignObject>
    <defs><linearGradient id=g><stop offset="NaN%"/></linearGradient></defs>
    <use xlink:href="#g" xmlns:xlink="http://www.w3.org/1999/xlink"/>
  </svg>
  <math display="sideways">
    <annotation-xml encoding="application/xhtml+xml">
      <div xmlns="http://www.w3.org/1999/xhtml"><em>embedded</em></div>
    </annotation-xml>
    <mtext><span>text</span></mtext>
  </math>
  <iframe srcdoc="<p>quoted <b>markup</b> &amp; text" sandbox=allow-scripts></iframe>
  <object data="x" type="application/x-unknown"><param name=name value=value><p>fallback</object>
</body>
</html>