<!DOCTYPE html>
<html lang="x">
<head><title>Ruby and legacy inline elements</title></head>
<body>
  <p>
    <ruby>
      漢<rt>kan</rt><rp>(</rp><rt>かん</rt><rp>)</rp>
      <rb>字<rtc><span>annotation</span></rtc></rb>
    </ruby>
    <bdo dir="sideways">direction</bdo>
    <bdi>isolate</bdi>
    <abbr title="&quot;abbr&quot;">A</abbr>
    <acronym title='x>y'>XYZ</acronym>
  </p>
  <center>
    <font face="A&B" size="999" color="#12">old <tt>type</tt></font>
    <strike><u><s>crossed</u></strike>
  </center>
  <dl compact="no">
    <dt>Term 1
    <dd>Definition <dfn>word
    <dt><ins cite="x" datetime="n">Term 2
    <dd><del cite="y"><var>value</var></del>
  </dl>
  <menu type="toolbar">
    <li><button autofocus=maybe accesskey=<< type=button>Run</button>
    <li><command label="Old" onclick="a('>');">Command
  </menu>
  <p><a href="javascript:&#x0a;alert(1)" title="a&quot;b">link
  <isindex prompt="Search: &">
</body>
</html>