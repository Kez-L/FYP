<!DOCTYPE HTML PUBLIC "-//W3C//DTD HTML 4.01 Frameset//EN">
<html>
<head><title>Frameset recovery</title></head>
<frameset rows="*,25%,0" cols="50%,*" frameborder="maybe">
  <frame src="a.html" name="left" scrolling="sideways" noresize>
  <frameset cols="bad">
    <frame src="b.html">
    <noframes>
      <body>
        <h1>Fallback</h1>
        <p>This body occurs inside a malformed frameset.</p>
        <table><tr><td>cell<td>another</table>
      </body>
    </noframes>
  </frameset>
  <frame>
</frameset>
<frameset>
  <frame src="orphan">
</frameset>
</html>