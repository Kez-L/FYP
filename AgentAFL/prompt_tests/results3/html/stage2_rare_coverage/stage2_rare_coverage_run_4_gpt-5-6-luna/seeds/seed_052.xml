<!DOCTYPE html>
<html>
<head><title>Lists and definitions</title></head>
<body>
<dl compact>
  <dt>term one
  <dd>definition one
  <dt><b>term <i>two</dt>
  <dd><p>paragraph in definition
  <ul>
    <li>outer
      <ol start="zero" type="I">
        <li value="NaN">inner one
        <li>inner two
      </ol>
    <li>outer two
  </ul>
</dl>
<menu>
  <li><a href>missing value
  <li><a href="#x" target="_blank">link
</menu>
<ol reversed start="-3">
  <li>alpha
  <li>beta
</ol>
<p id=x><a name=x>duplicate anchors</a></p>
</body>
</html>