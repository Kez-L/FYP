<html>
  <head>
    <title>table recovery</title>
  </head>
  <body>
    <table border=1 cellpadding="x" cellspacing=-2 width="101%" summary="a & b">
      <caption align=side><b>Caption
      <colgroup span="-4"><col span=abc width=0*><colgroup>
      <thead><tr><th rowspan=999 colspan=0 scope=side>Head<th>Second
      <tbody>
        <tr><td>A<td>B<td>C
        <tr><td><table><tbody><tr><td>nested</table><td>after
      <tfoot><tr><th><div>footer</div><td><p>tail
    </table>
    <table><tr><td><form><input name=q><tr><td>form row</form></table>
    <table><tbody><tr><td><ul><li>list one<li>list two</ul><td>
      <dl><dt>term<dd>definition<dt>next</dl>
    </table>
    <p><a href="#x"><table><tr><td>anchor table</table>after anchor</a>
  </body>
