<!doctype html>
<html>
<head>
  <title>Form controls</title>
</head>
<body>
  <form method=get action="/submit" enctype=x-invalid>
    <fieldset disabled>
      <legend>Choose <label for=x>one</label></legend>
      <label><input name=a type=checkbox checked="checked" value=> Alpha</label>
      <label><input name=a type=checkbox checked=no> Beta</label>
      <select name=pick multiple size=notanumber>
        <optgroup label="Group 1" disabled=false>
          <option selected value=1>One
          <option value="2">Two</option>
        </optgroup>
        <option>orphan
      </select>
      <textarea name=notes rows=-1 cols=abc wrap=side>text
      <button type=submit disabled=0 name=x value="&quot;">Go
    </fieldset>
    <input type=text name=user value="unterminated>
    <input type=image src=button.gif alt=Submit><input type=reset>
  </form>
  <p><label for=missing>Loose label</label></p>
</body>
</html>