<!DOCTYPE html PUBLIC "-//W3C//DTD HTML 3.2 Final//EN">
<HTML>
<HEAD>
<TITLE>Legacy objects and applets</TITLE>
</HEAD>
<BODY bgcolor=#GGGGGG text=rgb(0,0,0)>
<applet code="X.class" archive="a.jar,b.jar" width=NaN height=-10>
  <param name=movie value="x&y">
  <param name=value>
  fallback <object data="file:///tmp/x" type="application/x-test">
    <param name=broken value
    <embed src="" pluginspage="about:blank" width="1" height="1">
  </object>
</applet>
<noembed><form><input name="x" value="a>b"><input type=image src=# border=none></form></noembed>
<isindex prompt="Search &quot;now&quot;">
<basefont size=0 face="A,B,C"><font size=+7 color=not-a-color>text</font>
<marquee behavior=alternate direction=sideways loop=-2><blink>old</blink></marquee>
</BODY>
</HTML>