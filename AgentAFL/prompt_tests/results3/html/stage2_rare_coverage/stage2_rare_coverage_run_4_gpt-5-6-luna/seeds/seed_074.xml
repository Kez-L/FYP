<!doctype html>
<html>
<head>
  <title>mixed declarations</title>
  <!--[if IE]><div>conditional markup</div><![endif]-->
  <!--[if !IE]><!--><span>revealed</span><!--<![endif]-->
  <?xml-stylesheet type="text/css" href="a.css"?>
  <style media="all" scoped=true>
    <![CDATA[
      @media (x) { a::before { content: "<&"; } }
    ]]>
  </style>
</head>
<body>
  <section>
    <h1>section
    <div><p>one
    <div><p>two
    <p>three</div>
  </section>
  <canvas width="18446744073709551615" height="-20">fallback
    <div>inside canvas</div>
  </canvas>
  <map name=map><area shape=poly coords="0,0,foo,999999999" href=#bad><area></map>
  <img usemap="#map" ismap loading=sideways decoding=maybe>
  <iframe srcdoc="<p title='x'>nested</p>" sandbox="allow-scripts allow-unknown" width=bad height=>
    fallback
  <video autoplay="false" controlslist="nodownload foo" poster="x">
    <source src="a" type="video/unknown"><track kind=subtitles srclang=xx>
    video fallback
  </video>
  <form><fieldset disabled><legend>legend</legend><input><fieldset><input></fieldset></fieldset></form>
  <del cite="x" datetime="not-date">deleted</del><ins>inserted</ins>
</body>
</html>