<!doctype html>
<html>
<head><title>forms and controls</title></head>
<body>
<form method=get action="/submit" enctype="multipart/form-data" accept-charset="UTF-8, BAD" onsubmit="return false;">
<fieldset disabled="maybe">
<legend>Account <input name=legend value="x"></legend>
<label for=user>User:</label>
<input id=user name=user type=text value="a&quot;b" maxlength="-1" size="NaN">
<label>Password <input name=pass type=password autocomplete=off></label>
<input type=hidden name=h value="1">
<select name=choice multiple size=-2>
<option value=one selected>One
<option value=two disabled selected="no">Two
<optgroup label=Group disabled=false><option>Three</optgroup>
</select>
<textarea name=notes rows=0 cols=abc wrap=side>line 1
line 2</textarea>
<button type=submit name=go value="&lt;">Send <img src=x></button>
<input type=image src=x alt=submit width=-4 height=oops>
</fieldset>
</form>
<form><input type=radio name=x checked><input type=radio name=x checked>
<input type=checkbox checked=unchecked></form>
</body>
</html>