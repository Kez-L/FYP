<!DOCTYPE html>
<html>
<head><title>Obsolete embedded and metadata elements</title></head>
<body bgcolor="#gggggg" text="rgb(1,2,3)" background="a b">
  <applet code="x.class" archive="a.jar,b.jar" width="NaN" height="-4">
    <param name="x" value>
    fallback <object data="file:///x" type="bad/type">
      <param name=y value="&quot;">
      <embed src="movie" hidden="sometimes" loop="-1">
      object fallback
    </object>
  </applet>
  <marquee behavior=sideways direction="diagonal" scrollamount="huge">
    moving <blink>blink</blink>
  </marquee>
  <isindex prompt="Search &amp; find">
  <img srcset="a 1x, b 2w, c" sizes="(min-width: 1px) 50vw, nonsense" usemap="#map">
  <map name=map><area shape=poly coords="1,2,three,4" href="#"></map>
  <a href="javascript:alert('x')" name="n"><font face="&bad;" size="+99">link
  <noembed><video src=x><source src=y></video></noembed>
</body>
</html>