<html>
<head><title>Lists and inline recovery</title></head>
<body>
<dl compact>
  <dt>Term one
  <dd>Definition <p>paragraph inside definition
  <dt><a href="#x"><i>Term two</dd>
  <dd><ul compact><li>nested one<li>nested two<ol start=-3 reversed>
    <li value=999999999999999999999999>number
    <li>next
  </ul></dd>
</dl>
<center><big><small><font face="Arial" size=+7 color=red>
  <b><i><u>many inline tags</b> crossed</i></u>
</font></small></big></center>
<p><q cite="x">quote <abbr title="long">abbr</abbr>
  <acronym>acro</acronym> <sub>sub</sub><sup>sup</sup>
  <del datetime=bad>deleted</del><ins>inserted
<p><a name=x><img src alt=broken width=abc height=-1 border=999>
<object data="movie" type="video/x-test" width=0 height=0>
  <param name=autoplay value=true>
  <embed src=x hidden>
  fallback text
</object>
</body>
</html>