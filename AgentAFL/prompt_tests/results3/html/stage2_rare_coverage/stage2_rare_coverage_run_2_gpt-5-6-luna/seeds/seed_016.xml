<!DOCTYPE html>
<html>
<head>
  <title>Comments and declarations</title>
  <!-- ordinary comment --><!-- comment with -- inside -->
  <!--[if IE]><style>body{color:red}</style><![endif]-->
  <! bogus declaration >
  <!---->
</head>
<body>
  <div>
    <!--->
    text after broken comment
    <!-- nested <!-- comment --> still text
    <![CDATA[ this is not really CDATA in HTML ]]>
    <span>visible</span>
  </div>
  <?xml version="1.0"?>
  <p>before &amp; after</p>
  <div title="unterminated attribute>
    <b>recovered content
  </div>
  <!-- final --!>
</body>
</html>