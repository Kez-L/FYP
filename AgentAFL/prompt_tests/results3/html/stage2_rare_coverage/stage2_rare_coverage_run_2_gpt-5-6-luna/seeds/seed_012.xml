<!DOCTYPE HTML PUBLIC "-//W3C//DTD HTML 3.2 Final//EN">
<html>
<head>
  <title>Legacy controls</title>
</head>
<body>
<form method=POST action="/submit" enctype="multipart/form-data">
  <fieldset>
    <legend><b>Account</legend>
    <label for=user>Name:
    <input id=user name=user type=text value="&lt;admin&gt;" maxlength=999999999999999999>
    <label>Password <input name=pass type=password>
    <input type=hidden name=h value=x>
    <textarea name=notes rows=2 cols=4 wrap=hard>first</textarea>
    <select name=choice multiple size=0>
      <optgroup label=One><option value=a selected>Alpha<option>Beta
      <option disabled>Gamma
    </select>
    <select><option>unclosed
    <button type=submit onclick="if (a < b) alert('x')">Send</button>
    <input type=image src="x" alt="go">
  </fieldset>
</form>
<isindex prompt="Search:">
<frameset cols="20%,*,0">
  <frame src="left.html" name=left>
  <frame src="right.html" scrolling=no>
  <noframes><body>Frames unavailable</body></noframes>
</frameset>
</body>
</html>