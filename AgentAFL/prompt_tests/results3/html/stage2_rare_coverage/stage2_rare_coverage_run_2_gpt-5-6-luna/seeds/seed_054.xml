<!DOCTYPE html>
<html>
<head><title>Forms and nested controls</title></head>
<body>
<form id=f1 action=/submit enctype=multipart/form-data>
  <fieldset>
    <legend><label>Account <input name=user></label></legend>
    <input type=text name=a required autofocus maxlength=-4 size=999999999999>
    <input type=image src=x alt=go border=abc>
    <button type=button><select name=q>
      <option value="a">A
      <optgroup label="G"><option>B
    </select></button>
    <textarea name=t cols=0 rows=-8 wrap=sideways>one
two</textarea>
  </fieldset>
</form>
<form action=/second>
  <input name=outside form=f1>
  <label for=missing>label<label>nested</label></label>
  <output for="a b c">result</output>
  <progress value=nan max=0>loading</progress>
  <meter min=10 max=2 low=bad high=999 value=-3>meter</meter>
</form>
</body>
</html>