<!DOCTYPE HTML PUBLIC "-//W3C//DTD HTML 3.2 Final//EN">
<html>
<head><title>obsolete inline elements</title></head>
<body bgcolor=#fff text="black" link=blue vlink=purple alink=red>
  <center><font face="serif" size=+7 color=red>Old <strike>style</font></center>
  <dir compact>
    <li>one
    <li><b>two<i>three</b>four</i>
  </dir>
  <ruby>
    漢字 <rp>(</rp><rt>かんじ</rt><rp>)</rp>
    <rtc><rb>extra</rb><rt>annotation</rt></rtc>
  </ruby>
  <bdo dir=sideways>direction</bdo>
  <bdi><wbr>isolated</bdi>
  <marquee behavior=alternate scrollamount=999999 direction=diagonal>
    <blink>moving</blink><nobr>long&nbsp;text</nobr>
  </marquee>
  <ins cite="x" datetime=never>inserted<del datetime="2020-99-99">deleted</ins></del>
  <hr noshade size=0 width=wat>
  <isindex prompt="Search:">
</body>
</html>