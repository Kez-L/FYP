<!doctype html>
<html>
<head>
  <title>Namespaces and declarations</title>
</head>
<body>
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 10 10">
    <g transform="translate(1,2)">
      <text x="1" y="2">svg text</text>
      <foreignObject><html xmlns="http://www.w3.org/1999/xhtml">
        <body><p>embedded</p></body>
      </html></foreignObject>
      <use href="#missing" xlink:href="javascript:alert(1)"/>
    </g>
  </svg>
  <math xmlns="http://www.w3.org/1998/Math/MathML">
    <mrow><mfrac><mi>a</mi><mo></mfrac><mo>&amp;</mo></mrow>
  </math>
  <div xmlns:p="urn:test" p:item="v" xml:lang="x" xml:base="">
    <p:unknown><p:child /></p:unknown>
  </div>
  <!-- nested <!-- comment --> remainder -->
  <![CDATA[ outside foreign content ]]>
  <hr />
</body>
</html>