<!DOCTYPE html>
<html>
<head>
  <title>Ruby and phrasing edge cases</title>
</head>
<body>
  <p>
    <ruby>
      漢<rt>かん</rt><rp>(</rp><rt>kan</rt><rp>)</rp>
      <rb>字</rb><rtc><span>annotation</span></rtc>
    </ruby>
    <bdi dir=rtl>abc123</bdi>
    <bdo dir=sideways>forced direction</bdo>
    <wbr><mark>highlight <time datetime="not-a-date">yesterday</time></mark>
  </p>
  <p>
    <ins cite="/a" datetime="2020-99-99"><del cite=none>old</del>new</ins>
    <dfn title=definition>term</dfn>
    <abbr title="long title">abbr</abbr>
    <data value="1&2">payload</data>
  </p>
  <pre><code>line 1
  <kbd>Ctrl</kbd><samp>output</samp>
  </code></pre>
  <p><a href="javascript:alert(1)" target="_blank" rel=noopener">link</a>
  <q cite="x"><cite>citation</q></cite></p>
</body>
</html>