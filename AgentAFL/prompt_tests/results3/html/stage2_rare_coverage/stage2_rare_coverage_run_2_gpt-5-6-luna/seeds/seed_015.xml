<!DOCTYPE html>
<html>
<head>
  <title>Foreign content and malformed attributes</title>
  <meta charset="utf-8">
</head>
<body>
  <svg viewBox="0 0 100 100" width="100" height="100">
    <title>svg title</title>
    <foreignObject x="0" y="0" width="80" height="80">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p class="inside">embedded <em>HTML</em></p>
      </div>
    </foreignObject>
    <path d="M0 0 L10 20 Z" fill="url(#missing)" />
  </svg>
  <math display="block">
    <mrow><mi>x</mi><mo>=</mo><msup><mi>y</mi><mn>2</mn></msup></mrow>
  </math>
  <p data-a="one" data-b='two" three' data-c=unquoted&value>
    &notanentity; &#x; &#99999999; &#x110000;
  </p>
</body>
</html>