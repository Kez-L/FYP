<!DOCTYPE html>
<html>
<head><title>Table mutation</title></head>
<body>
<table border=1>
<caption>Rows &amp; columns</caption>
<colgroup><col span="2"><col>
<thead><tr><th>A<th>B<th>C
<tbody>
<tr><td rowspan=3><div>one<tr><td colspan="x">two<td>three
<tr><td><select name=s><option>one<option selected>two</select>
<tr><td><textarea rows=2 cols=3>raw <b>text</textarea><td>
<tfoot><tr><td><form><input name=x><button>go</table>
</body>
</html>