<!DOCTYPE html>
<html>
<head><title>Interactive controls</title></head>
<body>
  <dialog open=maybe>
    <form method="dialog" action="/submit?x=1&y=2">
      <fieldset disabled>
        <legend>Choose <small>one</small></legend>
        <label for=a>Alpha</label>
        <input id=a name=choice type=radio checked=checked value="&quot;">
        <label><input name=choice type=radio value=beta>Beta</label>
        <button type=submit formaction="/other" formmethod=post>Go</button>
      </fieldset>
      <select name=items multiple size=999999999999999999>
        <optgroup label="Group one">
          <option selected value=x>First
          <option disabled>Second
        </optgroup>
        <option>Orphan selection</option>
      </select>
      <textarea name=note rows=-1 cols=zero>raw &lt;textarea&gt;
      </textarea>
      <output for="a missing">result</output>
    </form>
  </dialog>
  <details open="false"><summary>Summary</summary><p>Details</p></details>
</body>
</html>