<!DOCTYPE html>
<html>
<head>
  <base href="http://example.invalid/">
  <title>Legacy controls</title>
</head>
<body bgcolor="#fff" onload="start()">
  <isindex prompt="Search:">
  <form method=post enctype="multipart/form-data" accept-charset="UTF-8, ISO-8859-1">
    <fieldset disabled>
      <legend>Account</legend>
      <label for="u">User</label>
      <input id=u name=user type=text value="a&amp;b" maxlength=999999999999999999999>
      <label>Password <input name=p type=password autocomplete=off></label>
    </fieldset>
    <fieldset>
      <select name=mode multiple size=0>
        <optgroup label="A&amp;B"><option value=1 selected>one</optgroup>
        <option disabled value="2">two
      </select>
      <textarea name=note wrap=hard cols="-1" rows="999999">line 1
line 2 &amp; <b>raw</b></textarea>
      <input type=image src="" alt="submit" border=garbage>
      <button type=submit formaction="/x?a=1&b=2">Send</button>
    </fieldset>
  </form>
  <hr noshade="noshade" width="100%" height="-3">
</body>
</html>