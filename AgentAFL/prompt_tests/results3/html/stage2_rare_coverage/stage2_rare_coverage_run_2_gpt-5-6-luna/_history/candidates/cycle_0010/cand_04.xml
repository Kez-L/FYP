<!DOCTYPE html>
<html>
<head>
  <title>Frames, maps, and mixed nesting</title>
</head>
<frameset cols="*,0,100%" rows="bad">
  <frame src="a.html" name=f1 frameborder=maybe scrolling=side>
  <frameset>
    <frame srcdoc="<html><body><p>embedded</p></body></html>">
    <noframes>
      <body>
        <p>Fallback
        <map name=m>
          <area shape=poly coords="0,0,10,10,garbage" href=x alt=a>
          <area shape=rect coords=1,2,3 href>
          <img src="x" usemap="#m" ismap>
        </map>
        <object type="text/html" data="x">
          fallback <param name=p><div>inside object</div>
        </object>
        <applet code=x archive="a,b" width=NaN height=-1>
          <param name=foo value=bar>
          applet fallback
        </applet>
      </body>
    </noframes>
  </frameset>
</frameset>
<body>
  <p>Content after frameset
  <a href="x"><area href=y><img src=x alt=z></a>
  <details open=closed><summary>Summary<summary>Again</summary>body</details>
  <ruby>漢<rt>kanji<rp>(</rp></ruby>
</body>
</html>