<!doctype html>
<html>
<head><title>forms and malformed attributes</title></head>
<body>
<form id=f1 action=/one method=GET enctype=multipart/form-data>
  <input name=a value="x" disabled readonly required autofocus>
  <input name=b type=image src=submit.png alt=go>
  <select name=s>
    <option value=1>one</option>
    <option value=2 selected=maybe>two</option>
    <optgroup label="unclosed group">
      <option>three
  </select>
  <textarea name=t maxlength=notanumber>hello</textarea>
  <button name=go value="a&b" type=reset>Reset
  <form action=/nested><input type=text name=inner></form>
  <input type=file accept=image/* multiple=0>
</form>
<form action="/two" novalidate="x">
  <fieldset><legend><label>Label <input type=checkbox checked></legend>
  <output for="a b">result</output>
  <meter min=10 max=1 low=x high=y optimum=z value=NaN>meter</meter>
</fieldset>
</form>
</body>
</html>