<!DOCTYPE html>
<html>
<head>
  <title>Adoption and namespaces</title>
</head>
<body>
  <b><i><u>one</b>two</i>three</u>
  <p><a href=x><font color=red><div>split</a></font>tail</div>
  <svg viewBox="0 0 10 10" preserveAspectRatio="none">
    <title>svg title</title>
    <g><foreignObject width=10 height=10>
      <body xmlns="http://www.w3.org/1999/xhtml"><p>foreign</p></body>
    </foreignObject></g>
  </svg>
  <math display=block>
    <mrow><mi>x</mi><mo>&lt;</mo><mstyle mathvariant=bold><mn>2</mn></mstyle></mrow>
  </math>
  <table><tr><td><form><input name=x></td></tr></table>
  <select multiple>
    <option selected=selected>one
    <option>two
    <option disabled><optgroup label="g"><option>three
  </select>
  <p><q cite="unterminated>quote<mark>mark</mark></q>
</body>
</html>