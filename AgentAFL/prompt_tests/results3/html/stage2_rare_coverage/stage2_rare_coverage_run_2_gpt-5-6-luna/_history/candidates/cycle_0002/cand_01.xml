<!DOCTYPE html>
<html>
<head>
  <title>Namespace repair</title>
</head>
<body>
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 10 10">
    <g transform="translate(1 2)" transform="scale(2)">
      <foreignObject width="8" height="8">
        <div xmlns="http://www.w3.org/1999/xhtml">
          <p>embedded <em>markup</em></p>
        </div>
      </foreignObject>
      <path d="M0 0 L 10 10 Z"></path>
    </g>
  </svg>
  <math xmlns="http://www.w3.org/1998/Math/MathML">
    <mrow><mi>x</mi><mo>&InvisibleTimes;</mo><msup><mi>y</mi><mn>2</mn></msup></mrow>
  </math>
  <custom:widget xmlns:custom="urn:test" custom:flag="yes"/>
</body>
</html>