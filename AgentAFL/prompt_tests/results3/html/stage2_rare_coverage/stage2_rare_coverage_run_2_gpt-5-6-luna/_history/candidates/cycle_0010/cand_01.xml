<!DOCTYPE html>
<html>
<head>
  <title>Table repair stress</title>
</head>
<body>
  <table border=1 cellpadding=0 cellspacing=-4 summary="x">
    <caption align=side>Caption
    <colgroup span="0"><col width=auto><col span=bogus>
    <thead><tr><th rowspan=999 colspan=-1>Header<th>Second
    <tbody>
      <tr><td>A<td>B<td>C
      <tr><td><table><tr><td>nested without closing
      <tfoot><tr><td colspan="not-a-number">Footer
    </tbody>
  </table>
  <p>After table
  <dl compact>
    <dt>Term one
    <dd>Definition <div>block inside definition
    <dt><em>Term two
    <dd><dd>Repeated definition
  </dl>
  <table><tr><td>x</table><tr><td>orphan row</td></tr>
  <div align=left><span>inline <table><td>cell</table> tail</span></div>
</body>