<!DOCTYPE html>
<html>
<head><title>Raw text and obsolete elements</title></head>
<body>
<plaintext>
Everything after this point is intended to challenge plaintext handling.
</plaintext>
<listing>one
two <b>three</b></listing>
<xmp><div>literal markup</div></xmp>
<noscript>
  <table><tr><td>fallback</noscript>
  <applet code="A.class" archive="a.jar,b.jar" width=0 height=-1>
    <param name=code value="A.class">
    fallback <object><param name=x><span>object text</span></object>
  </applet>
  <marquee direction=sideways behavior=scrollloop>moving</marquee>
  <blink><font face="Arial" size="+9" color=#12FG34>old text</font></blink>
</body>
</html>