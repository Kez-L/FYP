<!DOCTYPE html>
<html>
  <head><title>Forms and obsolete controls</title></head>
  <body>
    <form name=f method=INVALID enctype=x action=javascript:alert(1) onsubmit="return false">
      <input type=text name=user value="a" disabled readonly required autofocus multiple>
      <input type=image src=x alt= submit=submit>
      <button name=b formaction action="/x" type=unknown><img src=x>Click</button>
      <select name=s size=zero>
        text before
        <option value=a selected selected>Alpha
        <option value=b label="B"><b>Beta</b>
        <optiongroup label=wrong><option>Gamma
      </select>
      <textarea rows=-1 cols=999999999999999999 wrap=side>one
two
      <output for="a b" name=o>result</output>
      <keygen name=k challenge=x>
      <isindex prompt="Search:">
      <input type=file accept=image/* directory webkitdirectory>
    </form>
    <form><fieldset><legend><legend>double legend</legend><input></fieldset></form>
    <label><label for=missing>Nested labels</label></label>
    <marquee behavior=warp direction=diagonal><blink>old</blink></marquee>
  </body>
</html>