<!doctype html>
<html>
<head><title>Frames and raw text</title></head>
<body>
  <frameset cols="*,0,">
    <frame src="a" name="one" scrolling=maybe>
    <frameset rows="50%,">
      <frame srcdoc="<html><body><p>inner</p></body></html>" src=b>
      <noframes>
        <body><p>fallback</p></body>
      </noframes>
    </frameset>
  </frameset>
  <script type=text/plain>
    <div><p>raw script &amp; </script><script>reopened</script>
  </script>
  <textarea rows=1 cols=2>&lt;em&gt;literal</textarea>
  <xmp><b>not markup</b></xmp>
  <listing><i>listing</i></listing>
  <plaintext><h1>everything is text</h1>
</body>
</html>