<!DOCTYPE html>
<html>
<head>
  <title>forms and namespaces</title>
</head>
<body>
  <form id=f method=INVALID enctype=x target=_blank>
    <label>Label <input type=text name="a" value="&quot; onfocus=&quot;x"></label>
    <input type=image src=x formaction="/a" formenctype="bad">
    <select name=s size=0>
      <option label="L" value=v selected=off>visible
      <option><option value=two>two
    </select>
    <textarea rows=999999999999 cols=-8 wrap=sideways>&lt;/textarea><b>raw</b></textarea>
    <output for="a b" name=o><input></output>
    <button type=unknown disabled=false><span>button</span></button>
  </form>
  <form><fieldset><legend>one</legend><fieldset disabled="no"><legend>two</legend>
    <input type=checkbox checked="false"><input type=file multiple=maybe>
  </fieldset></fieldset></form>
  <svg:svg xmlns:svg="http://www.w3.org/2000/svg">
    <svg:foreignObject><html:div><p>x</svg:foreignObject></html:div>
    <svg:path d="M 0 0 L NaN NaN Z"/>
  </svg:svg>
  <math:math><math:mi>x</math:mi></math:math>
  <p id="x" id="y">end
</body>
</html>