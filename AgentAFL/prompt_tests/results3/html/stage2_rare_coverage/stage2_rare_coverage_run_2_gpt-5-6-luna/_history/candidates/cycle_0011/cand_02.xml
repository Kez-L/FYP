<!DOCTYPE html>
<html>
<head><title>Head boundary mutations</title>
<base href="/root/">
<link rel=stylesheet href=style.css>
<meta charset=UTF-8>
<style type=text/css>
body { color: red; } </style data-x>
<noscript><link rel=alternate href=x></noscript>
</head>
<body>
  <header id=top><hgroup><h1>Title<h2>Subtitle</hgroup></header>
  <main>
    <section><article>
      <h3>Article heading
      <p>Paragraph one
      <p>Paragraph two
      <div><span>nested <span>deep</div>
    </article></section>
    <aside><menu type=context>
      <li><a href=#a>first
      <li><button disabled=disabled name=b>second
    </menu></aside>
  </main>
  <footer><small>Footer</small></footer>
</body>
</html>