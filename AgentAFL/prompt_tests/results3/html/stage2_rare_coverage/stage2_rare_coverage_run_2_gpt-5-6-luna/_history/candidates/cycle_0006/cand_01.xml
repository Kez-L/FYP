<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml">
<head>
  <title>foreign content</title>
</head>
<body>
  <svg width="120" height="80" viewBox="0 0 120 80">
    <g id="layer" transform="translate(1 2)">
      <path d="M0,0 L10,20 Z" fill="url(#paint)" />
      <linearGradient id="paint"><stop offset="0%" stop-color="#fff"></stop><stop offset="100%"></linearGradient>
      <text x="2" y="20"><tspan>svg &amp; text</tspan></text>
    </g>
    <foreignObject width="50" height="20"><div xmlns="http://www.w3.org/1999/xhtml"><i>inside</i></div></foreignObject>
  </svg>
  <math xmlns="http://www.w3.org/1998/Math/MathML" display="block">
    <mrow><mi>x</mi><mo>=</mo><msup><mi>y</mi><mn>2</mn></msup></mrow>
    <annotation encoding="application/x-tex">x &lt; y</annotation>
  </math>
  <p><svg><circle cx="bad" cy="2" r="3"></svg>after</p>
</body>
</html>