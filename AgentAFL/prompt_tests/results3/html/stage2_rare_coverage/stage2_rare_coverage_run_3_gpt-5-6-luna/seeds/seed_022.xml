<!DOCTYPE html>
<html>
<head>
  <title>Misnested phrasing and annotations</title>
</head>
<body>
  <p><b><i><u>one <em>two</b> three</i> four</u> five
  <a href="x"><span>link <strong>strong</a> tail</span></strong>
  <p><ins cite="a" datetime="not-a-date">inserted <del>deleted</ins> remainder</del>
  <pre> preformatted
    <code>&lt;div&gt;</code>
  </pre>
  <blockquote cite="urn:x">
    <p>quote <q cite="q">nested quote <cite>source</q></cite>
  </blockquote>
  <dl>
    <dt>term 1
    <dd>definition 1
    <dt><span>term 2
    <dd><div>definition <mark>highlight</div></mark>
  </dl>
  <address><a href="mailto:a@b">contact <small>details</address>
  <p><time datetime="2024-99-99">yesterday</time><data value=abc>value</data>
</body>
</html>