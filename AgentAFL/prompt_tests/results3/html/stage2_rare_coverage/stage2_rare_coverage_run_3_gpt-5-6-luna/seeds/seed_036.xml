<!doctype html>
<html>
<head>
<title>Frames and quoted attributes</title>
</head>
<frameset cols="20%,*,20%" onload="x<y && y>z">
<frame src="left.html" name=left scrolling=no>
<frameset rows="*,100">
<frame src='middle.html' frameborder=0 marginwidth="0" marginheight=bad>
<frame src=right.html>
<noframes>
<body>
<h1>Fallback</h1>
<p><a href=home.html title="a > b < c">Home
<object data="movie.swf" classid="clsid:00000000-0000-0000-0000-000000000000">
<param name=movie value="a&b=c">
<embed src="movie.swf" width=0 height=-1></embed>
</object>
</body>
</noframes>
</frameset>
</frameset>
</html>