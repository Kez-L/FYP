<!DOCTYPE html>
<html lang=en>
<head><title>Form controls</title></head>
<body>
<form method="get" action="/search" enctype="multipart/form-data">
  <fieldset disabled>
    <legend><label for=q>Search <input id=q name=q value="a&b"></label></legend>
    <label><input type=text name=x required readonly></label>
    <select name=choice multiple size=0>
      <optgroup label="one" disabled>
        <option selected value=1>first
        <option value="2>second
      </optgroup>
      <option>third
    </select>
    <textarea name=notes wrap=invalid>line one
line two</textarea>
  </fieldset>
  <input type=checkbox checked=maybe>
  <input type=radio name=r>
  <input type=file accept="image/*,.x" multiple>
  <button type=submit><img src=x alt=go>Submit</button>
  <input type=image src="x" width="-1" height="99999999999999999999">
</form>
<label for=missing>orphan label</label>
<input name=outside form=no-such-form>
</body>
</html>