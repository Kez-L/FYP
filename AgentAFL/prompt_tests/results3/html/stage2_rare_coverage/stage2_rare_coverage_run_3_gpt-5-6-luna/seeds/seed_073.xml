<!DOCTYPE html>
<html>
<head>
<title>Form control mutation</title>
</head>
<body>
<form method=post action="/submit" enctype="multipart/form-data" accept-charset="UTF-8, UTF-16" onsubmit="return false">
<fieldset disabled="false"><legend>Choices</legend>
<label for=x>Pick <input id=x name=x type=text value="unterminated></label>
<input name=a type=checkbox checked=checked checked=false>
<input name=b type=radio value=one><input name=b type=radio value=two checked>
<select name=sel multiple size="-1">
<option selected selected="">one
<option value=2 disabled>two
<optgroup label="Group" disabled="no">
<option>three
</optgroup>
</select>
<textarea cols="999999999999999999999999999999999999" rows=0 wrap=hard>value
</textarea>
<button type=submit name=go value="&quot;>Send</button>
<input type=image src="" alt="submit">
</fieldset>
</form>
<form><input type=file accept="image/*,,," maxlength="-999"><output for=x y></output>
</form>
</body>
</html>