<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml">
<head>
  <title>Namespace transitions</title>
</head>
<body>
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 10 10">
    <foreignObject width="10" height="10">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p>HTML in SVG
          <svg><circle cx="NaN" cy="-1e99" r="INF"/></svg>
        </p>
      </div>
    </foreignObject>
    <script><![CDATA[
      if (a < b && c > d) { /* ]]> fake */ }
    ]]></script>
  </svg>
  <math xmlns="http://www.w3.org/1998/Math/MathML">
    <mrow><mi>x</mi><mo>&lt;</mo><mfrac><mi>a</mi><mi>b</mi></mfrac></mrow>
    <annotation-xml encoding="application/xhtml+xml">
      <div><b>annotation</b></div>
    </annotation-xml>
  </math>
  <p xmlns="">back to HTML &amp; text</p>
</body>
</html>