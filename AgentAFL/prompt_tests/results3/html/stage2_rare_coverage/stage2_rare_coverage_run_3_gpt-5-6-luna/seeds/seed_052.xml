<!doctype html>
<html>
<head>
  <template id="outer">
    <table><tr><td>template cell</td></tr></table>
    <template><p>nested template</p></template>
  </template>
  <title>Template and shadow-like content</title>
</head>
<body>
<template>
  <form><input name=x><button type=submit>Go</button></form>
  <select><option>hidden choice</option></select>
</template>
<main>
  <template shadowrootmode="open">
    <style>:host{display:block}</style>
    <slot name="label">default</slot>
  </template>
  <div slot=label>slotted <span>content</div>
  <script type="text/plain"><![CDATA[
    <not-an-element attr='x'>
  ]]></script>
</main>
<noscript>
  <p>noscript text <img src=x></p>
</noscript>
<script>
  if (a < b && c > d) { document.write("<i>raw</i>"); }
</script>
</body>
</html>