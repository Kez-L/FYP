<!DOCTYPE html>
<html>
<head><title>forms with unusual controls</title></head>
<body>
<form method="get" action="/search" enctype="multipart/form-data">
  <fieldset disabled="disabled"><legend>Options</legend>
    <label for="q">Query</label><input id="q" name="q" type="search" required minlength="2" maxlength="999999">
    <input name="hidden" type="hidden" value="&bad;">
    <textarea name="memo" rows="0" cols="-1" wrap="hard">first
second</textarea>
    <select name="choice" multiple size="0">
      <optgroup label="group"><option value="1" selected>One<option value="2">Two</optgroup>
      <option label="unclosed">Three
    </select>
  </fieldset>
  <fieldset><legend><b>More</b></legend>
    <input type="number" min="nan" max="1e999" step="0">
    <input type="date" value="2020-99-99">
    <input type="file" accept="text/html,image/*" multiple>
    <button type="submit" formaction="/x" formmethod="dialog">Go</button>
    <button type="reset"><img src="r" alt="reset"></button>
  </fieldset>
</form>
<details open="false"><summary>summary</summary><p>details body</details>
<dialog open>dialog <button autofocus>close</button></dialog>
</body>
</html>