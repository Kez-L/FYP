<!doctype html>
<html>
<head>
<meta http-equiv="Content-Type" content="text/html; charset=windows-1252">
<title>Controls and labels</title>
</head>
<body>
<form id="checkout" action="/submit?x=1&amp;y=2" method="POST" enctype="multipart/form-data">
  <fieldset disabled>
    <legend>Account &amp; profile</legend>
    <label for=user>Name</label>
    <input id=user name=user value="A &quot;quoted&quot; value" maxlength=999999>
    <label>Email <input type=email name=email required></label>
  </fieldset>
  <fieldset>
    <legend>Options</legend>
    <input type=checkbox name=flag checked=checked value=on>
    <input type=radio name=kind value=one checked>
    <input type=radio name=kind value=two>
    <select name=choice multiple size=0>
      <optgroup label="Group 1">
        <option value=a selected>Alpha
        <option value=b>Beta</option>
      </optgroup>
      <option label="dangling" value=c>Gamma
    </select>
    <textarea name=notes rows="01" cols="999">&lt;/textarea&gt; &amp; unfinished
  <button type=submit name=go value="&copy;">Send</button>
  <input type=image src="button.png" alt="Send image" formaction="/other">
  <input type=file name=upload accept="image/*,.txt" multiple>
</form>
<form><input name=outside><button>second</button></form>
<output for="user email">result</output>
</body>
</html>