<!DOCTYPE HTML PUBLIC "-//W3C//DTD HTML 4.01//EN">
<html>
<head>
<title>Forms and controls</title>
</head>
<body>
<form method="get" action="/search" enctype="multipart/form-data">
<fieldset disabled="false"><legend>Choose &amp; enter</legend>
<label for="q">Query<input id="q" name="q" type="search" required="yes" maxlength="-1"></label>
<select name="pick" multiple="multiple" size="999999999">
<option selected>first<option value="2">second
<optgroup label="Group"><option>third</optgroup>
</select>
<textarea name="memo" rows="-3" cols="0">one
two</textarea>
<input type="number" min="nan" max="1e999" step="0" value="999999999999999999999">
<input type="file" accept="image/*,.wat" multiple="no">
<input type="image" src="data:image/gif;base64,R0lGODlh" alt="submit">
<button type="reset"><span>Reset</button>
</fieldset>
</form>
<form><input name="a"><form><input name="b"></form></form>
<output for="q missing">result</output>
</body>
</html>