<!doctype html>
<html>
<head>
<meta charset="utf-8">
<title>Misnested inline controls</title>
<style type="text/css">
@media screen and (max-width: 0px) { body > p:first-child { color: red } }
</style>
</head>
<body>
<p><b><i><u>alpha <em>beta</b> gamma</u> delta</i> epsilon</p>
<p><label for=x>Label <input id=x name=q value="a&#x0; b &unknown; c"></label>
<button type=submit disabled=maybe><span>Send</button></span></p>
<dl compact>
<dt>Term <dd>Definition <dt>Second <dd><a href="x?y=1&amp;z=2">Link
<blockquote cite='a"b<c>d' dir=invalid><q>quote</blockquote>
<p><small><big><strike>obsolete</small> outside</big></strike></p>
</body>
</html>