<!doctype html>
<html>
<head><title>URL and metadata variants</title></head>
<body>
<base href="https://example.invalid/a/b/">
<nav>
  <a href="">empty</a>
  <a href="//host/path?x=1#frag">network path</a>
  <a href="javascript:/*x*/void(0)" rel="nofollow noopener">script</a>
  <a href="data:text/plain,%3Ctag%3E">data</a>
</nav>
<main>
  <article itemscope itemtype="http://schema.org/Thing">
    <hgroup><h1 itemprop=name>Title</h1><h6>small</h6></hgroup>
    <time datetime="not-a-date">yesterday</time>
    <data value="&#xFFFFFFFF;">value</data>
    <meter min=10 max=2 low=-1 high=999 optimum=NaN value=abc>meter</meter>
    <progress max="-0" value="1e309">progress</progress>
    <picture>
      <source media="(min-width: 0px)" srcset="a 1x, b 2x,">
      <source type="image/avif" srcset>
      <img srcset="one.png 100w, two.png 200w" sizes="(x) 50vw" alt=pic>
    </picture>
    <details><summary>open me</summary><ul><li>one<li>two<li>three</ul></details>
  </article>
  <aside><ol start="999999999999999999999999" reversed type="i"><li value="-4">item</li></ol></aside>
</main>
<footer><small>© &reg; &trade; &amp;broken</small></footer>
</body>
</html>