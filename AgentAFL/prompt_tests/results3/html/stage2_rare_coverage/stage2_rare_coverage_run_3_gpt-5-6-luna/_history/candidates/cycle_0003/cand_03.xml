<!DOCTYPE html>
<html>
<head>
  <title>frameset collision</title>
</head>
<frameset rows="0,*,NaN" cols="50%,50%,">
  <frame src="about:blank" name="a" scrolling="garbage">
  <frameset cols="*">
    <frame src="javascript:/*x*/void(0)" frameborder="-1">
    <noframes>
      <body>
        <h1>fallback</h1>
        <iframe srcdoc="<p>one &amp; <b>two" sandbox="allow-scripts allow-scripts"></iframe>
      </body>
    </noframes>
  </frameset>
  <frame>
</frameset>
<body>
  <object data="x" type="application/x-unknown">
    <param name="movie" value="x">
    <embed src="x" />
    fallback
  </object>
  <applet code="X.class" archive="a.jar,b.jar" width="0" height="-1">
    <param name="x" value="&">
  </applet>
</body>
</html>