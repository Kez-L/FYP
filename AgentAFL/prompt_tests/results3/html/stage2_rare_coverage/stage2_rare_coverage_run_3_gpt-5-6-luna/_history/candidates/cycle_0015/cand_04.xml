<!DOCTYPE html>
<html>
<head>
<title>Embedding and raw foreign-looking elements</title>
</head>
<body>
<object classid="clsid:deadbeef" data="file:///dev/null" type="application/x-unknown" width="999999999999999999">
<param name=name value="x"><param name=value>
<embed src="javascript:alert(1)" pluginspage="x" hidden="maybe">
<noembed>fallback <a href="x">link</a></noembed>
</object>
<applet code="A.class" archive="a.jar,b.jar" object="bad" width="0" height="-1">
<param name=code value="x">
fallback
</applet>
<iframe srcdoc="<p>inner</p><iframe src='x'>" name="f" scrolling=maybe frameborder=999>
<marquee behavior=scroll direction=diagonal loop="-999999999999999999999999">moving
<blink>blink</blink></marquee>
<map name=m><area shape=poly coords="0,0,999999999999999999999,foo" href=# alt=x><area nohref></map>
<img usemap="#m" srcset="a 1x, b 999999999999x, c" sizes="(min-width: ) 50vw">
<video autoplay controls="false" poster="x"><source src=x type=video/unknown><track kind=bogus></video>
</body>
</html>