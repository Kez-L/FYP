<!DOCTYPE html>
<html>
<head><title>lists maps and tables</title></head>
<body>
<ol start="-999" reversed type="i">
  <li value="0">zero</li>
  <li>one
    <ol><li>nested A<li>nested B<ul><li>deep</ul></ol>
  <li>two
</ol>
<menu><li>menu item<li><input type="checkbox" checked>checked item</menu>
<table summary="data" border="0" cellpadding="x" cellspacing="-4">
  <colgroup span="3"><col width="*"><col width="0"><col></colgroup>
  <thead><tr><th scope="col" colspan="0">A<th rowspan="-1">B<th>C</thead>
  <tbody>
    <tr><td rowspan="999">1<td>2<td>3
    <tr><td colspan="999">wide
  </tbody>
  <tfoot><tr><td>footer</table>
<map name="m"><area shape="rect" coords="0,0,10,10" href="#"><area href="no-shape"></map>
<img src="map.png" usemap="#m" width="NaN" height="-2">
</body>
</html>