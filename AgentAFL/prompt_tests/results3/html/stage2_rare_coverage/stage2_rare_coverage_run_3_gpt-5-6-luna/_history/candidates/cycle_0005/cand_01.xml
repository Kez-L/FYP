<!doctype html>
<html>
<head>
  <title>Foreign content boundaries</title>
</head>
<body>
  <svg width="120" height="80" viewBox="0 0 120 80">
    <g transform="translate(2,3)">
      <rect x="0" y="0" width="40" height="20" fill="red"></rect>
      <foreignObject x="5" y="5" width="90" height="40">
        <div xmlns="http://www.w3.org/1999/xhtml">
          <p>embedded <b>HTML</b></p>
          <math><mrow><mi>x</mi><mo>&lt;</mo><mn>10</mn></mrow></math>
        </div>
      </foreignObject>
    </g>
    <path d="M0 0 L10 20 Q 20 30 40 0 Z" />
  </svg>
  <math display="block">
    <munder><mo>∑</mo><mi>i=0</mi></munder>
    <mfrac><msup><mi>a</mi><mn>2</mn></msup><mn>0</mn>
  </math>
  <p>after foreign content</p>
</body>
</html>