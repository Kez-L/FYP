<!DOCTYPE html>
<html>
<head>
  <title>processing and malformed declarations</title>
  <?xml version="1.0" encoding="UTF-8"?>
  <?processing instruction ?>
  <!--[if IE]><script>alert("x")</script><![endif]-->
</head>
<body>
  <template id="t"><div><p>template text</div></p></template>
  <script type="application/ld+json">{"name":"x","items":[1,2,],"bad":}</script>
  <script>
    if (a < b && c > d) { document.write("</textarea><p>x"); }
    /* unterminated-looking <tag> */
  </script>
  <noscript><p>fallback <b>bold</noscript>
  <blockquote cite="urn:test"><p>quoted <cite>source</cite></blockquote>
  <time datetime="not-a-date">tomorrow</time>
  <data value="&amp;broken">value</data>
  <ruby>漢<rb>字<rp>(</rp><rt>kan</rt><rp>)</rp></ruby>
  <div><span><br><wbr><hr><img src alt="a" title="b"></span>
  <p>after unclosed division
</body>
</html>