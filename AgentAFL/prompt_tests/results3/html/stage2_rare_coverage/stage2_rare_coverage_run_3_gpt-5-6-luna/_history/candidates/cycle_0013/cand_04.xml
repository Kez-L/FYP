<!DOCTYPE html>
<html>
<head><title>Metadata and embedded boundaries</title></head>
<body>
<template id=t><div>template <p>content</template>
<dialog open><form method=dialog><p>Are you sure?<menu><button value=yes>Yes</button><button value=no>No</button></menu></form>
<object type="text/html" data="page.html" name=obj>
<param name=x value=y><source src=a><track kind=captions src=c.vtt>
fallback <iframe name=i src="about:blank">frame fallback</object>
<video controls poster=p preload=none><source src=a type=video/mp4><source src=b><track default kind=subtitles src=s><p>video fallback</video>
<audio autoplay loop muted><source src=x></audio>
<map name=m><area shape=rect coords="0,0,999999999999999999999" href=x alt=x><area nohref></map>
<img usemap="#m" ismap src="data:image/png;base64,">
<picture><source media="(min-width: 0px)" srcset="x"><img src=y alt=z></picture>
<iframe srcdoc="&lt;html&gt;&lt;body&gt;embedded&lt;/body&gt;&lt;/html&gt;" sandbox="allow-scripts allow-same-origin"></iframe>
<portal src="https://example.invalid"><p>portal fallback</p></portal>
<embed type="application/x-shockwave-flash" src="x" width="0" height="0">
<noscript><meta http-equiv=refresh content=0><p>noscript text</noscript>
</body>
</html>