<!doctype html>
<html>
<head><title>Long attribute and token boundaries</title></head>
<body>
  <form method="get" action="/search" enctype="multipart/form-data" accept-charset="UTF-8, UNKNOWN">
    <fieldset disabled="disabled"><legend>Controls</legend>
      <label>Name<input type=text name="n" value="&quot;&apos;&amp;&lt;&gt;&#12;&#x1f;"></label>
      <label><input type=checkbox checked=checked value></label>
      <button type=button name=b formaction="/x" formmethod=post>click</button>
    </fieldset>
  </form>
  <dl>
    <dt><dd><dd>orphan
    <dt>one
    <dd>two
  </dl>
  <menu type=context>
    <li value="9223372036854775808">large
    <li value="-9223372036854775809">small
  </menu>
  <figure>
    <img src="a" srcset="a 1x, b 999999999999999999w, c," alt>
    <figcaption>caption
  </figure>
  <p><q cite="a&amp;b&quot;c">quote</q>
  <wbr><time datetime="not-a-date">time</time>
  <data value=>data</data>
</body>
</html>