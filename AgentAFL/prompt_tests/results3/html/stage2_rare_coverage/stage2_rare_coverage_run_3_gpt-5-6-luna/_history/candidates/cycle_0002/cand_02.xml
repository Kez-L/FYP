<!DOCTYPE html>
<html>
<head><title>svg math and foreign content</title></head>
<body>
<svg width="10" height="10" viewBox="0 0 10 10">
  <defs><linearGradient id="g"><stop offset="0%"/><stop offset="100%"/></linearGradient></defs>
  <g transform="translate(1,2) rotate(3)"><path d="M0 0 L1 1 Z" fill="url(#g)"/>
    <text x="0" y="1">svg <tspan>text</tspan></text>
  </g>
  <foreignObject><div xmlns="http://www.w3.org/1999/xhtml"><p>embedded html</p><table><tr><td>x</td></tr></table></div></foreignObject>
</svg>
<math display="block"><mrow><mi>x</mi><mo>=</mo><mfrac><mn>1</mn><msqrt><mn>4</mn></msqrt></mfrac></mrow></math>
<object data="movie.bin" type="application/octet-stream" width="0" height="0">
  <param name="quality" value="high"><embed src="fallback.swf" type="application/x-shockwave-flash">
  fallback <iframe srcdoc="<p>nested</p>" sandbox="allow-scripts"></iframe>
</object>
</body>
</html>