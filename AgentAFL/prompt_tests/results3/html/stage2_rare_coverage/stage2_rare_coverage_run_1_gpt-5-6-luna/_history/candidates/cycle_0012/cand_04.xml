<!DOCTYPE html>
<html>
<head><title>Attributes and obsolete containers</title></head>
<body>
<marquee behavior=scroll direction=left loop=-1>
  <font face="Arial" size=+7 color="#12zz99">moving text</font>
</marquee>
<applet code=Demo.class archive="a.jar,b.jar" width=0 height=-1>
  <param name=movie value="x&amp;y">
  <param name=quality value=high>
  fallback &copy;
</applet>
<object classid="clsid:00000000" data=data:text/plain,hello>
  <embed src="movie.swf" hidden=false></embed>
  <noembed>alternate</noembed>
</object>
<map name=map1>
<area shape=rect coords="0,0,10,10" href=#one>
<area shape=circle coords=bad href>
</map>
<img src="x" usemap="#map1" ismap="false">
<dir compact><li>directory item</dir>
<menu><li>menu item</menu>
</body>
</html>