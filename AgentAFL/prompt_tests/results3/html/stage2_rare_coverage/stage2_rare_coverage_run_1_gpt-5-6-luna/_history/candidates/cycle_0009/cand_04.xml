<!DOCTYPE HTML PUBLIC "-//W3C//DTD HTML 4.01//EN">
<html>
<head><title>Legacy controls and maps</title></head>
<body>
<isindex prompt="Search:">
<center><font face="serif" size="+7" color=red>Old</font></center>
<marquee direction=left behavior=alternate><blink>moving text</blink></marquee>
<map name=planet>
<area shape=rect coords="0,0,10,10" href=a>
<area shape=circle coords="20,20,5" href=b alt="B">
<area nohref>
</map>
<img src="x" usemap="#planet" border=0 alt="map">
<select name=choice multiple size=3>
<option selected value=one>One
<option value=two disabled>Two
<optgroup label="Group"><option>Three<option value=>
</select>
<fieldset disabled><legend>Legend</legend>
<textarea name=message rows=2 cols=8 wrap=hard>one
two</textarea>
<keygen name=key challenge=test>
</fieldset>
<form>
<input type=text name=a value=first><input type=text name=b>
<input type=image src=x alt=go>
<button name=go value="1"><font>Submit</button>
</form>
<pre><code>if (x < 3) { y &= z; }</code></pre>
</body>
</html>