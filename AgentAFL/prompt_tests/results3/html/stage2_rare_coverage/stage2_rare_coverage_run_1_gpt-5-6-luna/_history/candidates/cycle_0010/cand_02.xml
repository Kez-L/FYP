<!DOCTYPE html PUBLIC "-//W3C//DTD HTML 4.0//EN">
<html>
<head><title>Interactive controls</title></head>
<body>
  <form method=POST action=/submit enctype=multipart/form-data>
    <fieldset disabled>
      <legend><label for=q>Search <input id=q name=q value="a&b"></label></legend>
      <label>Choice
        <select name=kind multiple size=0>
          <optgroup label=One disabled>
            <option selected value=1>one
            <option value=2>two
          </optgroup>
          <option>three
          <option label="four &amp; five" value=4>
        </select>
      </label>
      <textarea required readonly>value</textarea>
    </fieldset>
    <input type=hidden name=h value=x>
    <input type=image src=x alt=submit>
    <button type=submit name=b value="x y"><strong>Send</button>
    <button type=reset><img src=x></button>
  </form>
  <form>
    <input type=text name=a><input type=text name=b>
  </form>
  <label for=missing>orphan label</label>
  <isindex prompt="Find:">
  <menu compact><li>first<li>second<ul><li>nested</ul></menu>
</body>
</html>