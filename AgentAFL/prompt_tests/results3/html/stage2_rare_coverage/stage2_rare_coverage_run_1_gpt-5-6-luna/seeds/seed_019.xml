<!doctype html>
<html>
<head><title>interactive fragments</title></head>
<body>
<dialog open><form method=dialog>
  <menu type=context>
    <menuitem label="One" onclick="a<b"></menuitem>
    <li>fallback
  </menu>
  <label>Pick <select name=s>
    <option value=1>one
    <option value=2 selected=selected>two
    <optgroup label="broken"><option>three
  </select></label>
  <output for="x y">result</output>
  <meter min=10 max=0 low=foo high=bar value=-3>bad meter</meter>
  <progress value="nan" max="x">wait</progress>
  <button type=submit formaction=/go formmethod=invalid>Submit
</form></dialog>
<details><summary>summary</summary>
  <object data="x" type="text/html"><param name=p value=v>
    <embed src=x><noscript>fallback
</details>
</body>
</html>