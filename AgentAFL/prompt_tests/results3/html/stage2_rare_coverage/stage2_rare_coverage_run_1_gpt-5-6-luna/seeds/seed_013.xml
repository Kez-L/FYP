<!DOCTYPE html>
<html>
<head><title>Foreign content boundaries</title></head>
<body>
<svg viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
<defs><linearGradient id=g><stop offset="0%" stop-color="red"/><stop offset=1 stop-color="blue"></linearGradient></defs>
<g transform="translate(1,2)"><rect x=0 y=0 width=10 height=20 fill=url(#g)>
<foreignObject x=2 y=3 width=40 height=20><div xmlns="http://www.w3.org/1999/xhtml"><p>HTML in SVG<br><input disabled></div></foreignObject>
<text x=4 y=8><![CDATA[angle < text & stuff]]></text>
</g></svg>
<math xmlns="http://www.w3.org/1998/Math/MathML"><mi>x</mi><mo>&lt;</mo><mfrac><mn>1</mn><mn>2</mn></mfrac><annotation-xml encoding="application/xhtml+xml"><div>math child</div></annotation-xml></math>
<p>back in HTML <svg><circle r=4></svg> end</p>
</body>
</html>