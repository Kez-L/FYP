<!doctype html>
<html xmlns="http://www.w3.org/1999/xhtml">
<head>
<title>Foreign content boundary</title>
</head>
<body>
<svg width="100" height="100" viewBox="0 0 100 100">
<g transform="translate(10 10)">
<rect x="0" y="0" width="80" height="40" fill="url(#paint)"/>
<text x="5" y="20">SVG <tspan>text</tspan></text>
<foreignObject><div xmlns="http://www.w3.org/1999/xhtml">
  <p>embedded html <em>inside</svg>
</div></foreignObject>
</g>
<defs><linearGradient id="paint"><stop offset="0%"><stop offset="100%"></linearGradient></defs>
</svg>
<math display="block"><mrow><mi>x</mi><mo>=</mo><mfrac><mn>1</mn><msqrt><mn>4</mn></msqrt></mfrac></mrow></math>
<p>tail</p>
</body>
</html>