<!DOCTYPE html>
<html>
<head><title>Table stress</title></head>
<body>
<table border="1" cellpadding="0">
<caption>Rows &amp; columns</caption>
<colgroup span="2"><col width="*"><col style="width: 10px"></colgroup>
<thead><tr><th rowspan="2" colspan="0">A<th>B<th>C</tr><tr><th>missing close<td>1</thead>
<tbody>
<tr><td><div>cell<div>nested</td><td colspan="-1">2<td>3
<tr><th scope="row"><a href=#x>link<td><table><tr><td>inner</table><td>outer
</tbody>
