<!doctype HTML PUBLIC "-//W3C//DTD HTML 3.2 Final//EN">
<html>
<head>
<title>Frames and legacy flow</title>
</head>
<frameset rows="20%,*,0" cols="50%,50%">
<frame src="left.html" name=left scrolling=maybe>
<frame src="right.html" frameborder=none>
<noframes>
<body>
<center><font face="Arial" size="+7" color=red>Fallback</font></center>
<marquee direction=sideways behavior=loop scrollamount=-9>
<blink>moving <big>content</small>
</marquee>
<applet code="X.class" archive="x.jar" width=0 height=-2>
<param name=codebase value="/"><param name=object value=x>
applet fallback
</applet>
<dir><li>legacy one<li>legacy two</dir>
</body>
</noframes>
</frameset>
</html>