<!doctype html>
<html>
<head>
  <title>form controls</title>
</head>
<body>
  <form method="get" enctype="multipart/form-data" action="/submit" accept-charset="UTF-8">
    <fieldset disabled>
      <legend>Choose <em>one</legend>
      <label for=q>Query</label>
      <input id=q name=q type=text value="a&amp;b" maxlength="-1">
      <button type=submit name=go value="&lt;send&gt;">Send</button>
      <select name=pick multiple size=0>
        <optgroup label="Group 1">
          <option selected>one
          <option value=two disabled>two
        </optgroup>
        <option>unclosed
      </select>
      <textarea name=t rows=2 cols=0>text </textarea broken>
    </fieldset>
    <input type=image src=x alt=y>
  </form>
  <form><input name=a><form><input name=b></form></form>
</body>
</html>