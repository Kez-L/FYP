<!doctype html>
<html>
<head>
  <title>Objects and metadata</title>
  <meta name=description content="a > b & c">
  <link rel=stylesheet alternate href=one.css media="screen and (x)">
</head>
<body>
  <object classid="clsid:0000" codebase=/bin data=x>
    <param name=name value="a&b">
    <param name=value>
    <embed src=movie type=application/x-shockwave-flash width=0 height=-1>
    fallback <a href="#"><img src=missing alt="fallback"></a>
  </object>
  <map name=nav>
    <area shape=rect coords="0,0,10,10" href=one>
    <area shape=poly coords="1,2,3,4,5" nohref>
    <area>
  </map>
  <img src="x" usemap="#nav" ismap border=abc>
  <dl compact>
    <dt>Term 1
    <dd><p>Definition <q cite=http://x>quote</q>
    <dt><a href=two>Term 2</a></dt>
    <dd><div>nested<div>unclosed
  </dl>
  <blockquote cite="a&b"><pre> preformatted
  line 2 </blockquote>
  <center><marquee direction=sideways>moving <blink>text</center>
</body>
</html>