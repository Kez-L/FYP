<!doctype html>
<html>
<head><title>metadata and links</title></head>
<body>
<menu>
<menuitem label="Open" type="command" checked>
<menuitem label="Save" type="checkbox" disabled=false>
<li>legacy item
</menu>
<dl compact>
<dt>Term one
<dd>Definition one
<dt><span>Term two
<dd><p>Definition <mark>two</mark>
<dt><dd>empty pair
</dl>
<details open="no"><summary>Summary <b>bold</details>
<dialog open>Dialog text <button autofocus="false">Close</button></dialog>
<figure><img src=x><figcaption>caption before?</figure>
<picture>
<source media="(min-width: 1px)" srcset="a 1x, b 2x">
<source type="image/webp">
<img src="fallback" alt="image">
</picture>
</body>
</html>