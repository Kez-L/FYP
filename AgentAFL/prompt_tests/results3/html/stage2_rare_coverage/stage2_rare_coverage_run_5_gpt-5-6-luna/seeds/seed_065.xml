<!DOCTYPE html>
<html>
<head>
<meta http-equiv="Content-Type" content="text/html; charset=windows-1252">
<base href="http://example.test/a/b/">
<title>Frames and obsolete declarations</title>
<frameset rows="20%,*,0" cols="50%,50%">
  <frame name="top" src="top.html" noresize scrolling="no">
  <frameset cols="30%,70%">
    <frame src="left.html" frameborder=0>
    <frame src="right.html" marginwidth="0" marginheight=bad>
  </frameset>
  <noframes>
    <body bgcolor=#ffffff text=black link=blue vlink=#800080 alink=red>
      <h1>Fallback <font face="Arial" size="+3" color="red">content</font></h1>
      <center><isindex prompt="Search:"><hr></center>
      <marquee direction=left behavior=alternate width=100%>
        <blink>old browser text</blink>
      </marquee>
    </body>
  </noframes>
</frameset>
</html>