<html>
<head><title>forms and controls</title></head>
<body>
<form method=WHAT action="/submit?x=1&y=2" enctype=multipart/form-data>
<fieldset disabled="maybe">
<legend><label for=x>Choose <i>one</label></legend>
<label><input id=x name=pick type=radio value=a checked=FALSE>a
<input name=pick type=radio value=b CHECKED=perhaps>b</label>
<select name=sel multiple=0 size=huge>
<option value=1 selected>first
<option value=2>second
<optgroup label="group"><option>third</select>
<textarea name=comments rows=NaN cols=-4 wrap=sideways>one
two &lt; three</textarea>
<button type=submit name=go value="a&b">Send <img src="x" alt=">"></button>
<input type=image src=x alt=go>
<input type=file accept="image/*,," maxlength=-1>
<input type=hidden name=h value="unterminated>
</fieldset>
</form>
<isindex prompt="Search:">
</body>
</html>