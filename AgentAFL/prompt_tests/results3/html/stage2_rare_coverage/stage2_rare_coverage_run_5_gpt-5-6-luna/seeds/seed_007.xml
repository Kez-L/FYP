<!DOCTYPE html>
<html>
<head>
  <title>Forms and obsolete controls</title>
</head>
<body>
<form id=f method=dialog enctype="multipart/form-data" accept-charset="x-invalid">
  <fieldset disabled="disabled">
    <legend>Credentials</legend>
    <label for=u>User</label>
    <input id=u name=user value="a&amp;b" type=text readonly=FALSE>
    <label>Password <input name=p type=password maxlength=abc></label>
  </fieldset>
  <select name=choice multiple size=0>
    <optgroup label="Group 1">
      <option selected value=x>one
      <option disabled>two
    </optgroup>
    <option>three
  </select>
  <textarea name=msg cols=bad rows=-3 wrap=weird>raw &lt;b&gt;
  <button type=submit formaction="/x">Send</button>
  <button type=reset><img src="submit.gif" alt="reset"></button>
  <input type=image src="/button" alt=go usemap="#m">
</form>
<map name=m><area shape=rect coords="0,0,10,10" href="/"></map>
<frameset rows="*,0">
  <frame src="left.html" name=left>
  <frame src="right.html" noresize>
  <noframes><body>fallback</body></noframes>
</frameset>
</html>