<html>
<head>
<title>Table repair input</title>
</head>
<body>
<table border=1 cellpadding=2 cellspacing=3 width=100%>
<caption align=bottom>caption after broken rows</caption>
<colgroup span=3 width="33%">
<col align=left>
<col span=2 valign=middle>
<thead>
<tr><th rowspan=2>Header<th colspan=2>Other
</thead>
<tbody>
<tr><td>A<td>B<td>C
<tr><td colspan=4>D
<tfoot>
<tr><td>E
<tbody>
<tr><td>F</tr><tr><td><table><tr><td>nested</table>
</table>
<p>after<table><tr><td>implicit close
<div>division inside cell</div>
</body>
</html>