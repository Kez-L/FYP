<!DOCTYPE html>
<html>
<head>
<title>forms and interactive controls</title>
</head>
<body>
<form id=f method=POST action="/submit" enctype="multipart/form-data">
<fieldset disabled>
<legend>Options <b>now</legend>
<label for=a>Alpha</label><input id=a type=text name=a required minlength="x" maxlength="-1">
<label><input type=checkbox checked=maybe>Beta</label>
<select name=s multiple size=0>
<option value=1 selected>One
<optgroup label="Group"><option>Two<option disabled>Three</optgroup>
</select>
<textarea name=t disabled rows=0 cols=-2>value</textarea>
</fieldset>
<input type=image src=x alt=submit formaction="/other">
<button type=reset><span>Reset</button>
<output name=o for="a b">result</output>
</form>
<form><input type=submit><form><input name=n></form></form>
<iframe srcdoc="<p>inside &amp; <b>frame</b>" sandbox=allow-scripts></iframe>
<details open="false"><summary>summary</summary><p>details text</p></details>
</body>
</html>