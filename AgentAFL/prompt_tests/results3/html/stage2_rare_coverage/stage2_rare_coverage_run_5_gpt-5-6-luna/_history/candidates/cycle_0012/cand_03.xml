<!DOCTYPE html>
<html>
<head><title>Lists and forms</title></head>
<body>
<dl compact>
<dt>term one
<dd>definition <p>paragraph in definition
<dt><dd><dl><dt>inner<dd>value</dl>
</dl>
<menu type=context>
<li value=0>zero
<li value="-999999999999999999999">negative
<li><a href=#a>link item
</menu>
<form action="/submit" method=GET target=_blank>
<fieldset disabled><legend>Account</legend>
<input type=text name=user maxlength=-1 size=999999999999999999>
<input type=password name=pass autocomplete=off>
</fieldset>
<select name=choice size=0 multiple>
<option selected value=1>One
<option value=2 disabled>Two
<optgroup label="Group"><option>Three</optgroup>
</select>
<input type=file accept="image/*,.x" multiple>
<input type=image src="x" border=abc>
<textarea name=notes wrap=hard rows=0 cols=-5>line1
line2</textarea>
<input type=submit value="Send"><input type=reset>
</form>
<ol type=z start=abc><li>first<li><li>third</ol>
</body>
</html>