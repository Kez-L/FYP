<!doctype html>
<html>
<head><title>Frameset transition</title></head>
<frameset cols="25%,*,0" onload="x<y">
  <frame src="a.html" name="left">
  <frameset rows="50,*">
    <frame src="b.html">
    <noframes>
      <body>
        <h2>Fallback</h2>
        <iframe src="nested.html" width="100" height="100">
          fallback <object data="x"><param name="movie" value="x"></object>
        </iframe>
      </body>
    </noframes>
  </frameset>
  <frame src="c.html">
</frameset>
<frameset><frame><noframes>tail