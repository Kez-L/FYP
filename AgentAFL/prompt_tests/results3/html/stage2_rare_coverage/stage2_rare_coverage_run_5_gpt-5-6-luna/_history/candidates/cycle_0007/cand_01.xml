<!doctype html>
<html>
<head><title>foreign content</title></head>
<body>
<svg width="120" height="80" viewBox="0 0 120 80">
  <defs><linearGradient id="g"><stop offset="0%"/><stop offset="1"/></linearGradient></defs>
  <g transform="translate(2 3)">
    <rect x="0" y="0" width="90" height="40" fill="url(#g)"/>
    <text x="3" y="20"><tspan>SVG &amp; text</tspan></text>
    <foreignObject width="50" height="20"><div xmlns="http://www.w3.org/1999/xhtml"><b>HTML</b><br>inside</div></foreignObject>
  </g>
</svg>
<math display="block"><mrow><mi>x</mi><mo>=</mo><mfrac><mi>a</mi><mrow><mi>b</mi><mo>+</mo><mi>c</mi></mrow></mfrac></mrow></math>
<p>after <svg><circle cx="4" cy="4" r="3"><title>circle</title></svg> end</p>
</body>
</html>