<html>
<head>
<title>Frameset transition</title>
<base target=_top>
</head>
<frameset rows="20%,*,0" border=1 frameborder=yes>
<frame name=top src="top.html" scrolling=no noresize>
<frameset cols="30%,70%">
<frame src='left.html' marginwidth=0 marginheight=999999>
<noframes>
<body>
<h2>Fallback</h2>
<p>This content is shown when frames are unavailable.</p>
<iframe name=inner src=about:blank width=0 height=0 frameborder=0></iframe>
</body>
</noframes>
</frameset>
<frame src="bottom.html">
</frameset>
</html>