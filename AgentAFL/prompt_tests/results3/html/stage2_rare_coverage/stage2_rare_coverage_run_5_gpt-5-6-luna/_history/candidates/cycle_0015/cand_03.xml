<!DOCTYPE HTML PUBLIC "-//W3C//DTD HTML 3.2 Final//EN">
<HTML>
<HEAD>
<TITLE>Legacy element matrix</TITLE>
</HEAD>
<BODY>
<APPLET CODE="x.class" WIDTH="1" HEIGHT="2" ALIGN="middle">
  <PARAM NAME="x" VALUE="a>b">
  <OBJECT DATA="movie.bin" TYPE="application/octet-stream">
    <EMBED SRC="movie.swf" WIDTH="bad" HEIGHT="-1">
    fallback
  </OBJECT>
</APPLET>
<MAP NAME="m">
  <AREA SHAPE="poly" COORDS="1,2,three,4" HREF="x">
  <AREA NOHREF>
</MAP>
<IMG USEMAP="#m" SRC="x" ISMAP BORDER="999999999999999999999">
<HR NOSHADE SIZE="--" WIDTH="50%">
<CENTER><DIR><LI>one<LI>two</DIR></CENTER>
<ADDRESS><B><I>contact</B></ADDRESS>
<BLINK><FONT SIZE="garbage"><TT>legacy</FONT></TT></BLINK>
<FORM METHOD="GET" ENCTYPE="multipart/form-data" ACTION="a&b">
  <SELECT NAME="x">
    <OPTION VALUE="1" SELECTED=maybe>one
    <OPTIONGROUP LABEL="wrong"><OPTION>two</OPTIONGROUP>
  </SELECT>
</FORM>
</BODY>
</HTML>