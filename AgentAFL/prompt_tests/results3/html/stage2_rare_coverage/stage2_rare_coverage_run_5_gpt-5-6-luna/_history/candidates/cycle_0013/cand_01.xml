<!doctype html>
<html>
<head>
<title>Legacy interactive controls</title>
</head>
<body>
<form method=post action="/submit" enctype="multipart/form-data">
<fieldset disabled>
<legend>Profile &copy;</legend>
<label>Name <input name=user maxlength=04 size=20 value=alpha></label>
<label>Color <select name=color multiple size=0>
<option value=red selected>Red
<option value="green&blue">Green &amp; Blue
<optgroup label="Other">
<option>Yellow
</optgroup>
</select></label>
<textarea name=comment rows=2 cols=5 wrap=hard>one
two &amp; three</textarea>
</fieldset>
<input type=image src=/go.gif border=00 alt=Go>
<button type=submit name=send value=x><b>Send</b></button>
<input type=hidden name=a value="1>2">
</form>
<isindex prompt="Search this archive:">
<menu compact>
<li><a href=/a tabindex=1 accesskey=A>A</a>
<li><a href=/b tabindex=0>B</a>
</menu>
</body>
</html>