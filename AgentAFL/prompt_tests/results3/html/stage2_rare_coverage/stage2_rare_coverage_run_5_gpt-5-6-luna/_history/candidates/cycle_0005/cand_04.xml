<!DOCTYPE HTML PUBLIC "-//W3C//DTD HTML 4.01//EN">
<html>
<head>
  <title>mixed blocks</title>
</head>
<body>
  <center><h2>heading
  <table><tr><td>cell</center><p>paragraph after table
  <div align="middle"><marquee behavior=alternate direction=diagonal>
    moving <blink>text <font size="999" color="#12">colour</blink>
  </marquee></div>
  <hr width="101%" noshade="false">
  <pre>preformatted
    <b>bold</b> &broken; </pre>
  <xmp><b>literal</b> &amp; <end>
  <listing>listing text
  <hgroup><h1>one<h4>four</hgroup>
  <details open="no"><summary>summary</summary><p>contents
  <dialog open>dialogue <address>mail</address></dialog>
  <menu type=context><li>first<li>second</menu>
  <ruby>base<rt>annotation<rp>(</rp></ruby>
</body>
</html>