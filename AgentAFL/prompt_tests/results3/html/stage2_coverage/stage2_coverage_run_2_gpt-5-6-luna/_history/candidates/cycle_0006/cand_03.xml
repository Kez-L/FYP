<!doctype html>
<html>
  <head><title>forms and controls</title></head>
  <body>
    <form id=f1 action=/submit method=get>
      <fieldset disabled="false">
        <legend>choose <b>one</legend>
        <label for=q>Query</label>
        <input id=q name=q type=text value='a"b' maxlength="NaN">
        <input name=hidden type=hidden value=&amp;>
        <button type=submit formaction="/other">Go</button>
      </fieldset>
    </form>
    <form id=f2>
      <select name=pick size=00>
        <option value=one selected disabled>One
        <option value="two" selected="selected">Two</option>
        <optgroup label="group">
          <option>Three</optgroup>
      </select>
      <textarea name=t readonly=maybe>alpha &copy; beta</textarea>
      <input type=file multiple accept="image/*,">
      <input type=checkbox checked="no">
      <output for="q pick">result</output>
    </form>
    <form><input form=f1><button><select><option>x</select></button></form>
  </body>
</html>