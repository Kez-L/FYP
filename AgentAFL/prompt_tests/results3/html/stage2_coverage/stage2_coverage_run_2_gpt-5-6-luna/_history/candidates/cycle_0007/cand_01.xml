<!doctype html>
<html>
<head><title>frames and objects</title></head>
<frameset rows="20%,*,0" cols="50%,50%">
  <frame src="one.html" name=left scrolling=maybe>
  <frame src=two.html noresize>
  <frameset>
    <frame>
  </frameset>
  <noframes>
    <body>
      <p>Fallback <a href="x" target=_blank>link
      <object data="movie.bin" type="application/octet-stream" width=bad height=-1>
        <param name=autoplay value=true>
        <embed src=plugin.dat hidden>
        fallback text
      </object>
      <applet code=Test.class archive=a.jar width=0 height=0>
        <param name=foo value="bar">
      </applet>
    </body>
  </noframes>
</frameset>
</html>