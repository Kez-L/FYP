<title>mixed namespaces</title>
</head>
<body>
<x:widget data-a="1<2" x:flag="yes">
<x:item><![CDATA[ raw <tag> & stuff ]]></x:item>
</x:widget>
<svg width="1e309" viewBox="0 0 10 10">
<foreignObject><div xmlns="http://www.w3.org/1999/xhtml">inside svg</div></foreignObject>
<path d="M0 0 L10 10 Z" fill="url(#x)"/>
</svg>
<math><mrow><mi>x</mi><mo>&InvisibleTimes;</mo><mn>2</mn></mrow></math>
<p><bdo dir="sideways">direction</bdo><br/></p>
