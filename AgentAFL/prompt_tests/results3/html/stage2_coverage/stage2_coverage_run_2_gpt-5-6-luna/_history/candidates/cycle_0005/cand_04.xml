<!doctype html>
<html>
<head><title>interactive controls</title></head>
<body>
  <form id=f1 action="/submit" method="dialog">
    <fieldset disabled>
      <legend><label for=x>Choose <input id=x type=checkbox></label></legend>
      <label><input type=radio name=g checked=checked> A</label>
      <label><input type=radio name=g CHECKED="false"> B</label>
    </fieldset>
    <input type=file accept="image/*,.txt" capture multiple>
    <input type=number min=10 max=2 step=0 value=nan>
    <input type=date value=2026-99-99>
    <output for="x y">result</output>
    <meter min=high low=0 value=2 max=1 optimum=none></meter>
    <progress value=abc max=-1>progress</progress>
    <select>
      <option value=a>a
      <option value=b>b
    </select>
  </form>
  <form id=f2>
    <input form=f1 name=outside>
  </form>
  <menu type=context>
    <li><button type=button autofocus>Open</button>
    <li><button formaction=/x formmethod=GET>Go</button>
  </menu>
  <dialog open=true><p>dialog text<form><input></dialog>
  <iframe srcdoc="<p>nested &amp; text</p>" sandbox="allow-scripts allow-forms"></iframe>
</body>
</html>