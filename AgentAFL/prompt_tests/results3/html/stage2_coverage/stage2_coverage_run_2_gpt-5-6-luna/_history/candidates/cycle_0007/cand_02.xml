<!DOCTYPE html>
<html>
<head><title>lists and ruby</title></head>
<body>
  <menu compact>
    <li value=0>zero
    <li value="-3">negative
    <li><input type=button disabled=false>
  </menu>
  <ol start="abc" reversed="no">
    <li>one
    <li value=999999999999999999999999999>two
      <ol type=i start=-7><li>nested
  </ol>
  <dl compact="compact">
    <dt>Term 1
    <dd>Definition 1
    <dt><ruby>漢<rb>字<rt>kanji</ruby>
    <dd><ins datetime=tomorrow>Inserted</ins><del cite=x>Deleted
  </dl>
  <p><bdo dir=sideways>direction</bdo>
  <p><span dir="rtl"><wbr><bdi>isolated</bdi></span>
  <p><u><s><strike>old</strike></s></u>
</body>
</html>