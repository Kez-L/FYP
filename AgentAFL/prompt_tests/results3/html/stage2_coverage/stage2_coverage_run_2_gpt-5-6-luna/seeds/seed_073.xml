<!doctype html>
<html>
<head>
<title>Form controls and entities</title>
</head>
<body>
<form method="POST" action="/submit?x=1&y=2" enctype="multipart/form-data" accept-charset="utf-8,">
<fieldset disabled="false"><legend>Options
<label for="q">Query<input id="q" name="q" value="&notanentity; &#x110000; &#99999999;"></label>
<select name="choice" multiple="no" size="zero">
<option value=one selected>One
<option value="two" selected="selected">Two
<optgroup label="Group"><option>Three</optgroup>
</select>
<textarea name="memo" rows="NaN" cols="-3">first
second <b>literal?</textarea>
<input type="file" accept="image/*," required="sometimes">
<button type="submit" formaction="/other" formmethod="TRACE">Send</button>
<output for="q missing">result</output>
</fieldset>
</form>
<form><input type="text" name="a"><form><input type="hidden" name="b"></form>
</body>
</html>