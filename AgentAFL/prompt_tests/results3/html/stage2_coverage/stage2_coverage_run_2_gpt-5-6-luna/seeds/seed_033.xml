<!DOCTYPE html>
<html>
<head><title>forms and controls</title></head>
<body>
<form id=f method=invalid enctype=x action=/submit>
  <fieldset disabled="false">
    <legend><img src alt=legend></legend>
    <input type=text name=a maxlength=-2 size=999999 value="unterminated>
    <input type=file accept=image/* multiple=0>
    <input type=number min=ten max=two step=0 value=nan>
    <input type=date min=2030-01-01 max=1900-01-01>
    <input type=checkbox checked=off>
    <input type=radio name=r checked>
    <select name=s size=zero multiple="false">
      <optgroup label="A" disabled=no>
        <option selected=maybe value=>empty</option>
        <option label=x>text
      </optgroup>
      <option>after
    </select>
    <textarea cols=-1 rows=huge wrap=side>one
two &amp; three</textarea>
    <button type=bogus formaction=/other>submit</button>
    <output for="a b">result</output>
  </fieldset>
</form>
<isindex prompt="Search:" action=/q>
</body>
</html>