<!DOCTYPE html>
<html>
<head>
  <title>misnested inline elements</title>
</head>
<body>
<p><b><i><u>alpha</b> beta</i> gamma</u> delta
<p><a href=/one><em>first <strong>second</a> third</strong></em>
<blockquote cite="x"><q>quote <small>small <big>big</blockquote></q>
<pre>line 1
  <code>code <kbd>key</pre></kbd>
<address><span>name<br>street</address></span>
<dl>
  <dt>term 1
  <dd>definition 1
  <dt><b>term 2
  <dd><p>definition 2<div>block inside dd</dl>
<hr><hr/>
<center><font face=monospace size=+7 color=red>legacy</center>
</body>
</html>