<!DOCTYPE html>
<html>
  <head>
    <title>form controls</title>
  </head>
  <body>
    <form method="sideways" enctype="unknown/type" accept-charset="," action="&quot;">
      <fieldset disabled="false">
        <legend><label for=missing>Choose <input
        <input type="email" name="a" value="x" minlength="-5" maxlength="none">
        <input type="number" min="ten" max="-" step="0">
        <input type="date" value="2024-99-99">
        <select multiple="maybe" size="-1" name=sel>
          <option selected selected value="&bad;">one
          <optgroup label="group"><option>two</optgroup>
          <option value=three>three
        </select>
        <textarea rows="NaN" cols="-2">first
        <button type="unknown" formaction="x" formmethod="get">press</button>
        <output for="a b">result</output>
      </fieldset>
      <input type=image src="javascript:bad" usemap="#x">
    </form>
    <label><input type=checkbox checked=off> dangling label
  </body>
</html>