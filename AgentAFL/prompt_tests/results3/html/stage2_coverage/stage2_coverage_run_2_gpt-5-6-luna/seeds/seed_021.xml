<!DOCTYPE HTML PUBLIC "-//W3C//DTD HTML 3.2 Final//EN">
<html>
<head>
<title>frameset experiment
</head>
<frameset rows="20%,*,bad" cols="*" border=none>
  <frame src="one.html" name=left scrolling=yes>
  <frame src='two.html name=right noresize>
  <frameset cols="50%,50%">
    <frame src=three.html>
    <noframes>
      <body>
        <h1>Fallback</h1>
        <p>Frame text &copy; 2026
        <form method=POST enctype=multipart/form-data>
          <input type=text name=user value="a&b">
          <input type=image src=x alt=go>
          <select name=x multiple size=zero>
            <optgroup label=group disabled>
              <option selected>one
              <option value='two>two
            </optgroup>
          </select>
          <textarea rows=2 cols=3>literal <b> markup &amp unfinished</textarea>
          <button type=submit><b>Send</button>
        </form>
      </body>
    </noframes>
  </frameset>
</frameset>
</html>