<!DOCTYPE html>
<html>
<head><title>Forms and misplaced controls</title></head>
<body>
  <form id=f1 action="/submit" method="get">
    <input type=text name=q value="a&amp;b" required>
    <input type=checkbox name=c checked=checked>
    <select name=choice multiple size=2>
      <option value=one>One
      <option value=two selected>Two
      <option>Three
    </select>
    <button name=go value=1>Send</button>
  </form>
  <fieldset form=f1>
    <legend>Detached fieldset</legend>
    <label>Name <input type=text form=f1 autocomplete=off></label>
    <output for=q>result</output>
    <meter min=0 max=10 low=3 high=8 optimum=7 value=NaN>bad meter</meter>
    <progress max=100 value=200>complete</progress>
  </fieldset>
  <form>
    <input type=file accept="image/*,.txt" multiple>
    <input type=date min=2020-01-01 max=not-a-date value=2020-99-99>
    <textarea name=notes rows=2 cols=4 wrap=hard>line one
line two
line three</textarea>
  </form>
</body>
</html>