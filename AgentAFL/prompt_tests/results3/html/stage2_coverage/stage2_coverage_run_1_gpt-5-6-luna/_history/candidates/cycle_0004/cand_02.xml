<head>
  <title>foreign content</title>
  <script type="text/javascript">
    if (a < b && c > d) { document.write("<p>x</p>"); }
    // </script is text in this broken case
  <script>
  <noscript><div>fallback <b>bold</noscript>
</head>
<body>
  <svg width="100" height="100"><foreignObject x=0 y=0 width=50 height=50>
    <div xmlns="http://www.w3.org/1999/xhtml">mixed <em>content</div>
