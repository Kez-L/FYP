<!DOCTYPE html>
<html>
<head><title>frames and legacy forms</title></head>
<frameset rows="*,bad,0" cols="1,,999%">
<frame src="a" name="one" scrolling="sideways" frameborder="-1">
<frame src="b" noresize="false">
<noframes>
<body>
<form action="/submit" method="TRACE" target=_blank>
<input type=text name=x value="a&quot;b" checked="no" readonly="">
<input type=file accept=",,,," multiple="maybe">
<select name=pick multiple size=-1>
<option value=one>one
<option value=two selected=off>two
</select>
<textarea wrap=diagonal maxlength=not-a-number>first
second
</textarea>
<fieldset><legend>Legend</legend>
<input type=hidden>
<output for="x y">result</output>
</fieldset>
<input type=submit formaction=javascript:alert(1) formmethod=unknown>
</form>
<iframe srcdoc="<p>embedded <b>text</iframe>" sandbox="allow-everything">
</body>
</noframes>
</frameset>
</html>