<!DOCTYPE HTML>
<html>
<head>
  <title>Raw text and foreign elements</title>
  <script type="text/javascript">
    if (a < b && c > d) {
      document.write("<p class='x'>script</p>");
    }
  </script>
  <style>
    @media screen { body > p:first-child { color: rgb(1,2,3); } }
  </style>
</head>
<body>
  <noscript><p>fallback</p></noscript>
  <template id=t><div><span>template text</span></div></template>
  <p>before <svg width="20" height="20"><circle cx="5" cy="5" r="4"></circle><foreignObject><div>svg html</div></foreignObject></svg> after
  <math><mrow><mi>x</mi><mo>&lt;</mo><mn>2</mn></mrow></math>
  <textarea>&lt;tag&gt; &amp; not markup
</textarea>
  <script type=application/json>{"x":"</script><p>escape</p>"}</script>
</body>
</html>