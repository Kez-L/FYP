<!doctype html>
<html>
<head><title>frameset confusion</title></head>
<frameset rows="*,0,invalid" cols="25%,75%">
  <frame src="one.html" name=left scrolling=maybe frameborder=-1>
  <frameset>
    <frame src=two.html>
    <noframes>
      <body>
        <h2>No frames</h2>
        <a href="x" target=_parent><img src=missing alt="><br>
        <map name=nav>
          <area shape=poly coords="0,0,10,10,garbage" href=#one>
          <area href=#two>
        </map>
      </body>
    </noframes>
  </frameset>
  <frame>
</frameset>
<noframes><p>orphan fallback</p></noframes>