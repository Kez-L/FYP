<!DOCTYPE html>
<html>
<head><title>Metadata and ruby fragments</title></head>
<body>
  <ruby>
    漢 <rt>kan <rp>(</rt>ji<rp>)</rp>
    <rtc><rb>字</rb><rt>zi</rt></rtc>
  </ruby>
  <p lang="ar" dir="rtl">مرحبا <bdo dir="ltr">abc</bdo> xyz
  <ins datetime="not-a-date"><del cite="" datetime="9999-99-99">changed</ins></del>
  <time datetime="2026-99-99T25:61:61Z">tomorrow</time>
  <data value="NaN"><meter min=10 max=2 low=-1 high=999 optimum=abc value=5>meter</data>
  <progress max="0" value="Infinity">loading
  <details open=open>
    <summary>summary <summary>nested summary</summary></summary>
    <p>details body
  </details>
  <dialog open="maybe"><form><button command="--x">close</dialog></button></form>
  <menu type="context"><li>first<li><span>second</menu>
  <hr noshade="false" width="calc(100%"><wbr><br>
</body>
</html>