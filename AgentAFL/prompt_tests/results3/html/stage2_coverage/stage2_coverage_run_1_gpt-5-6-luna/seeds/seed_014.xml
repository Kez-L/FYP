<!doctype html>
<html>
<head>
  <title>block nesting and ruby entities</title>
  <style>
    .a { color: red; }
  </style>
</head>
<body>
  <header id=top>
    <nav><a href="#main">main<a href="#foot">foot</nav>
  </header>
  <main id=main>
    <article>
      <h2>Article
      <section><h3>Section one</h3>
        <p class=a>alpha <span>beta <div>unexpected block
        <blockquote cite="x"><p>quoted<br/>line<hr>tail
      </section>
      <aside>
        <ul><li>first<ul><li>nested<li>again</ul>
        <ol reversed start="bad"><li>item</ol>
      </aside>
    </article>
    <details open="false"><summary>More</summary>
      <p>hidden-ish content <wbr>break
    </details>
  </main>
  <footer id=foot><p>&#0; &#x10ffff; &ampersand &unknown; &copy; &notin;
    <span title="a&quot;b">end
  </footer>
</body>
</html>