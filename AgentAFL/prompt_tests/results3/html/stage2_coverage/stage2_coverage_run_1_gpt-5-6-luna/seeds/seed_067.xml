<!DOCTYPE html>
<html>
<head>
<title>legacy objects</title>
</head>
<body>
<frameset rows="*,0,abc" cols="50%,*" border=-1 frameborder=maybe>
<frame src="a.html" name=x scrolling=side marginwidth=NaN>
<frame src=about:blank noresize="false">
<noframes>
<body>
<p>fallback
<object classid="clsid:broken" codebase=/bad/ data="x" type=application/x-unknown standby="wait" width=Infinity height=-0>
<param name=movie value="&amp;broken">
<param name=name value>
<embed src="" pluginspage="javascript:bad" width=foo height=bar hidden=maybe>
<object>
<map name=map1>
<area shape=poly coords="1,2,three,4" href=x alt>
<area shape=rect coords="1,2" href>
</map>
<img src="x" usemap=#map1 ismap border=huge>
</object>
</noframes>
</frameset>
</body>
</html>