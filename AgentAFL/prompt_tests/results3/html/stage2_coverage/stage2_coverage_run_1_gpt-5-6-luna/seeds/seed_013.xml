<!DOCTYPE html>
<html>
<head>
  <title>form controls</title>
</head>
<body>
  <form method=post enctype=multipart/form-data>
    <fieldset disabled>
      <legend>Account <b>details</legend>
      <label for=user>User:
      <input id=user name=user type=text maxlength=999 value="a&amp;b">
      <label>Password <input type=password name=p required>
    </fieldset>
    <select name=choice multiple size=0>
      <optgroup label=First disabled>
        <option selected value=one>One
        <option value=two>Two</option>
      </optgroup>
      <option>Outside
    </select>
    <button type=submit formaction=/submit>Send <i>now</button>
    <button type=reset>Reset</button>
    <input type=image src=go.png alt=go>
    <input type=file accept="image/*,.txt" multiple>
    <output name=result for="user choice">result</output>
  </form>
  <form>
    <input name=x>
  </form>
  <p><label><input type=checkbox checked=checked>wrapped label
</body>
</html>