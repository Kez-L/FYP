<!DOCTYPE html>
<html>
<head><title>Foreign content boundary</title></head>
<body>
  <svg width="not-a-number" height="-" viewBox="0 0 100" preserveAspectRatio="xMidYMid?">
    <title>svg title</title>
    <g transform="translate(1,2) rotate(foo)" onclick="x<y">
      <path d="M0 0 L 10 ZZZ L" fill="url(#missing)" />
      <foreignObject><div xmlns="http://www.w3.org/1999/xhtml">
        <p>HTML inside SVG <br /></p>
      </div></foreignObject>
      <circle cx="NaN" cy="Infinity" r="-4"></circle>
    </g>
  </svg>
  <math display="sideways">
    <mrow><mi>x</mi><mo>&InvisibleTimes;</mo><msup><mi>y</mi><mn>2</mn></msup>
    <mtext><b>text in math</b></mtext></mrow>
    <annotation-xml encoding="application/xhtml+xml"><p>annotation</p></annotation-xml>
  </math>
  <p>after foreign content</p>
</body>
</html>