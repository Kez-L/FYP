<!DOCTYPE HTML PUBLIC "-//W3C//DTD HTML 4.01//EN">
<html>
<head><title>Legacy frames and mixed declarations</title></head>
<frameset rows="*,0" cols="50%,50%">
  <frame src="left.html" name=left scrolling=auto noresize>
  <frame src="right.html" name=right frameborder=bogus>
  <noframes>
    <body>
      <center><font size=7 color="#12">Fallback</font></center>
      <dir compact>
        <li>alpha
        <li><a href="javascript:">beta</a>
      </dir>
      <menu type=context>
        <li value=999>item
      </menu>
      <table>
        <tr><td>legacy
      </table>
      <pre>  preformatted
  <b>mixed</b> text</pre>
      <hr width="50%" align=middle>
      <address>mail &lt;broken@example.test</address>
    </body>
  </noframes>
</frameset>
</html>