<!doctype html>
<html xmlns="http://www.w3.org/1999/xhtml" xml:lang="zz">
<head>
  <title>Namespace stress</title>
</head>
<body>
  <svg:svg width="100" height="100" viewBox="0 0 10 10">
    <svg:foreignObject width="50" height="50">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p>embedded <b>HTML</svg:foreignObject></b>
    </svg:svg>
  <math xmlns="http://www.w3.org/1998/Math/MathML">
    <mi>x</mi><mo>&InvisibleTimes;</mo><mfrac><mn>1</mn><mrow><mi>y</mi>
  </math>
  <object data="movie.swf" type="application/x-shockwave-flash">
    <param name="movie" value="x.swf">
    fallback <embed src=x width="0" height="-1"></object>
  <iframe srcdoc="<p>nested &amp; text</p>" sandbox="allow-scripts allow-forms">
    iframe fallback
  </iframe>
  <p><a name=foo id=foo name=bar href="#&bad">duplicate anchors
</body>
</html>