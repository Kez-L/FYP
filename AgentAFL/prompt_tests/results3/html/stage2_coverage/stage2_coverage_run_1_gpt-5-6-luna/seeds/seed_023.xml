<!doctype html>
<html>
<head><title>Head element permutations</title>
  <base href="http://example.test/root/">
  <meta name=viewport content="width=device-width, initial-scale=1">
  <link rel="alternate" type="application/rss+xml" href=feed.xml>
  <link rel=icon href=data:image/gif;base64,AAAA>
  <meta http-equiv=refresh content="0; url='next page.html">
</head>
<body>
  <header><hgroup><h1>News</h1><h2>Today</h2></hgroup></header>
  <main>
    <article itemscope itemtype="http://schema.org/Article">
      <time itemprop=datePublished datetime=2024-13-40>tomorrow</time>
      <p itemprop=articleBody>Text <wbr>split <mark>highlight</mark>
      <figure><img srcset="a 1w, b 2x, c 0w" sizes="(max-width: 2px) 1px" alt=""><figcaption>caption</figcaption></figure>
    </article>
    <aside><details open=maybe><summary>More</summary><p>hidden content</details></aside>
  </main>
  <footer><nav><a href=#one>one<a href=#two>two</nav></footer>
</body>
</html>