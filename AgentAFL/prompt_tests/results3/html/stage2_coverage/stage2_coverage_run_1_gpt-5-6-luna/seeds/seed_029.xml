<!DOCTYPE html>
<html>
<head><title>Obsolete layout and media recovery</title></head>
<body>
  <center>
    <table border=0 cellpadding=bogus cellspacing=-4>
      <tr><td>
        <marquee behavior=alternate direction=sideways scrollamount=-2>
          moving <blink>text
        </marquee>
      </td></tr>
    </table>
  </center>
  <isindex prompt=">> Search <<">
  <form action="javascript:alert('x')" method="TRACE">
    <input type="text" name="q" accesskey="&" tabindex="-999999999999">
  </form>
  <noembed><p>fallback <img src="" alt="a > b"></noembed>
  <picture>
    <source media="(min-width: 0px" srcset="a 1x, b 2x,, c">
    <source type="image/" srcset="">
    <img srcset="one.png 100w two.png 200w" sizes="calc(100% - )" alt=broken>
  </picture>
  <object>
    <video autoplay="false" controls="maybe" poster=>
      <track kind=subtitles srclang=xx src=missing.vtt default=0>
      video fallback
    <audio src=a.mp3><source src=b.ogg type=audio/ogg>
  </object>
  <frameset rows="*,invalid,0" cols="25%,*">
    <frame src="a.html" name="a">
    <frame src="b.html" noresize="false">
    <noframes><body>frames fallback</body></noframes>
  </frameset>
</body>
</html>