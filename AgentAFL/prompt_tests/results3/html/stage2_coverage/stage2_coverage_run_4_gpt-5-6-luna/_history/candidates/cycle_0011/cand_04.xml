<!DOCTYPE HTML PUBLIC "-//W3C//DTD HTML 4.0//EN">
<html>
<head>
<title>Misnested lists and definitions</title>
</head>
<body>
<menu compact="compact">
  <li>alpha
  <li><dl><dt>term<dd>definition<ul><li>deep<li>deeper</dl>
  <li><p>paragraph<div>block<strong>strong<em>em</div>after</li>
</menu>
<blockquote cite="http://example.invalid/?a=1&b=2">
  <q>quote <cite>source</blockquote>
<center><address>name<br>street</address></center>
<dir>
  <li type="square">x
  <li value="0">y
</dir>
<hr width="0" size="-20">
</body>
</html>