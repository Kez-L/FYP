<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN">
<html xmlns="http://www.w3.org/1999/xhtml">
<head><title>Broken table model</title></head>
<body>
<table border="1" summary="&not-an-entity;">
  <caption align="middle">Table <b>caption</caption>
  <colgroup span="3"><col width="25%"><col><col style="bad:"></colgroup>
  <thead>
    <tr><th rowspan="2">A<th colspan="2">B
    <tr><th>C<td>D
  </thead>
  <tbody>
    <tr><td><p>cell one<tr><td colspan="99">cell two
    <tr><th><div>heading inside row</div><td>tail</tbody>
  <tfoot><tr><td>footer</table>
<p>after the table<table><tr><td>another<table><tr><td>nested</table></td></tr></table>
</body>
</html>