<!DOCTYPE html>
<html>
<head>
<title>Frames and maps</title>
</head>
<frameset rows="*,0,invalid" cols="20%,80%">
  <frame src="left.html" name="nav" scrolling="maybe" frameborder=wat>
  <frameset>
    <frame src=right.html>
    <noframes>
      <body>
        <p>This is fallback content.
        <map name=planet>
          <area shape=rect coords="0,0,10" href="/one" alt="one">
          <area shape=poly coords="1,2,three,4,5" nohref>
          <area shape=circle coords="x,y,r" href="">
        </map>
        <img src="map.gif" usemap="#planet" ismap>
        <object data="movie.bin" type="application/octet-stream">
          <param name=autoplay value=true>
          <param name=width value=bad>
          fallback <embed src=x pluginspage="unterminated>
        </object>
      </body>
    </noframes>
  </frameset>
</frameset>
</html>