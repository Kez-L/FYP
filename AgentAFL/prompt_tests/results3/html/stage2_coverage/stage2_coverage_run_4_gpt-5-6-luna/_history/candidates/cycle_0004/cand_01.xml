<!DOCTYPE html>
<html>
<head><title>Frameset collision</title></head>
<frameset rows="20%,*,20%" frameborder="maybe">
  <frame src="top.html" name=top scrolling=sideways>
  <frameset cols="25%,75%">
    <frame src="left.html">
    <noframes>
      <body>
        <p>This text is inside a noframes body.
        <form method=post enctype=multipart/form-data>
          <label for=q>Query
          <input id=q name=q value="unterminated>
          <button type=submit>Send
        </form>
      </body>
    </noframes>
  </frameset>
  <frame src="bottom.html">
</frameset>