<!doctype html>
<html>
<head>
  <title>Frames and legacy declarations</title>
  <base target=_blank>
</head>
<frameset rows="20%,*,0" frameborder="wat">
  <frame src="left.html" name=left scrolling=maybe>
  <frameset cols="*,*" border="negative">
    <frame src="a.html">
    <frame src=javascript:alert(1) noresize>
  </frameset>
  <noframes>
    <body>
      <h2>Fallback</h2>
      <iframe srcdoc="<p>inside &amp; quoted</p>" width="abc"></iframe>
      <p><a href="mailto:a@b">link
    </body>
  </noframes>
</frameset>
</html>