<!doctype html>
<html lang=en>
<head>
  <title>Objects and alternate content</title>
  <link rel=alternate media=screen href=feed.xml>
  <style media="all & invalid">.x{background:url("x");}</style>
</head>
<body>
<object classid="clsid:ABC" codebase=/bad width=zero height=-1>
  <param name=movie value="clip.mov">
  <param name=autoplay value=true>
  <embed src=clip.swf type="application/x-shockwave-flash" width=100 height=bad>
  <noembed><p>Fallback <img src=missing alt=broken></p></noembed>
</object>
<applet code=Test.class archive="a.jar,b.jar" width=10 height=10>
  <param name=code value="x">
  applet fallback
</applet>
<map name=MAP>
  <area shape=rect coords="0,0,10" href=/a alt=A>
  <area shape=poly coords="1,2,3,4,5" href=>
</map>
<img src="photo" usemap="#MAP" ismap border>
<iframe srcdoc="<p>nested</p>" src=/frame frameborder=maybe></iframe>
</body>
</html>