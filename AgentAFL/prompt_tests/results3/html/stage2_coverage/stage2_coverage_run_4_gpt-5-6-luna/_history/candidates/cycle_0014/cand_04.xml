<!doctype html>
<html lang=en>
<head><title>list and definition repair</title></head>
<body>
<ol start="zero" reversed="maybe" type="I">
  <li value="NaN">first
    <ul compact=compact>
      <li type="square">nested one
      <li><dl compact>
        <dt>term one
        <dd>definition one
        <dt><b>term two
        <dd><table><tr><th>inside definition</table>
      </dl>
  <li>second
</ol>
<menu>
  <li><a href="one" name="x">one
  <li><button type=button onclick="x<y">two</button>
</menu>
<dir><li>legacy A<li>legacy B</dir>
<p><small><big><center>mixed formatting</small></big></center>
<figure><figcaption>caption</figcaption><img src=broken alt></figure>
</body>
</html>