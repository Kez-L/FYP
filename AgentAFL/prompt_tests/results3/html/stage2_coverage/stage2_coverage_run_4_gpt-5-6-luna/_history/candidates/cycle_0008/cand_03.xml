<!DOCTYPE html>
<html>
<head><title>Form controls</title></head>
<body>
<form method=post action=/submit enctype=multipart/form-data>
<fieldset disabled>
<legend>Account <b>details</legend>
<label for=user>User:</label><input id=user name=user value='abc"def' required>
<select name=choice multiple size=999>
<option value=one selected>One
<option value=two>Two
<optgroup label=Group><option>Three</optgroup>
</select>
<textarea name=note rows=2 cols=0>line one
line two</textarea>
<button type=submit formaction=/other>Send
</fieldset>
<input type=image src=x alt=submit>
<output name=result for=user>old</output>
<progress max=10 value=20>loading</progress>
<meter min=10 max=5 low=20 high=-1 optimum=bogus value=abc>meter</meter>
</form>
</body>
</html>