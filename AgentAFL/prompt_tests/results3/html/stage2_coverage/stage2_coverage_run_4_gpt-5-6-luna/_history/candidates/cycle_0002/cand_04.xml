<!doctype html>
<html>
<head>
  <title>Form controls and entities</title>
</head>
<body>
<form method="INVALID" action="?" enctype="bad/type" accept-charset="," onsubmit="&quot;">
  <label for=missing>Label<label>Nested
  <input type="text" name="a" value="one" maxlength="-7" size="zero">
  <input type="file" name=file accept="image/*,,">
  <select name=s multiple="maybe" size="-1">
    <optgroup label="group" disabled="sometimes">
      <option value=1 selected=selected>one
      <option value="2>two
    </optgroup>
    <option>three
  </select>
  <textarea name=note rows="x" cols="-3" wrap=diagonal>&lt;tag
  <button type=maybe name=x value="a&b">button
  <fieldset disabled=false>
    <legend>legend</legend>
    <input type=radio name=r checked="0">
    <input type=checkbox name=c checked>
  </fieldset>
  <input type=image src alt="submit">
</form>
<dl compact="no">
  <dt>term
  <dd>definition
  <dt><dd>empty pair
</dl>
</body>
</html>