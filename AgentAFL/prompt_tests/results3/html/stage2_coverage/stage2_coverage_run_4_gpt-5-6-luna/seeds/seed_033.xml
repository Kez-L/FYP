<!doctype html>
<html>
<head>
<title>Interactive controls</title>
</head>
<body>
<form method=dialog enctype=unknown accept-charset="utf-8, , latin1" autocomplete=maybe>
<fieldset disabled="false">
<legend><label for=a>Choose</label></legend>
<label><input id=a name=x type=number min=ten max=-2 step=0 value=1e999></label>
<label><input name=x type=date value=2024-99-99 checked="no"></label>
<select name=pick multiple size=-8>
<optgroup label="group" disabled=maybe>
<option value=a selected=false>A
<option value=b label="B" selected>text
</optgroup>
<option>orphan
</select>
<textarea name=note rows=bad cols=-1 wrap=sideways>one
two</textarea>
<button type=unknown formaction="unterminated>click</button>
<output for="a b c">result</output>
</fieldset>
</form>
</body>
</html>