<!doctype html>
<html>
<head>
  <title>Form controls with broken boundaries</title>
</head>
<body>
<form method="POST" action="/submit" enctype="multipart/form-data">
  <fieldset disabled>
    <legend>Account &copy;
    <label for=u>Name <input id=u name=user value="a&b" maxlength="-1"></label>
    <label>Password <input type=password name=pw></label>
  </fieldset>
  <select name=choice multiple size="zero">
    <optgroup label="Group one">
      <option selected value=1>One
      <option value="2">Two</optgroup>
    <option>Three
  </select>
  <textarea name=notes rows=abc cols=3 wrap=hard>one
two</textarea>
  <input type=image src=x border=bad>
  <button type=submit disabled="maybe">Send <b>now</button>
  <input type=hidden name=h value="&amp;quot;">
</form>
<div contenteditable spellcheck=unknown><br><hr noshade size=bad></div>
</body>
</html>