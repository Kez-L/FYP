<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Strict//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">
<head><title>Mixed namespaces and declarations</title></head>
<body>
<svg width="bad" height="-1" viewBox="0 0 100">
  <title>vector</title>
  <foreignObject requiredExtensions="x">
    <div xmlns="http://www.w3.org/1999/xhtml">embedded <br/></div>
  </foreignObject>
  <path d="M 0 0 L nope Z" fill="url(#x)" />
</svg>
<math display="sideways">
  <mrow><mi>x</mi><mo>&lt;</mo><mn>2</mn></mrow>
  <annotation-xml encoding="text/html"><p>math html</p></annotation-xml>
</math>
<form>
  <input type=hidden name=token value="a&b">
  <input type=file accept=image/* multiple=maybe>
  <input type=number min=abc max=1 step=0 value=999>
  <input type=date value=not-a-date>
  <input type=checkbox checked="false">
  <input type=submit formaction="http://[bad" formenctype=text/plain>
</form>
<template id=t><div>template <span>content</template>
<canvas width=foo height=bar>fallback</canvas>
</body>
</html>