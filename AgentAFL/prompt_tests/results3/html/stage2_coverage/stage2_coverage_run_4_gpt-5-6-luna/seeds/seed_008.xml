<!DOCTYPE HTML PUBLIC "-//IETF//DTD HTML 2.0//EN">
<html>
<head><title>Table attribute collision</title></head>
<body>
<table align="diagonal" width="wide" height="-" cellpadding="-4"
       cellspacing="999999999999999999999999" border="hello">
  <caption align="sideways">caption
  <colgroup span="-2" width="25*">
    <col align="bogus" valign="middle" width="0">
    <col span="NaN">
  <thead align=right>
    <tr bgcolor=#12>
      <th nowrap="false" abbr= title="head">H1
      <th scope=side colspan="-1">H2
  <tbody>
    <tr valign="up">
      <td headers="a b" height="--" width="%" bgcolor="rgb(1,2">
        cell one
      <td><div>cell two
  <tfoot>
    <tr><td colspan="999999999999999999999">footer
</table>
<table><tr><td>unclosed nested
<table><tr><td>x</table>
</body>
</html>