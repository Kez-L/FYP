<!DOCTYPE html>
<html>
<head>
  <title>Inline legacy elements</title>
</head>
<body>
<center><font face="A&amp;B" size="+9" color="#12GG00">
  <b><i><u><strike><big><small>Nested inline text
</center>
<pre width="not-a-number">  preserved
  <code>&lt;tag attr='x'&gt;</code></pre>
<blockquote cite="unterminated>
  <q cite=/quote>quoted <sup>2</sup><sub>n</sub></q>
</blockquote>
<address><a href=mailto:test@example.invalid>Contact</address>
<marquee behavior=scroll direction=sideways loop=-2>
  scrolling &copy; text
</marquee>
<blink>old <s>formatting</s></blink>
<p>After <b>unclosed <i>style <u>stack</p>
</body>
</html>