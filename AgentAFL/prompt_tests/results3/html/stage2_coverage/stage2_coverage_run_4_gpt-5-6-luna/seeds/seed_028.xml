<!DOCTYPE html>
<html>
<head><title>Form controls</title></head>
<body>
<form id=f method=patch enctype="multipart/form-data; boundary=" action=javascript:alert(1)>
<fieldset disabled="no"><legend>settings</legend>
<label for=q>Query</label><input id=q name=q value="a&quot;b" minlength=-2 maxlength=9999999999 pattern="[">
<input type=file name=upload accept="image/*,," multiple=0 capture=maybe>
<input type=number min=10 max=1 step=0 value=nan>
<input type=date value="2020-02-31"><input type=color value="#12">
<input type=checkbox checked=false required=0>
<select name=pick multiple size=-3>
<option value=one selected=false>One
<option value=two label="Two">Two
<hr>
<optgroup disabled=none label="unterminated><option>three
</select>
<textarea name=note wrap=sideways maxlength=-7>one &lt; two
<output for="q missing">result</output>
<button type=reset formaction=/x formmethod=garbage>reset</button>
<input type=image src=x alt=bad width=huge height=-9>
</fieldset>
</form>
<input form=f name=outside>
</body>
</html>