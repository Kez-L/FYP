<!doctype html>
<html>
<head><title>obsolete and foreign content</title></head>
<body bgcolor=#fff text=black link=blue vlink=red alink=green>
<center><font face="Arial" size=+999 color=notacolor>
<marquee direction=sideways behavior=unknown scrollamount=-1>
<blink><big><small>legacy text</small></big></blink>
</marquee>
</font></center>
<frameset cols="*,0,999999" rows="1,*">
<frame src="a" name="one" scrolling=maybe>
<frame src="b" noresize>
<noframes><body><p>frames fallback</p></body></noframes>
</frameset>
<applet code="x" archive="a,b" width=0 height=-5>
<param name=foo value=bar><param name=foo>
fallback <img lowsrc=x>
</applet>
<map name=m><area shape=poly coords="0,0,1" href=javascript:bad></map>
<img usemap=#m ismap border=-1>
<menu compact><li>one<li>two</menu>
</body>
</html>