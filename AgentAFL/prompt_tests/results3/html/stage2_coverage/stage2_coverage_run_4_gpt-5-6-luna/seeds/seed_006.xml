<!doctype HTML PUBLIC "-//W3C//DTD HTML 4.0//EN">
<html>
<head><title>Object and map stress</title></head>
<body>
<object classid="clsid:00000000-0000-0000-0000-000000000000"
        codebase="/bad path/" standby="loading..." width=abc height=-20>
  <param name="movie" value="x&y">
  <param name=loop value=true>
  <object data="nested.dat" type="application/octet-stream">
    <param name="bogus">
    fallback &amp text
  </object>
</object>
<map name="MAP1">
  <area shape="rect" coords="1,2,3" href="one">
  <area shape=poly coords="0,0,10,0,10,10,0" nohref>
  <area shape=circle coords="x,y,r">
</map>
<img src="picture" usemap="#MAP1" ismap border="none">
<hr noshade="noshade" size="not-a-number">
<blockquote cite=>
  <q cite="unterminated>
  quoted text
</blockquote>
</body>
</html>