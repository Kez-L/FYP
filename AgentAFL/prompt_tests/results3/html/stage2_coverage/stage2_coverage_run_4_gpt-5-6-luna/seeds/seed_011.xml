<!doctype html>
<html>
<head>
  <title>Foreign element confusion</title>
  <meta http-equiv="Content-Type" content="text/html; charset=windows-1252">
</head>
<body>
<section id="outer">
  <svg width="10" height="10" viewBox="0 0 10 10">
    <g transform="translate(1 1)"><path d="M0,0 L10,10 Z"></g>
    <foreignObject width="4" height="4"><div xmlns="http://www.w3.org/1999/xhtml">text</div></foreignObject>
  </svg>
  <math xmlns="http://www.w3.org/1998/Math/MathML">
    <mrow><mi>x</mi><mo>&InvisibleTimes;</mo><msup><mi>y</mi><mn>2</mn></msup></mrow>
  </math>
  <custom:widget xmlns:custom="urn:invalid"><custom:item data-x="&bad;">value</custom:item></custom:widget>
  <p><unknown a=1 b='2" c=`3`>unclosed custom content
</section>
</body>
</html>