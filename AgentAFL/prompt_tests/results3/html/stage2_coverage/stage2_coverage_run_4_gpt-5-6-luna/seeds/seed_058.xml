<!DOCTYPE html>
<html>
<head>
  <title>interactive elements</title>
  <template id="card"><article><h2>template title</h2><p>template body</p></article></template>
</head>
<body>
  <details open="false">
    <summary>Details <b>summary</details>
    <article><header>hidden header</header><p>content</article>
  <dialog open><p>dialogue <button autofocus type=button>OK</dialog>
  <menu type="toolbar">
    <li><button type=menuitem>One</button>
    <li><button disabled>Two</menu>
  <section>
    <header><h2>section heading</header>
    <main><p>main text</main>
    <aside>aside text</aside>
    <footer>foot</footer>
  </section>
  <template><p>unclosed template
  <p>outside template <slot name=x>slot fallback</slot>
  <iframe srcdoc="<p>embedded <b>markup</p>" sandbox=allow-scripts>
    frame fallback
  </iframe>
</body>
</html>