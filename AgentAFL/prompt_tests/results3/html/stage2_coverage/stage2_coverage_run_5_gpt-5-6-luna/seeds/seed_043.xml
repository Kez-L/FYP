<!DOCTYPE html>
<html>
<head><title>forms and controls</title></head>
<body>
<form method="get" action="/submit" enctype="multipart/form-data">
  <fieldset disabled="false">
    <legend>Options</legend>
    <label for=a>Name <input id="a" name="name" type="text" value="&quot; onfocus=alert(1)"></label>
    <label>Pick <select name=choice multiple size="not-number">
      <option value=1 selected>one
      <option value=2>two
      <optgroup label="group"><option>three</optgroup>
    </select></label>
    <textarea name=notes rows="-1" cols="x">text</textarea>
    <button type="bogus" formaction="/x">go</button>
    <input type=image src alt=submit>
    <input type=checkbox checked=maybe>
    <input type=radio name=r checked>
    <output for="a b">result</output>
  </fieldset>
</form>
<form><input name=x><form><input name=y></form></form>
<isindex prompt="Search:">
</body>
</html>