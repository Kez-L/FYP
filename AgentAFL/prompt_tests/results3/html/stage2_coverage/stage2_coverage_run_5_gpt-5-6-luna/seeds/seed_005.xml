<!DOCTYPE html>
<html>
<head>
  <title>Foreign Content Boundary</title>
  <meta charset="utf-8">
</head>
<body>
  <svg viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
    <title>vector title</title>
    <g transform="translate(5,5)">
      <rect x="0" y="0" width="40" height="20" fill="url(#paint)">
      <circle cx="20" cy="10" r="7" />
      <foreignObject x="1" y="1" width="30" height="15">
        <div xmlns="http://www.w3.org/1999/xhtml">
          <p>embedded <b>text</b>
        </div>
      </foreignObject>
    </g>
    <defs><linearGradient id="paint"><stop offset="0%"><stop offset="100%"></linearGradient></defs>
  </svg>
  <p>after svg</p>
  <math>
    <mrow><mi>x</mi><mo>&InvisibleTimes;</mo><msup><mi>y</mi><mn>2</mn></msup></mrow>
    <annotation-xml encoding="application/xhtml+xml"><div>math payload</div></annotation-xml>
  </math>
</body>
</html>