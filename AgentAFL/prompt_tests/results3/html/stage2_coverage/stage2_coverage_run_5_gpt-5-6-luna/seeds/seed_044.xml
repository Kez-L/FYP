<!DOCTYPE HTML PUBLIC "-//W3C//DTD HTML 4.01//EN">
<html>
<head><title>mixed legacy structures</title></head>
<body>
<center>
  <font face="Arial" size="+99" color="#gggggg">legacy
  <p align="justify">paragraph
  <dir compact><li>one<li>two</dir>
  <menu type="bar"><li>menu item</menu>
</center>
<dl compact>
<dt>Term 1
<dd>Definition 1
<dt><b>Term 2
<dd><table><tr><td>definition table</td></tr></table>
</dl>
<pre>
  pre text
  <b>bold inside pre</b>
  </pre>
<marquee behavior="sideways" direction="diagonal">moving</marquee>
<applet code="X.class" archive="a.jar,b.jar" width="0" height="-1">
  <param name=name value="x"><param value>
  fallback
</applet>
<object data="x" type="bad/type"><embed src=x></object>
<hr><hr><br><br>
</body>
</html>