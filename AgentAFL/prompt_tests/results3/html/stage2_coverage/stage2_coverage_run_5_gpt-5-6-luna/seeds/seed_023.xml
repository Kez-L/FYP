<!DOCTYPE html>
<html>
<head><title>Forms and controls</title></head>
<body>
<form method=sideways enctype="multipart/form-data" accept-charset="UTF-999" onsubmit="x<y">
<fieldset disabled="no">
<legend><label for=missing>Account &amp; details</legend>
<label>Name <input id=name type=text name=user maxlength=-7 size=abc></label>
<label>Secret <input type=password autocomplete=??? value="&quot;'></label>
<textarea name=notes wrap=spiral cols=NaN>one
two
</textarea>
<select name=choice multiple="false" size=zero>
<option selected=off value=>empty
<option value="1" label="A & B">One
<option>Two
<optgroup label=Group disabled=maybe>
<option value=3>Three
</optgroup>
</select>
<input type=checkbox name=c value=v checked=0>
<input type=radio name=c checked=checked>
<input type=file accept=image/*,application/x-unknown>
<button type=reset name=go value="x<y">Reset
<input type=image src=missing alt=alt border=bad>
</fieldset>
</form>
</body>
</html>