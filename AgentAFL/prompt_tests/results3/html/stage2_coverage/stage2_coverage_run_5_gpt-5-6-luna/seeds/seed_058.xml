<!DOCTYPE html>
<html>
<head><title>lists and phrasing boundaries</title></head>
<body>
  <menu>
    <li>one
    <li><a href="u"><span><em>two</li>
    <li><button><label>three<input name=x></button>
  </menu>
  <ol start="zero" reversed="perhaps" type="I">
    <li value="nan">alpha
    <li><details><summary>beta</summary><ol><li>inner</ol></details>
  </ol>
  <p>before <q cite="a">quote <cite>source</q> after
  <address><time datetime="2020-13-99">yesterday</address>
  <p><small><big><s><u><var>x</small></big></s></u></var>
  <pre> pre
    <code>code <kbd>key</pre></kbd>
  <blockquote cite="x"><p>block <hr><p>second
  <dl><dt>term<dd>definition<dt><dt>empty<dd>
  <div hidden="false"><p>hidden content</div>
</body>
</html>