<!DOCTYPE HTML PUBLIC "-//W3C//DTD HTML 3.2 Final//EN">
<HTML>
<HEAD>
<TITLE>Frames and obsolete containers</TITLE>
<BASE HREF="http://example.invalid/a/b/">
</HEAD>
<FRAMESET ROWS="25%,*" COLS="*,240" BORDER="bad">
  <FRAME NAME="top" SRC="one.html" SCROLLING="maybe" MARGINWIDTH="x">
  <FRAMESET COLS="50%,50%">
    <FRAME SRC="two.html">
    <NOFRAMES>
      <BODY BGCOLOR="#zzzzzz">
        <H1>Fallback</H1>
        <P><FONT SIZE="+99" COLOR="rgb(1,2,3)">text
        <HR NOSHADE="false" WIDTH="200%" ALIGN="side">
        <CENTER><IMG SRC="data:image/gif;base64,%%%%" ISMAP HEIGHT="-4"></CENTER>
      </BODY>
    </NOFRAMES>
  </FRAMESET>
</FRAMESET>
</HTML>