<!doctype HTML PUBLIC "-//W3C//DTD HTML 4.0 Transitional//EN" "http://example.invalid/loose.dtd">
<html>
<head><title>Object and map controls</title></head>
<body>
<object classid="clsid:bad" codebase="/x" width="0" height="-2" standby="wait">
  <param name="movie" value="&quot;broken">
  <param name="loop">
  <embed src="movie" type="application/x-test" hidden="no">
  <p>alternate content
</object>
<map name="hot">
  <area shape="rect" coords="0,0,10" href="#one">
  <area shape="poly" coords="a,b,c,d" nohref>
  <area shape="circle" coords="1,2,three,4">
</map>
<img src="x" usemap="#hot" ismap>
<dl compact>
  <dt id=one>Term <dd>definition
  <dt><i>another <dd><blockquote cite="x"><q>quote</blockquote>
</dl>
<center><marquee behavior=sideways direction=diagonal loop=NaN>scroll</marquee></center>
</body>
</html>