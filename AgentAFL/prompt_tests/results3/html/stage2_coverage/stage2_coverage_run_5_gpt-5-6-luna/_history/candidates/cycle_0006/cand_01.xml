<!doctype html>
<html>
<head><title>Frames and targets</title></head>
<frameset rows="20%,*,0" cols="*,*" frameborder="maybe">
  <frame src="left.html" name="left" scrolling="sometimes" noresize>
  <frameset cols="30%,70%">
    <frame src="right.html" name="right">
    <frame src="javascript:alert('x')" name="main">
  </frameset>
  <noframes>
    <body>
      <h1>Fallback</h1>
      <p><a target="missing" href="http://[bad">open</a>
      <form method="GET" enctype="x/y" accept-charset="bad bad">
        <input name=x value="a&amp;b" checked="false">
        <select name=pick multiple size="-1">
          <option selected>first
          <option value="2">second</option>
        </select>
        <textarea cols="NaN" rows=0>unfinished
      </form>
    </body>
  </noframes>
</frameset>