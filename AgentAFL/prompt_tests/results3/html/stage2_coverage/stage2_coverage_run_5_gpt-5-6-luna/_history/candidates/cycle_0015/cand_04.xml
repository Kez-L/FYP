<!DOCTYPE html>
<html>
<head><title>Mixed namespaces and malformed tokens</title></head>
<body>
<table>
<caption><b>caption</caption>
<colgroup><col span=abc><colgroup>
<tbody><tr><th>one<th><button>two</tr>
<tbody><tr><td><details open=maybe><summary>More</summary><p>detail</details></td>
<td><menu><li>alpha<li>beta</menu></td></tr>
</table>
<template id=t><div><p>template<p><slot name=x>fallback</slot></div></template>
<dialog open=true><form method=post><p>Dialog</dialog>
<ruby>漢<rt>kan<rp>(</rp></ruby>
<bdi dir=side>abc</bdi><bdo dir=rtl>xyz</bdo>
<time datetime="not-a-date">yesterday</time>
<data value=>label</data>
<figure><img src alt=missing><figcaption>caption</figure>
<video controls autoplay=maybe poster=><source src=x type=bad><track kind=bogus src=x defaulted></video>
<map name=m><area shape=poly coords="1,2,three" href=#></map>
<img usemap=#m ismap width=-2 height=bad>
</body>
</html>