<!doctype html>
<html>
<head>
  <title>foreign content boundaries</title>
</head>
<body>
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 10 10">
    <title>svg title</title>
    <foreignObject width="10" height="10">
      <div xmlns="http://www.w3.org/1999/xhtml"><p>html in svg
        <math><mi>x</mi><mfrac><mn>1</mn><mo>+</mo></mfrac>
          <annotation-xml encoding="application/xhtml+xml"><p>annotation</p>
        </math>
      </div>
    </foreignObject>
    <g><path d="M0 0 L 2 2" fill-rule="evenodd"><text x="1">label</text></g>
  </svg>
  <math display="block">
    <mrow><mi>a</mi><mo>&lt;</mo><mtext>text</mtext></mrow>
    <semantics><mfrac><mi>x</mi><mn>0</mn></mfrac>
      <annotation encoding="application/x-tex">x/0</annotation>
    </semantics>
  </math>
  <p>back in html</p>
</body>
</html>