<!doctype html>
<html>
<head><title>ruby and embedded languages</title></head>
<body>
  <p><ruby>漢<rb>字<rt>kan<rtc><b>ji</ruby>
  <p><bdi dir="auto">abc <bdo dir="sideways">xyz</bdi></bdo>
  <p><ins cite="x" datetime="not-a-date"><del><mark>marked</ins>deleted</del></mark>
  <map name="m"><area shape="poly" coords="1,2,3,4,5" href=#x><area></map>
  <object data="x" type="application/octet-stream">
    <param name=name value="v">
    <embed src=x width="NaN" height="-4">
    <p>fallback<object><p>nested fallback</p></object>
  </object>
  <audio controls autoplay="false"><source src=a type=audio/x><track kind=subtitles src=b>
    audio fallback
  </audio>
  <video poster="p"><source src=c><track default></video>
  <template shadowrootmode="open"><div>template <slot name=x></slot></div></template>
  <slot>outside</slot>
</body>
</html>