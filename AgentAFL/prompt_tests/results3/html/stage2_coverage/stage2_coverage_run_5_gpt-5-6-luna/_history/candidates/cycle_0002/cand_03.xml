<!doctype html>
<html>
<head><title>table mode transitions</title></head>
<body>
<table>
  text-before
  <caption><select><option>one<option selected>two</select></caption>
  <colgroup><col span=3><tbody>
  <tr><td>A<td>B
    <table><tr><th>nested</th></tr><tr><td>cell</table>
  <tr><td>
    <form><input type=hidden name=x><p>paragraph in cell
  </tbody>
  <tfoot><tr><td>footer</td></tr></tfoot>
</table>
<table><tr><td><div>second table</div></td></tr></table>
<p>tail<table><tr><td>orphan</p></td></tr></table>
</body>
</html>