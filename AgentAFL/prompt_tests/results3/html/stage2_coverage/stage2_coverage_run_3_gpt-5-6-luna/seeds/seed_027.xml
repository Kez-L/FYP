<!DOCTYPE html>
<html>
<head>
  <title>Interactive controls</title>
</head>
<body>
  <details open="false">
    <summary>Options <span>inside summary</details>
    <dialog open>
      <form method="dialog">
        <button type=submit autofocus>Accept</button>
        <button type=reset formaction="/reset">Reset</button>
      </form>
    </dialog>
  </details>
  <menu type=context id=main-menu>
    <menuitem label="One" command="--one">
    <li>Fallback item
  </menu>
  <select name=color multiple size="not-a-number">
    <optgroup label=Warm disabled>
      <option value=red selected>Red
      <option value=orange>Orange</optgroup>
    <option>Unclosed option
  </select>
  <textarea cols=abc rows=-1>literal <b> markup &amp;
  <output for="x y">result</output>
</body>
</html>