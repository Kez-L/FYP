<!DOCTYPE HTML>
<html>
<head><title>forms and frames</title></head>
<body>
<form method=POST action="/submit" enctype="multipart/form-data">
<fieldset disabled>
<legend>Registration
<label for=user>User</label><input id=user name=user required>
<label>Password<input type=password name=pass maxlength=abc></label>
<textarea name=notes rows=2 cols=3>one
two</textarea>
<button type=submit formaction="/other">Send</button>
</fieldset>
<input type=radio name=x checked="no"><input type=checkbox name=y>
</form>
<frameset rows="20%,*,bad">
<frame src="left.html" name=left>
<frame src="right.html" noresize scrolling=maybe>
<noframes><body><p>Frames unavailable</p></body></noframes>
</frameset>
<map name=map1><area shape=rect coords="0,0,10" href=#x><area href></map>
</body>
</html>