<!doctype html>
<html>
<head><title>frames and obsolete containers</title></head>
<frameset rows="*,0,garbage" cols="25%,*,">
  <frame name="left" src="a.html" scrolling="maybe" frameborder="no" marginwidth="999999">
  <frameset cols="50%,50%">
    <frame src="" noresize="false">
    <frame src="javascript:alert(1)" name="a" name="b">
  </frameset>
  <noframes>
    <body>
      <h1>Fallback</h2>
      <p>frame fallback <a href="x">link
      <form method="UNKNOWN" enctype="bad/type" action>
        <input name="x" value="one" value="two">
        <select name="s" multiple size="-3">
          <option selected>one
          <option value=two>two</option
          <optgroup label="group"><option>three</optgroup>
        </select>
        <textarea rows="notnum" cols=999 wrap=banana>value
      </form>
    </body>
  </noframes>
</frameset>
<base target="_blank">
</html>