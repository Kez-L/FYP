<html xmlns="http://www.w3.org/1999/xhtml">
<head>
<title>Nested table recovery</title>
</head>
<body>
<table border="1" cellpadding="2">
<caption align=bottom>Inventory</caption>
<colgroup span=2><col width="40%"><col></colgroup>
<thead><tr><th rowspan=2>Code<th colspan=2>Value</tr></thead>
<tbody>
<tr><td>A-1<td><table><tr><td>inner</tr></table><td>open
<tr><td colspan=3><form><select multiple name=pick>
<option selected>red<option value=green>green<option>blue
</select><textarea name=note rows=2 cols=8>unfinished
</tbody>
<tfoot><tr><td>Total<td><strong>?</strong></tfoot>
</table>
</body>
</html>