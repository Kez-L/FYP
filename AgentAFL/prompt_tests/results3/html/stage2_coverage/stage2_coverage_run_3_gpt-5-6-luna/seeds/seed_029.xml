<!DOCTYPE html>
<html>
<head>
  <title>Sections and malformed metadata</title>
  <meta charset="utf-16" content="text/html; charset=latin1">
  <link rel=stylesheet alternate href=style.css media="screen and (x)">
</head>
<body>
  <header>
    <hgroup><h1>One<h2>Two<h6>Six</hgroup>
    <nav><a href=a><span>first</a><a href=b>second</span></nav>
  </header>
  <main>
    <section>
      <article>
        <figure>
          <img srcset="a 1x, b 2x, c" sizes="(max-width: 1px)" alt=>
          <figcaption>caption</figure>
        </figcaption>
        <address>name<br>street
      </article>
      <aside><mark>aside</mark><time datetime="2024-13-99">tomorrow</time></aside>
    </section>
    <dl compact><dt>Term<dd>Definition<dt>Next
    <p><bdi dir=invalid>direction <bdo dir=rtl>mixed</bdi></bdo>
  </main>
  <footer><small>footer</small></footer>
</body>
</html>