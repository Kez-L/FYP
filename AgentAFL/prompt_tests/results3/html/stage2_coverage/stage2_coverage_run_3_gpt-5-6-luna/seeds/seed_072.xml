<!DOCTYPE html>
<html>
<head>
<title>lists and definitions</title>
</head>
<body>
<ol start="zero" reversed="false" type="Z">
<li value="abc">alpha
<ol><li>nested one<li>nested two
</ol>
<li>beta
</ol>
<ul compact="no" type="square">
<li>first
<menu>
<li>menu item
<dir><li>directory item</dir>
</menu>
</ul>
<dl compact>
<dt><b>Term one
<dd>Definition without closure
<dt>Term two</dt>
<dd><p>Paragraph in definition
<dt><dt>Repeated term
<dd><dd>Repeated definition
</dl>
<figure>
<figcaption>caption before image</figcaption>
<img srcset="a 1x, b 2x, c" sizes="(bad)" alt>
<pre><code>&lt;raw&gt;
&amp;broken
</code></pre>
</figure>
<center><marquee direction=sideways behavior=explode loop=-1>moving</marquee></center>
</body>
</html>