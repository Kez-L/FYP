<!DOCTYPE HTML PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN">
<html xmlns="http://www.w3.org/1999/xhtml">
<head><title>mixed namespaces</title></head>
<body>
<div xmlns:x="urn:custom">
<x:panel enabled>
<x:item><![CDATA[raw <b> text & stuff]]></x:item>
</x:panel>
</div>
<table>
<tbody>
<tr><td>one</tbody>
<caption>late caption</caption>
<thead><tr><th>header</tr></thead>
<tr><td colspan="not-a-number" rowspan="-7">two
</table>
<dl compact="compact">
<dt>term 1
<dd>definition 1
<dt><b>term 2</dt>
<dd><ul><li>nested<li>still nested</dl>
<form method="post" enctype=application/x-www-form-urlencoded>
<label for=x>Name</label>
<input id=x type=text disabled=maybe>
<button type=submit><img src=x></button>
</form>
</body>
</html>