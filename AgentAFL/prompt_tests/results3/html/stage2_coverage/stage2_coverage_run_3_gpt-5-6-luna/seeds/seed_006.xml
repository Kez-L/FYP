<!doctype html>
<html>
<head><title>frames and declarations</title></head>
<frameset rows="*,*,0" cols="50%,50%">
<frame name=left src="left.html" scrolling=maybe noresize>
<frame name=right src="right.html" frameborder=-1>
<noframes>
<body>
<h1>fallback</h1>
<form method=get enctype="multipart/form-data" action="/submit?x=1&y=2">
<label for=q>Query</label>
<input id=q name=q value="a&amp;b&quot;c" maxlength="-1" size=999999999>
<select name=pick multiple size=-7>
<option selected disabled value=>one
<option value=two>two
<optgroup label="group"><option>three</optgroup>
</select>
<textarea name=notes rows=0 cols=-4 wrap=sideways>raw & text <tag> </textarea>
<button type=submit formaction="javascript:void(0)">Go</button>
</form>
</body>
</noframes>
</frameset>
</html>