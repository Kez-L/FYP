<!doctype html>
<html>
<head><title>forms, controls, and comments</title></head>
<body>
<form id="f" action="/submit?x=1&y=2" method="post" accept-charset="UTF-8,">
<fieldset disabled="no"><legend>Choose <label for=x>one</legend>
<label><input type="radio" name="r" checked="false" value="1">First
<label for="x">Second</label><input id="x" type="radio" name="r" value="2">
<input type="text" required="0" maxlength="-7" minlength="999999999" pattern="[">
<input type="file" accept="image/*," multiple="maybe">
<button type="unknown" formaction="x" formmethod="get">send</button>
</fieldset>
<output name="o" for="x y">result</output>
<progress value="NaN" max="-1">progress</progress>
<meter min="10" max="2" low="99" high="-4" optimum="x" value="50">meter</meter>
</form>
<form><input name=a><input name=b></form>
<ol start="not-a-number" reversed="false" type="Z">
<li value="-999999999999999999999999">x
<li>y
</ol>
<ul><li><p>paragraph<li>next<p>another</ul>
</body>
</html>