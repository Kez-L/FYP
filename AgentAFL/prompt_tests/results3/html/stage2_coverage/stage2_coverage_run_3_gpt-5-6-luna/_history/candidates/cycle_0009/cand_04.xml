<html xmlns="http://www.w3.org/1999/xhtml" xmlns:x="urn:test">
<head><title>mixed namespaces</title></head>
<body>
  <x:widget x:flag="yes"><x:item>custom</x:item></x:widget>
  <svg width="10" height="10"><circle cx="5" cy="5" r="4"/></svg>
  <math><mrow><mi>x</mi><mo>&lt;</mo><mn>3</mn></mrow></math>
  <p><b><i><u><em><strong>deep</b> unwind</i></u></em></strong>
  <object data="movie" type="x/y" width="1" height="1">
    <param name=name value="a&b">
    <embed src="plugin" hidden=maybe>
    fallback text
  </object>
  <map name=map><area shape=poly coords="1,2,3" href=#x><area></map>
  <img src="x" usemap="#map" ismap="" border=none>
</body>
</html>