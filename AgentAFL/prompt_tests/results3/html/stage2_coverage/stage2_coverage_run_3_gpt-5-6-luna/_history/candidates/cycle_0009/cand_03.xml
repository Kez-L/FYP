<!DOCTYPE html>
<html>
<head>
  <title>lists and definitions</title>
</head>
<body>
<menu compact>
  <li value=0>zero
  <li value="-3"><a href="x" title="a<b>c">negative
  <li>third
</menu>
<ol start="not-a-number" reversed type=I>
  <li>first
  <li><ol type=z><li>nested one<li>nested two</ol>
  <li>last
</ol>
<dl>
  <dt><b>term without closure
  <dd>description
  <dt><img src="term.png">
  <dd><p>paragraph description</p><dd>second description
</dl>
<dir>
  <li>directory item
  <li><p>paragraph inside list
</dir>
</body>
</html>