<!doctype html>
<html>
<head>
<title>forms and controls</title>
</head>
<body>
<form method=get action="/submit?x=1&y=2" enctype="multipart/form-data">
<fieldset disabled>
<legend><label for=a>Profile</legend>
<label>Name <input id=a name=name value="&quot; onfocus=&quot;alert(1)" maxlength="-1"></label>
<label><textarea name=note rows=999 cols=0 wrap=sideways>first
second
</textarea></label>
<select name=choice multiple size=-4>
<option selected selected value=one>One
<option disabled value=two>Two
<optgroup label="Group"><option value=three>Three</optgroup>
</select>
<button type=unknown name=b value="x>y">Push</button>
<input type=image src="x" alt="a&b" border=none>
<input type=file name=f accept="image/*,.bad," size=NaN>
</fieldset>
</form>
<form>
<input type=radio name=r checked=maybe>
<input type=checkbox name=c checked="">
<input type=hidden name=h>
<keygen name=k challenge="&amp;">
</form>
</body>
</html>