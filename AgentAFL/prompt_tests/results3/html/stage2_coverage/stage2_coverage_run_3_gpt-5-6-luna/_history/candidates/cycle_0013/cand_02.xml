<html>
<head><title>forms and controls</title></head>
<body>
<form id=f method=POST enctype="multipart/form-data" action="/submit?x=1&y=2">
<fieldset disabled><legend>Credentials</legend>
<label>User <input type=text name=user required maxlength="-1"></label>
<label>Password <input type=password name=pass autocomplete=off></label>
</fieldset>
<select name=choice multiple size=bogus>
<option selected value=1>One
<optgroup label="Group"><option value=2 disabled>Two<option>Three</optgroup>
</select>
<select><option>unterminated
<textarea name=notes rows=-2 cols=abc wrap=weird>text </textarea><textarea>second
<input type=checkbox checked=maybe><input type=radio name=r checked>
<input type=file accept="image/*,.x" multiple>
<input type=number min=abc max=1 step=0 value=nan>
<input type=date value="2024-99-99">
<output for="a b">result</output>
<progress value="infinity" max="0">loading</progress>
<meter min=10 low=2 optimum=3 high=1 max=0 value=-7>meter</meter>
<button formaction="/x" formmethod=wat autofocus>submit
</form>
<form><input name="unclosed" value="x><div>form-associated?</form></body>