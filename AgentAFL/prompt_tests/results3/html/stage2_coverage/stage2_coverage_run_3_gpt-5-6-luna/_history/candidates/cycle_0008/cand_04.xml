<!DOCTYPE html>
<html>
<head><title>lists and definitions</title></head>
<body>
<ol start="zero" type="i">
<li value=3>first
<li>second
<ul><li>nested A<li>nested B</ol>
<menu compact><li>menu item 1<li>menu item 2
</menu>
<dl>
<dt>alpha<dd><p>definition <b>bold
<dt>beta
<dd>definition without closure
</dl>
<center>
<table><tr><td>centered cell</td></tr></table>
</center>
<dir><li>directory one<li>directory two</dir>
<p><big>large <small>small <strike>strike <tt>mono</big> end
<ins cite="x" datetime="not-a-date">inserted</ins>
<del datetime=2020-99-99>deleted</del>
</body>
</html>