<!doctype HTML PUBLIC "-//W3C//DTD HTML 4.01 Frameset//EN" "http://example.invalid/frameset.dtd">
<html>
<head>
  <!--[if IE 5]><meta http-equiv="X-UA-Compatible" content="IE=5"><![endif]-->
  <?xml-stylesheet type="text/css" href="odd.css"?>
  <title>Frames and fallback</title>
</head>
<frameset rows="0,*,0" cols="*" border="999999">
  <frame src="javascript:alert(1)" name="top" scrolling="maybe" frameborder="-1">
  <frameset cols="25%,75%">
    <frame src="" noresize>
    <noframes>
      <body bgcolor="#xyz">
        <h1>Fallback <blink>content</blink>
        <p><a href="relative path?q=1&amp;x=2">broken link
        <iframe srcdoc="<p>nested &amp; unclosed" sandbox="allow-scripts"></iframe>
      </body>
    </noframes>
  </frameset>
</frameset>
</html>