<!doctype html>
<html>
<head><title>Implicit containers</title></head>
<body>
  <h1><em>heading <strong>with <small>mixed</h1>
  <p>first paragraph
  <p>second <a href="javascript:alert(1)">link
  <ul compact="compact"><li>one<li><ol reversed start="0"><li>nested<li>again</ol><li>three</ul>
  <dl compact><dt>term one<dd>definition <dt>term two<dd><p>paragraph <q>quote</dl>
  <menu><li>menu item<div>block in item</div><li>last</menu>
  <blockquote cite="&quot;broken"><address><i>name<br>street</blockquote>
  <center><big><font size="999" color="#ggg">legacy</font></big></center>
  <hr noshade="false"><br/><br>
</body>
</html>