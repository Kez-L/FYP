<!doctype html>
<html>
<head><title>Lists and definition structures</title></head>
<body>
  <nav aria-label="crumbs">
    <ol start="0" reversed>
      <li value="3">One
      <li>Two
        <ul>
          <li>child A
          <li>child B
            <ol type="i"><li>deep</li></ol>
        </ul>
      <li><a href="javascript:alert(1)">Three</a>
    </ol>
  </nav>
  <dl>
    <dt>Term one
    <dd>Definition one
    <dd><p>Second definition <q cite="a&b">quoted</q>
    <dt><ins>Term two</ins><dt>
    <dd>Orphaned definition
  </dl>
  <menu>
    <li><button accesskey="&">Action</button>
    <li><details open><summary>Summary</summary><p>Details</details>
  </menu>
  <p><del datetime="not-a-date">deleted <mark>marked</del> remainder</mark></p>
</body>
</html>