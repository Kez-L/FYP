<!DOCTYPE html>
<html>
<head>
<title>Frames and obsolete elements</title>
<base target="_blank">
</head>
<frameset rows="*,0,NaN" cols="1*,2*,-3*">
<frame src="about:blank" name="left" scrolling="maybe" frameborder="-1">
<frame src="missing.html" name="right" noresize>
<noframes>
<body>
<center><font face="sans-serif" size="+999" color="#GGGGGG">
<marquee behavior="warp" direction="sideways" loop="-1" scrollamount="0">
  <blink>legacy <strike>content</strike>
</marquee>
</font></center>
<pre><listing>preformatted
  <code>code <var>variable <samp>sample</pre>
<hr width="999999999999999999999" size="-1" noshade="false">
<isindex prompt="Search &copy; <input type=text>">
</body>
</noframes>
</frameset>
<iframe srcdoc="<p>quoted <b>fragment</iframe>" sandbox="allow-scripts allow-scripts" loading="unknown"></iframe>
</html>