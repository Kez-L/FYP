<!DOCTYPE html>
<html>
<head>
  <title>Forms with unusual controls</title>
</head>
<body>
  <form id="outer" action="" enctype="multipart/form-data">
    <fieldset disabled>
      <legend>Profile <strong>information</legend>
      <label for="user">User
      <input id="user" name="user" type="text" required autofocus>
      </label>
      <label>Choice
        <select name="choice" multiple size="0">
          <optgroup label="Group &amp; One">
            <option value="a" selected>A</option>
            <option value="b" disabled>B
          </optgroup>
          <option>C</option>
        </select>
      </label>
    </fieldset>
    <input type="image" src="" alt="go" formaction="/image">
    <input type="file" accept="image/*,.x" multiple>
    <input type="number" min="10" max="2" step="0" value="NaN">
    <input type="date" value="2024-99-99">
    <input type="checkbox" checked="false">
    <textarea name="notes" wrap="hard" maxlength="-1">line one
line two</textarea>
    <button type="button" form="missing" name="b" value="&lt;">Push</button>
    <output for="user choice">result</output>
  </form>
  <form action="/second"><input name="x"><button>second</button></form>
</body>
</html>