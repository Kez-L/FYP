<!DOCTYPE html>
<html>
<head><title>Images and metadata</title></head>
<body>
  <picture>
    <source media="(min-width: 0px)" srcset="a 1x, b 2x, c 0w">
    <source type="image/avif" srcset="">
    <img srcset="one.png 400w, two.png 50%, three.png" sizes="(bad) 10vw, 100vw"
         src="data:image/svg+xml,%3Csvg%3E" width="not-a-number" height="-10"
         alt="&lt;broken">
  </picture>
  <map name="M">
    <area shape="rect" coords="0,0,10" href="#a">
    <area shape="poly" coords="0,0,1,1,2" nohref>
  </map>
  <object data="missing.bin" type="application/octet-stream">
    <param name="movie" value="x">
    <embed src="plugin://" width="0" height="NaN">
    <p>fallback <button disabled="">click</button></p>
  </object>
  <audio controls autoplay loop src="not-audio">
    <track kind="captions" src="captions.vtt" srclang="xx" default>
    audio fallback
  </audio>
  <video poster="" preload="invalid"><source src="x" type=""><track></video>
</body>
</html>