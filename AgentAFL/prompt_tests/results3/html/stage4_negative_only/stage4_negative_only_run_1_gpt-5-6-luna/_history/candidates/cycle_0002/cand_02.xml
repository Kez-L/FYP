<!doctype html>
<html>
<head>
  <title>Interactive and metadata mix</title>
  <meta charset="x-user-defined">
</head>
<body id="root" contenteditable="maybe">
  <header>
    <hgroup><h1>Heading <small>small</h1><h2>orphan</h2></hgroup>
    <nav aria-label="crumbs">
      <ol reversed start="0"><li value="-2">one<li>two<li>three</ol>
    </nav>
  </header>
  <main>
    <details open="false">
      <summary>Summary <span>text</summary>
      <dialog open="0"><p>Dialog body</dialog>
      <menu type="toolbar">
        <li><button disabled="no" autofocus="false">A</button>
        <li><button type="menu">B</button>
      </menu>
    </details>
    <dl compact="compact"><dt>term<dd>definition<dt>next<dd><del>removed<ins>inserted</dl>
    <progress max="-1" value="NaN">fallback</progress>
    <meter min="10" max="2" low="x" high="y" optimum="z" value="999">meter</meter>
  </main>
  <footer><address><a href="mailto:%ZZ">contact</a></address></footer>
</body>