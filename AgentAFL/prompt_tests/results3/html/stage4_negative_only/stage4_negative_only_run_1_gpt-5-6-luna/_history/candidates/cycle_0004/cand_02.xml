<!DOCTYPE html>
<html>
<head>
  <title>Interactive controls</title>
</head>
<body>
  <form method="post" enctype="multipart/form-data" accept-charset="x-invalid">
    <fieldset disabled>
      <legend><label for="missing">Choose &copy; <input></label></legend>
      <label>Text <input type=text name=a value="one" disabled></label>
      <input type="file" name="upload" multiple accept=",,">
      <button type="submit"><span>Submit</button>
    </fieldset>
    <select name="items">
      <optgroup label="Group">
        <option value="1" selected>One
        <option value="2" label="Two">Ignored text
      </optgroup>
      <option>Unclosed
    </select>
    <textarea rows="0" cols="-2">text &lt;tag&gt;
      </textarea>
    <output for="a b">result</output>
    <progress value="2" max="1">fallback</progress>
  </form>
  <details open="maybe"><summary>More</summary><p>hidden-ish</p></details>
</body>
</html>