<html>
<head>
  <title>Names and attributes</title>
  <meta name="viewport" content="width=device-width">
</head>
<body>
  <div ID=one id=two class=a class='b c' data-x data-x="&amp;broken;" =novalue
       style="color: rgb(1,2,3); background:url('unterminated)"
       onclick="if (a < b) alert(&quot;x&quot;)" >
    <custom-element foo:bar="x" XMLNS="urn:bogus">
      <unknown/><unknown>text
    </custom-element>
  </div>
  <p accesskey="😀" tabindex="999999999999999999999999999">
    <a href="#&#0;" target="_blank" rel="noopener noreferrer">link
  <img srcset="a 1w, b 0w, c -2x, , d" sizes="calc(100% - )" alt="&notanentity">
  <label for="x">Label <input id=x type="unknown" checked="false" readonly="no"></label>
  <details open="closed"><summary>Summary</summary><div>Details</div>
  <meter min="ten" max="0" low="Infinity" high="-Infinity" value="NaN">meter</meter>
  <progress max="-1" value="999">progress
  <time datetime="2024-99-99T25:99:99Z">time</time>
  <data value=>data</data>
</body>