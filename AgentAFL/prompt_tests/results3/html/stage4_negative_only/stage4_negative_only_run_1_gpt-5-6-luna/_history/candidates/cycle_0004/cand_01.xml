<!doctype html>
<html>
<head><title>Ruby and inline phrasing</title></head>
<body>
<p>
  <ruby>漢<rb>字<rt>かん<rp>(</rp><rt>じ<rp>)</rp></ruby>
  <b><i><u><s>nested</b> crossing</i> text</u>
  <a href="http://[broken" title="unterminated>link
  <abbr title="full">abbr</abbr>
  <bdi dir="rtl">שלום</bdi><bdo dir="ltr">abc</bdo>
</p>
<dl compact>
  <dt>first<dd>definition one
  <dt><span>second</span>
  <dd><blockquote cite="x"><q cite="y">quoted &notanentity; &amp incomplete</q></blockquote>
</dl>
<address><a href="mailto:test@example.invalid">contact</a><br>line</address>
</body>
</html>