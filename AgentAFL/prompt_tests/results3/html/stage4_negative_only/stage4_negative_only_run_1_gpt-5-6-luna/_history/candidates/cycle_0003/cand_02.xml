<!DOCTYPE html>
<html>
<head><title>Foreign content crossings</title></head>
<body>
<svg width="100%" viewBox="0 0 10 10">
  <title>svg title</title>
  <g transform="translate(1 2) rotate(90)">
    <foreignObject width="10" height="10">
      <div xmlns="http://www.w3.org/1999/xhtml">HTML in foreign content <b>bold</b></div>
    </foreignObject>
    <path d="M0,0 L10,10 Z" fill="url(#missing)"/>
  </g>
  <text><tspan>text</tspan><circle cx="NaN" cy="Infinity" r="-1"></circle>
</svg>
<math display="block">
  <mrow><mi>x</mi><mo>&InvisibleTimes;</mo><msup><mi>y</mi><mn>2</mn></msup></mrow>
  <annotation-xml encoding="application/xhtml+xml"><p>embedded</p></annotation-xml>
</math>
<p>back in HTML</p>
</body>
</html>