<html>
<head>
  <title>Raw text and character references</title>
  <script type="application/javascript">
    if (a < b && c > d) {
      document.write("<div data-x='&amp;'>&lt;raw&gt;</div>");
    }
    // </script> is text in this string: "</scr" + "ipt>"
  </script>
  <script type="text/plain"><!--
    <not-an-element>&copy; &#x41;
  --></script>
  <style>
    @media screen and (min-width: 0px) {
      body::before { content: "</style><p>escaped"; }
    }
  </style>
</head>
<body>
  <noscript><div class="fallback">JavaScript is off</div></noscript>
  <textarea rows="2" cols="20">&lt;b&gt;typed&lt;/b&gt;
second line &amp; &#65;</textarea>
  <input value="&quot;quoted&quot;" title="a > b & c">
  <p><![CDATA[not really CDATA in HTML]]></p>
  <x-custom data-json='{"a": [1, true, null]}'></x-custom>
</body>
</html>