<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>Nested Forms and Tables</title>
  <style>
    .notice { color: #164; }
  </style>
</head>
<body>
  <main>
    <form id="outer" action="/submit" method="post">
      <fieldset disabled>
        <legend>Account details</legend>
        <label>User <input name="user" value="guest"></label>
        <form id="inner">
          <input type="email" name="email">
          <button type="submit">Continue</button>
        </form>
      </fieldset>
      <table border="1">
        <caption>History</caption>
        <thead><tr><th>Year<th>Result</tr></thead>
        <tbody>
          <tr><td rowspan="2">2023<td>Pending
          <tr><td><strong>Complete</strong>
        </tbody>
        <tfoot><tr><td colspan="2">End</tfoot>
      </table>
    </form>
    <p class="notice">The document intentionally mixes form and table scopes.</p>
  </main>
</body>
</html>