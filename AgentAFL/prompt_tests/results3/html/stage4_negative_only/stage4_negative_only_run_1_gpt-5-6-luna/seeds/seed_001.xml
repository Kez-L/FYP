<!DOCTYPE html>
<html>
<head>
  <title>Foreign Content</title>
  <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
</head>
<body>
  <svg viewBox="0 0 120 80" width="120" height="80">
    <title>Badge</title>
    <g transform="translate(4 5)">
      <rect x="0" y="0" width="100" height="60" rx="8"></rect>
      <text x="8" y="35">SVG <tspan>label</tspan></text>
      <foreignObject x="10" y="40" width="80" height="25">
        <div xmlns="http://www.w3.org/1999/xhtml">
          <p><em>embedded HTML</em></p>
        </div>
      </foreignObject>
    </g>
  </svg>
  <math display="block">
    <mrow>
      <mi>x</mi><mo>=</mo><msup><mi>y</mi><mn>2</mn></msup>
      <annotation encoding="application/xml"><b>note</b></annotation>
    </mrow>
  </math>
  <p>After foreign content</p>
</body>
</html>