<!doctype html>
<html>
<head>
  <title>Template and Metadata</title>
  <base href="https://example.invalid/root/">
  <link rel="alternate" type="application/json" href="data:application/json,%7B%7D">
  <style>
    @media screen and (max-width: 4px) { body { margin: 0 } }
  </style>
</head>
<body>
  <template id="card">
    <article itemscope itemtype="https://schema.org/Article">
      <h2 itemprop="headline">Template title</h2>
      <time itemprop="datePublished" datetime="2026-01-01">New year</time>
      <slot name="summary">Fallback <mark>text</mark></slot>
    </article>
  </template>
  <script type="application/ld+json">
    {"@context":"https://schema.org","@type":"Thing","name":"sample"}
  </script>
  <noscript>
    <section>
      <h1>Fallback heading</h1>
      <p>Content visible when scripts are unavailable.
    </section>
  </noscript>
  <div id="mount"></div>
</body>
</html>