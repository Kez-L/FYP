<!doctype html>
<html>
<head><title>Interactive nesting</title></head>
<body>
<main>
<details><summary>One</summary>
  <details><summary>Two</summary>
    <p>Deep <time datetime="2024-02-30">date</time>
    <meter min=0 max=1 value=2>bad meter</meter>
    <progress value="not-a-number" max="0">loading</progress>
  </details>
  <summary>Late summary</summary>
</details>
<menu type=context>
  <menuitem label="Cut" onclick="return false">
  <menuitem label="Copy" checked>
</menu>
<map name=m><area shape=poly coords="0,0,10,0,10,10" href=#x><area nohref></map>
<img usemap="#m" srcset="a 1w, b 2x" sizes="(min-width: 1px) 50vw, 100vw">
<video controls poster=p.jpg><source src=a.mp4 type=video/mp4><track kind=subtitles default></video>
<audio autoplay loop><source src=a.ogg><track></audio>
</main>
</body>
</html>