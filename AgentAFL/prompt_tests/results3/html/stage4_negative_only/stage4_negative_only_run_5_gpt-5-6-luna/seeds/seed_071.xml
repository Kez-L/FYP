<!doctype html>
<html>
<head><title>List and ruby repair</title></head>
<body>
  <ol start="not-a-number" reversed>
    <li value="3">one
      <ul type="square">
        <li>nested <strong>bold
        <li><ol><li>a<li>b</ol>
      </ul>
    <li>two
  </ol>
  <menu>
    <li><input type="checkbox" checked=checked> choice
    <li><button type=submit disabled>send
  </menu>
  <dl>
    <dt><ruby>base<rt>annotation<rp>)</ruby>
    <dd><mark>definition
    <dt>second <dd><small>text
  </dl>
  <p><b>one <i>two <u>three <s>four</b> five</i> six</u>
  <blockquote cite="a"><p>quoted <cite>source</blockquote>
  <figure>
    <figcaption>caption <span>not closed
    <img src=picture alt="x" width="auto" height=-4>
  </figure>
  <details open="false"><summary>summary</summary>
    <p>details <time datetime="2024-99-99">when
  </details>
</body>
</html>