<!DOCTYPE HTML PUBLIC "-//W3C//DTD HTML 4.0 Transitional//EN">
<html>
<head><title>Nested formatting</title></head>
<body>
  <p><b><i><u><s><big><small>deep <font color=red size=+7 face="x y">format</font></small></big></s></u></i></b>
  <p><a href="one"><a href="two">double anchor <span><span>nested</span></span></a></a>
  <div align=center><center><center>centers</center></center>
    <blockquote cite="a" style="color: red"><q>quote <cite>cite</cite></q>
      <address>mail<br>line<hr></address>
    </blockquote>
  </div>
  <dl><dt>term<dd>definition<dt>second<dd><ol start="x" reversed><li value="0">zero<li>one<ul type="square"><li>nested</ul></ol></dl>
  <pre><code>  &lt;tag&gt;
	&amp; entity
</code></pre>
  <br/><br />text
</body>
</html>