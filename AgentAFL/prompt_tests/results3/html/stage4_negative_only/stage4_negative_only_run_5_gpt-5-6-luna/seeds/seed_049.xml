<!doctype html>
<html>
<head><title>Odd controls and tokens</title></head>
<body>
<header><nav><a href=#a>A<a href=#b>B<a href=#c>C</nav></header>
<main>
  <form><input type=text name=a required required=maybe readonly=false>
    <input type=checkbox checked="false" checked>
    <button name=x disabled="0"><span>click</button>
    <output for=a>b</output>
  </form>
  <details open="no"><summary>Summary <small>small</details><p>after
  <dialog open>dialog <table><tr><td>cell</dialog>
  <progress value="1" max="0">bad</progress>
  <meter min=10 max=2 low=3 high=4 optimum=5 value=999>meter
  <canvas width=0 height=-1>fallback <b>bold</b></canvas>
</main>
<aside><figure><img src alt><figcaption>caption</figure></aside>
</html>