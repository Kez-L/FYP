      <tr><td><input type="checkbox" checked=checked disabled></td><td><select multiple size="0"><option selected>one<option>two</select></td><td><textarea rows="-1" cols="NaN">x</textarea></td></tr>
      <tr><td colspan="9"><details open><summary>sum</summary><dialog open>dialog text</dialog></details></td></tr>
    </tbody>
    <tfoot><tr><td>tail</td></tr></tfoot>
  </table>
  <form action="?" method="PoSt" enctype="application/x-www-form-urlencoded">
    <fieldset disabled><legend>Legend</legend><label for=q>Q</label><input id=q name=q value='"&<>></fieldset>
    <button type=submit formnovalidate>submit</button>
  </form>
