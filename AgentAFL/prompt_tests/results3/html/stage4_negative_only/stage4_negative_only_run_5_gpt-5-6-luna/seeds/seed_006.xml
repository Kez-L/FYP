<!doctype HTML PUBLIC "-//W3C//DTD HTML 4.01//EN" "http://www.w3.org/TR/html4/strict.dtd">
<html>
<head><title>Frameset document</title></head>
<frameset rows="20%,*,20%" cols="50%,50%">
  <frame src="top.html" name="top" scrolling="no">
  <frameset cols="30%,70%">
    <frame src="left.html">
    <frame src="right.html">
  </frameset>
  <noframes>
    <body>
      <p>This fallback contains <a href="x">a link
      <img src="missing.gif" alt="fallback">
      <map name="m"><area shape="rect" coords="0,0,10,10" href="a"><area href="b"></map>
    </body>
  </noframes>
</frameset>
</html>