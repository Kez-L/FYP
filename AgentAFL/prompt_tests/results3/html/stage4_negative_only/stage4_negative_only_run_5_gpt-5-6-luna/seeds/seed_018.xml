<!doctype html>
<html>
<head><title>forms and controls</title></head>
<body>
<form action="/submit" method="WHAT" enctype="multipart/form-data" accept-charset="x,y" target="_blank">
  <fieldset disabled="0">
    <legend><label for="q">Search</label></legend>
    <input id="q" name="q" type="search" value="a&b" required="maybe" maxlength="-4" size="NaN">
    <input type="image" src="" alt="go" width="-1" height="1e9">
    <button type="bogus" formaction="/alt" formmethod="TRACE"><span>send</span>
  </fieldset>
  <select name="v" multiple="false" size="-7">
    <optgroup label="A" disabled>
      <option value="1" selected="selected">one
      <option value=2>two</optgroup>
    <option>three
  </select>
  <label><input type="radio" name="x" checked="no"> first</label>
  <label><input type="radio" name="x" checked> second</label>
  <output for="q missing">result</output>
  <progress value="2" max="1">loading</progress>
  <meter min="10" low="x" optimum="-2" high="0" max="5" value="999">meter</meter>
  <input type="submit" formaction>
</form>
</body>
</html>