<!doctype html>
<html>
<head>
  <base href="https://example.invalid/a/">
  <title>Foreign Content</title>
  <style>
    .box { color: red; }
  </style>
</head>
<body>
  <svg viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
    <title>Vector title</title>
    <foreignObject x="0" y="0" width="20" height="20">
      <div xmlns="http://www.w3.org/1999/xhtml" class="box">
        <p>HTML inside SVG</p>
      </div>
    </foreignObject>
    <path d="M0 0 L20 20" stroke="black"/>
  </svg>
  <math xmlns="http://www.w3.org/1998/Math/MathML">
    <mrow><mi>x</mi><mo>=</mo><mfrac><mn>1</mn><mn>2</mn></mfrac></mrow>
  </math>
  <p>After foreign elements &copy; &#x1F642;</p>
</body>
</html>