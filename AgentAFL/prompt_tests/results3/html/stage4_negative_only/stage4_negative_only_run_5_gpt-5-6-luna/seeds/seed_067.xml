<!DOCTYPE html>
<html>
<head>
  <title>Object and embedded content</title>
  <noscript><p>head fallback</p></noscript>
</head>
<body>
  <object classid="clsid:bad" data="movie.bin" type="application/x-test"
          width=320 height=240>
    <param name=movie value="x&amp;y">
    <param name=autoplay value=true>
    <p>fallback <img src=missing alt="image < text"></p>
    <embed src="nested.swf" width="10" height="10">
  </object>
  <video controls autoplay poster=poster.jpg>
    <source src=a.mp4 type=video/mp4>
    <source src=b.ogg type=video/ogg>
    <track kind=subtitles src=sub.vtt srclang=en label=English>
    video fallback
  </video>
  <audio loop><source src=sound.wav><a href=download>download</a></audio>
  <map name=m>
    <area shape=rect coords="0,0,10,10" href="#a">
    <area shape=poly coords="1,2,3,4,5,6">
  </map>
  <img src="x" usemap="#m" ismap border=0>
  <iframe srcdoc="<p>inside &amp; quoted</p>" sandbox="allow-scripts"
          name=f><frame src=frame.html></iframe>
  <noscript><div>fallback <b>bold</b></div></noscript>
</body>
</html>