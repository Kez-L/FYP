<!doctype html>
<html>
<head>
  <meta charset="utf-16">
  <title>Interactive controls</title>
</head>
<body>
<details open=true>
  <summary>Options <span>summary</details>
  <menu type=context>
    <menuitem label="A&amp;B" onclick="x<y"></menuitem>
    <li>orphan item
  </menu>
</details>
<dialog open>
  <form method=dialog>
    <label>Choice <input type=radio name=r checked=checked></label>
    <label><input type=checkbox name=c>Check</label>
    <output name=result for="a b">result</output>
    <meter min=10 max=0 low=20 high=-2 optimum=5 value=nan>bad</meter>
    <progress max=-1 value=999>loading</progress>
    <button formmethod=post formaction="/x?y=1&z=2">Submit
  </form>
</dialog>
<template><table><tr><td>template</template></td></tr></table></template>
</body>
</html>