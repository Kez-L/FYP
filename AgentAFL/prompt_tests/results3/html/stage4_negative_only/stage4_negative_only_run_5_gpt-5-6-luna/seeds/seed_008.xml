<html>
  <head>
    <?xml-stylesheet type="text/css" href="style.css"?>
    <title>Odd declarations</title>
  </head>
  <body>
    <div>
      <![CDATA[
        <not-an-element> & still text
      ]]>
      <p>Before
      <hr>
      <p>After
    </div>
    <dl>
      <dt>Term one
      <dd>Description one
      <dd><dt>Term two</dt><dd>Description two</dd>
    </dl>
    <blockquote cite="http://example.test/q">
      <p>Quoted <q cite='x"y'>words</q>
      <cite>Source</cite>
    </blockquote>
    <address>Written by <a href="mailto:a@b">A & B</a></address>
  </body>
</html>