<!DOCTYPE HTML PUBLIC "-//W3C//DTD HTML 4.01 Frameset//EN">
<html>
<head>
<meta http-equiv="Content-Type" content="text/html; charset=windows-1252">
<title>Frameset &amp; fallback</title>
</head>
<frameset rows="25%,*,0" onload="top.x&amp;y()">
  <frame src="about:blank" name="top" scrolling="no" frameborder="0">
  <frameset cols="40%,60%">
    <frame srcdoc="<html><body><h1>Nested &amp; text</h1></body></html>" name="left">
    <frame src="javascript:alert('x')" name="right">
    <noframes>
      <body>
        <p>Frames unavailable</p>
        <table><tr><td>fallback</td></tr></table>
      </body>
    </noframes>
  </frameset>
  <frame>
</frameset>
</html>