<!DOCTYPE html>
<html>
<head>
  <title>Form controls and embedded raw text</title>
  <form id=outer action=/submit method=POST>
    <label for=x>Name <input id=x name=name required=maybe></label>
    <input type=text name=a value="one" value="two">
    <input type=image src="x" alt="go"><button formaction=/other>button
</head>
<body>
  <form action="inner">
    <fieldset disabled>
      <legend>legend <b>bold</legend>
      <select name=pick multiple size=bad>
        <optgroup label=Group disabled>
          <option selected value=1>one
          <option value=2>two
        </optgroup>
        <option>three
      </select>
      <textarea name=t rows=2 cols=3>text <b>literal</textarea>
      <output for="x y">result</output>
    </fieldset>
    <input type=file accept="image/*,.x" multiple>
  </form>
  <iframe srcdoc="<p>inside &amp; <b>frame" sandbox allow-scripts></iframe>
  <object data="movie.bin" type="application/octet-stream">
    <param name=name value=value>
    fallback <a href="x">link</a>
  </object>
  <p contenteditable spellcheck=maybe>after <br/> line
  <form><button><select><option>x</button></form>
</body>
</html>