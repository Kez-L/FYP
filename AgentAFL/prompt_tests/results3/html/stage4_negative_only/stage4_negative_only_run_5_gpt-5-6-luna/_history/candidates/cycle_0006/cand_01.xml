<!doctype html>
<html>
<head><title>Frameset Document</title></head>
<frameset rows="20%,*,10%" frameborder="0">
  <frame src="top.html" name=top scrolling=no>
  <frameset cols="30%,70%">
    <frame src='left.html' name=nav>
    <frame src=main.html name=content noresize>
  </frameset>
  <noframes>
    <body>
      <h1>Fallback</h1>
      <p>This page uses <b>frames</b> and an unclosed fallback.
      <table><tr><td>x<td>y</table>
    </body>
  </noframes>
</frameset>
</html>