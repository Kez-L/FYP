<!DOCTYPE html>
<html>
<head>
<title>Foreign content boundaries</title>
</head>
<body>
<svg width="120" height="80" viewBox="0 0 120 80" xmlns="http://www.w3.org/2000/svg">
  <title>svg title</title>
  <g transform="translate(2 3)" fill="red">
    <rect x="0" y="0" width="40" height="20"/>
    <foreignObject x="5" y="5" width="80" height="30">
      <div xmlns="http://www.w3.org/1999/xhtml"><p>HTML <b>inside</div>
    </foreignObject>
    <path d="M0 0 L10 10 Q 20 30 40 0 Z"></path>
  </g>
</svg>
<math display="block">
  <mrow><mi>x</mi><mo>&lt;</mo><msup><mi>y</mi><mn>2</mn></msup></mrow>
  <annotation-xml encoding="application/xhtml+xml"><p>math html</p></annotation-xml>
</math>
<p>after <svg><circle cx=4 cy=4 r=3></svg> tail</p>
</body>
</html>