<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-16">
  <title>Obsolete and malformed controls</title>
</head>
<body bgcolor=#fff text="black" link=blue vlink=purple alink=red>
  <center><font size=+7 face="serif" color><big>legacy</center>
  <marquee direction=sideways behavior=unknown><blink>moving</blink></marquee>
  <object classid="clsid:unknown" data="file.bin" type="application/octet-stream">
    <param name=name value=value>
    <embed src="plugin.dat" width=0 height=-20></embed>
    fallback <noembed>fallback text
  </object>
  <form action method=post enctype="multipart/form-data" novalidate="no">
    <fieldset disabled><legend>Group <output name=o for="a b">result</output>
      <label>Text <input name=a type=text value="x" maxlength=-2></label>
      <label>File <input type=file accept="*/*,,.x" multiple=maybe></label>
    </fieldset>
    <select name=s size=0 multiple="false">
      <optgroup label="G"><option selected=maybe value=1>one<option>two
      <option>three
    </select>
    <textarea name=t wrap=invalid maxlength=-1>text</textarea>
    <button type=reset formaction=/reset>reset
  </form>
  <hr><isindex prompt="Search:">
</body>
</html>