<!DOCTYPE html>
<html>
<head><title>Misnested phrasing</title></head>
<body>
<p><b><i><u><s><strong>alpha</b> beta</i> gamma</u> delta</s> epsilon</strong>
<p><a href="#a"><em>first <a href="#b">second <span>third</a> fourth</span></em>
<blockquote cite="&quot;broken"><p>quote <cite>source</blockquote>
<figure>
  <img src=one alt="first" width=auto height=-1>
  <figcaption>caption <small>small</figure>
</figcaption>
<section><h2>section<h4>skipped heading</section>
<menu type=context>
  <li><button type=button name=x disabled=maybe>click</button>
  <li><label for=q>Label<input id=q name=q required="false"></label>
</menu>
<p><time datetime="2026-99-99T99:99">future</time>
   <data value="a&b">value</data>
   <abbr title="long"><dfn>term</abbr>
</body>
</html>