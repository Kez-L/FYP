<!doctype html>
<html>
<head>
  <title>Objects and maps</title>
  <base target="_blank">
</head>
<body>
  <object data="movie.bin" type="application/x-test" width="0" height="-1">
    <param name="autoplay" value="true">
    <param name=src value='a"b&c'>
    <embed src="plugin.so" hidden="maybe">
    <img src="fallback.png" usemap="#m">
  </object>
  <map name=m id=m>
    <area shape=rect coords="0,0,10" href="/a">
    <area shape=poly coords="1,2,3,4,5" alt="x">
    <area href=unquoted target=_self>
  </map>
  <video controls autoplay poster="p.jpg">
    <source src=a.mp4 type=video/mp4>
    <track kind=subtitles src=vtt srclang=en>
    <audio src=b.ogg><p>fallback
  </video>
</body>
</html>