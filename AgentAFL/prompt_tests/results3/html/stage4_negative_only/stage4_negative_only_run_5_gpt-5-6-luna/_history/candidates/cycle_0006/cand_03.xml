<body>
<center><big><font face="serif" color=red>Notice</font></big></center>
<p>Before <b>bold <i>italic <u>under <strike>strike</b> close</i></u></strike>
<blockquote cite="x"><p>quoted<br>line<q>nested quote</blockquote>
<pre>
  literal &lt;tag&gt; &amp; text
  <code>code <kbd>key</kbd></code>
</pre>
<dl compact>
  <dt>Term
  <dd>Definition <sup>1</sup>
  <dt><abbr title="HyperText Markup Language">HTML</abbr>
  <dd><acronym title=x>markup</acronym>
</dl>
<div align=left><img src="x" alt="a &quot;quote" border=0><applet code="Demo.class" width=1 height=1>fallback</applet></div>
</body>
