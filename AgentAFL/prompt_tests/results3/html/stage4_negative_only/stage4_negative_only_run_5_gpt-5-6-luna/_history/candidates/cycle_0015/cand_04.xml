<!DOCTYPE html>
<html>
<head><title>Media map and obsolete containers</title></head>
<body>
  <header><hgroup><h1>heading one<h2>heading two</hgroup></header>
  <main>
    <picture>
      <source media="(min-width: 1px)" srcset="a 1x, b 2x">
      <source type="image/webp" srcset="">
      <img src="fallback" alt="">
    </picture>
    <audio controls autoplay="false">
      <source src="sound.ogg" type="audio/ogg">
      <track kind=subtitles src="sub.vtt" srclang=en default>
      audio fallback
    </audio>
    <video width="0" height="-" poster="p">
      <source src="movie.mp4">
      <track>
    </video>
    <map name=map1>
      <area shape=rect coords="0,0,10" href=#one alt=one>
      <area shape=poly coords="bad" nohref>
      <area>
    </map>
    <img src="x" usemap="#map1" ismap>
    <center><font size=+100 color=#ggg>legacy <big>large</center>
    <marquee direction=diagonal behavior=unknown>
      <blink>moving <tt>text</blink>
    </marquee>
    <dir><li>directory item<li><a href="#">link</dir>
    <p><ins cite=x datetime=bad>inserted <del>deleted</ins> remainder</del>
    <footer><small>footer <a href="mailto:x@y">mail</a></small></footer>
  </main>
</body>
</html>