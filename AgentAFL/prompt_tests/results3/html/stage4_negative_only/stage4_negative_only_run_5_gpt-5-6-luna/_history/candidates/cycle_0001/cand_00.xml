<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>Nested Recovery Case</title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
</head>
<body>
  <main id="root">
    <section>
      <p>Alpha <b>bold <i>italic <u>underlined</p>
      <div class="after-paragraph">
        <span>Recovered text</span>
        <table border="1">
          <tr><td>one<td>two
          <tbody><tr><th colspan="2">header</th></tr></tbody>
        </table>
      </div>
    </section>
  </main>
</body>
</html>