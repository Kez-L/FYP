<html>
<head><title>Frameset transition</title></head>
<frameset rows="20%,*,0" cols="*,*" border=2>
  <frame src="top.html" name=top scrolling=no>
  <frameset cols="30%,70%">
    <frame src=left.html frameborder=0>
    <frame src=right.html>
    <noframes>
      <body>
        <h1>Fallback</h1>
        <p>Frames are unavailable
        <form><input type=image src=x><input type=hidden name=a value="&amp;">
        <button>fallback</button></form>
      </body>
    </noframes>
  </frameset>
</frameset>
<script>
if (a < b) { document.write("<div class='x'>"); }
</script>
</html>