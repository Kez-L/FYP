<!doctype html>
<html lang="x">
<head>
  <title>Interactive Template Document</title>
  <meta name="description" content="A &amp; B">
</head>
<body>
  <dialog open>
    <form method="dialog">
      <menu>
        <button value="ok">OK</button>
        <button value="cancel" autofocus>Cancel</button>
      </menu>
    </form>
  </dialog>
  <template id="card">
    <article>
      <h2><slot name="title">Fallback title</slot></h2>
      <img src="image.png" alt="sample">
      <details open>
        <summary>More</summary>
        <p>Template content <br> with a break.</p>
      </details>
    </article>
  </template>
  <main>
    <slot>Outside slot</slot>
    <iframe srcdoc="<p>embedded &amp; text</p>" sandbox></iframe>
    <video controls poster="poster.jpg">
      <source src="movie.mp4" type="video/mp4">
      fallback
    </video>
  </main>
</body>
</html>