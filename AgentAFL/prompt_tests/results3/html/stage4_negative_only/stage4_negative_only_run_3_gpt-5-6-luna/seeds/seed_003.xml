<!DOCTYPE html>
<html>
<head>
  <title>Form Controls</title>
</head>
<body>
  <form id="profile" action="/submit" method="post" enctype="multipart/form-data">
    <fieldset disabled>
      <legend>Account details</legend>
      <input type="text" name="user" value="guest" required>
      <input type="email" name="mail" placeholder="name@example.test">
    </fieldset>
    <fieldset>
      <legend>Preferences</legend>
      <input type="hidden" name="token" value="x&amp;y">
      <input type="checkbox" id="news" name="news" checked>
      <label for="news">Send updates</label>
      <input type="radio" id="light" name="theme" value="light">
      <label for="light">Light</label>
      <input type="radio" id="dark" name="theme" value="dark" checked>
      <label for="dark">Dark</label>
      <textarea name="notes" rows="2" cols="20">line one
line &lt;two&gt;</textarea>
      <input type="file" name="attachment" multiple accept=".txt,text/plain">
      <button formaction="/preview" formmethod="get">Preview</button>
    </fieldset>
  </form>
  <output form="profile" name="status">pending</output>
</body>
</html>