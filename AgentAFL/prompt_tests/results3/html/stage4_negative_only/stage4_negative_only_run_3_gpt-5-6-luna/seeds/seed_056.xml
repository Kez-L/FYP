<!doctype html>
<html>
<head>
  <title>Form controls</title>
  <base href="http://example.invalid/a/">
</head>
<body>
<form action="/submit" method="POST" enctype="multipart/form-data">
  <fieldset disabled><legend>Choose <em>one</legend>
    <label for=x>First <input id=x type=radio name=q checked>
    <label>Second <input type="radio" name="q" value="2"></fieldset>
  <input type=text name=user value="a&amp;b" required readonly>
  <textarea name=note rows=2 cols=4>one
two</textarea>
  <select name=items multiple size=3>
    <optgroup label="Group"><option selected>alpha<option value='b'>beta
    <option>gamma
  </select>
  <button type=submit>Send <input type=image src=x alt=go></button>
  <output name=result>unclosed
</form>
<form><input name=second><button>other</form>
</body>
</html>