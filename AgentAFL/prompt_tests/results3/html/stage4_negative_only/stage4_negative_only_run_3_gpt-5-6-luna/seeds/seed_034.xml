<!doctype html>
<html>
<head><title>Lists and Objects</title></head>
<body>
<ol start="999999999999999999999" reversed type="unsupported">
<li value="x">one
<li>two
<ul type="circle"><li>nested<ul><li>deep</ul><li>after</ul>
</ol>
<dl compact="no"><dt>alpha<dd><p>paragraph one<p>paragraph two
<dt>beta<dd><tableish><row><cell>fake</cell></row></tableish>
</dl>
<object data="file.bin" type="application/x-unknown" width="-" height="100%">
<param name=movie value="a&b">
<embed src="plugin" type="x/y" hidden="maybe">
<noembed><p>fallback <img src=missing alt=broken></noembed>
</object>
<map name="m"><area shape=poly coords="0,0,notnum" href=#x alt="area"><area href></map>
<img src="x" usemap="#m" ismap="false" width=abc height=-- alt>
<picture><source srcset="a 1x, b 2q"><source media="("><img srcset="broken"></picture>
</body>
</html>