<!DOCTYPE html>
<html>
<head>
  <title>Forms and Tables</title>
</head>
<body>
  <form action="/submit" method="post" enctype="multipart/form-data">
    <fieldset>
      <legend>Registration</legend>
      <label for="user">User name</label>
      <input id="user" name="user" required minlength="2" maxlength="40">
      <label>
        <span>Category</span>
        <select name="category">
          <optgroup label="Letters">
            <option value="a">Alpha</option>
            <option value="b" selected>Beta</option>
          </optgroup>
          <optgroup label="Numbers" disabled>
            <option value="1">One</option>
          </optgroup>
        </select>
      </label>
      <input list="choices" name="choice">
      <datalist id="choices">
        <option value="red">Warm</option>
        <option value="blue">Cool</option>
      </datalist>
      <textarea name="notes" rows="3" cols="28">line one
line two</textarea>
      <button type="submit">Send</button>
    </fieldset>
  </form>
  <table>
    <caption>Quarterly values</caption>
    <colgroup>
      <col span="2" class="wide">
      <col class="narrow">
    </colgroup>
    <thead>
      <tr><th scope="col">Name</th><th scope="col">Kind</th><th scope="col">Value</th></tr>
    </thead>
    <tbody>
      <tr><th scope="row">North</th><td rowspan="2">A</td><td>17</td></tr>
      <tr><th scope="row">South</th><td>23</td></tr>
    </tbody>
    <tfoot>
      <tr><td colspan="2">Total</td><td><output>40</output></td></tr>
    </tfoot>
  </table>
</body>
</html>