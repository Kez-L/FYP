<!doctype html>
<html>
<head>
  <title>Lists and definition recovery</title>
</head>
<body>
  <ol start="0" reversed type="A">
    <li>alpha
    <li value="7">beta
      <ul>
        <li>nested one
        <li>nested two
      </ul>
    <li>gamma
  </ol>
  <menu>
    <li><input type="checkbox" checked> check
    <li><input type="radio" name="r"> radio
  </menu>
  <div>
    <p>paragraph one
    <div>unexpected division
      <p>paragraph two
      <table><tr><td>cell</td></tr></table>
    </div>
    <p>paragraph three
  </div>
  <figure>
    <img src="" alt="">
    <figcaption>caption <mark>highlight</mark></figcaption>
  </figure>
</body>
</html>