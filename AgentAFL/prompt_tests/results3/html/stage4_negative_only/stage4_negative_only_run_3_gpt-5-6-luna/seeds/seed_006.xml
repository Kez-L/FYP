<!doctype html>
<html>
<head><title>Foreign Content Junction</title></head>
<body>
  <div id="wrapper">
    <svg width="240" height="120" viewBox="0 0 240 120" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <linearGradient id="g" x1="0" x2="1"><stop offset="0%"/><stop offset="100%" stop-color="#ff0"/></linearGradient>
        <clipPath id="clip"><circle cx="60" cy="60" r="48"/></clipPath>
      </defs>
      <g clip-path="url(#clip)" transform="translate(4 4)">
        <rect width="110" height="100" fill="url(#g)"/>
        <text x="8" y="32" font-size="16">SVG &amp; text</text>
        <path d="M10 80 C30 5 80 115 105 35" fill="none" stroke="black"/>
      </g>
      <foreignObject x="120" y="10" width="110" height="90">
        <div xmlns="http://www.w3.org/1999/xhtml"><p>embedded <em>HTML</em></p></div>
      </foreignObject>
    </svg>
    <math xmlns="http://www.w3.org/1998/Math/MathML">
      <mrow><mi>x</mi><mo>=</mo><mfrac><mn>−b</mn><msqrt><msup><mi>b</mi><mn>2</mn></msup><mo>−</mo><mn>4ac</mn></msqrt></mfrac></mrow>
    </math>
    <p>Trailing HTML after foreign nodes &copy; <span data-x="&lt;&amp;&quot;">done</span></p>
  </div>
</body>
</html>