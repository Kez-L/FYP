<!doctype html>
<html>
<head>
  <title>Template and Dialog</title>
</head>
<body>
  <main>
    <template id="card-template">
      <article class="card">
        <header><h2><slot name="heading">Fallback heading</slot></h2></header>
        <p><slot>Fallback body</slot></p>
      </article>
    </template>
    <section aria-label="Live examples">
      <dialog id="notice" open>
        <form method="dialog">
          <h1>Notice</h1>
          <p>This dialog includes a progress indicator.</p>
          <progress value="3" max="5">60%</progress>
          <meter min="0" max="100" low="30" high="80" optimum="90" value="72">72</meter>
          <menu>
            <li><button value="close">Close</button></li>
          </menu>
        </form>
      </dialog>
      <details>
        <summary>Expandable content</summary>
        <div>
          <p>Additional content appears after the summary.</p>
          <ul>
            <li>First item</li>
            <li>Second item with <span>inline text</span></li>
          </ul>
        </div>
      </details>
    </section>
    <iframe srcdoc="<p>Inline frame content</p>" title="Preview" loading="lazy"></iframe>
  </main>
  <noscript>
    <p>JavaScript is disabled.</p>
  </noscript>
</body>
</html>