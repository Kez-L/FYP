<!DOCTYPE HTML>
<html>
<head><title>Malformed document recovery</title></head>
<body>
  <div id="outer">
    <p>paragraph one
    <p>paragraph two
    <div><span>span starts
      <table>
        <tr><td>cell before tbody
        <tbody><tr><td>body cell</td></tr></tbody>
        <tfoot><tr><td>foot</td></tr></tfoot>
      </table>
    </div>
  </div>
  <center><font face="serif" size="7" color="#zzzzzz">
    <big>legacy <strike>markup</font></big></strike>
  </center>
  <hr noshade="noshade" width="101%" height="bad">
  <iframe srcdoc="<p>embedded &amp; text</p>" sandbox="allow-scripts" name="frame">
    fallback <object data="file.bin" type="application/octet-stream">
      <param name="x" value="1"><embed src="x">
    </object>
  </iframe>
  <div><a href="x"><button>invalid nesting</a></button></div>
  <!-- unclosed comment
  <p>commented-looking content</p>
</body>
</html>