<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>Nested Dialog Case</title>
  <base href="./assets/">
  <link rel="stylesheet" href="theme.css">
</head>
<body>
  <main id="shell">
    <dialog open>
      <form method="dialog">
        <label for="choice">Choose a value</label>
        <select id="choice" name="choice">
          <optgroup label="Primary">
            <option selected value="α">Alpha</option>
            <option value="β">Beta</option>
          </optgroup>
          <optgroup label="Empty"></optgroup>
        </select>
        <button type="submit">Close</button>
      </form>
      <details open>
        <summary>Additional information</summary>
        <p>Text before <mark>highlighted <b>content</b></mark> and after.</p>
      </details>
    </dialog>
  </main>
</body>
</html>