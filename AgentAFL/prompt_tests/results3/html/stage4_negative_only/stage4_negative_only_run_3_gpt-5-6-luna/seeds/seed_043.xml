<!doctype html>
<html>
<head>
  <title>Media and form controls</title>
  <base target="_blank">
</head>
<body>
  <form id="f" action="/search" enctype="multipart/form-data">
    <fieldset disabled>
      <legend>Search options</legend>
      <input type="search" name="q" list="terms" minlength="2" maxlength="20">
      <datalist id="terms">
        <option label="alpha" value="a">
        <option value="b">Beta
      </datalist>
      <textarea name="notes" rows="2" cols="5" wrap="hard">one
two</textarea>
      <output name="result" for="q">unknown</output>
    </fieldset>
    <input type="file" accept="image/*,.txt" multiple>
    <input type="date" min="2020-01-01" max="not-a-date" value="2020-02-30">
    <button type="reset" formnovalidate>Reset</button>
  </form>
  <video controls autoplay muted poster="poster.jpg" width="320">
    <source src="movie.webm" type="video/webm">
    <source src="movie.mp4" type="video/mp4">
    <track kind="subtitles" srclang="en" label="English" default src="captions.vtt">
    fallback video text
  </video>
  <audio preload="metadata"><source src="sound.ogg"><track src="audio.vtt"></audio>
  <map name="m"><area shape="rect" coords="0,0,10,10" href="#top"></map>
</body>
</html>