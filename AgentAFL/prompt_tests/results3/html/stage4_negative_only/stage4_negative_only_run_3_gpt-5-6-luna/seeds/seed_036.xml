<!DOCTYPE html>
<html>
<head>
  <title>Interactive controls</title>
</head>
<body>
  <form id=f enctype="multipart/form-data" action=/upload>
    <fieldset disabled>
      <legend>Options <small>unfinished
      <label for=q>Query</label><input id=q type=text value="&quot;quoted">
      <input type=checkbox checked=checked disabled=false>
      <select name=mode multiple size=0>
        <option value=one selected>One
        <option value=two>Two
        <optgroup label="Group"><option>Three</optgroup>
      </select>
      <textarea name=notes rows="x" cols="-2">raw <b>markup</textarea>
      <button type=submit formaction="/go">Submit <input type=image src=x></button>
    </fieldset>
    <output name=result for="q missing">42</output>
    <datalist id=list><option value=A><option value=B></datalist>
    <input list=list pattern="[a-" maxlength="-1">
  </form>
  <details open="false"><summary>Summary</summary><p>Details</details>
  <dialog open>Dialog <menu><li>item<li>second</menu></dialog>
</body>
</html>