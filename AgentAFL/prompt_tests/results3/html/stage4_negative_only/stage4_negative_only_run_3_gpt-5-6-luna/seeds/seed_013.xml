<!DOCTYPE html>
<html>
<head><title>Foreign fragments</title></head>
<body>
<svg width="100%" height="40" viewBox="0 0 40 40" preserveAspectRatio="none">
<defs><linearGradient id=g x1=0 y1=0 x2=1 y2=1><stop offset="0%" stop-color="#fff"/><stop offset="100%"/></linearGradient></defs>
<g transform="translate(1e2,-3)rotate(999)">
<rect x="NaN" y="Infinity" width="calc(10px)" height="-" fill="url(#g)" />
<text x="0" y="10">a &lt; b</text>
<use href="#missing" xlink:href="&bad;" />
</g>
</svg>
<math display="block">
<semantics><mfrac><mroot><mi>a</mi><mn>2</mn></mroot><mrow><mo>&InvisibleTimes;</mo><mi>b</mi></mrow></mfrac>
<annotation encoding="application/xml"><![CDATA[<x><y/></x>]]></annotation></semantics>
</math>
<picture><source media="(min-width: 1px)" srcset="x 1w"><source type=image/avif><img alt="fallback"></picture>
</body>
</html>