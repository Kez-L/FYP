<!DOCTYPE HTML PUBLIC "-//W3C//DTD HTML 4.01 Transitional//EN">
<html>
<head>
  <title>Table Repair Case</title>
  <meta http-equiv="Content-Type" content="text/html; charset=windows-1252">
</head>
<body bgcolor="#fefefe">
  <form action="/submit" method="post">
    <table border="1" cellpadding="2" cellspacing="0">
      <caption><b>Unbalanced inventory</b></caption>
      <colgroup span="3"><col width="40%"><col><col></colgroup>
      <thead>
        <tr><th rowspan="2">Item<th colspan="2">Status
        <tr><th>Count<th>Notes
      <tbody>
        <tr><td>alpha<td><input name="a" value="01"><td rowspan="2">pending
        <tr><td>beta<td><input name="b" value="02">
        <tr><td colspan="3">
          <table>
            <tr><td>nested one<td>nested two
          </table>
        <tr><td>gamma<td><select name="g"><option>one<option selected>two</select>
          <td><textarea name="comment" rows="2" cols="18">unfinished
      <tfoot><tr><td>Total<td><input type="text" disabled value="3"><td>
    </table>
    <p><input type="submit" value="Save"><input type="reset"><button type="button">Cancel
  </form>
  <p>After the form <a href="/help">help <b>text</a> continues.</p>
</body>
</html>