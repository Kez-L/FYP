<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>Media and Figures</title>
</head>
<body>
  <main>
    <figure>
      <picture>
        <source media="(min-width: 800px)" srcset="wide.webp 1x, wide@2x.webp 2x" type="image/webp">
        <source srcset="compact.jpg" type="image/jpeg">
        <img src="fallback.png" alt="A geometric landscape" width="640" height="360" loading="lazy">
      </picture>
      <figcaption>Figure 1: A responsive image with alternate sources.</figcaption>
    </figure>
    <section>
      <h2>Audio sample</h2>
      <audio controls preload="metadata">
        <source src="sample.ogg" type="audio/ogg">
        <source src="sample.mp3" type="audio/mpeg">
        Your browser cannot play this audio.
      </audio>
    </section>
    <section>
      <h2>Video sample</h2>
      <video controls width="480" poster="poster.jpg">
        <track kind="captions" src="captions.vtt" srclang="en" label="English" default>
        <source src="clip.webm" type="video/webm">
        <source src="clip.mp4" type="video/mp4">
      </video>
    </section>
    <section>
      <h2>Embedded content</h2>
      <object data="diagram.svg" type="image/svg+xml" width="320" height="180">
        <param name="background" value="transparent">
        <embed src="fallback.svg" type="image/svg+xml">
      </object>
    </section>
  </main>
</body>
</html>