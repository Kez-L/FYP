<!html>
<html xmlns="http://www.w3.org/1999/xhtml">
<head><title>template and metadata</title></head>
<body>
<template id=t><div><p>inside template <slot name=x>fallback</slot></div></template>
<dialog><p>dialog text<form><input type=image src=x alt=submit><button formaction=/x formenctype=text/plain>send</button></form>
<map name=m><area shape=rect coords="0,0,10,10" href=#a alt=hit><area href></map>
<picture><source media="(min-width: 1px)" srcset="a 1x, b 2x"><img srcset="c 3x" sizes="bad" alt="pic"></picture>
<object data="x" type="application/x-unknown"><param name=movie value=y><embed src=z><p>fallback</object>
<dl><dt>term<dd>definition<dt>second<dd><div>block in definition</div>
<menu><li><button type=button autofocus>click</button><li><input type=checkbox checked=false></menu>
<iframe srcdoc="<p>quoted &amp; <b>frame</b>" sandbox="allow-scripts allow-scripts"></iframe>
</body>
