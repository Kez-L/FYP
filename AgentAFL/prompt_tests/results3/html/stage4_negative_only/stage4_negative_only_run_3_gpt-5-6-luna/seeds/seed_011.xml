<!DOCTYPE HTML PUBLIC "-//W3C//DTD HTML 3.2 Final//EN">
<html>
<head>
<title>Frameset fallback and declarations</title>
<base href="http://example.invalid/root/">
</head>
<frameset rows="20%,*,20%" frameborder="no">
<frame src="top.html" name="top" noresize scrolling="no">
<frameset cols="30%,70%">
<frame src="left.html" name="nav">
<frame src="right.html" name="content">
<noframes>
<body>
<h1>Fallback</h1>
<p>This body appears inside a malformed nested frameset.
<iframe src="fallback.html" width="10" height="10"></iframe>
</body>
</noframes>
</frameset>
<frame src="bottom.html">
</frameset>
<noframes>
<p>Second fallback without a body.
</noframes>
</html>