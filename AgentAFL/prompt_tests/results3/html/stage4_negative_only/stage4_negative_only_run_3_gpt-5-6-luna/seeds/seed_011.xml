<!doctype HTML SYSTEM "about:legacy-compat">
<html>
<head><title>Frames and maps</title></head>
<body>
<iframe name=left srcdoc="<p>embedded &amp; text</p>" sandbox="allow-scripts"></iframe>
<object data="file.bin" type="application/octet-stream" width=0 height=-1>
<param name=movie value="x&y">
<embed src="x.swf" hidden>
fallback <a href=#map>fallback</a>
</object>
<img src="image" srcset="a 1x, b 2x," usemap="#map" ismap border=0>
<map name=map>
<area shape=poly coords="0,0,10,0,10,10," href="javascript:void(0)" alt=x>
<area shape=default nohref>
</map>
<frameset cols="*,0" onload="f()">
<frame src="a" name="a"><frame src="b" name="b">
<noframes><p>Frames unavailable</p></noframes>
</frameset>
</body>
</html>