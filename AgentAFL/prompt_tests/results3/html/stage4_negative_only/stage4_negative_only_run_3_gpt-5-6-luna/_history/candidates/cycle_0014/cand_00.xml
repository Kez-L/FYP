<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<!-- unclosed-looking comment with -- oddities -->
<title>Table reconstruction</title>
</head>
<body>
<table border="1">
<caption>Inventory</caption>
<colgroup><col span="2"><col></colgroup>
<thead><tr><th scope="col">Name<th scope="col">Count<th scope="col">Note</tr></thead>
<tbody>
<tr><td>alpha<td rowspan="2">3<td>first
<tr><td>beta<td><p>paragraph inside a cell</p><table><tr><td>nested table</table>
<tr><td colspan="3">last row
</tbody>
<tfoot><tr><td>total<td>4<td></tr></tfoot>
</table>
Text between tables
<table><tr><td>A<tr><th>B</table>
</body>
</html>