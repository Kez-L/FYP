<!DOCTYPE html>
<html>
<head>
  <title>Namespace and raw text transitions</title>
</head>
<body>
  <svg xmlns="http://www.w3.org/2000/svg">
    <title>svg title</title>
    <style>rect{fill:red}</style>
    <foreignObject>
      <html>
        <head><title>inner head</title></head>
        <body><p>HTML island <b>bold</p></body>
      </html>
    </foreignObject>
    <script><![CDATA[
      if (a < b && c > d) { document.write("<path>"); }
    ]]></script>
    <text><![CDATA[raw <tag> & data]]></text>
  </svg>
  <math xmlns="http://www.w3.org/1998/Math/MathML">
    <mstyle mathvariant="double-struck">
      <mtext>text <b>not math?</b></mtext>
      <msub><mi>a</mi><mo><malignmark/></mo></msub>
      <mspace width="bad" height="calc(1px)"/>
    </mstyle>
  </math>
  <div xmlns:x="urn:unknown" x:foo="bar">
    <x:widget><x:item /></x:widget>
    <script type="text/plain"><![CDATA[</script><svg><path>]]></script>
    <textarea><svg><path d="M 0 0"></textarea>
  </div>
</body>
</html>