<!doctype html>
<html>
<head>
  <base href="/root/">
  <title>Forms and replaced elements</title>
</head>
<body>
  <form action="/submit" method=post>
    <fieldset disabled>
      <legend>Account <b>details</legend>
      <label for=user>User name
      <input id=user name=user required>
      <label>Password<input type=password name=pw>
    </fieldset>
    <fieldset>
      <legend>Options</legend>
      <input type=checkbox name=a checked>
      <input type=radio name=r value=1><input type=radio name=r value=2 checked>
      <input type=file accept="image/*,.txt" multiple>
      <input type=number min=10 max=2 step=0 value=abc>
      <input type=color value="#12">
      <input type=date value="2024-99-99">
      <input list=choices name=search>
      <datalist id=choices><option value=one><option value=two label=Two></datalist>
      <output name=result for="user">unknown</output>
      <button type=submit>Send</button><button type=reset>Reset</button>
    </fieldset>
  </form>
  <form><input name=x></form>
  <map name=world><area shape=rect coords="0,0,10,10" href=a><area href=b></map>
  <img src="map.png" usemap="#world" alt="">
  <video controls autoplay><source src=a.mp4 type=video/mp4><track kind=subtitles src=a.vtt></video>
  <audio><source src=s.ogg><source src=s.mp3></audio>
</body>
</html>