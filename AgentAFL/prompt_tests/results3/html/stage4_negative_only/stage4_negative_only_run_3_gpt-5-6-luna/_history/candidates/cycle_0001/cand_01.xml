<!DOCTYPE html>
<html>
<head>
  <title>Table and Template</title>
</head>
<body>
  <table border="1">
    <caption>Inventory</caption>
    <colgroup>
      <col span="2">
      <col>
    </colgroup>
    <thead>
      <tr><th scope="col">Item</th><th scope="col">Count</th><th scope="col">State</th></tr>
    </thead>
    <tbody>
      <tr><td rowspan="2">Widget</td><td>4</td><td>Ready</td></tr>
      <tr><td colspan="2">Reserved</td></tr>
    </tbody>
    <tfoot>
      <tr><td>Total</td><td>4</td><td><data value="ok">OK</data></td></tr>
    </tfoot>
  </table>
  <template id="row-template">
    <tr><td><slot name="name">fallback</slot></td></tr>
  </template>
  <p>After the table <ruby>漢<rt>kan</rt>字<rp>(</rp><rt>ji</rt><rp>)</rp></ruby>.</p>
</body>
</html>