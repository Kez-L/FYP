<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>Nested Interactive Document</title>
  <base href="/assets/">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <style>
    :root { --accent: #345; }
    @media screen and (min-width: 20em) {
      body > main { display: grid; }
    }
  </style>
</head>
<body>
  <header>
    <h1><a href="index.html"><span>Archive</span> <em>Explorer</em></a></h1>
    <nav aria-label="Primary">
      <ul>
        <li><a href="#records">Records</a></li>
        <li><a href="#details">Details</a></li>
      </ul>
    </nav>
  </header>
  <main id="records">
    <section>
      <h2>Selected records</h2>
      <article itemscope itemtype="https://schema.org/CreativeWork">
        <h3 itemprop="name">A layered entry</h3>
        <p itemprop="abstract">Text with <mark>highlighted</mark> and <small>secondary</small> content.</p>
        <dl>
          <dt>Format</dt>
          <dd><data value="html">HTML</data></dd>
          <dt>Updated</dt>
          <dd><time datetime="2026-10-08T12:30:00Z">Today</time></dd>
        </dl>
      </article>
    </section>
    <aside id="details">
      <details open>
        <summary>Metadata</summary>
        <ol>
          <li><span>Owner:</span> <bdi>user-Δ</bdi></li>
          <li><span>Status:</span> <strong>active</strong></li>
        </ol>
      </details>
    </aside>
  </main>
  <footer>
    <address><a href="mailto:info@example.test">Contact</a></address>
  </footer>
</body>
</html>