<!doctype html>
<html>
<head>
  <meta charset="windows-1252">
  <title>Embedded Content</title>
</head>
<body>
  <header><h1>Media Archive</h1></header>
  <section>
    <picture>
      <source media="(min-width: 800px)" srcset="large.webp 1x, large@2x.webp 2x">
      <source type="image/avif" srcset="image.avif">
      <img src="fallback.jpg" alt="A &amp; B" width="320" height="240" loading="lazy">
    </picture>
    <audio controls preload="metadata">
      <source src="sound.ogg" type="audio/ogg">
      <source src="sound.mp3" type="audio/mpeg">
      <track kind="captions" srclang="en" src="captions.vtt">
    </audio>
    <iframe srcdoc="<p>Inner &amp; isolated</p>" sandbox="allow-scripts"></iframe>
  </section>
  <footer>
    <object data="archive.bin" type="application/octet-stream">
      <param name="mode" value="preview">
      <embed src="legacy.swf" type="application/x-shockwave-flash">
    </object>
  </footer>
</body>
</html>