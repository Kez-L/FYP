<!doctype html>
<html>
<head>
<title>Forms and interactive controls</title>
</head>
<body>
<form action="/submit" method="post">
<fieldset>
<legend>Account <b>details</legend>
<label for="user">User:</label>
<input id="user" name="user" type="text" required value="&quot;broken">
<label>Password <input name="pass" type=password minlength=3></label>
<select name="role" multiple size="2">
<option value=a selected>Admin
<option value=b>Editor
<optgroup label="Other"><option>Guest<option disabled>Unknown</optgroup>
</select>
<textarea name="bio" rows="2" cols="8">literal <b>text</textarea>
<button type=submit>Send <span>now</button>
</fieldset>
<output name=result>uninitialized</output>
</form>
<form><input name=x><button>second form</button></form>
</body>
</html>