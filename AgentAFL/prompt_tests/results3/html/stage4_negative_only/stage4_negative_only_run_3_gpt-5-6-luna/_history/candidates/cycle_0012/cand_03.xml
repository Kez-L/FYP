<!DOCTYPE html>
<html>
<head>
  <title>Legacy document modes</title>
  <meta http-equiv="refresh" content="0; url='javascript:alert(1)'">
  <link rel=stylesheet href="//example.invalid/style.css" />
  <style type="text/css">
    body { color: red; } <!-- legacy
    p { background: url("x"); }
  </style>
</head>
<frameset cols="20%,*,0" rows="*">
  <frame src="a.html" name=left noresize>
  <frameset>
    <frame src='b.html'><frame src=c.html>
  </frameset>
  <noframes><body><p>fallback</p></body></noframes>
</frameset>
<noframes>trailing fallback</noframes>
</html>