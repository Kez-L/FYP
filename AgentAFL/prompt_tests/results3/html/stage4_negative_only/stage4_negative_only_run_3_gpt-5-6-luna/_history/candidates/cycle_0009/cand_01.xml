<!doctype html>
<html>
<head>
  <title>Media and list recovery</title>
  <link rel=stylesheet href=style.css disabled=false>
</head>
<body>
  <main>
    <h1>Heading <small>tail</h1>
    <ol start="0" reversed>
      <li value=abc>first
      <li>second
        <ul compact="compact"><li>nested one<li>nested two</ul>
      <li>third
    </ol>
    <dl>
      <dt>term one
      <dd>definition one
      <dt><em>term two
      <dd><p>definition <mark>with<p>another paragraph
    </dl>
    <figure>
      <picture>
        <source media="(min-width: 0px)" srcset="a 1x, b 2x, , c">
        <source type=image/avif srcset="bad&name">
        <img src=x alt="quoted & broken" srcset="a 100w b" sizes="(foo)">
      </picture>
      <figcaption>caption</figcaption>
    </figure>
    <video controls autoplay="false" poster="p" width=bad>
      <source src=a type="video/mp4; codecs=&quot;x">
      <track kind=subtitles srclang=en label=English default="no" src=vtt>
      fallback <b>text
    </video>
    <audio preload=garbage><source src=a><source src=b></audio>
    <map name=main><area shape=poly coords="1,2,3" href=#x alt=a><area href></map>
    <menu type=context><li><button type=menu>one<li><button>two</menu>
    <p><embed src=x><wbr><hr noshade><br/></p>
    <custom-widget data-a=1><unknown attr><span>tail</unknown-widget>
  </main>
</body>
</html>