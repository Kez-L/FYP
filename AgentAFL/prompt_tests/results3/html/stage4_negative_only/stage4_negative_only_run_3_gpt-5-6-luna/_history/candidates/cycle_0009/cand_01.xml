<!doctype html>
<html>
<head>
  <title>Interactive elements</title>
</head>
<body>
  <main>
    <details open>
      <summary>More information <mark>here</mark></summary>
      <p>Hidden content with <del>old</del> and <ins>new</ins>.
    </details>
    <dialog open>
      <form method="dialog">
        <p><label>Choose <select name="choice">
          <optgroup label="first">
            <option value=one selected>One
            <option value="two">Two
          </optgroup>
          <optgroup disabled label="second"><option>Three</select></label>
        <button autofocus type=submit>Close
      </form>
    </dialog>
    <figure>
      <picture>
        <source media="(min-width: 10px)" srcset="a 1x, b 2x">
        <img src="fallback" alt="picture">
      </picture>
      <figcaption>Caption without a closing figure
    <aside><p>aside starts before figure recovery</p></aside>
  </main>
  <footer>footer text
</body>
</html>