<!doctype html>
<html>
<head>
  <title>Mixed Legacy Markup</title>
  <style>
    body { color: #123456; }
    .box::before { content: "<tag>"; }
  </style>
  <!--[if IE]>
    <style>.old { behavior: url(old.htc); }</style>
