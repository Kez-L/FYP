        <pre>  preserved
   spacing &lt;and&gt; symbols</pre>
      </blockquote>
    </font>
  </center>
  <dl>
    <dt>Term &copy;</dt>
    <dd><s>obsolete</s> <ins datetime="2024-01-01">replacement</ins></dd>
  </dl>
  <script type="application/json">
    {"html":"&lt;div&gt;","items":[1,2,3]}
  </script>
