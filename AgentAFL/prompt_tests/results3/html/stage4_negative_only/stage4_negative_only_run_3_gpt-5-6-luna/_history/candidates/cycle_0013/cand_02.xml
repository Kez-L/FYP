<!DOCTYPE html>
<html lang="en">
<head><title>Interactive and ruby elements</title></head>
<body>
  <header><hgroup><h1>Heading <small>small</h1><h2>subheading</h3></hgroup></header>
  <main>
    <details open><summary>Summary <b>label</details>
      hidden detail text
    <dialog open><p>dialog content<button type=button>OK</dialog>
    <section>
      <ruby>漢<rt>kan<rp>(</rp><rtc>reading</rtc><rp>)</rp></ruby>
      <p>score <meter min="0" max="10" value="7">seven</meter>
      progress <progress max=100 value=40>40%</progress>
    </section>
    <aside>
      <figure><img src="missing.png" alt="image"><figcaption>caption</figure>
      <picture><source srcset="a.webp" type="image/webp"><img src="a.png"></picture>
    </aside>
    <article><h2>article</h2><p>one
      <section><h3>nested section</h3><p>two</section>
    <footer>article footer</footer></article>
  </main>
  <footer>page footer</footer>
</body>
</html>