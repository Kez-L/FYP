<!DOCTYPE html>
<html>
<head><title>Ruby and phrasing</title></head>
<body>
  <article>
    <header><hgroup><h1>Header</h1><h2>Subhead</h2></hgroup></header>
    <p>
      <ruby>漢<rp>(</rp><rt>kan</rt><rp>)</rp></ruby>
      <bdi dir="rtl">אבג</bdi>
      <bdo dir="ltr">abc</bdo>
      <span title="a &quot;quoted&quot; value"><small>small</small>
    </p>
    <dl>
      <dt>Term 1
      <dd>Definition <code>&lt;tag&gt;</code>
      <dt>Term 2
      <dd><samp>output <kbd>Ctrl+C</kbd></samp>
    </dl>
    <ol start="-2" reversed>
      <li value="9">nine
      <li>eight
        <ol type="i"><li>nested one<li>nested two</ol>
      <li>seven
    </ol>
    <blockquote cite="urn:test"><p>quoted <q>nested quotation</q>
    <pre>line one
line two &amp; line three</pre>
    <address>Contact: <a href=mailto:test@example.invalid>mail</a></address>
  </article>
</body>
</html>