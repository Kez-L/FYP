<!DOCTYPE html>
<html>
<head><title>misnested sections</title></head>
<body>
<header><hgroup><h1>Site</h1><h2>Subtitle</h2></hgroup></header>
<article>
<h1>Article title
<section><h2>First</h2>
<p>alpha <b>bold <i>italic <a href="#">link</p>
<section><h2>Second</h2>
<div>
<p>paragraph one
<p>paragraph two
<pre> preformatted
  line &lt;x&gt;
  <code>literal</code>
</pre>
</div>
</section>
</section>
<footer>article footer</footer>
</article>
<article>
<h2>Another</h2>
<menu>
<li>item one
<li>item two
<menu>
<li>subitem</li>
</menu>
</menu>
<dl compact><dt>key<dd>value<dt>other<dd><p>paragraph</dl>
</article>
<main>
<search>
<form>
<label>Query <input type="search"></label>
<button>Go</button>
</form>
</search>
</main>
<dialog open>
<form method="dialog"><p>Dialog text</p><button value="ok">OK</button></form>
</dialog>
<template id="t"><div><slot name="x">fallback</slot></div></template>
</body>
</html>