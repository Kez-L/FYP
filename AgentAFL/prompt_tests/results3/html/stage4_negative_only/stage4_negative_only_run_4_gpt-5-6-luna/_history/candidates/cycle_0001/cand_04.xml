<!doctype html>
<html>
<head>
  <title>Misnested Sections</title>
</head>
<body>
  <header>
    <h1>Heading
    <p>Intro <em>emphasis <strong>strong <a href="#">link</em> remains</strong></a>
  </header>
  <article>
    <h2>Part one</h3>
    <section>
      <p>Paragraph one
      <ul>
        <li>First
        <li>Second
          <dl>
            <dt>Term
            <dd>Definition
          </dl>
        <li>Third
      </ul>
    </section>
    <aside>
      <blockquote cite="/quote">
        Quoted <q>text
      </blockquote>
    </aside>
  </article>
  <footer>
    <address>Contact <br><br>someone@example.invalid</address>
  </footer>
</body>
</html>