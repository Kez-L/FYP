<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>Nested Interactive Controls</title>
  <base href="/assets/">
</head>
<body>
  <main id="controls">
    <form action="/submit" method="post">
      <fieldset disabled>
        <legend><button type="button">Toggle</button></legend>
        <label for="search">Search <input id="search" name="q" list="terms"></label>
        <datalist id="terms">
          <option value="alpha">
          <option value="beta"></option>
          <option>
        </datalist>
      </fieldset>
      <select name="choice" multiple size="2">
        <optgroup label="Primary">
          <option selected>One
          <option value="two">Two</option>
        </optgroup>
        <option>Three
      </select>
      <button type="submit">Send</button>
    </form>
  </main>
</body>
</html>