<!DOCTYPE html>
<html>
<head><title>form controls</title></head>
<body>
<form action="/submit" method="post" enctype="multipart/form-data">
<fieldset disabled>
<legend>Account <strong>details</strong></legend>
<label for="user">User</label>
<input id="user" name="user" type="text" value="&quot;unterminated" required>
<label>Password<input name="pass" type="password"></label>
<textarea name="bio" rows="2" cols="8">line one
line two</textarea>
<select name="choice" multiple size="4">
<option value=a selected>Alpha
<option value="b">Beta
<optgroup label="Group">
<option>Gamma
<option disabled>Delta
</optgroup>
</select>
<button type="submit">Send <img src=x alt="icon"></button>
</fieldset>
<fieldset>
<legend>Other</legend>
<input type="radio" name="r" checked>
<input type="radio" name="r">
<input type="file" accept="image/*">
<input type="number" min="1" max="3" step=".5">
<input type="date" value="2020-01-01">
<output name="result" for="user">result</output>
<progress max="10" value="4">40%</progress>
<meter min="0" max="100" low="20" high="80" optimum="50">50</meter>
</fieldset>
</form>
<iframe srcdoc="<p>embedded &amp; text</p>" name="frame"></iframe>
<object data="x.bin" type="application/octet-stream">
<param name="mode" value="raw">
fallback <a href="fallback">download</a>
</object>
</body>
</html>