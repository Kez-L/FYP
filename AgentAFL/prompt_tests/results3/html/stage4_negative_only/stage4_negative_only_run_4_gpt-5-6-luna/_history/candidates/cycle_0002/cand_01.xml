<!doctype html>
<html lang=en>
<head><title>misnested table modes</title></head>
<body>
<table border=1>
  <caption><b>caption <i>crossed</caption>
  <colgroup><col span=2><col>
  <thead><tr><th>H1<th>H2</tr>
  <tbody>
    <tr><td>A<td>B
    <tr><td colspan=3>
      <table><tr><td>inner
    </tbody>
  <tfoot><tr><td>footer</table>
<p>after table
<table><tbody><tr><td>x</tbody></table>
</body>