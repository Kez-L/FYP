<!DOCTYPE html>
<html>
<head><title>raw text boundaries</title></head>
<body>
  <pre>
line one
  &lt;not-an-element&gt;
  <b>literal-looking</b>
  </pre>
  <textarea rows=4 cols=12>one
two &amp; three
</textarea>
  <xmp><div>inside xmp</div>&amp;</xmp>
  <listing><p>listing text</listing>
  <plaintext>
    Everything after this point is intended to be text.
    <div class="apparently">not markup</div>
    &lt;end&gt;
</body>
</html>