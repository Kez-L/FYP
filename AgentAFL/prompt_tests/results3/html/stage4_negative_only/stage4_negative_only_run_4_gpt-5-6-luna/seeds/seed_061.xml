<!doctype html>
<html>
<head><title>controls</title></head>
<body>
<form action=/submit method=maybe enctype="multipart/form-data" accept-charset=utf-8>
  <fieldset disabled="false"><legend>Account
    <label for=x>Name <input id=x name=user type=text value="a&b" maxlength=-4></label>
    <label>Password <input name=p type=password required=required></label>
  </fieldset>
  <select name=choice multiple size=zero>
    <optgroup label="one" disabled>
      <option selected value=1>First
      <option value=2>Second
    <optgroup label=two>
      <option>Third</select>
  <textarea name=notes cols=bad rows=-1>&lt;tag&gt;
    raw </textarea>
  <button type=unknown><img src=x alt="button">go</button>
  <input type=image src=missing alt>
</form>
<p><input type=checkbox checked=no><output for=x>result
</body>
</html>