<!doctype html>
<html>
<head><title>forms and declarations</title></head>
<body>
<form id=f1>
  <input name=a disabled required readonly>
  <button formaction=/x formmethod=dialog>send</button>
  <output for="a b">result</output>
  <meter min=10 max=0 low=20 high=-2 value=999>meter</meter>
  <progress max=-1 value=2>progress
  <fieldset>
    <legend>one</legend>
    <input type=number min=bad step=any value="1e999">
    <input type=image src=x alt=unclosed
  </fieldset>
</form>
<form id=f2><select><option>one<optgroup><option>two</select></form>
<dialog open><form method=dialog><button>close</button></form></dialog>
</body>