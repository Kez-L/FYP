<!doctype html public "-//W3C//DTD HTML 4.01 Transitional//EN" "http://www.w3.org/TR/html4/loose.dtd">
<html>
<head><title>form controls</title></head>
<body>
  <form name=f action=/go method=dialog onsubmit="return false">
    <fieldset disabled>
      <legend>Options</legend>
      <label for=q>Query</label><input id=q type=search required minlength=999 maxlength=-2 pattern="[">
      <select name=choice multiple size=-4>
        <optgroup label="A" disabled><option selected>one<option>two
        <option value="&lt;" label="x">three
      </select>
      <textarea name=t rows="NaN" cols="-8">one
two</textarea>
      <output for=q>result</output>
      <progress value="Infinity" max="0">loading</progress>
      <meter min="10" max="1" low="x" high="-1" value="999">meter</meter>
    </fieldset>
    <input type=image src="" alt="">
    <button formaction="/other" formmethod="GET" type=reset>Reset
  </form>
  <menu type=context><li>menu item</menu>
  <details open="false"><summary>summary</summary><pre>preformatted
  &lt;tag&gt;</details>
</body>
</html>