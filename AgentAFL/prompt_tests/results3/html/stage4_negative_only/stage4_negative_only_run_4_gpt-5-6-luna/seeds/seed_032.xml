<html>
<head><title>lists and phrasing</title></head>
<body>
<ol start="0" reversed type="A">
<li>alpha
<li value=7>beta<ul compact><li>nested one<li>nested two<ol><li>deep</ol></ul>
<li>gamma
</ol>
<dl compact>
<dt>term one
<dd>definition one
<dt><span>term <i>two</i></span>
<dd><p>definition <mark>two</mark>
<dd>extra definition
</dl>
<menu><li><a href=one>one</a><li><a href="two">two</menu>
<p><ruby>漢<rt>kan</rt><rp>(</rp><rt>かん</rt><rp>)</rp></ruby>
<wbr><bdi>abc</bdi><bdo dir=ltr>xyz</bdo>
<figure><img src="missing" alt="figure"><figcaption>caption</figcaption></figure>
<center><font face="serif" size=+2 color=#fff>obsolete</font></center>
</body>
</html>