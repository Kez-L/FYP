<!DOCTYPE HTML PUBLIC "-//W3C//DTD HTML 4.01 Frameset//EN" "http://www.w3.org/TR/html4/frameset.dtd">
<html>
<head>
  <title>Frame topology</title>
  <meta http-equiv="Content-Type" content="text/html; charset=windows-1252">
</head>
<frameset cols="25%,*,25%" border="0">
  <frame name="left" src="javascript:alert('left')" noresize scrolling="auto">
  <frameset rows="40%,60%">
    <frame srcdoc="<html><body><h1>Nested</h1></body></html>" frameborder="1">
    <noframes>
      <body>
        <h2>Fallback</h2>
        <iframe src="about:blank" seamless></iframe>
        <object data="missing.bin" type="application/octet-stream">
          <param name="autoplay" value="false">
          <embed src="broken.swf" hidden>
        </object>
      </body>
    </noframes>
  </frameset>
  <frame src="data:text/html,%3Cp%3Eright%3C/p%3E" scrolling="no">
</frameset>
</html>