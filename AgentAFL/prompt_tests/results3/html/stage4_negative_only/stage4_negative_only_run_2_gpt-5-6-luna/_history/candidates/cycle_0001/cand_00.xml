<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>Nested Template Stress</title>
  <style>
    :root { --gap: calc(1px + 2%); }
    @media screen and (max-width: 0px) {
      body > main article:first-child { display: contents; }
    }
  </style>
</head>
<body>
  <main>
    <article id="outer">
      <template shadowrootmode="open">
        <section>
          <slot name="missing"></slot>
          <template>
            <p>inner template <strong>without a close
          </template>
        </section>
      </template>
      <div hidden>
        <template id="t1"><template id="t2"><template id="t3">deep</template>
        <form><input name="x"><button><span>submit</form>
      </div>
    </article>
  </main>
</body>
</html>