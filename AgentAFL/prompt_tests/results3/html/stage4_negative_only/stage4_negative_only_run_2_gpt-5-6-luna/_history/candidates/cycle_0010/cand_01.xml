<!doctype html>
<html>
<head><title>Controls</title></head>
<body>
<form action="/submit" method="POST" enctype="multipart/form-data">
<fieldset disabled="false">
<legend><label for=missing>Account</legend>
<label>Name <input type=text name=name value="a&quot;b" required></label>
<label><input type=checkbox checked="no">opt</label>
<select name=kind multiple size="-4">
<option value=1 selected>one
<option value=2>two
<optgroup label="group"><option>three</optgroup>
</select>
<textarea name=note rows=abc cols=-1>first
  second <b>not markup</textarea>
<button type=submit><i>Send</button>
<input type=image src=x alt="go"><input type=hidden disabled>
</fieldset>
</form>
<form><input name=x><form><input name=y></form></form>
<details open="0"><summary>summary</summary><p>hidden content
<dl><dt>term<dd>definition<dt><dt>empty</dl>
</body>
</html>