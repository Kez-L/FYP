<!DOCTYPE html>
<html>
<head>
  <title>Lists and ruby</title>
</head>
<body>
  <ol start="zero" reversed="false" type="A">
    <li value="NaN">one
    <li>two
      <ul type="square">
        <li>nested
        <li><ol><li>deep<li>deeper</ol>
      </ul>
    <li><p>three
  </ol>
  <menu compact="compact"><li>menu item<li><a href="">link</menu>
  <dir><li>legacy one<li>legacy two</dir>
  <blockquote cite="unterminated>
    quote <q cite=x>nested <q>double</blockquote>
  <ruby>
    base<rp>(</rp><rt>annotation</rt><rp>)</rp>
    <rb>unclosed <rtc>group <rt>note
  </ruby>
  <p><b><i><u><s><strike>formatting
  <center><font face="A" size=999 color=#ggg>old text</font></center>
  <marquee direction=sideways behavior=alternate>moving <blink>text</blink></marquee>
  <x-unknown a=1><y-unknown><z-unknown /></y-unknown></x-unknown>
</body>
</html>