<!DOCTYPE html>
<html>
<head>
  <title>Form controls and replaced elements</title>
</head>
<body>
<form action="/submit?a=1&b=2" method=post enctype="multipart/form-data" name=f>
  <fieldset disabled="false"><legend><label for=x>Choose &amp; type</legend>
    <label><input id=x type=text name=q value="one" value="two" maxlength=-3></label>
    <input type=number min=10 max=2 step=0 name=n>
    <input type=image src=missing alt=go formaction=/other>
    <button type=submit><select name=s multiple size=-1>
      <option selected value=a>alpha<option value=b>beta
      <optgroup label="group"><option>gamma</optgroup>
    </select></button>
    <textarea name=t rows=0 cols=-5>text &amp; <b>literal?</textarea>
    <output for="x n">result</output>
  </fieldset>
  <input type=file accept="image/*,,text/plain" capture=unknown>
</form>
<map name=m><area shape=rect coords="1,2,three,4" href=#x><area nohref></map>
<img src="x" usemap="#m" ismap loading=lazy>
<object data="file.bin" type="application/octet-stream" width="auto">
  <param name=p value=v><param name=p>
  <embed src="plugin" type="x/y"><noembed>fallback</noembed>
</object>
<video controls autoplay="0" poster="" width="NaN">
  <source src=a type=video/mp4><track kind=captions src=cc.vtt default>
  video fallback
</video>
<iframe src="about:blank" sandbox="allow-scripts allow-scripts" loading=lazy>frame text</iframe>
</body>
</html>