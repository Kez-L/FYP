<!doctype html>
<html>
<head>
  <title>Interactive controls</title>
  <noscript><style>body{display:none}</style><p>fallback</noscript>
</head>
<body>
<form action="/submit" method=post enctype="multipart/form-data">
  <fieldset disabled>
    <legend>Choose <input type=text value="legend"></legend>
    <label for=a>First</label><input id=a type=text required>
    <label>Second<input type=checkbox checked=checked></label>
    <select name=s multiple size=0>
      <optgroup label="A"><option value=1 selected>one<option value=2>two</optgroup>
      <option>three
    </select>
    <textarea name=t rows=-2 cols="abc">x</textarea>
  </fieldset>
  <input type=image src="x" alt="submit">
  <button type=submit formaction="/other">go</button>
  <output name=o for="a b">result</output>
</form>
<form><input name=outside></form>
<label for=missing>dangling</label>
<details open><summary>sum</summary><dialog open>dialog text</details>
</body>
</html>