<!DOCTYPE html>
<html lang="en">
<head>
  <meta http-equiv="content-type" content="text/html; charset=utf-8">
  <title>Interactive controls</title>
</head>
<body>
  <header><h1><em>Control</h1> panel</em></header>
  <main>
    <details open="open">
      <summary>Choose a value <strong>now</summary>
      <form id="f" action="javascript:alert(1)" enctype="multipart/form-data">
        <label for="q">Query <input id="q" name="q" required></label>
        <fieldset disabled>
          <legend>Options <i>unfinished</fieldset>
          <input type="checkbox" checked=checked name="a">
          <input type="radio" name="a" value="one"><input type="radio" name="a" value="two">
          <select name="s" multiple size="3">
            <optgroup label="Group one">
              <option selected>alpha
              <option>beta
            </optgroup>
            <option label="lonely" value="&bad;">gamma
          </select>
          <textarea name="t" rows="2">text <b>not markup</textarea>
          <button type="reset"><span>reset</button>
        </fieldset>
        <input type="file" accept="image/*" multiple>
        <output name="result" for="q">x</output>
      </form>
      <dialog open>dialog content <form method="dialog"><button>close</button></form>
    </details>
  </main>
  <footer><address><a href="mailto:x@y">contact</a></address></footer>
</body>
</html>