<!doctype html>
<html>
<head>
  <title>Raw text boundaries</title>
  <style type="text/css">
    body > p::before { content: "</style><script>not really a tag</script>"; }
    @media screen and (min-width: 2px) { .x { color: rgb(1,2,3); } }
  </style>
  <script type="application/javascript">
    if (a < b && c > d) {
      document.write("<div data-x='&amp;'>raw</div>");
      // </script> appears in a JavaScript comment
    }
  </script>
</head>
<body>
  <noscript>
    <p>noscript branch <img src="x" alt="&copy;">
  </noscript>
  <template id="card">
    <article itemscope itemtype="https://example.invalid/Thing">
      <h2 itemprop="name">Template <span>content</span></h2>
      <meta itemprop="version" content="1">
      <slot name="missing"></slot>
    </article>
  </template>
  <p>Outside <code>&lt;tag&gt;</code> <kbd>Ctrl</kbd><var>x</var>
  <script type="text/plain">literal <b>markup</b> &amp; text</script>
</body>
</html>