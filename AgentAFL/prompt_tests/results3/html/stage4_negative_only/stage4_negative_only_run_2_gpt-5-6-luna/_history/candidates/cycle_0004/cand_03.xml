<!doctype html>
<html>
<head><title>Interactive controls</title></head>
<body>
<form id=f action=//example.invalid/post method=dialog enctype=multipart/form-data>
  <fieldset disabled>
    <legend>Account <button type=button autofocus>Help</button></legend>
    <label for=u>User</label><input id=u name=user required pattern="[A-Z]+">
    <label>Password<input type=password name=p minlength=2 maxlength=1></label>
  </fieldset>
  <input type=hidden name=token value="a&amp;b">
  <output name=result for="u p">unknown</output>
  <meter min=10 max=0 low=2 high=8 optimum=4 value=5>5</meter>
  <progress max=-1 value=2>progress</progress>
  <select multiple size=0>
    <option value=a>alpha</option>
    <option label="b &amp; c" selected>beta</option>
  </select>
  <textarea name=notes rows=2 cols=3 wrap=hard>line one
line two</textarea>
  <button type=submit formaction=/go formmethod=get>Send</button>
</form>
<form><input name=outside form=f><button>orphan</button></form>
</body>
</html>