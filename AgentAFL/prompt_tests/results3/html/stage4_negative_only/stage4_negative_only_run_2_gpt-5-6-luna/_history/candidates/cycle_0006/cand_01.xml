<!doctype html>
<html>
<head>
  <title>Interactive controls</title>
</head>
<body>
  <form action="/submit?x=1&amp;y=2" method="dialog" enctype="multipart/form-data">
    <fieldset disabled>
      <legend><button type="button" autofocus>Choose <em>one</em></button></legend>
      <label for="q">Query</label>
      <input id="q" name="q" type="search" list="suggestions" required pattern="[A-Z]{2,}">
      <datalist id="suggestions">
        <option value="ALPHA" label="first">
        <option value="beta">
      </datalist>
      <select name="mode" multiple size="0">
        <optgroup label="Primary">
          <option selected value="a">A
          <option value="b"><!-- unclosed option
        </optgroup>
        <option value="c">C</option>
      </select>
      <textarea name="notes" rows="2" cols="4">one &amp; two</textarea>
      <output name="result" for="q mode">pending</output>
      <progress max="10" value="15">75%</progress>
      <meter min="10" low="20" optimum="50" high="40" max="30" value="x">x</meter>
    </fieldset>
    <input type="image" srcset="a 1w, b 2x" alt="">
    <button type="submit" formaction="/alternate">Send</button>
  </form>
</body>
</html>