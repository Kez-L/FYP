<!DOCTYPE HTML PUBLIC "-//W3C//DTD HTML 4.01 Frameset//EN">
<html>
<head>
  <meta http-equiv="Content-Type" content="text/html; charset=windows-1252">
  <?xml version="1.0"?>
  <!--[if IE 5]>legacy<![endif]-->
  <title>Frameset stress</title>
</head>
<frameset rows="*,120" cols="25%,*">
  <frame src="left frame.html" name="nav" scrolling="no" noresize="noresize">
  <frameset cols="50%,50%">
    <frame src="http://example.invalid/a?x=1&amp;y=2" target="main">
    <frame srcdoc="<html><body><p>nested</p></body></html>" name="right">
  </frameset>
  <noframes>
    <body bgcolor=#fff text='black' onload="x<y && a>0">
      <h1>Fallback</h1>
      <p>Frames are unavailable.
      <form method=post action=/search?x=1&y=2>
        <input type=text name=q value="a>b" disabled>
        <input type=submit value="Go">
      </form>
    </body>
  </noframes>
</frameset>
</html>