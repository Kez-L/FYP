<!DOCTYPE html>
<html>
<head>
  <title>Interactive nesting</title>
</head>
<body>
  <main>
    <details open>
      <summary><em>Choose a section</em></summary>
      <details>
        <summary>Nested summary <span title="unterminated>label</span></summary>
        <p>Hidden text <mark>marked <small>small</small></mark>
      </details>
      <dialog open>
        <form method="dialog">
          <fieldset disabled>
            <legend>Dialog controls</legend>
            <label for="q">Query</label>
            <input id="q" name="q" list="words" required>
            <datalist id="words"><option value="alpha"><option value="beta"></datalist>
            <output for="q">result</output>
          </fieldset>
          <button value="ok">OK</button>
        </form>
      </dialog>
    </details>
    <menu type="toolbar">
      <li><button type="button">A</button>
      <li><button type="button">B
        <menu><li>subitem</li></menu>
      </li>
    </menu>
  </main>
</body>
</html>