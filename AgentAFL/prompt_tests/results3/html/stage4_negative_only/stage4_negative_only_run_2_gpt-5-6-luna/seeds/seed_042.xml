<!doctype html>
<html>
<head>
  <title>Frameset oddities</title>
  <meta charset="x-invalid">
</head>
<frameset rows="*,0,auto" cols="25%,*,bad" frameborder="maybe">
  <frame src="a.html" name=one scrolling=bogus noresize>
  <frameset cols="*">
    <frame srcdoc="<p>embedded & broken" frameborder=0>
    <frame src="javascript:alert(1)" marginwidth=-1 marginheight=999999>
  </frameset>
  <noframes>
    <body>
      <h2>No frames</h2>
      <object data="movie.bin" type="application/octet-stream" width=0 height=-5>
        <param name="x" value="&quot;bad">
        <embed src="x.swf" pluginspage="none" width="NaN"></embed>
        fallback text
      </object>
      <applet code="A.class" archive="a.jar,b.jar" width=1 height=1>
        <param name=x>
        applet fallback
      </applet>
    </body>
  </noframes>
</frameset>
<frameset>
  <frame>
</html>