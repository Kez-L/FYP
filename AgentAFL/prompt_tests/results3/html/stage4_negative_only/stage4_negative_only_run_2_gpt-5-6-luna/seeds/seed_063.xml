<!DOCTYPE html>
<html>
<head>
  <title>Embedded content and obsolete elements</title>
</head>
<body bgcolor="#gggggg" text="red">
  <center>
    <font size="999" color="#12">legacy <big>large <small>small</font></big></small>
  </center>
  <marquee behavior=alternate direction=sideways scrollamount="-1">moving</marquee>
  <frameset rows="*,0,*">
    <frame src="one.html" name=one>
    <frame src="two.html">
    <noframes>
      <body>
        <p>fallback body <img src="x" width="-20" height="999999999999">
        <map name=m><area shape=polygon coords="1,2,three,4"></map>
      </body>
    </noframes>
  </frameset>
  <object data="file:///tmp/x" width="bad" height="-1">
    <param name=movie>
    fallback <embed src="" hidden="false">
  </object>
  <video controls autoplay="no" poster=x>
    <source src=a type=video/unknown>
    <track kind=subtitles src=vtt>
    fallback video
  </video>
  <audio src=a><source src=b></audio>
</body>
</html>