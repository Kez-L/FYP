<!DOCTYPE html>
<html>
<head><title>Interactive nesting</title></head>
<body>
<main>
<details open="false"><summary><button type="submit"><span>Open</summary>
<form action="?" method="dialog" enctype="multipart/form-data">
<fieldset disabled><legend><label for=q>Query</legend>
<input id=q type=text value="a&quot; b&#10;c" required autofocus>
<select name=choice multiple size=0>
<option selected>one
<option disabled value="&amp;">two
<optgroup label="broken"><option>three</select>
<output for="q">result</output>
</fieldset>
<fieldset>
<label><input type=checkbox checked=checked> check
<textarea name=notes cols="999999999999999999999" rows="-2">raw &lt;/textarea&gt;
</textarea>
</fieldset>
<menu type=context><li><button formaction="/x">X</button><li><button type=reset>R</menu>
<progress max="0" value="-5">100%</progress>
<meter min="10" max="2" low="NaN" high="-Infinity" optimum="x" value="7">meter</meter>
</form>
</button></details>
<dialog open><p>dialog text<form><input name=a></form></dialog>
</main>
</body>
</html>