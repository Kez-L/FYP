<!doctype html>
<html>
<head><title>List and definition recovery</title></head>
<body>
  <ol start="not-a-number" reversed="false">
    <li>first
    <li value="-999999999999999999999">second
      <ul type="square">
        <li>nested one
        <li>nested two
    <dt>misplaced term
    <dd>definition without a list
    <li>third
  </ol>
  <dl compact>
    <dt><em>term
    <dd><p>definition one
    <dt><input type=text name=term value="x y">
    <dd><div>definition two</div></dd>
  </dl>
  <menu>
    <li><a href="javascript:alert('x')">link
    <li><button type=submit disabled=false>button</button>
  </menu>
  <p>tail
</body>
</html>