<!doctype HTML PUBLIC "-//W3C//DTD HTML 4.01//EN" "http://www.w3.org/TR/html4/strict.dtd">
<html>
<head>
  <title>Frames and controls</title>
  <base target=_blank>
</head>
<frameset rows="*,0,*" cols="50%,50%">
  <frame src="a.html" name=left scrolling=yes noresize>
  <frame src="b.html" frameborder=bogus>
  <frameset>
    <frame>
    <noframes>
      <body>
        <form action="/submit" method=post enctype="multipart/form-data">
          <fieldset disabled>
            <legend>Account <input name=legend>
            <label for=x>User <input id=x name=user required></label>
            <label>Password <input type=password name=pwd minlength=999 maxlength=-1></label>
          </fieldset>
          <select name=choice multiple size="not-number">
            <optgroup label="A" disabled><option selected>one<option>two</optgroup>
            <option value="&bad">three
          </select>
          <textarea name=notes rows=-4 cols=zero wrap=hard>start
          <button type=maybe formaction="/x">send</button>
          <input type=image src=missing alt="submit">
          <input type=file accept="image/*,," multiple>
        </form>
        <isindex prompt="Search:">
        <details open="false"><summary>summary</summary>content</details>
      </body>
    </noframes>
  </frameset>
</frameset>
</html>