<!doctype html>
<html>
<head><title>Shadow and template fragments</title></head>
<body>
<template id=t1><div><slot name=x>fallback</slot><template><p>nested</p></template></div></template>
<template shadowrootmode="open" shadowrootdelegatesfocus>
<style>:host([data-x])::part(a){--v:"</style>";}</style>
<slot></slot><div part="a b" contenteditable="plaintext-only">shadow</div>
</template>
<div id=host data-x="&quot;" is="unknown-element">
<template><table><tr><td>template cell</template>
</div>
<article>
<picture>
<source media="(orientation: sideways)" srcset="a 1x, b 0w, c 999999999999999999999w">
<source type="image/avif" srcset="">
<img srcset="x, y 2x" sizes="calc(100% - )" loading="lazy">
</picture>
<video controls autoplay muted preload="wat" poster="x"><track kind=subtitles default srclang=en label=English src="x.vtt"><source src="a" type="video/mp4"><source src="b"></video>
<audio><source src="x"><track></audio>
<map name=m><area shape=poly coords="0,0,NaN,999999999999" href="#x"></map>
<img usemap="#m" src="x">
</article>
</body>
</html>