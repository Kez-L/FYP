<!DOCTYPE HTML>
<html>
<head><title>Lists and inline boundaries</title></head>
<body>
<ol start="not-a-number" reversed>
<li>alpha
<li value="0">beta
<ul type="square"><li>nested one
<li><ul><li>deep</ul>
</ol>
<menu><li>menu a<li>menu b</menu>
<dl compact><dt><b>term <dd><p>description
<dt>another<dd><div>block <span>inline <u>under <small>small</div>
<p><b><i><em><strong>cascade</b> after</i></em></strong>
<ruby>漢<rt>kan<rp>(</rp><rtc>annotation</rtc></ruby>
<p><q cite=x>quote <cite>cite <dfn>define</p>
<marquee direction=sideways><blink>legacy</blink></marquee>
<center><font face="x" size=999 color="notacolor">old text</font></center>
</body>
</html>