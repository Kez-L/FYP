<!doctype html>
<html>
<head>
  <title>form controls</title>
  <link rel=stylesheet href=data:text/css,body%7Bcolor:red%7D disabled>
</head>
<body>
  <form id=f1>
    <fieldset disabled><legend>account</legend>
      <label for=u>User <input id=u type=email multiple required pattern="[">
      <label>Password <input type=password autocomplete=off minlength=-1 maxlength=999999999999>
    </fieldset>
    <input type=number min=Infinity max=-Infinity step=0 value=1e309>
    <input type=date value=2024-99-99>
    <input type=file accept="image/*,.bad," multiple>
    <input type=image src alt>
    <textarea name=note rows=-4 cols=NaN wrap=sideways>line 1
      <b>line 2</b>&lt;raw
    <select name=choice>
      <option value=a> A
      <option selected disabled value=b>B
      orphan text
      <optgroup label="x"><option>C
    </select>
    <button formaction="/x" formmethod=invalid>go</button>
  </form>
  <form id=f2 action="/submit">
    <input name=outside form=f1 value="associated">
  </form>
  <div contenteditable spellcheck=mystery tabindex="999999999999999999">
    <p draggable=maybe>editable <br><wbr><img src alt=broken width=-2 height=Infinity>
  </div>
  <object data="x" type="application/octet-stream">
    <param name=name value=value>
    fallback <embed src=x type=bad>
  </object>
</body>
</html>