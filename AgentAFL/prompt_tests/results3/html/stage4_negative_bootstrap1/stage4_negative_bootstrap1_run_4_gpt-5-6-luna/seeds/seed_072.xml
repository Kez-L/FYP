<!doctype html>
<html>
<head><title>phrasing and ruby</title></head>
<body>
  <ul compact>
    <li value="0">alpha
    <li>beta
      <ol start="-2" reversed>
        <li>nested one
        <li>nested two
      </ol>
    <li>gamma
  </ul>
  <dl>
    <dt><abbr title="&notanentity;">term
    <dd><ruby>漢<rt>kan<rp>(</rp><rt>bad</ruby>
    <dt><samp>definition
    <dd><ins cite=foo datetime=2024-13-99>inserted <del>deleted</ins>
  </dl>
  <p><a href="x"><span><mark>marked <small>small</a> after
  <p><bdi dir=auto>isolate <bdo dir=sideways>override</bdi>
  <time datetime="not-a-time">yesterday</time>
  <meter min=10 max=5 low=nan high=Infinity optimum=-1 value=999>meter</meter>
  <progress max="0" value="-4">progress
  <details open="0"><summary>summary</summary><p>details body
  <dialog open>dialog <output for="a b">result
</body>
</html>