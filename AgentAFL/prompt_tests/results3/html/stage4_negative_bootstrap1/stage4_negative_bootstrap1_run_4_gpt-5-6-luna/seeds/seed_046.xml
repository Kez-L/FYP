<!DOCTYPE html>
<html>
<head>
  <title>Forms and controls</title>
</head>
<body>
  <form action="/submit" method="POST" enctype="multipart/form-data">
    <fieldset disabled>
      <legend><label for="q">Search <input id="q" name="q" value="a&quot;b"></label></legend>
      <input type=text name=q required readonly>
      <select name=pick multiple size=999>
        <option selected>one<option disabled value='two>two
        <optgroup label="group"><option>three</optgroup>
      </select>
      <textarea name=note rows=0 cols=-4>first
second
</textarea>
      <button type=submit formaction="::::">Send</button>
    </fieldset>
    <input type="image" src="" alt=broken
    <output name=result for="q"></output>
    <object data="data:text/plain,hello" type="x/x">
      <param name=name value=value>
      fallback <embed src=//invalid.example/a>
    </object>
  </form>
  <label><input type=checkbox checked=maybe> dangling label</label>
</body>
</html>