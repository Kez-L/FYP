<!DOCTYPE html>
<html>
<head>
  <title>Foreign content</title>
</head>
<body>
  <svg width="120" height="80" viewBox="0 0 120 80" xmlns="http://www.w3.org/2000/svg">
    <defs>
      <linearGradient id="g" x1="0" x2="1">
        <stop offset="0%"/><stop offset="100%"/>
      </linearGradient>
      <clipPath id="clip"><rect x="0" y="0" width="60" height="60"/></clipPath>
    </defs>
    <g transform="translate(2 3)" onclick="alert('x')">
      <rect width="80" height="40" fill="url(#g)"/>
      <text x="4" y="20">A &amp; B</text>
      <foreignObject x="1" y="1" width="40" height="20">
        <div xmlns="http://www.w3.org/1999/xhtml"><b>inside</b></div>
      </foreignObject>
    </g>
  </svg>
  <math xmlns="http://www.w3.org/1998/Math/MathML">
    <mrow><mi>x</mi><mo>&InvisibleTimes;</mo><msup><mi>y</mi><mn>2</mn></msup></mrow>
  </math>
  <p>Trailing text</p>
</body>
</html>