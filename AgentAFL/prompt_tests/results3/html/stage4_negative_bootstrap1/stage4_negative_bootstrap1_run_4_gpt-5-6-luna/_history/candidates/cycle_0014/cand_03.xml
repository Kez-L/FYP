<!doctype html>
<details open="false" name="group">
  <summary>toggle <span>label</details>
<dialog open>
  <form method=dialog>
    <fieldset disabled>
      <legend><button type=submit>submit</legend>
      <input required pattern="[a-" value="&notanentity">
      <output for=a>b</output>
    </fieldset>
  </form>
</dialog>
<menu type=context>
  <li><button command="--x" commandfor="missing">One
  <li><input type=image srcset="a 1x, b 2x, c">
</menu>
<template shadowrootmode="open"><slot name=x></slot><p>template</p></template>