    <input id=a type=text value="unterminated" maxlength="-1" minlength="999999999999" pattern="[">
    <textarea name=t rows=-4 cols=NaN wrap=sideways>one
two</textarea>
  </fieldset>
  <fieldset><legend>controls</legend>
    <label><input type=radio name=r checked>first</label>
    <label><input type=radio name=r checked=false>second</label>
    <button type=unknown formnovalidate formaction>Go</button>
    <output for="a b c">result</output>
    <progress value="Infinity" max="-0">%</progress>
    <meter min=10 max=2 low=NaN high=-1 optimum=999 value=abc>x</meter>
  </fieldset>
</form>
