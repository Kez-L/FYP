<!doctype html>
<html>
<head><title>obsolete controls</title></head>
<body>
  <form id=f1 action="" method="dialog" enctype="x/x">
    <fieldset disabled>
      <legend><label for=q>Choose <input id=q name=q></label></legend>
      <input type=checkbox checked checked="false" name=a>
      <input type=radio name=r value=1>
      <input type=radio name=r value=2 selected>
      <select multiple size=0>
        <option value=a selected>Alpha
        <option value=b disabled>Beta
        <optgroup label="Group"><option>Gamma</optgroup>
      </select>
      <button type=reset formaction=/reset formmethod=get>reset</button>
    </fieldset>
  </form>
  <form id=f2>
    <input form=f1 name=outside value="&quot;quoted">
  </form>
  <label><input type=text><label>duplicate label</label></label>
  <object data="movie.bin" type="application/octet-stream">
    <param name=movie value="x">
    <embed src="plugin.dat" width=0 height=-1>
    fallback <iframe srcdoc="<p>inside &amp; broken" name=frame></iframe>
  </object>
</body>
</html>