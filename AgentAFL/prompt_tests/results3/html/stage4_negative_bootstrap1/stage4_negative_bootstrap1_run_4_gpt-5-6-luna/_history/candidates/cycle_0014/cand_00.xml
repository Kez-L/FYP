<frameset cols="25%,*,0">
  <frame src="about:blank" name="left">
  <frameset rows="*,40">
    <frame srcdoc="<p>embedded &amp; broken</p>" scrolling="no">
    <frame src="javascript:parent.document.body.innerHTML='x'">
  </frameset>
  <noframes>
    <body>
      <h1>Frames fallback
      <p><a href="http://[::1">unterminated link
      <img src=x onerror=alert(1) alt="a>b">
    </body>
  </noframes>
</frameset>
</html>