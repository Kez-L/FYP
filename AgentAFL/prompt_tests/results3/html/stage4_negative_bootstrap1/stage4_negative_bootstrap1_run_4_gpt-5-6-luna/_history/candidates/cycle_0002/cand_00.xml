<!DOCTYPE html>
<html>
<head>
  <meta http-equiv="refresh" content="0;url=/next">
  <meta name="viewport" content="width=device-width">
  <link rel="alternate" media="print" href="/print.css">
  <title>Plain title</title>
</head>
<body>
  <form action="/submit" method="post" enctype="multipart/form-data">
    <fieldset disabled>
      <legend>Account</legend>
      <label for="user">User</label>
      <input id="user" name="user" type="text" value="&quot;quoted&quot;">
      <label>Choice
        <select name="choice" multiple size="0">
          <optgroup label="One">
            <option selected>Alpha
            <option value="b">Beta</option>
          </optgroup>
          <option>Gamma</select>
      <textarea name="note" rows="2" cols="0">text &amp; more</textarea>
      <button type="submit"><img src="/button.png" alt="send"></button>
    </fieldset>
  </form>
  <details open="false">
    <summary>Summary</summary>
    <meter min="10" max="2" value="999">meter</meter>
    <progress value="-1" max="0">progress</progress>
  </details>
</body>
</html>