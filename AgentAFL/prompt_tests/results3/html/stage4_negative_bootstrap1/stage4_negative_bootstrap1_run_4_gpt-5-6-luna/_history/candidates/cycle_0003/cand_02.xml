<html>
  <head>
    <title>Frameset branch</title>
    <meta http-equiv=content-type content="text/html; charset=UTF-16">
  </head>
  <frameset rows="*,0,auto" cols="50%,*">
    <frame src="a.html" name="left" scrolling="maybe" frameborder="-1">
    <frameset>
      <frame src="" name="right">
      <noframes>
        <body>
          <h1>No frames</h1>
          <iframe srcdoc="<p>nested <b>document</p>" sandbox="allow-scripts allow-forms"></iframe>
          <object data="data:text/html,<h1>x</h1>" type="text/html">
            <param name="movie" value="x">
            fallback
          </object>
        </body>
      </noframes>
    </frameset>
  </frameset>
  <body>
    <p>Body after frameset</p>
  </body>
</html>