<!doctype html>
<html lang="x-klingon" dir="rtl">
<head>
  <meta charset="windows-1252">
  <title>table recovery &amp; entities</title>
</head>
<body>
  <table border="1">
    <caption><em>unclosed caption
    <colgroup span="2"><col width="*"><col width="0">
    <thead><tr><th rowspan="2">A<th>B
    <tbody>
      <tr><td>one<td>two
      <tr><td colspan="3"><p>cell paragraph
        <table><tr><td>nested table</table>
        text after nested table
      <tr><td><input name=x value="&quot; &#0; &#xD800;">
    <tfoot><tr><td>footer
  </table>
  <p>after table <select multiple size="0"><option selected>first<option>second
  <optgroup label="group"><option value="&amp;">third</optgroup></select>
</body>
</html>