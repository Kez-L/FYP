<!DOCTYPE html>
<html>
<head>
  <title>embedded raw text</title>
  <style>
    .a:before { content: "</style><script>alert(1)</script>"; }
    @media screen { div { width: calc(100% - 1px); } }
  </style>
</head>
<body>
  <template id="t"><div><p>template <b>markup</b></div></template>
  <script type="text/plain">
    <div>not markup</div>
    &amp; <!-- comment-looking -->
  </script>
  <textarea rows=2 cols=4>one
two <b>three</b> &amp; &#65;</textarea>
  <xmp><p>literal</p></xmp>
  <listing>line &lt;tag&gt;
  <plaintext><h1>everything after here
  <div class="after-plaintext">unparsed?</div>
</body>
</html>