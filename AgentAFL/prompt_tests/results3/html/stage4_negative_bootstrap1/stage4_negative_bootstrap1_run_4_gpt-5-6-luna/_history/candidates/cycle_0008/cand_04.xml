<!doctype html>
<html>
<head>
  <base target="_blank">
  <title>media and metadata</title>
</head>
<body>
  <picture>
    <source srcset="a.webp 1x, b.webp 2x" type="image/webp" media="(min-width: 0px)">
    <source srcset="broken 3x, , c.png" sizes="calc(100% - 1px)">
    <img src="fallback" srcset="x 100w y -2w" width="1e2" height="0" alt="&notanentity;">
  </picture>
  <video controls autoplay muted preload="invalid" poster="">
    <track kind="subtitles" src="captions.vtt" srclang="xx" default>
    <source src="movie.mp4" type="video/mp4; codecs=&quot;">
    fallback <a href="">watch</a>
  </video>
  <audio loop><source src="sound" type=""><track></audio>
  <map name="m"><area shape="rect" coords="0,0,10" href="#one"><area nohref></map>
  <object data="data:text/html,<p>x" type="application/x-unknown">
    <param name="x" value="&quot;">
    <embed src="" width="-1" height="NaN">
  </object>
</body>
</html>