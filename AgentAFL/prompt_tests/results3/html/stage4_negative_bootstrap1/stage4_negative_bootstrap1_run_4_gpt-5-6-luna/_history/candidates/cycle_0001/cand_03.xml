<!DOCTYPE html>
<html>
<head><title>forms</title></head>
<body>
  <form method="POST" action="/submit" enctype="multipart/form-data">
    <fieldset>
      <legend>Inputs</legend>
      <label for=x>Name
      <input id=x name=user value="a
      <input type=number min=10 max=2 step=0 value=NaN>
      <select name=choice multiple size="-1">
        <option value=one selected>One
        <optgroup label="Group"><option>Two</optgroup>
        <option>Three
      </select>
      <textarea rows=0 cols=abc wrap=soft>text
    </fieldset>
    <button type=submit formaction=/a>Send
    <button type=reset disabled>Reset</button>
  </form>
  <form><input name=x><form><input name=y></form>
  <menu>
    <li value=0>zero
    <li><input type=checkbox checked=maybe>
  </menu>
</body>
</html>