<!doctype html>
<html>
<head>
  <title>Table mutation</title>
  <meta charset="utf-8">
</head>
<body>
  <table border="1">
    <caption><b>caption <i>with crossed tags</caption>
    <colgroup span="2"><col width="*"><colgroup><col>
    <thead>
      <tr><th rowspan="0">A<td>B<td colspan="-1">C
    <tbody>
      <tr><td><p>cell one<tr><td>cell two</p>
      <tr><td><table><tr><td>nested<td><tfoot><tr><td>end
    <tfoot>
      <tr><td>footer</table>
  </table>
  <div><table><tbody><tr><td>x</div></tbody></table>
</body>
</html>