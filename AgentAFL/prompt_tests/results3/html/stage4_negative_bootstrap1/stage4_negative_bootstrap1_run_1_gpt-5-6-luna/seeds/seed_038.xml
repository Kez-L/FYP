<!DOCTYPE html>
<html>
<head><title>misnested inline and obsolete elements</title></head>
<body>
<center><font face="&quot;A" size="999" color="#GGGGGG">
<b><i><u><s>one
</b>two</i>three</u>four</s>
<big><small><tt><strike>text</strike></tt></small></big>
</font></center>
<marquee behavior="sideways" direction="diagonal" loop="-1">
<nobr>long <blink>blink <spacer type="block" width="-5" height="NaN">
</nobr></marquee>
<isindex prompt="Search &amp; find:"><basefont size="0">
<acronym title="a>b">label</acronym>
<q cite="urn:foo?x=1&y=2"><cite>nested cite</q></cite>
<address><a href="#x"><em>contact</address></em></a>
<layer visibility="maybe"><div>layer content</div></layer>
</body>
</html>