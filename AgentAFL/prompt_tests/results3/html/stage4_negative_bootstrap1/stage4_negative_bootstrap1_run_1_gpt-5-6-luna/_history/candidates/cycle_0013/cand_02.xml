<!DOCTYPE html>
<html>
<head><title>Tables and selectable controls</title></head>
<body>
<header role=banner><nav aria-label="Main"><a href=#one>one</a> | <a href=#two>two</a></nav></header>
<main>
<section id=one>
<h2>Form controls</h2>
<form id=f action="/x?y=1&amp;z=2" method=get>
<fieldset disabled>
<legend>Choose &amp; continue</legend>
<label for=q>Query</label><input id=q name=q value='a&b<c' autofocus>
<select name=pick multiple size=3>
<optgroup label="First"><option selected value=1>one<option value=2>two</optgroup>
<option label="third" value=3>three
</select>
<textarea name=notes rows=2 cols=8 wrap=hard>line 1
line 2 &amp; line 3</textarea>
<output name=result for="q pick">uncomputed</output>
</fieldset>
<datalist id=choices><option value=alpha><option value=beta></datalist>
<input list=choices type=search>
</form>
</section>
<section id=two>
<table>
<thead><tr><th scope=col>A<th scope=col>B</thead>
<tbody><tr><td>A1<td>B1
<tr><td rowspan=3>A2<td>B2</tbody>
<tfoot><tr><td colspan=2>Total</tfoot>
</table>
<details open><summary>Summary <mark>text</mark></summary><p>details body</p></details>
</section>
</main>
<footer><small>End</small></footer>
</body>
</html>