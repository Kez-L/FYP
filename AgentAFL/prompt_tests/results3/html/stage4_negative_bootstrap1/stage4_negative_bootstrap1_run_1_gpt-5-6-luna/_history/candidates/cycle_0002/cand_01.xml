<!DOCTYPE html>
<html>
<head><title>Form controls</title></head>
<body>
<form action="?" method="get" enctype="multipart/form-data">
<fieldset disabled><legend><output name=o>Result</output></legend>
<label><input type=number min=1 max=0 step=0 value="1e999" name=n></label>
<label><input type=date value="2024-99-99"><input type=color value="#12"></label>
<select name=pick size=0>
<optgroup label="one"><option>first<option selected value="&amp;">second</optgroup>
<option label="orphan" disabled>third
</select>
<textarea name=t wrap=hard maxlength="-2">start</textarea>
<button type=submit formaction="javascript:x">go</button>
</fieldset>
<fieldset><legend>More</legend>
<input type=file accept="image/*,,text/plain" multiple>
<input type=range min="10" max="-10" value="">
<input type=checkbox checked="false">
<datalist id=dl><option value=a><option value=b></datalist>
<input list=dl>
<output for="x y">a <meter min=5 max=2 low=9 high=-1 value=3>m</meter></output>
</fieldset>
</form>
<menu><li><button popovertarget=p>open</button></li><li>item</li></menu>
<div id=p popover="manual"><template shadowrootmode="open"><slot name=x></slot></template></div>
</body>
</html>