<!DOCTYPE html>
<html>
<head>
<title>svg and foreign content</title>
</head>
<body>
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 10 10" width="10px" height="10em">
<defs><linearGradient id="g"><stop offset="0%"/><stop offset="Infinity" stop-color="rgba(0,0,0,2)"/></linearGradient></defs>
<g transform="translate(1 2) rotate(nan)">
<path d="M0 0 L10 10 Q 4 5 8 3 Z" fill="url(#g)" onload="x<y && z>q"/>
<text x="1" y="2"><tspan dx="1,2">A &amp; B</tspan></text>
<foreignObject x="0" y="0"><div xmlns="http://www.w3.org/1999/xhtml"><b>embedded</b><br/>text</div></foreignObject>
</g>
</svg>
<svg><use href="#missing" xlink:href="javascript:alert(1)"></use><circle cx="1e999" cy="-" r="-0"/></svg>
</body>
</html>