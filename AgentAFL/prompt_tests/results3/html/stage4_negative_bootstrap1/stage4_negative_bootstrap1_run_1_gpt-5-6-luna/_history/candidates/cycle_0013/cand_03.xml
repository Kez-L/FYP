<!doctype html>
<html>
<head>
<meta charset="utf-8">
<title>Embedded legacy media</title>
</head>
<body>
<map name=planet><area shape=rect coords="0,0,10,10" href="#north"><area shape=circle coords="20,20,5" nohref></map>
<picture>
<source media="(min-width: 800px)" srcset="wide-1x.png 1x, wide-2x.png 2x" type=image/png>
<source srcset="small.png">
<img src="fallback&amp;broken.png" srcset="a.png 400w, b.png 800w" sizes="50vw" usemap="#planet" alt="A &lt;picture&gt;">
</picture>
<figure>
<figcaption>Media with odd dimensions</figcaption>
<video controls autoplay muted loop width="0" height="-1" poster="p.jpg">
<source src="movie.mp4" type="video/mp4">
<source src="movie.ogg" type="video/ogg; codecs=&quot;theora&quot;">
<a href="movie.mp4">download</a>
</video>
<audio preload=auto controls><source src="sound.wav" type=audio/wav></audio>
</figure>
<embed src="plugin.bin" type="application/x-test" width=nan height=1e999>
<iframe name=old frameborder=0 scrolling=no src="about:blank">fallback <b>content</b></iframe>
<object classid="clsid:00000000-0000-0000-0000-000000000000" width=10 height=10>
<param name=movie value="a&amp;b">
<param name=autoplay value=true>
fallback object <img src=x alt="">
</object>
<marquee behavior=alternate direction=sideways scrollamount=-4>moving &copy;</marquee>
</body>
</html>