<!DOCTYPE html>
<html>
<head><title>forms and controls</title></head>
<body>
<form action="/submit?x=1&y=2" method="GET" enctype="multipart/form-data" accept-charset="utf-8, utf-16" novalidate="false">
<fieldset disabled="no"><legend><label for=q>Search</label></legend>
<input id=q name=q type="search" value="a&quot;b" pattern="["><input name=q type=number min=abc max=1e400 step=0>
</fieldset>
<label><input type=checkbox checked="false" required=maybe>agree</label>
<select name=choice multiple size="-1">
<option selected="0" value=>empty</option><option value="&amp;bad">A<option>B</select>
<datalist id=choices><option label="x" value="1"><option value="2"></datalist>
<textarea name=note rows="999999999999" cols="-4" wrap=side>raw &amp; text
</textarea>
<button type="submit" formaction="http://%" formmethod="INVALID">send</button>
<output for="q missing">result</output>
</form>
<form><input type="text"><form><input type="hidden"></form></form>
</body>
</html>