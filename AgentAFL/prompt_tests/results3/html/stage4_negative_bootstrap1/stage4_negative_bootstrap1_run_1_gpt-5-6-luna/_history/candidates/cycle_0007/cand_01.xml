<body>
<table border="bogus" cellpadding="-999" cellspacing="1e309" width="100%" summary="&notanentity;">
  <caption align="middle"><b>Caption <i>crossed</caption>
  <colgroup span="nope"><col span="-1" width="*"><colgroup><col>
  <thead><tr><th rowspan="999" colspan="0" abbr="x">A<td headers="missing">B</tr></thead>
  <tbody>
    <tr><td>A1<td>A2<tr><th scope="rowgroup"><div>mixed<div>cell</tr>
    <tr><td><table><tr><td>nested</table><form><input></form></td><td>end
  </tbody>
  <tfoot><tr><td colspan="x">tail</table>
<p>after table
