<?xml version="1.0"?>
<!DOCTYPE html [
<!ENTITY local "expanded">
<!ELEMENT ignored ANY>
]>
<html xmlns="http://www.w3.org/1999/xhtml">
<head><title>mixed namespaces</title></head>
<body>
<section>
<article>
<h2>Namespace test</h2>
<svg><circle cx="1" cy="2"/><text>&local;</text></svg>
<div xmlns="">
<custom-widget data-x="1"><slot name="header">slot</slot></custom-widget>
</div>
<svg xmlns="http://www.w3.org/2000/svg"><g><rect width="0" height="-1"><animate attributeName="x" values="0;1;;3"/></rect></g></svg>
</article>
<aside>
<template><table><tr><td>template<table><tr><td>nested</template>
</aside>
</section>
</body>
</html>