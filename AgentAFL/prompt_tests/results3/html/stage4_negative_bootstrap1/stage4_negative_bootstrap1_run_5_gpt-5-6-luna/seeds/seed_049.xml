<!DOCTYPE HTML PUBLIC "-//W3C//DTD HTML 3.2 Final//EN">
<html>
<head>
  <title>frames and metadata</title>
  <meta http-equiv="refresh" content="0; url=next">
  <isindex prompt="Search:">
</head>
<frameset cols="20%,*,0" rows="*" frameborder="0">
  <frame src="left.html" name="left" noresize scrolling="no">
  <frame src="right.html" name="right">
  <noframes>
    <body>
      <h1>Fallback</h1>
      <p>This document uses frames.</p>
      <map name="m">
        <area shape="rect" coords="0,0,10,10" href="a">
        <area shape="circle" coords="5,5,3" href="b">
      </map>
      <img src="x" usemap="#m" ismap>
    </body>
  </noframes>
</frameset>
</html>