<!DOCTYPE HTML>
<html>
<head>
  <title>Table repair corpus</title>
  <meta charset="utf-8">
</head>
<body>
  <table border="1" cellpadding="0" cellspacing="0">
    <caption><b>Quarterly <i>totals</caption>
    <colgroup span="2"><col width="*"><col width="0"></colgroup>
    <colgroup><col><col><col></colgroup>
    <thead>
      <tr><th rowspan="2">Name<td colspan="3">Values
      <tr><th>one<th>two<th>three
    <tbody>
      <tr><td>A<td>1<td><em>2<tr><td>B<td><td>3<td>4
      <tr><td colspan="4">tail
    <tfoot><tr><td><table><tr><td>nested</table><td>after
  </table>
  <form action="/submit" method="post">
    <fieldset disabled>
      <legend>Options</legend>
      <label><input type="checkbox" checked name="a"> Alpha</label>
      <label><input type="radio" name="a" value="b"> Beta
      <select multiple size="0" name="pick"><option>one<option selected>two</select>
    </fieldset>
    <button type="submit"><span>send</button></span>
  </form>
</body>
</html>