<!doctype html>
<html>
<head><title>controls and objects</title></head>
<body>
<form action="submit" method="POST" enctype="multipart/form-data">
<fieldset disabled>
<legend>Account <input type="text" name="legend"></legend>
<label for="x">Name</label><input id="x" type="text" value="&quot;" required autofocus>
<label>Choice <select name="s" multiple size="0">
<option selected>one<option value="2" disabled>two
<optgroup label="Group"><option>three</optgroup>
</select></label>
<textarea name="t" rows="1" cols="0">&lt;textarea&gt;</textarea>
<input type="image" src="a" alt="A"><input type="file" accept="text/*,.x" multiple>
<button type="submit" formaction="other">Send</button>
</fieldset>
</form>
<object data="movie.bin" type="application/octet-stream" width="0" height="-1">
<param name="movie" value="x">
<embed src="fallback.swf" pluginspage="x">
<p>object fallback</p>
</object>
<details open><summary>summary</summary><dialog open>dialog text</dialog></details>
</body>
</html>