<!doctype html>
<html>
<head><title>Raw text and token edges</title></head>
<body>
  <textarea autofocus rows="0" cols="-1">&lt;/textarea&gt; <b>literal</b>
    <!-- not a comment -->
    &amp; &#65;
  </textarea>
  <textarea><textarea>nested-looking</textarea></textarea>
  <xmp><div>raw xmp &amp; </xmp><p>after xmp
  <plaintext><html><body><script>never-close</script>
  <div>&amp; everything is text
</body>
</html>