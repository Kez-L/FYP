<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <title>Foreign content boundaries</title>
</head>
<body>
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20">
    <title>svg title</title>
    <foreignObject width="10" height="10">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p>HTML in foreign content <svg><circle r="2"></svg> after</p>
      </div>
    </foreignObject>
    <g transform="translate(1 2)" unknown-attr="&bad;">
      <use href="#x"></use>
      <path d="M0 0 L 1 1 Z" />
    </g>
  </svg>
  <math display="block">
    <mrow><mi>x</mi><mo>&lt;</mo><mfrac><mn>1</mn><mn>2</mn></mfrac></mrow>
    <annotation-xml encoding="application/xhtml+xml">
      <div><span>annotation</span></div>
    </annotation-xml>
  </math>
  <p><svg><foreignObject><table><tr><td>mixed</td></tr></table></foreignObject></svg></p>
</body>
</html>