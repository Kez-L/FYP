<!doctype html>
<html>
<head><title>sectioning and obsolete edges</title></head>
<body>
  <header><h1>Root</h1><nav><ul><li>one<li>two</ul></nav></header>
  <main>
    <article>
      <h2>Article</h2>
      <section><h3>First<section><h4>Nested</h4>text</article>
      <aside>aside after article close</aside>
    </section>
    <figure><img src="" alt="a&amp;b" ismap><figcaption>caption
    <video controls poster="x.jpg"><source src="a.mp4" type="video/mp4"><track kind="captions"></video></figure>
    <p><marquee behavior="alternate"><blink>obsolete</blink></marquee>
    <center><font color=red size=+3>legacy <strike>text</strike></font></center>
    <hr><br><wbr>
  </main>
  <footer>
    <p>footer
    <object data="x" type="application/x-test"><param name="a" value="1"><embed src="y">fallback</object>
  </footer>
</body>
</html>