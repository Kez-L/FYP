<!DOCTYPE html>
<html>
<head>
  <title>Obsolete and interactive controls</title>
</head>
<body>
  <frameset cols="*,0" rows="1,2">
    <frame src="about:blank" name="a">
    <frame src="" name="b">
    <noframes><p>fallback</p></noframes>
  </frameset>
  <form id="f" method="post" enctype="multipart/form-data" accept-charset="x-invalid">
    <fieldset disabled>
      <legend><button type="button">legend button</button></legend>
      <input type="image" src="x" formaction="/x" formmethod="dialog">
      <meter min="10" max="2" low="NaN" high="-Infinity" value="999">meter</meter>
      <progress max="-1" value="1">progress</progress>
    </fieldset>
    <output name="o" for="a b">result</output>
    <object data="x" type="application/x-unknown">
      <param name="movie" value="&amp;">
      <embed src="y" hidden>
      fallback<object>nested</object>
    </object>
  </form>
</body>
</html>