<html>
<head><title>Mixed raw text boundaries</title></head>
<body>
  <script>
    const a = "</script>";
    const b = String.raw`<!-- <div> &amp; -->`;
    if (a.length) { /* text */ }
  </script>
  <script type="application/ld+json">
    {"name":"x","value":"</script><p>","items":[1,2,3]}
  </script>
  <style>
    @media screen { body::before { content: "<!--"; } }
  </style>
  <div data-x="&quot; &apos; &gt;" aria-label="a>b">
    <!-- comment -- --><!---->
    <![CDATA[not really cdata]]>
    <x-unknown><y-unknown>payload</y-unknown></x-unknown>
  </div>
