<!doctype html>
<html>
<head><title>Foreign namespaces</title></head>
<body>
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 60">
  <defs><linearGradient id="g"><stop offset="0%"/><stop offset="100%"/></linearGradient></defs>
  <g transform="translate(4 5)">
    <path d="M0,0 L20,10 Z" fill="url(#g)" stroke-width="2"/>
    <foreignObject x="0" y="10" width="80" height="30">
      <div xmlns="http://www.w3.org/1999/xhtml"><b>HTML in SVG</b></div>
    </foreignObject>
  </g>
</svg>
<math xmlns="http://www.w3.org/1998/Math/MathML">
  <mrow><mi>x</mi><mo>=</mo><mfrac><mn>1</mn><msup><mi>y</mi><mn>2</mn></msup></mfrac></mrow>
</math>
<p>after foreign content</p>
</body>
</html>