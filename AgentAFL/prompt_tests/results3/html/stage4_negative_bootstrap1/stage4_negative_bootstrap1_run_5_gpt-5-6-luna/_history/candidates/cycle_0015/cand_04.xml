<!DOCTYPE html>
<html>
<head><title>Template and obsolete mixtures</title></head>
<body>
  <template id="t"><table><tr><td>template <b>content</b></td></tr></table></template>
  <main>
    <header><nav><a href="#a">A<a href="#b">B</nav></header>
    <article>
      <section><h2>First<section><h3>Nested without closing</h2>
        <center><font face="serif" size="999" color="#ggg">legacy
          <dir><li>directory item</dir>
        </font></center>
      </section>
      <aside><blockquote cite="x"><q>quote <q>nested</blockquote></q></aside>
      <pre>  pre <code>code <kbd>kbd</pre></code>
      <x-custom a="1" a="2"><span>custom</x-custom>
      <div contenteditable="true" spellcheck="maybe" style="width: expression(alert(1))">
        <wbr><br><br></div>
    </article>
    <footer><address>name<br>mail@example.test</address></footer>
  </main>
  <template><p>unclosed template
</body>
</html>