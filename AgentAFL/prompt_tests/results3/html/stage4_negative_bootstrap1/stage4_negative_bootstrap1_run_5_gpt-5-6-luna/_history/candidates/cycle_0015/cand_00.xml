<body>
  <table border="1">
    <caption><b>Results<table><tr><td>nested caption</b></caption>
    <colgroup span="2"><col><col width="bad"></colgroup>
    <thead><tr><th rowspan="0">A<th colspan="-2">B<th>C</tr></thead>
    <tbody>
      <tr><td>one<td>two
      <tr><td colspan="99">three
      <div>stray block inside table</div>
      <tr><th><p>broken paragraph<td><ul><li>list<li>item</ul>
    </tbody>
    <tfoot><tr><td>footer<td><td>extra</tfoot>
  </table>
  <p>after<table><tr><td>second table</table>tail
</body>
