<!doctype html>
<html>
<head><base href="relative/path/"><title>Frameset fallback</title></head>
<frameset cols="25%,*,">
<frame src="left.html" name=left scrolling=no>
<frameset rows="40,*">
<frame src="top.html">
<frame src="bottom.html" noresize>
</frameset>
<noframes>
<body>
<hgroup><h1>Fallback</h1><h2>content</h2></hgroup>
<p>This text appears <a href="/x" target=_blank>without frames.
<address>contact@example.invalid</address>
</body>
</noframes>
</frameset>
</html>