<!doctype html>
<html>
<head><title>Forms and objects</title></head>
<body>
<form action="/a" method="GET" enctype="multipart/form-data">
<fieldset><legend><b>Account</b></legend>
<input type=text name=user value=alice>
<input type="checkbox" checked="false" name=c1>
<input type=radio name=r value=1><input type=radio name=r value=2 checked>
<select name=s>
<option value=a>A<option disabled>B
<optgroup label=broken><option>C</optgroup>
</select>
<button name=go value="1">submit</button>
</fieldset>
</form>
<form><input name=x><form><input name=y></form></form>
<object data="movie.bin" type="application/octet-stream">
<param name=autoplay value=true>
<embed src="x" width="0" height="-2">
<object><p>fallback</p></object>
</object>
<isindex prompt="Search:">
</body>
</html>