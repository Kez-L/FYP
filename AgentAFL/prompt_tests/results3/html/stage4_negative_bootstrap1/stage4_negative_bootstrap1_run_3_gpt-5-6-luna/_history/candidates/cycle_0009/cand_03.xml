<!DOCTYPE HTML>
<html>
<head><title>Frames and obsolete controls</title></head>
<body>
<frameset rows="10%,*,0" cols="50%,50%">
<frame src="a.html" name="left">
<frameset><frame src="b.html"><noframes><body>fallback</body></noframes></frameset>
</frameset>
<body>
<center><font face="x" size="7" color="#ggg">legacy</font></center>
<marquee behavior=alternate direction=sideways><blink>moving</blink></marquee>
<isindex prompt="Search:">
<map name=m><area shape=poly coords="0,0,10,10" href=x><area href=y></map>
<object data="x.bin" type="application/octet-stream">
<param name=p value=v><embed src="movie.swf" width="-1">
fallback<object><img src=x></object>
</object>
<hr noshade><wbr><br><br>
</body>
</html>