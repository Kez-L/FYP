<!doctype html>
<html>
<head><title>Optional end tags</title></head>
<body>
<ul><li>first<ul><li>nested one<li>nested two</ul><li>second
<ol start="0" reversed type="I"><li>alpha<li value=999>beta<li>gamma</ol>
<p>p one
<p>p two
<p><b><i><u>unbalanced formatting</b> still italic</u> plain</i>
<a href="#x"><span>link <em>with <strong>many</a> ends</strong></em></span>
<ruby>漢<rt>kan<rp>(<rt>??</rp></ruby>
<ins cite=x datetime=bad><del cite=y>changed</ins> text</del>
<table><tr><td>x</tr><tr><th>y</td></table>
<form action=/x><input type=text name=a><button>submit
<div contenteditable=true><p>editable <br>line
<iframe srcdoc="<p>inner &amp; text</p>" sandbox allowfullscreen></iframe>
<object data=x type=application/x-test><param name=p value=v><p>fallback</object>
<video autoplay controls poster=x><source src=a type=video/x-test><track kind=subtitles src=v.vtt><p>video fallback
<audio loop><source src=s></audio>
