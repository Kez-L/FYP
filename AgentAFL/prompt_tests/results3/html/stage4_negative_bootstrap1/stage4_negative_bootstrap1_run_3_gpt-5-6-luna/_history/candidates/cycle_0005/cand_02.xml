<!doctype html>
<html>
<head><title>Metadata and embedded text</title></head>
<body>
  <header id=top><hgroup><h1>Heading <small>minor</h1><h2>Second</h2></hgroup></header>
  <main>
    <article>
      <section><h3>First</h3><p>alpha
      <section><h4>Second <mark>highlight</section>
      <aside><p>side <time datetime=2024-02-30>date</time></aside>
    </article>
    <details open="false"><summary>More</summary><p>hidden-ish content</details>
    <dialog open><form method=dialog><p>Choose:</p><button value=yes>Yes</button></form></dialog>
    <figure><img src=missing alt="image"><figcaption>caption</figcaption></figure>
    <audio controls preload=auto><source src=a.ogg type=audio/ogg><source src=b.mp3><track kind=subtitles srclang=en label=English></audio>
    <video width=0 height=-1 poster=bad><source src=x.mp4></video>
  </main>
  <footer><address>contact <a href="mailto:x@y">x@y</a></address></footer>
</body>
</html>