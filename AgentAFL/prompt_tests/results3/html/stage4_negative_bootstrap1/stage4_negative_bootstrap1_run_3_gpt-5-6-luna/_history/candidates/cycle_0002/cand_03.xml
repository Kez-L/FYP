<!doctype html>
<html>
<head><title>Form controls</title></head>
<body>
<form id=f1 action=/submit method=post>
<label for=q>Query</label>
<input id=q name=q value="a&amp;b" required>
<select name=kind multiple size=0>
<option>one
<option selected>two
<optgroup label="group"><option value=3>three</optgroup>
</select>
<textarea name=notes rows=2 cols=0>initial &lt;text&gt;</textarea>
<button type=submit><span>Go</button>
<fieldset disabled><legend>set <input name=hidden></legend></fieldset>
<form id=f2><input name=inner><select><option>broken</form></select>
</form>
<output for="q f1">result</output>
<details open><summary>more</summary><dialog open>dialog text</dialog></details>
</body>
</html>