<!doctype html>
<html>
<head><title>Misnested sections and maps</title></head>
<body>
<header><hgroup><h1>Main<h2>Subheading</hgroup><nav>
<a href=a>One<a href=b>Two<a href=c>Three</nav></header>
<main>
<section id=s1><h2>First</h2>
<article><h3>Article</h3><aside>aside begins
<section>inner section</article>
<footer>wrong footer</section>
</aside></article>
</main>
<map name=world>
<area shape=rect coords="0,0,10,10" href=a alt=A>
<area shape=circle coords="5,5,3" href=b>
<img src="image.png" usemap="#world" ismap alt="map">
</map>
<picture>
<source media="(min-width: 1px)" srcset="a 1x, b 2x">
<source type=image/webp srcset=c>
<img src=d alt=x>
</picture>
<details><summary>summary one<summary>summary two
<div>detail content</details>
<menu><li><button type=button>item one</li><li>item two</menu>
<dialog open><form method=dialog><button value=ok>OK</form><p>dialog text</dialog>
<template><table><tr><td>template cell</table><div>template tail</div></template>
<slot name=x>fallback</slot>
</body>
</html>