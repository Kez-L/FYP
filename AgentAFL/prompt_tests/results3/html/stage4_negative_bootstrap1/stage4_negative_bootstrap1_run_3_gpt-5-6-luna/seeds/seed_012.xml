<!DOCTYPE html>
<html>
<head><title>Foreign Content Mix</title></head>
<body>
<svg viewBox="0 0 120 80" width=120 height=80>
<title>an svg title</title>
<defs><linearGradient id=g x1=0 y1=0 x2=1 y2=1><stop offset="0%" stop-color=red><stop offset=100% stop-color=blue></linearGradient></defs>
<g transform="translate(2 3)" fill=url(#g)>
<rect x=0 y=0 width=50 height=20 rx=3 />
<circle cx=70 cy=20 r=12></circle>
<path d="M0 0 L20 20 Q40 0 60 20 Z"><animate attributeName=x dur=1s></animate></path>
<foreignObject x=5 y=30 width=100 height=40><div xmlns="http://www.w3.org/1999/xhtml"><p><b>HTML in SVG</b></p><input disabled></div></foreignObject>
</g>
</svg>
<math display=block>
<mi>x</mi><mo>=</mo><mfrac><msup><mi>y</mi><mn>2</mn></msup><mrow><mn>1</mn><mo>+</mo><mi>z</mi></mrow>
</mfrac>
<annotation-xml encoding="application/xhtml+xml"><div><i>annotation</i></div></annotation-xml>
</math>
<p>tail after foreign content</p>
</body>
</html>