<!DOCTYPE html>
<html>
<head>
<title>Embedded and obsolete containers</title>
</head>
<body>
<iframe srcdoc="<p>frame &amp; text</p>" name=main scrolling=yes>
fallback frame text
</iframe>
<object data="movie.bin" type="application/octet-stream" width=0 height=-1>
<param name=loop value=true>
<embed src="x" pluginspage="about:blank">
<object data="nested"><p>object fallback</p></object>
</object>
<map name=map1>
<area shape=rect coords="0,0,10,10" href=#a alt=A>
<area href=#b>
</map>
<img src=x usemap="#map1" ismap border=0>
<figure align=left>
<figcaption>caption <small>with <big>mixed</small></big></figcaption>
<p>figure text
</figure>
<isindex prompt="Search:">
<listing>&lt;tag&gt;
</listing>
</body>
</html>