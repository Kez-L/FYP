<html>
<head><title>frames and maps</title></head>
<frameset rows="10%,*,0" cols="50%,50%">
<frame src="left.html" name=left scrolling=no>
<frame src="right.html" name=right>
<noframes>
<body>
<h1>fallback</h1>
<object data="movie.bin" type="application/octet-stream" width=0 height=0>
<param name=movie value="x.swf">
<object><embed src=x></embed></object>
</object>
<map name=planet>
<area shape=rect coords="0,0,10,10" href=a>
<area shape=circle coords="5,5,2">
<area shape=poly coords="0,0,1,1,2,0" href=b>
</map>
<img src="map.png" usemap=#planet border=999>
</body>
</noframes>
</frameset>
</html>