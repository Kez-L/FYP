<!doctype html>
<html>
<head><title>Controls and Sections</title></head>
<body>
<form id=account action="/save" method=dialog>
<fieldset disabled>
<legend>Profile <small>optional</small></legend>
<label for=user>User name</label>
<input id=user name=user required autofocus>
<label>Color <input type=color name=c value=#12zz99></label>
<input type=date name=d min=2024-13-40 max=2020-01-01>
<textarea name=note rows=2 cols=8>one
two</textarea>
<select name=role multiple size=0>
<optgroup label=Staff disabled><option value=a>A<option value=b selected>B
<optgroup label=Guest><option>G
</select>
<datalist id=choices><option value=alpha><option value=beta></datalist>
<input list=choices name=lookup>
<output for="user role">result</output>
</fieldset>
<meter min=10 max=2 low=0 high=8 optimum=4 value=7>bad meter</meter>
<progress value=abc max=-1>loading</progress>
<button type=submit formnovalidate>Go</button>
</form>
<details open><summary>More</summary><dialog open>dialog text</dialog><p>inside details</p></details>
<template><section><h2>Hidden</h2><slot name=x></slot></section></template>
</body>
</html>