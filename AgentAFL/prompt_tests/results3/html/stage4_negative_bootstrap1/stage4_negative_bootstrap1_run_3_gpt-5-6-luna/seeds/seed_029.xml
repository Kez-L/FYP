<!doctype html>
<html>
<head><title>attributes and namespaces</title></head>
<body>
<div ID="a" id="b" class=test class="x y" data-X=1 data-x=2 disabled=false>
<custom-element a:b="v" xlink:href="#z" xmlns:q="urn:q">
<template shadowrootmode="open"><slot name=x></slot><p>template</p></template>
</custom-element>
<svg><foreignObject><div><table><tr><td>inside</foreignObject></svg>
<math><mtext><table><tr><td>math table</mtext></math>
<input type=file accept=",,text/plain" name="a&#x0; b" value="&notanentity;">
<iframe srcdoc="&lt;p&gt;embedded&lt;/p&gt;" sandbox="allow-scripts allow-scripts"></iframe>
<video controls><source src="a.mp4" type="video/mp4"><track kind=subtitles></video>
</div>
</body>
</html>