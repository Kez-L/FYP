<!doctype html>
<html>
<head>
<title>Embedded resources</title>
<base target="_blank">
</head>
<body>
<object data="movie.bin" type="application/octet-stream" width="320" height="200">
  <param name="quality" value="high">
  <param name="autoplay" value="false">
  <p>Fallback <em>content</em></p>
  <object classid="clsid:00000000-0000-0000-0000-000000000000">
    <img src="missing-image" alt="fallback image">
  </object>
</object>
<iframe src="about:blank" name="frame" scrolling="no">
  <h2>Fallback frame</h2>
  <p>Embedded text</p>
</iframe>
<map name="planet">
<area shape="rect" coords="0,0,10,10" href="/one" alt="one">
<area shape="circle" coords="20,20,5" nohref>
</map>
<img src="picture" usemap="#planet" ismap border="0">
<video controls poster="poster.jpg" preload="metadata">
<source src="clip.webm" type="video/webm">
<source src="clip.mp4" type="video/mp4">
<track kind="captions" srclang="en" label="English" default src="captions.vtt">
Fallback video text
</video>
<audio autoplay loop><source src="sound.ogg"><source src="sound.mp3"></audio>
<p><a href="javascript:void(0)" download="x&y">download</a></p>
</body>
</html>