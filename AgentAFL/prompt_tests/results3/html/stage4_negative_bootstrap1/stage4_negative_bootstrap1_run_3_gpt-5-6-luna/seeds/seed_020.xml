<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>Table repair case</title>
</head>
<body>
  <table border="1">
    <caption>irregular rows</caption>
    <colgroup><col span="2"><col></colgroup>
    <thead>
      <tr><th scope=col>A<th scope=col>B<th scope=col>C
    </thead>
    <tbody>
      <tr><td rowspan="2">one<td>two
      <tr><td colspan=2>three
      <tr><th>four<td><p>paragraph in cell<tr><td>five
    </tbody>
    <tfoot><tr><td>tail</td></tr></tfoot>
  </table>
  <p>text after table
  <table><tr><td>second<table><tr><td>nested</td></tr></table></td></tr></table>
</body>
</html>