<!DOCTYPE html>
<html>
<head>
<title>Interactive controls</title>
</head>
<body>
<form action="/submit?x=1&y=2" method="dialog" enctype="multipart/form-data">
<fieldset disabled="false"><legend>Register</legend>
<label for=a>Name <input id=a name=name type=text required readonly value="&quot; &apos; &amp;"></label>
<label>Email <input name=email type=email multiple pattern="["></label>
<input type=image src="data:image/svg+xml,<svg onload=alert(1)>">
<textarea name=notes rows="0" cols="-1">line 1
</textarea>ignored</textarea>
<select name=choice multiple size="999">
<option selected disabled>--choose--</option>
<optgroup label="Group"><option value=1>one<option value=2>two</optgroup>
</select>
<button type=submit formaction="/a" formmethod=get>Send</button>
<button type=reset><span>Reset</button>
</fieldset>
</form>
<dialog open><form><input autofocus><output name=result>42</output></form></dialog>
</body>
</html>