<!doctype html>
<html>
<head><title>Foreign content boundary</title></head>
<body>
<svg viewBox="0 0 20 20" width="20" height="20">
<title>vector title</title>
<g transform="translate(1 2)" onclick="x<y">
<path d="M0 0 L10 10" fill="none"/>
<foreignObject width="10" height="10">
<div xmlns="http://www.w3.org/1999/xhtml"><p>embedded <b>text</b></div>
</foreignObject>
<circle cx="4" cy="4" r="2"></circle>
</g>
</svg>
<math display="block">
<mrow><mi>x</mi><mo>&lt;</mo><mfrac><mi>a</mi><mi>b</mi></mfrac></mrow>
<annotation-xml encoding="application/xhtml+xml"><p>annotation</p></annotation-xml>
</math>
<picture>
<source srcset="a 1x, b 2x" type="image/avif">
<source media="(max-width: 2px)" srcset="">
<img src="fallback" alt="&quot;image&quot;">
</picture>
<object data="x" type="application/x-test"><param name="movie" value="x"><p>fallback<object>
<iframe srcdoc="<p>inside</p>" sandbox="allow-scripts allow-same-origin"></iframe>
</body>
</html>