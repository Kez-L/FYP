<!doctype html>
<html>
<head><title>Misnested phrasing</title></head>
<body>
<p><b>bold <i>italic <u>under <em>emphasis</b> after</i> end</u></em>
<div><span><a href="#"><strong>link <small>small</div>tail</strong></a></span>
<dl>
<dt>term<dd>definition
<dt><dt>second<dd><p>paragraph</p><dd>another
</dl>
<menu>
<li>one<li><li><span>three</menu>
<blockquote cite="x"><p>quote</blockquote>
<pre><code>literal &amp; &lt;tag&gt;
</code></pre>
<hr>
<center><font size=999 color=#xyz>legacy</font></center>
<marquee direction=sideways><blink>moving</blink></marquee>
</body>
</html>