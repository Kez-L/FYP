<!DOCTYPE html>
<html>
<head>
  <title>Control form collection</title>
  <style>
    <![CDATA[
      @media screen and (min-width:0px) { #x { width: calc(100% - 1px); } }
    ]]>
  </style>
</head>
<body>
<form action="/submit?a=1&b=2" method=dialog enctype="multipart/form-data" accept-charset="utf-8" novalidate>
  <fieldset disabled>
    <legend>Account <button type=button>Help</button></legend>
    <label for=u>User</label><input id=u name=user value="a"b" required>
    <input type=image src=go.png alt=go>
    <select name=choice multiple size=0>
      <optgroup label="One"><option selected value=1>First<option value='2>Second</optgroup>
      <option disabled>Third
    </select>
  </fieldset>
  <fieldset>
    <legend><b>Details</b></legend>
    <input type=text name=a><input type=text name=a>
    <textarea name=notes rows=2 cols=0 wrap=hard>one
two</textarea>
    <output for="u a">result</output>
    <meter min=10 max=2 low=3 high=1 optimum=0 value=99>meter</meter>
    <progress max=bad value=-4>wait</progress>
    <button formaction=/x formmethod=post type=submit>Send</button>
  </fieldset>
</form>
<dialog open=maybe><form method=post><p>modal<form><input></form></dialog>
</body>
</html>