<!DOCTYPE html>
<html>
<head>
  <title>Frames and metadata</title>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width">
  <link rel=stylesheet href=style.css media="screen and (min-width: 1px)">
  <style type="text/css"><!-- body { color: red } --></style>
</head>
<frameset cols="*,200" rows="100,*">
  <frame src="left.html" name=left scrolling=maybe>
  <frameset>
    <frame src="right.html">
    <noframes>
      <body>
        <p>fallback</p>
        <iframe src="nested.html" name="x"></iframe>
      </body>
    </noframes>
  </frameset>
</frameset>
<body>
  <p>content after frameset</p>
</body>
</html>