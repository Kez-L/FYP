<!doctype html>
<html xmlns="http://www.w3.org/1999/xhtml">
<head><title>Foreign islands</title></head>
<body>
<svg width="300" height="120" viewBox="0 0 300 120" preserveAspectRatio="xMidYMid meet">
  <defs><linearGradient id=g><stop offset="0%"/><stop offset="1"/></linearGradient></defs>
  <g transform="translate(2 3) rotate(4)">
    <path d="M0,0 L100 0 Q150 50 200,0 Z" fill=url(#g) stroke-width=3/>
    <text x=4 y=90><![CDATA[angle < text & marker]]></text>
    <foreignObject x="2" y="2" width="80" height="30"><div xmlns="http://www.w3.org/1999/xhtml">inside</div></foreignObject>
  </g>
</svg>
<math display=block>
  <mrow><mi>x</mi><mo>=</mo><mfrac><msup><mi>a</mi><mn>2</mn></msup><mrow><mi>b</mi><mo>+</mo><mn>1</mn></mrow></mfrac></mrow>
  <annotation encoding="application/x-tex">a_{1} &lt; b_{2}</annotation>
</math>
<picture><source media="(min-width: 2px)" srcset="a 1x, b 2x"><img srcset="fallback" loading=lazy></picture>
<svg><metadata><x:tag xmlns:x="urn:test" x:y="1"/></metadata><use href="#missing"/></svg>
</body>
</html>