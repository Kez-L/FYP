<!DOCTYPE html>
<html>
<head><title>Namespaces and foreign content</title></head>
<body>
<svg width="10" height="10" viewBox="0 0 10 10">
<foreignObject x="0" y="0"><div xmlns="http://www.w3.org/1999/xhtml">
<p>embedded <b>html</b></p>
</div></foreignObject>
<g><title>svg title</title><rect x="nan" y="inf" width="-1" height="999999999999999999999"></rect>
<path d="M0 0 LNaN 1 Z"/></g>
</svg>
<math>
<mi>x</mi><mo>&lt;</mo><mrow><mn>1</mn><mo>+</mo><msup><mi>y</mi><mn>2</mn></msup></mrow>
</math>
<svg><script><![CDATA[if (a < b) { /* </svg> */ }]]></script></svg>
<p xmlns="urn:weird"><span xmlns="">reset</span></p>
</body>
</html>