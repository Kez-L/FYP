<html>
<head><title>Controls</title></head>
<body>
<form action="/submit" method=post enctype="multipart/form-data">
<label for=user>User <input id=user name=user value="&quot;>&lt;"></label>
<input type=checkbox checked=checked disabled>
<input type=radio name=x value=1><input type=radio name=x value=2 checked>
<select name=kind multiple size="not-a-number">
<option selected>alpha
<option value=b>beta
<optgroup label="Group"><option>gamma</optgroup>
</select>
<textarea name=note rows=-3 cols=999>&lt;tag&gt;
</textarea>
<button type=submit><i>Send</button>
<fieldset><legend>Legend</legend><input name=x></fieldset>
</form>
<noscript><p>fallback <a href="javascript:alert(1)">link</a></noscript>
<iframe srcdoc="<p>embedded &amp; text</p>" sandbox></iframe>
</body>
</html>