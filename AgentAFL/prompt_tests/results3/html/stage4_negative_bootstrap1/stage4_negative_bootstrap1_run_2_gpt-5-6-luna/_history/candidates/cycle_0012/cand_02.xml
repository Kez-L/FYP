<html>
<head><title>Form controls</title></head>
<body>
<form action="/submit" method=POST enctype=multipart/form-data>
  <input type=text name=user value="a&amp;b" maxlength="999999999999" required>
  <input type=file name=upload multiple accept=",,text/plain">
  <select name=choice size=0 multiple>
    <option value=one selected>One
    <optgroup label=Group disabled>
      <option>Two</option>
      <option value=three>Three
    </optgroup>
    <option value=four>Four
  </select>
  <textarea name=notes rows=-2 cols=999 wrap=sideways>first
second</textarea>
  <button type=submit formaction=/other>Send
  <fieldset disabled><legend>Info</legend><input name=x></fieldset>
  <input type=image src alt=submit>
</form>
<form><p>nested start <input><form><button>bad nesting</form></button></form>
</body>
</html>