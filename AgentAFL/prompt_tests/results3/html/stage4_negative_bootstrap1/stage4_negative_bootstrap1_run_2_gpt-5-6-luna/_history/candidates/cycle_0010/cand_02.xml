<!DOCTYPE html>
<html>
<head><title>Template and shadow-like content</title></head>
<body>
<template id=t>
<div class=inside><slot name=x>fallback <span>text</span></slot>
<table><tr><td>template cell</td></tr></table>
</div>
</template>
<div id=host>
<template shadowrootmode=open>
<style>:host { display:block }</style>
<span part="label">shadow text</span>
</template>
<slot>light fallback</slot>
</div>
<dialog open><form method=dialog><p>Confirm?</p><button value=ok>OK</button></form>
<div>dialog sibling</div>
</dialog>
<details open><summary><em>Summary</em></summary>
<section><p>detail content</p></section>
</details>
<menu><li><button type=button>one</button><li>two</menu>
</body>
</html>