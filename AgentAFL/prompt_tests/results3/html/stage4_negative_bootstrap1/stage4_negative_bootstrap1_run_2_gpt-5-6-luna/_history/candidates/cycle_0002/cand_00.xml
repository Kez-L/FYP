<!DOCTYPE HTML PUBLIC "-//W3C//DTD HTML 4.01 Frameset//EN" "http://www.w3.org/TR/html4/frameset.dtd">
<html>
<head>
<title>Frameset stress</title>
<base target="_parent">
<meta name=viewport content="width=device-width,initial-scale=1">
</head>
<frameset cols="*,25%,0" border=7 frameborder="no">
  <frame src="left.html" name=nav scrolling="auto" noresize>
  <frameset rows="40%,*,*" border="bogus">
    <frame src='top.html' name="top">
    <frame src=main.html name=main>
    <frame src="bottom.html" name=bottom>
  </frameset>
  <noframes>
    <body bgcolor=#ffeecc text=black>
      <p><a href="index.html" target=_top>Continue</a>
      <table border=1 cellpadding=3 cellspacing=0>
        <tr><th colspan=3>Fallback</th><th rowspan=2>Tail
        <tr><td>A<td>B<td>C
        <tr><td><table><tr><td>nested<td></tr></table><td>&copy &unknown;
      </table>
    </body>
  </noframes>
</frameset>
</html>