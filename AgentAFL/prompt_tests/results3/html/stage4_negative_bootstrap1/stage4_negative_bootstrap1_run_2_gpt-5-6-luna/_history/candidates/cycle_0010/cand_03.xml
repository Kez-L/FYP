<!doctype html>
<html>
<head><title>Frameset transition</title></head>
<body>
<p>body before frameset
<frameset cols="*,0,garbage" rows="10%,*">
<frame src="a.html" name=left>
<frame src="b.html" frameborder=-1>
<noframes><body><h1>Fallback</h1><p>frame text</noframes>
</frameset>
<div>after frameset</div>
</html>