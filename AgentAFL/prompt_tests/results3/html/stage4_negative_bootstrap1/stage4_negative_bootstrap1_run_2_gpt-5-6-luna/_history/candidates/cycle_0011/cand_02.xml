<!DOCTYPE html>
<html>
<head>
<base href=":::://[invalid" target="%%%"><title>Form controls</title>
</head>
<body>
<form method="POST" action="/submit" enctype="multipart/form-data" accept-charset="UTF-999">
<fieldset disabled="false"><legend><label for=x>Choose</legend>
<label><input type=radio name=g checked=maybe value=a><input type=radio name=g checked value=b>
<input type="file" multiple accept="image/*,,text/plain" size="-7">
<input type="number" min="NaN" max="-Infinity" step="0" value="1e999">
<input type="date" value="2024-99-99"><input type="color" value="#12345">
<select name=s required><optgroup label="x" disabled=no><option value=a selected>Alpha<option>Beta</optgroup>
<option label="orphan">Gamma</select>
<textarea name=t wrap=side cols=0 rows=999999999999999999999>hello</textarea>
<button type="submit" formaction="http://[">Go</button>
<output for="x y" name=o>result</output>
</fieldset>
</form>
<input form="missing" autofocus autofocus>
</body>
</html>