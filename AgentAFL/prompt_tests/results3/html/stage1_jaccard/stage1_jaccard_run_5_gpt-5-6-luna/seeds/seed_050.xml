<?xml version="1.0"?>
<!DOCTYPE html>
<html>
<head>
  <title>Form control state transitions</title>
  <base href="/records/">
  <link rel="alternate" media="print" href="print.css">
</head>
<body>
  <form action="/submit" method="post" enctype="multipart/form-data" accept-charset="utf-8">
    <fieldset disabled>
      <legend>Account <em>details</em></legend>
      <label for="user">User name:</label>
      <input id="user" name="user" type="text" value="a&amp;b" readonly>
      <label>Secret <input name="secret" type="password"></label>
      <input type="hidden" name="token" value="x=y&amp;z">
    </fieldset>
    <fieldset>
      <legend>Preferences</legend>
      <select name="theme" multiple size="3">
        <optgroup label="Light">
          <option value="day" selected>Day</option>
          <option value="paper">Paper
        </optgroup>
        <optgroup label="Dark">
          <option value="night">Night</option>
        </optgroup>
      </select>
      <textarea name="notes" rows="2" cols="18">line one
line two</textarea>
      <button type="submit" name="go" value="1"><strong>Send</strong></button>
      <button type="reset">Clear</button>
    </fieldset>
  </form>
  <output name="status">pending</output>
</body>
</html>