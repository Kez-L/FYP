<!DOCTYPE HTML PUBLIC "-//W3C//DTD HTML 4.01 Frameset//EN">
<html>
<head>
<title>Frameset fallback and obsolete elements</title>
<basefont size=3>
</head>
<frameset rows="20%,*,0" cols="40%,60%">
<frame src="left.html" name=left frameborder=0 scrolling=auto>
<frameset>
<frame src="right.html" name=right noresize>
<noframes>
<body>
<h2>Fallback</h2>
<p>This content appears after a malformed nested frameset.
<iframe src="embed.html" width="100%" height="0" scrolling=no>
Fallback iframe text
</iframe>
<object classid="clsid:BAD" data="file.bin" type="application/octet-stream">
<param name="movie" value="x.swf">
<embed src="x.swf" hidden>
alternate object text
</object>
<applet code="Test.class" archive="a.jar,b.jar" width=0 height=-4>
<param name=foo value=bar>
applet fallback
</applet>
</body>
</noframes>
</frameset>
</frameset>
</html>