<!doctype HTML>
<html>
<head><title>Tables and lists</title></head>
<body>
<table border="bad" cellpadding="2">
<caption align=side>Inventory</caption>
<colgroup span=2><col width="*"><col width=0></colgroup>
<thead><tr><th rowspan=9>Item<th colspan=0>Count</tr></thead>
<tbody>
<tr><td>A<td>1
<tr><td>B<td><ul compact><li>nested one<ol reversed start=-3><li>x<li>y</ol><li>nested two</ul>
</tbody>
<tfoot><tr><td colspan=7>total</table>
<dl compact><dt>one<dd><p>first<dt>two<dd>second</dl>
</body>
</html>