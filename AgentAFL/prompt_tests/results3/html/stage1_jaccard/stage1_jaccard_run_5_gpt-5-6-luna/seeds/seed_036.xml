<!DOCTYPE html>
<html>
<head>
<title>Forms and controls</title>
</head>
<body>
<form action="/submit" method=POST enctype="multipart/form-data">
<fieldset disabled>
<legend><strong>Account</strong></legend>
<label>Name<input name=user value='x"y'></label>
<label>Password<input type=password name=p maxlength=999999999999></label>
<select name=choice multiple size=0>
<option selected value=a>Alpha
<option value=b disabled>Beta
<optgroup label="Group"><option>Gamma</optgroup>
</select>
<textarea name=message rows=-1 cols=999999999999>one
two</textarea>
<button type=submit formaction=/go>Send <span>!</button>
</fieldset>
<input type=image src=missing alt=submit>
</form>
<details open=maybe><summary>Summary</summary><p>Hidden? <output name=result>42</output></details>
</body>
</html>