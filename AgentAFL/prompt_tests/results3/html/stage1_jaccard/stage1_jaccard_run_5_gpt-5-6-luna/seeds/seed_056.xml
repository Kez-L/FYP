<!DOCTYPE html>
<html>
<head><title>Lists and definitions</title></head>
<body>
  <ol start="0" type="A">
    <li>first
      <ul compact>
        <li>nested one
        <li>nested two
          <ol reversed start="3"><li>three<li>two<li>one</ol>
      </ul>
    <li value="99">last
  </ol>
  <dl>
    <dt>term one
    <dd>definition without a closing tag
    <dt><a href=#missing>term <strong>two</a>
    <dd><p>paragraph in definition</p><dd>second definition
  </dl>
  <menu><li><a href="javascript:alert(1)">item</a></menu>
  <p><q cite="&quot;">quoted <s>deleted <u>underlined</q> text</u></s>
</body>
</html>