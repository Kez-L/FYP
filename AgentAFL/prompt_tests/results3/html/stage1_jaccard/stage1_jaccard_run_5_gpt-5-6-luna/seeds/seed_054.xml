<!DOCTYPE html>
<html lang="x-invalid">
<head>
  <title>Embedded replaced content and section edges</title>
  <meta charset="utf-8">
</head>
<body>
  <header>
    <nav>
      <a href="#one">one<a href="#two">two</a>
      <a href="#three"><span>three</span>
    </nav>
  </header>
  <section id="one">
    <h2>First section</h2>
    <p>intro
    <iframe src="about:blank" name="frame" width="0" height="0">
      iframe fallback <b>fallback text</b>
    </iframe>
    <video controls autoplay poster="poster.jpg">
      <source src="movie.webm" type="video/webm">
      <source src="movie.mp4" type="video/mp4">
      <track kind="subtitles" src="captions.vtt" srclang="en">
      video fallback
    </video>
  </section>
  <section id="two">
    <h2>Second section</h2>
    <p>before <ruby>漢<rt>かん</rt><rp>(</rp>字<rp>)</rp></ruby> after</p>
    <canvas width="20" height="20">canvas fallback</canvas>
    <hr>
  </section>
  <section id="three">
    <h2>Last section</h2>
    <p><ins datetime="2020-01-01">added</ins><del datetime="2021-01-01">removed</del>
    <time datetime="not-a-date">time</time>
  </section>
  <footer><small>footer text</small></footer>
</body>
</html>