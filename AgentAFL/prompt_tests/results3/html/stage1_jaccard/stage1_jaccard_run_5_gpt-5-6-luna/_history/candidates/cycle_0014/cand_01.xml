<!doctype html>
<html>
<head><title>Forms and controls</title></head>
<body>
<form action="/search" method=POST enctype="multipart/form-data" accept-charset="utf-8, iso-8859-1">
  <fieldset disabled="false">
    <legend>Account
    <label for=x>Name <input id=x name=name type=text value="a&b" maxlength=-1></label>
    <label><input type=checkbox checked=no> enabled?</label>
    <select name=mode multiple size=0>
      <optgroup label="one" disabled>
        <option selected value=1>first
        <option value='2>second</option>
      </optgroup>
      <option>third
    </select>
  </fieldset>
  <textarea name=message rows=-2 cols=not-a-number>unclosed
  <button type=submit formaction=javascript:alert(1)>Send</button>
  <input type=image src= data-x>
</form>
<hr noshade="nonsense">
</body>