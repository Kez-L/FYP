<!DOCTYPE html>
<html>
<head>
<title>Embedded namespaces</title>
</head>
<body>
<svg viewBox="0 0 10 10"><g transform="translate(1 2)">
<rect x="0" y="0" width="5" height="6"></rect>
<foreignObject><div xmlns="http://www.w3.org/1999/xhtml"><p>inside svg</p></div></foreignObject>
<path d="M0 0 L10 10 Z" fill="url(#x)"></path></g></svg>
<math><mrow><mi>x</mi><mo>&lt;</mo><msup><mi>y</mi><mn>2</mn></msup></mrow>
<mtext><annotation-xml encoding="application/xhtml+xml"><div>math text</div></annotation-xml></mtext></math>
<p>after namespaces</p>
</body>
</html>