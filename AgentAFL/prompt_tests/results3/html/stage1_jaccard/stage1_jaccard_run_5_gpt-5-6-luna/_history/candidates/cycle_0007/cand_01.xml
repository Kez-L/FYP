<!DOCTYPE HTML PUBLIC "-//IETF//DTD HTML 2.0//EN">
<html>
<head><title>Frames and legacy controls</title></head>
<frameset rows="*,0,20%" cols="80%,*">
<frame src="left.html" name=left noresize scrolling=auto>
<frameset>
<frame src='right.html' frameborder=abc>
<noframes><body><center><font size=+9 color=#zzzzzz>fallback</font></center></body></noframes>
</frameset>
</frameset>
<noframes><body>
<isindex prompt="Search:"><hr>
<dir compact><li>alpha<li>beta</dir>
<menu><li><strike>old</strike><li><big>large</big></menu>
<blockquote><center><table><tr><td>A<td>B</table></center></blockquote>
<blink>legacy <marquee direction=diagonal loop=-2>moving</marquee></blink>
</body></noframes>