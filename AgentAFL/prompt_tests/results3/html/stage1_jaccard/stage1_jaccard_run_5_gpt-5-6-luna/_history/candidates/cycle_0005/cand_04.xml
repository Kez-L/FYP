<!DOCTYPE HTML PUBLIC "-//W3C//DTD HTML 4.01//EN" "http://www.w3.org/TR/html4/strict.dtd">
<html lang="en-US">
<head>
  <title>Sections and quotations</title>
</head>
<body>
  <header>
    <nav><a href="#main">skip</a> | <a href="mailto:a@b">mail</a></nav>
  </header>
  <main id="main">
    <section>
      <h1>Heading
      <h4>Jumped level</h4>
      <p>Before <q cite="x">quote <cite>source</cite></q> after
      <blockquote cite="http://example.test/q">
        <p>Nested paragraph <small>small <big>large</big></small>
        <hr>
        <address>Author<br>Somewhere</address>
      </blockquote>
    </section>
    <aside>
      <details open="false">
        <summary>More</summary>
        <p>Hidden-ish <time datetime="2020-01-01T25:61">time</time></p>
      </details>
      <dialog open>dialog text</dialog>
    </aside>
    <section>
      <h2>Images</h2>
      <figure>
        <img srcset="a.png 1x, b.png 2x" sizes="(min-width: 2px) 50vw" alt="">
        <figcaption>caption with <del cite="x">deleted</del> and <ins>inserted</ins></figcaption>
      </figure>
    </section>
  </main>
  <footer><p>End</footer>
</body>
</html>