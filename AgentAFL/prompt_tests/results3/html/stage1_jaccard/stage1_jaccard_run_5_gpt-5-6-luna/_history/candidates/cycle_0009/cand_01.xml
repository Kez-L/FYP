<!doctype HTML PUBLIC "about:legacy-compat">
<html>
<head>
<title>Attributes</title>
</head>
<body>
<form action=/submit method=POST enctype="multipart/form-data">
<fieldset disabled><legend>Account &amp; Options</legend>
<input NAME=user required autofocus value=one>
<input type=checkbox checked=false>
<select name=kind multiple size=3><option selected>alpha<option>beta</select>
<textarea rows=2 cols=8 wrap=hard>unfinished
<button type=submit formaction="/other">Send</button>
</fieldset>
</form>
<map name=map1><area shape=rect coords="0,0,10,10" href=#one alt="x"><area href="#two"></map>
<img src="x" usemap="#map1" width="01" height="-2" alt="&unknown;">
<object data="movie" type="application/octet-stream"><param name=loop value=true><embed src=x></object>
</body>
</html>