<!doctype html>
<html>
<head>
  <title>Tables with unusual spans</title>
</head>
<body>
<table border="1" cellpadding=2 cellspacing=0>
  <colgroup span=2><col width="25%"><col width=75></colgroup>
  <thead><tr><th rowspan=2>Key<th colspan=3>Values</tr>
    <tr><th>A<th>B<th>C</thead>
  <tfoot><tr><td colspan=4>footer before body</tfoot>
  <tbody>
    <tr><td rowspan=2>x<td>1<td><input type=text value=two><td>3
    <tr><td colspan=2>merged<td>
    <tr><td><table><tr><td>inner<tr><th>inner head</table><td>outside
  </tbody>
  <tbody><tr><td>a<td>b<td>c<td>d</tbody>
</table>
<p>after table
<table><tr><td>unclosed cell
<div>block interrupts table</div>
</body>
</html>