<!DOCTYPE HTML PUBLIC "-//W3C//DTD HTML 4.01//EN" "http://www.w3.org/TR/html4/strict.dtd">
<html lang="zz" dir="rtl">
<head>
  <title>Frameset collision</title>
</head>
<frameset rows="20%,*,0" cols="50%,50%" border=0>
  <frame src="left.html" name=left scrolling="auto">
  <frame src="right.html" name=right noresize>
  <noframes>
    <body>
      <p>Fallback text <iframe src="nested.html" frameborder=0></iframe></p>
    </body>
  </noframes>
</frameset>
<base target="_blank">
<body>
  <h2>Body after frameset</h2>
  <form>
    <textarea name=note rows=2 cols=4 wrap=hard>one
two</textarea>
    <button type=submit disabled>send</button>
  </form>
</body>
</html>