<!doctype html>
<html>
<head>
  <title>form controls and replaced elements</title>
</head>
<body>
  <form name=f action="" method="dialog">
    <input type="file" accept="image/*,.txt" multiple="maybe" capture>
    <input type="range" min=10 max=2 step=0 value=999>
    <input type="date" min="not-a-date" max="2020-99-99">
    <input type="radio" name=choice checked="false">
    <output for="a b">result</output>
    <meter min=10 low=20 optimum=-1 high=0 max=5 value=100>meter</meter>
    <progress max=-2 value=NaN>loading</progress>
    <select name=x>
      <option value=a selected selected>one
      <option value=b disabled>two
      <option>three
    </select>
    <textarea wrap=side rows=0 cols=-4>text &amp; more</textarea>
    <button type=reset formmethod=POST formaction="/submit">go</button>
  </form>
  <object data="movie.swf" type="application/x-shockwave-flash" width="0" height="-1">
    <param name=movie value="x.swf">
    fallback <embed src="x" hidden="false">
  </object>
  <iframe srcdoc="<p>nested &amp; text</p>" sandbox="allow-scripts allow-forms" frameborder=bad></iframe>
</body>
</html>