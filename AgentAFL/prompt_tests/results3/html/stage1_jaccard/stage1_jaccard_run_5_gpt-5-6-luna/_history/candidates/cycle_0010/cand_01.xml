<!doctype html>
<html>
<head><title>Form controls and odd attributes</title></head>
<body>
<form action="/submit" method=POST enctype="multipart/form-data">
<fieldset disabled>
<legend>Choose <b>one</legend>
<label for=a>First<input id=a type=radio name=pick checked value=1></label>
<label>Second<input type=radio name=pick value=2></label>
<select name=menu multiple size=0>
<option value=x selected>one
<option>two</option>
<optgroup label="group"><option disabled>three</optgroup>
</select>
<textarea name=message rows=-1 cols="abc">text &amp; <b>not markup</textarea>
<input type=image src=button.gif alt="go">
<button type=submit formaction="/other"><span>Send</button>
<input type=unknown readonly required>
</fieldset>
<isindex prompt="Search:">
</form>
<map name=map><area shape=rect coords="0,0,10,10" href=#x><area nohref></map>
<img src="picture.png" usemap="#map" border=999>
</body>
</html>