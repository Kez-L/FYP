<html>
<head><title>Lists in the wrong order</title></head>
<body>
<dl compact>
  <dt>alpha
  <dd>one
  <dt><b>beta
  <dd><i>two
    <dl><dt>nested<dd>value</dl>
  <li>orphan item
</dl>
<ul type=disc>
  <li>first
    <ol start="not-number" reversed>
      <li>nested one
