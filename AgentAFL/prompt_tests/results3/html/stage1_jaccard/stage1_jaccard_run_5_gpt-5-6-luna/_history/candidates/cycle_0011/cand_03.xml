<!DOCTYPE html>
<html>
<head>
  <title>Column groups and irregular rows</title>
</head>
<body>
  <table border="1" cellpadding="2">
    <caption><strong>Quarterly figures</strong></caption>
    <colgroup span="2"><col class="label"><col width="40%">
    <colgroup><col span="2">
    <thead>
      <tr><th rowspan="2">Item<th colspan="3">Amounts
      <tr><th>Jan<th>Feb<th>Mar
    </thead>
    <tbody>
      <tr><th scope="row">Alpha<td>10<td>20<td>30
      <tr><td colspan="2">Beta<td>40<td>50
      <tr><td>Gamma<td><input type="text" value="60"><td>70<td>
    </tbody>
    <tfoot>
      <tr><th>Total<td>100<td>140<td>180
    </tfoot>
    <tr><td>orphan row outside section<td colspan="4">tail
  </table>
  <map name="diagram">
    <area shape="rect" coords="0,0,20,20" href="a">
    <area shape="circle" coords="30,30,10" alt="circle">
  </map>
  <img src="diagram.png" usemap="#diagram" alt="data diagram">
</body>
</html>