<!DOCTYPE HTML PUBLIC "-//IETF//DTD HTML 2.0//EN">
<html>
<head>
  <title>Nested flow and phrasing elements</title>
</head>
<body>
  <main>
    <article>
      <header><hgroup><h1>Heading A<h3>Subheading</h3></hgroup></header>
      <p>First paragraph <b>bold <i>italic <u>underlined</b> repaired?</u></i>
      <dl>
        <dt>one
        <dd>definition with <abbr title="Application Programming Interface">API</abbr>
        <dt>two
        <dd><ol start="3">
          <li>third
          <li>fourth<ul><li>nested bullet<li>another</ul>
        </ol>
      </dl>
      <blockquote cite="/quote"><p>quoted text
        <q cite="/source">nested quote</q>
      </blockquote>
      <figure>
        <figcaption>an illustration</figcaption>
        <object data="image.bin" type="application/octet-stream">
          <param name="mode" value="raw">
          fallback <mark>content</mark>
        </object>
      </figure>
      <footer><address>Contact <a href="mailto:x@example.test">editor</a></address></footer>
    </article>
    <aside>
      <details open><summary>More information</summary>
        <p>hidden until expanded</p>
      </details>
    </aside>
  </main>
</body>
</html>