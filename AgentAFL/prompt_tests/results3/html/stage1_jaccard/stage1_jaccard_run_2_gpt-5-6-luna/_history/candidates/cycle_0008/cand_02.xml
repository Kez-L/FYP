<!DOCTYPE html>
<html>
<head><title>frames and obsolete containers</title></head>
<frameset rows="20%,*,0" cols="bad,*">
  <frame src="a.html" name=top scrolling=maybe>
  <frameset cols="50%,50%">
    <frame src="b.html">
    <frame src="c.html">
  </frameset>
  <noframes>
    <body>
      <center>
        <font face="serif" size="7" color="#ggg">fallback</font>
      </center>
      <marquee behavior=alternate direction=sideways>moving</marquee>
      <blink>old text</blink>
      <hr><isindex prompt="Search:">
      <form action=/search method=WHAT enctype=text/plain>
        <input type=text name=q value="a&b">
        <input type=image src=x>
        <button type=invalid><b>send</button>
      </form>
    </body>
  </noframes>
</frameset>
</html>