<!DOCTYPE HTML PUBLIC "-//W3C//DTD HTML 4.01 Frameset//EN">
<html>
<head>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>frames and obsolete elements</title>
</head>
<frameset rows="20%,*,0" border="1">
  <frame src="one.html" name="top" scrolling="no" frameborder="0">
  <frameset cols="30%,70%">
    <frame srcdoc="<p>srcdoc &amp; <b>nested</b>" src="two.html">
    <noframes>
      <body bgcolor="#fff" text="black">
        <center><font face="serif" size="7">fallback</font></center>
        <marquee direction="left" behavior="alternate">moving &copy; text</marquee>
        <hr noshade="noshade" width="bad">
        <isindex prompt="Search:">
      </body>
    </noframes>
  </frameset>
  <frame src="javascript:alert('x')" name="_blank">
</frameset>
</html>