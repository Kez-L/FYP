<!DOCTYPE HTML>
<html>
<head><title>frames and legacy content</title></head>
<frameset rows="*,100,0" cols="25%,bad">
  <frame src="a.html" name="main" scrolling=maybe noresize>
  <frame src="b.html" frameborder="-1">
  <frameset>
    <frame>
    <noframes>
      <body>
        <h1>fallback</h1>
        <a href="x" target=_blank>link
      </body>
    </noframes>
  </frameset>
  <noframes>text outside body
</frameset>
<body>
  <applet code=Test.class archive="a.jar,b.jar" width=1 height=2>
    <param name=foo value=bar>
    <param name=foo>
    fallback text
  </applet>
  <object classid="clsid:bad" codebase="http://x/" width=auto height="">
    <param value>
    <embed src=x pluginspage=about:blank>
  </object>
</body>
</html>