<!doctype html>
<html>
<head><title>foreign content</title></head>
<body>
<svg width="100%" viewBox="0 0 10 10" onload="x<y">
  <title>svg title</title>
  <defs><linearGradient id="g"><stop offset="0%"/><stop offset="100%"/></linearGradient></defs>
  <g transform="translate(1 2) rotate(3)" fill="url(#g)">
    <path d="M0,0 L10,0 L10,10 Z" stroke-width="NaN"></path>
    <text x="2" y="3"><tspan>svg &amp; text</tspan></text>
    <foreignObject x="0" y="0" width="4" height="4">
      <div xmlns="http://www.w3.org/1999/xhtml"><p>embedded html</p></div>
    </foreignObject>
  </g>
</svg>
<math display="block">
  <mi>x</mi><mo>&InvisibleTimes;</mo><mfrac><msup><mi>a</mi><mn>2</mn></msup><mrow><mi>b</mi><mo>+</mo><mi>c</mi></mrow></mfrac>
  <annotation encoding="application/x-tex">x^2</annotation>
</math>
<p>after foreign content</p>
</body>
</html>