<!doctype html>
<html>
<head><title>frames and obsolete controls</title></head>
<body>
<frameset cols="*,2,invalid" rows="0,*">
<frame src="a.html" name=main scrolling=maybe noresize>
<frame srcdoc="<p>nested <b>document</p>" src="b.html">
<noframes><body><p>fallback</p></body></noframes>
</frameset>
<marquee behavior=alternate direction=sideways loop=-1><blink>moving</blink></marquee>
<center><font face="x" size=99 color="#GGGGGG">legacy</font>
<isindex prompt="Search:"><hr noshade="false" width="bad">
<applet code="x.class" archive="a.jar,b.jar" width=NaN height=-4>
<param name=movie value="x"><param name=movie value=y>
</applet>
</center>
</body>
</html>