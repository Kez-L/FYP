<!DOCTYPE html>
<html>
<head>
  <title>select option and malformed controls</title>
</head>
<body>
<form name=f1 action="" method=post>
  <label for=x>Choose:
  <select id=x name=pick multiple size=zero>
    <optgroup label="A">
      <option value=1 selected>one
      <option value=2 selected="selected">two
      <option>three
    <optgroup label="B">
      <option disabled>four</select>
  <textarea name=t rows="NaN" cols="-4">initial <b>markup</textarea>
  <fieldset disabled>
    <legend><i>legend</fieldset>
    <input name=a type=text checked value=x>
    <input name=b type=checkbox checked=maybe>
  <input type=file accept=",,," name=file>
  <input type=hidden name=h value="v">
  <input type=submit value="go">
</form>
<form>
  <input name=outside>
  <select><option>orphan
</form>
</select>
<p><label>unclosed label <input type=text></p>
</body>
</html>