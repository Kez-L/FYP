<!DOCTYPE html>
<html>
<head><title>misnested insertion modes</title></head>
<body>
  <table border=999 cellpadding=-1 cellspacing=abc>
    <caption>caption<table><tr><td>inner</caption>
    <colgroup span=0><col span=999999><colgroup><col>
    <thead><tr><th scope=col rowspan=-2 colspan=999>H
    <tbody><tr><td>A<td>B<form><input name=f></form></tr>
    <tfoot><tr><td>C</tbody><tr><td>D</table>
  <p>after table <div>block <span>inline</div> tail</span></p>
  <ol start=999999999999999999999999 type=z reversed="no">
    <li value=abc>one
    <li value=-999999999999999999999>two
  </ol>
  <ul><li><p>first<li><p>second</ul>
  <figure><img src=x><figcaption>caption<figure>nested</figure></figcaption></figure>
</body>
</html>