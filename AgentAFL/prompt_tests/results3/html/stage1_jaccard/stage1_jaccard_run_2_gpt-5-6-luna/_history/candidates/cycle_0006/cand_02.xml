<html>
<head>
<title>forms and controls</title>
</head>
<body>
<form action="/submit" method="get" enctype="multipart/form-data">
<fieldset disabled>
<legend>Account <input type=text name=legend></legend>
<label for=user>User
<input id=user name=user value="&lt;admin&gt;" required readonly>
</label>
<select name=choice multiple size="-1">
<option selected>alpha
<option value="&amp;beta">beta
<optgroup label="group"><option>gamma</optgroup>
</select>
<textarea name=note rows="999999999" cols="-4">initial &amp; <b>literal</textarea>
<button type=submit><input type=image src=x alt=send></button>
</fieldset>
<input type="hidden" name=x>
</form>
<form><input name=outside><label>unclosed label<input type=checkbox checked=checked></form>
<isindex prompt="Search:">
</body>
</html>