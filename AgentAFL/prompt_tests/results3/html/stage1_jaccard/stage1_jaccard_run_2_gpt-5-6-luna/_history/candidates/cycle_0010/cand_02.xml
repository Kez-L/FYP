<!doctype HTML PUBLIC "-//IETF//DTD HTML 2.0//EN">
<?xml version="1.0" encoding="UTF-16"?>
<!ENTITY foo "bar">
<html>
  <head>
    <title>conditional and declaration stress</title>
    <![if IE]>
      <style>body { display: none }</style>
    <![endif]>
  </head>
  <body>
    <p>before
    <?processing instruction?>
    <!unknown declaration "unterminated
    <div>
      <![CDATA[
        <tag attr="value"> & not entity </tag>
      ]]>
      <section>
        <hgroup><h1>Heading<h2>Subheading</hgroup>
        <dl>
          <dt>Term 1
          <dd>Description 1
          <dt><dt>Term 2
          <dd><p>Nested description</dl>
      </section>
    </div>
    <p>after</p>
  </body>
</html>