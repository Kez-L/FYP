<!DOCTYPE html>
<html>
<head><title>metadata edge cases</title></head>
<body>
  <section aria-labelledby="missing" role="not-a-role">
    <h2 id="dup">First</h2>
    <h3 id="dup">Second</h3>
    <nav><a href="#dup" hreflang="xx-INVALID" rel="noopener nofollow mystery">jump</a></nav>
  </section>
  <div contenteditable="maybe" spellcheck="perhaps" tabindex="999999999999999999999">
    <template shadowrootmode="open"><span>template &copy;</span></template>
    <slot name="x">fallback</slot>
    <dialog open="0">dialog text<form method="dialog"><button>close</button></form></dialog>
    <p><small><big><tt><strike>mixed</strike></tt></big></small></p>
  </div>
  <video src="movie" autoplay="false" controlslist="foo nofullscreen" preload="maybe" poster="">
    <track kind="subtitles" srclang="zz" label="x" src="missing.vtt" default="no">
    fallback
  </video>
  <audio><source src="a" type="audio/unknown"><source src="b"><track></audio>
  <picture>
    <source media="(min-width: 0px" type="image/" srcset="x,,y 3x">
    <img loading="sometimes" decoding="what" width="-" height="1e100">
  </picture>
  <canvas width="-1" height="999999999999999999999999">fallback <button type="button">x</button></canvas>
  <div><span>unclosed
  <aside>aside <main>nested main</main></aside>
  <footer>footer
</body>