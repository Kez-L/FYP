<!doctype html>
<html lang=en>
<head>
  <base href=//example.invalid/a/b>
  <title>raw text and form controls</title>
</head>
<body>
  <form method=dialog action="/x? a=b" accept-charset="UTF-8, BAD">
    <fieldset disabled>
      <legend>Options <input type=checkbox checked="maybe"></legend>
      <input type=text name=q value="unterminated>
      <input type=image src=missing alt=foo/bar>
      <button type=unknown formaction=/next>Push <strong>button</strong>
      <select multiple size="-7">
        <option value=a selected>one
        <option value=b>two
        <option value=c disabled>three
      </select>
      <textarea cols="NaN" wrap=hard>first line
second line &amp; &#x110000;</textarea>
    </fieldset>
    <input type=hidden name=x value="a&amp;b">
  </form>
  <pre><code>&lt;div&gt;
  literal preformatted text
</code></pre>
  <x-custom a:b="v"><template><p>template body</p></template></x-custom>
  <noscript><p>fallback <img src=x alt=y></noscript>
</body>
</html>