<html>
<head><title>Forms and controls</title></head>
<body>
  <form action="/submit" method=POST enctype="multipart/form-data">
    <fieldset disabled="false"><legend>Account
      <label for=u>User <input id=u name=user type=text value="a&b" maxlength="-1">
      <label>Password <input name=pass type=password>
    </fieldset>
    <select name=choice multiple size="notnum">
      <option value=one selected>One
      <option value=two selected="selected">Two
      <optgroup label="Group"><option>Three</select>
    <textarea name=notes rows="999999999999999999" cols="-4">a &lt; b
    <button type=submit formaction=><input type=hidden name=x value=y></button>
    <input type=image src alt=submit>
    <input type=file accept="image/*,," required=false>
  </form>
  <form><input name=outside><form action=x><input name=nested></form></form>
  <label><input type=checkbox checked="no">check</label>
</body>
</html>