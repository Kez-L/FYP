<!DOCTYPE html>
<html>
<head><title>form controls</title></head>
<body>
<form action="/submit?a=1&b=2" method="POST" enctype="multipart/form-data">
  <fieldset disabled>
    <legend><label for=x>Choose <input type="text" id=x name=n value="unterminated></label></legend>
    <input type="checkbox" checked="checked" disabled=false>
    <input type="radio" name="r" checked>
    <select name="s" multiple size="-1">
      <optgroup label="A&B"><option selected value=1>One<option value="2">Two</optgroup>
      <option>three
    </select>
    <textarea name=t rows="NaN" cols="-4">first
second</textarea>
  </fieldset>
  <input type="hidden" name="h" value="&quot; &amp; &#65">
  <button type=submit><span>Send</button>
  <label><output name=o for="x y">result</output></label>
  <input type="image" src="data:image/gif;base64,@@@@">
</form>
<menu type=context><li>entry<li><button>nested</menu>
<table><tr><td><form><input><tr><th>late header</table>
