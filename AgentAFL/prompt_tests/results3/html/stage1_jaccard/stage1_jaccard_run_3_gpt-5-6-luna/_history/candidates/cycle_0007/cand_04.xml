<!DOCTYPE HTML PUBLIC "-//W3C//DTD HTML 4.01 Frameset//EN" "http://www.w3.org/TR/html4/frameset.dtd">
<html>
<head>
  <title>Legacy frames and metadata</title>
  <meta name=viewport content="width=device-width,initial-scale=1">
  <meta http-equiv=refresh content="0; url=http://invalid/">
  <link rel=stylesheet alternate href=a.css media="screen and (min-width: 2px)">
  <style type="text/css">a{color:red} @import url(b.css);</style>
</head>
<frameset rows="*,0,25%" cols="50%,*" frameborder=maybe>
  <frame src="left.html" name=left scrolling=auto noresize>
  <frameset cols="*,*">
    <frame src=right.html>
    <noframes>
      <body>
        <p>fallback <b>bold <i>crossed</b> italic</i>
        <table border=1><tr><th>H<th>H2<tr><td>A<td>B</table>
        <form><input name=x><input name=y></form>
      </body>
    </noframes>
  </frameset>
  <frame src="third.html">
</frameset>
</html>