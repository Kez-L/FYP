<!DOCTYPE html>
<html>
<head>
  <title>lists and definition structures</title>
</head>
<body>
  <dl compact="compact">
    <dt>term one
    <dd>definition one
    <dt><b>term <em>two</dt>
    <dd><p>definition <code>x & y</code>
      <dl><dt>nested<dd>nested definition</dl>
  </dl>
  <ul type="square">
    <li>outer
      <ul><li>inner A<li>inner B
    <li>outer second
  </ul>
  <ol reversed start="abc">
    <li value="999999999999999999999">large
    <li value>implicit
  </ol>
  <blockquote cite="&quot;bad">
    <p>quoted one</p>
    <blockquote><p>quoted two
  </blockquote>
  <pre><code>line 1
    line 2</pre></code>
  <hr noshade="no" size="0">
  <center><font face="A" color="#GGG" size="100">legacy</font></center>
  <dir><li>directory item</dir>
</body>
</html>