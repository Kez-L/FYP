<!doctype html>
<html><head><title>form controls</title></head><body>
<form method=post action=/save enctype=multipart/form-data>
  <fieldset disabled><legend>Account
    <label for=u>User <input id=u type=text name=user required></label>
    <label>Password <input type=password name=p minlength=8></fieldset>
  <input type=checkbox checked=FALSE name=flag>
  <input type=number min=10 max=2 step=banana value=∞>
  <input type=file accept="image/*,,.txt" multiple>
  <select name=choice size=zero>
    <optgroup label=Group disabled>
      <option selected value=a>Alpha
      <option value=b>Beta
    </optgroup>
    <option>Gamma
  </select>
  <textarea rows=-1 cols=NaN wrap=sideways>first
second</textarea>
  <button type=submit formaction="javascript:bad(&quot;">Go</button>
</form>
<input form=no-such list=choices>
<datalist id=choices><option value=one><option value=two></datalist>
</body></html>