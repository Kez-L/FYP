<!DOCTYPE html>
<html>
<head>
  <title>raw text and comments</title>
  <noscript><p>fallback <b>markup</noscript>
</head>
<body>
  <template id=t><section><p>template text</section></template>
  <script language=javascript>
    var s = "<div>&amp;</div>";
    /* comment with </script and <style> */
    function f(x){ return x ? "<!--" : "-->"; }
  </script>
  <style>
    .x:before { content: "<p>&amp;"; }
    @import url("x.css");
  </style>
  <textarea name=t>one</textarea>two</textarea>
  <xmp><b>literal</b><xmp>nested</xmp></xmp>
  <plaintext><h2>everything after this is text
  <div class="not-an-element">&copy; &#xZZ;</div>
</body>
</html>