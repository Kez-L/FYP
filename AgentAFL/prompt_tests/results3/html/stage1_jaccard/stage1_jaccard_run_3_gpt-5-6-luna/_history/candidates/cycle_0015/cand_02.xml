<!doctype html>
<html>
<head><title>media and obsolete declarations</title></head>
<body>
  <picture>
    <source media="(min-width: 0px)" srcset="a 1x, b 2x, c">
    <source type="image/avif" srcset="">
    <img src="fallback" srcset="x 100w, y 0w, z -1w" sizes="calc(100% - )" alt="fallback">
  </picture>
  <video autoplay controls loop muted poster="poster">
    <source src="movie.mp4" type="video/mp4">
    <track kind="captions" srclang="xx" label="&notreal;" default>
    fallback <a href="x">video link</a>
  </video>
  <audio preload="invalid"><source src=a><source src=b type=audio/unknown></audio>
  <map name="m">
    <area shape="poly" coords="0,1,foo,3" href="#one">
    <area shape="rect" coords="1,2,3" nohref>
  </map>
  <object data="x" type="application/octet-stream" width="NaN" height="-0">
    <param name="movie" value="x">
    <embed src="y" hidden="maybe">
    object fallback
  </object>
  <marquee behavior=scroll direction=sideways><blink>old</blink></marquee>
</body>
</html>