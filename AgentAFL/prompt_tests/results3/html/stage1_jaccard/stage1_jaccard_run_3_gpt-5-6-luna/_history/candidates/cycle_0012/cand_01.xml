<!DOCTYPE HTML PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">
<head><title>attributes</title></head>
<body>
<form action="/submit" method="get" enctype="multipart/form-data">
  <fieldset disabled><legend><label for="q">Query</label></legend>
    <input id="q" name="q" type="text" value="one" value="two" required="required" maxlength="-4">
    <input name="n" type="number" min="9" max="1" step="0" value="NaN">
    <input type="date" name="d" value="2024-99-99">
  </fieldset>
  <label>Choice <select name="s" multiple size="-1">
    <option value="a" selected selected>A
    <option value="b" label="B">B
    <optgroup label="Group"><option>C</optgroup>
  </select></label>
  <textarea name="t" rows="-2" cols="0" wrap="banana">first
second</textarea>
  <button formaction="/other" formmethod="post">Go</button>
  <output for="q n">result</output>
  <datalist id="list"><option value="x"><option value="y"></datalist>
  <input list="list" type="text" autocomplete="off">
</form>
<table border="0" cellpadding="-1">
  <colgroup span="0"><col span="-2"><colgroup><col>
  <thead><tr><th rowspan="0" colspan="-1">A<th>B
  <tbody><tr><td headers="missing" abbr="x" scope="rowgroup">1
    <td><input type="checkbox" checked="no"></td></tr>
  <tfoot><tr><td>foot</table>
</body>
</html>