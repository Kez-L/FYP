<!doctype html>
<html>
  <head>
    <title>Mixed namespaces and broken tokens</title>
    <meta charset=UTF-16>
  </head>
  <body>
    <svg viewBox="0 0 10 10" xmlns="http://www.w3.org/2000/svg">
      <foreignObject width="10" height="10">
        <div xmlns="http://www.w3.org/1999/xhtml">
          <p data-x="&amp;&#xD800;&#1114112;" class='unterminated>
            text </div></foreignObject>
      <path d="M0 0 L10 10 Z" />
      <script><![CDATA[if (a < b) { /* ]] </script>]]></script>
    </svg>
    <math>
      <mrow><mi>x</mi><mo>&InvisibleTimes;</mo><mn>2</mn></mrow>
      <annotation-xml encoding="application/xhtml+xml">
        <p>crossed foreign content</p>
      </annotation-xml>
    </math>
  </body>
</html>