<!DOCTYPE html>
<html>
<head>
  <title>Embedded namespaces</title>
</head>
<body>
  <svg width="20" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
    <g transform="translate(1 2)"><path d="M0 0 L10 10" stroke="red"></g>
    <foreignObject><div xmlns="http://www.w3.org/1999/xhtml"><p>HTML in SVG</foreignObject>
    <circle cx=5 cy=5 r=3><animate attributeName=r from=1 to=4 dur=1s></circle>
  </svg>
  <math display=block>
    <mrow><mi>x</mi><mo>&#x2212;</mo><mn>1</mn><mo>=</mo><mfrac><mi>a</mi><mi>b</mi></mfrac></mrow>
    <annotation-xml encoding="application/xhtml+xml"><div>math child</div></annotation-xml>
  </math>
  <object data="movie.bin" type="application/octet-stream">
    <param name=autoplay value=true>
    <embed src=other.bin width=0 height=-2>
    fallback <iframe srcdoc="<p>nested &amp; page"></iframe>
  </object>
  <template><table><tr><td>template cell</template>
</body>
</html>