<!DOCTYPE html [
  <!ENTITY broken "replacement">
  <!ELEMENT html O O ANY>
]>
<html>
<head>
  <title>Internal subset and declarations</title>
  <?xml version="1.0"?>
  <!---->
  <!-- nested-looking <!-- comment --> tail -->
</head>
<body>
  <form action="/submit" method=post enctype="multipart/form-data">
    <fieldset disabled>
      <legend>choose &broken; &unknown;</legend>
      <input type=text name=a value="one" disabled>
      <input type=checkbox name=b checked=checked>
      <select name=pick multiple size=0>
        <optgroup label="A &amp; B">
          <option selected>first<option value=two>second
        </optgroup>
        <option>third
      </select>
      <textarea name=notes rows=2 cols=0>raw <b>markup &amp; entity</textarea>
      <button type=submit formaction='unterminated>Send</button>
    </fieldset>
  </form>
</body>
</html>