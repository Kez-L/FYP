<!doctype HTML PUBLIC "-//W3C//DTD XHTML 1.1//EN" "http://www.w3.org/TR/xhtml11/DTD/xhtml11.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">
<head>
  <title>Namespace transitions</title>
  <style type="text/css"><![CDATA[
    body::before { content: "<tag>&value;"; }
  ]]></style>
  <script type="application/javascript">
    if (x < 3 && y > 1) { document.write("<em>&amp;</em>"); }
  </script>
</head>
<body>
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 10 10">
    <foreignObject x="0" y="0" width="10" height="10">
      <div xmlns="http://www.w3.org/1999/xhtml">embedded <b>markup</b></div>
    </foreignObject>
    <path d="M0 0L10 10" fill="none"/>
  </svg>
  <math xmlns="http://www.w3.org/1998/Math/MathML">
    <mrow><mi>x</mi><mo>=</mo><mfrac><mn>1</mn><mn>0</mn></mfrac></mrow>
  </math>
</body>
</html>