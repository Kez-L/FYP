<!DOCTYPE html>
<html>
<head>
  <title>Ruby and embedded data</title>
</head>
<body>
  <p><ruby>漢<rt>kan<rp>(</rp><rt>かん<rp>)</ruby>
  <p><bdo dir=rtl><abbr title="right to left">abc</bdo></abbr>
  <p><wbr><hr noshade size=0 width="75%">
  <form action method=get accept-charset="UTF-8, ISO-8859-1" onsubmit="return false">
    <label for=q>Search</label>
    <input id=q name=q type=search value="a&b" autocomplete=off>
    <button type=submit name=x value="1">Go</button>
    <input type=image src=go.gif alt=Go>
    <textarea rows=2 cols=4 wrap=hard>line one
line two
  <select name=x>
    <option value=1>one
    <option value=2 selected=selected>two
    <option disabled>three
  </select>
  </form>
  <iframe srcdoc="<p>inner &amp; <b>document</b>" sandbox width=1 height=1>
    iframe fallback
  </iframe>
  <details open><summary>more</summary><p>hidden-ish content</details>
</body>
</html>