<!DOCTYPE html>
<html lang="">
  <head>
    <meta charset=UTF-8 />
    <title>namespace and embedded markup</title>
  </head>
  <body>
    <svg xmlns="http://www.w3.org/2000/svg">
      <defs><linearGradient id=g><stop offset="50%" stop-color="#fff"/></linearGradient></defs>
      <use href="#g" xlink:href="#missing"></use>
      <text x="NaN" y="-Infinity">A &amp; B</text>
    </svg>
    <math xmlns="http://www.w3.org/1998/Math/MathML">
      <mstyle mathvariant="unknown"><mfrac><mi>a</mi><mrow><mo>&lt;</mo><mi>b</mi></mrow>
      <munder><mo>∑</mo><mi>i</mi></munder></mstyle>
    </math>
    <div xmlns:foo="urn:test" foo:flag="yes" xml:lang="en">
      <span style="color: rgb(999,-1,foo)" onclick="if (x < 2) alert('&quot;')">text</span>
    </div>
    <!-- -- bad -- comment -- -->
