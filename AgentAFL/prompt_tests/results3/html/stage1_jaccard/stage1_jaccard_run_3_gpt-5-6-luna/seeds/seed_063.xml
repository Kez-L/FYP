<html>
  <head>
    <title>Frameset and obsolete elements</title>
    <basefont size=999 color=#ggg>
    <isindex prompt="Search:">
    <noframes>
      <body><p>No frames</p></body>
    </noframes>
  </head>
  <frameset rows="*,*,0,-1" cols="25%,bad">
    <frame src="a.html" name=left frameborder=maybe marginwidth=-5>
    <frameset>
      <frame src="b.html">
      <frame src="c.html" noresize="false">
      <frame>
    </frameset>
    <noframes><p>fallback <a href=x>link</a></noframes>
  </frameset>
  <body bgcolor=red text=blue link=#000000 vlink=#fff alink=>
    <center><font face="A" size="+999"><big><small>old markup</small></big></font></center>
    <marquee direction=sideways behavior=unknown loop=-1 width=abc>
      <blink>moving <strike>content</strike></blink>
    </marquee>
    <applet code=Test.class archive="a.jar,b.jar" width= height=-2>
      <param name=foo value="a&b">
      applet fallback
    </applet>
    <hr><center><table><tr><td>x</center></td></tr></table>
  </body>
</html>