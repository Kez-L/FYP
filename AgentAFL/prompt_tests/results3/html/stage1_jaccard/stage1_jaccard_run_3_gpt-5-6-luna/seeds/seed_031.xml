<!DOCTYPE html>
<html>
<head><title>Form controls</title></head>
<body>
<form action="/submit?a=1&b=2" method=post enctype="multipart/form-data">
  <fieldset disabled>
    <legend>Account <input name=legend></legend>
    <label for=u>User <input id=u name=user value="a&b" required></label>
    <label>Password <input type=password name=pw minlength=3 maxlength=2></label>
    <input type=checkbox checked=unchecked name=flag>
    <input type=radio name=choice checked value=x><input type=radio name=choice value=y>
  </fieldset>
  <select name=items multiple size=-1>
    <optgroup label="A"><option selected>one<option disabled value=two>two</optgroup>
    <option>three
  </select>
  <textarea name=note rows=0 cols=-5>first
second</textarea>
  <button type=submit formaction=/go>Go</button>
  <input type=image src=missing alt=submit>
  <output for="u pw">result</output>
  <meter min=10 max=2 low=3 high=4 value=99>meter</meter>
  <progress max=0 value=-1>progress</progress>
</form>
<input form=missing name=outside>
<label><input type=file accept=image/*,application/x-foo multiple></label>
</body>
</html>