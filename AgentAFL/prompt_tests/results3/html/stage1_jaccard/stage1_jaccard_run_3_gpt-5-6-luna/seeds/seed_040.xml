<!DOCTYPE html>
<html>
<head><title>foreign content boundary stress</title></head>
<body>
  <svg viewBox="0 0 10 10" width="0" height="-1">
    <title>&#xD800; &#x110000; &ampbroken</title>
    <g transform="translate(1,2) rotate(foo)">
      <path d="M0 0 LNaN 10 Z" fill="url(#missing)" />
      <foreignObject x="1" y="2" width="3" height="4">
        <div xmlns="http://www.w3.org/1999/xhtml"><b><i>crossed</div></i></b>
      </foreignObject>
      <metadata><![CDATA[<x>&not-an-entity;</x>]]></metadata>
    </g>
  </svg>
  <math display="sideways">
    <mrow><mi>x</mi><mo>&InvisibleTimes;</mo><msup><mi>y</mi><mn>2</mn></msup>
    <annotation-xml encoding="text/html"><p><em>embedded</annotation-xml></mrow>
  </math>
  <p>after foreign content</p>
</body>
</html>