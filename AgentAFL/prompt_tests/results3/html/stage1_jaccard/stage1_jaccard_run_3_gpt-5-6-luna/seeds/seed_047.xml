<head><title>table repair variant</title></head>
<body>
  <table border="bogus" cellpadding="-" cellspacing="1.2">
    <colgroup span="NaN"><col width="*"><colgroup><col>
    <thead><tr><th rowspan="-1">A<th colspan="zero">B
    <tbody>
      <tr><td headers=a b>1<td>2
      <tr><td><p>nested paragraph<td><table><tr><td>inner</table>
