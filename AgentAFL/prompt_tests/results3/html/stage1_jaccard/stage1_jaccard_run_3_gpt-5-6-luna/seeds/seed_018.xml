<!DOCTYPE html>
<html>
<head>
  <title>Lists and definition transitions</title>
</head>
<body>
  <ol start="0" reversed type="A">
    <li value="3">first
      <ol><li>nested one</li><li>nested two
    <li>second
  </ul>
  <dl compact>
    <dt>Term one
    <dd>Definition one
    <dt><dt>Term two</dt>
    <dd><p>Definition <em>with emphasis</dd>
  </dl>
  <menu type="toolbar">
    <li><button type=button>Action</button>
    <li><input type=button value="Control">
  </menu>
  <p>after list</p>
  <ul><li>unclosed A<li>unclosed B
  <div>block inside list</div>
  <li>unclosed C</ul>
</body>
</html>