<!DOCTYPE html>
<html>
<head><title>foreign nodes</title></head>
<body>
<svg width="100%" viewBox="0 0 10 10" viewbox="bad">
  <defs><linearGradient id=g><stop offset="0%"/><stop offset="100%" stop-color="&bogus;"/></linearGradient></defs>
  <g transform="translate(1,2" onclick="x<y">
    <rect x="0" y="0" width="10" height="10" fill="url(#g)"></rect>
    <text x="1" y="2">SVG &amp; text</text>
    <foreignObject><div xmlns="http://www.w3.org/1999/xhtml"><p>embedded HTML</div></foreignObject>
  </g>
</svg>
<math display="block">
  <mrow><mi>x</mi><mo>&lt;</mo><msup><mi>y</mi><mn>2</mn></msup></mrow>
  <annotation-xml encoding="application/xhtml+xml"><p>math payload</p></annotation-xml>
</math>
<p xmlns="urn:unknown" xmlns:xlink="http://www.w3.org/1999/xlink">
  <x:thing xlink:href="#x" xlink:actuate="onLoad">unknown namespace</x:thing>
</p>
</body>
</html>