<!doctype html>
<html>
<head><title>Sections and orphaned nodes</title></head>
<body>
  <h1>Heading <span>start
  <section><h3>Skipped level</h3>
    <p>paragraph <ins cite=x datetime=bad><em>inserted <del>deleted</ins> tail</em></del>
    <figure><figcaption>caption first</figcaption><div>not a usual image</div></figure>
  </section>
  <h2>after section
  <p>one<p>two<div>block <span>inline <section>nested section</section> after</div>
  <blockquote cite="a" hidden="false"><p>quote<q cite=b>nested quote</blockquote>
  <hr><br><wbr><br />
  <address><a href="mailto:a@b">contact</a></address>
  <menu type=context>
    <li><button type=button>Action</button>
    <li><a href=# onclick="x<y && z>0">Link</a>
  </menu>
  <map name=map><area shape=rect coords="0,0,10,10" href=x><area nohref></map>
  <img usemap="#map" src=x>
</body>
</html>