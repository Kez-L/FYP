<!DOCTYPE html>
<html>
<head><title>Ruby and list recovery</title></head>
<body>
  <dl compact>
    <dt>Term one
    <dd>Definition without closing
    <dt><a href=/term?x=1&y=2>Term two
    <dd><ul type=disc>
      <li value=0>zero
      <li><ol start="not-number" reversed>
        <li>nested A
        <li>nested B
      </ul>
    </dl>
  <ruby>
    漢<rb>字<rt>kanji<rp>)</rp>
    <rtc><span>annotation</span></rtc>
  </ruby>
  <dir><li>old item<li>another item</dir>
  <menu compact><li><a>missing href<li>unclosed
  <p>after lists</p>
</body>
</html>