<!DOCTYPE html>
<html>
<head>
  <title>mixed raw text and embedded declarations</title>
  <noscript><meta charset="utf-7"><p>fallback</noscript>
</head>
<body>
  <template id=t>
    <p>template content <b>bold</template>
  <iframe srcdoc="<p>embedded &amp; broken</p>" sandbox="allow-scripts allow-forms">
    fallback <b>text</iframe>
  <object data="movie.swf" type="application/x-shockwave-flash">
    <param name=movie value=movie.swf>
    <embed src=movie.swf width=0 height=-1>
    object fallback
  </object>
  <map name=main><area shape=rect coords="0,0,10" href=#x><area href></map>
  <p><ruby>漢<rt>kan<rp>)</ruby> text
  <meter min=10 max=2 value=NaN>bad meter</meter>
  <progress value=abc max=>progress</progress>
  <video controls autoplay="no" poster=><source src=foo type=video/mp4><track kind=subtitles srclang=en>
  <noscript>no script <img src=x></noscript>
</body>
</html>