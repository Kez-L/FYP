<!DOCTYPE html>
<html>
<head>
  <title>Embedded foreign content</title>
</head>
<body>
  <svg width="120" height="80" viewBox="0 0 120 80">
    <defs>
      <linearGradient id="g"><stop offset="0%"/><stop offset="100%"/></linearGradient>
      <clipPath id="c"><circle cx="40" cy="40" r="30"/></clipPath>
    </defs>
    <g transform="translate(2,3)" clip-path="url(#c)">
      <rect x="0" y="0" width="90" height="60" fill="url(#g)"/>
      <text x="4" y="20">A &amp; B</text>
      <foreignObject x="4" y="25" width="100" height="30">
        <div xmlns="http://www.w3.org/1999/xhtml"><em>embedded</em></div>
      </foreignObject>
    </g>
  </svg>
  <math xmlns="http://www.w3.org/1998/Math/MathML">
    <mrow><mi>x</mi><mo>=</mo><mfrac><mn>1</mn><msup><mi>y</mi><mn>2</mn></msup></mfrac></mrow>
  </math>
  <p>after foreign content</p>
</body>
</html>