<html>
<head><title>misnested inline elements</title></head>
<body>
  <p><b><i><u>one</b>two</i>three</u>four
  <p><a href="javascript:alert('x')" title="a > b" foo=bar baz='qux><em>link
  <dl>
    <dt><strong>term
    <dd>definition <ol start=-2 reversed><li>alpha<li value=0>beta<li>gamma</ol>
    <dt><img src alt><dd><input type=checkbox checked=checked checked>
  </dl>
  <address><p>contact<br/>line<br>tail</address>
</body>