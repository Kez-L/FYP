<!DOCTYPE html>
<html>
<head><title>lists tables and recovery</title></head>
<body>
  <ol start="not-a-number" reversed>
    <li value="999999999999999999999">first
    <li>second
      <ul type="square">
        <li>nested A
        <li>nested B
      </ul>
    <li>third
  </ol>
  <dl>
    <dt>term one
    <dd>definition one
    <dt><dt>duplicate term
    <dd><dd>duplicate definition
  </dl>
  <table border=1>
    <colgroup span=2><col width=10><col>
    <thead><tr><th rowspan=9 colspan=0>head<th>extra
    <tbody>
      <tr><td>A<td>B<td>C
      <tr><td colspan=abc>D</tr>
    <tfoot><tr><td>foot</table>
  <p>paragraph starts
  <address>address <b>bold <i>italic</address>
  <pre>line one
line two <code>unterminated
  <blockquote cite="x"><p>quote</blockquote>
  <center><font size=+999 color=#zzzzzz>old formatting</center>
  <div><span>left</div>right</span>
</body>
</html>