<!DOCTYPE html>
<html>
<head><title>ruby and phrasing boundaries</title></head>
<body>
  <section>
    <hgroup><h1>Heading <small>one</small></h1><h2>Subheading</h2></hgroup>
    <p><ruby>漢<rt>かん</rt>字<rp>(</rp><rt>じ</rt><rp>)</rp></ruby>
      <bdi dir="rtl">אבג</bdi><bdo dir="ltr">xyz</bdo>
      <wbr>split<mark>highlight</mark><time datetime="2026-10-08T12:34:56Z">today</time></p>
    <dl>
      <dt>alpha<dd>first
      <dt>beta<dd><ins cite="/a" datetime="bad">added</ins>
      <dt><del>gamma</del><dd><s>removed</s>
    </dl>
    <figure>
      <picture>
        <source media="(min-width: 1px)" srcset="a.webp 1x, b.webp 2x">
        <img src="fallback" alt="a &amp; b" loading="lazy">
      </picture>
      <figcaption>caption without a closing element
    </figure>
  </section>
  <footer><address><a href="tel:+1-2-3">call</a></address></footer>
</body>
</html>