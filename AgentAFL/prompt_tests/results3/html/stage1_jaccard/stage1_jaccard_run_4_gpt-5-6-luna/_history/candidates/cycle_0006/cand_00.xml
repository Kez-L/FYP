<!doctype html>
<html>
  <head>
    <title>Form control state transitions</title>
    <base href="https://example.invalid/forms/">
    <meta name="viewport" content="width=device-width,initial-scale=1">
  </head>
  <body>
    <form action="/submit?x=1&amp;y=2" method="post" enctype="multipart/form-data">
      <fieldset disabled>
        <legend>Account <b>details</legend>
        <label for="user">User</label>
        <input id="user" name="user" type="text" value="a&quot;b" required>
        <label>Password <input name="pw" type="password"></label>
        <select name="role" multiple size="3">
          <option value="one" selected>One
          <option value="two">Two</option>
          <optgroup label="Group &amp; More">
            <option>Three
        </select>
        <textarea name="notes" rows="2" cols="8">first
second</textarea>
      </fieldset>
      <input type="file" name="upload" accept="image/*,.txt" multiple>
      <button type="submit" formaction="/different">Send</button>
      <output name="result" for="user pw">pending</output>
    </form>
  </body>
</html>