<!DOCTYPE html>
<html>
<head>
  <title>foreign content</title>
</head>
<body>
  <svg width="100" height="100" viewBox="0 0 100 100">
    <g transform="rotate(45)" onclick="x<y">
      <rect x="0" y="0" width="20" height="20"></rect>
      <circle cx="40" cy="40" r="10"/>
      <foreignObject width="50" height="50">
        <div xmlns="http://www.w3.org/1999/xhtml"><p>inside foreign</div>
      </foreignObject>
    </g>
  </svg>
  <math display="block">
    <mrow><mi>x</mi><mo>&lt;</mo><mfrac><mn>1</mn><mn>0</mn></mfrac></mrow>
  </math>
  <svg><path d="M0 0 L10 10 Z" /><text x='1' y='2'>text</svg>
</body>
</html>