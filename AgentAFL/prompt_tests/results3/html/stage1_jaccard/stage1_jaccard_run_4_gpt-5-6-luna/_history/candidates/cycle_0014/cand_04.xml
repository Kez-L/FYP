<!doctype html>
<html>
<head><title>raw text and attribute edge cases</title></head>
<body>
<script>
if (a < b && c > d) { document.write("<p>fake</p>"); }
<!-- legacy comment
</script>
<style>
body { background: url("x>y"); }
</style>
<textarea><div>literal &amp; text</textarea>
<iframe src="javascript:alert('x')" name="a" name="b">fallback
<details open=0>
  <summary>first summary</summary>
  <summary>second</summary>
  <p>content
</details>
<dialog open=maybe><form method=dialog><button value=x>close</form></dialog>
<div contenteditable spellcheck="maybe" tabindex="not-an-int">
  <ins cite=x datetime=bad>inserted
  <del cite=y>deleted</ins>
  <bdo dir=sideways>direction</bdo>
  <bdi>isolate</bdi>
</div>
<hr/><br><wbr><hr>
</body>
</html>