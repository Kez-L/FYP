<!DOCTYPE HTML PUBLIC "-//W3C//DTD HTML 4.01 Frameset//EN" "http://www.w3.org/TR/html4/frameset.dtd">
<html>
<head>
  <title>frames and noscript</title>
  <meta http-equiv="refresh" content="0; url=/next">
</head>
<frameset rows="25%,*,0" cols="60%,40%" frameborder="0" border="bad">
  <frame name="left" src="left.html" scrolling="yes" noresize="noresize">
  <frameset cols="*,*">
    <frame src="a.html">
    <frame src="b.html" marginwidth="none">
  </frameset>
  <noframes>
    <body>
      <h1>No frames</h1>
      <p><a target="_top" href="index.html">continue</a></p>
      <iframe src="fallback.html" width="100%" height="auto" sandbox allowfullscreen></iframe>
    </body>
  </noframes>
</frameset>
</html>