<!doctype html>
<html>
<head>
  <meta charset="utf-16">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Mixed namespaces &amp; unusual text</title>
  <style type="text/css">
    @supports (display: grid) { .x::before { content: "\0000"; } }
  </style>
  <script type="application/javascript">
    if (a < b && c > d) { document.write("<em data-v='&amp;'>x</em>"); }
  </script>
</head>
<body>
  <main id="m">
    <svg width="20" height="20" viewBox="0 0 20 20">
      <title>icon</title>
      <g transform="translate(1,2) rotate(45)">
        <path d="M0 0L10 0L10 10Z" fill="none" />
        <foreignObject x="0" y="0" width="10" height="10">
          <div xmlns="http://www.w3.org/1999/xhtml">embedded <b>HTML</b></div>
        </foreignObject>
      </g>
    </svg>
    <math display="block">
      <mrow><mi>x</mi><mo>&InvisibleTimes;</mo><msup><mi>y</mi><mn>2</mn></msup></mrow>
    </math>
    <p data-json="{&quot;a&quot;:[1,2,3]}">before<![CDATA[ raw <tag> & text ]]><span>after</span></p>
  </main>
</body>
</html>