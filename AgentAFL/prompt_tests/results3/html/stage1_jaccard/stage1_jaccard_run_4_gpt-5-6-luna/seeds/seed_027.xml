<!DOCTYPE html>
<html>
<head>
  <title>Lists and definition structures</title>
</head>
<body>
  <ol start="0" reversed type="A">
    <li>alpha
      <ul>
        <li>nested one</li>
        <li>nested two
          <ol><li>deep item</ol>
      </ul>
    <li value="9">omega</li>
  </ol>
  <dl>
    <dt>term one
    <dd>definition one
    <dt><span>term two</span></dt>
    <dd>definition <a href="#missing">with link
    <dt></dt>
    <dd><p>paragraph in definition</p><dd>second definition
  </dl>
  <menu>
    <li><button type=button>Action</button>
    <li><a href="mailto:a@b.invalid">Mail</a>
  </menu>
  <hr>
  <pre>  preserved
 &lt;not-a-tag&gt; &#x1F600;</pre>
</body>
</html>