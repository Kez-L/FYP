<!DOCTYPE HTML>
<html>
<head>
  <title>Object and legacy controls</title>
</head>
<body>
  <object classid="clsid:123" codebase="/x" width="0" height="-1">
    <param name=name value="a&b">
    <param name="movie" value="x.swf">
    fallback <embed src=x type=application/x-shockwave-flash></embed>
  </object>
  <applet code="Foo.class" archive="a.jar,b.jar" align=middle>
    <param name=code value=Foo>
    <text>applet fallback</text>
  </applet>
  <marquee behavior=alternate direction=sideways loop=-1>
    <blink><font face=bad size=99 color=#12>moving</font></blink>
  </marquee>
  <isindex prompt="Search:">
  <center><big><small><strike>legacy</strike></small></big></center>
</body>
</html>