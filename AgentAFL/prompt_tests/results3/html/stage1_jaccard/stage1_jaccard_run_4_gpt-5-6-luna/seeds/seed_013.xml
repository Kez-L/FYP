<html>
<head>
  <title>head insertion and URL attributes</title>
  <base href="//[invalid-host]/a/../b?x=1&y=2">
  <meta charset="">
  <meta http-equiv=refresh content="0; url='javascript:alert(1)'">
  <meta name=description content="a > b < c & d">
  <link rel=stylesheet href=style.css disabled>
