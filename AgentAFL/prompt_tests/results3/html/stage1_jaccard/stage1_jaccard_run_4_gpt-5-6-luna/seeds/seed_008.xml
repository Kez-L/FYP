<!DOCTYPE html>
<html>
<head><title>forms and table sections</title></head>
<body>
  <form id="f" method="post" enctype="multipart/form-data" action="?a=1&amp;b=2">
    <label for="choice">Choose:</label>
    <select id="choice" name="choice" multiple size="0">
      <optgroup label="A"><option value=1 selected>first</option><option>second</optgroup>
      <optgroup label="B"><option disabled value="&quot;">third
    </select>
    <input type="image" src="submit.png" alt="submit" formaction="/other">
    <button name="go" value="&lt;go&gt;">Send</button>
    <output name="result" for="choice">none</output>
  </form>
  <table border="1">
    <caption>irregular grid</caption>
    <colgroup span="2"><col width="20%"><col></colgroup>
    <thead><tr><th rowspan="2">A</th><th colspan="3">B</th></tr><tr><th scope=col>b1<th>b2<td>b3</tr></thead>
    <tbody><tr><td headers="a b" colspan="0">x<td>y</tr></tbody>
    <tfoot><tr><td>footer</td></tr></tfoot>
  </table>
</body>
</html>