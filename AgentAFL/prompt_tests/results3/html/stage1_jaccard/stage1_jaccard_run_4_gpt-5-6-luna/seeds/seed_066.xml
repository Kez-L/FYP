<!DOCTYPE html>
<html>
<head><title>forms and controls</title></head>
<body>
<form action="/submit" method="post" enctype="multipart/form-data">
  <fieldset disabled>
    <legend><input name=legend-value value="x"></legend>
    <label for=a>Name <input id=a name=name type=text required></label>
    <select name=choice multiple size=0>
      <option selected value=one>One
      <option value=two disabled>Two
      <optgroup label=group><option>Three</optgroup>
    </select>
    <textarea name=notes rows=-1 cols="bad">text
    <button type=submit formaction="/other">send
  </fieldset>
  <input type=image src=x alt=y>
  <input type=checkbox checked="false">
  <input type=radio name=r checked>
  <input type=file accept=",,text/plain" multiple="no">
  <output for="a b">result</output>
  <progress value=abc max=-2>loading</progress>
</form>
<form><input name=x><form><input name=y></form></form>
</body>
</html>