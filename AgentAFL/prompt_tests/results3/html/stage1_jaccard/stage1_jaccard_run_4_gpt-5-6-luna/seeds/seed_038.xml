<!DOCTYPE HTML PUBLIC "-//W3C//DTD XHTML 1.0 Strict//EN"
  "http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd">
<html xmlns="http://www.w3.org/1999/xhtml" xml:lang="en">
<head>
  <title>XHTML-style empty elements</title>
  <link rel="alternate" type="application/atom+xml" href="feed?x=1&amp;y=2" />
  <base href="http://example.test/root/" />
</head>
<body>
  <p>first <br /> second <img src="x" alt="x" /></p>
  <ol start="0" reversed="reversed">
    <li value="10">ten
      <ol type="a"><li>nested A</li><li>nested B</li></ol>
    </li>
    <li>after</li>
  </ol>
  <table>
    <thead><tr><th scope="col">A</th><th scope="col">B</th></tr></thead>
    <tbody><tr><td rowspan="2">one</td><td>two</td></tr></tbody>
    <tfoot><tr><td colspan="3">foot</td></tr></tfoot>
    <tbody><tr><td>late</td></tr></tbody>
  </table>
  <pre xml:space="preserve">  leading
    spaces&#13;&#10;end</pre>
</body>
</html>