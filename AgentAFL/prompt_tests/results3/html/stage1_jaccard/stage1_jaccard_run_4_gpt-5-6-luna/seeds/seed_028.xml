<!doctype html>
<html>
<head>
  <meta charset="ISO-8859-1">
  <title>Media and metadata</title>
  <link rel=stylesheet href=a.css media="screen and (min-width: 2px)">
  <link rel="alternate" type="application/json" href="/data">
</head>
<body>
  <picture>
    <source media="(min-width: 800px)" srcset="large.jpg 1x, large-2.jpg 2x">
    <source type="image/webp" srcset="small.webp">
    <img src="fallback.jpg" alt="fallback" width="20" height="10" loading=lazy>
  </picture>
  <audio controls autoplay loop preload="metadata">
    <source src="sound.ogg" type="audio/ogg">
    <source src="sound.mp3">
    fallback <a href="sound.mp3">download</a>
  </audio>
  <video width="320" height="180" poster=cover.jpg controls>
    <track kind=subtitles src="sub.vtt" srclang=en label=English default>
    <track kind=chapters src=chap.vtt>
    video fallback
  </video>
  <iframe srcdoc="<p>inside &amp; frame</p>" sandbox="allow-scripts" loading=lazy></iframe>
  <object data="movie.bin" type="application/octet-stream">
    <param name="autoplay" value="false">
    object fallback
  </object>
</body>
</html>