<!doctype html>
<html>
<head><title>forms and options</title></head>
<body>
<form action="/submit" method=post enctype="multipart/form-data" novalidate>
  <label for=user>Name<label><input id=user name=user value="a>b" disabled readonly>
  <input type=number min=10 max=2 step=0 value=3>
  <input type=image src=x alt=go>
  <select name=choice multiple size=0>
    <option selected value=one>One
    <option value=two disabled>Two</option>
    <optgroup label="Group"><option>Three</optgroup>
  </select>
  <textarea name=note rows=2 cols=4>first
second</textarea>
  <button type=submit><span>send</button>
  <fieldset disabled><legend>Info</legend><input name=x></fieldset>
</form>
<details open><summary>More</summary><p>inside details</details>
<meter value=abc min=high max=low>meter</meter>
<progress value=1 max=>loading</progress>
</body>
</html>