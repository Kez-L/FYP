<!doctype html>
<html>
<head>
  <title>Mixed namespaces &amp; malformed boundaries</title>
  <meta charset=utf-8>
  <style>
    @media screen and (min-width:0) { body { color: rgb(1,2,3); } }
    </style attr="broken">
  <script>
    var template = "<div title='x'> &amp; </div>";
    if (a && b < c) { /* unterminated-looking text */ }
  </script>
</head>
<body>
  <svg width="10" viewBox="0 0 10 10">
    <foreignObject width="8" height="8">
      <div xmlns="http://www.w3.org/1999/xhtml">inside</div>
    </foreignObject>
    <path d="M0 0 L10 10 Z" fill="url(#missing)" />
  </svg>
  <math display="block">
    <mrow><mi>x</mi><mo>&InvisibleTimes;</mo><mfrac><mn>1</mn><mtext>two</mtext>
  </math>
  <p><b><i><u>crossing</b> nesting</u> remains</i>
  <div data-x="a&b" data-y='c"d' data-z==value>text</div>
</body>
</html>