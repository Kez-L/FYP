<!doctype html>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:xlink="http://www.w3.org/1999/xlink">
<head><title>Namespaced embedded content</title></head>
<body>
  <svg width="120" height="80" viewBox="0 0 120 80" preserveAspectRatio="bad">
    <title>vector</title>
    <g transform="translate(1,2) rotate(foo)">
      <rect x="-1" y="NaN" width="100%" height="20" fill="url(#missing)"/>
      <circle cx="20" cy="20" r="-4"></circle>
      <path d="M0 0 L 10,10 Q bad" stroke-width="1e3"></path>
      <foreignObject width="50" height="20"><div>HTML in SVG</div></foreignObject>
    </g>
    <use xlink:href="#unknown" href="##double"></use>
  </svg>
  <math display="sideways">
    <mrow><mi>x</mi><mo>&InvisibleTimes;</mo><mfrac><mn>1</mn><mroot><mi>y</mi></mroot></mfrac></mrow>
    <annotation encoding="application/x-unknown"><![CDATA[<not markup>]]></annotation>
  </math>
  <p><custom-widget data-a="&bad;" /><x-one><x-two>nested</x-one>tail</x-two></custom-widget></p>
</body>
</html>