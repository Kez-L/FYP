<!doctype html>
<html>
<head>
  <title>Interactive and obsolete elements</title>
</head>
<body>
  <details open="yes">
    <summary>More information</summary>
    <p>Hidden content made visible.</p>
    <dialog open>Dialog text <button>Close</button></dialog>
  </details>
  <object data="movie.bin" type="application/octet-stream" width="10" height="10">
    <param name=autoplay value=true>
    <param name="loop" value="0">
    <embed src="fallback.swf" pluginspage="about:blank">
    <noembed>Object fallback <img src=alt.png></noembed>
  </object>
  <marquee behavior=alternate direction=sideways scrollamount="x">
    <blink>moving <font face="serif" color="#12" size=99>legacy</font></blink>
  </marquee>
  <center>
    <big>Large</big><small>small</small>
    <strike>old</strike><tt>fixed</tt>
  </center>
  <iframe srcdoc="<p>inner &amp; text</p>" sandbox="allow-scripts allow-forms"
          name="sub" width=0 height=0></iframe>
  <noscript>
    <p>No script <a href='x' title='y>z'>fallback</a></p>
  </noscript>
</body>
</html>