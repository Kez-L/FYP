<!doctype html>
<html>
<head><title>SVG Math and foreign content</title></head>
<body>
<svg width="100" viewBox="0 0 10 10">
  <title>vector</title>
  <defs><linearGradient id=g><stop offset="0%"><stop offset="100%"></linearGradient></defs>
  <g transform="translate(1 2)" onclick="x<y">
    <rect x="0" y="0" width="5" height="5" fill="url(#g)"></rect>
    <circle cx="4" cy="4" r="3"/>
    <path d="M0 0 L10 10 Q 4 5 8 2 Z" stroke-width="bad">
  </g>
  <foreignObject x=0 y=0 width=9 height=9>
    <div xmlns="http://www.w3.org/1999/xhtml"><p>embedded html</div>
  </foreignObject>
</svg>
<math display="block">
  <mi>x</mi><mo>&lt;</mo><mfrac><mn>1</mn><mrow><mi>y</mi><mo>+</mo></mfrac>
  <annotation encoding="application/x-tex">x_{i}</annotation>
</math>
<p>after math <svg><text>text<g>broken</svg> end
</body>
</html>