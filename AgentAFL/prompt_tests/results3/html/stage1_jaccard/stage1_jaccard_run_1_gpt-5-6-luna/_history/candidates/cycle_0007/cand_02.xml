<html>
<head>
  <title>Forms with unusual controls</title>
  <meta name="viewport" content="width=device-width">
</head>
<body>
  <form action="/submit" method="POST" enctype="multipart/form-data" accept-charset="utf-8">
    <fieldset disabled>
      <legend><input type=text value="legend control"></legend>
      <label for=x>Name <input id=x name=name value="a" checked></label>
      <textarea name=note rows=0 cols=-1>line one
line two
</textarea>
      <select name=choice multiple size=0>
        <option value=1 selected>One
        <option>Two
        <optgroup label="Group"><option value=3>Three
      </select>
    </fieldset>
    <input type=image src=x alt="go">
    <input type=radio name=r checked checked>
    <input type=checkbox name=c disabled=false>
    <button type=submit><img src=x>Submit</button>
    <output name=result for="x">old</output>
  </form>
  <form>
    <input name=a>
  </form>
  <input name=outside form=no-such>
</body>
</html>