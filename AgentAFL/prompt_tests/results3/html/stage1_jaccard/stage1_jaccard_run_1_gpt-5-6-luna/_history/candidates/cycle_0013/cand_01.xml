<!DOCTYPE HTML PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">
<head><title>Namespaced fragments</title></head>
<body>
  <svg viewBox="0 0 10 10" xmlns="http://www.w3.org/2000/svg">
    <foreignObject><div xmlns="http://www.w3.org/1999/xhtml"><p>inside</div></foreignObject>
    <path d="M0 0 L10 10" fill="url(#x)"/>
    <use href="#x"><g id="x"><text>vector</text></g>
  </svg>
  <math><mi>x</mi><mo>&InvisibleTimes;</mo><mrow><mn>2</mn></mrow></math>
  <p><b><i><u>crossed</b> tags</u></i>
  <x-custom a:b="c" disabled="false"></x-custom>
</body>
</html>