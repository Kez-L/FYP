<!doctype HTML>
<html>
<head>
  <title>misnested inline formatting and lists</title>
</head>
<body>
  <ol start="not-a-number" reversed>
    <li>first
    <li value="999999999999999999999999">second
      <ul type="square">
        <li><b>bold <i>italic <u>under <s>strike</li>
        <li><font size="+999" color="#gggggg" face=>text</font>
      </ul>
    <li>third
  </ol>
  <dl>
    <dt>term <dd>definition
    <dt><dt><dd><dd>empty chain
  </dl>
  <blockquote cite=unquoted&bad>
    <pre>  leading
      <code>literal <tag attr='x'> bytes &amp broken</code>
    </pre>
  </blockquote>
  <center><div align=middle><p>one<p>two<p>three</center>
  <marquee direction=sideways behavior=explode loop=-3>
    <blink>old <big>elements <small>everywhere</blink></big></small>
  </marquee>
  <address><a href="x" target="_self"><b><i>contact</a></i></b></address>
</body>
</html>