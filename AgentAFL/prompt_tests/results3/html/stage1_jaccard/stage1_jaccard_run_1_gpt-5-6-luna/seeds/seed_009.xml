<!DOCTYPE HTML PUBLIC "-//IETF//DTD HTML 2.0//EN">
<html lang="x">
<head>
  <title>frameset oddities</title>
  <meta name="viewport" content="width=device-width">
</head>
<frameset cols="*,2,0" rows="50%,">
  <frame src="left.html" name=left noresize scrolling=maybe>
  <frameset>
    <frame src=right.html>
    <noframes>
      <body>
        <header><nav><a href=#one>one<a href=#two>two</nav></header>
        <main id=one><article><section><h2>section</h1>
          <p>text <mark>marked <small>small</p></section>
        </article></main>
        <footer id=two>footer</footer>
      </body>
    </noframes>
  </frameset>
</frameset>
</html>