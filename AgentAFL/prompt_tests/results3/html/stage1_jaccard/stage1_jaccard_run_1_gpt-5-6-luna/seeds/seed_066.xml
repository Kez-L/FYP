<!DOCTYPE html>
<html>
<head>
  <title>foreign content</title>
</head>
<body>
  <svg width="10" height="10" viewBox="0 0 10 10" preserveAspectRatio="none">
    <g transform="translate(1 2)" onclick="x<y">
      <circle cx="2" cy="2" r="1" fill="url(#x)"/>
      <foreignObject><div xmlns="http://www.w3.org/1999/xhtml">
        <p>HTML inside SVG <b>bold</p>
      </div></foreignObject>
      <path d="M0 0 L 3 4 Z" stroke-width="bad"></path>
    </g>
  </svg>
  <math display="block">
    <mrow><mi>x</mi><mo>&lt;</mo><mn>2</mn><mo>&amp;</mo>
      <msup><mi>y</mi><mn>2</mn></msup>
    </mrow>
    <annotation-xml encoding="application/xhtml+xml">
      <div xmlns="http://www.w3.org/1999/xhtml"><em>math payload</em></div>
    </annotation-xml>
  </math>
  <svg><title>svg title</title><desc>desc</desc><use href="#missing"></use>
    <text x="1" y="2">text &amp; &#x1F4A9;</text>
  </svg>
  <p>after foreign content</p>
</body>
</html>