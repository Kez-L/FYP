<!DOCTYPE html>
<html>
<head>
  <title>Table model edge cases</title>
</head>
<body>
  <table border="1" cellpadding="2">
    <caption align="bottom">Quarterly figures</caption>
    <colgroup span="2" width="25%">
      <col class=q1>
      <col class=q2>
    </colgroup>
    <colgroup><col span="3"></colgroup>
    <thead>
      <tr><th rowspan=2 scope=col>Item</th><th colspan=4>Amounts</th></tr>
      <tr><th abbr=jan>Jan</th><th>Feb</th><th>Mar</th><th>Sum</th></tr>
    </thead>
    <tbody>
      <tr><th scope=row>North</th><td>1</td><td></td><td colspan=2>3</td></tr>
      <tr><th scope=row>South</th><td rowspan=2>4</td><td>5</td><td>6</td></tr>
      <tr><th scope=row>West</th><td>7</td><td>8</td><td>9</td></tr>
    </tbody>
    <tfoot>
      <tr><th>Total</th><td>10</td><td>12</td><td>14</td><td>36</td></tr>
    </tfoot>
  </table>
  <p>Text between tables</p>
  <table>
    <tr><td>A<tr><td>B
    <tbody><tr><td>C</tbody>
  </table>
</body>
</html>