<!DOCTYPE HTML PUBLIC "-//W3C//DTD HTML 4.01//EN">
<html>
<head>
  <title>Form control maze</title>
  <meta name="description" content="a &quot;quoted&quot; description">
</head>
<body>
  <form action="/submit?x=1&amp;y=2" method="post" enctype="multipart/form-data">
    <fieldset disabled>
      <legend>Profile <b>details</legend>
      <label for="uid">Identifier
      <input id=uid name=user value="A&B" maxlength=12>
      <select name=kind multiple size=3>
        <optgroup label="first">
          <option value=one selected>One
          <option value="two">Two</option>
        </optgroup>
        <option disabled value=three>Three
      </select>
      <textarea name=note rows=2 cols=12>line one
line &amp; two</textarea>
    </fieldset>
    <input type=image src="button.png" alt="send" border=0>
    <button type=submit name=go value="ok"><i>Submit</i></button>
    <input type=hidden name=token value='x"y=z'>
  </form>
  <dl>
    <dt>Term <dd>Definition
    <dt><a href="/x">Another term</a>
    <dd><p>Nested description</p>
  </dl>
</body>
</html>