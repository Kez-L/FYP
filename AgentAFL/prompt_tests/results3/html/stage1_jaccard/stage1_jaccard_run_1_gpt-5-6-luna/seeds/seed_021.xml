<!DOCTYPE HTML PUBLIC "-//IETF//DTD HTML 2.0//EN">
<html>
  <head>
    <title>frameset experiment
    <base target=_blank>
    <link rel=stylesheet href=//example.invalid/a.css disabled>
  </head>
  <frameset rows="*,0,*,">
    <frame src="a.html" name=left scrolling=maybe frameborder=-1>
    <frameset cols="25%,bad,">
      <frame src=javascript:alert(1) noresize>
      <frame src="" marginwidth=999999 marginheight=-8>
      <noframes>
        <body>
          <h1>Fallback</h1>
          <p><a href="mailto:x@y">link
          <form><input><button><select><option selected>one<option>two</select>
          <textarea rows=999 cols=-1>unterminated
        </body>
      </noframes>
    </frameset>
    <frame>
  </frameset>
  <body>
    <p>This body follows a frameset and should be relocated.
    <table border=0>
      <tr><td>A
      <tr><th>B</table>
  </body>
</html>