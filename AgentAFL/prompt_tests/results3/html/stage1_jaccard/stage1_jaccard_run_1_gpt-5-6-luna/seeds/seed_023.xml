<!DOCTYPE html>
<html>
<head><title>forms with odd token boundaries</title></head>
<body>
  <form name=f action="/a?x=1&y=2" method=get>
    <input type=text name=x disabled=disabled required=required>
    <input type=checkbox checked="checked" checked=false>
    <input type=radio name=r value=1><input type=radio name=r value=2 checked>
    <select name=s multiple size=zero>
      <optgroup label="Group 1" disabled>
        <option value=1 selected>one
        <option value=2>two
      </optgroup>
      <option>three
    </select>
    <textarea name=t wrap=sideways rows=0 cols=abc>line1
line2 &copy &#x; &#9999999999;</textarea>
    <button type=maybe formaction="/submit">Go <input type=hidden></button>
    <output for="x y">result</output>
    <meter min=10 max=2 low=NaN high=Infinity value=-999></meter>
    <progress max=-1 value=2>loading
  </form>
  <form>
    <label><input type=image src= data-x="a" alt=">"></label>
    <keygen challenge="unterminated>
    <isindex prompt="Search:">
    <fieldset><legend><legend>nested</fieldset>
  </form>
  <input form=missing type=file accept="*/*,," capture=maybe>
  </body attr="after">
</html>