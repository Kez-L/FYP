<!doctype html>
<html>
<head>
  <title>form controls</title>
</head>
<body>
  <form action="/submit" method="post">
    <input type="text" name="q" disabled=disabled checked="checked">
    <select name="choice">
      <option value=one>One
      <option value="two" selected>Two
      <optgroup label="broken>
        <option>Three
    </select>
    <textarea name="notes">text <b>not really markup</textarea>
    <button type=submit><label for=x>Go</button>
  </form>
  <form><input name="outer"><form><input name="inner"></form></form>
</body>
</html>