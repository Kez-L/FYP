<!doctype html>
<html xmlns="http://www.w3.org/1999/xhtml" xml:lang="fr">
<head>
  <title>Mixed namespace recovery</title>
  <style type="text/css">
    <![CDATA[
      .x { color: red; }
    ]]>
  </style>
  <script type="application/javascript">
    if (a < b && c > d) { document.write("<em>script</em>"); }
  </script>
</head>
<body>
  <svg width="120" height="80" viewBox="0 0 120 80">
    <title>Vector title</title>
    <g transform="rotate(4 20 20)">
      <path d="M0,0 L10,20 Q30,40 50,10 Z" fill="none" stroke="black"/>
      <foreignObject x="2" y="2" width="80" height="30">
        <div xmlns="http://www.w3.org/1999/xhtml"><span>embedded text</span></div>
      </foreignObject>
    </g>
  </svg>
  <math display="block">
    <mrow><mi>x</mi><mo>=</mo><msup><mi>y</mi><mn>2</mn></msup></mrow>
  </math>
  <p><span class="x">after namespaces</span></p>
</body>
</html>