<!doctype HTML PUBLIC "-//IETF//DTD HTML 3.2//EN">
<html>
  <head>
    <base href="http://example.test/a/b/">
    <isindex prompt="Search:">
    <title>Frameset replacement</title>
  </head>
  <frameset rows="*,50,0" cols="25%,*,25">
    <frame src="left.html" name="left" noresize="noresize">
    <frameset cols="*">
      <frame src="" frameborder=maybe>
      <noframes>
        <body>
          <h1>Fallback</h1>
          <a href=http://example.test/?a=1&b=2>broken URL</a>
          <img src=missing.gif alt="fallback">
        </body>
      </noframes>
    </frameset>
    <frame src="right.html" scrolling="sometimes">
  </frameset>
  <body>
    <p>Content after frameset that should be recovered.</p>
  </body>
</html>