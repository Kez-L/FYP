<!doctype html>
<html>
<head><title>definition nesting</title></head>
<body>
  <hgroup><h1>Terms</h1><h6>old markup</h6></hgroup>
  <dl compact="false">
    <dt><b>alpha
    <dd>first meaning
      <dl>
        <dt>nested <em>term</em></dt>
        <dd><p>description without closure
    <dt title='x"y>omega</dt>
    <dd><blockquote cite=broken://quote><q>quoted &unknown; text</blockquote>
  </dl>
  <ol start="zero" type=Z reversed="maybe">
    <li value=abc>one
    <li><ul compact><li>two<li><li>three</ul>
  </ol>
  <menu type=context><li><a href=#x>action</a><li>unclosed menu
  <address>mail &copy <span class=unclosed>author</address>
