<!DOCTYPE html>
<html>
<head><title>Lists and Definitions</title></head>
<body>
<dl compact="maybe"><dt>First<dd>alpha<dt><dt>Second<dd><p>beta
<ul type="square"><li>one<li><ul><li>nested</ul><li>three</ul>
<ol start="zero" reversed="false"><li value="NaN">x<li>y</ol>
<menu><li><a href=#x>link</a><li><button name="b" value="v">button</button></menu>
<blockquote cite="&"><q>quote<cite>source</cite></blockquote>
</body>
</html>