<!DOCTYPE HTML PUBLIC "-//W3C//DTD HTML 4.01 Frameset//EN"
 "http://www.w3.org/TR/html4/frameset.dtd">
<html lang="x">
<head><title>frameset</title></head>
<frameset cols="20%,*,bad" border="0">
  <frame src="left.html" name="left" scrolling="no">
  <frameset rows="50%,50%">
    <frame src="top.html">
    <frame src="" noresize>
  </frameset>
  <noframes>
    <body><h1>Fallback</h1><p>text</p></body>
  </noframes>
</frameset>
</html>