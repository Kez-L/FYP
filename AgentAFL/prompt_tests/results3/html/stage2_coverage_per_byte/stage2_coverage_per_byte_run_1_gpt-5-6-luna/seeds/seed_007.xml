<!doctype html>
<html>
<head>
<title>embedded content</title>
<base target="_blank">
</head>
<body>
<figure>
<svg width="40" height="20"><g><rect x="0" y="0" width="10" height="10"></g></svg>
<figcaption>image <br> caption</figcaption>
</figure>
<object data="movie.bin" type="application/octet-stream">
  <param name="autoplay" value="true">
  <embed src="fallback.swf" width="0" height="-1"></embed>
  <p>object fallback
</object>
<map name="m"><area shape="rect" coords="0,0,10,10" href="#"><area></map>
<img src="x" usemap="#m" alt="x">
</body>
</html>