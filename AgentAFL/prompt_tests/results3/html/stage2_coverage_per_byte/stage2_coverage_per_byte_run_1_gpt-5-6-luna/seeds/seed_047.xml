<!DOCTYPE HTML>
<HTML>
<HEAD><TITLE>Form edge cases</TITLE></HEAD>
<BODY>
<FORM ACTION="javascript:&#34;&gt;" METHOD="INVALID" ENCTYPE="x/y" ACCEPT-CHARSET=",,utf-8">
<INPUT NAME="a" TYPE="radio" CHECKED="false" VALUE="&quot;">
<INPUT NAME="b" TYPE="file" SIZE="-999" MAXLENGTH="abc">
<LABEL FOR="missing">Name<INPUT ID="dup" ID="dup" VALUE="x"></LABEL>
<SELECT NAME="s" MULTIPLE="0" SIZE="zero">
<OPTION SELECTED>first
<OPTGROUP LABEL="&bad;" DISABLED="no"><OPTION VALUE="2">second
</SELECT>
<TEXTAREA NAME="t" WRAP="sideways" ROWS="999999999999999999999">a&amp;b</TEXTAREA>
<BUTTON TYPE="submit"><IMG ALT="x"></BUTTON>
</FORM>
</BODY>
</HTML>