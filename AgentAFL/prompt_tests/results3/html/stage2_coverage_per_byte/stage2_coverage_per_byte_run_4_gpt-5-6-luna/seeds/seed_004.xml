<html>
  <head>
    <title>frames and declarations</title>
  </head>
  <frameset rows="20%,*">
    <frame src="left.html" name="left">
    <frameset cols="50%,50%">
      <frame src="a.html">
      <frame src="b.html">
      <noframes>
        <body>
          <object data="movie.bin" type="application/octet-stream">
            <param name="x" value="1">
            fallback <img src="missing" alt="fallback">
          </object>
        </body>
      </noframes>
    </frameset>
  </frameset>
</html>