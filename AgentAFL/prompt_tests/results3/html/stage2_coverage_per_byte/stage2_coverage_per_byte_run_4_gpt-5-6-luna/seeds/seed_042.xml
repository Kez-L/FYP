<html>
<head>
<title>Foreign and embedded markup</title>
</head>
<body>
<svg width="10" height="10" viewBox="0 0 10 10">
<foreignObject width="10" height="10">
<div xmlns="http://www.w3.org/1999/xhtml">html in svg
<br/></div>
</foreignObject>
<path d="M0 0 L10 10" fill="none"></path>
</svg>
<math xmlns="http://www.w3.org/1998/Math/MathML">
<mrow><mi>x</mi><mo>&InvisibleTimes;</mo><msup><mi>y</mi><mn>2</mn></msup></mrow>
</math>
<object data="blob:invalid" type="application/x-unknown">
<param name="movie" value="a&b">
<embed src="x" width="0" height="-1">
fallback <iframe srcdoc="<p>nested</p>" name="f"></iframe>
</object>
</body>
</html>