<!DOCTYPE html PUBLIC "-//W3C//DTD HTML 4.01 Frameset//EN" "http://www.w3.org/TR/html4/frameset.dtd">
<html>
<head><title>frame maze</title></head>
<frameset cols="20%,*,0" border="999" frameborder="no">
<frame name="left" src="left.html" scrolling=auto noresize>
<frameset rows="*,25">
<frame srcdoc="<html><body><p>embedded &amp; fragment</p></body></html>" name=middle>
<frame src="right.html" marginwidth=-1 marginheight="999999">
<noframes>
<body>
<h1>fallback</h1>
<object data="movie.bin" type="application/octet-stream" width=0 height=-20>
<param name=loop value=infinite>
<object><embed src=x></object>
</object>
</body>
</noframes>
</frameset>
</frameset>
</html>