<!DOCTYPE html>
<html>
<head><title>Ruby and bidi elements</title></head>
<body dir=rtl>
<p lang="ja"><ruby>漢<rt>かん<rp>(</rp>字<rp>)</rp></ruby>
<bdi dir=ltr>abc &lrm; 123</bdi> <bdo dir=rtl>left <i>right</bdo></p>
<article itemscope itemtype="http://schema.org/Person">
  <header><h1 itemprop=name>أسم</h1></header>
  <p itemprop=description>text <data itemprop=age value=٣>٣</data></p>
  <time itemprop=birthDate datetime="not-a-date">tomorrow</time>
  <meter min=10 max=5 low=20 high=-1 optimum=abc value=999>meter</meter>
  <progress max=-2 value=3>loading</progress>
  <footer><small>©</small></footer>
</article>
<figure>
  <figcaption>Caption before image</figcaption>
  <picture>
    <source media="(min-width: 1px)" srcset="a 1x, b 2x">
    <source type="image/webp" srcset="">
    <img src="" alt="&copy; &unknown;">
  </picture>
</figure>
</body>
</html>