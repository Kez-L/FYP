<!DOCTYPE html>
<html>
<head><title>Form controls and lists</title></head>
<body>
<form id="f" action="/go" method="get">
<input type="hidden" name="token" value="&quot;quoted&quot;">
<fieldset><legend>Search</legend>
<input name="q" required autofocus>
<button type="submit" formaction="/alt">Go <img src="go.png"></button>
</fieldset>
<datalist id="choices"><option value="one">First<option value=two>Second</datalist>
<label>Pick <select name="x" multiple size="2">
<option disabled selected>Choose</option>
<optgroup label="A"><option value="a">A<option value="b">B</optgroup>
</select></label>
<textarea name="notes" rows="2" cols="4">raw &lt;tag&gt;</textarea>
</form>
<dl><dt>Term<dd>Definition<dt>Another<dd><p>Nested definition</p></dl>
</body>
</html>