<!DOCTYPE HTML PUBLIC "-//W3C//DTD HTML 4.01//EN" "http://www.w3.org/TR/html4/strict.dtd">
<html>
<head><title>misnested controls</title></head>
<body>
<p><b><i>one</b>two</i>three
<dl><dt>term<dd>definition<dt><li>mixed item</dl>
<ul compact="0"><li>first<ul><li>nested</ul><li>last
<menu><li type="square">menu item</menu>
<form>
<table><tr><td><input type=text name=a><tr><td>
<textarea cols="999" rows="-4">value &lt; end</textarea>
</td></tr></table>
</form>
<marquee direction=sideways><blink>old</blink></marquee>
<small><big><font face="x" size=+99 color=#12G>text</font></big></small>
</body>
</html>