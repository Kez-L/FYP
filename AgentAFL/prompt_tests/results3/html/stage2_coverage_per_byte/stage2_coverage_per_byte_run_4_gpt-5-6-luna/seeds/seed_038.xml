<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml">
<head><title>Mixed namespace markup</title></head>
<body>
<svg width="80" height="40" viewBox="0 0 80 40">
<g transform="translate(2,2)"><rect x="0" y="0" width="40" height="20"></rect>
<foreignObject x="4" y="4" width="30" height="15">
<div xmlns="http://www.w3.org/1999/xhtml">svg text</div>
</foreignObject></g>
</svg>
<math><mi>x</mi><mo>&lt;</mo><mn>2</mn><mrow><mo>+</mo><mi>y</mi></mrow></math>
<p><span style="font-weight:bold">following text</span>
</body>
</html>