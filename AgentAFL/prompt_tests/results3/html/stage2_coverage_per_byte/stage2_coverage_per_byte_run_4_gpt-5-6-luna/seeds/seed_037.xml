<!doctype html>
<html>
<head>
<title>Embedded content boundaries</title>
<style type="text/css">
.box { color: red; background: url("a;b.png"); }
</style>
<script type="text/javascript">
if (a < b) { document.write("<div class='generated'>x</div>"); }
</script>
</head>
<body>
<object data="movie.bin" type="application/octet-stream" width="120" height="80">
<param name="autoplay" value="true">
<embed src="fallback.swf" width="120" height="80">
<p>Object fallback <span>text</object>
<iframe srcdoc="<p>inner &amp; text</p>" name="preview">
fallback iframe text
</iframe>
</body>
</html>