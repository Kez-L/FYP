  </fieldset>
  <input type=hidden name=h value="&notanentity">
  <input type=checkbox checked=checked checked=no>
  <input type=radio name=r value=1><input type=radio name=r value=2 checked>
  <select name=s multiple="multiple">
    <optgroup label="Group">
      <option value=one selected>One
      <option>Two</option>
    </optgroup>
    <option disabled value="three">Three
  </select>
  <textarea name=t wrap=hard cols="0">first
second
</textarea>
  <output for="u p">result</output>
</form>
