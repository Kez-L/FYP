<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<title>Frameset and map stress</title>
</head>
<frameset rows="20%,*,30%" cols="*" frameborder="yes">
  <frame src="about:blank" name="top" scrolling="auto" noresize>
  <frameset cols="25%,75%">
    <frame srcdoc="<p>inline frame</p>" name="left">
    <frame src="javascript:void(0)" name="right">
  </frameset>
  <noframes>
    <body>
      <h1>Fallback</h1>
      <map name="m">
        <area shape="rect" coords="0,0,10,10" href="#one">
        <area shape="circle" coords="4,4,2" href="x">
        <area shape="poly" coords="1,2,3,4,5" nohref>
      </map>
      <img src="x" usemap="#m" ismap alt="">
      <a name="one"></a>
    </body>
  </noframes>
</frameset>
</html>