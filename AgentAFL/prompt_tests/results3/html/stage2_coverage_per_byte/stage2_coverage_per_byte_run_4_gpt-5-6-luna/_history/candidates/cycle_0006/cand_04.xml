<!doctype html>
<html>
<head>
<title>Obsolete and foreign content</title>
</head>
<body>
<marquee behavior=alternate direction=left loop=-1>
  <blink>moving <font face="serif" size="+7" color=#12zz90>text</font>
</marquee>
<svg width="10" height="10" viewBox="0 0 10 10">
  <title>icon</title>
  <foreignObject x="0" y="0" width="10" height="10">
    <div xmlns="http://www.w3.org/1999/xhtml">foreign <b>content</b></div>
  </foreignObject>
  <path d="M0 0 L10 10 Z" fill="url(#x)"/>
</svg>
<math display=block>
  <mi>x</mi><mo>&InvisibleTimes;</mo><mfrac><mn>1</mn><mn>0</mn></mfrac>
</math>
<center>
  <applet code="x.class" archive="a.jar" width=0 height=-1>
    <param name=movie value="x&amp;y">
    fallback
  </applet>
</center>
<isindex prompt="Search:">
<hr>
</body>
</html>