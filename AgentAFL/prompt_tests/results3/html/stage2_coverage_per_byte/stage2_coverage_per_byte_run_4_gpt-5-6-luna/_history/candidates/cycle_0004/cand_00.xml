<!DOCTYPE HTML PUBLIC "-//W3C//DTD HTML 3.2 Final//EN">
<html>
<head>
  <base href="http://example.invalid/a/">
  <isindex prompt="Find:">
  <title>frameset sample</title>
</head>
<frameset rows="25%,*,0" border="7" frameborder="no">
  <frame src="top.html" name=top scrolling=auto noresize>
  <frameset cols="180,*" onload="init()">
    <frame src='nav.html' name="nav" marginwidth=0 marginheight="x">
    <frame src="content.html" name=main>
    <noframes>
      <body bgcolor=#ffffcc text=black>
        <h1>Navigation</h1>
        <p><a href="content.html">Continue &copy; now</a>
        <img src=map.gif border=0 usemap=#links ismap>
        <map name=links>
          <area shape=rect coords="0,0,40,40" href=a.html alt=one>
          <area shape="circle" coords="90,20,12" href="b.html">
        </map>
        <object data="missing.bin" type=application/octet-stream width=0 height=-4>
          <param name=autoplay value=true>
          fallback <embed src="x" hidden="false"></embed>
        </object>
      </body>
    </noframes>
  </frameset>
</frameset>
</html>