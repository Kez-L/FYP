<!DOCTYPE HTML PUBLIC "-//W3C//DTD HTML 4.01//EN">
<html>
<head>
<title>Frameset transition</title>
</head>
<frameset cols="30%,*,0" border="7" frameborder="no">
<frame src="left.html" name="nav" noresize scrolling="auto">
<frameset rows="40,*">
<frame src="top.html">
<noframes>
<body>
<h1>Fallback</h1>
<p>This fallback contains <img src="missing.gif" alt="broken image">
<map name="m"><area shape="rect" coords="0,0,20,20" href="#x"></map>
</body>
</noframes>
</frameset>
</frameset>
</html>