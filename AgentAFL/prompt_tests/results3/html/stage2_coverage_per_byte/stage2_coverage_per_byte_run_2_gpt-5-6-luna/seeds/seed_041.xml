<!doctype html>
<html>
<head>
<title>Frames and forms</title>
</head>
<frameset rows="40%,*" border=0>
<frame src="top.html" name=top scrolling=no>
<frameset cols="25%,75%">
<frame src=nav.html frameborder=1>
<frame src=content.html>
<noframes>
<body>
<form action="/submit" method=post enctype="multipart/form-data">
<fieldset disabled>
<legend>Choose</legend>
<label for=x>Name:</label><input id=x name=user value="a&b">
<select name=kind multiple size=2>
<option selected value=one>One
<option value=two>Two
</select>
<textarea name=notes rows=2 cols=8>unclosed
<input type=submit value=Send>
</fieldset>
</form>
</body>
</noframes>
</frameset>
</frameset>