<!DOCTYPE HTML>
<html>
<head><title>Legacy inline constructs</title></head>
<body>
<center>
<marquee behavior=alternate direction=left width=100>
<blink>moving &copy text</blink>
</marquee>
<font face="Arial" size=+3 color=red>
This is <u>underlined <strike>crossed</u> text</strike>
</font>
<applet code="X.class" width=10 height=10>
<param name=foo value="bar">
<param name=empty>
fallback <object data="movie.bin" type=application/octet-stream>
<param name=data value=x>
</object>
</applet>
<hr noshade size=0>
<small><sup>2</sup><sub>n</sub></small>
</center>
</body>
</html>