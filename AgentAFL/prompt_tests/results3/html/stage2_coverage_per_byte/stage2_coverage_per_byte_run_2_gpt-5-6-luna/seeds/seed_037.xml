<!DOCTYPE HTML PUBLIC "-//W3C//DTD HTML 4.01//EN">
<html dir=rtl>
<head><title>Lists and block boundaries</title></head>
<body>
<blockquote cite="x">
<address>first line<br>second line
<ul compact>
<li value=0>zero
<li><ol start=-3 type=I>
<li>nested one
<li><li>empty transition
</ol>
<li>after
</ul>
<menu>
<li><a href="javascript:alert('x')">link
<li><img src alt=missing>
</menu>
<isindex prompt="Search:">
<h1>heading
<p>paragraph <em>em <strong>strong</p>tail</strong></em>
</blockquote>
</body>
</html>