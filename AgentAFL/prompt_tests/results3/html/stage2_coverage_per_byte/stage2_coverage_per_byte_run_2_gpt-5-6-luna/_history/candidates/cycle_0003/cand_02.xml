<!DOCTYPE html>
<html>
<head><title>form controls</title></head>
<body>
  <form id=f action="submit" method=get accept-charset="UTF-8, ISO-8859-1">
    <fieldset disabled>
      <legend>Pick &lt;one&gt;</legend>
      <label for=a>Alpha</label>
      <input id=a type=checkbox checked name=flags[] value=1>
      <label><input type=radio name=r value=x> X</label>
      <select name=choice multiple size=0>
        <optgroup label="Group &quot;A&quot;">
          <option selected value=1>One
          <option value=2>Two</option>
        </optgroup>
        <option>unclosed
      </select>
      <textarea name=notes rows=2 cols=3>raw <b>text</textarea>
      <input type=file name=upload accept=image/*>
    </fieldset>
    <input type=image src="" alt=submit width=-1 height=NaN>
    <button formaction=/other formmethod=dialog>send</button>
  </form>
  <menu type=context><li>first<li>second<ul><li>nested</ul></menu>
  <blockquote cite="a>b"><pre>  pre
 &lt;tag&gt;	space</pre></blockquote>
</body>
</html>