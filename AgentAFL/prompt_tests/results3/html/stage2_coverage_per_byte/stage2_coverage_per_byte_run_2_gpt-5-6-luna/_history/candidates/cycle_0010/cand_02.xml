<html>
<head><title>Form controls</title></head>
<body>
<form method=get action="/search?old=1" accept-charset="utf-8" novalidate>
<input type=text name=q value="&lt;tag&gt;" required>
<input type=image src=x alt=Go>
<label>Choice<select name=choice>
<option value=a>A
<optgroup label="Group &amp; One">
<option disabled>Broken
</optgroup>
</select></label>
<textarea name=t cols=4 rows=1>&lt;textarea&gt;
</textarea>
<button type=button disabled>Push</button>
<output name=result for=q></output>
<datalist id=keys><option value=one><option value=two></datalist>
<input list=keys name=k>
</form>
<details open><summary>More</summary><p>hidden-ish</p></details>
</body>
</html>