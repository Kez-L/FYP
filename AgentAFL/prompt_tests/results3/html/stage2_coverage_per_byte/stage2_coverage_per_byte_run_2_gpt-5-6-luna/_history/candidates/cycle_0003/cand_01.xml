<!DOCTYPE HTML PUBLIC "-//W3C//DTD HTML 4.01 Frameset//EN"
 "http://www.w3.org/TR/html4/frameset.dtd">
<html>
<head>
  <title>frameset test</title>
  <meta http-equiv=refresh content="0;url=next.html">
</head>
<frameset rows="20%,*,0" cols="40%,60%" border="bogus">
  <frame src="left.html" name=nav scrolling=no frameborder=0>
  <frameset cols="*,*" onload="x<y">
    <frame src="a.html" marginwidth=0>
    <frame src="b.html" noresize>
  </frameset>
  <noframes>
    <body>
      <p>This fallback contains <a href="x?y=1&amp;z=2">a link</a>.
      <form action=/search method=POST enctype="multipart/form-data">
        <input type=text name=q value='unterminated>
        <button type=submit>Go</button>
      </form>
    </body>
  </noframes>
</frameset>
</html>