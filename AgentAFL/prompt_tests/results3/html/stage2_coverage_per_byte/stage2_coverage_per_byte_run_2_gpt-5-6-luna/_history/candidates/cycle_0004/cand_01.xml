<?xml version="1.0"?>
<!DOCTYPE html [
  <!ENTITY local "replacement">
  <!ELEMENT note - - (to,from,heading,body)>
]>
<html xmlns="http://www.w3.org/1999/xhtml">
<head><title>Namespaced</title></head>
<body>
  <svg:svg width="20" height="20">
    <svg:foreignObject><div>inside &local;</div></svg:foreignObject>
  </svg:svg>
  <math><mrow><mi>x</mi><mo>&lt;</mo><mn>10</mn></mrow></math>
  <p title="a&quot;b&amp;c">text</p>
</body>
</html>