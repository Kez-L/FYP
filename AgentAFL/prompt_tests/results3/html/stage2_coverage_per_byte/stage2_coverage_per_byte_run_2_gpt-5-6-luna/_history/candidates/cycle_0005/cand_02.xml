<!DOCTYPE html>
<html lang=en>
<head><title>form controls</title></head>
<body>
<form action=/submit method=post enctype="multipart/form-data">
  <fieldset disabled>
    <legend><em>Account</legend>
    <label for=user>User <input id=user name=user value="a>b" required></label>
    <label>Password <input type=password name=pw></label>
  </fieldset>
  <input type=checkbox checked=checked name=flag>
  <input type=radio name=kind value=one checked>
  <input type=file accept="image/*,.txt" multiple>
  <select name=choice size=4>
    <optgroup label=First>
      <option value=1 selected>Alpha
      <option value=2>Beta</optgroup>
    <option>Gamma
    <option disabled>Delta
  </select>
  <textarea cols=4 rows=2 wrap=hard>line one
line two</textarea>
  <button type=submit><span>Send</button>
  <button formaction="/other" type=reset>Reset</button>
</form>
<form><input name=outer><form><input name=inner></form></form>