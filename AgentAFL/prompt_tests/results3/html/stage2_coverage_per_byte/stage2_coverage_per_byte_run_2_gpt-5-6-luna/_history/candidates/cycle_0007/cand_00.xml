<!DOCTYPE HTML PUBLIC "-//IETF//DTD HTML 2.0//EN">
<html>
<head>
<title>Frames and Forms</title>
<frameset cols="25%,75%" onload="a< b">
<frame src="left.html" name=left scrolling=no>
<frameset rows="40,*">
<frame src="top.html">
<frame src="main.html" frameborder=0>
<noframes>
<body>
<form method=post action="/submit" enctype="multipart/form-data">
<fieldset disabled>
<legend><b>Account</legend>
<label for=user>User:
<input id=user name=user value="x&y">
<textarea name=note rows=2 cols=8>one
two</textarea>
<select name=kind multiple size=3>
<option selected>first
<option>second
</select>
<button type=submit>Send</button>
</fieldset>
</form>
</body>
</noframes>
</frameset>
</frameset>
</html>