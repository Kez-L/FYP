<!DOCTYPE HTML PUBLIC "-//IETF//DTD HTML 2.0//EN">
<html>
<head><title>Forms and obsolete controls</title></head>
<body>
<isindex prompt="Search:" action=/find>
<form method="INVALID" action="x y" accept-charset="UTF-8,," name="">
<input type=text name=q value="one" maxlength="-4" size="NaN">
<input type=file name=f accept="image/*,,text/plain" multiple=maybe>
<input type=image src alt width="0" height="-2">
<select name=s size="0">
<option value=a>A
<option value=b>B
</select>
<textarea name=t rows="bad" cols="-1">unterminated
<keygen name=k challenge=abc>
<button disabled="false" value=>Click</button>
</form>
<marquee direction=sideways><blink>old <center>tags</marquee>
</body>
</html>