<!DOCTYPE HTML PUBLIC "-//IETF//DTD HTML 2.0//EN">
<html>
<head>
<title>Form controls</title>
</head>
<body>
<form method=POST action="/submit" enctype="multipart/form-data">
<fieldset disabled>
<legend>Account <em>details</em></legend>
<label for=user>User:</label><input id=user name=user required>
<label>Password<input type=password name=pw size=0 maxlength="-1"></label>
<select name=kind multiple size=-2>
<option selected>First
<option value="2">Second
<optgroup label="Other"><option>Third</optgroup>
</select>
<textarea name=notes cols="x" rows="0">a&b
<cite>raw</cite></textarea>
<button type=unknown><img src=button.gif alt=send></button>
</fieldset>
<input type=hidden name=x value="&quot;broken">
</form>
</body>
</html>