<!DOCTYPE HTML PUBLIC "-//W3C//DTD HTML 4.01//EN">
<html>
<head><title>embedded and obsolete</title></head>
<body>
<object classid="clsid:bad" width=10 height="10">
  <param name=movie value="x&y">
  <embed src="movie.swf" pluginspage=http://plug.invalid>
  fallback text
</object>
<map name=mainmap>
  <area shape=rect coords="0,0,10,10" href=#top>
  <area href="/next" coords=bad>
</map>
<img src="diagram.png" usemap="#mainmap" border=1 align=left>
<marquee direction=sideways behavior=alternate><big>moving</big></marquee>
<blink>old <font face="serif" size=+3 color=#123456>markup</font>
<noembed>fallback</noembed>
</body>
</html>