<!doctype html>
<html lang=en>
<head><title>lists and definition repair</title></head>
<body>
<dl compact>
<dt>alpha
<dd>first definition
<dt><span>beta
<dd>second <del>definition
</dl>
<ol start="zero" reversed>
<li>one
<li value=3>three
<ul type=square>
<li>nested A
<li>nested B
</ol>
</ul>
<menu>
<li><a href=#a>link item
<li><input name=x><label>control item
</menu>
<p><dfn id=a>End
</body>
</html>