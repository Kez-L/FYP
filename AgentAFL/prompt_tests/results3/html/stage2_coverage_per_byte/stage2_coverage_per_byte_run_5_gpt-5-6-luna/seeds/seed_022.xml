<!doctype html public "-//IETF//DTD HTML 2.0//EN">
<html>
<head>
<title>frames and obsolete elements</title>
</head>
<frameset rows="20%,*,20%" border=0>
<frame src="a.html" name=top noresize scrolling=auto>
<frameset cols="30%,70%">
<frame srcdoc="<p>inline</p>" frameborder=yes>
<frame src="b.html" marginwidth=bad>
<noframes>
<body>
<center><h1>fallback</h1></center>
<marquee direction=sideways loop=-1>moving</marquee>
<blink>old &unknown; text</blink>
</body>
</noframes>
</frameset>
</frameset>
</html>