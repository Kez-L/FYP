<!DOCTYPE html>
<html>
<head><title>form controls</title></head>
<body>
<form action="/submit?a=1&b=2" method=POST enctype="multipart/form-data">
  <fieldset disabled>
    <legend><b>Account</legend>
    <label for=user>Name
    <input id=user name=user type=text value="a > b" checked>
    <label>Password<input type=password name=pw>
    <select name=role multiple size=2>
      <option selected>Admin
      <option value="guest">Guest
      <optgroup label=Other><option>Visitor</optgroup>
    </select>
  </fieldset>
  <textarea name=notes rows=2 cols=8>one
two</textarea>
  <button type=submit><span>Send</button>
  <input type=image src=submit.gif alt=>
</form>
</body>
</html>