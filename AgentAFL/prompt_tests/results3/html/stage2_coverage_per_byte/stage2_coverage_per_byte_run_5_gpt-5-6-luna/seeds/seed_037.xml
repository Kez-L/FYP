<!DOCTYPE HTML PUBLIC "-//W3C//DTD HTML 4.01 Frameset//EN"
 "http://www.w3.org/TR/html4/frameset.dtd">
<html>
<head>
<base target=_top>
<title>Frameset case</title>
<script type="text/javascript">if (x < 3) { document.write("<b>z</b>"); }</script>
<style type=text/css>
a { color: red; } <!-- legacy comment
</style>
</head>
<frameset rows="20%,*,0" border=notanumber>
<frame src="left.html" name=left frameborder=yes scrolling=auto>
<frameset cols="*,*" noresize>
<frame src=one.html>
<frame src="two.html" marginwidth=-4>
<noframes>
<body>
<h2>Fallback</h2>
<p>This content is inside a noframes element.</p>
</body>
</noframes>
</frameset>
</html>