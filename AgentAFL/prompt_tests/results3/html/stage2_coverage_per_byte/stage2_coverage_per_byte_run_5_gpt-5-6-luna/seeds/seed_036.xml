<!DOCTYPE html>
<html>
<head>
<title>Form controls</title>
</head>
<body>
<form action="/submit" method=post enctype="multipart/form-data">
<fieldset disabled>
<legend>Profile
<label for=x>Name</label><input id=x name=name value="a&b" maxlength=abc>
<label>Choice <select name=choice multiple size=0>
<option selected>one
<option value='two>two
<optgroup label=group><option>three</select>
<textarea name=note rows=-1 cols="bad">unterminated
<input type=checkbox checked=checked>
<input type=radio name=r>
<button type=submit><b>Send</button>
</fieldset>
<input type=image src=missing alt="submit">
</form>
<p><label for=orphan>orphan</label>
</body>
</html>