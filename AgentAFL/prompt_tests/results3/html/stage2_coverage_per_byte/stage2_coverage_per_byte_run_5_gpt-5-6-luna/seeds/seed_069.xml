<!DOCTYPE html>
<html>
<head><title>Embedded Data</title></head>
<body>
<figure>
<picture>
<source media="(min-width: 800px)" srcset="large.png 2x">
<source srcset="small.png">
<img src="fallback.png" alt="fallback">
</picture>
<figcaption>Image <mark>caption</mark></figcaption>
</figure>
<details open><summary>More</summary><ol reversed start=4><li>four<li>three<li value=1>one</ol></details>
<dl><dt>A<dd>first<dt>B<dd>second</dl>
<iframe srcdoc="<p class='inner'>embedded &amp; text</p>" sandbox></iframe>
<canvas width=20 height=10>Canvas fallback</canvas>
</body>
</html>