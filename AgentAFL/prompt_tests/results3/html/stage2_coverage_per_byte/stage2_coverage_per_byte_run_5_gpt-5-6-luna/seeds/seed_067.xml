<!DOCTYPE HTML PUBLIC "-//IETF//DTD HTML 2.0//EN">
<html>
<head><title>Frames and Legacy Elements</title></head>
<frameset rows="20%,*">
  <frame src="top.html" name=top scrolling=no>
  <frameset cols="30%,70%">
    <frame src='left.html' frameborder=0>
    <frame src=right.html>
    <noframes>
      <body>
        <h2>No frames</h2>
        <p><a href="index.html">Return</a></p>
      </body>
    </noframes>
  </frameset>
</frameset>
</html>