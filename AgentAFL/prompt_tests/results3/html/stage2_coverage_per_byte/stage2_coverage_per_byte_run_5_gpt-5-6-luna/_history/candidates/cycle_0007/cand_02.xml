<!DOCTYPE HTML>
<html>
<head>
  <title>frames and map</title>
  <script type="text/javascript">
    if (x < 4 && y > 2) { document.write("<p>raw</p>"); }
  </script>
  <style type="text/css">
    body { background: url("x>y"); } /* unterminated-looking */
  </style>
</head>
<frameset rows="20%,*" border=0>
  <frame src="left.html" name=nav noresize>
  <frameset cols="30%,70%">
    <frame src="middle.html">
    <frame src=right.html scrolling="maybe">
  </frameset>
  <noframes><body><p>fallback</p></body></noframes>
</frameset>
</html>