<head>
<title>Frames and obsolete declarations</title>
</head>
<frameset rows="*,0,20" cols="bad">
<frame src="left.html" name="left" frameborder="maybe">
<frameset><frame src=right.html><noframes>
<body bgcolor=#fff text=black>
<h1>Fallback</h1>
<base href="http://example.invalid/a/../b">
<basefont size="huge">
<center><marquee direction=sideways behavior=loop>moving &unknown;</marquee></center>
<applet code="X.class" width="NaN" height="-4" archive="a.jar,b.jar">
<param name=code value="x"><param name=code value="y">
alternate text</applet>
</body>
</noframes></frameset>
</frameset>
</html>