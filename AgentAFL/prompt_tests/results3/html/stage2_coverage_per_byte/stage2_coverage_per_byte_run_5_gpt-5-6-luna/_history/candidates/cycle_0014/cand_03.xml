<!doctype html>
<html>
<head><title>Interactive Form</title></head>
<body>
<form action="/submit?x=1&amp;y=2" method=post enctype="multipart/form-data">
<fieldset disabled>
<legend>Account <small>details</small></legend>
<label for=u>User:</label><input id=u name=user value="a&b" required>
<label>Password<input name=p type=password></label>
<select name=role multiple size=3>
<option value=one selected>One
<option>Two
<optgroup label="Group"><option value=three>Three</optgroup>
</select>
<textarea name=notes rows=2 cols=8>line 1
line 2</textarea>
</fieldset>
<input type=checkbox checked><button type=submit>Send</button>
</form>
</body>
</html>