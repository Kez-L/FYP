<!doctype html>
<html xmlns="http://www.w3.org/1999/xhtml">
<head><title>foreign content</title></head>
<body>
<svg width="80" height="40" viewBox="0 0 80 40">
<g transform="translate(2 2)">
<rect x="0" y="0" width="30" height="20" fill="red"/>
<text x="3" y="15">SVG &amp; text</text>
<foreignObject x="35" y="0" width="40" height="30">
<div xmlns="http://www.w3.org/1999/xhtml"><p>inside foreign</p></div>
</foreignObject>
</g>
</svg>
<math display="block"><mrow><mi>x</mi><mo>&lt;</mo><mn>10</mn></mrow></math>
<p><b><i><u>unclosed nesting</b></i></u>
</body>
</html>