<!DOCTYPE HTML PUBLIC "-//IETF//DTD HTML 2.0//EN">
<HTML>
<HEAD>
  <TITLE>frameset stress</TITLE>
</HEAD>
<FRAMESET ROWS="20%,*" COLS="30%,70%">
  <FRAME NAME=left SRC="left.html" NORESIZE SCROLLING=auto>
  <FRAMESET>
    <FRAME SRC='right.html?x=1&y=2'>
    <NOFRAMES>
      <BODY>
        <H1>Fallback</H1>
        <FORM ACTION=/submit METHOD=POST ENCTYPE=multipart/form-data>
          <INPUT TYPE=text NAME=user VALUE="a>b">
          <INPUT TYPE=checkbox CHECKED NAME=x>
          <SELECT NAME=kind MULTIPLE SIZE=2>
            <OPTION SELECTED VALUE=1>one
            <OPTION VALUE='2>two'>two
          </SELECT>
          <TEXTAREA NAME=msg ROWS=2 COLS=4>unterminated
          <BUTTON TYPE=submit>Go</BUTTON>
        </FORM>
      </BODY>
    </NOFRAMES>
  </FRAMESET>
</FRAMESET>