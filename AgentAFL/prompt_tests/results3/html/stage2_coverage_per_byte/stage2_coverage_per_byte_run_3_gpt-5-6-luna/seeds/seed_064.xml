<!doctype HTML PUBLIC "-//W3C//DTD HTML 4.01 Frameset//EN" "http://www.w3.org/TR/html4/frameset.dtd">
<html>
<head><title>frames and embeds</title></head>
<frameset rows="25%,*,25%" border=0>
<frame src="top.html" name=top scrolling=no>
<frameset cols="33%,*,33%">
<frame src="left.html" frameborder=1>
<frame src="middle.html">
<frame src="right.html" noresize>
<noframes>
<body>
<object data="movie.bin" type="application/octet-stream" width=0 height=0>
<param name="autoplay" value="true">
<embed src="plugin.dat" width="300" height="200" hidden>
fallback <a href="fallback">download</a>
</object>
<iframe srcdoc="<p>embedded &amp; text</p>" sandbox="allow-scripts" width="x"></iframe>
</body>
</noframes>
</frameset>
</frameset>
</html>