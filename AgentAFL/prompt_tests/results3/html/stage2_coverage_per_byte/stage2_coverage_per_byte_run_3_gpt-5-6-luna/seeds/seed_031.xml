<!doctype html>
<html>
<head><title>mixed forms</title></head>
<body>
<form action="/submit" method="post">
<fieldset disabled>
<legend><label for=x>Choose &copy; &notanentity;</label></legend>
<select name=kind multiple size=3>
<option selected value="a">One
<option value='b'>&amp; Two</option>
<optgroup label="Group"><option>Three</select>
<input id=x type=checkbox checked>
<textarea name=notes rows=2 cols=8>first
second</textarea>
<button type=submit><img src="x" alt="go"></button>
</fieldset>
</form>
</body>
</html>