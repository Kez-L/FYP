<!DOCTYPE HTML>
<html>
<head>
  <title>mixed embedded content</title>
  <style type="text/css">
    body { background: url("x&y"); }
    .bad { color: red; </style>
  <script type="text/javascript">
    if (a < b && c > d) { document.write("<em>script</em>"); }
    // </script> appears early
  </script>
</head>
<body>
  <noscript><p>JavaScript is disabled</noscript>
  <textarea name="t">a < b &amp; c</textarea>
  <select name=x multiple>
    <option value=1 selected>One
    <option value="2">Two</option>
  </select>
  <button type=submit disabled=disabled>Send</button>
</body>
</html>