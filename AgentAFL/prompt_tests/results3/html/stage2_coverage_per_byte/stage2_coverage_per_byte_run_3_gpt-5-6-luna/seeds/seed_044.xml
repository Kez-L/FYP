<!doctype html>
<html>
<head>
  <title>forms and lists</title>
</head>
<body>
  <form action="/submit" method="POST" enctype="multipart/form-data">
    <fieldset disabled>
      <legend>Account</legend>
      <label for=u>User:</label>
      <input id=u name=user>
      <label>Password <input type=password name=p></label>
    </fieldset>
    <input type=file name=upload>
    <input type=image src="/go.png" alt=go>
  </form>
  <dl>
    <dt>Term 1
    <dd>Description without closing
    <dt>Term 2</dt><dd><ul><li>Nested one<li>Nested two</ul>
  </dl>
  <ol start="0" reversed><li>zero<li>negative</ol>
  <menu><li>action A</menu>
</body>
</html>