<!DOCTYPE HTML PUBLIC "-//W3C//DTD HTML 3.2 Final//EN">
<html>
<head><title>Legacy controls</title></head>
<body>
<applet code="Missing.class" archive="a.jar,b.jar" width=0 height=0>
<param name=movie value="x&amp;y">
<param name=quality value=high>
fallback &copy; text
</applet>
<object classid="clsid:00000000-0000-0000-0000-000000000000" data="x" width="1">
<param name=data value="a>b">
<embed src="movie.swf" pluginspage="about:blank" hidden>
<object data="nested"><p>fallback</object>
</object>
<marquee behavior=alternate direction=sideways scrollamount=-1>
<blink>old <font face="serif" size=+9 color="#GGG">markup</font></blink>
</marquee>
</body>
</html>