<!doctype html>
<html>
<head><title>form controls</title></head>
<body>
<form action="/submit" method=post enctype="multipart/form-data">
<fieldset disabled>
<legend>Options <input name=legend value="x"></legend>
<label for=a>Name</label><input id=a name=name required readonly>
<select name=pick multiple size=0>
<option value=one selected>One
<option value=two>Two</option>
<optgroup label="Group"><option>Three</optgroup>
</select>
<button type=submit>Send <img src=x alt="button"></button>
</fieldset>
<input type=image src="" alt="">
</form>
<details open><summary>More</summary><p>hidden-ish</details>
</body>
</html>