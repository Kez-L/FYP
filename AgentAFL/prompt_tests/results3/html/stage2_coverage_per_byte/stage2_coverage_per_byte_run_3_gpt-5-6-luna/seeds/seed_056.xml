<!DOCTYPE HTML PUBLIC "-//W3C//DTD HTML 4.01//EN">
<html>
<head>
<title>frames and objects</title>
<link rel=stylesheet href="x.css">
<style type="text/css">body{color:red} @media screen{p{display:none}}</style>
</head>
<frameset cols="25%,*" onload="go()">
<frame src="left.html" name=left scrolling=no>
<frameset rows="50,*">
<frame src="top.html">
<frame src="right.html" frameborder=0>
<noframes>
<body>
<object data="movie.bin" type="application/octet-stream" width="2" height="3">
<param name=autoplay value=true>
<embed src="fallback.swf">
<p>Fallback <a href="javascript:void(0)">link</a></p>
</object>
</body>
</noframes>
</frameset>
</frameset>
</html>