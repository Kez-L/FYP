<html><head><title>frames and maps</title></head>
<frameset rows="*,0" cols="50%,50%">
  <frame name="left" src="left.html" frameborder="no" scrolling="auto">
  <frameset>
    <frame srcdoc="<p>embedded &amp; text</p><img src=x>">
    <noframes>
      <body>
        <map name="m">
          <area shape="rect" coords="0,0,10,10" href="/a" alt="a">
          <area shape=poly coords="1,2,3,4,5,6 href=/b alt=b>
        </map>
        <img usemap="#m" ismap src="x" alt="map">
        <object data="x" type="text/html" width=0 height=0>
          <param name="movie" value="&quot;bad">
          fallback <embed src=x></embed>
        </object>
      </body>
    </noframes>
  </frameset>
</frameset>
</html>