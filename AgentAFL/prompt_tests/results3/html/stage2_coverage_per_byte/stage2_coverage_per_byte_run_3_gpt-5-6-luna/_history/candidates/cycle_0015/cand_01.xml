<!doctype html>
<html>
<head><title>form controls</title></head>
<body>
<form action="/submit" method=post enctype="multipart/form-data">
<label for=x>Name<label>
<input id=x name=user value="a>b" disabled>
<select name=choice multiple size=3>
<option selected>one
<option value=two>two
<optgroup label=broken><option>three
</select>
<textarea name=notes rows=2 cols=4>one</textarea>
<button type=submit><img src=x alt=send>Go</button>
<input type=image src="missing" alt="">
</form>
</body>
</html>