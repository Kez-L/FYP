<!DOCTYPE HTML>
<html>
<head><title>obsolete controls</title></head>
<body>
<center>
<marquee direction=left behavior=alternate scrollamount=0>
<blink>legacy <font face="serif" size=+9 color=#12GG78>text</font></blink>
</marquee>
</center>
<hr noshade="noshade" width=101%>
<isindex prompt="Search:" action="/q">
<form>
<input name=q value="a&quot;b" type=text maxlength=-1>
<keygen name=key challenge=test>
<select name=s>
<option>one<option selected>two<option disabled>three
</select>
<textarea wrap=hard>line1&#13;&#10;line2</textarea>
<output name=result for=a>b</output>
</form>
<pre>  leading
	 tabs &lt; &gt;
</pre>
</body>
</html>