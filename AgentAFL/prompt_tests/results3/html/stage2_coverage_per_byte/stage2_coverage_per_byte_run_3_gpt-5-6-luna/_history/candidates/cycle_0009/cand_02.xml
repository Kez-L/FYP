<!doctype html>
<html lang="x">
<head><title>attributes</title></head>
<body>
  <div data-a="one" data-b='two' data-c=three data-d=unquoted&value
       empty="" disabled checked=checked style="width: expression(alert(1))">
    <a href="mailto:a@b.example?x=1&amp;y=2" title="a &quot;quote&quot;">link</a>
    <img src=x alt="broken" width=0 height=-1>
    <input type=text name=q value="a>b<c" readonly/>
  </div>
  <p id=x id=y class="a  b	c" class='override'>text
  <hr>
  <br/>
</body>
</html>