<html>
  <head>
    <title>form controls</title>
  </head>
  <body>
    <form action="/submit" method="post">
      <input name="a" value="&quot; onfocus=&quot;alert(1)" />
      <select name="s">
        <option value="1">one
        <optgroup label="g"><option>two</select>
      <button type="submit"><label for=x>go</button>
      <fieldset disabled><legend>L</legend><input><textarea cols="0" rows="-1">
        &lt;/textarea&gt;
      </fieldset>
    </form>
    <form><input form="missing"><output><meter value="nan">x</meter>
    <label><input type=checkbox checked=checked><label>nested
  </body>
</html>