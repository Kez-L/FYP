<!doctype html>
<html>
  <head><title>embedded namespaces</title></head>
  <body>
    <svg viewBox="0 0 10 10"><g><path d="M0 0L10 10"></g>
      <foreignObject><div xmlns="http://www.w3.org/1999/xhtml">x</svg>
    <math>
      <mi>x</mi><mo>&lt;</mo><mfrac><mn>1</mn><mn>2</mn></mfrac>
      <annotation-xml encoding="text/html"><p>nested</math>
    <object data="x">
      fallback <iframe srcdoc="<p>inside &amp; out"></iframe>
    </object>
  </body>
</html>