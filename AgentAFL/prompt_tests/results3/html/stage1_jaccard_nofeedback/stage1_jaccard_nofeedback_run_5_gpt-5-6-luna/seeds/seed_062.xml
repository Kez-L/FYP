<!DOCTYPE html>
<html>
<head>
  <meta charset="windows-1252">
  <title>form controls</title>
</head>
<body>
  <form action="/submit" method="post" enctype="multipart/form-data">
    <fieldset disabled>
      <legend><label for=x>Pick</legend>
      <input id=x name=a type="text" value="&quot; &apos; &#x1f4a9;">
      <select name=s multiple size="-1">
        <option selected>one
        <option value="two"><option><optgroup label="g"><option>three
      </select>
    </fieldset>
    <button type=submit formaction="javascript:void(0)">go</button>
    <textarea name=t rows="0" cols="-4"><!-- x --></textarea>
    <output for="x y">result</output>
  </form>
  <details open><summary>summary <summary>nested</summary></summary><p>body</p></details>
</body>
</html>