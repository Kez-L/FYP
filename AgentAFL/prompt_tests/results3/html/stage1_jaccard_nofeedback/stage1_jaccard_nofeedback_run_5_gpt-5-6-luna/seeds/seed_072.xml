<!doctype html>
<html lang=en>
<head><title>forms and misnested formatting</title></head>
<body>
<form action="/submit" method="post">
<label for=x>Name<input id=x name=name value="a>b"></label>
<select name=choice><option>first<option selected>second<optgroup label=group><option>third</select>
<button type=submit><b><i>send</b></i></button>
<fieldset disabled><legend>group<input type=text></fieldset>
</form>
<p><a href="javascript:alert(1)"><em>link<strong>nested</a>tail</strong></em>
</body>
</html>