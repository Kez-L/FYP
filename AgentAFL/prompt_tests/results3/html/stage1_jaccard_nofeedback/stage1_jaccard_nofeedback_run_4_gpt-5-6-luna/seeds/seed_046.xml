<!DOCTYPE html>
<html>
<head><title>Form controls</title></head>
<body>
<form action="/submit" method="post">
  <fieldset disabled>
    <legend>Account <input name="legend" value="x"></legend>
    <label for="email">Mail</label>
    <input id="email" type="email" required value="a@b">
    <select name="items" multiple size="2">
      <option selected>one
      <optgroup label="group"><option value="two">two</optgroup>
      <option>three</select>
    <textarea name="note" cols="0" rows="-1">line one
line two</textarea>
  </fieldset>
  <button type="submit"><input type="hidden" name="x" value="1"></button>
</form>
<input form="missing" list="choices"><datalist id="choices"><option label="A">
<iframe srcdoc="<p>embedded &amp; fragment</p>" sandbox></iframe>
</body>
</html>