<!DOCTYPE html>
<html>
<head>
<title>Forms and foreign content</title>
</head>
<body>
<form action="/submit" method="post">
<fieldset disabled="disabled"><legend>Account</legend>
<label for=user>User <input id=user name=user value="a&b" required></label>
<label>Password <input type=password name=pw></label>
<select name=choice multiple size=2>
<option selected>First<option>Second<option disabled>Third
</select>
<textarea name=notes rows=2 cols=8>one
two</textarea>
<button type=submit>Send</button>
</fieldset>
</form>
<details open><summary>More <b>information</summary>
<progress value="1.5" max="1">bad</progress>
<meter min=0 max=10 value=NaN>meter</meter>
</details>
<svg viewBox="0 0 10 10"><g><path d="M0 0L10 10"></g><foreignObject><div>svg html</div></foreignObject></svg>
<math><mi>x</mi><mo>&InvisibleTimes;</mo><mrow><mn>2</mn></mrow></math>
</body>
</html>