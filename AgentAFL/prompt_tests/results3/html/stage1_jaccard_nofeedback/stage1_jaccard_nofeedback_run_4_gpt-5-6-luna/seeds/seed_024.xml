<!doctype html>
<html lang="x" dir="rtl">
<head><title>misnested sections</title></head>
<body>
  <header><nav><ul><li>one<li>two<ul><li>nested</ul></ol></nav></header>
  <article>
    <hgroup><h1>Title<h3>Subheading</h2></hgroup>
    <p>paragraph <a href=#one><b>bold <i>italic</a> after</b></i>
    <dl><dt>term<dd>definition<dt>second<dd><div>block in definition</dl>
    <blockquote cite="x"><p>quote</blockquote></p>
    <figure><img src=x><figcaption>caption</figure>
    <details open><summary>Summary</summary><p>more details
    <table border=1>
      <colgroup><col span=2><col></colgroup>
      <thead><tr><th scope=col>A<th>B</thead>
      <tbody><tr><td rowspan=2>1<td>2
      <tfoot><tr><td>footer</tr></tbody>
    </table>
  </article>
  <footer><address><a href="mailto:x@y">contact</address></footer>
</body>
</html>