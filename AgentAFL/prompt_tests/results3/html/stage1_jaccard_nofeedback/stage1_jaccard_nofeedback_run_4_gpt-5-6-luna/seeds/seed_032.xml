<!DOCTYPE html>
<html>
<head><title>form edge cases</title></head>
<body>
  <form action="/submit" method="POST" enctype="multipart/form-data">
    <label for="field">Name</label>
    <input type="text" name="field" id="field" value="&quot; onfocus=&quot;x" maxlength="-1">
    <input type="checkbox" checked checked="no" name="flag">
    <select name="choice" multiple size="0">
      <optgroup label="A"><option selected>one<option>two</optgroup>
      <option value="&amp;">three
    </select>
    <textarea name="notes" rows="-3" cols="999">&lt;/textarea&gt;
      raw & invalid &#999999999999999999999999;
    <button type="submit"><span>send</button>
    <fieldset disabled><legend>group</legend><input name="inside"></fieldset>
    <input type="image" src="data:image/png;base64,AAAA" alt="">
  </form>
  <form><input form="missing"><button formaction="">go</button></form>
</body>
</html>