<!doctype html>
<html>
<head><title>form nesting</title></head>
<body>
<form action="/submit" method="post">
  <label for=x>Name <input id=x name=user value="a&b"></label>
  <select name=kind multiple size=2>
    <option selected>One
    <option value='two>Two</option>
    <optgroup label="Group"><option>Three</select>
  <button type=submit formaction="/alt">Send
  <fieldset disabled><legend>Details</legend>
    <textarea name=note rows=2 cols=4>one
two</textarea>
    <input type=file><output name=result>result
  </fieldset>
</form>
<form><input name=outer><form><input name=inner></form></form>
</body>
</html>