<!DOCTYPE html>
<html>
<head><title>Forms and lists</title></head>
<body>
  <form action="/submit" method="post">
    <label for="q">Query<label>
    <input name="q" type="text" disabled="disabled" checked>
    <select name="items">
      <option value="1">one
      <option selected selected value="2">two</option>
      <optgroup label="group">
        <option>three</optgroup>
    </select>
    <textarea name="note">raw </textarea text
    <button type="submit"><span>send</button>
  </form>
  <ul><li>first<li>second<ol><li>nested</ul></ol>
  <dl><dt>term<dd>definition<dt>next
</body>
</html>