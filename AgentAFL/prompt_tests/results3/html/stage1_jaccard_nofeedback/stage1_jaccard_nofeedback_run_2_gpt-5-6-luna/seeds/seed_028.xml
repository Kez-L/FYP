<!DOCTYPE html>
<html>
<head>
<title>foreign content</title>
</head>
<body>
<svg width="10" height="10" viewBox="0 0 10 10">
<foreignObject><div xmlns="http://www.w3.org/1999/xhtml">
<p>html in svg
</foreignObject>
<g><circle cx="1" cy="2" r="3"></g>
</svg>
<math><mi>x</mi><mo>&InvisibleTimes;</mo><mrow><mn>1</mn><mo>+</mo></mrow>
<annotation-xml encoding="application/xhtml+xml"><p>raw</annotation-xml>
</math>
<iframe srcdoc="<p title='x'>embedded</p>">fallback</iframe>
<object data="file.bin"><param name=x><embed src=x></object>
</body>