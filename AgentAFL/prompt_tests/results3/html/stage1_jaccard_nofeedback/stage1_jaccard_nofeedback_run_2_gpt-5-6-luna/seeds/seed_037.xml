<!doctype html>
<html>
<head><title>frames and controls</title></head>
<frameset rows="*,0,25%" cols="50%,*">
<frame src="a.html" name="left" frameborder="0">
<frameset>
<frame srcdoc="<p>embedded <b>text</b></p>" scrolling=maybe>
<noframes><body><p>fallback</p></body></noframes>
</frameset>
<iframe src="data:text/html,<html><body>x</body></html>" sandbox="allow-scripts allow-forms" width=0 height=-1></iframe>
<object data="movie.bin" type="application/x-shockwave-flash">
<param name=movie value="x.swf">
<embed src=x.swf hidden>
fallback <a href="mailto:a@b?subject=x&body=y">mail</a>
</object>
</frameset>