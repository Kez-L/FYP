<!DOCTYPE html>
<html lang=en>
<head>
  <title>foreign content</title>
</head>
<body>
  <svg width="10" viewBox="0 0 10 10">
    <g transform="translate(1 2)">
      <path d="M0 0 L10 10" fill="url(#x)" />
      <text x="1" y="2">SVG &amp; text</text>
      <foreignObject><div xmlns="http://www.w3.org/1999/xhtml"><p>embedded</div></foreignObject>
    </g>
  </svg>
  <math display="block"><mi>x</mi><mo>&#x2212;</mo><mfrac><mn>1</mn><mi>y</mi></mfrac></math>
  <p><svg><title>nested title</title><circle cx="NaN" cy="Infinity"></circle></svg>tail
</body>
</html>