<!doctype html>
<html>
<head>
  <title>misnested controls</title>
</head>
<body>
  <main>
    <p>start <b>bold <i>italic <u>under
    <section><p>new paragraph <a href=#><b>link</section>
    <address><p>contact <div>block in address</div></address>
    <table>
      <colgroup><col span="x"><col>
      <thead><tr><th scope=col>head
      <tbody><tr><td><input type="text"><tr><td>
      <tfoot><tr><td>foot
    </table>
    <template><table><tr><td>template</template></td></tr></table>
  </main>
  <dialog open><form><fieldset><legend>one</fieldset><input></form>
</body>
</html>