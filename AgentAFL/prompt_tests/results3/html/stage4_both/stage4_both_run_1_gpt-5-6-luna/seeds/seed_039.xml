<!DOCTYPE html>
<html>
<head><title>misnested sections and obsolete elements</title></head>
<body>
<center><font face="unknown" color="#gggggg" size="nine">centered
<big><small>mixed sizing</small></big></font></center>
<marquee behavior="sideways" direction="diagonal" loop="-1">moving</marquee>
<main>
<header>header <h2>heading</h2></header>
<section>
<p>paragraph one
<div>division starts
<p>paragraph two <strong>strong <em>emphasis</div>
<address>address inside section</address>
</section>
<article>
<hgroup><h1>title</h1><h4>subtitle</h4></hgroup>
<time datetime="2024-02-30T25:61:99Z">future</time>
<data value="not-number">label</data>
<meter min="high" max="low" value="NaN" low="-1" optimum="huge" high="2">meter</meter>
<progress max="zero" value="infinity">progress</progress>
</article>
<footer>
<small>copyright</small>
<del datetime="2020-99">old <ins cite="not-url">new</ins>
</footer>
</main>
</body>
</html>