<!DOCTYPE html>
<html>
<head><title>controls and labels</title></head>
<body>
  <form method="POST" enctype="multipart/form-data" accept-charset="UTF-8,NOPE">
    <fieldset disabled="0">
      <legend><label for="missing">Account <em>details</legend>
      <label>Name <input id=name name=user autofocus required pattern="[A-" min=+1></label>
      <label for=mail>Email</label><input type=email id=mail multiple value=a@b
      <input type=file name=upload accept=image/*,garbage capture=environment>
      <textarea name=note rows=999 cols=-4 wrap=diagonal>unclosed
      <select name=mode size="NaN" multiple="false">
        <optgroup label="group" disabled="no">
          <option value=1 selected=maybe>one
          <option value=2>two
        </optgroup>
        <option>outside
      </select>
      <input type=image src=x alt=go width=+0 height=-9>
      <button type=unknown formaction=/submit>send <input value=inside></button>
      <output for="a b c">result</output>
      <progress value=Infinity max=0>loading</progress>
      <meter min=10 max=2 low=x high=y optimum=z value=999>meter</meter>
    </fieldset>
    <input type=hidden name=token value="&invalid; &#x;">
  </form>
</body>
</html>