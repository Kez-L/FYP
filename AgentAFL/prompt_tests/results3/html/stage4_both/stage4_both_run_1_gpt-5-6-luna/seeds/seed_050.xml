<!DOCTYPE HTML PUBLIC "-//W3C//DTD HTML 4.01 Frameset//EN" "http://www.w3.org/TR/html4/frameset.dtd">
<html>
<head>
  <title>frameset with malformed frame navigation</title>
  <base href="https://example.invalid/root/">
</head>
<frameset rows="20%,*,0" cols="30%,70%" border="bad" frameborder="maybe" framespacing="-1">
  <frame src="left.html" name="left pane" scrolling="sometimes" noresize="false" marginwidth="NaN">
  <frame src="right.html" name="_blank" frameborder="x" marginheight="-20">
  <frameset cols="*" rows="50%,50%">
    <frame src="" name="nested">
    <noframes>
      <body>
        <h1>Fallback content</h1>
        <p><a href="index.html" target="left pane">Return</a></p>
      </body>
    </noframes>
  </frameset>
  <noframes>
    <p>Outer fallback <img src="fallback.gif" alt="&invalid;"></p>
  </noframes>
</frameset>
</html>