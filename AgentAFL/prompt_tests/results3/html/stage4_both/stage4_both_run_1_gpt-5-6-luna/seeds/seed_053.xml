<!doctype html>
<html>
<head>
  <title>malformed lists and nested sectioning</title>
  <template id="t"><section><p>template <b>content</b></section></template>
</head>
<body>
  <header><hgroup><h1>Title<h3>Subheading</h2></hgroup></header>
  <section id="one">
    <h2>First section</h2>
    <p>Paragraph one
    <aside>
      <h2>Aside heading</h2>
      <p>Aside paragraph</p>
    </aside>
    <section>
      <h4>Deep heading</h4>
      <p>Deep text</section>
    <footer>Section footer</footer>
  </section>
  <nav>
    <ol start="zero" reversed="false" type="bogus">
      <li value="NaN">Alpha
      <li>Beta
        <ol>
          <li>Nested one</li>
          <li>Nested two
      </ol>
      <li>Gamma</li>
    </ol>
  </nav>
  <menu type="context" label="Actions">
    <li><button command="--unknown" commandfor="missing">Action</button>
    <li><a download="false" ping="https://a.invalid https://b.invalid">Download</a>
  </menu>
  <footer>
    <small>Footer text <sup>2</sup><sub>n</sub></small>
  </footer>
</body>
</html>