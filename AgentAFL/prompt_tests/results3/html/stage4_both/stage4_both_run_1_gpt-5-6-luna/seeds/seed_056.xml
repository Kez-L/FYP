<!DOCTYPE html>
<html>
<head>
  <title>interactive disclosure and media fallback</title>
</head>
<body>
  <header id="top">
    <nav aria-label="main"><ol start="zero" reversed="perhaps">
      <li value="NaN"><a href="#one">One<li><a href="#two">Two</ol></nav>
  </header>
  <main>
    <article itemscope itemtype="not a type">
      <h1 itemprop="name">A story</h1>
      <details open="0" name="group">
        <summary>Details <span>summary</details>
        <p>Hidden paragraph <dialog open="sometimes">dialogue
        <details><summary>nested</summary>nested body</details>
      </details>
      <figure>
        <picture>
          <source srcset="a 1x, b 2q, c" type="image/unknown">
          <source media="not media" srcset="">
          <img srcset="one.png 100w, two.png -2w" sizes="calc(bad)" alt="picture">
        </picture>
        <figcaption>caption without closing
      </figure>
      <video autoplay="no" controlslist="maybe" preload="sometimes" width="-1" height="NaN">
        <source src="movie.mp4" type="video/not-real">
        <track kind="captions" srclang="xx" src="captions.vtt" default="false">
        video fallback <a href="data:text/html,<b>x</b>">download</a>
      </video>
      <audio loop="zero" muted="maybe"><source src=audio.ogg></audio>
    </article>
    <aside popover="manual"><p>popover <button popovertarget="missing">open</button></aside>
  </main>
  <footer><address>Written by <span itemprop=author>someone</span>
</body>
</html>