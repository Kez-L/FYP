<!doctype html>
<html>
<head>
  <title>ruby, bidi, and phrasing recovery</title>
</head>
<body dir="auto">
  <p><bdi dir="rtl">שלום <bdo dir="sideways">abc</bdo></bdi>
    <ruby>漢<rt>かん<rp>(</rt><rtc>kan</rtc><rp>)</rp></ruby>
    <wbr>break <mark hidden="false">marked</mark>
  <p><dfn title="definition">HTML</dfn> is
    <abbr title="HyperText Markup Language">H<sub>T</sub>ML</abbr>.
  <p translate="maybe" spellcheck="perhaps">
    <time datetime="2024-02-30T25:61:00+99:99">sometime</time>
    <data value="1,2,three">value</data>
    <meter min="ten" max="0" low="5" high="-1" optimum="NaN" value="50">meter</meter>
    <progress max="-2" value="999">progress</progress>
  </p>
  <dl compact>
    <dt>term <dt>second term
    <dd>definition <dd>another definition
    <dt><span>third</span>
  </dl>
  <p>
    <ins cite="/edit one" datetime="2024-13-40">inserted
    <del cite="" datetime="">deleted <s>struck</s></del>
    <sup><sup>double</sup> top</sup>
    <sub><sub>double</sub> bottom</sub>
  </p>
  <figure>
    <figcaption>Caption <a href="#figure">link</a></figcaption>
    <picture>
      <source srcset="a.webp 1x, b.webp 2x, invalid descriptor" type="image/webp">
      <source media="(min-width: bad)" srcset="">
      <img srcset="x 100w, y 200q" sizes="calc(100vw - )" alt="fallback">
    </picture>
  </figure>
</body>
</html>