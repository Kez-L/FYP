<!doctype html>
<html>
<head><title>lists ruby-like phrasing and entities</title></head>
<body>
  <ul type="banana" compact="true">
    <li>first
      <ul><li>nested one</li><li>nested two
    <li>second
  </ul>
  <ol type="Z" start="-999" reversed="false">
    <li value="1.5">alpha</li>
    <li value="">beta
    <li>gamma<ol><li>deep</ol>
  </ol>
  <menu type="toolbar">
    <li><button type="unknown" command="--bad" commandfor="none">Action</button>
    <li><input type="button" value="click" disabled="perhaps">
  </menu>
  <p>
    <abbr title=>HTML</abbr>
    <dfn title="definition">API</dfn>
    <samp><kbd>Ctrl</kbd> + <kbd>Alt</samp> + <var>x</var>
    <sup>2<sup>3</sup></sup><br clear="diagonal">
    <bdi>abc<bdo dir="invalid">xyz</bdi>
  </p>
  <p>
    &notanentity; &amp;broken; &#x110000; &#-1; &#0; &#13;
    &apos; &nbsp &copy
  </p>
  <table border="not-number" cellpadding="-2" cellspacing="NaN">
    <tr><td>A</td><td>B</td></tr>
  </table>
  <p><span style="color: expression(alert(1));">style</span>
  <div contenteditable="sometimes" spellcheck="perhaps" tabindex="1.2">
    <template shadowrootmode="sideways"><p>template content</p></template>
    <slot name="bad name">slot fallback</slot>
  </div>
</body>
</html>