<!DOCTYPE html>
<html>
<head>
  <title>raw text and token interruptions</title>
  <style>
    body { color: red; }
    </style type="text/css">
    /* unterminated comment
    .x { content: "</style><p>escaped"; }
  </style>
</head>
<body>
  <textarea name="notes" rows="2" cols="x">first &amp; second
  </textarea>
  <select name="choice" multiple="maybe" size="-3">
    <optgroup label="Group one" disabled="false">
      <option value="a" selected="sometimes">Alpha
      <option value="b">Bravo</option>
    </optgroup>
    <optgroup>
      <option>Orphan group
  </select>
  <output for="a b" name="result">old result</output>
  <form>
    <input type="text" name="q" value="&lt;tag&gt;">
    <button type="submit"><span>submit</span></button>
  </form>
  <script>
    if (a < b && c > d) {
      document.write("<div class='x'>literal</div>");
    }
    </script>
  <script type="text/plain">
    <tag attr="value">not really markup</tag>
  </script>
  <div data-x="unterminated data-y=two class='x'>
    <p>after broken quote
    <div><!-- nested --><!--> weird comment</div>
  </div>
  <noscript>
    <div>fallback <b>markup</b>
  </noscript>
</body>
</html>