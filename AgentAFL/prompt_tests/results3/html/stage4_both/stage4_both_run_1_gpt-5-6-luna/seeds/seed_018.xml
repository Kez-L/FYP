<!doctype HTML PUBLIC "-//W3C//DTD HTML 4.0//EN">
<html>
<head><title>replaced content and maps</title></head>
<body>
  <p><img src="x" alt="&amp;bad" usemap="#m" ismap border="--" hspace="999999999999">
    text after image
  <map name=m id=m>
    <area shape=rect coords="1,2,3" href=a alt=A>
    <area shape=poly coords="1,2,3,4,5,6,7" nohref=no>
    <area shape=circle coords="x,y,r" target=_blank>
    <p>map paragraph
  </map>
  <object classid="clsid:x" codebase="bad://" data="file.bin" type=application/octet-stream
          width="auto" height="0" declare="maybe">
    <param name=movie value="a&b">
    <param name=quality value=best>
    <object data=nested><embed src=plugin type=x/y></object>
    fallback <a href=javascript:void(0)>link</a>
  </object>
  <applet code="Foo.class" archive="a.jar,b.jar" object="x" alt="old">
    <param name=code value=bad>
    applet fallback
  </applet>
  <marquee behavior=sideways direction=diagonal loop=-1>
    <blink>moving <img src=x></blink>
  </marquee>
  <center><font face="A<B" size="+99" color="#GGG">legacy</font></center>
</body>
</html>