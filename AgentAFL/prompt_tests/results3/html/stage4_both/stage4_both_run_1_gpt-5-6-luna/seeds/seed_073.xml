<!doctype html>
<html>
<head><title>microdata and web components</title></head>
<body>
  <div itemscope itemtype="http://schema.org/Person" itemid="not a uri">
    <meta itemprop="name" content="A & B">
    <link itemprop="url" href="http://[broken">
    <data itemprop=age value="NaN">unknown</data>
    <time itemprop="birthDate" datetime="2024-02-30T25:61:61+99:99">date</time>
    <div itemprop="knows" itemscope>
      <span itemprop="name">nested</span>
      <meta itemprop="name" content="duplicate">
    </div>
  </div>
  <x-card disabled="false" data-a="&amp" data-b='
    <slot></slot>
    <template><style>:host { --x: "</style>"; }</style></template>
  </x-card>
  <dialog id=d open="0">
    <form method=dialog>
      <button value="ok" popovertarget=pop popovertargetaction=toggle>close
      <input type=number min=inf max=-inf step=0 value=1e309>
    </form>
  </dialog>
  <div popover=manual id=pop anchor=missing>
    <p>popover <output>unclosed
  </div>
  <picture>
    <source media="(" srcset="a 1x, b 2w,">
    <source type="image/" srcset>
    <img alt="fallback" srcset="x,,y" sizes="calc(100% - )">
  </picture>
</body>
</html>