<!DOCTYPE html>
<html>
<head><title>form ownership and malformed controls</title></head>
<body>
<form id="outer" action="/submit?x=1&y=2" method="SIDEWAYS" enctype="application/x-invalid">
  <fieldset disabled="false">
    <legend><label for="missing">User <b>profile</legend>
    <label>Name <input id=name name=user value="one" form="other"></label>
    <label><input type=email multiple list=names required="maybe">mail</label>
    <datalist id=names>
      <option value="a@b">
      <option label="unterminated value="x>
    </datalist>
    <input type=number min="ten" max="2" step="0" value="1e999">
    <input type=date value="2024-99-99">
    <input type=file accept="image/*,," capture="no">
    <input type=image src="x" width="NaN" height="-1" alt="a & b">
    <textarea name=notes wrap=diagonal maxlength="-4">line one
line two
  <select name=broken>
    <option>never closed
  </textarea>
  <button formaction="javascript:alert(1)" formenctype="bad">send</button>
</fieldset>
</form>
<form id=other><input name=outside><button>other</button></form>
<isindex prompt="Enter &amp; value">
<keygen name=k challenge=x>
</body>
</html>