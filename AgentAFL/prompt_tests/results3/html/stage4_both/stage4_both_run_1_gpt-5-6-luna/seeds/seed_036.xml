<!doctype html>
<html>
<head>
<title>lists and definition recovery</title>
</head>
<body>
<ul type="mystery" compact="false">
<li value="zero">first
<li>second
<ol start="abc" reversed="no">
<li>nested one
<li>nested two
</ol>
<li>third
</ul>
<dl compact="maybe">
<dt>term one
<dd>definition one
<dt><em>term two</em>
<dd><p>definition two
<dd>another definition
</dl>
<menu type="toolbar">
<li><button type="unknown" autofocus="false">action</button>
<li><details open="0"><summary>summary</summary><p>hidden text</p></details>
</menu>
<figure>
<img srcset="a.png 1x, b.png 2w, c.png" sizes="(bad) 50vw" alt>
<figcaption>caption <mark>highlight</mark></figcaption>
</figure>
<dialog open="no">dialog content</dialog>
</body>
</html>