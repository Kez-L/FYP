<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>foreign content islands</title>
  <style>
    svg { display: block }
  </style>
</head>
<body>
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 120 80" width="120" height="80">
    <title>vector title</title>
    <defs>
      <linearGradient id="g" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0" stop-color="#fff"/>
        <stop offset="1" stop-color="rgb(0,0,0)"/>
      </linearGradient>
      <clipPath id="clip"><circle cx="40" cy="40" r="30"/></clipPath>
    </defs>
    <g transform="translate(2.5 -3)" clip-path="url(#clip)" unknown="x">
      <rect x="0" y="0" width="90" height="70" fill="url(#g)" />
      <path d="M0,0 L20 30 Q40,10 60,50 Z" fill="none" stroke-width="bad"/>
      <text x="4" y="18" rotate="10,20,">A &amp; B</text>
      <foreignObject x="4" y="20" width="90" height="50">
        <div xmlns="http://www.w3.org/1999/xhtml">
          <p>embedded <b>HTML</b></p>
          <table><tr><td>inside svg</td></tr></table>
        </div>
      </foreignObject>
    </g>
  </svg>
  <math xmlns="http://www.w3.org/1998/Math/MathML" display="block">
    <mrow>
      <mi>x</mi><mo>=</mo>
      <mfrac bevelled="maybe">
        <mrow><msup><mi>a</mi><mn>2</mn></msup><mo>+</mo><mi>b</mi></mrow>
        <mroot><mi>c</mi><mn>2</mn></mroot>
      </mfrac>
      <mtext>units <span>mixed</span></mtext>
    </mrow>
  </math>
  <p>after foreign content</p>
</body>
</html>