<!doctype html>
<html>
<head><title>forms with unusual nesting</title></head>
<body>
  <form id="a">
    <input name="x">
    <form id="b" method="get">
      <button type="submit"><span>send</button>
      <select name="choice" multiple size="-3">
        <optgroup label="one" disabled="maybe">
          <option selected selected value=a>A
          <option value="b">B
        </optgroup>
        <option>outside
      </select>
      <input type="hidden" name="h" value="&quot;broken">
    </form>
    <output for="x y">result</output>
  </form>
  <form action="/x" accept-charset="utf-8, windows-1252, ???">
    <fieldset>
      <legend>legend <input name=inside></legend>
      <input type="radio" name=r checked="false">
      <input type="checkbox" name=c indeterminate="true">
      <textarea cols="not-a-number" rows="999999999999999999">value</textarea>
      <select><option><option><optgroup><option>tail</select>
    </fieldset>
  </form>
  <input form="missing" type="text" value="detached">
</body>
</html>