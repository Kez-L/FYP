<!DOCTYPE html>
<html>
<head>
<title>metadata and embedded text</title>
<style media="not all" type="text/css">
body { color: red; }
<!-- broken style comment
</style>
<script language="javascript" type="text/javascript">
if (a < b && c > d) { document.write("</script>"); }
</script>
<noscript><meta http-equiv=refresh content="1"></noscript>
</head>
<body>
<iframe src="about:blank" allowfullscreen="maybe" loading="later"
 sandbox="allow-scripts allow-forms unknown"></iframe>
<object data="movie.bin" type="application/x-unknown" width="bad">
<param name="autoplay" value="maybe">
<param name=quality value=high>
fallback <embed src="x" type="bad/type" height="-2">
</object>
<video controls="false" autoplay="0" preload="sometimes" poster="">
<source src="one" type="video/not-real">
<source src="two">
<track kind="sideways" src="captions.vtt" srclang="xx" default="no">
fallback video
</video>
<audio muted="false" loop="yes"><source src="sound"></audio>
</body>
</html>