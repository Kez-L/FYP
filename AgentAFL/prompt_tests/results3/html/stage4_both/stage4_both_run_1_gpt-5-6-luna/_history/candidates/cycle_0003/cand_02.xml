<!DOCTYPE html>
<html>
<head>
  <title>lists and definitions</title>
</head>
<body>
<ol start="not-a-number" type="Z" reversed="maybe">
  <li value="999999999999999999999999999999999999999">first
  <li><dl compact="compact">
    <dt><b>term <dd>definition
    <dt><dd><p>second definition
  </dl>
  <li>third
</ol>
<ul type="square">
  <li>outer
    <ul>
      <li>inner one
      <li><ul><li>deep</ul>
      <li><div>block in item</div></li>
    </ul>
  <li><p>paragraph item
</ul>
<menu>
  <li type=disc>menu one
  <li type="circle">menu two
</menu>
<dir><li>a<li>b</dir>
</body>
</html>