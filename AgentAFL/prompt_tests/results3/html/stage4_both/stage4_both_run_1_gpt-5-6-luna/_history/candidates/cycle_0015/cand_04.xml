<!DOCTYPE html>
<html>
<head>
  <title>misnested ruby tables and character references</title>
</head>
<body>
  <hgroup><h1>heading one<h4>heading four</hgroup>
  <p>&amp &unknown; &#; &#x; &#xZZ; &#0; &#x10FFFF; &#x110000; &#-1;</p>
  <p><ins><mark><del>overlap</ins>middle</mark>end</del></p>
  <table>
    <tr><td>implicit one
    <caption>late caption</caption>
    <col><colgroup><col span=0></colgroup>
    <tbody>
      <tr><th headers="a b" abbr="x" rowspan=999>H
      <td><select><option>option in cell</select>
    <tr><td><textarea cols=bad rows=-2>raw &lt;textarea&gt;
    <tr><td><p>paragraph in cell<div>block in cell
  </table>
  <ruby>
    <rb>base one
    <rt>reading one
    <rb>base two
    <rtc><span>annotation</span>
    <rt>reading two
  </ruby>
  <p><object><param name=x><source src=x><track kind=bogus src=>
    <video controlslist="autoplay nonsense" poster="[" preload=maybe>
      <track default kind=subtitles srclang="xx-">
      fallback
    </video>
  </object></p>
  <footer><address><a href="mailto:a@b">mail</address></a></footer>
</body>
</html>