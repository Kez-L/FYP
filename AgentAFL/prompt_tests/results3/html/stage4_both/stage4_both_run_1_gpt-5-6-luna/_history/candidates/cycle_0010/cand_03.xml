<!doctype html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">
<head><title>namespace and embedded markup</title></head>
<body>
  <div>
    <svg>
      <foreignObject>
        <div>foreign object text</div>
      </foreignObject>
    </svg>
    <math display="block">
      <mi>x</mi><mo>&InvisibleTimes;</mo><mfrac><mn>1</mn><mrow><mi>y</mi></mrow>
      <annotation encoding="application/xml"><![CDATA[<x>raw</x>]]></annotation>
    </math>
  </div>
  <p>between namespaces</p>
  <object type="image/svg+xml" data="diagram.svg">
    <param name="quality" value="high">
    <div>object fallback</div>
  </object>
  <map name="m">
    <area shape="poly" coords="0,0,10,10,20" href="#a" alt="poly">
    <area shape="circle" coords="bad" href="#b">
  </map>
  <img src="map.png" usemap="#m" ismap="false" alt="">
  <table>
    <caption>caption</caption>
    <colgroup span="x"><col width="10"><col></colgroup>
    <thead><tr><th scope="rowgroup">head</th><th>next</th></tr></thead>
    <tbody>
      <tr><td rowspan="-1">one<td colspan="bad">two</tr>
    </tbody>
    <tfoot><tr><td>foot</td></tr></tfoot>
  </table>
</body>
</html>