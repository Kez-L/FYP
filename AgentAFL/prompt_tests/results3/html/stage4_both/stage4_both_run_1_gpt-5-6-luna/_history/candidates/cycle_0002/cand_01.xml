<!doctype html>
<html>
<head><title>frameset oddities</title></head>
<frameset rows="*,0,auto">
  <frame src="about:blank" name="left" scrolling=maybe>
  <frameset cols="30%;70%">
    <frame srcdoc="<p>inside &amp; broken</p>" frameborder=-1>
    <noframes>
      <body>
        <h1>fallback</h1>
        <p>text before <iframe src="x"><b>iframe fallback</b></iframe> after</p>
        <object data="movie" type="application/x-shockwave-flash">
          <param name="x" value="&quot;">
          <embed src=x>
        </object>
      </body>
    </noframes>
  </frameset>
  </frame>
</frameset>