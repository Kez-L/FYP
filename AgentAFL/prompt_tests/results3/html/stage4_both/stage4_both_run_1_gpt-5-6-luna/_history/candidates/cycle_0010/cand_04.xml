<!doctype html>
<html>
<head><title>misnested flow and section recovery</title></head>
<body>
  <hgroup><h1>Heading <small>minor</small></h1><p>not a heading</p></hgroup>
  <p>before <a href="one"><span>link <a href="two">nested link</a> tail</span></a> after</p>
  <div class="outer">
    <p>paragraph one
    <div class="inner">
      <p>paragraph two
      <ul>
        <li>item one
        <li>item two
          <ol start="zero" reversed="maybe">
            <li value="NaN">subitem
            <li>subitem two
          </ol>
        <li>item three
      </div>
    </ul>
    <blockquote cite="javascript:void(0)">
      <pre><code>line 1
line 2 &lt; literal
      </code></pre>
      <cite>citation</cite>
    </blockquote>
  </div>
  <address>
    <span>Author</span><br>
    <a href="mailto:x@y">x@y</a>
  </address>
  <hr>
  <p>Trailing paragraph
  <div id="end">
    <span>unclosed span
    <custom-element data-a="1"><slot></slot>
  </div>
  </body
</html