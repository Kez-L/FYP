<!DOCTYPE html>
<html>
<head><title>ruby and bidirectional inline structure</title></head>
<body>
  <p dir="rtl" lang="ar">
    <bdi dir="auto">user_123</bdi>
    <bdo dir="sideways">forced text</bdo>
    <ruby>
      漢 <rt>kan</rt>
      <rp>(</rp><rt>ji</rt><rp>)</rp>
      <rtc><rb>annotation</rb><rt>note</rt></rtc>
    </ruby>
    <span translate="maybe" hidden="0" inert="false">inline <wbr>break</span>
  </p>
  <p>
    <del cite="not a uri" datetime="2024-99-99">removed <ins datetime="">replacement</del>
    <mark>marked <time datetime="not-time">yesterday</time></mark>
  </p>
  <pre tabindex="abc"><code class="language-html">&lt;div&gt;
  &amp;copy; &unknown;
&lt;/div&gt;</code></pre>
  <blockquote cite="javascript:void(0)" style="color: rgb(999, -1, none)">
    <p>quoted <q cite="">text</q></p>
  </blockquote>
  <dl compact="maybe">
    <dt>Term one
    <dd>Definition one
    <dt><span>Term two</span></dt>
    <dd><p>Definition two</p><dd>Orphan continuation
  </dl>
  <address><a href="mailto:test@example.invalid?subject=a&b=c">contact</a></address>
</body>
</html>