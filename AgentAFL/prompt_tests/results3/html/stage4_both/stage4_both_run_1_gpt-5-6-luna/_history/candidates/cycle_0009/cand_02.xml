<!doctype html>
<html>
<head>
  <title>interactive and metadata edges</title>
  <meta name="robots" content="noindex,nofollow">
  <meta property="og:title" content="A &quot;title&quot;">
  <link rel="alternate" type="application/rss+xml" media="screen and (min-width: 0px)" href="//host/feed">
</head>
<body>
  <details open="0">
    <summary>Options <em>summary</em></summary>
    <p>hidden content</p>
    <details name="group" open>
      <summary>nested</summary>
      <ul><li>one<li>two</ul>
    </details>
  </details>
  <dialog open="false" aria-modal="perhaps">
    <form method="dialog">
      <p>Choose</p>
      <button type="menu" command="--close" commandfor="d">Accept</button>
      <button autofocus="no" disabled="0">Cancel</button>
    </form>
  </dialog>
  <menu type="toolbar">
    <li><button popovertarget="pop" popovertargetaction="toggle">Open</button>
    <li><a href="#pop" accesskey="1">Help</a>
  </menu>
  <div id="pop" popover="manual" anchor="missing">
    <h2>Popover</h2>
    <p><label for="q">Query</label>
      <input id="q" value="&quot; &apos; &notanentity;">
    </p>
  </div>
  <iframe src="about:blank" sandbox="allow-scripts allow-forms bad-token"
          allow="geolocation 'none'; camera *" referrerpolicy="nonsense">
    <p>iframe fallback</p>
  </iframe>
  <object data="data:text/html,<p>one</p>" type="text/html" usemap="#m">
    <map name="m">
      <area shape="poly" coords="1,2,three,4" href="#x" alt="area">
      <area shape="rect" coords="0,0,10" nohref>
    </map>
  </object>
</body>
</html>