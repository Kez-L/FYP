<!DOCTYPE html>
<html>
<head>
  <title>frameset and legacy document modes</title>
  <meta http-equiv="Content-Security-Policy" content="default-src 'none'; report-uri=[">
</head>
<frameset rows="*,0,garbage" cols="1,,2">
  <frame name="left" src="a.html" scrolling=maybe frameborder=-1>
  <frameset>
    <frame src="b.html" noresize="false">
    <frame src="" marginwidth="999999999999999999999">
  </frameset>
  <noframes>
    <body bgcolor=#ggg text="unterminated>
      <center><font face="&bad;" size="999">
        fallback <blink>obsolete</blink>
      </font></center>
      <table border=bad cellpadding=-4>
        <tr><td>fallback cell
      </table>
    </body>
  </noframes>
</frameset>
<isindex prompt="search &">
<listing><div>raw-ish listing <b>markup</b>
</listing>
<xmp><tag attr="x">literal?</xmp>
<plaintext>
  everything after this may be text
  <html><body><img src=x></body></html>