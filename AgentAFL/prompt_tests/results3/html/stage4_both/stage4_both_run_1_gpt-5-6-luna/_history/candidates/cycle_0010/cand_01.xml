<!doctype html>
<html>
<head>
<title>interactive details and templates</title>
<base href="/assets/">
</head>
<body>
<details open="sometimes">
  <summary>Options <span>summary</span>
  <div class="panel">
    <p>Hidden-ish content <button type="unknown" disabled="maybe">press</button>
  </div>
</details>
<dialog open="false" aria-modal="true">
  <form method="dialog">
    <p>Dialog text</p>
    <menu>
      <li><button value="ok">OK</button>
      <li><button value="cancel">Cancel</button></li>
    </menu>
  </form>
</dialog>
<template id="card">
  <article>
    <h2>Template heading</h2>
    <slot name="label">default label</slot>
    <input name="x">
  </article>
</template>
<main>
  <article itemscope itemtype="https://schema.org/Thing">
    <data itemprop="identifier" value="007">seven</data>
    <time itemprop="dateCreated" datetime="not-a-date">yesterday</time>
    <meter min="10" max="2" low="x" high="y" optimum="z" value="999">meter</meter>
    <progress max="-1" value="NaN">progress</progress>
  </article>
  <p><ruby>漢<rt>かん</rt><rp>(</rp><rt>じ</rt><rp>)</rp></ruby>
  <p><bdi dir="sideways">isolation</bdi> <bdo dir="unknown">override</bdo></p>
  <iframe src="about:blank" sandbox="allow-scripts allow-what" loading="whenever">
    iframe fallback
  </iframe>
</main>
<script type="application/ld+json">{"x":1,}</script>
<noscript><p>noscript branch</p></noscript>
</body>
</html>