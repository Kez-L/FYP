<!doctype html>
<html>
<head>
  <title>ruby and interactive elements</title>
  <script type="text/javascript">
    if (a < b && c > d) { document.write("<div>raw</div>"); }
  </script>
  <noscript><p>noscript <b>fallback</noscript>
</head>
<body>
<details open="closed" name="section">
  <summary><ruby>漢<rt>かん<rp>(</rp>字<rt>じ</ruby></summary>
  <p>inside details
  <dialog open="maybe" aria-modal="sometimes">
    <form method=dialog><button value=ok>OK</button><button autofocus>close
  </dialog>
</details>
<menu type="context">
  <li><button command="toggle-popover" commandfor=pop>menu action</li>
</menu>
<div popover="manual" id=pop anchor=missing>
  <hgroup><h1>heading <h3>wrong rank</hgroup>
  <p><mark>marked <time datetime="not-a-date">yesterday</mark>
  <data value="&quot;"><meter min=10 max=2 low=foo high=-1 optimum=NaN value=99>meter</data>
  <progress max="-Infinity" value="abc">progress</progress>
</div>
<figure>
  <picture>
    <source media="(" srcset="a 1x, b 999w,">
    <source type="image/unknown" src="fallback">
    <img srcset="x,,y 2x" sizes="calc(" alt="figure">
  </picture>
  <figcaption>caption</figcaption>
</figure>
</body>
</html>