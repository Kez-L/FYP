<!DOCTYPE html>
<html>
<head>
<meta charset="utf-16">
<title>comment and declaration boundaries</title>
<!-- ordinary comment -->
<!--- malformed comment -->
<!---->
<![CDATA[head data]]>
<?xml version="1.0"?>
<meta name="viewport" content="width=device-width,initial-scale=1">
<link rel="stylesheet" href="style.css" media="screen and (min-width: 2px)">
</head>
<body>
<!-- comment with -- inside -- and an unfinished marker
<header id="top">
  <nav aria-label="main navigation">
    <ol>
      <li><a href="#one">One</a>
      <li><a href="#two">Two</a></li>
      <li><a href="#three">Three
    </ol>
  </nav>
</header>
<main>
  <article>
    <h1 id="one">A &amp; B &lt; C &gt; D &quot;quoted&quot;</h1>
    <p>Text with unknown &bogus; entity and numeric &#0; &#xD800; &#x110000; values.</p>
    <aside><p>aside starts without a closing element
  </article>
  <section id="two">
    <h2>Nested section</h2>
    <p>alpha <em>beta <strong>gamma</em> delta</strong> epsilon</p>
    <dl>
      <dt>Term one
      <dd>Definition one
      <dt>Term two</dt>
      <dd><code>value</code><wbr><mark>marked</mark>
    </dl>
  </section>
  <section id="three">
    <figure>
      <picture>
        <source srcset="a.webp 1x, b.webp 2x" type="image/webp">
        <source media="(min-width: 400px)" srcset="wide.png">
        <img src="fallback.png" alt="fallback">
      </picture>
      <figcaption>caption without expected nesting</figcaption>
    </figure>
  </section>
</main>
<footer><small>tail</small></footer>
</body>
</html>