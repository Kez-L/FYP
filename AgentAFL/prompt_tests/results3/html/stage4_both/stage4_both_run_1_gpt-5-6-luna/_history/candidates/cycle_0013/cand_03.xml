<!doctype html>
<html>
<head><title>lists and definition structures</title></head>
<body>
  <menu type="context" compact="false">
    <li value="abc">alpha
    <li>beta
      <menu>
        <li>nested one
        <li>nested two
      </menu>
    <li>gamma
  </menu>
  <ol type="Z" start="-999" reversed="0">
    <li value="1.5">first
    <li value="">second
  </ol>
  <ul type="invalid">
    <li>unclosed one
    <li><p>paragraph inside item
    <li><div>block inside item</div>
  </ul>
  <dl compact="maybe">
    <dt>term one
    <dd>definition one
    <dt><b>term two
    <dd><p>definition two
    <dd>extra definition
  </dl>
  <div role="list">
    <div role="listitem" aria-setsize="NaN" aria-posinset="-1">item</div>
    <div role="separator" aria-hidden="perhaps"></div>
  </div>
  <blockquote cite="http://[invalid">
    <p>quoted <cite>source</cite>
  </blockquote>
  <address><a href="tel:+">contact</address>
  <center>legacy <dir><li>directory item</dir></center>
</body>
</html>