<!DOCTYPE html>
<html>
<head>
  <title>Lists and definition structures</title>
</head>
<body>
  <ol start="not-a-number" reversed="false" type="Z">
    <li value="-999">first
    <li>second
      <ul type="square">
        <li>nested one
        <li>nested two
          <ol><li>deep<li>deeper</ol>
      </ul>
    <li><p>third
  </ol>
  <ul compact="maybe">
    text before
    <li>alpha
    <li><div>beta</div>
    orphan text
  </ul>
  <dl compact>
    <dt><strong>Term one
    <dd>Definition one
    <dd><ul><li>definition list<li></ul>
    <dt><dt>Empty terms
    <dd><p>Paragraph<p>Second paragraph
  </dl>
  <dir><li>old item<li>another</dir>
  <menu><li>menu item</menu>
</body>
</html>