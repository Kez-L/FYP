<!DOCTYPE HTML PUBLIC "-//W3C//DTD HTML 4.01 Transitional//EN" "http://www.w3.org/TR/html4/loose.dtd">
<html>
<head>
  <title>Legacy object and parameter markup</title>
  <isindex prompt="Search:">
  <basefont size="999">
  <link rel=stylesheet type=text/css href=//invalid/%2>
</head>
<body bgcolor=#12GG34 text="&unknown;" link=000000 vlink=-1 alink="1e4">
  <center>
    <font face="A&#0;B" size="-99" color="rgb(300,-2,NaN)">
      Before
      <object classid="clsid:" codebase="" data="file:///bad" type="application/x-unknown"
              width="not-a-number" height="-0">
        <param name=name value>
        <param name=value valuetype=ref>
        <param name=movie value="a&amp;b" valuetype=object>
        <object data="nested">
          <param>
          fallback <b>bold <i>italic</object>
        </i>
      </object>
      <applet code="x.class" archive="a.jar,,b.jar" object="broken"
              width=0 height=999>
        <param name=code value="x">
        applet fallback
      </applet>
    </font>
  </center>
  <hr noshade size="-4" width="200%" align=diagonal>
  <marquee behavior=explode direction=sideways loop=notnum scrollamount=-8>
    <blink>legacy <strike>moving</blink> text</strike>
  </marquee>
  <address><a href="mailto:x@@">contact</address>
</body>
</html>