<!doctype html>
<html>
<head><title>Menus, dialogs, and obsolete interactive markup</title></head>
<body>
  <menu type=context compact>
    <li><button type=bogus autofocus=maybe formaction=javascript:x>Run</button>
    <li><button disabled="false"><label>Label<input type=hidden value=x></label></button>
    <li><a href=# onclick="if (a < b) { c++; }">item</a>
  </menu>
  <details open=closed name=x>
    <summary>summary <span>text</details>
  <dialog open=0 tabindex=-999 aria-hidden=maybe>
    <form method=dialog><output for="a b">result</output><input name=a></form>
  </dialog>
  <form action=/submit novalidate=off autocomplete=perhaps>
    <label>outside control <input name=x list=missing></label>
    <datalist id=missing><option value=one label=First><option>two</datalist>
    <textarea cols=0 rows=-2 wrap=diagonal maxlength=-8>one
two &amp; three</textarea>
    <select required size=0>
      <option disabled selected>--</option>
      <option value="&lt;" label="x">choice
      <optgroup><option>orphan
    </select>
    <input type=image src=x alt=alt formaction>
  </form>
  <dl><dt>one<dd>two<dt>three<dd><p>four</dl>
</body>
</html>