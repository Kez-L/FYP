<!doctype html>
<html>
<head>
  <title>Interactive controls</title>
</head>
<body>
  <form id=f method=dialog enctype="multipart/form-data" accept-charset="utf-8, unknown" novalidate>
    <fieldset disabled="0">
      <legend><label for=q>Query</legend>
      <label><input id=q type=text value="a&#0;b" minlength="-1" maxlength="999999999"></label>
      <output name=result for="q missing">output</output>
      <meter min="10" max="2" low="NaN" high="-1" optimum="Infinity" value="999">meter
      <progress max="bad" value="-4">loading</progress>
      <button type=reset formnovalidate=maybe><img src=x alt=reset></button>
    </fieldset>
    <input type=file accept=image/*,, application/x-unknown multiple=maybe>
    <select name=s size=0>
      <optgroup label="group" disabled>
        <option label="x" selected>visible
      </optgroup>
      <option value="&quot;">unterminated
    </select>
  </form>
  <dialog open="false"><p>dialog <form><input name=x></form></dialog>
</body>
</html>