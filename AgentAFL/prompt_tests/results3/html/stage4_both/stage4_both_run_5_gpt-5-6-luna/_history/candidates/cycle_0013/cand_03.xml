<!DOCTYPE html>
<html>
<head>
  <title>Template and embedded data</title>
  <template id=t shadowrootmode=sideways shadowrootdelegatesfocus=maybe>
    <table><tr><td>template <template><p>nested</template></td></tr></table>
  </template>
</head>
<body>
  <main>
    <article>
      <header><h1>Embedded formats</h1></header>
      <pre class=language-html>&lt;div class="x"&gt;&amp;broken;&lt;/div&gt;</pre>
      <x-widget data-json='{"x": [1,2,], "bad": }' disabled=perhaps>
        <slot name=missing>fallback</slot>
        <template><style>p{color:red} </style><p>shadow text</p></template>
      </x-widget>
      <script language=VBScript defer=maybe async=perhaps>
        if (x < 3) then
          document.write("</script><textarea>")
        end if
      </script>
      <noscript>
        <div><p>noscript <img src=x alt=y></div>
      </noscript>
      <textarea>&lt;/textarea&gt; &amp;notclosed
      <plaintext><b>all literal <html><body></plaintext>
    </article>
  </main>
</body>
</html>