<!doctype html>
<html>
<head>
<meta charset="x-unknown">
<title>Interactive elements</title>
</head>
<body>
<main id=main>
  <details open=maybe name=group>
    <summary><b>Summary <i>with mismatched emphasis</summary>
    <p>Hidden content <mark>marked <small>small</details>
  <dialog open=true aria-modal=perhaps>
    <form method=post enctype=multipart/form-data action="?x=1&y=2">
      <label for=who>Who <input id=who name=who required=maybe minlength=-2></label>
      <button type=menu formaction=javascript:void(0) disabled=>Send</button>
      <fieldset disabled=no>
        <legend>Options</legend>
        <input type=checkbox checked=off name=a>
        <input type=radio name=r value=1 checked>
        <output name=result for="who missing">old result</output>
      </fieldset>
    </form>
  </dialog>
  <template id=t><section><p>template <b>content</section></template>
  <slot name=one>fallback <br></slot>
</main>
<footer><address><del cite=unquoted>contact</address></footer>
</body>
</html>