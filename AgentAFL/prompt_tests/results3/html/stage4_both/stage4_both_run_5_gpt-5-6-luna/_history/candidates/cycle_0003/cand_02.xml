<!doctype HTML PUBLIC "-//IETF//DTD HTML 2.0//EN">
<html>
<head>
  <title>Raw text and declarations</title>
  <!-- comment -- -- nested <!-- marker -->
  <!ENTITY foo "bar">
  <!DOCTYPE nested [
    <!ELEMENT weird ANY>
    <!ATTLIST weird x CDATA #IMPLIED>
  ]>
</head>
<body>
  <h1>before <a href="unterminated>after</a>
  <p>entity &notanentity; &#; &#x; &#x110000; &apos; &Tab; &NewLine;
  <x-weird a=1 b='2' c="3" / >custom element</x-weird>
  <script>
    var s = "<div>";
    /* </script> */
    var t = '&lt; &amp;';
  </script attr=ignored>
  <style>
    @import url("x");
    .a { background: url(data:image/svg+xml,<svg></svg>); }
  </style>
  <textarea name="t" disabled="disabled">one &lt; two
    <b>literal markup</b>
  </textarea>
  <xmp><b>raw xmp</b>&amp;</xmp>
  <plaintext>
    <html><body><p>everything becomes text
  </plaintext>
  <p>unreachable-looking tail</p>
</body>