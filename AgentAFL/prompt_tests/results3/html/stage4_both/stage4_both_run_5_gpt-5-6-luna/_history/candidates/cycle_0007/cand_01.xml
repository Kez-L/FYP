<!doctype HTML PUBLIC "-//W3C//DTD HTML 4.01//EN" "http://www.w3.org/TR/html4/strict.dtd">
<html>
<head>
  <title>Lists and ruby boundaries</title>
</head>
<body>
  <h7 class=unexpected>heading seven</h7>
  <blockquote cite="::::">
    <q cite="">quoted <cite>citation</cite>
  </blockquote>
  <ol start=999999999999999999999 reversed type=wat>
    <li value=abc>first
    <li>second
      <ul compact=maybe>
        <li>nested A
        <li>nested B
          <ol><li>deep
      </ul>
    <li><p>third paragraph
  </ol>
  <menu type=invalid>
    <li><a href="http://[broken">menu link</a>
    <li><button type=unknown accesskey="&#0;">button
  </menu>
  <dl>
    <dt><ruby>漢<rt>kan<rp>(</rp></ruby>
    <dd><data value=not-a-number>meaning</data>
    <dt>orphan term
    <dd><dd>two definitions
    <dt><ins cite=bad datetime=never>changed</ins>
  </dl>
  <address><bdo dir=sideways>contact</bdo></address>
  <center><big><small><strike>obsolete nesting</strike></small></big></center>
</body>
</html>