<!DOCTYPE html>
<html>
<head><title>Ruby and inline language elements</title></head>
<body>
  <p lang=ja dir=sideways>
    <ruby>漢<rt>かん<rp>(</rp><rt>kan</rt><rp>)</ruby>
    <bdi dir=auto>abc<bdo dir=invalid>עברית</bdi></bdi>
    <mark><small><big><sup>2</sup><sub>n</sub></big></small></mark>
    <time datetime="2024-99-99T25:61:61Z">now</time>
    <data value=>value</data>
  </p>
  <p><a href="http://[broken" ping="a b" download=0 hreflang=xx referrerpolicy=unknown>
    link <img srcset="a 1w, b 999x, , c" sizes="nonsense" alt=>
  </a></p>
  <figure>
    <img src="" width=-20 height=999999 loading=maybe>
    <figcaption><span title="&notanentity; &amp &copy">caption</span></figcaption>
  </figure>
  <p><object><img src=x><param name=x><embed src=bad></object></p>
  <map name=x><area shape=weird coords="1,2,three" href=#></map>
  <p><b>bold <i>italic <em>em <strong>strong</p>after
</body>
</html>