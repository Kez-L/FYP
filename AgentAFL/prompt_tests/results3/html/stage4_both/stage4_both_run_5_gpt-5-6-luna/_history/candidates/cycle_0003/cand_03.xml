<html>
<head>
  <title>Block closure maze</title>
</head>
<body>
  <address>
    <div>block inside address
      <p>paragraph <span>span
    <blockquote cite="x" cite="y">
      quoted <div>nested block</div>
    </blockquote>
  </address>
  <h2>heading <p>paragraph after heading</h2>
  <div align="center">
    <p>one
    <p>two
    <blockquote><pre>pre
    <div>inside pre?</div></pre></blockquote>
  </div>
  <hr>
  <ins cite="a" datetime="not-a-date"><del><p>deleted paragraph</ins>tail</del>
  <figure>
    <figcaption>caption <b>bold</figure>
    <div>after figure</div>
  </figure>
  <details open="maybe">
    <summary>summary
    <p>details content
  </details>
  <dialog open="0"><p>dialog text</dialog>
  <main><section><article><header>head</section>body</article></main>
</body>
</html>