<!doctype html>
<html>
<head><title>Lists, tables, and obsolete controls</title></head>
<body>
  <menu type="toolbar">
    <li><button accesskey="a" command="--bad">A
    <li><input type="checkbox" checked="0" indeterminate="yes">B
  </menu>
  <table border="abc" cellpadding="-" cellspacing="1e309" width="auto">
    <col span="NaN">
    <thead><tr><th colspan="0">A<th rowspan="999">B</thead>
    <tbody>
      <tr><td rowspan="x">one<td><table><tr><td>nested</table>
      <tr><td colspan="-1">two
    </tbody>
    <tbody><tr><td>second body
    <tfoot><tr><td>footer</tfoot>
  </table>
  <p><label>Label <output for="a b">result</output></label>
  <form id="f">
    <input name="a" type="file" accept="image/*,,text/unknown" multiple="maybe">
    <input name="b" type="range" min="ten" max="-" step="0">
    <input name="c" type="date" value="2024-99-99">
    <button type="button" disabled="false">go</button>
  </form>
  <details><summary><span>sum</details><p>after summary
  <marquee behavior="diagonal" direction="sideways" loop="-1"><blink>old</marquee>
  <ins datetime="2024-13-40T99:99:99Z"><del>old <u>new</ins></del>
</body>
</html>