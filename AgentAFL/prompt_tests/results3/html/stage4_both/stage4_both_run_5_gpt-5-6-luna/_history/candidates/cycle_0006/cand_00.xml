<!doctype html>
<html>
<head>
  <meta charset="utf-8">
  <title>Forms and interactive controls</title>
  <form id=f action="javascript:alert(1)" method=bogus enctype="bad/type" accept-charset="utf-8, koi8-r">
    <fieldset disabled>
      <legend><label for=q>Search <input id=q name=q value="&amp; &lt; &#0; &#xD800;"></label></legend>
      <input type=email name=mail multiple required pattern="[" maxlength=-1>
      <input type=number min=1 max=0 step=0 value=999999999999999999999>
      <input type=date value=2024-02-31>
      <input type=file accept="image/*,.wat" multiple>
      <select name=choice size=-4 multiple>
        <optgroup label="group" disabled>
          <option selected value=one>one
          <option value=two>two</option>
        </optgroup>
        <option>unterminated
      </select>
      <textarea name=body rows=NaN cols=-2 wrap=sideways>text</textarea>
      <button type=submit formaction="/next" formmethod=PATCH>Submit</button>
      <output for="q missing">result</output>
    </fieldset>
  </form>
</head>
<body>
  <input form=f name=outside>
  <label><input type=checkbox checked=maybe>check</label>
  <details open=0><summary>summary</summary><p>hidden-ish</p></details>
  <dialog open=false><form method=dialog><button>close</button></form></dialog>
</body>
</html>