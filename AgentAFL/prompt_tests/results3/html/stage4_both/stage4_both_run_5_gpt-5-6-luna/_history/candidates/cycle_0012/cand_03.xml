<!DOCTYPE html>
<html>
<head>
<meta charset="x-user-defined">
<title>Interactive nesting</title>
</head>
<body>
<header><nav aria-label="main"><a href=#one><span>One</a><a href="#two">Two</nav></header>
<main>
<article itemscope itemtype="not a url">
<hgroup><h1 itemprop=title>Heading<h4>Wrong level</h4></hgroup>
<address><a href=mailto:a@b><p>contact</address>
<dialog open=maybe><form method=dialog><input name=x><button>Close</button></form>
<div contenteditable=maybe draggable=perhaps spellcheck=2 tabindex=abc>
  <p hidden="no">hidden <mark>marked <time datetime="not-date">now</time></mark></p>
  <del cite=x datetime=bad><ins cite=y>changed</del></ins>
</div>
</article>
<aside>
<figure><img alt="missing src"><figcaption>caption</figure>
<map name=><area shape=diagonal coords="a,b,c" href=#></map>
</aside>
</main>
<footer><p>foot <small><small>deep</small></small></p></footer>
</body>
</html>