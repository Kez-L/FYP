<!doctype html>
<html>
<head>
  <title>Form controls and obsolete attributes</title>
</head>
<body bgcolor="#gggggg" text="not-a-color" link="rgb(,)" vlink=none alink="">
  <form action="http://[::ffff:999.999.1.1" method=SIDEWAYS enctype=unknown
        accept-charset="utf-8, invalid, utf-16" target=>
    <fieldset disabled=maybe name=123>
      <legend><label>Account <input type=text name=user autofocus=perhaps></label></legend>
      <input type=email name=mail multiple=maybe list=no-list required=perhaps
             minlength=-4 maxlength=NaN size=zero>
      <input type=number min=foo max=bar step=0 value=1e999>
      <input type=date min=2024-13-40 max=0000-00-00 value=yesterday>
      <input type=range min=10 max=-10 step=NaN value=middle>
      <input type=file accept="image/*,,,,application/x-unknown" capture=sideways>
      <input type=image src= alt="unterminated name=x
      <textarea name=comments rows=-1 cols=NaN wrap=diagonal maxlength=-2>one
      <select name=multi multiple size=-1>
        <option value=1 disabled=maybe>one
        <option value=2 selected>two
      </select>
      <button type=unknown formaction="http://[" formmethod=sideways formnovalidate=maybe>
        submit
      </button>
      <output for="a b c" name=out>result</output>
      <progress max=NaN value=-1>loading</progress>
      <meter min=10 max=0 low=NaN high=-2 optimum=sideways value=999>meter</meter>
    </fieldset>
  </form>
  <iframe srcdoc="<p>unterminated &amp; <b>x" sandbox="allow-what?" width=NaN height=-5></iframe>
</body>
</html>