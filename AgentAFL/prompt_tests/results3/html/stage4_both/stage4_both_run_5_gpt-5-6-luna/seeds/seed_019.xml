<!doctype html>
<html xmlns="http://www.w3.org/1999/xhtml" xml:lang=en>
<head><title>Foreign namespaces</title></head>
<body>
<svg viewBox="0 0 100 100" width="100%" height="-1" preserveAspectRatio="bad">
  <title>SVG title</title>
  <defs><linearGradient id=g x1=0% y1=0% x2=100% y2=100%>
    <stop offset="0%" stop-color="#zzzzzz"><stop offset=110% stop-opacity=NaN>
  </linearGradient></defs>
  <g transform="translate(1 2) rotate(foo)" onclick="a<b">
    <path d="M0,0 L10,10 Z junk" fill=url(#g) stroke-width="-3"/>
    <foreignObject x=0 y=0 width=20 height=20>
      <div xmlns="http://www.w3.org/1999/xhtml">foreign <b>text</div>
    </foreignObject>
  </g>
</svg>
<math display=sideways>
  <mrow><mi>x</mi><mo>&lt;</mo><msup><mi>y</mi><mn>2</mn></msup>
  <annotation-xml encoding=application/xhtml+xml><p>math html</annotation-xml>
  <mo>+</mo><mtext><b>bad nesting</mtext></mrow>
</math>
<iframe srcdoc="<p>inner &amp; <b>frame</b>" sandbox=allow-scripts,foo></iframe>
</body>
</html>