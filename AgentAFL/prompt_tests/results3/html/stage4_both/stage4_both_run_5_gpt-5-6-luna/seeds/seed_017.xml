<!DOCTYPE html>
<html>
<head><title>Table reconstruction</title></head>
<body>
<table border=0 summary="a & b" rules=sideways>
  <colgroup span=zero><col width=12*><col span="NaN"></colgroup>
  <thead><tr><th colspan=0 rowspan=-1>Head<th>Second</thead>
  orphan before body
  <tbody>
    <tr><td>A<td>B<tr><td colspan="999">C
    <tr><th scope=invalid headers=x><form><input name=q></form>
  </tbody>
  <tfoot><tr><td>Footer</tfoot>
  text between sections
  <tbody><tr><td><table>
      <tr><td>nested one
      <tr><td>nested two</tr>
    </table>tail
  </tbody>
  <caption align=diagonal><span>late caption</span></caption>
</table>
<p>after table<table><tr><td>x</table>after second
</body>
</html>