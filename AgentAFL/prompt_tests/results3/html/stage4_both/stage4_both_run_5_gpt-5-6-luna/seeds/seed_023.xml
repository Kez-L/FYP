<!DOCTYPE html>
<html>
<head><title>Embedded resources and map</title></head>
<body>
  <picture>
    <source media="(min-width: 1px)" type="image/avif" srcset="a.avif 1x, b.avif 2x">
    <source srcset="small.png 320w, large.png 1280w" sizes="calc(100vw - 2em)">
    <img srcset="fallback-1x.jpg 1x" src="fallback.jpg" width="auto" height="-5" alt="fallback">
  </picture>
  <figure>
    <object data="data:text/html,<p>x</p>" type="application/octet-stream" width="NaN" height="0">
      <param name=movie value="&quot;unterminated">
      <embed src="plugin.bin" type="application/x-test" hidden=maybe>
      alternate object text
    </object>
    <figcaption>caption after object</figcaption>
  </figure>
  <map name="m">
    <area shape=poly coords="0,0,10,10,bad" href="#a" alt="one">
    <area shape=circle coords="x y r" nohref>
    <area shape=rect coords="1,2,3" href="" alt="">
  </map>
  <img src="mapped.png" usemap="#m" border="999999999999">
  <video controlslist="nodownload foobar" autoplay="maybe" poster="p.jpg" preload=invalid>
    <source src="movie.mp4" type="video/mp4; codecs=&quot;x&quot;">
    <track kind=subtitles srclang=xx default=maybe label="&lt;bad&gt;">
    video fallback
  </video>
  <audio src="" loop=off muted=no>audio fallback</audio>
</body>
</html>