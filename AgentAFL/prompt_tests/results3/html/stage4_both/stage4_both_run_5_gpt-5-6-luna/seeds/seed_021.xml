<!DOCTYPE html>
<html>
<head>
  <meta charset="windows-1252">
  <title>Foreign content crossings</title>
</head>
<body>
  <svg width="100%" viewBox="0 0 10 10" preserveAspectRatio="none">
    <title>SVG title</title>
    <defs><linearGradient id="g"><stop offset="0%"/><stop offset="110%"/></linearGradient></defs>
    <g transform="translate(1,2) rotate(-45)">
      <foreignObject x="-1" y="-2" width="20" height="20">
        <div xmlns="http://www.w3.org/1999/xhtml">
          <p>inside foreign object <b>bold</b></p>
          <table><tr><td>cell</td></tr></table>
        </div>
      </foreignObject>
      <path d="M0,0 L10,10 Z" fill="url(#g)" stroke-width="NaN"/>
      <text x="1" y="2"><tspan dx="1em">text</tspan></text>
    </g>
  </svg>
  <math display="block">
    <mi>x</mi><mo>&InvisibleTimes;</mo>
    <mrow><msup><mi>y</mi><mn>2</mn></msup><munder><mo>∑</mo><mi>i</mi></munder></mrow>
    <annotation-xml encoding="application/xhtml+xml">
      <p xmlns="http://www.w3.org/1999/xhtml">annotation</p>
    </annotation-xml>
  </math>
  <p>after math</p>
</body>
</html>