<!doctype html>
<html lang="en">
<head>
  <meta http-equiv="refresh" content="0; url='//invalid/%%" />
  <meta name="keywords" content="a,b,c">
  <title>Forms and controls</title>
</head>
<body>
  <form id=f1 action="/submit?x=1&amp;y=2" method=dialog target=_blank autocomplete=maybe>
    <input type=text name=user value="a&amp;b" list=choices>
    <datalist id=choices>
      <option value=one label="One">
      <option value=two selected=selected>Two
    </datalist>
    <select name=pick multiple size=-1 required=0>
      <optgroup label="Group" disabled=off>
        <option selected>alpha<option>beta
      </optgroup>
      <option value=gamma>gamma
    </select>
    <textarea name=notes wrap=sideways maxlength=-10>line 1
line 2 &amp; &#0; &#xD800;</textarea>
    <output name=result for="user pick">old result</output>
    <progress value=999 max=0>progress text</progress>
    <meter min=10 low=5 optimum=NaN high=2 max=-1 value=3>meter</meter>
    <button type=reset formnovalidate="false">Reset</button>
  </form>
  <fieldset form=f1 name=outside disabled>
    <legend>Legend <input name=legend></legend>
    <input type=image src=x alt=submit formaction=/other>
  </fieldset>
  <form><input name=x></form>
  <label>unassociated <input type=file accept="*/*,image/*" capture=environment></label>
</body>
</html>