<!doctype html>
<html>
<head>
  <title>Raw text and declarations</title>
  <style type=text/css media="screen,,print">
    body { color: red; }
    </style>
    <script type="text/javascript">
      if (a < b) { document.write("</script><p>injected"); }
    </script>
    <noscript><style>.x{background:url("x")}</style><p>noscript</noscript>
    <template id=t><div><span>template <template><b>nested</b></template></div></template>
</head>
<body>
  <![CDATA[not really cdata <b>bold</b>]]>
  <?xml version="1.0"?>
  <!foo bar baz>
  <!----><! -- malformed comment --><!-[CDATA[wat]]>
  <script language=vbscript src=http://x/one?x=1&y=2>
    <!-- legacy <tag> & entity -->
  </script>
  <style>
    .a { content: "</style>"; } <b>still style?
  </style>
  <x-custom a:b="v" @bad="x"><![CDATA[x<y]]></x-custom>
</body>
</html>