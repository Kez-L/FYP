<!doctype html>
<html>
  <head>
    <title>Sections, ruby, and annotations</title>
  </head>
  <body>
    <header><nav><a href="#one">one<a href="#two">two</nav></header>
    <main>
      <section id=one>
        <hgroup><h1>Heading <small>small</h3><h2>Subheading</h2></hgroup>
        <p>Text <ruby>漢<rt>かん<rp>(</rp><rt>kan</rt><rp>)</ruby> end.
        <blockquote cite="http://example.test/quote"><p>quoted <q cite=>nested</blockquote>
        <ins datetime="not-a-date">added <del cite="/x" datetime="2020-99-99">removed</ins>
      </section>
      <aside>
        <menu type=context>
          <li><button command=toggle commandfor=x>item</button>
          <li><a download="a b" ping="http://x http://y">download</a>
        </menu>
      </aside>
      <section id=two>
        <article><h2>Article</h2><p>paragraph
          <table>
            <caption>cap<table><tr><td>wrong</table>after caption
            <col><tr><td>x</td></tr>
          </table>
        </article>
      </section>
    </main>
    <footer>
      <div itemscope itemtype="http://schema.org/Person">
        <span itemprop=name>Alice</span>
        <meta itemprop=age content="-999">
        <link itemprop=url href="not a url">
      </div>
      <template shadowrootmode=open><p>template <b>content</template>
    </footer>
  </body>
</html>