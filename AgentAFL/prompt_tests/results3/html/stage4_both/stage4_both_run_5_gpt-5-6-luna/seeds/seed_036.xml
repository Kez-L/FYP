<!doctype html>
<html>
<head>
  <title>Ruby and bidirectional text</title>
  <meta http-equiv=content-language content="xx-YY">
  <style type="text/css">
    @import url("unterminated;
    body { color: #123456789; width: calc(1px + ); }
  </style>
</head>
<body dir=sideways>
  <p lang="ja" dir=rtl>
    <ruby>
      <rb>漢字
      <rt lang=en>kanji
      <rtc><span>annotation</ruby>
    <bdo dir=ltr>abc <bdi>xyz</bdo> tail
  </p>
  <section>
    <header><hgroup><h1>One<h2>Two</header>
    <article>
      <p>alpha <mark>marked <small>small</article>
      <aside><q cite="&quot;broken">quote<cite>source</aside>
    </section>
  <details open=maybe name=x>
    <summary>Summary <time datetime="2024-99-99T99:99:99Z">now</time></summary>
    <p hidden="false">Hidden <data value=>value</data></p>
  </details>
  <figure>
    <img srcset="a 1x,b 0w,c -2x" sizes="calc(100% - )" alt="a&b">
    <figcaption>caption</figcaption>
  </figure>
</body>
</html>