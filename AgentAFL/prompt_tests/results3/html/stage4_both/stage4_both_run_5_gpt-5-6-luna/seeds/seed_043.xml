<!DOCTYPE html>
<html>
<head><title>Namespaces and foreign content</title></head>
<body>
  <svg width="1e9" height="-4" viewBox="0 0 100 bad" preserveAspectRatio="sideways">
    <title>svg title</title>
    <defs><linearGradient id=g x1="NaN" y2="999%"><stop offset="-2"/></linearGradient></defs>
    <g transform="matrix(1,0,0,1,foo,bar)" onclick="x<y">
      <rect x=-1 y=bad width=999999 height=0 fill="url(#missing)"/>
      <path d="M 0 0 L nope Z Q" stroke-width="-3"/>
      <text x="1"><tspan dy="bad">svg text</tspan></text>
      <foreignObject><div xmlns="http://www.w3.org/1999/xhtml"><p>embedded html</p></div></foreignObject>
    </g>
  </svg>
  <math display=sideways>
    <mi mathvariant=unknown>x</mi>
    <mo>&InvisibleTimes;</mo>
    <mfrac linethickness=NaN><mn>1</mn><mrow><mo>(</mo><mn>0</mn></mrow></mfrac>
    <semantics><mrow><msup><mi>a</mi><mn>2</mn></msup></mrow><annotation encoding=x>raw</annotation></semantics>
  </math>
  <p xmlns:xlink="urn:bad"><custom-element foo:bar=x is=y>text</custom-element></p>
</body>
</html>