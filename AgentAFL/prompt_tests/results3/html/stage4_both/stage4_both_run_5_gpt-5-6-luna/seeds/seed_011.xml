<!DOCTYPE HTML PUBLIC "-//W3C//DTD HTML 3.2//EN">
<HTML>
<HEAD>
  <TITLE>Map and embedded content</TITLE>
  <ISINDEX PROMPT="Search:">
</HEAD>
<BODY>
  <P><IMG SRC="x" ALT="a & b" WIDTH="NaN" HEIGHT="-999" BORDER="none" USEMAP="#m">
  <MAP NAME="m" ID="m">
    <AREA SHAPE="rect" COORDS="0,0,10,10" HREF="one">
    <AREA SHAPE="circle" COORDS="x,y,r" NOHREF>
    <AREA SHAPE="poly" COORDS="1,2,3" HREF>
    stray map text
  </MAP>
  <OBJECT CLASSID="clsid:invalid" CODEBASE="" DATA="data:text/plain,abc" TYPE="bad/type"
          WIDTH="0" HEIGHT="%" ALIGN="sideways">
    <PARAM NAME="movie" VALUE="a&b">
    <PARAM NAME= VALUE=>
    fallback <EMBED SRC="plugin" TYPE="application/x-unknown" HIDDEN="false">
  </OBJECT>
  <APPLET CODE="X.class" CODEBASE="/x" ARCHIVE="a.jar,b.jar" WIDTH="-" HEIGHT="auto">
    <PARAM NAME="x" VALUE="1">
    <TEXTAREA>not really textarea</TEXTAREA>
  </APPLET>
  <P><IMG SRCSET="a 1x, b 2w, c" SIZES="(min-width: ) 50vw,">
  <NOFRAMES><DIV>ordinary fallback <A HREF="#m">anchor</A></DIV></NOFRAMES>
</BODY>
</HTML>