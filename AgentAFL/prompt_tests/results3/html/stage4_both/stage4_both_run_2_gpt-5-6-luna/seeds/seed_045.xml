<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <base href="not a valid base">
  <title>table repair and character references</title>
  <!-- unterminated-looking -- comment -- >
  <style type="text/plain">body { color: red; }</style>
</head>
<body>
  <table border="not-a-number" cellpadding="-4" cellspacing="huge">
    text before row
    <caption align="sideways">caption <b>bold</caption>
    <colgroup span="-1"><col width="none"><colgroup><col></colgroup>
    <thead><tr><th rowspan="zero" colspan="-9">head<th scope="mystery">second
    <tbody>
      <tr><td headers="a b" rowspan="999999999999999999999">one
      <td><p>paragraph in cell<table><tr><td>inner</table>tail
      <tr><td>unclosed
    <tfoot><tr><td colspan="garbage">foot</td></tr></tfoot>
  </table>
  <p>&unknown; &#x110000; &#999999999; &copy no-semi &notit; &amp</p>
  <p>before<br/>after<hr/></p>
  <![CDATA[ not really cdata in HTML ]]>
</body>
</html>