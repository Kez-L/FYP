<!DOCTYPE html>
<html>
<head>
  <title>foreign boundaries and malformed markup</title>
</head>
<body>
  <svg>
    <metadata><rdf:RDF><rdf:Description></rdf:Description></rdf:RDF></metadata>
    <g><a href="x"><text>svg text</a></g>
    <switch requiredExtensions="bad"><foreignObject><p>html in svg</p></foreignObject>
    <use xlink:href="#missing" xlink:actuate="maybe"></use>
  </svg>
  <math>
    <mrow><mi mathvariant="unknown">x</mi><mo>+</mo><mfrac><mn>1</mn><mroot><mn>2</mn></mroot></mfrac>
    <annotation-xml encoding="application/xhtml+xml"><div><b>embedded</b></annotation-xml>
  </math>
  <p>text<!-- comment with -- double -- hyphen --><span>after
  <?processing instruction?>
  <!bad declaration>
  <!DOCTYPE nested SYSTEM "strange">
  <form>
    <input type="file" accept=",,,application/x-unknown" capture="maybe">
    <input type="checkbox" checked="false" indeterminate="yes">
    <textarea wrap="sideways" minlength="999999999999" maxlength="-1">text</textarea>
  </form>
</body>
</html>