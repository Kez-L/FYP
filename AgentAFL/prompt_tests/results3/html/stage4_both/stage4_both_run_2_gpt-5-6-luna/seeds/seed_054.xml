<!doctype html>
<html>
<head><title>custom tree and obsolete boundaries</title></head>
<body>
<template shadowrootmode="open" shadowrootdelegatesfocus="maybe">
  <style>:host { display: block }</style>
  <slot name="title">fallback <b>content</b></slot>
</template>
<widget-panel is="unknown-widget" data-x="&quot; &apos; &#xZZ;" foo=bar foo=baz>
  <template><p>template child <slot></slot></p></template>
  <div slot="title">slotted <font face="&bad;" color="rgb(0,0,0)" size="huge">text</font></div>
</widget-panel>
<center><big><strike>obsolete <tt><blink>formatting</strike> continuation</tt></big></center>
<dir compact="maybe"><li>alpha<li>beta<ul><li>gamma</dir>
<marquee behavior="sideways" direction="diagonal" loop="-1"><img srcset="a 1x, b nope, c 999999w" alt=></marquee>
<applet code="x" archive="a b" object="missing" align="unknown"><param name="x" value="&unterminated"><p>fallback</applet>
<noscript><div><p>noscript markup</div></noscript>
<ins><del>overlap <span>text</ins> ending</del>
</body>
</html>