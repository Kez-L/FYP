<!DOCTYPE html>
<html>
<head>
  <title>obsolete vocabulary and empty-element confusion</title>
</head>
<body>
<center><font face="&quot;Times New Roman&quot;" size="999" color="#GGGGGG">
  <big><big>large <small>small</big> middle</small></big>
</font></center>
<dir compact="no"><li>directory one<li>directory two<ul><li>nested</ul></dir>
<menu><li>menu item<dt>unexpected term<dd>unexpected definition</menu>
<marquee behavior="sideways" direction="diagonal" loop="-1">scroll <blink>blink</blink></marquee>
<isindex prompt="Search: &quot;" action="/search">
<hr></hr><br></br><img src="x"></img><input type="text"></input>
<p align="justify" valign="middle">text <u><s><strike>old</u> crossed</s></strike>
<tt><code><kbd>input</tt></code></kbd>
<acronym title="x">ABC<abbr title="y">DEF</acronym></abbr>
<object data="movie.bin" type="application/x-unknown" width="bad" height="-20">
  <param name="movie" value="&broken">
  <embed src="fallback" pluginspage="nowhere">
  <noembed><p>fallback</p></noembed>
</object>
</body>
</html>