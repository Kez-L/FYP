<!DOCTYPE html>
<html><head><title>frameset case</title></head>
<frameset rows="*,0,25%" cols="50%,50%">
<frame src="a.html" name="left" scrolling="no">
<frame src="b.html" name="right">
<noframes>
<body>
<iframe srcdoc="<p>embedded &amp; broken</p>" width="0" height="-1"></iframe>
<object data="x" type="text/html"><param name="movie" value="x"><embed src="y" />
<p>fallback
</object>
<map name="m"><area shape="poly" coords="0,0,1,1" href="#x"><area></map>
<img src=x alt="a>b" usemap="#m" ismap>
</body>
</noframes>
</frameset>
</html>