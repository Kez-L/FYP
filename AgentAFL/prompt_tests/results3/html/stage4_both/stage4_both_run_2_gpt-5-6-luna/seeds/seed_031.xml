<!DOCTYPE html>
<html>
<head><title>forms and controls</title></head>
<body>
<form id=f action="/submit?x=1&y=2" method=post enctype=multipart/form-data accept-charset="utf-8, iso-8859-1" autocomplete=off>
<input type=hidden name=token value="a=b&c">
<input type=search name=q list=suggestions autofocus formnovalidate>
<datalist id=suggestions><option value=alpha label="A"><option value=beta></datalist>
<input type=number name=n min=10 max=2 step=0 value=999>
<input type=range name=r value=-100 min=20 max=5>
<input type=date name=d value=2024-02-31>
<input type=file name=upload accept="image/*,.txt" multiple directory>
<select name=pick size=0><option value=1>one<option value=2 selected>two</select>
<select name=multi multiple><optgroup label=x disabled><option>bad</optgroup><option>good</select>
<textarea name=t wrap=invalid maxlength=9999999999>line 1
line 2 &amp; text</textarea>
<output name=o for=x y>sum</output>
<button type=submit formaction="" formenctype=text/plain formmethod=GET formtarget=_self>send</button>
</form>
<label for=missing>orphan</label>
<fieldset form=f><legend>extra</legend><input name=outside></fieldset>
</body>
</html>