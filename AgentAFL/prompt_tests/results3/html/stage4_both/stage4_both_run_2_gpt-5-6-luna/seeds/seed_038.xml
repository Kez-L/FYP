<!DOCTYPE html>
<html>
<head><title>interactive controls</title></head>
<body>
<menu type=context>
<li><button type=menu command="--open" commandfor=dialog>Open</button>
<li><button type=submit formnovalidate="no" popovertarget=pop popovertargetaction=toggle>Toggle</button>
</menu>
<dialog id=dialog open="no" closedby=everything>
<form action="?" method=PATCH enctype="multipart/unknown" autocomplete=maybe>
<fieldset name=group disabled="0">
<legend>Account</legend>
<input type=email name=e multiple="false" min="foo" max="-Infinity" step=0.0 pattern="[">
<input type=number name=n value=NaN>
<input type=date name=d min=2026-99-99 max=not-a-date>
<input type=color name=c value="#12">
<input type=file name=f accept="image/*,.wat,," capture=maybe>
<input type=checkbox checked="false" switch>
<input type=radio name=r required>
<select name=s size=-4 required="false">
<option value=a selected=0>Alpha<option value=b label="B">Beta
</select>
<output name=o for="x y">result</output>
</fieldset>
<datalist id=list><option value="a" label="A"><option value="b"></datalist>
<input list=list name=withlist>
<button type=reset>Reset</button>
</form>
</dialog>
<div id=pop popover=manual anchor=dialog>popover</div>
<details name=group open="no"><summary>one</summary><p>detail</p></details>
<details name=group open><summary>two</summary><p>other</p></details>
</body>
</html>