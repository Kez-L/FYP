<!DOCTYPE html PUBLIC "-//W3C//DTD HTML 4.01//EN">
<html>
<head><title>frames and declarations</title></head>
<frameset rows="*,0,garbage" cols="50%,50%,">
  <frame src="a.html" name="a" frameborder="-1" scrolling=maybe noresize=false>
  <frameset>
    <frame src=about:blank>
    <noframes>
      <body>
        <p>fallback</p>
        <table>
          <tr><td>x<td>y
          <tr><th colspan="x">z
        </table>
      </body>
    </noframes>
  </frameset>
  <frame>
</frameset>
<noframes>
  <body>
    <map name=map><area shape=poly coords="1,2,three" href=#></map>
    <img src="x" usemap="#map">
    <applet code="Foo.class" archive="a.jar,b.jar" width=bad height=>
      <param name=foo value=bar>
      fallback
    </applet>
    <!--- malformed comment --!>
    <![CDATA[not really cdata <tag>]]>
  </body>
</noframes>
</html>