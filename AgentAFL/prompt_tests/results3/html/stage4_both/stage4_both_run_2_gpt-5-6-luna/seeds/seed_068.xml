<!DOCTYPE html>
<html>
<head><title>obsolete containers and omitted ends</title></head>
<body>
<dl compact><dt>alpha<dd>one<dt>beta<dd>two<dd>three</dl>
<menu compact><li value=0>zero<li value=-1>negative<li>last</menu>
<dir><li>directory<li><li>empty text</dir>
<blockquote cite=about:blank><p>quote one<p>quote two</blockquote>
<figure><figcaption><a href=#><b>caption</a></figcaption><pre>pre
line <code>code</pre><figcaption>late caption</figcaption></figure>
<details open=maybe><summary><b>summary</summary><p>detail one</details>
<dialog open><p>dialog <div>block</div></dialog>
<main><header><hgroup><h1>one<h2>two</hgroup><section><h3>three</section></header>
<aside><p>aside <footer>foot</aside></footer>
<section><h1>heading<h7>bad heading</h7><p>text</section>
<article><header>nested<header>again</header></header><footer><address>x</footer></article>
<legend>outside legend</legend>
</body>
</html>