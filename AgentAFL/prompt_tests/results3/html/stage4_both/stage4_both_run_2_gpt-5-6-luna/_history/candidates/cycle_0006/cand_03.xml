<!doctype html>
<html>
<head><title>forms and controls</title></head>
<body>
<form id=f action method=dialog enctype="multipart/form-data; boundary=" accept-charset="UTF-8, bogus" autocomplete=maybe>
<label for=field>Label<input id=field name=q value="a&quot;b" required=perhaps autofocus=0></label>
<select name=s multiple size=999999>
<option value=one selected=selected>one
<optgroup label="group"><option disabled="no">two<option>three</optgroup>
</select>
<datalist id=dl><option value=a><option value=b label=c>text</datalist>
<input list=dl type=image src=x alt=y formaction=z>
<button type=reset formaction=/x formmethod=UNKNOWN>button</button>
<textarea wrap=sideways maxlength=-1 minlength=99999999999999999999>text</textarea>
<output for="field missing" name=o>result</output>
<fieldset disabled=false><legend>legend</legend><input type=week min=2024-W99 max=abc step=NaN></fieldset>
<progress max=-1 value=Infinity>progress</progress>
<meter min=10 low=9 optimum=foo high=2 max=1 value=999>meter</meter>
<input type=file accept="image/*,,application/x" multiple=false>
</form>
<form><input name=x><button form=f type=submit>submit</button></form>
</body>
</html>