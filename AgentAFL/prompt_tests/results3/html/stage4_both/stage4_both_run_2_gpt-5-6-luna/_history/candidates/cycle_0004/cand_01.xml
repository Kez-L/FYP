<?xml version="1.0"?>
<!DOCTYPE svg [
  <!ENTITY local "replacement">
  <!ELEMENT odd ANY>
]>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:x="urn:test">
<head><title>mixed namespaces</title></head>
<body>
  <x:widget x:a="1" a:b="2"><x:item /></x:widget>
  <svg width="1e309" height="-0" viewBox="0 0 10">
    <foreignObject required="yes">
      <div class="inside">text &local;</div>
    </foreignObject>
    <path d="M0 0 LNaN Infinity Z" fill="url(#x)" />
  </svg>
  <math><mrow><mi>x</mi><mo>&InvisibleTimes;</mo><mn>2</mn></mrow></math>
  <p data-a="one" data-a="two" style="color: rgb(999,-1,none)">tail
</body>
</html>