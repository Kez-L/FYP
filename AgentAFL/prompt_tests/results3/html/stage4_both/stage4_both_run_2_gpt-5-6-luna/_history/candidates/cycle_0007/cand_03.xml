<!DOCTYPE html>
<html>
<head><title>svg math and foreign content</title></head>
<body>
<svg width="100%" viewBox="0 0 100 100" preserveAspectRatio="none">
<title>vector</title>
<defs><linearGradient id=g x1=0 y1=0 x2=1 y2=1><stop offset="0%" stop-color="#fff"/><stop offset="120%" stop-color=none></linearGradient></defs>
<g transform="translate(1e2,-3) rotate(foo)" fill="url(#g)">
<path d="M0 0L10 10Z" stroke-width="-1" />
<circle cx=nan cy=inf r=999999999999999999 />
<text x=1 y=2>svg <tspan dy="-3">text</tspan></text>
</g>
<foreignObject x=0 y=0 width=50 height=50><div xmlns="http://www.w3.org/1999/xhtml">html <input></div></foreignObject>
</svg>
<math display=block><mi>x</mi><mo>&lt;</mo><mfrac><mn>1</mn><mrow><mi>y</mi><mo>+</mo><mn>2</mn></mrow></mfrac><msup><mi>z</mi><mn>2</mn></msup></math>
<p>after math</p>
</body>
</html>