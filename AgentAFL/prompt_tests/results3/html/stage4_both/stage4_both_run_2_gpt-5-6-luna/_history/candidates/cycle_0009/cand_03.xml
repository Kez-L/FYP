<body>
  <picture>
    <source type="image/avif" media="(orientation: sideways)" srcset=", , a, b 2x, c -1x">
    <source type="" srcset="data:image/svg+xml,%3Csvg%3E 1x">
    <img alt="&quot;" src="data:," usemap="#map" ismap="no" referrerpolicy="what" crossorigin="maybe">
  </picture>
  <map name="map">
    <area shape="rect" coords="1,2,3" href="" alt="a">
    <area shape="circle" coords="1,2" href="http://[:::" alt="b">
    <area shape="default" coords="" nohref="false" alt="c">
  </map>
  <audio controlslist="nodownload invalid" autoplay="perhaps" loop="-1" muted="no" preload="sometimes">
