    <source src="" type="audio/mpeg; codecs=&quot;">
    fallback
  </audio>
  <video poster="" width="auto" height="-" playsinline="0" disablepictureinpicture="false">
    <track kind="captions" src="caption.vtt" srclang="xx" label="" default="no">
    <track kind="invalid" src="data:text/vtt,%00%FF">
    video fallback
  </video>
  <object data="x" type="bad/type" name="obj" usemap="#none" form="missing">
    <param name="movie" value="javascript:bad">
