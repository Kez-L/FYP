<!DOCTYPE html>
<html>
<head>
  <title>interactive boundaries</title>
</head>
<body>
  <details open="0" name="group">
    <summary tabindex="not-a-number"><bdi>summary</bdi></summary>
    <details open><summary>nested</summary><p>inside</p></details>
    <dialog open="maybe" aria-modal="sometimes">
      <form method="dialog" target="???">
        <output for="x y z" name="result">old</output>
        <input id="x" type="date" min="tomorrow" max="yesterday" step="0" value="not-a-date">
        <button popovertarget="p" popovertargetaction="explode">submit</button>
      </form>
    </dialog>
  </details>
  <div popover="manual" id="p" anchor="missing" role="invalid-role">
    <p><b><i><u><s><small><big><em>crossed formatting
    <br><wbr><bdo dir="invalid">text</bdo></em></big></small></s></u></i></b></p>
  </div>
  <menu type="context"><li><button type="menu">one</button><li>two</menu>
  <p><ins datetime="not-a-date" cite="::::">inserted</ins>
     <del datetime="" cite="%%%"><span>deleted</span></del></p>
  <div contenteditable="true" inputmode="mystery" translate="maybe">editable</div>
</body>
</html>