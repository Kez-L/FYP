<!doctype HTML>
<html>
<head><title>ruby and interactive elements</title></head>
<body>
<main>
<article itemscope itemtype="http://schema.org/Thing">
<header><hgroup><h1 itemprop="name">Title</h1><h6>small</h6></hgroup></header>
<p><ruby><rb>漢</rb><rt>かん</rt><rp>(</rp><rt>kan</rt><rp>)</rp><rtc>annotation</rtc></ruby>
<details open="false" name="group"><summary>Summary <mark>marked</summary><p>hidden-ish content</p></details>
