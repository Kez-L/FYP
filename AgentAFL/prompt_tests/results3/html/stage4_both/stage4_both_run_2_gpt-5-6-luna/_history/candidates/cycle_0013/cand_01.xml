<meter min="10" max="2" low="nan" high="-inf" optimum="999">meter</meter>
<progress max="-1" value="infinity">progress</progress>
<dl><div><dt><data value="001">one</data><dd><time datetime="not-a-date">time</time></div>
<figure><picture><source media="(" srcset="a 1x, b 999999x"><img srcset="a 1w, b" sizes="calc(" alt="broken"></picture><figcaption>caption</figcaption></figure>
<video controlslist="nodownload nonsense" preload="maybe"><track kind="captions" srclang="xx" default="false"><source srcset="x" type="bad/type"></video>
</article>
</main>
