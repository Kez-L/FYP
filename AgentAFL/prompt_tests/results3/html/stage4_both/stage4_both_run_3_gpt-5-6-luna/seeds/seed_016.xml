<!doctype html>
<html>
<head>
<title>foreign namespaces</title>
</head>
<body>
<svg viewBox="0 0 100 100" width="1e309" height="-0" xmlns="http://www.w3.org/2000/svg">
<defs><linearGradient id=g><stop offset="110%"/><stop offset="-20%"></linearGradient></defs>
<g transform="translate(foo) rotate()">
<path d="M0,0 L bad Z" fill="url(#g)" stroke-width="NaN"/>
<circle cx="&notanentity;" cy="1&copy" r="-" />
<foreignObject><div xmlns="http://www.w3.org/1999/xhtml"><p>html in svg <b>broken</div></foreignObject>
<text x="1" y="2"><tspan font-size="999999999999">label</text>
</g>
</svg>
<math xmlns="http://www.w3.org/1998/Math/MathML" display="sideways">
<mrow><mi>x</mi><mo>&InvisibleTimes;</mo><msup><mn>2</mn><mn>bad</msup></mrow>
<annotation encoding="application/xhtml+xml"><p>annotation <em>text</annotation>
<semantics><mfrac><mi>a</mi><mo>/</mo><mi>b</mi></mfrac><annotation-xml encoding="text/html"><div>fallback</annotation-xml></semantics>
</math>
<svg><a href="javascript:alert(1)" xlink:href="#x"><title>link</title><rect/></a></svg>
</body>
</html>