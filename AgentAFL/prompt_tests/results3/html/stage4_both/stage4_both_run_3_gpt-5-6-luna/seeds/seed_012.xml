<!DOCTYPE html>
<html>
<head>
  <title>foreign content</title>
  <style>body { color: red; } &lt;broken {}</style>
  <script type="application/x-not-real">
    if (a < b && c > d) { document.write("<p>raw</p>"); }
  </script>
</head>
<body>
<svg width="20" height="20" viewBox="0 0 20 20" preserveAspectRatio="xMidYMid meet">
  <title>icon</title>
  <g fill="none" stroke-width="bad">
    <path d="M0 0 L10 10 Z" unknown="v"/>
    <foreignObject requiredExtensions="x">
      <div xmlns="http://www.w3.org/1999/xhtml"><p>HTML in SVG</div>
    </foreignObject>
  </g>
  <circle cx="nan" cy="Infinity" r="-2"></circle>
</svg>
<math display="block">
  <mi>x</mi><mo>&lt;</mo><mrow><mn>2</mn><mo>+</mo><mtext>text</mtext></mrow>
</math>
<p>after <svg><text>unclosed <b>foreign</svg> normal</p>
</body>
</html>