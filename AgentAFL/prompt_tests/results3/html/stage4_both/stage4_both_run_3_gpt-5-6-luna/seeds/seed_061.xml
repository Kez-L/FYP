<head><title>foreign content transitions</title></head>
<body>
<svg width="1e309" height="-0" viewBox="0 0 10 10">
  <title><b>svg title</b></title>
  <g transform="translate(1,2) rotate(NaN)">
    <rect x="1px" y="Infinity" width="1e999" height="-" fill="url(#missing)"></rect>
    <foreignObject><div xmlns="http://www.w3.org/1999/xhtml"><p>html in svg</p><svg><circle r="none"/></svg></div></foreignObject>
    <text><![CDATA[raw <tag> & text]]></text>
  </g>
</svg>
<math display="sideways">
  <mi mathvariant="unknown">&InvisibleTimes;</mi>
  <mo>&#x110000;</mo>
  <mrow><msup><mi>x</mi><mn>2</mn></msup><annotation-xml encoding="application/xhtml+xml"><div>annotation</div></annotation-xml></mrow>
</math>
<svg><style>&lt;g&gt;{fill:red}</style><script><![CDATA[if (a < b) { c++; }]]></script></svg>
