<!DOCTYPE html>
<html>
<head><title>interactive nesting and ruby</title></head>
<body>
  <details open="no" name="group">
    <summary><label for="q">Question <b>one</summary>
    <p>Hidden text
    <details open><summary>Nested summary <summary>second</summary>
      <dialog open="maybe" aria-modal="perhaps">
        <form method="dialogue">
          <fieldset disabled="false">
            <legend><input id=q autofocus="no">Legend
            <label><select multiple size="-1"><option selected>alpha<option>beta</select>
          </fieldset>
        </form>
      </dialog>
    </details>
  </details>
  <menu type="toolbar">
    <li><button type="submit" popovertarget="p" formaction="javascript:bad">A</button>
    <li><button type="button" disabled="false">B
    <li><a href="x"><button>C</a></button>
  </menu>
  <div id=p popover="manual">
    <ruby>漢<rt>kan<rp>(</rp><rtc>annotation</rtc><rp>)</rp>字<rt>ji</ruby>
    <dl compact="true"><dt>term<dd>definition<dt><dd>empty
  </div>
  <template shadowrootmode="open"><div>template <span>unterminated</template>
  <slot name="&bad;">fallback</slot>
</body>
</html>