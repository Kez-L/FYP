<!DOCTYPE html>
<html>
<head><title>obsolete controls</title></head>
<body>
  <form method=dialog enctype="multipart/form-data" accept-charset="x y">
    <fieldset disabled="false">
      <legend><label for=nope>Credentials</legend>
      <label>User <input name=user type=text value="a&quot;b" maxlength=-7></label>
      <label>Password <input name=pass type=password readonly=false></label>
      <textarea name=note rows=NaN cols=0>line one
line two <b>not markup?</textarea>
      <select name=pick>
        <option value=a>Alpha
        <option value=b selected=maybe>Beta
        <option>Gamma
      </select>
      <select name=empty multiple>
        <optgroup disabled label="broken><option>x
      </select>
      <button type=reset name=x value="&copy">Reset</button>
      <input type=image src alt>
    </fieldset>
  </form>
  <form><input type=file multiple accept="*/bad,image/png"><output for="user pass">result</output></form>
</body>
</html>