<!doctype html>
<html>
<head>
<title>form controls and labels</title>
</head>
<body>
<form id="f" method="WHAT" enctype="multipart/x-custom" accept-charset="," target="*" novalidate="perhaps">
<fieldset disabled="no">
<legend><label for="missing">account</legend>
<label><input type="text" name="user" maxlength="-1" size="999999999999" required="false"></label>
<input type="email" list="d" value="a@@b" formaction="::::" formmethod="SIDEWAYS">
<input type="date" min="tomorrow" max="yesterday" step="NaN">
<input type="number" min="foo" max="-Infinity" step="0">
<select name="x" multiple="false" size="-20">
<option selected="no" value="&bad">one
<optgroup label="group"><option>two</optgroup>
</select>
<datalist id="d"><option value="a"><option value="b"></datalist>
<textarea rows="-1" cols="NaN" wrap="diagonal">&lt;/textarea&gt;
</textarea>
<button type="maybe" name="b" value="x"><em>submit</em></button>
<input type="image" src="" width="-" height="auto" alt="&copy">
</fieldset>
</form>
<label for="user">orphan label</label>
<input form="f" type="checkbox" checked="false">
</body>
</html>