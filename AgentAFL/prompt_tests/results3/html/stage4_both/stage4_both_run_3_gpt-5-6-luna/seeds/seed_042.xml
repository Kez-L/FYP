<!DOCTYPE html>
<html>
<head>
<title>forms and controls</title>
</head>
<body>
<form id=f action="/submit" method=UNKNOWN enctype="multipart/form-data" accept-charset="x,,utf-99">
<fieldset disabled="maybe"><legend>credentials
<label for=missing>User <input name=user type=text value="&quot; onfocus=alert(1)"></label>
<label>Password <input type=password name=pass></fieldset>
<fieldset><legend>options</legend>
<input type=checkbox checked=false required=wat>
<input type=radio name=r value=one checked>
<input type=radio name=r value=two checked=checked>
<select name=s multiple=0 size=not-a-number>
<option selected=maybe value>first
<option value=two>second
<optgroup label="group"><option>third</optgroup>
</select>
<textarea rows=-1 cols=999999999999999999 wrap=diagonal>one
two</textarea>
<button type=submit formaction="::::">Send</button>
<input type=image src="" width=-4 height=NaN>
</fieldset>
</form>
<form><input list=choices><datalist id=choices><option value=a><option value=b></datalist></form>
