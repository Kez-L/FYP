<!DOCTYPE html>
<html>
<head>
<title>frames and embedded fallbacks</title>
</head>
<frameset rows="0,*,-1" cols="*,bad">
<frame src="a" name="one" frameborder="-1" scrolling="maybe" marginwidth="NaN">
<frame src="" name="one" noresize="false">
<noframes>
<body>
<h1>fallback</h1>
<iframe src="about:blank" srcdoc="&lt;!doctype html&gt;&lt;html&gt;&lt;body&gt;inside" width="-" height="999999999999999999999">
fallback iframe
</iframe>
<embed src="missing" type="application/x-shockwave-flash" width="auto" height="-">
<object classid="clsid:" codebase="::::" archive="a b c" usemap="#u">
<param name="quality" value="high">
<param name="movie">
text fallback <img src="x" alt="&ampcopy; &unknown;">
</object>
<map name=u><area href="x" shape="circle" coords="1,2" alt="one"><area></map>
</body>
</noframes>
</frameset>
<iframe name=after-frame><p>unexpected after frameset</p></iframe>
</html>