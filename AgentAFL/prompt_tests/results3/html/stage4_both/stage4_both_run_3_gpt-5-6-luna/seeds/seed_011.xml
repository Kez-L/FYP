<!doctype html>
<html>
<head><title>lists and maps</title></head>
<body>
<ol start="09" reversed type="i">
  <li value="x">first
    <ol>
      <li>nested <dl><dt>term <dd>definition <dt><dd></dl>
      <li>second
  <li>third
</ol>
<menu>
  <li><button type="reset">Reset</button>
  <li><select multiple size="-2">
    <optgroup label="A" disabled>
      <option selected value=one>One
      <option>Two
    </optgroup>
    <option label="outside" value="&copy">Three
  </select>
</menu>
<map name="m">
  <area shape="rect" coords="0,0,foo,20" href="#bad" alt="x">
  <area shape=poly coords="1,2,3,4,5" nohref>
</map>
<img usemap="#m" srcset="x 0w, y -1x" sizes="calc(100% - 1px)" alt="">
<ol><li>open<ul><li>mixed</ol></ul>
</body>
</html>