<!doctype html>
<html>
<head><title>form controls and obsolete phrasing</title></head>
<body>
<form id=f1>
<fieldset disabled="0"><legend>Options <small>legend</fieldset>
<input type="text" name="a" required="" minlength="999999" maxlength="-2" size="bad" pattern="[">
<input type="date" min="tomorrow" max="yesterday" step="NaN" value="32/13/0000">
<input type="range" min="10" max="-10" step="0" value="999">
<input type="file" accept="image/*,,application/x-unknown" multiple="sometimes">
<button name=x value="&amp;" formaction=":::" formmethod="INVALID">click
<select name=s required>
<option value=one selected selected>One
<optgroup label="group"><option disabled="">Two<option>Three</optgroup>
</select>
<datalist id=d><option value="a">visible<option value="b">also</datalist>
<output for="a b missing" form="missing">out</output>
</form>
<form id=f2><input form=f1><textarea form=f2 wrap=diagonal>text</textarea>
<keygen name=k challenge="x">
<label for=missing>Label <meter min="x" max="-" low="2" high="1" optimum="NaN" value="100"></meter>
<progress max="-5" value="999">progress</progress>
</form>
<p><abbr title="&quot;>abbr <bdi dir=sideways>direction</bdi> <bdo dir="">override</bdo>
<time datetime="2024-02-30T25:61:61Z">time</time></p>
</body>
</html>