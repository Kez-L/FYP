<!DOCTYPE html>
<html>
<head><title>frameset and obsolete constructs</title></head>
<frameset rows="*,0,invalid,999999999999999999999999999999999999999999999999" cols="25%,*,bad">
<frame src="about:blank" name="a" scrolling="maybe" frameborder="-1" marginwidth="NaN">
<frame src="http://[broken" noresize="false">
<noframes><body>
<center><font size="999" color="#GGGGGG">fallback</font></center>
<dir compact="sometimes"><li>one<li>two</dir>
<isindex prompt="Search &amp; find" action="/search">
<marquee behavior="impossible" direction="sideways" loop="-999999999999999999999999999999">moving</marquee>
<blink>obsolete <u><s>nested</blink></s>
</body></noframes>
</frameset>
</html>