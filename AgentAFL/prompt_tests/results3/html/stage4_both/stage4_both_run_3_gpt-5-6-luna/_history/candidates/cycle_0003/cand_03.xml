<!doctype html>
<html>
<head><title>forms and templates</title></head>
<body>
<form id=f1 method=dialog enctype="bad/type" autocomplete=maybe>
  <fieldset disabled="false">
    <legend>Account <input name=legend></legend>
    <label>Username <input type=text name=user required minlength="-3" maxlength="999999999999"></label>
    <label>Password <input type=password name=p pattern="[a-" value="&quot;"></label>
    <input type=image src=x alt=go formaction="/submit">
  </fieldset>
  <output name=result for="a b">old</output>
  <textarea name=notes rows=nan cols=-1 wrap=unknown>&lt;textarea&gt;
  <select name=choice>
    <option value="">empty
    <option selected>selected
  </select>
  <button formaction target="_blank" formmethod=garbage>Send</button>
</form>
<template id=t><table><tr><td>template<td><template><p>nested</template></table></template>
<form action="#f1"><input name=outside><input type=file accept=",,," multiple=maybe></form>
</body>
</html>