<html>
<head>
<title>ruby and inline boundaries</title>
</head>
<body>
<p><a name="x" href="#y"><abbr title="a > b">abbreviation
<cite>citation <code>&lt;code&gt;</cite></a>
<ruby>漢<rt>かん<rp>(</rt>字<rt>じ</rp></ruby>
<ins datetime="not-a-date">inserted <del cite="x" datetime="9999-99-99">deleted</ins>
<sub><sup><u><b><i>deep text</u></sup></i></b>
<span style="color:expression(foo)" title="one&quot;two">span
<wbr><br><br class="a" class="b">
<img src="data:image/gif;base64,%%%%" alt="a & b" width="-" height="NaN" border="999">
<map name="m">
<area shape="poly" coords="1,2,three,4,999999999999999999999" href="" alt="">
<area shape="rect" coords="1" nohref>
</map>
<figure align="unknown">
<figcaption>caption</figcaption>
<picture>
<source media="(min-width: ???)" srcset="a 1x, b bad, c">
<img srcset="x 999999999x" sizes="auto" src="">
</picture>
</figure>
<details open="false"><summary>summary</summary><div>hidden?</div></details>
<time datetime="yesterday">now</time>
<progress max="-1" value="NaN">progress fallback</progress>
<meter min="10" max="2" low="x" high="y" optimum="z" value="100">meter</meter>
</body>
</html>