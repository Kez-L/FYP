<!doctype html>
<html>
<head>
<title>interactive nesting</title>
</head>
<body>
<details name="group" open="0">
<summary><a href="#x"><button type="button">summary control</button></a></summary>
<details open><summary>nested summary</summary><p>nested body</details>
</details>
<dialog open="0" closedby="invalid">
<form method="dialog" action="http://[bad">
<fieldset><legend><legend>duplicate legend</legend>
<input type="file" accept="image/*,,bad" multiple="false" capture="maybe">
<input type="date" min="not-a-date" max="9999-99-99" step="NaN" value="2024-13-40">
<input type="range" min="10" max="-10" step="0" value="999999999999">
<output name=o for="one two missing">output</output>
</fieldset>
<fieldset><legend>second</legend>
<select required="false" size="-1">
<option disabled selected value="">empty
<option label="a" value="b">visible
<optgroup disabled="no" label="group"><option>inside
</select>
<button type="reset" popovertarget="missing" popovertargetaction="strange">reset</button>
</form>
</dialog>
<div popover="manual" id=p>
<template shadowrootmode="invalid" shadowrootdelegatesfocus="maybe"><style>:host( {}</style><slot></slot>
</template>
<slot name=missing>fallback</slot>
</div>
<custom-element><template><div><span></template>after</custom-element>
</body>
</html>