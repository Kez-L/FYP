<!doctype html>
<html>
<head><title>misnested interactive controls</title></head>
<body>
<form action="http://[broken" target="_blank" novalidate="maybe">
<fieldset><legend><button type="submit"><strong>legend button</legend></strong>
<label><select name=x><option>one<option><option>three</select><input type=text name=a>
<button disabled="false" type="menu"><a href="#"><span>button link</button></span></a>
