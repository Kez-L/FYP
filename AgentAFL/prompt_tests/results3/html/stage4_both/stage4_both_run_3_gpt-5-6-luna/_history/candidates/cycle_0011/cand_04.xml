<progress value="999999999999" max="-1">progress</progress>
<meter min="bad" max="bad" low="-1" high="999999999999" optimum="x" value="wat">meter</meter>
</fieldset>
</form>
<menu><button type=button menu="x">menu button</button><a href="javascript:">menu link</a></menu>
<details><summary><input type=checkbox checked="no">toggle</summary><form><input type=file accept=",,bad" multiple="false"></form></details>
