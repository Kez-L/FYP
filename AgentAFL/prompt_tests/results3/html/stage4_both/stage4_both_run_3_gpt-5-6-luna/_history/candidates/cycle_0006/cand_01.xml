<!DOCTYPE html>
<html>
<head>
<title>namespace and foreign content</title>
</head>
<body>
<svg width="bad" height="-1" viewBox="0 0 999999999999999999 0">
<defs><linearGradient id="g" x1="NaN" y1="-2" x2="foo" y2="100%">
<stop offset="120%" stop-color="#GGGGGG"/>
</linearGradient></defs>
<g transform="translate(foo, -999999999)">
<path d="M0 0 Lbad Z Q 1 2" fill="url(#missing)" onclick="x<y && y>z">
<text x="1,2" y="">A &amp B</text>
<foreignObject width="auto" height="0">
<div xmlns="http://www.w3.org/1999/xhtml"><p>foreign <b>content</foreignObject>
</g>
</svg>
<math display="sideways" xmlns="http://www.w3.org/1998/Math/MathML">
<mrow><mi>x</mi><mo>&lt;</mo><msup><mn>2</mn><mn>n</mn></msup>
<annotation-xml encoding="application/xhtml+xml"><p>math fallback</p></annotation-xml>
</mrow></math>
<p><svg><title>nested title</title><a href="x"><circle r="--"/></a></svg>after</p>
</body>
</html>