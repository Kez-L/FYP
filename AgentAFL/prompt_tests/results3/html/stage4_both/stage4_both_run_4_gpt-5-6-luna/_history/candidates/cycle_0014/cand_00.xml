<!doctype html>
<html lang="en">
<head>
  <base href="https://example.invalid/root/">
  <title>Forms and interactive controls</title>
</head>
<body>
  <header id=top><h1>Account settings</h1></header>
  <main>
    <form action="/submit" method="post" enctype="multipart/form-data">
      <fieldset disabled>
        <legend>Identity <em>details</em></legend>
        <label for=user>Name</label>
        <input id=user name=user value="A&B" required>
        <label>Email <input type=email name=email multiple></label>
        <output name=result for=user email>pending</output>
      </fieldset>
      <fieldset>
        <legend>Preferences</legend>
        <select name=mode required>
          <option value="">Choose one
          <option value=a selected>Alpha
          <optgroup label=Other>
            <option value=b>Beta</option>
            <option value=c disabled>Gamma
          </optgroup>
        </select>
        <label><input type=checkbox checked name=alerts> Alerts</label>
        <label><input type=radio name=level value=low>Low</label>
        <label><input type=radio name=level value=high checked>High</label>
        <input type=number min=0 max=10 step=any value=3.14>
        <input type=date value=2026-13-40>
        <textarea name=notes rows=2 cols=4>line one
line two</textarea>
        <button type=submit formaction="/alternate">Send</button>
        <button type=reset>Reset</button>
      </fieldset>
    </form>
    <details open><summary>Advanced</summary><p>Hidden-ish <mark>configuration</mark></p></details>
    <dialog open>Dialog content <button autofocus>OK</button></dialog>
  </main>
  <footer><a href="#top">back</a></footer>
</body>
</html>