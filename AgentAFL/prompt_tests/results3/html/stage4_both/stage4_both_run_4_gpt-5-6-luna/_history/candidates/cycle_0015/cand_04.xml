<!DOCTYPE html>
<html>
<head>
  <title>Document mode transitions</title>
</head>
<frameset cols="25%,*,0" border=0>
  <frame src="left.html" name=left>
  <frame src="right.html" name=right noresize>
  <noframes>
    <body>
      <h1>No frames</h1>
      <p>Fallback content <basefont size=7 color=red>legacy</basefont>
      <center><font face="serif" size="+2">old formatting</font></center>
      <dir><li>directory item<li>another</dir>
      <menu compact><li>menu item<li>second</menu>
      <table><caption>fallback<table><tr><td>inner</td></tr></table></caption></table>
    </body>
  </noframes>
</frameset>
<body>
  <p>stray body after frameset</p>
  <form action=/ method=POST>
    <fieldset><legend>Data</legend>
      <input name=a>
      <input name=b>
    </fieldset>
  </form>
</body>
</html>