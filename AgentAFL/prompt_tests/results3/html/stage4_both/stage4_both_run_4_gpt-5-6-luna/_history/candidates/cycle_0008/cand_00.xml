<!doctype html>
<html>
<head>
<meta charset="utf-8">
<title>Forms and obsolete controls</title>
</head>
<body>
<form action="/submit" method="post" enctype="multipart/form-data">
<fieldset disabled>
<legend>Account <span>details</legend>
<label for=user>Name:
<input id=user name=user type=text required value="A&B">
</label>
<label>Password <input name=pass type=password minlength=3></label>
</fieldset>
<fieldset>
<legend>Preferences</legend>
<label><input type=radio name=theme value=light checked>Light</label>
<label><input type=radio name=theme value=dark>Dark</label>
<label><input type=checkbox name=mail>Send mail</label>
<select name=country>
<option value="">Choose
<optgroup label=Europe>
<option value=de>Germany
<option value=fr>France
</optgroup>
<optgroup label=Other><option value=x>Unknown</optgroup>
</select>
<textarea name=notes rows=2 cols=12>first
second &amp; third</textarea>
<button type=submit>Save <b>now</button>
<input type=image src="submit.png" alt=Go>
</fieldset>
</form>
<isindex prompt="Search:">
<menu compact>
<li><input type=button value=One>
<li><button disabled>Two</button>
</menu>
</body>
</html>