<!doctype html>
<html>
<head>
<title>Lists and definitions</title>
</head>
<body>
<ol start="03" reversed type="A">
<li>first<ul><li>nested one<li>nested two<ol><li>deep</ol></ul>
<li value="7">second
</ol>
<menu compact>
<li><button type=button onclick="x('>')">Action</button>
<li><input type=text value="a b" maxlength=abc>
</menu>
<dl>
<dt><abbr title="Hyper Text">HTML</abbr>
<dd><p>definition <sup>1</sup>
<dt><dfn>term <var>x</var></dfn>
<dd><pre><code>if (a < b) {
  return &amp; c;
}</code></pre>
</dl>
<p><bdo dir=ltr>abc <bdi>xyz</bdi> def</bdo>
</body>
</html>