<!DOCTYPE html>
<html>
<head>
  <title>Form controls</title>
</head>
<body>
  <form id=f action="/submit" method="post" enctype="multipart/form-data">
    <fieldset disabled>
      <legend>Account <em>details</legend>
      <label for=user>User:</label>
      <input id=user name=user type=text required value="&quot;quoted&quot;">
      <label>Password <input name=p type=password minlength=3 maxlength=2></label>
      <input type=checkbox checked checked=false name=agree>
      <input type=radio name=role value=a>
      <input type=radio name=role value=b checked>
      <textarea name=notes rows=2 cols=4>one
two</textarea>
      <select name=choice multiple size=0>
        <option selected>first
        <option value=2>second</option>
        <optgroup label=Group disabled>
          <option>third
        </optgroup>
      </select>
      <button type=submit formaction="/other">Send</button>
