<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<title>Form controls &amp; namespaces</title>
</head>
<body>
<form action="/submit" method="post" enctype="multipart/form-data">
<fieldset disabled>
<legend>Account <span>details</span></legend>
<label for=user>User name</label>
<input id=user name=user required autofocus>
<label>Password <input type=password name=pw pattern="[A-Z]+"></label>
<input type=file name=upload accept="image/*,.txt" multiple>
<input type=hidden name=token value="a&amp;b">
</fieldset>
<fieldset>
<legend>Preferences</legend>
<input type=radio name=color value=red checked>Red
<input type=radio name=color value=blue>Blue
<input type=checkbox name=notify>Notify
<select name=country>
<option value="">Choose</option>
<option value=fr selected>France</option>
</select>
<textarea name=notes placeholder="write here"></textarea>
<button type=submit>Send</button>
<button type=reset>Clear</button>
</fieldset>
</form>
<output name=result for=user>pending</output>
<progress value=2 max=5>40%</progress>
<meter min=0 max=100 low=20 high=80 optimum=50 value=91>91</meter>
</body>
</html>