<html>
<head>
<title>Embedded data and objects</title>
</head>
<body>
<object classid="clsid:deadbeef" data="thing.bin" type="application/octet-stream" width=2 height=3>
<param name=movie value="clip.swf">
<param name=autoplay value=true>
<object data="fallback.dat">
fallback <a href="/download">download</a>
</object>
</object>
<embed src="plugin.bin" type="application/x-test" hidden=false>
<iframe srcdoc="<p>inner &amp; <b>document</b>" name=frame sandbox="allow-scripts allow-forms">
fallback frame text
</iframe>
<noembed><p>no plugin</p></noembed>
<picture>
<source media="(min-width: 1px)" srcset="a.png 1x, b.png 2x">
<source src="wrong" type="image/webp">
<img src="fallback.png" alt="picture">
</picture>
<canvas width=40 height=20>Canvas fallback <strong>text</strong></canvas>
<template id=t><p>template <span>content</span></p></template>
<script type="text/plain">
if (a < b) { document.write("<p>x</p>"); }
</script>
</body>
</html>