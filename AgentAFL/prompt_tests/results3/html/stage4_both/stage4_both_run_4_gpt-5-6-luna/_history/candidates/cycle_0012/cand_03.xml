<html>
<head>
<title>Comments entities and declarations</title>
<!-- ordinary comment --><!-- nested-looking <!-- comment -->
<![if IE]><div>conditional text</div><![endif]>
<!DOCTYPE weird [
<!ELEMENT weird O O ANY>
<!ENTITY demo "replacement">
]>
<meta name="x" content='one "two" three'>
</head>
<body>
<div data-a=one data-b='two words' data-c="three &quot;quoted&quot;">
<p>Unknown &bogus; &amp &copy &#0; &#1; &#x0; &#x110000; &NewLine;</p>
