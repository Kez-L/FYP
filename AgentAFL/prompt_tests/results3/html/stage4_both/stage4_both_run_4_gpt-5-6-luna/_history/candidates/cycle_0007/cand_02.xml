<!doctype html>
<html>
<head><title>Foreign content boundary</title></head>
<body>
<svg viewBox="0 0 120 80" width="120" height="80" xmlns="http://www.w3.org/2000/svg">
  <title>Vector</title>
  <desc>mixed namespace content</desc>
  <g transform="translate(4,4)">
    <rect x="0" y="0" width="40" height="20" fill="red"/>
    <circle cx="70" cy="20" r="12" stroke="blue" fill="none"></circle>
    <text x="2" y="55">A &amp; B</text>
    <foreignObject x="5" y="58" width="100" height="20">
      <div xmlns="http://www.w3.org/1999/xhtml"><em>HTML in SVG</em></div>
    </foreignObject>
  </g>
</svg>
<math xmlns="http://www.w3.org/1998/Math/MathML" display="block">
  <mi>x</mi><mo>=</mo><mfrac><mi>a</mi><mrow><mi>b</mi><mo>+</mo><mn>1</mn></mrow></mfrac>
  <annotation encoding="application/x-tex">x=(a)/(b+1)</annotation>
</math>
<p>After foreign content</p>
</body>
</html>