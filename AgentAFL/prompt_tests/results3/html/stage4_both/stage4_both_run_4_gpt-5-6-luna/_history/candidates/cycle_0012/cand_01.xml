<!DOCTYPE html>
<html>
<head>
<title>Embedded resources</title>
</head>
<body>
<object data="movie.bin" type="application/octet-stream" width=320 height=200>
<param name=autoplay value=true>
<param name="quality" value="high">
<object class=backup data=backup.dat>
<a href="download.dat">Download</a>
</object>
</object>
<embed src="plugin.dat" hidden=false width="0" height=0>
<iframe srcdoc="<p>inner &amp; text</p>" name=panel sandbox="allow-scripts allow-forms" width=400>
fallback frame text
</iframe>
<picture>
<source srcset="small.webp 1x, large.webp 2x" type=image/webp media="(min-width: 2px)">
<source src="fallback.jpg">
<img src="image.jpg" alt="&quot;picture&quot;" width=640 height=480 loading=lazy>
</picture>
<video controls autoplay poster=poster.png>
<source src=movie.mp4 type=video/mp4>
<source src=movie.ogv type=video/ogg>
<track kind=subtitles srclang=en label=English src=sub.vtt default>
no video
</video>
<audio loop><source src=sound.wav type=audio/wav></audio>
<map name=hotspots><area shape=rect coords="0,0,10,10" href=a.html alt=A><area shape=circle coords="20,20,5" href=b.html></map>
<img src=map.png usemap="#hotspots">
</body>
</html>