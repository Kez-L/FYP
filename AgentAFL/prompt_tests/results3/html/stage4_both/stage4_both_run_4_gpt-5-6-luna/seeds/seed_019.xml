<!doctype html>
<html>
<head>
<title>Interactive media</title>
</head>
<body>
<details open>
<summary>Media collection</summary>
<video controls autoplay muted width="320" poster="poster.jpg">
<source src="movie.webm" type="video/webm">
<source src="movie.mp4" type="video/mp4">
<track kind=subtitles srclang=en label=English src="sub.vtt" default>
fallback video
</video>
<audio controls loop preload=metadata>
<source src="sound.ogg" type=audio/ogg">
</audio>
<map name=worldmap>
<area shape=rect coords="0,0,40,40" href="/a" alt=A>
<area shape=circle coords="70,20,15" href="/b" alt=B>
</map>
<img src="world.png" usemap="#worldmap" ismap alt="map">
</details>
<dialog open><form method=dialog><p>Confirm?</p><button value=yes>Yes</button><button value=no>No</button></form></dialog>
<canvas id=paint width=40 height=20>Canvas fallback</canvas>
</body>
</html>