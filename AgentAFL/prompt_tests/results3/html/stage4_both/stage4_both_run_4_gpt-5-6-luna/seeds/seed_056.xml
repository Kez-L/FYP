<!doctype html>
<html>
<head>
<title>Form controls and obsolete elements</title>
<meta charset="windows-1252">
<base href="//example.invalid/root/">
<link rel="stylesheet" href=main.css media=screen>
<script type="text/javascript">
if (a < b && c > d) { document.write("<p>generated</p>"); }
</script>
</head>
<body>
<center><font face="serif" size=+2 color="#00ff00">Legacy heading</font></center>
<form action="/submit?x=1&amp;y=2" method=post enctype="multipart/form-data">
<fieldset disabled>
<legend>Account &copy; 2026</legend>
<label for=user>Name:</label>
<input id=user name=user value="a&amp;b" required>
<label>Password <input type=password name=pw></label>
<input type=checkbox checked="checked" name=remember>
<input type=radio name=mode value=one>
<input type=radio name=mode value=two checked>
<select name=choice multiple size=3>
<option value=1>First
<option selected value='2'>Second
<optgroup label=Other><option value=3>Third</optgroup>
</select>
<textarea name=notes rows=2 cols=8>line one
line &lt;two&gt;</textarea>
<button type=submit formaction=/go>Send</button>
<input type=image src=button.gif alt=go>
</fieldset>
</form>
<marquee direction=left behavior=alternate>moving text</marquee>
<blink>old content</blink>
<isindex prompt="Search:">
</body>
</html>