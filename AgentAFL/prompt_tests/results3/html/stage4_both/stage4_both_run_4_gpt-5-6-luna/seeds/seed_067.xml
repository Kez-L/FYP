<!DOCTYPE html>
<html>
<head><title>Lists and phrasing boundaries</title></head>
<body>
<nav aria-label=sections>
  <ol start=0 reversed>
    <li value=9>First <ul><li>nested one<li>nested two</ul>
    <li>Second <ol type=A><li>alpha<li>beta</ol>
    <li>Third
  </ol>
</nav>
<section>
  <hgroup><h1>Heading <small>small</small></h1><h2>Subheading</h2></hgroup>
  <p>Text <b>bold <i>italic <u>underlined</b> after</i></u>
  <p><ruby>漢<rt>kan</rt><rp>(</rp>字<rt>ji</rt><rp>)</rp></ruby>
     <q cite=x>quoted <cite>source</cite></q>
     <abbr title="HyperText Markup Language">HTML</abbr>
     <kbd>Ctrl</kbd>+<kbd>C</kbd>
  <pre><code>if (x &lt; y) {
  return &amp;&amp; z;
}</code></pre>
  <blockquote cite="urn:test"><p>Nested <span title="a>b">words</span></blockquote>
  <hr>
  <p><ins datetime=bad>added</ins><del cite=x>removed</del>
  <address><a href="mailto:x@y">contact</a><br>Unknown &copy entity &bogus;</address>
</section>
<aside>
  <menu>
    <li><button type=button>One</button>
    <li><button type=button>Two
  </menu>
</aside>
</body>
</html>