<!doctype HTML PUBLIC "-//W3C//DTD HTML 4.01 Transitional//EN" "http://www.w3.org/TR/html4/loose.dtd">
<html>
<head><title>Form controls</title></head>
<body>
<form action="/submit?a=1&amp;b=2" method="POST" enctype="multipart/form-data" accept-charset="utf-8" target="_blank">
<fieldset disabled="false"><legend>Account &amp; preferences</legend>
<label for=user>Name:</label><input id=user name=user value="&quot;quoted&quot;" required autofocus>
<label>Email<input type=email name=email multiple></label>
<input type="text" name="dupe" name="second" maxlength="-1" size=0>
<input type=number min=10 max=2 step=0 value=nan>
<input type=range min=100 max=0 value=50>
<input type=date value=2020-99-99><input type=time value=25:61>
<input type=color value=#12><input type=file accept="image/*,.txt" multiple>
<input type=checkbox checked="no" indeterminate><input type=radio checked>
<select name=choice multiple size=-3>
<option value=a selected>Alpha
<option value=b disabled>Beta<option>Gamma</option>
<optgroup label="Group one"><option value=1>One<option value=2>Two</optgroup>
</select>
<input list=names name=person>
<datalist id=names><option value=Alice label="A"><option value=Bob>Bob</datalist>
<textarea name=message rows=0 cols=-1 wrap=hard>&lt;textarea&gt;
second line</textarea>
<button type=submit formaction="/other" disabled=false>Send <b>now</button>
<button type=reset><i>Reset</i></button>
<output name=result for="user choice">old result</output>
<progress value=12 max=5>12%</progress>
<meter min=10 low=20 optimum=30 high=40 max=50 value=60>bad</meter>
</fieldset>
</form>
<form><input name=x><form><input name=y></form></form>
</body>
</html>