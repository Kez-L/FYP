  <mrow><mi>x</mi><mo>&InvisibleTimes;</mo><mfrac><mn>1</mn><mn>0</mn></mfrac></mrow>
</math>
<div xmlns:foo="urn:test" foo:item="value" style="color: red; unknown: {">
  <span title="a&#13;&#10;b" onclick="if (x < 2) alert('&quot;')">text</span>
</div>
<template><p>template content<table><tr><td>x</template>
<dialog open>dialogue <button type=button>close</button>
