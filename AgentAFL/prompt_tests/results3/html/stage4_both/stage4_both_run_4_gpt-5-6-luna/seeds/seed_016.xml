<!doctype html>
<html>
<head>
<title>Embedded vector data</title>
</head>
<body>
<svg width="120" height="80" viewBox="0 0 120 80" xmlns="http://www.w3.org/2000/svg">
<defs><linearGradient id=g><stop offset="0%" stop-color="red"/><stop offset="100%" stop-color="blue"/></linearGradient></defs>
<rect x="1" y="2" width="50" height="30" fill="url(#g)" stroke-width="3"/>
<circle cx="80" cy="20" r="12"/>
<path d="M0 60 C20 10 40 90 120 40" fill="none"/>
<text x="4" y="74">A &amp; B</text>
</svg>
<math xmlns="http://www.w3.org/1998/Math/MathML">
<mrow><mi>x</mi><mo>=</mo><mfrac><msup><mi>a</mi><mn>2</mn></msup><msqrt><mn>4</mn></msqrt></mfrac></mrow>
</math>
<figure>
<img src="diagram.svg" alt="A diagram" width="10" height="10">
<figcaption>Vector <code>figure</code></figcaption>
</figure>
</body>
</html>