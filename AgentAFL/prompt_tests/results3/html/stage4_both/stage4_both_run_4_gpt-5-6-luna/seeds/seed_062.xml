<!DOCTYPE html>
<html>
<head>
<title>Tables and captions</title>
</head>
<body>
<table border=1>
<caption>Quarterly inventory</caption>
<colgroup>
<col span=2 class=label>
<col class=amount>
</colgroup>
<thead>
<tr><th rowspan=2 scope=col>Item</th><th colspan=2>Count</th></tr>
<tr><th scope=col>In</th><th scope=col>Out</th></tr>
</thead>
<tbody>
<tr><th scope=row>Paper</th><td>12</td><td>4</td></tr>
<tr><th scope=row>Ink</th><td colspan=2>none</td></tr>
<tr><th scope=row>Boxes</th><td>7<td>2</tr>
</tbody>
<tfoot>
<tr><th>Total</th><td>19</td><td>6</td></tr>
</tfoot>
</table>
<table>
<tr><td>A<table><tr><td>nested</td></tr></table>B</td><td>C</td></tr>
</table>
<div role=region aria-label=Summary>
<dl>
<dt>In stock</dt><dd><data value=19>nineteen</data></dd>
<dt>Updated</dt><dd><time datetime="2026-10-08T12:34:56Z">today</time></dd>
</dl>
</div>
</body>
</html>