<!doctype html>
<html>
<head><title>Metadata and control flow</title></head>
<body>
<template id="card"><article><h2>Template title</h2><p>Template body</p></article></template>
<details open="false">
<summary>More information</summary>
<section hidden="hidden"><p>Initially hidden</p></section>
</details>
<menu type="toolbar">
<li><button type=button disabled="disabled">Cut</button>
<li><button type=submit formnovalidate>Send</button>
</menu>
<dialog open>Dialog text <form method=dialog><button value=close>Close</button></form></dialog>
<picture>
<source srcset="small.png 400w, medium.png 800w" sizes="50vw" type=image/png>
<source media="(min-width: 800px)" srcset="large.webp" type=image/webp>
<img src="fallback.gif" alt="fallback" ismap>
</picture>
<video controls autoplay muted width="320">
<source src="clip.webm" type="video/webm">
<track kind=subtitles srclang=en label=English src="captions.vtt" default>
no video
</video>
<map name=hotspots><area shape=rect coords="0,0,50,50" href="/a"><area nohref></map>
</body>
</html>