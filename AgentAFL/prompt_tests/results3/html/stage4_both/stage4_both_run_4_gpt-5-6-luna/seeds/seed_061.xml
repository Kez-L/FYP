<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Forms and interactive controls</title>
</head>
<body>
<header id=top>
<nav>
<ul>
<li><a href="#account">Account</a></li>
<li><a href="#prefs">Preferences</a></li>
</ul>
</nav>
</header>
<main>
<section id=account>
<h1>Registration</h1>
<form action="/register" method="post" enctype="multipart/form-data">
<fieldset>
<legend>Identity</legend>
<label for=user>Username</label>
<input id=user name=user type=text required minlength=2 maxlength=32 autocomplete=username>
<label for=mail>Email</label>
<input id=mail name=mail type=email multiple>
<label>Password <input name=pwd type=password pattern="[A-Za-z0-9]{8,}"></label>
<input type=hidden name=token value="a&b=c">
</fieldset>
<fieldset id=prefs disabled>
<legend>Options</legend>
<label><input type=checkbox name=updates checked> Send updates</label>
<label><input type=radio name=theme value=light> Light</label>
<label><input type=radio name=theme value=dark checked> Dark</label>
<select name=role size=3>
<option value=a>Author</option>
<option value=e selected>Editor</option>
<optgroup label=Other>
<option value=g>Guest</option>
<option value=x disabled>Unknown</option>
</optgroup>
</select>
<textarea name=notes rows=3 cols=20 placeholder="Write &lt;notes&gt;">old &amp; text</textarea>
</fieldset>
<label for=upload>Avatar</label>
<input id=upload type=file name=avatar accept="image/*" capture>
<output name=result for=user mail></output>
<button type=submit>Save</button>
<button type=reset>Clear</button>
</form>
</section>
<aside>
<details open><summary>Help</summary><p>Fields marked <em>required</em> must be filled.</p></details>
<dialog open><p>Welcome</p><form method=dialog><button>Close</button></form></dialog>
</aside>
</main>
<footer><small>© 2026</small></footer>
</body>
</html>