<!DOCTYPE HTML PUBLIC "-//W3C//DTD HTML 4.0//EN">
<html>
<head>
  <title>Embedded languages</title>
  <style>
    @media screen {
      .x { background: url("x"); }
      /* </style> */
    }
  </style>
</head>
<body>
<object classid="clsid:deadbeef" data="movie.swf" type="application/x-shockwave-flash">
  <param name="movie" value="movie.swf">
  <param name=quality value=high>
  <embed src=movie.swf width=320 height=200 pluginspage="about:blank">
  fallback
</object>
<iframe srcdoc="<p>inside &amp; <b>frame</b>" name=frame></iframe>
<script language="VBScript">
  If x < 10 Then
    document.write "<!--"
  End If
</script>
<noscript>
  <textarea name=raw><b>not markup</textarea>
  <xmp><i>literal</i></xmp>
</noscript>
<canvas width=0 height=-1><font color=red>fallback</font></canvas>
</body>
</html>