<!DOCTYPE html>
<html>
<head><title>Forms and interactive content</title></head>
<body>
<form action="/submit" method="post" enctype="multipart/form-data">
<fieldset disabled>
<legend>Account <strong>details</strong></legend>
<label>Username <input name=user required autofocus></label>
<label for=pass>Password</label>
<input id=pass type=password autocomplete=off>
</fieldset>
<fieldset>
<legend>Preferences</legend>
<input type=radio name=color value=red checked>
<input type=radio name=color value=blue>
<input type=file name=upload accept="image/*,.txt" multiple>
<input type=range min=10 max=1 step=0.1 value=5>
<output name=result for="a b">unknown</output>
<textarea name=notes wrap=hard readonly>note</textarea>
</fieldset>
<details open><summary>More</summary><p>extra information</p></details>
<dialog open>dialogue <button formmethod=get>OK</button></dialog>
<button type=submit>Send</button>
</form>
</body>
</html>