<!doctype html>
<html>
<head>
  <title>Namespaces and unknown elements</title>
  <meta charset=utf-16>
</head>
<body>
  <custom-card data-a=1>
    <custom-header><slot name=title>Fallback title</slot></custom-header>
    <custom-body>
      <template shadowrootmode=open><style>:host{display:block}</style><slot></slot></template>
      <p>light content</p>
    </custom-body>
  </custom-card>
  <x-thing><y-thing><z-thing>nested custom elements</x-thing></y-thing>
  <div xmlns="urn:example:one"><foo:bar xmlns:foo="urn:example:two">prefixed</foo:bar></div>
  <embed src="movie.bin" width=0 height=-1>
  <object><a href=#>object fallback</a><embed src=x></object>
  <p data-json='{"a":[1,2,],"b":null}' data-bad="x&amp;y&#0;">
    text <wbr><br/><input type=unknown>
  </p>
</body>
</html>