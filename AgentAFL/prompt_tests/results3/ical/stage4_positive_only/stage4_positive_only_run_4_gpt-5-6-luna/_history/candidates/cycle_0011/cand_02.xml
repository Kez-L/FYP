BEGIN:VCALENDAR
PRODID:-//SeedLab//Alarms//EN
VERSION:2.0
BEGIN:VEVENT
UID:alarm-chain@example.invalid
DTSTAMP:20261001T120000Z
DTSTART:20261015T120000Z
DTEND:20261015T130000Z
SUMMARY:Meeting with multiple alarms
BEGIN:VALARM
UID:alarm-display@example.invalid
ACTION:DISPLAY
TRIGGER;RELATED=START:-PT15M
DESCRIPTION:Meeting begins in fifteen minutes
END:VALARM
BEGIN:VALARM
UID:alarm-audio@example.invalid
ACTION:AUDIO
TRIGGER;RELATED=END;VALUE=DURATION:PT5M
ATTACH;FMTTYPE=audio/basic:https://example.invalid/chime.wav
END:VALARM
BEGIN:VALARM
UID:alarm-email@example.invalid
ACTION:EMAIL
TRIGGER:-P1D
SUMMARY:Reminder
DESCRIPTION:Tomorrow is the meeting.
ATTENDEE:mailto:alerts@example.invalid
ATTACH:https://example.invalid/agenda.txt
END:VALARM
END:VEVENT
END:VCALENDAR