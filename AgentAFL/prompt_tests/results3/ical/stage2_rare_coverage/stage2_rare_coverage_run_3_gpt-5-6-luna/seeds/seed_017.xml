BEGIN:VCALENDAR
VERSION:2.0
PRODID:-//Alarm Nesting Cases//EN
BEGIN:VEVENT
UID:event-with-alarms
DTSTAMP:20261001T030405Z
DTSTART;TZID=America/New_York:20261101T013000
DTEND;TZID=America/New_York:20261101T023000
SUMMARY:Repeated and absolute alarms
RRULE:FREQ=YEARLY;BYMONTH=11;BYDAY=1SU
BEGIN:VALARM
ACTION:DISPLAY
TRIGGER;RELATED=START:-PT15M
DESCRIPTION:before start
END:VALARM
BEGIN:VALARM
ACTION:AUDIO
TRIGGER;VALUE=DATE-TIME:20261031T235959Z
ATTACH;FMTTYPE=audio/basic:CID:alarm-audio-1
REPEAT:2
DURATION:PT30S
END:VALARM
BEGIN:VALARM
ACTION:EMAIL
TRIGGER;RELATED=END:-P1D
DESCRIPTION:daily notice
SUMMARY:Event reminder
ATTENDEE;CN=Ops:mailto:ops@example.invalid
ATTACH;VALUE=URI:https://example.invalid/reminder.ics
END:VALARM
END:VEVENT
BEGIN:VTODO
UID:todo-with-alarm
DTSTAMP:20261001T030405Z
SUMMARY:Task
DUE;TZID=Europe/Paris:20261002T170000
BEGIN:VALARM
ACTION:DISPLAY
TRIGGER:-P2W
DESCRIPTION:task warning
END:VALARM
END:VTODO
END:VCALENDAR