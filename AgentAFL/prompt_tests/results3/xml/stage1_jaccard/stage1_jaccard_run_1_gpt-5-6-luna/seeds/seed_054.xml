<?xml version="1.0"?>
<!DOCTYPE graph [
  <!ELEMENT graph (node*,edge*)>
  <!ELEMENT node EMPTY>
  <!ELEMENT edge EMPTY>
  <!ATTLIST graph mode (directed|undirected) "directed">
  <!ATTLIST node id ID #REQUIRED label CDATA #IMPLIED tags NMTOKENS #IMPLIED>
  <!ATTLIST edge from IDREF #REQUIRED to IDREF #REQUIRED weight NMTOKEN #IMPLIED>
]>
<graph mode="undirected">
  <node id="n0" label="root" tags="entry start"/>
  <node id="n1" label="left &lt; branch" tags="leaf"/>
  <node id="n2" label="right" tags="leaf terminal"/>
  <node id="n3" label="unconnected"/>
  <edge from="n0" to="n1" weight="01"/>
  <edge from="n1" to="n2"/>
  <edge from="n2" to="n0" weight="0x10"/>
</graph>