<!DOCTYPE envelope [
  <!ELEMENT envelope (meta, body)>
  <!ELEMENT meta (tag*)>
  <!ELEMENT tag (#PCDATA)>
  <!ELEMENT body (section*)>
  <!ELEMENT section (heading, paragraph*)>
  <!ATTLIST section xml:lang NMTOKEN #IMPLIED>
  <!ELEMENT heading (#PCDATA)>
  <!ELEMENT paragraph (#PCDATA|link)*>
  <!ELEMENT link (#PCDATA)>
  <!ATTLIST link href URI #REQUIRED>
]>
<envelope>
  <meta>
    <tag>one</tag>
    <!-- comment with -- forbidden? -->
    <tag><![CDATA[ two ]]></tag>
    <?meta-pi value?>
  </meta>
  <body>
    <section xml:lang="en-US">
      <heading>Introduction</heading>
      <paragraph>See <link href="urn:item:1">this node</link> for details.</paragraph>
      <paragraph><![CDATA[unescaped & symbols and <markup>]]></paragraph>
    </section>
    <section>
      <heading>Second</heading>
      <paragraph>tail</paragraph>
    </section>
  </body>
</envelope>