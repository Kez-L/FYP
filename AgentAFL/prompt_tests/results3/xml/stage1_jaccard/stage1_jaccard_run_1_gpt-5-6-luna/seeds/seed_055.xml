<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE archive [
  <!NOTATION png SYSTEM "image/png">
  <!ENTITY banner "A&amp;B &lt;archived&gt;">
  <!ENTITY payload SYSTEM "payload.bin" NDATA png>
  <!ELEMENT archive (entry+, footer?)>
  <!ELEMENT entry (#PCDATA|note|link)*>
  <!ELEMENT note (#PCDATA)>
  <!ELEMENT link EMPTY>
  <!ELEMENT footer (#PCDATA)>
  <!ATTLIST archive format (short|long) "long">
  <!ATTLIST entry key ID #REQUIRED ref IDREFS #IMPLIED blob ENTITY #IMPLIED>
  <!ATTLIST link href CDATA #REQUIRED>
]>
<archive format="short">
  <entry key="e1" ref="e2" blob="payload">before &banner;<note>nested</note><link href="urn:item:1"/></entry>
  <entry key="e2">after &banner;</entry>
  <footer>done</footer>
</archive>