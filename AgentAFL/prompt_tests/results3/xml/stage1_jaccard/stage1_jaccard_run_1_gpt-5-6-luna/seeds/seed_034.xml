<?xml version="1.0"?>
<!DOCTYPE dashboard [
  <!ELEMENT dashboard (title, grid)>
  <!ELEMENT title (#PCDATA|br)*>
  <!ELEMENT br EMPTY>
  <!ELEMENT grid (cell*)>
  <!ELEMENT cell (value?, note?)>
  <!ELEMENT value (#PCDATA)>
  <!ELEMENT note (#PCDATA)>
  <!ATTLIST cell row NMTOKEN #REQUIRED col NMTOKEN #REQUIRED state CDATA "new">
  <!ENTITY nbsp "&#160;">
  <!ENTITY twice "&#x25; &amp; &lt;">
]>
<?xml-stylesheet type="text/css" href="dash.css"?>
<dashboard xmlns:ui="urn:ui" ui:version="2">
  <title>Daily<br/>status &nbsp; &twice;</title>
  <grid>
    <cell row="1" col="1" state="ready">
      <value>42</value>
      <note xml:lang="en">steady</note>
    </cell>
    <cell row="1" col="2" state="stalled"/>
    <cell row="2" col="1">
      <value><![CDATA[
        line-one
        line-two
      ]]></value>
      <note><!-- deliberately empty --></note>
    </cell>
  </grid>
</dashboard>