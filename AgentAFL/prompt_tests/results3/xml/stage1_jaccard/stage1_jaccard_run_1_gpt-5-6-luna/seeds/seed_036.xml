<!DOCTYPE report [
  <!ELEMENT report ANY>
  <!ELEMENT section (#PCDATA|item|section)*>
  <!ELEMENT item EMPTY>
  <!ATTLIST item key ID #IMPLIED value CDATA "default">
  <!ENTITY plain "A&amp;B&lt;C">
  <!ENTITY quoted 'single "quoted" value'>
  <!NOTATION bin SYSTEM "application/octet-stream">
  <!ENTITY blob SYSTEM "payload.bin" NDATA bin>
]>
<report>
  &plain;
  <section name="outer">
    <item key="first" value="&quot;&apos;"/>
    <section name="inner">
      &quoted;
      <item key="second"/>
    </section>
  </section>
</report>