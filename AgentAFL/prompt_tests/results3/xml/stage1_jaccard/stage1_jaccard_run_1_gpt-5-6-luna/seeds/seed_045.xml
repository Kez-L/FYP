<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE catalog [
  <!ELEMENT catalog (item+, note?)>
  <!ELEMENT item (name, meta*, description)>
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT meta EMPTY>
  <!ELEMENT description (#PCDATA|em|br)*>
  <!ELEMENT em (#PCDATA|em|br)*>
  <!ELEMENT br EMPTY>
  <!ELEMENT note (#PCDATA)>
  <!ATTLIST catalog xmlns CDATA #IMPLIED
                    xmlns:x CDATA #IMPLIED>
  <!ATTLIST item sku CDATA #REQUIRED
                  x:featured (yes|no) "no">
  <!ATTLIST meta key CDATA #REQUIRED value CDATA #IMPLIED>
]>
<catalog xmlns="urn:example:catalog" xmlns:x="urn:example:extra">
  <item sku="A-17" x:featured="yes">
    <name>α &amp; β</name>
    <meta key="color" value="blue"/>
    <meta key="stock"/>
    <description>Text <em>with nested emphasis</em><br/>and a trailing fragment.</description>
  </item>
  <item sku="B-42">
    <name>Second item</name>
    <description><![CDATA[raw <markup> and ]]]]><![CDATA[> boundaries]]></description>
  </item>
  <note xml:lang="en">catalog footer</note>
</catalog>