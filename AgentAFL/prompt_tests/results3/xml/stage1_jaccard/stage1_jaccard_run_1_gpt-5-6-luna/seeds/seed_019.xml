<!DOCTYPE root [
  <!ENTITY % declarations '
    <!ELEMENT root (node)>
    <!ELEMENT node (#PCDATA|node)*>
    <!ATTLIST node level NMTOKEN #IMPLIED>
  '>
  %declarations;
  <!ENTITY left "[" >
  <!ENTITY right "]" >
]>
<root>
  <node level="0">
    before &left;
    <node level="1">inside &amp; text</node>
    after &right;
  </node>
</root>