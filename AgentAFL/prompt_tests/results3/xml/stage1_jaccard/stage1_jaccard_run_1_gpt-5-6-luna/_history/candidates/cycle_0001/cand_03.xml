<!DOCTYPE report [
  <!ELEMENT report (header, entries, footer)>
  <!ELEMENT header EMPTY>
  <!ATTLIST header generated CDATA #IMPLIED>
  <!ELEMENT entries (entry*)>
  <!ELEMENT entry (key, value, value?)>
  <!ELEMENT key (#PCDATA)>
  <!ELEMENT value (#PCDATA|part)*>
  <!ELEMENT part (#PCDATA)>
  <!ELEMENT footer (#PCDATA)>
  <!NOTATION bin SYSTEM "application/octet-stream">
  <!ENTITY payload SYSTEM "data.bin" NDATA bin>
]>
<report>
  <header generated="true"/>
  <entries>
    <entry><key>k&amp;1</key><value>plain<part>A</part><part>B</part></value></entry>
    <entry><key>broken</key><value>unterminated<part>piece</value></entry>
    <entry><key>external</key><value>&payload;</value></entry>
  </entries>
  <footer>done</footer>
</report>