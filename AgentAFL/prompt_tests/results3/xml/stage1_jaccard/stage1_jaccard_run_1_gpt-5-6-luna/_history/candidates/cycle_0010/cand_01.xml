<?xml version="1.0"?>
<!DOCTYPE archive [
  <!NOTATION gif SYSTEM "image/gif">
  <!NOTATION txt SYSTEM "text/plain">
  <!ENTITY logo SYSTEM "logo.gif" NDATA gif>
  <!ELEMENT archive (entry*)>
  <!ELEMENT entry (title, payload?)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT payload EMPTY>
  <!ATTLIST entry key ID #REQUIRED
                  link IDREFS #IMPLIED
                  kind (text|binary) "text">
  <!ATTLIST payload src ENTITY #IMPLIED
                    format NOTATION #IMPLIED>
]>
<archive>
  <entry key="first" kind="binary">
    <title>Graphic asset</title>
    <payload src="logo" format="gif"/>
  </entry>
  <entry key="second" link="first" kind="text">
    <title>Referenced record</title>
    <payload src="logo" format="gif"/>
  </entry>
</archive>