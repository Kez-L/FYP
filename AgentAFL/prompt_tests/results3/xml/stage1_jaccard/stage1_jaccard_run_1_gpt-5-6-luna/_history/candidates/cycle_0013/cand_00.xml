<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<!DOCTYPE archive SYSTEM "missing-external-subset.dtd" [
  <!NOTATION bin SYSTEM "application/octet-stream">
  <!ENTITY logo SYSTEM "logo.bin" NDATA bin>
  <!ENTITY local "alpha &amp; beta &#x1F600;">
  <!ELEMENT archive (entry+,tail?)>
  <!ELEMENT entry (title,body,ref*)>
  <!ATTLIST entry id ID #REQUIRED kind (text|binary|empty) "text">
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT body (#PCDATA|em|br)*>
  <!ELEMENT em (#PCDATA|br)*>
  <!ELEMENT br EMPTY>
  <!ELEMENT ref EMPTY>
  <!ATTLIST ref target IDREF #REQUIRED>
  <!ELEMENT tail EMPTY>
]>
<archive>
  <entry id="e1" kind="text">
    <title>&local;</title>
    <body>before <em>inside<br/></em> after<ref target="e1"/></body>
  </entry>
  <entry id="e2" kind="binary">
    <title>external entity follows</title>
    <body>&logo;</body>
  </entry>
  <tail/>
</archive>