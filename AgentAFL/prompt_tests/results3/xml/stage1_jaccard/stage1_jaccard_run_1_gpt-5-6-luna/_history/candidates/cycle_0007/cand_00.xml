<?xml version="1.0"?>
<!DOCTYPE catalog [
  <!ELEMENT catalog (entry+)>
  <!ELEMENT entry (title, price, details?)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT price (#PCDATA)>
  <!ELEMENT details (#PCDATA|emph|code)*>
  <!ELEMENT emph (#PCDATA)>
  <!ELEMENT code (#PCDATA)>
  <!ATTLIST entry id ID #REQUIRED region CDATA "unknown">
  <!ENTITY vendor "A &amp; B Supplies">
  <!ENTITY intro "catalogue item">
  <!ENTITY % extra "<!ATTLIST entry audited (yes|no) 'no'>">
  %extra;
]>
<catalog>
  <entry id="item-α" region="west" audited="yes">
    <title>&intro;: &vendor;</title>
    <price currency="EUR">19&#x2E;95</price>
    <details>Use <emph>carefully</emph>; see <code>item-α</code>.</details>
  </entry>
  <entry id="item-β">
    <title>Replacement &amp; repair</title>
    <price currency="JPY">2400</price>
  </entry>
</catalog>