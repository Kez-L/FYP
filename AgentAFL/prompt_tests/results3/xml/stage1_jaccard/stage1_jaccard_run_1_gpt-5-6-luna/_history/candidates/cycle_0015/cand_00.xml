<?xml version="1.0"?>
<!DOCTYPE catalog [
  <!ELEMENT catalog (item*)>
  <!ELEMENT item (name, description?, payload?)>
  <!ATTLIST item code ID #REQUIRED status (new|used|archived) "new">
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT description (#PCDATA|emph|break)*>
  <!ELEMENT emph (#PCDATA)>
  <!ELEMENT break EMPTY>
  <!ELEMENT payload EMPTY>
  <!ATTLIST payload source ENTITY #IMPLIED>
  <!NOTATION gif SYSTEM "image/gif">
  <!ENTITY thumbnail SYSTEM "thumbnail.gif" NDATA gif>
  <!ENTITY mark "&#x2026; catalog &amp; fragment">
]>
<catalog>
  <item code="x1" status="used">
    <name>alpha &mark;</name>
    <description>before <emph>inside</emph><break/>after</description>
    <payload source="thumbnail"/>
  </item>
  <item code="x2">
    <name><![CDATA[raw <name> ]]> content]]></name>
  </item>
</catalog>