<!DOCTYPE archive [
  <!ELEMENT archive (record*)>
  <!ELEMENT record (key, value, value?)>
  <!ELEMENT key (#PCDATA)>
  <!ELEMENT value (#PCDATA|emph|br)*>
  <!ELEMENT emph (#PCDATA)>
  <!ELEMENT br EMPTY>
  <!ATTLIST record status CDATA "new">
  <!ENTITY open "<emph>">
  <!ENTITY close "</emph>">
]>
<archive xml:lang="x-klingon" xml:base="urn:example:root">
  <record status="&quot;quoted&quot;">
    <key>alpha</key>
    <value>&open;bold&close;<br/>end</value>
    <value><![CDATA[x]]>&#x0A;&#10;&amp;</value>
  </record>
  <record>
    <key>beta</key>
    <value>one<!-- comment --><![CDATA[two]]><?note three?></value>
  </record>
</archive>