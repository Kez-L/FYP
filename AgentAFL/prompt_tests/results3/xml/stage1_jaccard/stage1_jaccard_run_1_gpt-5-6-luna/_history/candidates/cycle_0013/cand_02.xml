<!DOCTYPE galaxy [
  <!ELEMENT galaxy (cluster|void|cluster)+>
  <!ELEMENT cluster (star|planet|cluster)*>
  <!ELEMENT star EMPTY>
  <!ATTLIST star name NMTOKEN #REQUIRED mass CDATA #IMPLIED>
  <!ELEMENT planet (name,moon*)>
  <!ATTLIST planet xmlns CDATA #IMPLIED>
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT moon (#PCDATA)>
  <!ELEMENT void EMPTY>
]>
<g:galaxy xmlns:g="urn:outer" xmlns:a="urn:alpha" xmlns:b="urn:beta">
  <g:cluster a:level="0">
    <g:star name="Sirius" mass="2.02"/>
    <g:planet xmlns="" id="p1">
      <name>detached namespace</name>
      <moon a:code="m&amp;1">one</moon>
      <moon b:code="m2">two</moon>
    </g:planet>
    <g:cluster b:level="1">
      <g:star name="&#x41;&#x42;&#x43;"/>
    </g:cluster>
  </g:cluster>
  <g:void/>
  <g:cluster a:level="final"/>
</g:galaxy>