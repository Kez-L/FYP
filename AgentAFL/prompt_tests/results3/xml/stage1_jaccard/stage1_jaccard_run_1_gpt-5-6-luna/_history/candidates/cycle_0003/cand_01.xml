<?xml version="1.0"?>
<!DOCTYPE archive [
  <!ELEMENT archive (header,entry+)>
  <!ELEMENT header (#PCDATA)>
  <!ELEMENT entry (name,blob?,link*)>
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT blob (#PCDATA)>
  <!ELEMENT link EMPTY>
  <!ATTLIST entry index NMTOKEN #REQUIRED kind (text|binary|other) "other">
  <!ATTLIST link href URI #IMPLIED rel CDATA #IMPLIED>
  <!ENTITY greeting "hello &amp; goodbye">
  <!ENTITY hex "&#x41;&#65;">
  <!NOTATION raw SYSTEM "urn:example:raw">
  <!ENTITY payload SYSTEM "urn:example:payload" NDATA raw>
]>
<archive>
  <header>&greeting;: &hex;</header>
  <entry index="0007" kind="binary">
    <name>sample</name>
    <blob>before &lt; after &#x1F; end</blob>
    <link href="urn:a" rel="next"/>
    <link href="" rel="alternate"/>
  </entry>
  <entry index="last">
    <name>tail</name>
  </entry>
</archive>