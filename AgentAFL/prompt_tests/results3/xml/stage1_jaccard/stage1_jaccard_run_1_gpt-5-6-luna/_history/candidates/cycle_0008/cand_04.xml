<?xml version="1.0"?>
<!DOCTYPE envelope [
  <!ELEMENT envelope (data)>
  <!ELEMENT data (#PCDATA|chunk)*>
  <!ELEMENT chunk (#PCDATA)>
  <!ATTLIST chunk n NMTOKEN #REQUIRED>
]>
<envelope>
  <data>
    <chunk n="0">zero</chunk>
    <chunk n="1">one &amp; two</chunk>
    <chunk n="2"><![CDATA[
      line one
      line two
    ]]></chunk>
    <chunk n="3">unclosed-looking &lt;tag&gt; text</chunk>
  </data>
</envelope>