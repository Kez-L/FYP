<?xml version="1.0"?>
<!DOCTYPE matrix [
  <!ELEMENT matrix (row+)>
  <!ELEMENT row (cell*)>
  <!ELEMENT cell (#PCDATA)>
  <!ATTLIST cell colspan NMTOKEN "1" rowspan NMTOKEN "1">
  <!ENTITY left "[">
  <!ENTITY right "]">
  <!ENTITY quoted "&lt;cell&gt;">
]>
<matrix xmlns:x="urn:x">
  <row><cell colspan="01">&left;one&right;</cell><cell><![CDATA[
    line-one
    line-two
  ]]></cell></row>
  <row><cell rowspan="0">&quoted;</cell><cell x:flag="yes"/></row>
</matrix>