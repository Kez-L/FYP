<?xml version="1.0"?>
<!DOCTYPE report [
  <!ELEMENT report (header, section*, footer)>
  <!ELEMENT header (#PCDATA)>
  <!ELEMENT section (title, item+)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT item (#PCDATA|strong|code|br)*>
  <!ELEMENT strong (#PCDATA)>
  <!ELEMENT code (#PCDATA)>
  <!ELEMENT br EMPTY>
  <!ELEMENT footer (#PCDATA)>
  <!ATTLIST section rank NMTOKEN #IMPLIED>
  <!ENTITY mark "&#x2022;">
  <!ENTITY open "<">
]>
<report>
