  <section rank="01">
    <title>Symbols</title>
    <item>&mark; <strong>bold</strong> and <code>&lt;tag&gt;</code><br/>next</item>
  </section>
  <section rank="02">
    <title>Empty content</title>
    <item></item>
    <item>left<![CDATA[ raw ]]>&open;right</item>
  </section>
  <footer>done</footer>
</report>