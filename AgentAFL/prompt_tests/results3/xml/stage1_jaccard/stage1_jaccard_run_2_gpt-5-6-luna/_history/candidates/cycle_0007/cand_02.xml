<?xml version="1.0"?>
<!DOCTYPE map [
  <!ELEMENT map (node+)>
  <!ELEMENT node (label?, node*)>
  <!ELEMENT label (#PCDATA|code|fragment)*>
  <!ELEMENT code (#PCDATA)>
  <!ELEMENT fragment (#PCDATA)>
  <!ATTLIST node key NMTOKEN #REQUIRED depth NMTOKEN "0">
  <!ENTITY arrow "&#x2192;">
  <!ENTITY nbsp "&#160;">
]>
<?map-processing instruction?>
<map xmlns:m="urn:map" xmlns:q="urn:aux">
  <node key="root" depth="0">
    <label>Start <code><![CDATA[<node key="literal"/>]]></code> &arrow;</label>
    <node key="left" depth="1">
      <label q:kind="branch">A&nbsp;<fragment>left</fragment></label>
      <node key="leaf-a" depth="2"/>
      <node key="leaf-b" depth="2">
        <label>text<!-- embedded comment --><code>x &lt; y</code></label>
      </node>
    </node>
    <node key="right" depth="1" m:flag="yes">
      <label>Branch <fragment>R</fragment></label>
    </node>
  </node>
</map>