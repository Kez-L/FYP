<?xml version="1.1"?>
<!DOCTYPE labyrinth [
  <!ELEMENT labyrinth (gate)>
  <!ELEMENT gate (inside|outside)>
  <!ELEMENT inside (gate|token)*>
  <!ELEMENT outside EMPTY>
  <!ELEMENT token (#PCDATA)>
  <!ENTITY crack "A&amp;B&lt;C&gt;">
]>
<labyrinth>
  <gate>
    <inside>
      <token xml:space="preserve">  &crack;  </token>
      <gate><outside/></gate>
      <gate><inside><token>nested</token></inside></gate>
    </inside>
  </gate>
</labyrinth>