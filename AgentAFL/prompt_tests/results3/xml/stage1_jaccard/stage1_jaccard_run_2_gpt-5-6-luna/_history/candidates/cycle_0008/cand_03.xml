<?xml version="1.0"?>
<!DOCTYPE matrix [
  <!ELEMENT matrix (row+)>
  <!ELEMENT row (cell*)>
  <!ELEMENT cell (#PCDATA|mark)*>
  <!ELEMENT mark (#PCDATA)>
  <!ATTLIST row index NMTOKEN #REQUIRED>
  <!ATTLIST cell span NMTOKENS #IMPLIED kind CDATA #IMPLIED>
  <!ENTITY open "<mark>">
  <!ENTITY close "</mark>">
]>
<matrix>
  <row index="r1">
    <cell span="a b" kind="text">plain</cell>
    <cell kind="mixed">before &open;inside&close; after</cell>
    <cell><![CDATA[]]></cell>
  </row>
  <row index="r2"><cell span="single">line&#10;break</cell></row>
  <row index="r3">
    <cell kind="quote">one &quot;two&quot; &apos;three&apos;</cell>
  </row>
</matrix>