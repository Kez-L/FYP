  <!ELEMENT payload (#PCDATA)>
  <!ELEMENT checksum (#PCDATA)>
  <!ATTLIST header length CDATA #REQUIRED flags NMTOKENS #IMPLIED>
  <!ATTLIST payload encoding (base64|hex|raw) #IMPLIED>
  <!ENTITY amp "&amp;">
]>
