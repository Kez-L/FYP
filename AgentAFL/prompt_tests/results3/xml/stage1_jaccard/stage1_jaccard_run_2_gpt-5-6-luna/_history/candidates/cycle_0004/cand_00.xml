<?xml version="1.0"?>
<!DOCTYPE universe [
  <!ELEMENT universe (sector+)>
  <!ELEMENT sector (planet|wormhole|artifact)*>
  <!ELEMENT planet (#PCDATA|moon|ring)*>
  <!ELEMENT moon EMPTY>
  <!ELEMENT ring (#PCDATA)>
  <!ELEMENT wormhole EMPTY>
  <!ELEMENT artifact (#PCDATA)>
  <!ATTLIST universe xmlns:astro CDATA #IMPLIED>
  <!ATTLIST sector code NMTOKEN #REQUIRED>
  <!ATTLIST planet class (rocky|gas|ice) "rocky">
  <!ATTLIST moon orbit ID #IMPLIED>
  <!ENTITY star "Sol &amp; Proxima">
  <!ENTITY fractured "left &lt; right &amp;&amp; right &gt; left">
]>
<universe xmlns:astro="urn:example:astro">
  <sector code="A-01">
    <planet class="gas" astro:type="giant">Jupiter<moon orbit="m1"/><ring>dust</ring></planet>
    <artifact>&star;</artifact>
  </sector>
  <sector code="B_02">
    <wormhole/>
    <planet><![CDATA[ice & stone < vapor]]></planet>
    <artifact>&fractured;</artifact>
  </sector>
</universe>