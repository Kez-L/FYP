<?xml version="1.0"?>
<!DOCTYPE media [
  <!NOTATION png SYSTEM "image/png">
  <!NOTATION text PUBLIC "-//Example//NOTATION Plain Text//EN">
  <!ENTITY logo SYSTEM "logo.png" NDATA png>
  <!ELEMENT media (caption, asset, metadata?)>
  <!ELEMENT caption (#PCDATA)>
  <!ELEMENT asset EMPTY>
  <!ELEMENT metadata (author|checksum|tag)*>
  <!ELEMENT author (#PCDATA)>
  <!ELEMENT checksum (#PCDATA)>
  <!ELEMENT tag (#PCDATA)>
  <!ATTLIST asset source ENTITY #REQUIRED format NOTATION (png|text) #IMPLIED>
  <!ATTLIST metadata mode CDATA "compact">
]>
<media>
  <caption>binary reference follows</caption>
  <asset source="logo" format="png"/>
  <metadata mode="expanded">
    <author>parser-test</author>
    <tag>one</tag>
    <checksum>00ff:aa11</checksum>
    <tag><![CDATA[semi & literal < text]]></tag>
  </metadata>
</media>