<?xml version="1.1"?>
<!DOCTYPE configuration [
  <!ENTITY % declarations '
    <!ELEMENT configuration (module*, setting*)>
    <!ATTLIST configuration xml:space (default|preserve) "preserve">
    <!ELEMENT module (name, option*)>
    <!ELEMENT name (#PCDATA)>
    <!ELEMENT option (#PCDATA)>
    <!ELEMENT setting EMPTY>
    <!ATTLIST setting key CDATA #REQUIRED value CDATA #IMPLIED>
  '>
  %declarations;
  <!ENTITY % extras '<!ATTLIST module enabled (yes|no) "yes">'>
  %extras;
]>
<configuration xml:space="preserve">
  <module enabled="no">
    <name>core</name>
    <option>one&#x85;two</option>
    <option>three&#x2028;four</option>
  </module>
  <setting key="path" value="a&#xD;&#xA;b"/>
</configuration>