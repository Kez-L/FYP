<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE archive [
  <!ELEMENT archive (collection+)>
  <!ELEMENT collection (item*)>
  <!ELEMENT item (key,value,history?)>
  <!ELEMENT key (#PCDATA)>
  <!ELEMENT value (#PCDATA|binary)*>
  <!ELEMENT binary EMPTY>
  <!ELEMENT history (event+)>
  <!ELEMENT event (#PCDATA)>
  <!ATTLIST collection name CDATA #REQUIRED>
  <!ATTLIST item uid ID #REQUIRED state (new|changed|deleted) #REQUIRED>
  <!ATTLIST binary type CDATA #REQUIRED length NMTOKEN #IMPLIED>
  <!ATTLIST event when CDATA #REQUIRED actor CDATA #IMPLIED>
  <!NOTATION jpeg SYSTEM "image/jpeg">
  <!ENTITY logo SYSTEM "logo.jpg" NDATA jpeg>
]>
