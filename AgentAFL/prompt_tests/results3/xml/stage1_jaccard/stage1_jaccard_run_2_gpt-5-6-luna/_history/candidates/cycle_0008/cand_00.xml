<?xml version="1.0"?>
<!DOCTYPE archive [
  <!ENTITY % feature "<!ELEMENT audit (record|summary)*>">
  <![INCLUDE[
    <!ELEMENT archive (meta, audit)>
    <!ELEMENT meta (title, created, flag?)>
    <!ELEMENT title (#PCDATA)>
    <!ELEMENT created (#PCDATA)>
    <!ELEMENT flag EMPTY>
    <!ATTLIST flag state (on|off|unknown) "unknown">
  ]]>
  %feature;
  <![IGNORE[
    <!ELEMENT ignored (never, parsed)>
    <!ELEMENT never EMPTY>
  ]]>
  <!ELEMENT record (key, value, note?)>
  <!ELEMENT key (#PCDATA)>
  <!ELEMENT value (#PCDATA)>
  <!ELEMENT note (#PCDATA)>
  <!ELEMENT summary (#PCDATA)>
  <!ENTITY ampersand "&amp;">
  <!ENTITY wrapped "left-&ampersand;-right">
]>
<archive>
  <meta>
    <title>conditional declaration test</title>
    <created>2026-09-24</created>
    <flag state="on"/>
  </meta>
  <audit>
    <record><key>A-1</key><value>&wrapped;</value><note><![CDATA[x < y && y > z]]></note></record>
    <summary>done</summary>
  </audit>
</archive>