<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE scene [
  <!ELEMENT scene (layer*)>
  <!ELEMENT layer (object|group|empty)*>
  <!ELEMENT group (object|group|empty)*>
  <!ELEMENT object (#PCDATA|property)*>
  <!ELEMENT property EMPTY>
  <!ELEMENT empty EMPTY>
  <!ATTLIST layer name CDATA #IMPLIED>
  <!ATTLIST group name CDATA #REQUIRED depth NMTOKEN #IMPLIED>
  <!ATTLIST object type CDATA #IMPLIED>
  <!ATTLIST property key CDATA #REQUIRED value CDATA #IMPLIED>
]>
<scene>
  <layer name="base">
    <group name="g0" depth="0">
      <object type="text">one<property key="font" value="serif"/></object>
      <group name="g1" depth="1">
        <empty/>
        <object type="path"><![CDATA[M 0 0 L 10 10]]></object>
      </group>
    </group>
  </layer>
  <layer>
    <object type="mixed">a&amp;b<property key="quote" value="&quot;'&quot;"/>c</object>
  </layer>
</scene>