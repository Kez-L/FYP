<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE galaxy [
  <!ELEMENT galaxy (cluster|void)*>
  <!ELEMENT cluster (star+, note?)>
  <!ELEMENT void EMPTY>
  <!ELEMENT star EMPTY>
  <!ELEMENT note (#PCDATA|em|br)*>
  <!ELEMENT em (#PCDATA)>
  <!ELEMENT br EMPTY>
  <!ATTLIST star id ID #IMPLIED
                 kind (red|blue|white) "white"
                 coords CDATA #IMPLIED>
  <!ENTITY stellar "Sol &amp; Luna">
  <!ENTITY mark "&#x2605;">
  <!NOTATION jpeg SYSTEM "image/jpeg">
  <!ENTITY picture SYSTEM "nebula.jpg" NDATA jpeg>
]>
<galaxy xmlns="urn:astro:map" xmlns:x="urn:astro:extra" xml:base="https://example.invalid/sky/">
  <cluster x:label="&stellar;">
    <star id="sirius" kind="white" coords="06:45:09,-16:42:58"/>
    <star id="rigel" kind="blue" coords="05:14:32,-08:12:06"/>
    <note>Bright <em>&mark; objects</em><br/>catalogued in <x:band>visible</x:band>.</note>
  </cluster>
  <void x:source="&picture;"/>
  <cluster>
    <star id="antares" kind="red"/>
  </cluster>
</galaxy>