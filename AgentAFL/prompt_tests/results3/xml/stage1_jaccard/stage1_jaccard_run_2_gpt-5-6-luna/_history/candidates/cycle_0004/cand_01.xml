<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE media [
  <!ELEMENT media (clip+, poster?)>
  <!ELEMENT clip (caption|data)*>
  <!ELEMENT caption (#PCDATA|b|i)*>
  <!ELEMENT b (#PCDATA)>
  <!ELEMENT i (#PCDATA)>
  <!ELEMENT data EMPTY>
  <!ELEMENT poster EMPTY>
  <!ATTLIST clip src ENTITY #REQUIRED mode NMTOKENS #IMPLIED>
  <!ATTLIST data format NOTATION #REQUIRED>
  <!ATTLIST poster src ENTITY #REQUIRED>
  <!NOTATION png SYSTEM "image/png">
  <!NOTATION ogg PUBLIC "-//Example//NOTATION Ogg//EN" "audio/ogg">
  <!ENTITY cover SYSTEM "cover.png" NDATA png>
  <!ENTITY soundtrack SYSTEM "track.ogg" NDATA ogg>
  <!ENTITY local "A&lt;B&gt;C">
]>
<media>
  <clip src="soundtrack" mode="audio compressed">
    <caption>Intro <b>&local;</b><!-- hidden --><i><![CDATA[ / raw ]]></i></caption>
    <data format="ogg"/>
  </clip>
  <clip src="cover" mode="still">
    <caption>Frame <?marker value?> end</caption>
    <data format="png"/>
  </clip>
  <poster src="cover"/>
</media>