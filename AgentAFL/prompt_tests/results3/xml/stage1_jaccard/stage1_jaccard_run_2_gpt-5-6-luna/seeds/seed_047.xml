<!DOCTYPE packet [
  <!ELEMENT packet (meta, payload, trail)>
  <!ELEMENT meta EMPTY>
  <!ELEMENT payload (#PCDATA|chunk|![CDATA[not allowed here]])*>
  <!ELEMENT chunk (#PCDATA)>
  <!ELEMENT trail (event*)>
  <!ELEMENT event EMPTY>
  <!ATTLIST meta xmlns CDATA #IMPLIED timestamp CDATA #REQUIRED>
  <!ATTLIST chunk n ID #IMPLIED ref IDREF #IMPLIED>
  <!ATTLIST event kind (open|close|fault) "open" at CDATA #IMPLIED>
  <!ENTITY open "<chunk n='c1'>">
  <!ENTITY close "</chunk>">
]>
