<?xml version="1.0"?>
<!DOCTYPE map [
  <!ELEMENT map (layer*)>
  <!ELEMENT layer (metadata?, feature*)>
  <!ELEMENT metadata ANY>
  <!ELEMENT feature (geometry,properties?)>
  <!ELEMENT geometry (point|line|polygon)>
  <!ELEMENT point EMPTY>
  <!ELEMENT line (point+)>
  <!ELEMENT polygon (ring+)>
  <!ELEMENT ring (point+)>
  <!ELEMENT properties (property*)>
  <!ELEMENT property (#PCDATA)>
  <!ATTLIST layer name CDATA #REQUIRED visible (true|false) "true">
  <!ATTLIST feature fid ID #IMPLIED>
  <!ATTLIST point x CDATA #REQUIRED y CDATA #REQUIRED>
  <!ATTLIST property key CDATA #REQUIRED>
]>
<map>
  <layer name="coastline" visible="false">
    <metadata><![CDATA[projection=EPSG:4326; source=<survey/>]]></metadata>
    <feature fid="f-7">
      <geometry>
        <polygon>
          <ring>
            <point x="-3.2" y="51.4"/>
            <point x="-3.1" y="51.5"/>
            <point x="-3.2" y="51.4"/>
          </ring>
        </polygon>
      </geometry>
      <properties>
        <property key="label">North &amp; West</property>
      </properties>
    </feature>
  </layer>
  <layer name="routes">
    <feature>
      <geometry>
        <line>
          <point x="0" y="0"/>
          <point x="1e2" y="-4.5"/>
        </line>
      </geometry>
    </feature>
  </layer>
</map>