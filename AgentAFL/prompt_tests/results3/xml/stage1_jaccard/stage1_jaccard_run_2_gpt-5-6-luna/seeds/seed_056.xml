<?xml version="1.0"?>
<!DOCTYPE message [
  <!ELEMENT message (to, from, subject, body)>
  <!ELEMENT to (#PCDATA)>
  <!ELEMENT from (#PCDATA)>
  <!ELEMENT subject (#PCDATA)>
  <!ELEMENT body (#PCDATA|quote|list)*>
  <!ELEMENT quote (#PCDATA)>
  <!ELEMENT list (entry*)>
  <!ELEMENT entry (#PCDATA)>
  <!ATTLIST message priority (low|normal|high) "normal">
  <!ENTITY % common "xml:lang NMTOKEN #IMPLIED">
  <!ATTLIST message %common;>
]>
<message priority="high" xml:lang="en">
  <to>alpha@example.test</to>
  <from>beta@example.test</from>
  <subject>Re: &quot;boundary&quot;</subject>
  <body>
    Intro
    <quote>Nested &amp; quoted text</quote>
    <list>
      <entry>first</entry>
      <entry><![CDATA[second <entry>]]></entry>
      <entry>third</entry>
    </list>
    outro
  </body>
</message>