<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!DOCTYPE package [
  <!NOTATION gif SYSTEM "image/gif">
  <!NOTATION text PUBLIC "-//EXAMPLE//NOTATION Plain Text//EN">
  <!ENTITY logo SYSTEM "assets/logo.gif" NDATA gif>
  <!ENTITY manual SYSTEM "manual.txt" NDATA text>
  <!ELEMENT package (title, picture?, attachment?)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT picture EMPTY>
  <!ELEMENT attachment EMPTY>
  <!ATTLIST picture source ENTITY #REQUIRED format NOTATION (gif|text) "gif">
  <!ATTLIST attachment source ENTITY #REQUIRED>
]>
<package>
  <title>Binary references &amp; notation declarations</title>
  <picture source="logo" format="gif"/>
  <attachment source="manual"/>
</package>