<?xml version="1.0"?>
<!DOCTYPE catalog [
  <!ELEMENT catalog (item+)>
  <!ELEMENT item (name, price, detail*)>
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT price (#PCDATA)>
  <!ELEMENT detail EMPTY>
  <!ATTLIST item key ID #REQUIRED>
  <!ATTLIST item class NMTOKENS "default">
  <!ATTLIST detail kind (a|b|c) #IMPLIED code NMTOKEN #IMPLIED>
]>
<catalog>
  <item key="k1" class="one two">
    <name>alpha</name>
    <price>12.00</price>
    <detail kind="a" code="x-y"/>
    <detail kind="c" code="q"/>
  </item>
  <item key="k2" class="  spaced   tokens ">
    <name>beta&amp;gamma</name>
    <price>0&lt;1</price>
    <detail kind="b"/>
  </item>
</catalog>