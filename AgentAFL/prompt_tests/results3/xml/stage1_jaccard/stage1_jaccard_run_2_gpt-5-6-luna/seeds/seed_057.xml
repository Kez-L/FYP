<?xml version="1.0"?>
<!DOCTYPE graph [
  <!ELEMENT graph (node|edge)*>
  <!ELEMENT node EMPTY>
  <!ELEMENT edge EMPTY>
  <!ATTLIST node id ID #REQUIRED label CDATA #IMPLIED>
  <!ATTLIST edge from IDREF #REQUIRED to IDREF #REQUIRED weight NMTOKEN "1">
  <!NOTATION bin SYSTEM "application/octet-stream">
  <!ENTITY payload SYSTEM "data.bin" NDATA bin>
]>
<graph>
  <node id="n0" label="root"/>
  <node id="n1" label="A &amp; B"/>
  <node id="n2" label="line&#x0A;break"/>
  <edge from="n0" to="n1" weight="0"/>
  <edge from="n1" to="n2" weight="001"/>
  <edge from="n2" to="n0"/>
</graph>