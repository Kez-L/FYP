<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE archive [
  <!ELEMENT archive (meta, record*)>
  <!ELEMENT meta EMPTY>
  <!ELEMENT record (key, value, note?)>
  <!ELEMENT key (#PCDATA)>
  <!ELEMENT value (#PCDATA|part)*>
  <!ELEMENT part (#PCDATA)>
  <!ELEMENT note (#PCDATA)>
  <!ATTLIST archive version CDATA #FIXED "7">
  <!ATTLIST meta created CDATA #IMPLIED checksum CDATA #IMPLIED>
  <!ATTLIST record state (new|old|x) "new">
  <!ENTITY tab "&#x9;">
  <!ENTITY left "[">
  <!ENTITY right "]">
]>
<archive version="7">
  <meta created="2026-09-24T00:00:00Z" checksum="sha256:abc"/>
  <record state="x">
    <key> spaced-key </key>
    <value>&left;<part>one</part>&tab;<part>two</part>&right;</value>
    <note>line one
line two &amp; three</note>
  </record>
  <record>
    <key><![CDATA[key]]></key>
    <value></value>
  </record>
</archive>