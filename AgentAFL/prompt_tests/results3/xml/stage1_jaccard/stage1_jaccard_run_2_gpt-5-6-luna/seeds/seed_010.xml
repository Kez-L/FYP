<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!DOCTYPE catalog [
  <!ELEMENT catalog (entry+)>
  <!ELEMENT entry (name, details, link?)>
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT details (#PCDATA|em|br)*>
  <!ELEMENT em (#PCDATA)>
  <!ELEMENT br EMPTY>
  <!ELEMENT link EMPTY>
  <!ATTLIST entry id ID #REQUIRED xml:space (default|preserve) "default">
  <!ATTLIST link href URI #REQUIRED>
  <!ENTITY nbsp "&#xA0;">
  <!ENTITY note "café &amp; crème">
]>
<catalog xml:lang="fr">
  <entry id="item-1" xml:space="preserve">
    <name>Éléments &nbsp; spéciaux</name>
    <details>Texte <em>accentué</em><br/>fin &note;</details>
    <link href="https://example.invalid/a?x=1&amp;y=2"/>
  </entry>
</catalog>