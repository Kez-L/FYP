<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE matrix [
  <!ELEMENT matrix (row+)>
  <!ELEMENT row (cell*)>
  <!ELEMENT cell (#PCDATA|cell)*>
  <!ATTLIST row n NMTOKEN #IMPLIED>
  <!ATTLIST cell axis (x|y|z) "x">
  <!ENTITY % cells "<!ELEMENT generated EMPTY><!ATTLIST generated value CDATA #IMPLIED>">
  %cells;
  <!ENTITY tab "&#x9;">
  <!ENTITY line "&#xA;">
]>
<matrix>
  <row n="A"><cell axis="x">one&tab;two</cell><cell><cell>deep</cell></cell></row>
  <row n="B"><cell axis="z">&line;tail</cell><generated value="ok"/></row>
</matrix>