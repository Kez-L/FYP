<?xml version="1.0"?>
<!DOCTYPE dialogue [
  <!ELEMENT dialogue (scene+)>
  <!ELEMENT scene (stage?,actor+)>
  <!ELEMENT stage (#PCDATA)>
  <!ELEMENT actor (name,utterance+)>
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT utterance (#PCDATA|pause|emphasis)*>
  <!ELEMENT pause EMPTY>
  <!ELEMENT emphasis (#PCDATA|pause)*>
  <!ATTLIST scene id ID #REQUIRED time CDATA #IMPLIED>
  <!ATTLIST actor role CDATA #IMPLIED>
  <!ATTLIST utterance mood (calm|urgent|unknown) "unknown">
  <!ENTITY ellipsis "&#x2026;">
]>
<dialogue>
  <scene id="s1" time="00:00:01">
    <stage>The room is dark; a clock ticks.</stage>
    <actor role="narrator">
      <name>Voice</name>
      <utterance mood="calm">Listen<pause/>carefully&ellipsis;</utterance>
    </actor>
    <actor role="visitor">
      <name>Rhea</name>
      <utterance mood="urgent">Open the door <emphasis>now<pause/>please</emphasis>!</utterance>
      <utterance>There is no answer.</utterance>
    </actor>
  </scene>
  <scene id="s2">
    <stage><![CDATA[<wind> rises beyond the wall ]]></stage>
    <actor>
      <name>Guard &amp; Child</name>
      <utterance mood="unknown">Who goes there?</utterance>
    </actor>
  </scene>
</dialogue>