<?xml version="1.0"?>
<!DOCTYPE dashboard [
  <!ELEMENT dashboard (panel|separator)*>
  <!ELEMENT panel (heading, metric*, footer?)>
  <!ELEMENT heading (#PCDATA)>
  <!ELEMENT metric EMPTY>
  <!ELEMENT footer (#PCDATA)>
  <!ELEMENT separator EMPTY>
  <!ATTLIST panel
    id ID #IMPLIED
    visible (yes|no) "yes"
    xml:lang NMTOKEN #IMPLIED>
  <!ATTLIST metric
    name CDATA #REQUIRED
    value CDATA #IMPLIED
    trend (up|down|flat) #IMPLIED>
  <!ATTLIST separator style CDATA "dashed">
]>
<dashboard xml:base="urn:dash:root" xml:lang="fr">
  <panel id="main" xml:lang="en" visible="no">
    <heading>Quarterly <span>summary</span></heading>
    <metric name="users" value="42" trend="up"/>
    <metric name="errors" value="" trend="flat"></metric>
    <footer xml:space="preserve">  trailing spaces  </footer>
  </panel>
  <separator style="double"/>
  <panel id="secondary">
    <heading><![CDATA[<not-an-element>]]></heading>
    <metric name="latency"/>
  </panel>
</dashboard>