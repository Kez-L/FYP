<?xml version="1.0"?>
<!DOCTYPE outer [
  <!ELEMENT outer (wrapper)>
  <!ELEMENT wrapper (a|b|c)*>
  <!ELEMENT a (#PCDATA)>
  <!ELEMENT b (#PCDATA)>
  <!ELEMENT c EMPTY>
  <!ATTLIST a n CDATA #IMPLIED>
  <!ATTLIST b n CDATA #IMPLIED>
  <!ENTITY common "text &amp; more">
  <!ENTITY quoted "apos: &apos; quote: &quot;">
]>
<outer>
  <wrapper>
    <a n="1">&common;</a>
    <b n="2">&quoted;</b>
    <c/>
    <a n="3">x<![CDATA[y]]>z</a>
    <b n="4"><![CDATA[<a n="fake">]]></b>
    <c></c>
  </wrapper>
</outer>