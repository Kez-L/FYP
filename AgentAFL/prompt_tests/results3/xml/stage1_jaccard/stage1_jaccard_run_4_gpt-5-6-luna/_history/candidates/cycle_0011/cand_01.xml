<!DOCTYPE report [
  <!ENTITY % optional "INCLUDE">
  <!ENTITY % rowattrs 'id ID #IMPLIED class NMTOKENS #IMPLIED'>
  <!ELEMENT report (meta, row*, appendix?)>
  <!ELEMENT meta EMPTY>
  <!ELEMENT row (#PCDATA | cell)*>
  <!ELEMENT cell (#PCDATA)>
  <!ATTLIST row %rowattrs;>
  <!ATTLIST cell name NMTOKEN #IMPLIED>
  <![%optional;[
    <!ELEMENT appendix (item+)>
    <!ELEMENT item (#PCDATA)>
  ]]>
  <!ENTITY marker "&#x41;&#65;">
]>
<report>
  <meta/>
  <row id="r1" class="odd highlighted"><cell name="a">one</cell>&marker;<cell name="b">two</cell></row>
  <row class="even">tail <![CDATA[<not-an-element>]]></row>
  <appendix><item>extra</item><item><![CDATA[raw & text]]></item></appendix>
</report>