<?xml version="1.1"?>
<!DOCTYPE catalog [
  <!NOTATION bin SYSTEM "application/octet-stream">
  <!ENTITY payload SYSTEM "blob.dat" NDATA bin>
  <!ELEMENT catalog (entry+, note?)>
  <!ELEMENT entry (title, description, attachment?)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT description (#PCDATA|em|br)*>
  <!ELEMENT em (#PCDATA)>
  <!ELEMENT br EMPTY>
  <!ELEMENT attachment EMPTY>
  <!ATTLIST entry
    code ID #REQUIRED
    state (new|used|archived) "new"
    rank NMTOKENS #IMPLIED>
  <!ATTLIST attachment
    href ENTITY #REQUIRED
    checksum CDATA #IMPLIED>
  <!ELEMENT note ANY>
]>
<catalog>
  <entry code="e-1" rank="high urgent">
    <title>Inventory</title>
    <description>Marked <em>fragile</em><br/>and sealed.</description>
    <attachment href="payload" checksum="00ff"/>
  </entry>
  <entry code="e-2" state="archived">
    <title>Résumé &#xE9;</title>
    <description><![CDATA[raw ]]> text &amp; more</description>
  </entry>
  <note>unstructured <em>annotation</em></note>
</catalog>