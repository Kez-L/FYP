<?xml version="1.0"?>
<!DOCTYPE vault [
  <!ENTITY % feature "INCLUDE">
  <!ENTITY % fields '<!ELEMENT secret (key, value, fragment?)>
                      <!ELEMENT key (#PCDATA)>
                      <!ELEMENT value (#PCDATA)>
                      <!ELEMENT fragment (#PCDATA)>%feature;'>
  %fields;
  <![%feature;[
    <!ATTLIST secret mode (sealed|open) "sealed">
  ]]>
  <!ENTITY left "[left]">
  <!ENTITY right "[right]">
  <!ENTITY joined "&left;&right;">
]>
<vault>
  <secret mode="open">
    <key><![CDATA[a]]></key>
    <value>&joined; &lt; &quot;quoted&quot;</value>
    <fragment>before<!-- hidden -->after<?p x?></fragment>
  </secret>
</vault>