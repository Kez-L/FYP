<?xml version="1.0"?>
<!DOCTYPE archive [
  <!ENTITY % common '
    <!ELEMENT record (key, value, extra?)>
    <!ELEMENT key (#PCDATA)>
    <!ELEMENT value (#PCDATA)>
    <!ELEMENT extra (#PCDATA)>
    <!ATTLIST record xmlns CDATA #IMPLIED>
  '>
  %common;
  <!ENTITY % switches '
    <![%feature;[
      <!ATTLIST record enabled (true|false) "true">
    ]]>
  '>
  <!ENTITY % feature "feature">
  %switches;
  <!ENTITY left "[">
  <!ENTITY right "]">
]>
<archive>
  <record xmlns="urn:records" enabled="false">
    <key>A&amp;B</key>
    <value>one</value>
    <extra>&lt;escaped&gt; &quot;quoted&quot;</extra>
  </record>
  <record xmlns="">
    <key>two</key>
    <value><![CDATA[three]]></value>
  </record>
</archive>