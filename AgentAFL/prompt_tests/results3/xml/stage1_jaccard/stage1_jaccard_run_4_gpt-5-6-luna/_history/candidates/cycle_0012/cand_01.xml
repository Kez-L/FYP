<?xml version="1.0"?>
<!DOCTYPE report [
  <!ENTITY % common '
    <!ELEMENT report (section|note)+>
    <!ELEMENT section (heading, item*)>
    <!ELEMENT heading (#PCDATA)>
    <!ELEMENT item (#PCDATA|value)*>
    <!ELEMENT value (#PCDATA)>
    <!ELEMENT note (#PCDATA)>
  '>
  %common;
  <!ENTITY % attrs '
    <!ATTLIST section code NMTOKEN #REQUIRED>
    <!ATTLIST item kind CDATA "plain">
  '>
  %attrs;
  <!ENTITY left "[">
  <!ENTITY right "]">
  <!ENTITY nested "&left;&amp;&right;">
]>
<report>
  <section code="A-01">
    <heading>first</heading>
    <item kind="quoted">&nested;</item>
    <item><value>42</value><value>7</value></item>
  </section>
  <note><![CDATA[section-like text: <section code="fake"/>]]></note>
  <section code="B_02">
    <heading>second</heading>
  </section>
</report>