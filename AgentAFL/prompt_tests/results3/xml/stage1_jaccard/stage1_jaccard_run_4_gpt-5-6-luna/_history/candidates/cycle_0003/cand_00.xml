<?xml version="1.0" standalone="yes"?>
<!DOCTYPE catalog [
  <!NOTATION jpeg SYSTEM "image/jpeg">
  <!ENTITY logo SYSTEM "logo.jpg" NDATA jpeg>
  <!ENTITY nbsp "&#160;">
  <!ELEMENT catalog (section+)>
  <!ELEMENT section (title, entry*)>
  <!ATTLIST section code ID #REQUIRED>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT entry (name, description?, link)>
  <!ATTLIST entry ref IDREF #IMPLIED status (new|old|archived) "new">
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT description (#PCDATA|emph)*>
  <!ELEMENT emph (#PCDATA)>
  <!ELEMENT link EMPTY>
  <!ATTLIST link href CDATA #REQUIRED>
]>
<catalog>
  <section code="main">
    <title>Products &amp; Services</title>
    <entry ref="item1">
      <name>Alpha</name>
      <description>First <emph>featured</emph> item&nbsp;</description>
      <link href="https://example.invalid/a"/>
    </entry>
    <entry ref="item2" status="archived">
      <name>Beta</name>
      <link href="urn:example:beta"/>
    </entry>
  </section>
</catalog>