<?xml version="1.0"?>
<!DOCTYPE catalog [
  <!NOTATION png SYSTEM "image/png">
  <!ENTITY logo SYSTEM "logo.png" NDATA png>
  <!ELEMENT catalog (item+, summary?)>
  <!ELEMENT item (name, price, tags, description)>
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT price (#PCDATA)>
  <!ELEMENT tags (tag*)>
  <!ELEMENT tag (#PCDATA)>
  <!ELEMENT description (#PCDATA|em|code)*>
  <!ELEMENT em (#PCDATA)>
  <!ELEMENT code (#PCDATA)>
  <!ELEMENT summary EMPTY>
  <!ATTLIST item id ID #REQUIRED availability (yes|no) "yes">
  <!ATTLIST summary icon ENTITY #IMPLIED>
]>
<catalog xml:lang="en" xml:base="urn:example:catalog">
  <item id="p-1" availability="yes">
    <name>α &amp; β</name>
    <price currency="EUR">19.95</price>
    <tags><tag>odd</tag><tag>compact</tag></tags>
    <description>Text with <em>emphasis</em>, <code>code()</code>, and <![CDATA[<literal/>]]>.</description>
  </item>
  <item id="p-2" availability="no">
    <name>Second item</name>
    <price currency="JPY">0</price>
    <tags/>
    <description>Line one
line two<?note data?><![CDATA[x]]></description>
  </item>
  <summary icon="logo"/>
</catalog>