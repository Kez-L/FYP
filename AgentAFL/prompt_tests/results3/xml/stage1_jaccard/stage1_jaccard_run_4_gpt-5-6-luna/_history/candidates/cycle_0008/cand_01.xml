<?xml version="1.0"?>
<!DOCTYPE matrix [
  <!ELEMENT matrix (row+)>
  <!ELEMENT row (cell+)>
  <!ELEMENT cell (#PCDATA)>
  <!ATTLIST row index NMTOKEN #REQUIRED>
  <!ATTLIST cell r CDATA #IMPLIED c CDATA #IMPLIED>
  <!ENTITY q "&#34;">
  <!ENTITY amp "&#38;">
]>
<matrix>
  <row index="0"><cell r="0" c="0">0</cell><cell r="0" c="1">&q;one&q;</cell></row>
  <row index="1"><cell r="1" c="0"><![CDATA[&q;]]></cell><cell r="1" c="1">two&amp;three</cell></row>
  <row index="2"><cell r="2" c="0">&amp;&amp;&amp;</cell><cell r="2" c="1">&amp;</cell></row>
</matrix>