<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE archive [
  <!ELEMENT archive (directory)>
  <!ELEMENT directory (folder|file|shortcut)*>
  <!ELEMENT folder (folder|file|shortcut)*>
  <!ELEMENT file (#PCDATA)>
  <!ELEMENT shortcut EMPTY>
  <!ATTLIST folder name CDATA #REQUIRED>
  <!ATTLIST file
    name CDATA #REQUIRED
    size NMTOKEN #IMPLIED
    executable (true|false) "false">
  <!ATTLIST shortcut
    name CDATA #REQUIRED
    target IDREF #REQUIRED>
  <!ENTITY nbsp "&#160;">
  <!ENTITY snowman "&#x2603;">
]>
<archive>
  <directory>
    <folder name="root">
      <file name="readme.txt" size="12" executable="false">hello&nbsp;world</file>
      <folder name="深い">
        <file name="emoji-☃.txt" size="0" executable="true"><![CDATA[]]></file>
        <shortcut name="alias" target="missing-id"/>
      </folder>
      <folder name="empty"></folder>
    </folder>
    <file name="outside" size="18446744073709551615" executable="true">
      line one
      line two
    </file>
  </directory>
</archive>