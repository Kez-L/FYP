<?xml version="1.0"?>
<!DOCTYPE catalog [
  <!NOTATION gif SYSTEM "image/gif">
  <!ENTITY cover SYSTEM "cover.gif" NDATA gif>
  <!ELEMENT catalog (section+)>
  <!ELEMENT section (title, entry*)>
  <!ATTLIST section
    id ID #REQUIRED
    status (draft|published|archived) "draft"
    cover ENTITY #IMPLIED>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT entry (#PCDATA|emphasis|link)*>
  <!ELEMENT emphasis (#PCDATA)>
  <!ELEMENT link (#PCDATA)>
  <!ATTLIST link href CDATA #REQUIRED>
]>
<catalog>
  <section id="s-01" status="published" cover="cover">
    <title>Notation sample</title>
    <entry>Plain <emphasis>mixed</emphasis> text with <link href="urn:item:7">a link</link>.</entry>
  </section>
  <section id="s-02">
    <title>Empty section</title>
  </section>
</catalog>