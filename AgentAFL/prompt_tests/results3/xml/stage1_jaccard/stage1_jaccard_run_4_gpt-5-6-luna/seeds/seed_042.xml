<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE graph [
  <!ELEMENT graph (node|edge)*>
  <!ELEMENT node (label?, property*)>
  <!ATTLIST node id ID #REQUIRED kind CDATA #IMPLIED>
  <!ELEMENT edge EMPTY>
  <!ATTLIST edge from IDREF #REQUIRED to IDREF #REQUIRED weight CDATA "1">
  <!ELEMENT label (#PCDATA)>
  <!ELEMENT property (#PCDATA|value)*>
  <!ATTLIST property key CDATA #REQUIRED>
  <!ELEMENT value (#PCDATA)>
  <!ENTITY left "[" >
  <!ENTITY right "]" >
]>
<graph>
  <node id="n-root" kind="root">
    <label>Root &left;entry&right;</label>
    <property key="quoted"><value>one</value><value>two</value></property>
  </node>
  <node id="n-leaf">
    <property key="payload"><![CDATA[&left;not-expanded&right;]]></property>
  </node>
  <edge from="n-root" to="n-leaf" weight="0.000000"/>
  <edge from="n-leaf" to="n-root" weight="-1"/>
  <node id="n-empty"/>
</graph>