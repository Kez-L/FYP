<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE catalog [
  <!ELEMENT catalog (entry+)>
  <!ELEMENT entry (title, meta?, body)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT meta EMPTY>
  <!ELEMENT body (#PCDATA|em|br)*>
  <!ELEMENT em (#PCDATA|em)*>
  <!ELEMENT br EMPTY>
  <!ATTLIST entry id ID #REQUIRED status (draft|final|archived) "draft">
  <!ATTLIST meta created CDATA #IMPLIED>
  <!ENTITY mark "&#x2063;">
]>
<catalog xmlns="urn:example:catalog" xmlns:x="urn:example:extra">
  <entry id="e-01" status="final">
    <title>Boundary &amp; &lt;Markup&gt;</title>
    <meta created="2026-10-01"/>
    <body>alpha<em>nested <em>emphasis</em></em><br/>omega&mark;</body>
  </entry>
  <entry id="e-02">
    <title><![CDATA[raw ]]><![CDATA[]]> <![CDATA[text]]></title>
    <body x:flag="yes">left<?note data?>right</body>
  </entry>
</catalog>