<?xml version="1.0"?>
<!DOCTYPE report [
  <!ENTITY % common '
    <!ELEMENT report (header, body, footer)>
    <!ELEMENT header (field*)>
    <!ELEMENT field EMPTY>
    <!ATTLIST field name CDATA #REQUIRED value CDATA #IMPLIED>
  '>
  %common;
  <!ELEMENT body (section+)>
  <!ELEMENT section (heading?, paragraph*, section*)>
  <!ATTLIST section depth CDATA #IMPLIED>
  <!ELEMENT heading (#PCDATA)>
  <!ELEMENT paragraph (#PCDATA|strong|break)*>
  <!ELEMENT strong (#PCDATA)>
  <!ELEMENT break EMPTY>
  <!ELEMENT footer (#PCDATA)>
  <!ENTITY nbsp "&#160;">
  <!ENTITY % extra "INCLUDE">
  <![%extra;[
    <!ATTLIST report format (text|html|mixed) "mixed">
  ]]>
]>
<report format="html">
  <header>
    <field name="owner" value="&quot;qa&quot;"/>
    <field name="empty"/>
  </header>
  <body>
    <section depth="1">
      <heading>Overview</heading>
      <paragraph>Alpha &amp; <strong>beta</strong><break/>gamma& nbsp;</paragraph>
      <section depth="2">
        <paragraph><![CDATA[<literal node="not-real"/>]]></paragraph>
      </section>
    </section>
  </body>
  <footer>End&#x0A;of report</footer>
</report>