<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE catalog [
  <!ELEMENT catalog (entry+, footer)>
  <!ELEMENT entry (title, creator*, description, link*)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT creator (#PCDATA)>
  <!ELEMENT description (#PCDATA|em|code|br)*>
  <!ELEMENT em (#PCDATA)>
  <!ELEMENT code (#PCDATA)>
  <!ELEMENT br EMPTY>
  <!ELEMENT link (#PCDATA)>
  <!ELEMENT footer (#PCDATA)>
  <!ATTLIST catalog xmlns CDATA #IMPLIED xml:lang NMTOKEN "en">
  <!ATTLIST entry id ID #REQUIRED status (new|old|draft) "new">
  <!ATTLIST link ref IDREF #IMPLIED>
  <!ENTITY mark "&#xE2;&#x98;&#x83;">
  <!ENTITY phrase "A &amp; B &lt; C &gt; D">
]>
<catalog xmlns="urn:example:catalog" xml:lang="fr">
  <entry id="e1" status="draft">
    <title>Signals &mark;</title>
    <creator>Alpha</creator>
    <creator>Beta</creator>
    <description>text <em>emphasis</em><br/><code>&phrase;</code> tail</description>
    <link ref="e2">next</link>
  </entry>
  <entry id="e2">
    <title>Second</title>
    <description><![CDATA[raw ]]> content &amp; more</description>
  </entry>
  <footer>done</footer>
</catalog>