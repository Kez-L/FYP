<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE matrix [
  <!ELEMENT matrix (row+)>
  <!ELEMENT row (cell+)>
  <!ELEMENT cell (#PCDATA)>
  <!ATTLIST cell r CDATA #IMPLIED c CDATA #IMPLIED kind CDATA "text">
  <!ENTITY e0 "zero">
  <!ENTITY e1 "&e0;-one">
  <!ENTITY e2 "&e1;-two">
  <!ENTITY e3 "&e2;-three">
]>
<matrix>
  <row r="1">
    <cell r="1" c="1" kind="entity">&e3;</cell>
    <cell r="1" c="2">a&amp;b&lt;c&gt;</cell>
    <cell r="1" c="3"><![CDATA[line&#10;not-an-entity]]></cell>
  </row>
  <row r="2">
    <cell r="2" c="1">
      text
      <cell>nested where character data was expected</cell>
      tail
    </cell>
    <cell r="2" c="2" kind="quote" data-extra="&quot;"/>
  </row>
</matrix>