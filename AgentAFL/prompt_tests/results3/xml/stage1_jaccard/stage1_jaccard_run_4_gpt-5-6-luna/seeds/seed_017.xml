<?xml version="1.0"?>
<!DOCTYPE vessel [
  <!ENTITY ocean "Atlantic &amp; Pacific">
  <!ENTITY mark "&#x3C;marker&#x3E;">
  <!ELEMENT vessel (name, route, note?)>
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT route (point, point, point)>
  <!ELEMENT point EMPTY>
  <!ATTLIST point
    lat CDATA #REQUIRED
    lon CDATA #REQUIRED
    kind CDATA "waypoint">
  <!ELEMENT note (#PCDATA)>
  <!ATTLIST vessel
    code NMTOKEN #REQUIRED
    label CDATA "&ocean;">
]>
<vessel code="VX_17" label="custom">
  <name>&ocean;</name>
  <route>
    <point lat="51.4778" lon="-0.0015"/>
    <point lat="0" lon="180" kind="dateline"/>
    <point lat="-33.8568" lon="151.2153"/>
  </route>
  <note>Literal entity text: &mark; and numeric &#10; newline.</note>
</vessel>