<?xml version="1.0"?>
<!DOCTYPE catalog [
  <!NOTATION bin SYSTEM "application/octet-stream">
  <!ENTITY logo SYSTEM "logo.bin" NDATA bin>
  <!ENTITY company "North &amp; South">
  <!ELEMENT catalog (title, group+)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT group (asset+, note?)>
  <!ELEMENT asset EMPTY>
  <!ELEMENT note (#PCDATA)>
  <!ATTLIST catalog xml:lang CDATA #IMPLIED>
  <!ATTLIST group name ID #REQUIRED>
  <!ATTLIST asset id ID #REQUIRED ref IDREF #IMPLIED preview ENTITY #IMPLIED>
]>
<catalog xml:lang="en">
  <title>&company; collection</title>
  <group name="g-main">
    <asset id="a-one" preview="logo"/>
    <asset id="a-two" ref="a-one"/>
    <note>Assets &lt;may&gt; contain binary previews.</note>
  </group>
</catalog>