<!DOCTYPE report [
  <!ENTITY % mode "INCLUDE">
  <!ENTITY % declarations '
    <!ELEMENT report (header, data)>
    <!ELEMENT header (author, timestamp)>
    <!ELEMENT author (#PCDATA)>
    <!ELEMENT timestamp (#PCDATA)>
    <!ELEMENT data (row+)>
    <!ELEMENT row (cell, cell?, cell?)>
    <!ATTLIST row number NMTOKEN #IMPLIED>
    <!ELEMENT cell (#PCDATA)>
  '>
  %declarations;
  <![%mode;[
    <!ATTLIST report format (short|long) "long">
  ]]>
]>
<report format="short">
  <header>
    <author>Δelta &amp; Co.</author>
    <timestamp>2026-10-01T00:00:00Z</timestamp>
  </header>
  <data>
    <row number="001"><cell>one</cell><cell>two</cell><cell>three</cell></row>
    <row><cell><![CDATA[x < y && y > z]]></cell></row>
    <row number="003"><cell>終</cell><cell>é</cell></row>
  </data>
</report>