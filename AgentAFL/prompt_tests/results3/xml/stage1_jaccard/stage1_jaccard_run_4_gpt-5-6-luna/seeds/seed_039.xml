<?xml version="1.0"?>
<!DOCTYPE report [
  <!ELEMENT report (section, section?, appendix)>
  <!ELEMENT section (heading, item*)>
  <!ELEMENT heading (#PCDATA)>
  <!ELEMENT item (label, value, note?)>
  <!ELEMENT label (#PCDATA)>
  <!ELEMENT value (#PCDATA|fragment)*>
  <!ELEMENT note (#PCDATA)>
  <!ELEMENT fragment (#PCDATA)>
  <!ELEMENT appendix EMPTY>
  <!ATTLIST section name CDATA #REQUIRED>
  <!ATTLIST item key ID #REQUIRED>
  <!ATTLIST value type CDATA #IMPLIED>
  <!ENTITY nbsp "&#160;">
  <!ENTITY euro "&#x20AC;">
]>
<report>
  <section name="primary">
    <heading>Measurements</heading>
    <item key="i1">
      <label>temperature</label>
      <value type="decimal">-273.15&nbsp;°C</value>
      <note>lower bound</note>
    </item>
    <item key="i2">
      <label>currency</label>
      <value type="text">10&nbsp;&euro;<fragment><![CDATA[ / unit ]]></fragment></value>
    </item>
  </section>
  <section name="secondary">
    <heading>Empty values</heading>
    <item key="i3"><label>x</label><value/></item>
  </section>
  <appendix ref="missing"/>
</report>