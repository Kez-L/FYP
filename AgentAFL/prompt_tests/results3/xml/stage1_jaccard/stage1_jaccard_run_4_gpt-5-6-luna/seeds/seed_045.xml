<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE catalog [
  <!NOTATION svg SYSTEM "image/svg+xml">
  <!ENTITY logo SYSTEM "logo.svg" NDATA svg>
  <!ENTITY amp "&#38;">
  <!ENTITY quote "&#34;">
  <!ELEMENT catalog (entry+)>
  <!ELEMENT entry (title, metadata?, description, asset*)>
  <!ATTLIST entry
    id ID #REQUIRED
    status (draft|published|archived) "draft"
    xmlns:meta CDATA #IMPLIED>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT metadata EMPTY>
  <!ATTLIST metadata
    created CDATA #IMPLIED
    updated CDATA #IMPLIED>
  <!ELEMENT description (#PCDATA|link|em|code)*>
  <!ELEMENT link (#PCDATA)>
  <!ATTLIST link href CDATA #REQUIRED>
  <!ELEMENT em (#PCDATA|code)*>
  <!ELEMENT code (#PCDATA)>
  <!ELEMENT asset EMPTY>
  <!ATTLIST asset source ENTITY #REQUIRED kind NOTATION #REQUIRED>
]>
<catalog xmlns="urn:example:catalog" xmlns:meta="urn:example:metadata">
  <entry id="item-α" status="published" meta:revision="7">
    <title>Markup &amp; Metadata</title>
    <metadata created="2026-01-01T00:00:00Z" updated="2026-09-30T23:59:59Z"/>
    <description>
      Text with &amp; and &quot; entities, a
      <link href="https://example.invalid/a?x=1&amp;y=2">link</link>,
      <em>emphasis <code>&lt;token&gt;</code></em>.
    </description>
    <asset source="logo" kind="svg"/>
  </entry>
</catalog>