<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE matrix [
  <!ELEMENT matrix (row+)>
  <!ELEMENT row (cell+)>
  <!ELEMENT cell (#PCDATA)>
  <!ATTLIST row index CDATA #REQUIRED>
  <!ATTLIST cell
    column NMTOKEN #REQUIRED
    kind (integer|decimal|string) "string">
  <!ENTITY nbsp "&#160;">
  <!ENTITY quote "&quot;">
]>
<matrix>
  <row index="0">
    <cell column="a" kind="integer">000</cell>
    <cell column="b" kind="decimal">-0.00</cell>
    <cell column="c">alpha&nbsp;beta</cell>
  </row>
  <row index="1">
    <cell column="a" kind="integer">+17</cell>
    <cell column="b" kind="decimal">3.14159</cell>
    <cell column="c"><![CDATA[semi & entity]]></cell>
  </row>
  <row index="2">
    <cell column="a" kind="string">line
break</cell>
    <cell column="b" kind="string">&quote;quoted&quote;</cell>
  </row>
</matrix>