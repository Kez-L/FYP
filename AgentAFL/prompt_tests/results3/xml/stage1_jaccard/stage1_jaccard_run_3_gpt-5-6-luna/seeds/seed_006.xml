<?xml version="1.0"?>
<!DOCTYPE envelope [
  <!ELEMENT envelope (header, body, signature)>
  <!ELEMENT header EMPTY>
  <!ELEMENT body (section+)>
  <!ELEMENT section (heading, (p|list|table)*)>
  <!ELEMENT heading (#PCDATA)>
  <!ELEMENT p (#PCDATA|b|i|br)*>
  <!ELEMENT b (#PCDATA)>
  <!ELEMENT i (#PCDATA)>
  <!ELEMENT br EMPTY>
  <!ELEMENT list (li*)>
  <!ELEMENT li (#PCDATA|b|i)*>
  <!ELEMENT table (row*)>
  <!ELEMENT row (cell*)>
  <!ELEMENT cell (#PCDATA)>
  <!ELEMENT signature (#PCDATA)>
  <!ATTLIST header version NMTOKEN #IMPLIED>
  <!ATTLIST section level NMTOKEN #REQUIRED>
  <!ENTITY nbsp "&#160;">
]>
<envelope>
  <header version="v2.7"/>
  <body>
    <section level="1">
      <heading>Overview</heading>
      <p>alpha<b>bold</b><br/><i>italic</i>&nbsp;omega</p>
      <list><li>one</li><li>two<b>!</b></li></list>
    </section>
    <section level="2">
      <heading><![CDATA[Rows & columns]]></heading>
      <table>
        <row><cell>A</cell><cell>B</cell></row>
        <row><cell><![CDATA[<x/>]]></cell><cell>C</cell></row>
      </table>
    </section>
  </body>
  <signature>sha256:unknown</signature>
</envelope>