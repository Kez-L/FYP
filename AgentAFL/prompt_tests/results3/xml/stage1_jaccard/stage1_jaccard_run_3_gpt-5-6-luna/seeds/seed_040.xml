<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!DOCTYPE catalog [
  <!NOTATION jpeg SYSTEM "image/jpeg">
  <!ENTITY cover SYSTEM "cover.jpg" NDATA jpeg>
  <!ELEMENT catalog (book+)>
  <!ELEMENT book (title, author?, summary)>
  <!ATTLIST book
    id ID #REQUIRED
    cover ENTITY #IMPLIED
    rating NMTOKEN "unrated">
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT author (#PCDATA)>
  <!ELEMENT summary (#PCDATA|emph|br)*>
  <!ELEMENT emph (#PCDATA)>
  <!ELEMENT br EMPTY>
]>
<catalog>
  <book id="b1" cover="cover" rating="5">
    <title>Parser &amp; Entities</title>
    <author>A &amp; B</author>
    <summary>Mixed <emph>content</emph><br/>with references.</summary>
  </book>
</catalog>