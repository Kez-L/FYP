<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE media [
  <!NOTATION png SYSTEM "image/png">
  <!NOTATION text PUBLIC "-//example//NOTATION Plain Text//EN" "text/plain">
  <!ENTITY banner "A &quot;quoted&quot; banner">
  <!ENTITY fragment "<caption>embedded &amp; marked</caption>">
  <!ENTITY binary SYSTEM "missing-image.bin" NDATA png>
  <!ELEMENT media (title, caption, payload, attachment?)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT caption (#PCDATA|emph)*>
  <!ELEMENT emph (#PCDATA)>
  <!ELEMENT payload (#PCDATA)>
  <!ELEMENT attachment EMPTY>
  <!ATTLIST attachment
    source ENTITY #REQUIRED
    format NOTATION #IMPLIED>
]>
<media>
  <title>&banner;</title>
  <caption>before <emph>inside</emph> after &fragment;</caption>
  <payload><![CDATA[
    <not-an-element attr='x'/> ]]> &lt;end&gt;
  </payload>
  <attachment source="binary" format="png"/>
</media>