<?xml version="1.1" encoding="UTF-8" standalone="yes"?>
<!DOCTYPE registry [
  <!ELEMENT registry (entry, entry?, trailer)>
  <!ELEMENT entry (name, value, details?)>
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT value (#PCDATA)>
  <!ELEMENT details (line*)>
  <!ELEMENT line (#PCDATA)>
  <!ELEMENT trailer EMPTY>
  <!ATTLIST entry category CDATA #IMPLIED>
  <!ATTLIST trailer checksum CDATA #REQUIRED>
  <!ENTITY nbsp "&#160;">
  <!ENTITY leftmark "&#x27;">
  <!ENTITY rightmark "&#x27;">
  <!ENTITY phrase "&leftmark;inside&rightmark;">
]>
<registry xmlns="urn:registry:v3" xmlns:x="urn:extra">
  <entry category="α">
    <name>first&nbsp;</name>
    <value>&phrase; &lt;value&gt;</value>
    <details>
      <line><![CDATA[one]]></line>
      <line>two &x; three</line>
      <line>four<!--comment--><?pi?></line>
    </details>
  </entry>
  <entry category="mixed">
    <name>x:name</name>
    <value xml:space="preserve">  padded
value  </value>
    <details>
      <line>x:raw</line>
    </details>
  </entry>
  <trailer checksum="&quot;bad?&quot;"/>
</registry>