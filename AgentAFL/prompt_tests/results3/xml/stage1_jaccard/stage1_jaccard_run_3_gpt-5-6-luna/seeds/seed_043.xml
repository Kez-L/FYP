<?xml version="1.0"?>
<!DOCTYPE envelope [
  <!ENTITY left "[">
  <!ENTITY right "]">
  <!ENTITY payload "&left;inside&right;">
  <!ELEMENT envelope (message, metadata)>
  <!ELEMENT message (#PCDATA)>
  <!ELEMENT metadata (tag*)>
  <!ELEMENT tag EMPTY>
  <!ATTLIST tag
    name CDATA #REQUIRED
    value CDATA "default">
]>
<envelope>
  <message>&payload; &lt;raw&gt; &#65;&#x42;</message>
  <metadata>
    <tag name="one"/>
    <tag name="two" value="&quot;quoted&quot;"/>
    <tag name="three" value="&payload;"/>
  </metadata>
</envelope>