<?xml version="1.0"?>
<!DOCTYPE catalog [
  <!ENTITY % declarations
    "<!ELEMENT catalog (entry|gap)*>
     <!ELEMENT entry (#PCDATA)>
     <!ELEMENT gap EMPTY>
     <!ATTLIST entry code ID #IMPLIED>">
  %declarations;
  <!ENTITY % mode "IGNORE">
  <![ %mode; [
    <!ELEMENT secret (#PCDATA)>
    <!ATTLIST secret hidden CDATA "yes">
  ]]>
  <![INCLUDE[
    <!ENTITY marker "included">
  ]]>
]>
<catalog>
  <entry code="first">one &marker;</entry>
  <gap/>
  <entry>two</entry>
</catalog>