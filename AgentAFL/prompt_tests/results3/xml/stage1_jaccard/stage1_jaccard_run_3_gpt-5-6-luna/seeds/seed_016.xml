<?xml version="1.0"?>
<!DOCTYPE ledger [
  <!ELEMENT ledger (entry|gap)*>
  <!ELEMENT entry (head, body?, tail)>
  <!ELEMENT head (#PCDATA)>
  <!ELEMENT body (#PCDATA|mark)*>
  <!ELEMENT mark EMPTY>
  <!ELEMENT tail (#PCDATA)>
  <!ELEMENT gap EMPTY>
  <!ATTLIST entry id ID #IMPLIED refs IDREFS #IMPLIED>
  <!ATTLIST mark level (low|mid|high) "mid">
  <!ENTITY nbsp "&#160;">
]>
<ledger>
  <entry id="e1" refs="e1">
    <head>Opening &nbsp; section</head>
    <body>left<mark level="high"/>middle<mark/>right</body>
    <tail>done</tail>
  </entry>
  <gap/>
  <entry id="e2">
    <head><![CDATA[]]></head>
    <tail>trailing <?audit value?> text</tail>
  </entry>
</ledger>