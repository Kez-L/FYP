<?xml version="1.0"?>
<!DOCTYPE catalog [
  <!NOTATION png SYSTEM "image/png">
  <!NOTATION svg PUBLIC "-//W3C//DTD SVG 1.1//EN" "http://www.w3.org/Graphics/SVG/1.1/DTD/svg11.dtd">
  <!ENTITY logo SYSTEM "logo.png" NDATA png>
  <!ENTITY vector SYSTEM "vector.svg" NDATA svg>
  <!ENTITY title "Inventory &amp; Archive">
  <!ELEMENT catalog (entry+, footer?)>
  <!ELEMENT entry (name, asset*, note?)>
  <!ATTLIST entry key ID #REQUIRED state (new|old|missing) "new">
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT asset EMPTY>
  <!ATTLIST asset href ENTITY #REQUIRED format NOTATION (png|svg) #IMPLIED>
  <!ELEMENT note (#PCDATA|emph)*>
  <!ELEMENT emph (#PCDATA)>
  <!ELEMENT footer (#PCDATA)>
]>
<catalog>
  <entry key="e1" state="old">
    <name>&title;</name>
    <asset href="logo" format="png"/>
    <note>retained <emph>for review</emph></note>
  </entry>
  <entry key="e2">
    <name>Vector sample</name>
    <asset href="vector" format="svg"/>
  </entry>
  <footer>End of catalog</footer>
</catalog>