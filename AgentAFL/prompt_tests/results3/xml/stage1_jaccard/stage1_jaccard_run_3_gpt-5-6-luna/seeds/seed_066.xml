<?xml version="1.1" standalone="yes"?>
<!DOCTYPE packet [
  <!NOTATION bin SYSTEM "application/octet-stream">
  <!ENTITY payload SYSTEM "payload.bin" NDATA bin>
  <!ELEMENT packet (header, data, note?)>
  <!ELEMENT header EMPTY>
  <!ATTLIST header
            version NMTOKEN #REQUIRED
            mode (fast|safe|debug) "safe">
  <!ELEMENT data (#PCDATA)>
  <!ATTLIST data source ENTITY #IMPLIED>
  <!ELEMENT note (#PCDATA)>
]>
<packet>
  <header version="v1.0" mode="debug"/>
  <data source="payload">line one&#x85;line two&#x2028;line three</data>
  <note>control reference follows: &#x1;</note>
</packet>