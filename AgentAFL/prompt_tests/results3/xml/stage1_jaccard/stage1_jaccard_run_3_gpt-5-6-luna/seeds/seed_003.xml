<?xml version="1.0"?>
<!DOCTYPE report [
  <!ELEMENT report (summary?, data)>
  <!ELEMENT summary (#PCDATA)>
  <!ELEMENT data (entry+)>
  <!ELEMENT entry (#PCDATA|meta)*>
  <!ELEMENT meta (#PCDATA)>
  <!ATTLIST entry name CDATA #REQUIRED>
  <!ENTITY left "[" >
  <!ENTITY right "]" >
]>
<report>
  <?audit mode="compact"?>
  <summary>&left;status&right; <![CDATA[ok]]></summary>
  <data>
    <entry name="one">text<meta>m1</meta>tail</entry>
    <entry name="two"><meta><![CDATA[<tag attr="x"/>]]></meta></entry>
    <entry name="three">a&#x20;b&#x9;c&#xD;&#xA;</entry>
  </data>
  <!-- trailing comment -->
</report>