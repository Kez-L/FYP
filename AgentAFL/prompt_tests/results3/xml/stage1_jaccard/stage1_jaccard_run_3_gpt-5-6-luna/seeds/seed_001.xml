<!DOCTYPE envelope [
  <!ELEMENT envelope (header, payload)>
  <!ELEMENT header EMPTY>
  <!ATTLIST header
    version NMTOKEN "v1"
    stamp CDATA #IMPLIED>
  <!ELEMENT payload (record*)>
  <!ELEMENT record EMPTY>
  <!ATTLIST record
    key ID #REQUIRED
    ref IDREF #IMPLIED
    enabled (yes|no) "yes">
]>
<envelope>
  <header stamp="&#x32;&#x30;&#x32;&#x36;-09-24"/>
  <payload>
    <record key="r0" enabled="no"/>
    <record key="r1" ref="r0"/>
    <record key="r2" ref="r1" enabled="yes"/>
  </payload>
</envelope>