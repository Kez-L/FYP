<!DOCTYPE network [
  <!ELEMENT network (host+)>
  <!ELEMENT host (address, service*)>
  <!ATTLIST host name CDATA #REQUIRED enabled (yes|no) "yes">
  <!ELEMENT address (#PCDATA)>
  <!ELEMENT service EMPTY>
  <!ATTLIST service
            port NMTOKEN #REQUIRED
            protocol (tcp|udp) #REQUIRED
            secure (true|false) "false">
  <!ENTITY nl "&#xA;">
]>
<network>
  <host name="edge-1" enabled="yes">
    <address>2001:db8::1</address>
    <service port="443" protocol="tcp" secure="true"/>
    <service port="53" protocol="udp"/>
  </host>
  <host name="edge&amp;2">
    <address>127.0.0.1&nl;alias</address>
    <service port="8080" protocol="tcp"/>
  </host>
</network>