<?xml version="1.0"?>
<!DOCTYPE dashboard [
  <!ELEMENT dashboard (header, panel*)>
  <!ELEMENT header (caption, owner?)>
  <!ELEMENT caption (#PCDATA)>
  <!ELEMENT owner (#PCDATA)>
  <!ELEMENT panel (label, metric*)>
  <!ELEMENT label (#PCDATA)>
  <!ELEMENT metric EMPTY>
  <!ATTLIST dashboard xmlns CDATA #FIXED "urn:dash">
  <!ATTLIST panel name CDATA #REQUIRED state (open|closed) "open">
  <!ATTLIST metric key NMTOKEN #REQUIRED value CDATA #IMPLIED>
]>
<dashboard xmlns="urn:dash" xmlns:x="urn:extra" xml:lang="en">
  <!-- a comment between document-level children -->
  <header>
    <caption><![CDATA[Quarterly <summary>]]></caption>
    <owner x:role="reviewer">A &amp; B</owner>
  </header>
  <panel name="north" state="open">
    <label>North &lt; region</label>
    <metric key="latency" value="12.5"/>
    <metric key="load"/>
  </panel>
  <panel xmlns="" name="raw" state="closed">
    <label>unqualified panel</label>
    <metric key="bytes" value="&#x31;&#x32;&#x33;"/>
  </panel>
  <?refresh interval="30"?>
</dashboard>