<?xml version="1.0"?>
<!DOCTYPE vault [
  <!ENTITY % switch "<!ENTITY enabled 'yes'>">
  <![INCLUDE[
    <!ELEMENT vault (open, sealed)>
    <!ELEMENT open (#PCDATA)>
  ]]>
  <![IGNORE[
    <!ELEMENT discarded (never)>
    <!ATTLIST discarded ghost CDATA #IMPLIED>
  ]]>
  %switch;
  <!ELEMENT sealed (#PCDATA)>
  <!ENTITY left "L">
  <!ENTITY right "&left;R">
]>
<vault>
  <open>&enabled;:&right;</open>
  <sealed>[%switch;] &left;&right;</sealed>
</vault>