<?xml version="1.0"?>
<!DOCTYPE envelope [
  <!ELEMENT envelope (meta, body)>
  <!ELEMENT meta (tag*)>
  <!ELEMENT tag (#PCDATA)>
  <!ELEMENT body (section+)>
  <!ELEMENT section (heading, item*)>
  <!ELEMENT heading (#PCDATA)>
  <!ELEMENT item (#PCDATA|link|br)*>
  <!ELEMENT link (#PCDATA)>
  <!ELEMENT br EMPTY>
  <!ATTLIST section xml:lang NMTOKEN #IMPLIED level (low|mid|high) #REQUIRED>
  <!ATTLIST link target CDATA #REQUIRED>
  <!ENTITY nbsp "&#160;">
  <!ENTITY ampword "A&amp;B">
]>
<envelope>
  <meta>
    <tag>alpha</tag>
    <tag>beta</tag>
    <tag>&ampword;</tag>
  </meta>
  <body>
    <section xml:lang="en-US" level="high">
      <heading>Overview</heading>
      <item>first&nbsp;item<br/>continued</item>
      <item>visit <link target="urn:test:one">the reference</link> now</item>
    </section>
    <section xml:lang="x-private" level="low">
      <heading><![CDATA[Raw ]]> heading</heading>
      <item>mixed <br/> text &amp; symbols</item>
    </section>
  </body>
</envelope>