<!DOCTYPE package [
  <!ENTITY % declarations '
    <!ELEMENT package (part, checksum)>
    <!ELEMENT part (name, data)>
    <!ELEMENT name (#PCDATA)>
    <!ELEMENT data (#PCDATA)>
    <!ELEMENT checksum EMPTY>
    <!ATTLIST checksum algorithm (md5|sha1|none) "none" value CDATA #IMPLIED>
  '>
  %declarations;
  <!ENTITY q "&#34;">
]>
<package>
  <part>
    <name>payload</name>
    <data><![CDATA[one ]]]]><![CDATA[> two]]>&q;</data>
  </part>
  <checksum algorithm="sha1" value="deadbeef"/>
</package>