<?xml version="1.0"?>
<!DOCTYPE catalog [
  <!NOTATION png SYSTEM "image/png">
  <!NOTATION jpeg PUBLIC "-//IETF//NOTATION JPEG//EN" "image/jpeg">
  <!ENTITY cover SYSTEM "cover.png" NDATA png>
  <!ENTITY intro "A &amp; B &lt; C">
  <!ELEMENT catalog (entry+)>
  <!ELEMENT entry (title, description?, asset*)>
  <!ATTLIST entry
    id ID #REQUIRED
    state (new|old|archived) "new"
  >
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT description (#PCDATA|emph|link)*>
  <!ELEMENT emph (#PCDATA)>
  <!ELEMENT link EMPTY>
  <!ATTLIST link href CDATA #REQUIRED>
  <!ELEMENT asset EMPTY>
  <!ATTLIST asset source ENTITY #REQUIRED>
]>
<catalog>
  <entry id="e0" state="archived">
    <title>&intro;</title>
    <description>text <emph>with emphasis</emph> and <link href="urn:x"/>.</description>
    <asset source="cover"/>
  </entry>
</catalog>