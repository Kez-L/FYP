<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE catalog [
  <!ELEMENT catalog (section+)>
  <!ELEMENT section (title, item+)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT item (#PCDATA|em|ref)*>
  <!ELEMENT em (#PCDATA)>
  <!ELEMENT ref EMPTY>
  <!ATTLIST catalog
    generated ID #REQUIRED
    format (compact|expanded) "expanded">
  <!ATTLIST section code ID #REQUIRED>
  <!ATTLIST item
    id ID #IMPLIED
    links IDREFS #IMPLIED
    kind NMTOKEN "ordinary">
  <!ATTLIST ref target IDREF #REQUIRED>
  <!ENTITY mark "&#x2603;">
]>
<catalog generated="c0" format="compact">
  <section code="s1">
    <title>Inventory &amp; status</title>
    <item id="i1" kind="special">alpha <em>bold</em> &mark;</item>
    <item id="i2" links="i1" kind="ordinary">beta <ref target="i1"/></item>
  </section>
  <section code="s2">
    <title>References</title>
    <item links="i1 i2">gamma</item>
  </section>
</catalog>