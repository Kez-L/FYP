<?xml version="1.0"?>
<!DOCTYPE report [
  <!ELEMENT report (section*)>
  <!ELEMENT section (heading, item*)>
  <!ATTLIST section xml:lang NMTOKEN #IMPLIED>
  <!ELEMENT heading (#PCDATA)>
  <!ELEMENT item (#PCDATA|value|mark)*>
  <!ATTLIST item kind (text|number|flag) "text">
  <!ELEMENT value (#PCDATA)>
  <!ELEMENT mark EMPTY>
  <!ENTITY nbsp "&#160;">
]>
<report>
  <section xml:lang="en-US">
    <heading>Summary</heading>
    <item kind="text">A<mark/>B<value>42</value>C</item>
    <item kind="number">100&nbsp;200</item>
  </section>
  <section xml:lang="">
    <heading>Second</heading>
    <item kind="flag">yes</item>
  </section>
</report>