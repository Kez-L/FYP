<!DOCTYPE report [
  <!ENTITY % common '
    <!ELEMENT report (section*)>
    <!ELEMENT section (title, metric*)>
    <!ELEMENT title (#PCDATA)>
    <!ELEMENT metric EMPTY>
    <!ATTLIST section code NMTOKEN #REQUIRED>
    <!ATTLIST metric name CDATA #REQUIRED value CDATA #IMPLIED>
  '>
  %common;
  <![IGNORE[
    <!ELEMENT ignored ANY>
    <!ENTITY hidden "not expanded">
  ]]>
  <![INCLUDE[
    <!ENTITY visible "included">
  ]]>
]>
<report>
  <section code="A-01">
    <title>Quarter &visible;</title>
    <metric name="count" value="0042"/>
  </section>
  <section code="B_02">
    <title>Second</title>
    <metric name="ratio"/>
  </section>
</report>