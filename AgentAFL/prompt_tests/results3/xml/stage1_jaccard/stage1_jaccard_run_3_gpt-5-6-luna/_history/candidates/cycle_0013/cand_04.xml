<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE report [
  <!ELEMENT report (section+)>
  <!ELEMENT section (heading, para+)>
  <!ELEMENT heading (#PCDATA)>
  <!ELEMENT para (#PCDATA|link|break)*>
  <!ELEMENT link (#PCDATA)>
  <!ELEMENT break EMPTY>
  <!ATTLIST section id ID #REQUIRED>
  <!ATTLIST link target IDREF #IMPLIED>
  <!ENTITY quote "&#34;">
  <!ENTITY amp "&amp;">
  <!ENTITY newline "first&#x0A;second">
  <!ENTITY fragment "left&quote;mid&quote;right">
  <!ENTITY repeated "&newline; / &newline;">
]>
<report>
  <section id="intro">
    <heading>&fragment;</heading>
    <para>&repeated;<break/>tail <link target="details">read &amp; continue</link>.</para>
  </section>
  <section id="details">
    <heading>More</heading>
    <para><![CDATA[<escaped> text]]> &amp; &quote;</para>
  </section>
</report>