<?xml version="1.0"?>
<!DOCTYPE message [
  <!ELEMENT message (header, body, signature?)>
  <!ELEMENT header (from, to, subject)>
  <!ELEMENT from (#PCDATA)>
  <!ELEMENT to (#PCDATA)>
  <!ELEMENT subject (#PCDATA)>
  <!ELEMENT body (#PCDATA|quote|list|item)*>
  <!ELEMENT quote (#PCDATA|quote)*>
  <!ELEMENT list (item+)>
  <!ELEMENT item (#PCDATA|bold)*>
  <!ELEMENT bold (#PCDATA)>
  <!ELEMENT signature (#PCDATA)>
  <!ENTITY greeting "Hello, &amp; welcome">
  <!ENTITY footer "Regards&#xA;The Team">
]>
<message>
  <header>
    <from>sender@example.test</from>
    <to>receiver@example.test</to>
    <subject>&greeting;</subject>
  </header>
  <body>
    Intro
    <quote>Nested <quote>quoted text</quote> remains quoted.</quote>
    <list>
      <item><bold>First</bold> entry</item>
      <item>Second entry</item>
    </list>
    Tail &footer;
  </body>
  <signature><![CDATA[-- signed / raw <text> --]]></signature>
</message>