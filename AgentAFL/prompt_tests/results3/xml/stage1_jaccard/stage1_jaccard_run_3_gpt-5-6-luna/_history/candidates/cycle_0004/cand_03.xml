<?xml version="1.1" encoding="UTF-8"?>
<!DOCTYPE scene [
  <!ELEMENT scene (layer+)>
  <!ELEMENT layer (shape*)>
  <!ELEMENT shape EMPTY>
  <!ATTLIST layer name CDATA #REQUIRED visible (true|false) "true">
  <!ATTLIST shape
    kind CDATA #REQUIRED
    coords CDATA #IMPLIED
    transform CDATA #IMPLIED>
  <!ENTITY amp "&#38;">
]>
<scene>
  <layer name="背景" visible="false">
    <shape kind="line" coords="0,0 10,10"/>
    <shape kind="text" transform="rotate(90) translate(1 &amp; 2)"/>
  </layer>
  <layer name="foreground">
    <!-- comment with --? and unusual spacing -->
    <shape kind="path" coords="M0 0 C1 2 3 4 Z"/>
    <?render profile="fast"?>
  </layer>
</scene>