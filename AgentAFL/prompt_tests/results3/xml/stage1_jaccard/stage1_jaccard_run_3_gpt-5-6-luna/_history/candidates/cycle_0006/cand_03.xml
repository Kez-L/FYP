<?xml version="1.0"?>
<!DOCTYPE map [
  <!ELEMENT map (point*)>
  <!ELEMENT point EMPTY>
  <!ATTLIST point
    id ID #IMPLIED
    x CDATA #REQUIRED
    y CDATA #REQUIRED
    label CDATA "unset">
  <!ENTITY open "(">
  <!ENTITY close ")">
  <!ENTITY coords "&open;10,&close;">
]>
<map>
  <point id="p0" x="0" y="0" label="origin"/>
  <point id="p1" x="&coords;" y="&quot;quoted&quot;"/>
  <point x="&#x0B;" y="&#x0C;" label="control"/>
  <!-- deliberately awkward -- comment -->
  <point id="p1" x="duplicate" y="7"/>
</map>