<?xml version="1.0"?>
<!DOCTYPE archive [
  <!ELEMENT archive (entry+)>
  <!ELEMENT entry (key, value, checksum)>
  <!ATTLIST entry kind CDATA #IMPLIED>
  <!ELEMENT key (#PCDATA)>
  <!ELEMENT value (#PCDATA|part)*>
  <!ELEMENT part (#PCDATA)>
  <!ELEMENT checksum (#PCDATA)>
  <!ENTITY left "[">
  <!ENTITY right "]">
  <!ENTITY quoted "&left;payload&right;">
]>
<archive>
  <entry kind="text">
    <key>alpha</key>
    <value>before <part>middle</part> after &quoted;</value>
    <checksum><![CDATA[sha256:00000000000000000000000000000000]]></checksum>
  </entry>
  <entry kind="empty-value">
    <key>beta</key>
    <value><part><![CDATA[<nested-looking>]]></part></value>
    <checksum>&#x30;&#x31;&#x32;&#x33;</checksum>
  </entry>
</archive>