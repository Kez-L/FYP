<?xml version="1.0"?>
<!DOCTYPE report [
  <!ELEMENT report (title, body, footer?)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT body (paragraph|quote|list)*>
  <!ELEMENT paragraph (#PCDATA|em|br)*>
  <!ELEMENT quote (#PCDATA|paragraph)*>
  <!ELEMENT list (item+)>
  <!ELEMENT item (#PCDATA|em)*>
  <!ELEMENT em (#PCDATA)>
  <!ELEMENT br EMPTY>
  <!ELEMENT footer (#PCDATA)>
  <!ATTLIST report xml:lang NMTOKEN #IMPLIED>
  <!ENTITY open "<em>">
  <!ENTITY close "</em>">
  <!ENTITY nbsp "&#160;">
]>
<report xml:lang="en-US">
  <title>Entity boundaries</title>
  <body>
    <paragraph>before &open;emphasized&close; after<br/>tail&nbsp;</paragraph>
    <quote><paragraph>nested &amp; quoted</paragraph></quote>
    <list>
      <item>first</item>
      <item>second &nbsp; item</item>
    </list>
  </body>
  <footer><![CDATA[raw ]]> <![CDATA[markers & < >]]></footer>
</report>