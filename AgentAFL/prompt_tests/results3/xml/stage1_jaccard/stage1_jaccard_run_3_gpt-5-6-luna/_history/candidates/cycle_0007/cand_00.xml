<?xml version="1.0"?>
<!DOCTYPE catalog [
  <!NOTATION bin SYSTEM "application/octet-stream">
  <!ENTITY logo SYSTEM "logo.bin" NDATA bin>
  <!ENTITY amp "&#38;">
  <!ELEMENT catalog (entry+, footer?)>
  <!ELEMENT entry (title, meta*, description)>
  <!ATTLIST entry
            id ID #REQUIRED
            ref IDREF #IMPLIED
            asset ENTITY #IMPLIED>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT meta EMPTY>
  <!ATTLIST meta key NMTOKEN #REQUIRED value CDATA #IMPLIED>
  <!ELEMENT description (#PCDATA|em|br)*>
  <!ELEMENT em (#PCDATA|em|br)*>
  <!ELEMENT br EMPTY>
  <!ELEMENT footer (#PCDATA)>
]>
<catalog xmlns="urn:seed:catalog" xmlns:x="urn:seed:extra">
  <entry id="first" asset="logo">
    <title>Alpha &amp; &amp;</title>
    <meta key="priority" value="high"/>
    <description>before <em>nested <em>emphasis</em></em><br/>after</description>
  </entry>
  <entry id="second" ref="first">
    <title>x:prefixed <x:tag data="1">value</x:tag></title>
    <description>tail</description>
  </entry>
  <footer>done</footer>
</catalog>