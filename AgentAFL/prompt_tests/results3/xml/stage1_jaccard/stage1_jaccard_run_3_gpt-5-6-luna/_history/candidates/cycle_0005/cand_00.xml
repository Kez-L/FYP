<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE archive [
  <!ELEMENT archive (header, entry+)>
  <!ELEMENT header EMPTY>
  <!ATTLIST header
    xmlns:meta CDATA #FIXED "urn:example:metadata"
    meta:version CDATA #REQUIRED>
  <!ELEMENT entry (#PCDATA|tag|note)*>
  <!ATTLIST entry
    id ID #REQUIRED
    state (new|held|closed) "new"
    ref IDREF #IMPLIED>
  <!ELEMENT tag EMPTY>
  <!ATTLIST tag value CDATA #REQUIRED>
  <!ELEMENT note (#PCDATA)>
  <!ENTITY mark "&#x25; &amp; &quot; &apos;">
]>
<archive xmlns="urn:example:archive">
  <header xmlns:meta="urn:example:metadata" meta:version="&quot;1&quot;"/>
  <entry id="e1" state="held">alpha<tag value="&mark;"/>beta<note>one &amp; two</note></entry>
  <entry id="e2" ref="e1">gamma<tag value="&#x0A;"/></entry>
</archive>