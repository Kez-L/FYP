<?xml version="1.0"?>
<!DOCTYPE catalog [
  <!ELEMENT catalog (section+)>
  <!ELEMENT section (title, (record | note | record-ref)*)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT record EMPTY>
  <!ELEMENT note (#PCDATA)>
  <!ELEMENT record-ref EMPTY>
  <!ATTLIST section id ID #REQUIRED kind (open|closed) "open">
  <!ATTLIST record key ID #REQUIRED status CDATA #IMPLIED>
  <!ATTLIST record-ref target IDREF #REQUIRED>
  <!ENTITY nbsp "&#160;">
  <!ENTITY quoted "&quot;inside&quot;">
  <!NOTATION plain SYSTEM "text/plain">
]>
<catalog>
  <section id="s1" kind="closed">
    <title>Résumé &nbsp; &quoted;</title>
    <record key="r1" status="archived"/>
    <record-ref target="r1"/>
    <note>mixed <![CDATA[content]]> and &#x9; tabs</note>
  </section>
  <section id="s2">
    <title>Second</title>
    <record key="r2"/>
  </section>
</catalog>