<!DOCTYPE matrix [
  <!ELEMENT matrix (row+)>
  <!ELEMENT row (cell+)>
  <!ELEMENT cell (#PCDATA)>
  <!ATTLIST row index NMTOKEN #REQUIRED>
  <!ATTLIST cell
    colspan CDATA "1"
    role CDATA #IMPLIED>
  <!ENTITY quote "&quot;">
  <!ENTITY snowman "&#9731;">
]>
<matrix>
  <row index="0">
    <cell role="corner">&quote;A&quote;</cell>
    <cell colspan="2"><![CDATA[<not-an-element/>]]></cell>
  </row>
  <row index="1">
    <cell>1&snowman;</cell>
    <cell><![CDATA[line one
line two]]></cell>
    <cell role="last">end</cell>
  </row>
</matrix>