<?xml version="1.0" standalone="yes"?>
<!DOCTYPE message [
  <!ENTITY % declarations '
    <!ELEMENT message (from, to, subject, body)>
    <!ELEMENT from (#PCDATA)>
    <!ELEMENT to (#PCDATA)>
    <!ELEMENT subject (#PCDATA)>
    <!ELEMENT body (paragraph+)>
    <!ELEMENT paragraph (#PCDATA|quote|code)*>
    <!ELEMENT quote (#PCDATA)>
    <!ELEMENT code (#PCDATA)>
  '>
  %declarations;
  <!ENTITY openq "&#x201C;">
  <!ENTITY closeq "&#x201D;">
]>
<message>
  <from>sender@example.test</from>
  <to>receiver@example.test</to>
  <subject>Markup &amp; entities</subject>
  <body>
    <paragraph>Before <quote>&openq;quoted text&closeq;</quote> after.</paragraph>
    <paragraph><code>if (x &lt; y) return &amp;value;</code> and more.</paragraph>
  </body>
</message>