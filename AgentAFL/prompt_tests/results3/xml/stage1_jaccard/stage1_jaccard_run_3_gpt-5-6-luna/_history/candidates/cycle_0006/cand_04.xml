<?xml version="1.0"?>
<!DOCTYPE package [
  <!ELEMENT package (meta, payload)>
  <!ELEMENT meta (name, checksum)>
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT checksum (#PCDATA)>
  <!ELEMENT payload (chunk+)>
  <!ELEMENT chunk (#PCDATA | part)*>
  <!ELEMENT part EMPTY>
  <!ATTLIST chunk number NMTOKEN #REQUIRED>
  <!ATTLIST part offset CDATA #REQUIRED length CDATA #REQUIRED>
  <!ENTITY % injected '
    <!ATTLIST part encoding (raw|base64) "raw">
  '>
  %injected;
]>
<package>
  <meta>
    <name>sample</name>
    <checksum>deadbeef</checksum>
  </meta>
  <payload>
    <chunk number="1">abc<part offset="0" length="3" encoding="base64"/>def</chunk>
    <chunk number="2"><part offset="" length="-1"/>ghi</chunk>
  </payload>
</package>