<!DOCTYPE report [
  <!ENTITY % declarations '
    <!ELEMENT report (section*)>
    <!ELEMENT section (heading, item*)>
    <!ELEMENT heading (#PCDATA)>
    <!ELEMENT item (#PCDATA|value)*>
    <!ELEMENT value (#PCDATA)>
    <!ATTLIST section code CDATA #IMPLIED>
  '>
  %declarations;
  <!ENTITY open "<value>">
  <!ENTITY close "</value>">
]>
<report>
  <section code="A&amp;B">
    <heading>One</heading>
    <item>prefix &open;inside&close; suffix</item>
    <item>second</item>
  </section>
  <section>
    <heading>Two</heading>
    <item>numeric &#x41; &#65; &#x1F; </item>
  </section>
</report>