<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE catalog [
  <!ELEMENT catalog (meta, entry+)>
  <!ELEMENT meta (#PCDATA)>
  <!ELEMENT entry (title, detail, link?)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT detail (#PCDATA|em|code|br)*>
  <!ELEMENT em (#PCDATA)>
  <!ELEMENT code (#PCDATA)>
  <!ELEMENT br EMPTY>
  <!ELEMENT link EMPTY>
  <!ATTLIST catalog
    xmlns CDATA #IMPLIED
    xml:lang NMTOKEN #IMPLIED>
  <!ATTLIST entry
    id ID #REQUIRED
    status (draft|published|archived) "draft"
    xml:base URI #IMPLIED>
  <!ATTLIST link
    rel NMTOKEN #REQUIRED
    href CDATA #REQUIRED>
  <!ENTITY copyright "© 2026">
]>
<catalog xmlns="urn:example:catalog" xml:lang="en" xmlns:x="urn:example:extra">
  <?index mode="deep"?>
  <meta>Prepared &copyright; <!-- embedded comment --> &amp; indexed.</meta>
  <entry id="e1" status="published" xml:base="https://example.invalid/a/">
    <title><![CDATA[Names, namespaces, and ]]> edge cases</title>
    <detail>Text <em>x:y</em><br/><code>x &lt; y</code> and <![CDATA[ raw ]]></detail>
    <link rel="alternate" href="urn:test:one"/>
  </entry>
  <x:entry xmlns="urn:example:other" id="e2" status="archived">
    <x:title>Second vocabulary</x:title>
    <x:detail>foreign default namespace</x:detail>
  </x:entry>
</catalog>