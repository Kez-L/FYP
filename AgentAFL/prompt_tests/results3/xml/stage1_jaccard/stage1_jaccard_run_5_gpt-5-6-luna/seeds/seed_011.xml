<?xml version="1.0"?>
<!DOCTYPE package [
  <!ENTITY % mode "INCLUDE">
  <!ENTITY % declarations '
    <!ELEMENT package (header, body)>
    <!ELEMENT header (field+)>
    <!ELEMENT field (#PCDATA)>
    <!ATTLIST field name CDATA #REQUIRED>
  '>
  %declarations;
  <![%mode;[
    <!ELEMENT body (section|note|table)+>
    <!ELEMENT section (heading, para+)>
    <!ELEMENT heading (#PCDATA)>
    <!ELEMENT para (#PCDATA|b|i|br)*>
    <!ELEMENT b (#PCDATA)>
    <!ELEMENT i (#PCDATA)>
    <!ELEMENT br EMPTY>
    <!ELEMENT note (#PCDATA)>
    <!ELEMENT table (row+)>
    <!ELEMENT row (cell+)>
    <!ELEMENT cell (#PCDATA)>
  ]]>
  <!ATTLIST package revision NMTOKEN #IMPLIED>
]>
<package revision="r_0042">
  <header>
    <field name="producer">fuzz-seed</field>
    <field name="flags">A B C</field>
  </header>
  <body>
    <section>
      <heading>Conditional declarations</heading>
      <para>alpha<b>bold</b><i>italic</i><br/>omega</para>
      <para>adjacent text with &lt; and &gt; characters</para>
    </section>
    <note>note before the table</note>
    <table>
      <row><cell>1</cell><cell>one</cell></row>
      <row><cell>2</cell><cell>two</cell><cell>extra</cell></row>
    </table>
  </body>
</package>