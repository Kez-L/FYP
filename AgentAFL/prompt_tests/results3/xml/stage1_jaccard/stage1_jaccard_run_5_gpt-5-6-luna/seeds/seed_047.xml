<!DOCTYPE outer [
  <!ENTITY % switch "INCLUDE">
  <![%switch;[
    <!ELEMENT outer (inner, tail?)>
    <!ELEMENT inner (#PCDATA)>
    <!ELEMENT tail EMPTY>
    <!ATTLIST inner kind CDATA #IMPLIED>
  ]]>
  <![IGNORE[
    <!ELEMENT ignored (nothing)>
    <!ENTITY gone "not-expanded">
  ]]>
  <!ENTITY quote "A &quot; B &apos; C">
]>
<outer>
  <inner kind="&quot;odd&quot;">&quote;</inner>
  <tail></tail>
</outer>