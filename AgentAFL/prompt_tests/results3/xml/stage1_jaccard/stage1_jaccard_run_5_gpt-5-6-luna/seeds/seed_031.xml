<?xml version="1.0"?>
<!DOCTYPE universe [
  <!ELEMENT universe (zone|empty|zone)*>
  <!ELEMENT zone ANY>
  <!ELEMENT empty EMPTY>
  <!ATTLIST universe
    xmlns:astro CDATA #FIXED "urn:example:astronomy"
    xml:space (default|preserve) "preserve">
  <!ATTLIST zone
    astro:id ID #REQUIRED
    astro:class CDATA #IMPLIED>
  <!ENTITY left "&#x3C;">
  <!ENTITY right "&#x3E;">
]>
<universe xmlns="urn:example:universe"
          xmlns:astro="urn:example:astronomy"
          xml:space="preserve">
  <zone astro:id="z-1" astro:class="&quot;outer&quot;">
    text &left;inside&right;
    <astro:orbit xmlns:astro="urn:example:orbit" astro:period="42"/>
    <empty/>
  </zone>
  <zone astro:id="z-2" xmlns="">
    <local:point xmlns:local="urn:example:points" local:x="0" local:y="1"/>
  </zone>
</universe>