<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE telemetry [
  <!NOTATION bin SYSTEM "application/octet-stream">
  <!ENTITY payload SYSTEM "data.bin" NDATA bin>
  <!ELEMENT telemetry (sample*, summary)>
  <!ELEMENT sample (time, reading, annotation?)>
  <!ELEMENT time (#PCDATA)>
  <!ELEMENT reading (#PCDATA)>
  <!ELEMENT annotation (#PCDATA)>
  <!ELEMENT summary (#PCDATA)>
  <!ATTLIST sample key ID #REQUIRED unit (C|F|K) "C" source CDATA #IMPLIED>
  <!ATTLIST annotation xml:space (default|preserve) "preserve">
  <!ENTITY degree "&#xB0;">
  <!ENTITY city "München">
]>
<telemetry xml:lang="de">
  <sample key="s-alpha" unit="C" source="sensor-α">
    <time>2026-10-01T12:00:00Z</time>
    <reading>21&degree; &city;</reading>
    <annotation xml:space="preserve">  spaced&#xA;value  </annotation>
  </sample>
  <sample key="s-beta" unit="K">
    <time>2026-10-01T12:01:00Z</time>
    <reading>294.15</reading>
  </sample>
  <summary><![CDATA[Samples: 2; status=<ok>]]></summary>
</telemetry>