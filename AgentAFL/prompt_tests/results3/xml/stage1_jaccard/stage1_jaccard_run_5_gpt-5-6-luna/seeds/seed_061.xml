<?xml version="1.0"?>
<!DOCTYPE envelope [
  <!ELEMENT envelope (meta, payload)>
  <!ELEMENT meta EMPTY>
  <!ELEMENT payload (#PCDATA|part)*>
  <!ELEMENT part (#PCDATA|part)*>
  <!ATTLIST meta stamp CDATA #IMPLIED>
  <!ATTLIST part level NMTOKEN #IMPLIED>
  <!ENTITY left "[">
  <!ENTITY right "]">
  <!ENTITY wrapped "&left;inside&right;">
]>
<envelope>
  <meta stamp="&#x0A;&#x09;encoded&#x20;value"/>
  <payload>
    prefix &wrapped;
    <part level="0"><part level="1"><part level="2"><![CDATA[ raw ]]>tail</part></part>
    suffix &unknown;
  </payload>
</envelope>