<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE archive [
  <!ELEMENT archive (directory, footer)>
  <!ELEMENT directory (folder|file|alias)*>
  <!ELEMENT folder (folder|file|alias)*>
  <!ELEMENT file EMPTY>
  <!ELEMENT alias EMPTY>
  <!ELEMENT footer (#PCDATA)>
  <!ATTLIST directory version CDATA #REQUIRED>
  <!ATTLIST folder name CDATA #REQUIRED open (true|false) "true">
  <!ATTLIST file
    name CDATA #REQUIRED
    mode NMTOKENS #IMPLIED
    checksum CDATA #IMPLIED>
  <!ATTLIST alias
    name CDATA #REQUIRED
    destination IDREF #REQUIRED>
  <!ENTITY qmark "?">
  <!ENTITY path "root/&qmark;/leaf">
]>
<archive>
  <?archive generated="false"?>
  <directory version="2.0">
    <folder name="root" open="true">
      <file name="readme.txt" mode="u+r u-w" checksum="sha256:00"/>
      <folder name="data">
        <file name="résumé.txt" mode="0644"/>
        <alias name="latest" destination="missing-id"/>
      </folder>
      <folder name="empty" open="false"></folder>
    </folder>
    <file name="loose&amp;file" mode="a b c"/>
  </directory>
  <footer><![CDATA[archive path: ]]>&path;<!-- trailing --> </footer>
</archive>