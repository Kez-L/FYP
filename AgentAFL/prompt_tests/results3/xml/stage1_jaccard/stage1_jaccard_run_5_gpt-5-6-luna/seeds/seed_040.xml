<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="view.xsl"?>
<!DOCTYPE catalog [
  <!ELEMENT catalog (entry+)>
  <!ELEMENT entry (title, meta?, description, tags?)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT meta EMPTY>
  <!ELEMENT description (#PCDATA|em|code|br)*>
  <!ELEMENT em (#PCDATA)>
  <!ELEMENT code (#PCDATA)>
  <!ELEMENT br EMPTY>
  <!ELEMENT tags (tag*)>
  <!ELEMENT tag (#PCDATA)>
  <!ATTLIST catalog xmlns CDATA #IMPLIED>
  <!ATTLIST entry id ID #REQUIRED status (new|old|archived) "new">
  <!ATTLIST meta created CDATA #IMPLIED revised CDATA #IMPLIED>
]>
<catalog xmlns="urn:example:catalog" xmlns:x="urn:example:extra">
  <entry id="e-1" status="archived">
    <title>Namespaced &amp; mixed content</title>
    <meta created="2024-02-29" revised="2026-10-01"/>
    <description><![CDATA[before <literal>]]><em>emphasis</em><code>x &lt; y</code><br/>after</description>
    <tags><tag>x</tag><tag>unicode-π</tag></tags>
  </entry>
  <entry id="e-2"><title>x:prefixed</title><description><x:note x:kind="hint">hello</x:note></description></entry>
</catalog>