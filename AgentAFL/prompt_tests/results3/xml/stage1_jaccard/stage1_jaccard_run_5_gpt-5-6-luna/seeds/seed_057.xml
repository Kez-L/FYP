<?xml version="1.0" standalone="yes"?>
<!DOCTYPE universe [
  <!ELEMENT universe (cluster*)>
  <!ELEMENT cluster (object|void|cluster)*>
  <!ELEMENT object (#PCDATA)>
  <!ELEMENT void EMPTY>
  <!ATTLIST cluster
    label CDATA #IMPLIED
    xmlns:loc CDATA #IMPLIED>
  <!ATTLIST object
    key ID #IMPLIED
    class (α|β|γ) "α"
    xml:space (default|preserve) "default">
  <!ATTLIST void marker CDATA #FIXED "∅">
  <!ENTITY snow "☃">
  <!ENTITY math "∑ &lt; ∞">
]>
<universe xmlns="urn:cosmos">
  <cluster label="outer" xmlns:loc="urn:locale">
    <object key="o1" class="β" xml:space="preserve">
      Line one&#x0A;Line two &snow; &math;
    </object>
    <cluster label="nested">
      <void marker="∅"/>
      <object class="γ"><![CDATA[
        whitespace
        and ]]> delimiter text
      </object>
    </cluster>
  </cluster>
  <cluster xmlns="">
    <object key="o2">unqualified object</object>
  </cluster>
</universe>