<?xml version="1.0"?>
<!DOCTYPE map [
  <!ELEMENT map (layer, layer, overlay?)>
  <!ELEMENT layer (tile*)>
  <!ELEMENT tile EMPTY>
  <!ELEMENT overlay (polygon|point|path)+>
  <!ELEMENT polygon EMPTY>
  <!ELEMENT point EMPTY>
  <!ELEMENT path EMPTY>
  <!ATTLIST map xmlns CDATA #IMPLIED>
  <!ATTLIST layer
    id ID #REQUIRED
    visible (true|false) "true"
    opacity NMTOKEN "1">
  <!ATTLIST tile
    x NMTOKEN #REQUIRED
    y NMTOKEN #REQUIRED
    src CDATA #REQUIRED>
  <!ATTLIST polygon points CDATA #REQUIRED fill CDATA #IMPLIED>
  <!ATTLIST point x CDATA #REQUIRED y CDATA #REQUIRED>
  <!ATTLIST path d CDATA #REQUIRED>
]>
<map xmlns="urn:geo:map" xmlns:g="urn:geo:meta" g:version="0.4">
  <layer id="base" opacity="0.75">
    <tile x="0" y="0" src="tiles/0/0/0.png"/>
    <tile x="1" y="0" src="tiles/0/1/0.png"/>
    <tile x="0" y="1" src="tiles/0/0/1.png"/>
  </layer>
  <layer id="roads" visible="false" opacity="0">
    <tile x="0" y="0" src="roads&amp;old.png"/>
  </layer>
  <overlay>
    <polygon points="0,0 10,0 10,10 0,10" fill="#00ff80"/>
    <point x="-0.0001" y="+42"/>
    <path d="M0 0 C1.5 2.5 3 4 8 13"/>
  </overlay>
</map>