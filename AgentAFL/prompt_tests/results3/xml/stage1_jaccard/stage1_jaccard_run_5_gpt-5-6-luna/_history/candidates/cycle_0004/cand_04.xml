<!DOCTYPE dashboard [
  <!ELEMENT dashboard (header, widget+, footer?)>
  <!ELEMENT header (title, generated)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT generated (#PCDATA)>
  <!ELEMENT widget (label, value, detail*)>
  <!ELEMENT label (#PCDATA)>
  <!ELEMENT value (#PCDATA)>
  <!ELEMENT detail (#PCDATA)>
  <!ELEMENT footer (#PCDATA)>
  <!ATTLIST widget kind NMTOKEN #REQUIRED priority NMTOKEN "normal">
]>
<dashboard>
  <header>
    <title>Runtime status</title>
    <generated>2026-10-01T00:00:00Z</generated>
  </header>
  <widget kind="gauge" priority="high">
    <label>Memory</label>
    <value>42%</value>
    <detail>steady</detail>
    <detail>sample-count=0</detail>
  </widget>
  <widget kind="sparkline">
    <label>Load</label>
    <value>0,1,0,1,0</value>
  </widget>
  <footer>End of report.</footer>
</dashboard>