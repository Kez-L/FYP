<?xml version="1.0"?>
<!DOCTYPE root [
  <!ELEMENT root (a|b|c)*>
  <!ELEMENT a EMPTY>
  <!ELEMENT b (#PCDATA|a)*>
  <!ELEMENT c ANY>
  <!ATTLIST root mode (one|two|three) "two" ref IDREFS #IMPLIED>
  <!ATTLIST a n NMTOKEN #REQUIRED>
  <!ENTITY nbsp "&#160;">
  <!ENTITY nested "&nbsp;&amp;&lt;&quot;&apos;">
  <!ENTITY % declarations "<!ELEMENT injected (#PCDATA)>">
  %declarations;
]>
<root mode="three" ref="x y">
  <a n="x"/>
  <b>left &nested; <a n="y"/> right</b>
  <c><![CDATA[<a n="z"/>]]></c>
  <injected>late declaration use</injected>
</root>