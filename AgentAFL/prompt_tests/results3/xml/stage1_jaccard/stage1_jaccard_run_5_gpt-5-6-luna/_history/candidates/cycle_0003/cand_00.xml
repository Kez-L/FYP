<?xml version="1.0"?>
<!DOCTYPE catalog [
  <!ELEMENT catalog (meta, entry+)>
  <!ELEMENT meta EMPTY>
  <!ATTLIST meta
    xml:lang CDATA #IMPLIED
    generated CDATA #REQUIRED>
  <!ELEMENT entry (title, creator+, description?, link*)>
  <!ATTLIST entry
    id ID #REQUIRED
    status (draft|published|archived) "draft"
    related IDREFS #IMPLIED>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT creator (#PCDATA)>
  <!ELEMENT description (#PCDATA|em|code)*>
  <!ELEMENT em (#PCDATA)>
  <!ELEMENT code (#PCDATA)>
  <!ELEMENT link EMPTY>
  <!ATTLIST link
    rel CDATA #REQUIRED
    href URI #REQUIRED>
]>
