<?xml version="1.0"?>
<!DOCTYPE switches [
  <!ELEMENT switches (mode, item*)>
  <!ELEMENT mode (#PCDATA)>
  <!ELEMENT item (key, value?)>
  <!ELEMENT key (#PCDATA)>
  <!ELEMENT value (#PCDATA)>
  <!ATTLIST item enabled (yes|no) "yes">
  <!ENTITY open "<![CDATA[">
  <!ENTITY close "]]>">
  <!ENTITY amp "&#38;">
]>
<switches>
  <mode>test</mode>
  <item enabled="no">
    <key>empty</key>
  </item>
  <item enabled="yes">
    <key>entities</key>
    <value>&open;hidden &amp; literal&close;</value>
  </item>
  <item>
    <key>numeric</key>
    <value>&#0; &#x1; &#x7F; &amp; &lt; &gt;</value>
  </item>
</switches>