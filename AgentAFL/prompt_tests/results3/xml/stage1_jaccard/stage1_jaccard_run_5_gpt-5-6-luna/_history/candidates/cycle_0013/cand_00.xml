<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE catalog [
  <!ELEMENT catalog (section+)>
  <!ELEMENT section (title, item*)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT item (#PCDATA|em|br)*>
  <!ELEMENT em (#PCDATA|em|br)*>
  <!ELEMENT br EMPTY>
  <!ATTLIST section xml:lang NMTOKEN #IMPLIED>
  <!ATTLIST item id ID #REQUIRED priority (low|normal|high) "normal">
  <!ENTITY mark "&#x2605;">
]>
<catalog xmlns="urn:example:catalog" xmlns:x="urn:example:extra">
  <!-- mixed content with namespaces and entity replacement -->
  <section xml:lang="en-US">
    <title>Examples &amp; &mark;</title>
    <item id="i-1" priority="high">alpha <em>beta <em>gamma</em></em><br/>delta</item>
    <item id="i-2" x:flag="yes"><![CDATA[<literal> & not markup ]]></item>
    <?catalog instruction="one &amp; two"?>
  </section>
</catalog>