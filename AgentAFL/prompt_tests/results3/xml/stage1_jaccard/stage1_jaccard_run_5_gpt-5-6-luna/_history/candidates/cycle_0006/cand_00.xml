<?xml version="1.0"?>
<!DOCTYPE catalog [
  <!ELEMENT catalog (entry+)>
  <!ELEMENT entry (label, description, meta?)>
  <!ELEMENT label (#PCDATA)>
  <!ELEMENT description (#PCDATA|em|ref)*>
  <!ELEMENT em (#PCDATA)>
  <!ELEMENT ref EMPTY>
  <!ELEMENT meta (author?, tag*)>
  <!ELEMENT author (#PCDATA)>
  <!ELEMENT tag (#PCDATA)>
  <!ATTLIST entry id ID #REQUIRED status (draft|live|archived) "draft">
  <!ATTLIST ref target IDREF #REQUIRED>
  <!ENTITY company "A &amp; B Research">
  <!ENTITY mark "&#x2605;">
]>
<catalog xmlns="urn:example:catalog" xml:lang="en">
  <entry id="e1" status="live">
    <label>&company; &mark;</label>
    <description>Text with <em>mixed</em> content and a <ref target="e2"/> cross-link.</description>
    <meta>
      <author>North &amp; South</author>
      <tag>unicode</tag>
      <tag>references</tag>
    </meta>
  </entry>
  <entry id="e2">
    <label>Second entry</label>
    <description><![CDATA[Literal <markup> and ]] characters]]></description>
  </entry>
</catalog>