<?xml version="1.0"?>
<!DOCTYPE report [
  <!ENTITY % common
    "<!ATTLIST report category (daily|weekly|adhoc) 'daily'
                       revision CDATA #IMPLIED>">
  %common;
  <!ENTITY % fields
    "<!ELEMENT report (header, section+, footer?)>
     <!ELEMENT header (#PCDATA)>
     <!ELEMENT section (heading, field*)>
     <!ELEMENT heading (#PCDATA)>
     <!ELEMENT field (#PCDATA|value)*>
     <!ELEMENT value (#PCDATA)>
     <!ELEMENT footer (#PCDATA)>
     <!ATTLIST section name CDATA #REQUIRED>
     <!ATTLIST field key CDATA #REQUIRED>">
  %fields;
  <!ENTITY nl "&#xA;">
  <!ENTITY quoted "&quot;quoted&quot;">
]>
<report category="adhoc" revision="r&amp;7">
  <header>Generated&nl;header: &quoted;</header>
  <section name="alpha">
    <heading>First section</heading>
    <field key="x">plain <value>42</value> after</field>
    <field key="y"><![CDATA[value with <tags> and ]] characters]]></field>
  </section>
  <section name="beta">
    <heading>Second &lt;section&gt;</heading>
    <field key="z"><value>one</value><value>two</value></field>
  </section>
  <footer>done</footer>
</report>