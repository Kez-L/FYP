<?xml version="1.0"?>
<!DOCTYPE report [
  <!ENTITY % common "title | data | note">
  <!ELEMENT report (header, section+)>
  <!ELEMENT header (%common;)>
  <!ELEMENT section (name, (%common;)*, section?)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT data (#PCDATA)>
  <!ELEMENT note (#PCDATA)>
  <!ELEMENT name (#PCDATA)>
]>
<report>
  <header>
    <title>Nested declaration test</title>
    <data><![CDATA[<x>&y;</x>]]></data>
    <note>alpha</note>
  </header>
  <section>
    <name>outer</name>
    <data>one</data>
    <section>
      <name>inner</name>
      <note>two &lt; three</note>
    </section>
  </section>
</report>