<?xml version="1.0"?>
<!DOCTYPE report [
  <!ELEMENT report (section+)>
  <!ELEMENT section (heading, item*)>
  <!ELEMENT heading (#PCDATA)>
  <!ELEMENT item (#PCDATA|link)*>
  <!ELEMENT link (#PCDATA)>
  <!ATTLIST section id ID #IMPLIED>
  <!ENTITY % optional '
    <!ELEMENT appendix (item*)>
    <!ELEMENT item (#PCDATA|link)*>
  '>
  %optional;
  <!ENTITY left "[" >
  <!ENTITY right "]" >
  <![IGNORE[
    <!ELEMENT never-used (ghost*)>
    <!ENTITY hidden "discarded">
  ]]>
]>
<report>
  <section id="main">
    <heading>&left;Overview&right;</heading>
    <item>alpha<link>https://example.test/a?x=1&amp;y=2</link></item>
    <item><![CDATA[raw ]]> text</item>
  </section>
  <section>
    <heading>Second</heading>
    <item>one<link>two</link>three<link>four</link></item>
  </section>
</report>