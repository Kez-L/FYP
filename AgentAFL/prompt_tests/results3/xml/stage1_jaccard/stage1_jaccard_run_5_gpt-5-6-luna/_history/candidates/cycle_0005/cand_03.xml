<?xml version="1.0"?>
<!DOCTYPE vault [
  <!NOTATION bin SYSTEM "application/octet-stream">
  <!ENTITY logo SYSTEM "logo.bin" NDATA bin>
  <!ELEMENT vault (record*)>
  <!ELEMENT record (label, value)>
  <!ELEMENT label (#PCDATA)>
  <!ELEMENT value (#PCDATA|link)*>
  <!ELEMENT link EMPTY>
  <!ATTLIST record key ID #IMPLIED>
  <!ATTLIST link href CDATA #REQUIRED>
  <!ATTLIST vault icon ENTITY #IMPLIED>
]>
<vault icon="logo">
  <record key="r1">
    <label>external notation</label>
    <value>prefix<link href="urn:x"/>suffix</value>
  </record>
  <record>
    <label>quotes &quot; apostrophe &apos;</label>
    <value><![CDATA[<& not markup]]></value>
  </record>
</vault>