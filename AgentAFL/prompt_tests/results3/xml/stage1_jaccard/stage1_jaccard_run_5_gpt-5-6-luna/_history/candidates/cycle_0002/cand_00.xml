<?xml version="1.0"?>
<!DOCTYPE report [
  <!ENTITY base "alpha">
  <!ENTITY suffix "omega">
  <!ENTITY combined "&base;:&suffix;">
  <!ENTITY % attrs '<!ATTLIST section mode (cold|warm|hot) "warm" stamp CDATA #IMPLIED>'>
  %attrs;
  <!ELEMENT report (section+, payload?)>
  <!ELEMENT section (#PCDATA)>
  <!ELEMENT payload (#PCDATA)>
]>
<report>
  <section stamp="&combined;">&base; &#x20; &suffix;</section>
  <section mode="hot">before<![CDATA[<&unexpanded;]]>after</section>
  <payload>&combined;</payload>
</report>