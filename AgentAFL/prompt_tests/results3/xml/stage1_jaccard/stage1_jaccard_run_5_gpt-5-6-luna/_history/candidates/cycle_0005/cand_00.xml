<?xml version="1.0"?>
<!DOCTYPE catalog [
  <!ELEMENT catalog (entry+)>
  <!ELEMENT entry (title, price?, details)>
  <!ATTLIST entry id ID #REQUIRED status (new|used|archived) "new">
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT price (#PCDATA)>
  <!ELEMENT details (#PCDATA|em|ref)*>
  <!ELEMENT em (#PCDATA)>
  <!ELEMENT ref EMPTY>
  <!ATTLIST ref target IDREF #IMPLIED>
]>
<catalog>
  <entry id="item-1" status="used">
    <title>Odd &amp; Unusual</title>
    <price>0.00</price>
    <details>before <em>emphasis</em> after <ref target="item-1"/></details>
  </entry>
  <entry id="item-2">
    <title>Second</title>
    <details>mixed text <![CDATA[ ]]> tail</details>
  </entry>
</catalog>