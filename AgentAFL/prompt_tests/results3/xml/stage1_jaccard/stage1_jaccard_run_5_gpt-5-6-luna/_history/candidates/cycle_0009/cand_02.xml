<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE measurements [
  <!ELEMENT measurements (sample*)>
  <!ELEMENT sample (value, value?, note?)>
  <!ELEMENT value (#PCDATA)>
  <!ELEMENT note (#PCDATA)>
  <!ATTLIST sample key NMTOKEN #REQUIRED unit CDATA #IMPLIED>
  <!ENTITY deg "&#x00B0;">
  <!ENTITY euro "&#x20AC;">
  <!ENTITY nbsp "&#160;">
]>
<measurements>
  <sample key="A_01" unit="°C">
    <value>+000.0001&nbsp;</value>
    <value>-INF</value>
    <note>temperature &lt; limit &amp; rising</note>
  </sample>
  <sample key="B.02" unit="m/s">
    <value>3.141592653589793</value>
    <note>cost: &euro;42 &deg;</note>
  </sample>
  <sample key="C-03">
    <value>&#x1F600; &#x03B1; &#x4E2D;</value>
  </sample>
</measurements>