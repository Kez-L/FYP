<?xml version="1.0"?>
<!DOCTYPE inventory [
  <!ELEMENT inventory (warehouse+)>
  <!ELEMENT warehouse (bin+)>
  <!ATTLIST warehouse code NMTOKEN #REQUIRED>
  <!ELEMENT bin (item*)>
  <!ATTLIST bin label CDATA #IMPLIED>
  <!ELEMENT item (name, quantity, note?)>
  <!ATTLIST item sku ID #REQUIRED fragile (yes|no) "no">
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT quantity (#PCDATA)>
  <!ELEMENT note (#PCDATA)>
]>
<inventory>
  <warehouse code="A-01">
    <bin label="upper">
      <item sku="sku-100" fragile="yes">
        <name>Glass vial</name>
        <quantity>4</quantity>
        <note>Handle carefully</note>
      </item>
      <item sku="sku-101">
        <name>Paper seal</name>
        <quantity>28</quantity>
      </item>
    </bin>
  </warehouse>
  <warehouse code="B-02">
    <bin/>
  </warehouse>
</inventory>