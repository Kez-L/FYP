<?xml version="1.1" encoding="UTF-8"?>
<!DOCTYPE archive [
  <!ELEMENT archive (folder*)>
  <!ELEMENT folder (folder|file)*>
  <!ATTLIST folder name CDATA #REQUIRED>
  <!ELEMENT file EMPTY>
  <!ATTLIST file name CDATA #REQUIRED size NMTOKEN #IMPLIED>
]>
<archive>
  <folder name="root">
    <file name="manifest.json" size="128"/>
    <folder name="assets">
      <file name="icon.svg" size="2048"/>
      <folder name="nested">
        <file name="data.bin" size="65536"/>
      </folder>
    </folder>
  </folder>
</archive>