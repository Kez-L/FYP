  <!ELEMENT headline (#PCDATA)>
  <!ELEMENT body (#PCDATA|note|br)*>
  <!ELEMENT note (#PCDATA)>
  <!ELEMENT br EMPTY>
  <!ELEMENT link EMPTY>
  <!ATTLIST link rel CDATA #REQUIRED target IDREF #IMPLIED>
  <!ENTITY company "Northstar &amp; Co.">
]>
