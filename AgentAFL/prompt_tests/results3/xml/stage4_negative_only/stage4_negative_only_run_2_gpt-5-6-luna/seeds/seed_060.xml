<?xml version="1.0"?>
<!DOCTYPE archive [
  <!ELEMENT archive (record+)>
  <!ELEMENT record (title,body,tag*)>
  <!ATTLIST record code ID #REQUIRED>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT body (#PCDATA|note)*>
  <!ELEMENT note (#PCDATA)>
  <!ELEMENT tag EMPTY>
  <!ATTLIST tag name CDATA #REQUIRED>
  <!ENTITY greeting "Catalogued entry">
]>
<archive>
  <record code="r-001">
    <title>&greeting;: winter glass</title>
    <body>
      The pane reflected <note>three lamps</note> before dawn.
      <note>Measured at 04:17.</note>
    </body>
    <tag name="observed"/>
  </record>
</archive>