<?xml version="1.0"?>
<!DOCTYPE archive [
  <!ELEMENT archive (record+)>
  <!ELEMENT record (date, payload, checksum?)>
  <!ATTLIST record key ID #REQUIRED state (new|held|closed) "new">
  <!ELEMENT date (#PCDATA)>
  <!ELEMENT payload (#PCDATA)>
  <!ELEMENT checksum (#PCDATA)>
  <!ENTITY note "archival fragment">
]>
<archive>
  <record key="r17" state="held">
    <date>2026-09-24</date>
    <payload>First &note; with &#x1F4E6; marker.</payload>
    <checksum><![CDATA[sha256:0000abcd]]></checksum>
  </record>
  <record key="r18">
    <date>2026-10-01</date>
    <payload>Second record &amp; retained.</payload>
  </record>
</archive>