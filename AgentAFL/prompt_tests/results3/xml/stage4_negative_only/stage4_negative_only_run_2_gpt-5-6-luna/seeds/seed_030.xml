<?xml version="1.0"?>
<!DOCTYPE archive [
  <!ELEMENT archive (record+)>
  <!ELEMENT record (title, payload)>
  <!ATTLIST record id ID #REQUIRED kind (text|binary) "text">
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT payload (#PCDATA|chunk)*>
  <!ELEMENT chunk (#PCDATA)>
  <!ENTITY separator " :: ">
  <!ENTITY notice "internal entity content">
]>
<archive>
  <record id="r1" kind="text">
    <title>First &separator; Entry</title>
    <payload>alpha<chunk>one</chunk>beta<chunk>&notice;</chunk>gamma</payload>
  </record>
  <record id="r2">
    <title>Second Entry</title>
    <payload><![CDATA[x < y && y < z]]></payload>
  </record>
</archive>