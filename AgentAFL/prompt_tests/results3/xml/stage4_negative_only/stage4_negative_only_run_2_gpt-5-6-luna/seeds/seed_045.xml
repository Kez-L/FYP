<?xml version="1.0"?>
<!DOCTYPE catalog [
  <!ELEMENT catalog (metadata, product*)>
  <!ELEMENT metadata (title, generated)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT generated EMPTY>
  <!ELEMENT product (name, price, tags?, note?)>
  <!ATTLIST product sku ID #REQUIRED status (active|archived) "active">
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT price (#PCDATA)>
  <!ELEMENT tags (tag+)>
  <!ELEMENT tag (#PCDATA)>
  <!ELEMENT note (#PCDATA)>
]>
<catalog>
  <metadata>
    <title>Winter inventory</title>
    <generated/>
  </metadata>
  <product sku="p-001">
    <name>Thermal flask</name>
    <price currency="EUR">19.95</price>
    <tags>
      <tag>steel</tag>
      <tag>insulated</tag>
    </tags>
    <note>Keep upright &amp; dry.</note>
  </product>
  <product sku="p-002" status="archived">
    <name>Foldable cup</name>
    <price currency="JPY">700</price>
  </product>
</catalog>