  <!ATTLIST entry kind CDATA #IMPLIED>
  <!ELEMENT date (#PCDATA)>
  <!ELEMENT amount (#PCDATA)>
  <!ELEMENT description (#PCDATA|ref)*>
  <!ELEMENT ref EMPTY>
  <!ATTLIST ref target IDREF #REQUIRED>
  <!ATTLIST account alias ID #IMPLIED>
]>
