<?xml version="1.0"?>
<!DOCTYPE message [
  <!ELEMENT message (sender, recipient, body)>
  <!ELEMENT sender (#PCDATA)>
  <!ELEMENT recipient (#PCDATA)>
  <!ELEMENT body (#PCDATA)>
  <!ENTITY greeting "Welcome &amp; good morning">
]>
<message>
  <sender>system</sender>
  <recipient>operator</recipient>
  <body>&greeting;, your report is ready.</body>
</message>