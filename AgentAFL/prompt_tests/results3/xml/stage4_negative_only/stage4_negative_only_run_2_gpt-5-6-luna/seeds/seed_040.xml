<?xml version="1.0"?>
<!DOCTYPE catalog [
  <!ELEMENT catalog (item+)>
  <!ELEMENT item (name, price, note?)>
  <!ATTLIST item sku ID #REQUIRED status (active|archived) "active">
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT price (#PCDATA)>
  <!ELEMENT note (#PCDATA)>
  <!ENTITY currency "€">
  <!ENTITY clearance "limited availability">
]>
<catalog>
  <item sku="a17" status="active">
    <name>Thermal mug</name>
    <price>19.95 &currency;</price>
    <note>&clearance;</note>
  </item>
  <item sku="b42">
    <name>Foldable lamp</name>
    <price>31.00 &currency;</price>
  </item>
</catalog>