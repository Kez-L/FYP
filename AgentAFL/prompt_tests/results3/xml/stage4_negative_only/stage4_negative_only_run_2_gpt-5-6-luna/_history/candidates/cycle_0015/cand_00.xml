<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE archive [
  <!ELEMENT archive (title,record+)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT record (heading,body,meta?)>
  <!ATTLIST record id ID #REQUIRED status (open|closed|pending) "open">
  <!ELEMENT heading (#PCDATA)>
  <!ELEMENT body (#PCDATA|quote|br)*>
  <!ELEMENT quote (#PCDATA)>
  <!ELEMENT br EMPTY>
  <!ELEMENT meta EMPTY>
  <!ATTLIST meta source CDATA #IMPLIED>
  <!ENTITY notice "confidential &amp; provisional">
]>
<archive>
  <title xml:lang="en">Field Notes</title>
  <record id="r-01" status="pending">
    <heading>First entry</heading>
    <body>Wind crossed the ridge<quote>without warning</quote><br/>and stopped.</body>
    <meta source="sensor-A"/>
  </record>
  <record id="r-02">
    <heading>Second entry</heading>
    <body>&notice;: <quote>check again</quote>.</body>
  </record>
</archive>