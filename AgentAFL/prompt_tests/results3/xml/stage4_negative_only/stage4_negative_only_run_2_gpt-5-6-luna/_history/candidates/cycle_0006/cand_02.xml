<?xml version="1.0"?>
<!DOCTYPE message [
  <!ELEMENT message (header, body, attachment*)>
  <!ELEMENT header (from, to, subject)>
  <!ELEMENT from (#PCDATA)>
  <!ELEMENT to (#PCDATA)>
  <!ELEMENT subject (#PCDATA)>
  <!ELEMENT body (#PCDATA|quote|br)*>
  <!ELEMENT quote (#PCDATA)>
  <!ELEMENT br EMPTY>
  <!ELEMENT attachment (#PCDATA)>
]>
<message>
  <header>
    <from>alpha@example.test</from>
    <to>beta@example.test</to>
    <subject>Re: status</subject>
  </header>
  <body>Hello <quote>quoted text</quote><br/>Continuation.</body>
  <attachment media-type="text/plain">inline-note</attachment>
</message>