<?xml version="1.0"?>
<?processing mode="archive"?>
<configuration>
  <!-- Values are intentionally represented in different forms. -->
  <paths>
    <path kind="input">/var/tmp/incoming</path>
    <path kind="output">/var/tmp/results</path>
  </paths>
  <flags>
    <enabled>true</enabled>
    <retries>0</retries>
    <features>
      <feature name="compression"/>
      <feature name="signing" required="false"/>
    </features>
  </flags>
  <?checkpoint id="before-close"?>
</configuration>