<?xml version="1.0"?>
<!DOCTYPE report [
  <!ELEMENT report (header, section*)>
  <!ELEMENT header EMPTY>
  <!ATTLIST header generated CDATA #IMPLIED>
  <!ELEMENT section (title, value?, section*)>
  <!ATTLIST section name CDATA #REQUIRED>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT value (#PCDATA)>
]>
<report>
  <header generated="true"/>
  <section name="outer">
    <title>Root metric</title>
    <value>42</value>
    <section name="empty">
      <title></title>
    </section>
    <section name="nested">
      <title>Whitespace</title>
      <value>
        
      </value>
      <section name="leaf">
        <title>Done</title>
      </section>
    </section>
  </section>
</report>