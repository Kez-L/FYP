<?xml version="1.0"?>
<!DOCTYPE archive [
  <!ELEMENT archive (record+)>
  <!ELEMENT record (title,body)>
  <!ATTLIST record id ID #REQUIRED ref IDREF #IMPLIED>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT body (#PCDATA|link)*>
  <!ELEMENT link (#PCDATA)>
  <!ATTLIST link href CDATA #REQUIRED>
  <!ENTITY company "A &amp; B">
]>
<archive>
  <record id="r1">
    <title>Quarterly &company; report</title>
    <body>See <link href="urn:report:summary">the summary</link> before approval.</body>
  </record>
  <record id="r2" ref="r1">
    <title>Follow-up</title>
    <body>Reviewed by <link href="#r1">the first record</link>.</body>
  </record>
</archive>