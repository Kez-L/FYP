<?xml version="1.1"?>
<!DOCTYPE registry [
  <!ELEMENT registry (service*, disabled?)>
  <!ELEMENT service (endpoint+, credential?)>
  <!ATTLIST service name NMTOKEN #REQUIRED version CDATA #IMPLIED>
  <!ELEMENT endpoint EMPTY>
  <!ATTLIST endpoint method (GET|POST|PUT|DELETE) "GET" path CDATA #REQUIRED>
  <!ELEMENT credential (#PCDATA)>
  <!ELEMENT disabled (#PCDATA)>
]>
<registry xmlns="urn:services">
  <service name="search.api" version="2.0">
    <endpoint method="GET" path="/find?q=a%20b"/>
    <endpoint method="POST" path="/reindex"/>
    <credential>token:&#x85;masked</credential>
  </service>
  <service name="metrics">
    <endpoint path="/health"/>
  </service>
  <disabled>maintenance&#x0A;window</disabled>
</registry>