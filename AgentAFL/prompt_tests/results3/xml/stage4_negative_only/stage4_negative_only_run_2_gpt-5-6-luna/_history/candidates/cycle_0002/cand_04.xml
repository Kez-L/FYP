<?xml version="1.0"?>
<!DOCTYPE vault [
  <!ENTITY % record-model "<!ELEMENT record (key,value,tag*)>">
  %record-model;
  <!ELEMENT vault (record+)>
  <!ELEMENT key (#PCDATA)>
  <!ELEMENT value (#PCDATA)>
  <!ELEMENT tag (#PCDATA)>
  <!ATTLIST record xml:id ID #REQUIRED priority (low|normal|high) "normal">
  <!ENTITY separator " / ">
  <!ENTITY quoted "&#x22;classified&#x22;">
]>
<vault>
  <record xml:id="r1" priority="high">
    <key>access</key>
    <value>restricted&separator;&quoted;</value>
    <tag>internal</tag>
    <tag>review</tag>
  </record>
  <record xml:id="r2">
    <key>retention</key>
    <value>30 days</value>
  </record>
</vault>