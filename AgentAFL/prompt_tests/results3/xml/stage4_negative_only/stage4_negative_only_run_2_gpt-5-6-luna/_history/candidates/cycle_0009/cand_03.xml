<?xml version="1.0"?>
<!DOCTYPE matrix [
  <!ELEMENT matrix (row+)>
  <!ELEMENT row (cell+)>
  <!ELEMENT cell (#PCDATA)>
  <!ATTLIST row index NMTOKEN #REQUIRED>
  <!ATTLIST cell kind CDATA "number">
  <!ENTITY left "[">
  <!ENTITY right "]">
]>
<matrix>
  <row index="zero">
    <cell kind="number">0</cell>
    <cell kind="number">-1.25</cell>
    <cell kind="text">&left;origin&right;</cell>
  </row>
  <row index="one">
    <cell kind="number">1e6</cell>
    <cell kind="empty"/>
  </row>
</matrix>