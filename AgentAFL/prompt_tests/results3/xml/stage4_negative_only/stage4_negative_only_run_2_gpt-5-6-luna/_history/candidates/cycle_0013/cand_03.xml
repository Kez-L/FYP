<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE network [
  <!ELEMENT network (node+, link*)>
  <!ELEMENT node EMPTY>
  <!ATTLIST node id ID #REQUIRED label CDATA #IMPLIED>
  <!ELEMENT link EMPTY>
  <!ATTLIST link from IDREF #REQUIRED to IDREF #REQUIRED weight CDATA "1">
]>
<network>
  <node id="n-alpha" label="入口"/>
  <node id="n-beta" label="出口"/>
  <node id="n-gamma"/>
  <link from="n-alpha" to="n-beta" weight="0.75"/>
  <link from="n-beta" to="n-gamma"/>
  <link from="n-alpha" to="n-gamma" weight="2"/>
</network>