<?xml version="1.0" encoding="UTF-8"?>
<soap:Envelope
    xmlns:soap="http://www.w3.org/2003/05/soap-envelope"
    xmlns:auth="urn:example:auth"
    xmlns:svc="urn:example:service">
  <soap:Header>
    <auth:Credentials soap:mustUnderstand="true">
      <auth:Principal xml:lang="en">operator</auth:Principal>
      <auth:Token type="opaque">A&amp;B&lt;C&gt;</auth:Token>
    </auth:Credentials>
    <svc:Trace id="trace-7" enabled="false"/>
  </soap:Header>
  <soap:Body>
    <svc:SubmitRequest>
      <svc:Payload format="text/xml"><![CDATA[
        <inner value="&quot;quoted&quot;"/>
      ]]></svc:Payload>
      <svc:Options>
        <svc:Option name="priority">high</svc:Option>
        <svc:Option name="retry">0</svc:Option>
      </svc:Options>
    </svc:SubmitRequest>
  </soap:Body>
</soap:Envelope>