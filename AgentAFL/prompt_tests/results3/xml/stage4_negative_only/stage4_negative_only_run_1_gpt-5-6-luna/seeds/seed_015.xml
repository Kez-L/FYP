<?xml version="1.0"?>
<!DOCTYPE archive [
  <!ELEMENT archive (entry+)>
  <!ELEMENT entry (title, payload, checksum?)>
  <!ATTLIST entry id ID #REQUIRED kind (text|binary) "text">
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT payload (#PCDATA|part)*>
  <!ELEMENT part (#PCDATA)>
  <!ELEMENT checksum (#PCDATA)>
  <!ENTITY greeting "Hello &amp; welcome">
]>
<archive>
  <entry id="e1" kind="text">
    <title>&greeting;, parser</title>
    <payload>prefix<part><![CDATA[raw <content> & bytes]]></part>suffix</payload>
    <checksum>sha256:00000000000000000000000000000000</checksum>
  </entry>
  <entry id="e2">
    <title>Second entry</title>
    <payload><part>one</part><part>two</part><part>three</part></payload>
  </entry>
</archive>