<?xml version="1.0"?>
<!DOCTYPE message [
  <!ELEMENT message (header, body, attachment*)>
  <!ELEMENT header (from, to, subject)>
  <!ELEMENT from EMPTY>
  <!ATTLIST from address CDATA #REQUIRED>
  <!ELEMENT to EMPTY>
  <!ATTLIST to address CDATA #REQUIRED>
  <!ELEMENT subject (#PCDATA)>
  <!ELEMENT body ANY>
  <!ELEMENT attachment (#PCDATA)>
  <!ATTLIST attachment media CDATA "application/octet-stream">
]>
<message>
  <header>
    <from address="sender@example.invalid"/>
    <to address="receiver@example.invalid"/>
    <subject>Re: &quot;boundary&quot; test</subject>
  </header>
  <body>
    <blockquote cite="urn:quote">
      Line one
      <br/>
      Line two &amp; three
    </blockquote>
    <table border="0">
      <row><cell>α</cell><cell>β</cell></row>
    </table>
  </body>
  <attachment media="text/plain">YWJjZA==</attachment>
</message>