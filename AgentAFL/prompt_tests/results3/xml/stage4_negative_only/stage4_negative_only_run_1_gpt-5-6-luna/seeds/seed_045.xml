<?xml version="1.0"?>
<!DOCTYPE museum [
  <!ELEMENT museum (exhibit+, curator?)>
  <!ELEMENT exhibit (title, description, artifact*)>
  <!ATTLIST exhibit code ID #REQUIRED era (ancient|modern|future) "modern">
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT description (#PCDATA|emphasis|br)*>
  <!ELEMENT emphasis (#PCDATA)>
  <!ELEMENT br EMPTY>
  <!ELEMENT artifact EMPTY>
  <!ATTLIST artifact ref IDREF #IMPLIED material CDATA #IMPLIED>
  <!ELEMENT curator (#PCDATA)>
]>
<museum>
  <exhibit code="x-17" era="ancient">
    <title>Fragments</title>
    <description>Recovered <emphasis>ceramic</emphasis> shards<br/>from a coastal site.</description>
    <artifact ref="x-17" material="clay"/>
  </exhibit>
  <curator>Ada &amp; Noor</curator>
</museum>