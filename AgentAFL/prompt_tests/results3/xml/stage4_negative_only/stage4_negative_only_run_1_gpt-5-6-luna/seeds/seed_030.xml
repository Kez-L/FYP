<?xml version="1.0"?>
<!DOCTYPE archive [
  <!ELEMENT archive (entry+, index)>
  <!ELEMENT entry (title, metadata?, body)>
  <!ATTLIST entry id ID #REQUIRED kind (note|report|memo) "note">
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT metadata (author, keywords?)>
  <!ELEMENT author (#PCDATA)>
  <!ELEMENT keywords (keyword+)>
  <!ELEMENT keyword (#PCDATA)>
  <!ELEMENT body (#PCDATA|em|strong|link)*>
  <!ELEMENT em (#PCDATA|strong)*>
  <!ELEMENT strong (#PCDATA)>
  <!ELEMENT link (#PCDATA)>
  <!ATTLIST link href CDATA #REQUIRED>
  <!ELEMENT index (ref+)>
  <!ELEMENT ref EMPTY>
  <!ATTLIST ref target IDREF #REQUIRED>
  <!ENTITY product "XML &amp; validation">
]>
<archive>
  <entry id="e1" kind="report">
    <title>Parser &product; Survey</title>
    <metadata>
      <author>Ada Example</author>
      <keywords>
        <keyword>grammar</keyword>
        <keyword>entities</keyword>
      </keywords>
    </metadata>
    <body>Text with <em>mixed <strong>content</strong></em> and a <link href="urn:ref:1">reference</link>.</body>
  </entry>
  <entry id="e2">
    <title>Short Memo</title>
    <body><![CDATA[Characters such as < and > remain literal here.]]></body>
  </entry>
  <index>
    <ref target="e1"/>
    <ref target="e2"/>
  </index>
</archive>