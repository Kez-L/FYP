<?xml version="1.0"?>
<forms xmlns="urn:example:forms" xmlns:m="urn:example:meta">
  <form m:version="3" enabled="yes">
    <field name="query" type="text" required="true">
      <label>Search</label>
      <default xml:space="preserve">  a &amp; b  </default>
      <validation>
        <rule kind="length" min="1" max="64"/>
        <rule kind="pattern"><![CDATA[[A-Z]+\d{2}]]></rule>
      </validation>
    </field>
    <field name="choice" type="select">
      <label>Pick one</label>
      <options>
        <option value="x" selected="true">X-ray</option>
        <option value="y">Yankee</option>
        <option value="z">Zulu</option>
      </options>
    </field>
  </form>
</forms>