<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE graph [
  <!ELEMENT graph (node*, edge*)>
  <!ELEMENT node (label?, property*)>
  <!ATTLIST node key ID #REQUIRED>
  <!ELEMENT edge EMPTY>
  <!ATTLIST edge from IDREF #REQUIRED to IDREF #REQUIRED weight CDATA "1">
  <!ELEMENT label (#PCDATA)>
  <!ELEMENT property (#PCDATA)>
]>
<graph>
  <node key="n0">
    <label>Root</label>
    <property>isolated</property>
  </node>
  <node key="n1">
    <label><![CDATA[Child & Branch]]></label>
    <property>left</property>
    <property>right</property>
  </node>
  <edge from="n0" to="n1" weight="0.25"/>
  <edge from="n1" to="n0" weight="-7"/>
</graph>