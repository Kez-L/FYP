<?xml version="1.0"?>
<!DOCTYPE archive [
  <!ELEMENT archive (entry+, footer?)>
  <!ELEMENT entry (title, body, link*)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT body (#PCDATA|em|code|br)*>
  <!ELEMENT em (#PCDATA)>
  <!ELEMENT code (#PCDATA)>
  <!ELEMENT br EMPTY>
  <!ELEMENT link EMPTY>
  <!ELEMENT footer (#PCDATA)>
  <!ATTLIST entry id ID #REQUIRED kind (note|record|draft) "record">
  <!ATTLIST link target IDREF #IMPLIED rel CDATA #IMPLIED>
  <!ENTITY company "Northwind &amp; Sons">
]>
<archive>
  <entry id="e1" kind="note">
    <title>Release &company;</title>
    <body>Mixed <em>emphasis</em>, inline <code>code()</code><br/>and text.</body>
    <link target="e2" rel="related"/>
  </entry>
  <entry id="e2" kind="draft">
    <title>Second entry</title>
    <body>Unusual whitespace&#x0A;and a nonbreaking space&#xA0;.</body>
  </entry>
  <footer>End of archive</footer>
</archive>