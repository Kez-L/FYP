<?xml version="1.0"?>
<!DOCTYPE archive [
  <!ELEMENT archive (record+)>
  <!ELEMENT record (title, value, note?)>
  <!ATTLIST record id ID #REQUIRED>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT value (#PCDATA)>
  <!ELEMENT note (#PCDATA)>
  <!ENTITY company "North &amp; South Research">
  <!ENTITY marker "&#x1F642;">
]>
<archive>
  <record id="r1">
    <title>&company; &marker;</title>
    <value>42 &lt; 100 &amp;&amp; 100 &gt; 42</value>
    <note>First <![CDATA[record with ]]> mixed markup.</note>
  </record>
  <record id="r2">
    <title>Second record</title>
    <value>0xFF</value>
  </record>
</archive>