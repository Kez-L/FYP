<?xml version="1.0"?>
<!DOCTYPE scene [
  <!ELEMENT scene (environment, actor*, event+)>
  <!ELEMENT environment EMPTY>
  <!ATTLIST environment weather (clear|rain|snow) "clear">
  <!ELEMENT actor (name,position?,inventory?)>
  <!ATTLIST actor ref ID #REQUIRED>
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT position EMPTY>
  <!ATTLIST position x CDATA #REQUIRED y CDATA #REQUIRED z CDATA #IMPLIED>
  <!ELEMENT inventory (item*)>
  <!ELEMENT item (#PCDATA)>
  <!ATTLIST item id ID #IMPLIED>
  <!ELEMENT event (#PCDATA|move|say)*>
  <!ELEMENT move EMPTY>
  <!ATTLIST move actor IDREF #REQUIRED to IDREF #IMPLIED>
  <!ELEMENT say (#PCDATA)>
]>
<scene>
  <environment weather="rain"/>
  <actor ref="hero">
    <name>Rin</name>
    <position x="-0.0" y="4" z=""/>
    <inventory>
      <item id="potion">red &lt; vial</item>
      <item/>
    </inventory>
  </actor>
  <event>begin<move actor="hero" to="hero"/><say>Wait…</say>end</event>
  <event><?checkpoint?><say><![CDATA[echo &lt; raw]]></say></event>
</scene>