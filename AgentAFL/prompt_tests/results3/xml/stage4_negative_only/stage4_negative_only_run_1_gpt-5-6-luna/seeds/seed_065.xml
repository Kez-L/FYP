<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE report [
  <!ELEMENT report (metadata,summary,entry+)>
  <!ELEMENT metadata (title,author,date)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT author (#PCDATA)>
  <!ELEMENT date (#PCDATA)>
  <!ELEMENT summary (#PCDATA)>
  <!ELEMENT entry (message,details?)>
  <!ATTLIST entry severity (info|warning|error) "info" code ID #REQUIRED>
  <!ELEMENT message (#PCDATA)>
  <!ELEMENT details (#PCDATA)>
  <!ENTITY product "parser">
]>
