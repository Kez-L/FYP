<?xml version="1.0" encoding="UTF-8"?>
<network>
  <device id="router-01">
    <interface name="eth0">
      <address family="ipv4">192.0.2.1</address>
      <address family="ipv6">2001:db8::1</address>
      <routes>
        <route destination="0.0.0.0/0" gateway="192.0.2.254"/>
        <route destination="2001:db8:1::/64">
          <gateway>2001:db8::fe</gateway>
          <metric>10</metric>
        </route>
      </routes>
    </interface>
    <interface name="lo" state="up">
      <address family="ipv4">127.0.0.1</address>
    </interface>
  </device>
  <device id="sensor-β" state="maintenance">
    <interface name="radio">
      <capabilities>
        <capability>low-power</capability>
        <capability>mesh</capability>
      </capabilities>
    </interface>
  </device>
</network>