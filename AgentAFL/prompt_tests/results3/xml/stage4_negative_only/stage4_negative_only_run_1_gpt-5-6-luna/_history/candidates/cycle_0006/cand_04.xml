<?xml version="1.0"?>
<!DOCTYPE labyrinth [
  <!ELEMENT labyrinth (level)>
  <!ELEMENT level (north|south|east|west|junction)*>
  <!ELEMENT north (door|wall|levelref)>
  <!ELEMENT south (door|wall|levelref)>
  <!ELEMENT east (door|wall|levelref)>
  <!ELEMENT west (door|wall|levelref)>
  <!ELEMENT junction (north|south|east|west|door|wall|levelref)*>
  <!ELEMENT door EMPTY>
  <!ATTLIST door id ID #IMPLIED locked (yes|no) "no">
  <!ELEMENT wall EMPTY>
  <!ELEMENT levelref EMPTY>
  <!ATTLIST levelref target IDREF #REQUIRED>
]>
<labyrinth>
  <level id="unused">
    <north><door id="d0" locked="yes"/></north>
    <east><junction>
      <south><wall/></south>
      <west><levelref target="d0"/></west>
      <east><door locked="no"/></east>
    </junction></east>
    <south><levelref target="d0"/></south>
    <west><wall/></west>
  </level>
</labyrinth>