<?xml version="1.0"?>
<!DOCTYPE form [
  <!ELEMENT form (field|group)+>
  <!ELEMENT group (label, field*)>
  <!ELEMENT label (#PCDATA)>
  <!ELEMENT field (#PCDATA)>
  <!ATTLIST field name CDATA #REQUIRED type CDATA "text" readonly (yes|no) "no">
  <!ENTITY left "[">
  <!ENTITY right "]">
  <!ENTITY sample "A &amp; B &lt; C">
]>
<form>
  <group>
    <label>Contact &left;primary&right;</label>
    <field name="address" type="multiline" readonly="yes">one&#13;two&#10;three</field>
    <field name="comment"><![CDATA[raw ]]> text]]&gt; safely</field>
  </group>
  <field name="token">value &sample;</field>
</form>