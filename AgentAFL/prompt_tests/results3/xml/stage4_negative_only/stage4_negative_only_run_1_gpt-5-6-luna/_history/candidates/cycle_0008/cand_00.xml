<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE archive [
  <!ELEMENT archive (entry+)>
  <!ELEMENT entry (title, metadata, payload)>
  <!ATTLIST entry id ID #REQUIRED kind (text|binary) "text">
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT metadata (author?, keyword*)>
  <!ELEMENT author (#PCDATA)>
  <!ELEMENT keyword (#PCDATA)>
  <!ELEMENT payload (#PCDATA|part)*>
  <!ELEMENT part (#PCDATA)>
]>
<archive>
  <entry id="e1" kind="text">
    <title>Field Notes</title>
    <metadata>
      <author>R. Chen</author>
      <keyword>sensor</keyword>
      <keyword>calibration</keyword>
    </metadata>
    <payload>Start <part>alpha</part> and <part>beta</part> finish.</payload>
  </entry>
  <entry id="e2">
    <title>Empty Record</title>
    <metadata/>
    <payload><![CDATA[raw <content> & untouched]]></payload>
  </entry>
</archive>