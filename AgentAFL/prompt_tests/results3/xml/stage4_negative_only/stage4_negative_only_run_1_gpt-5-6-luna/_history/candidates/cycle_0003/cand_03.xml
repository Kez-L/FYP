<?xml version="1.0" encoding="UTF-8"?>
<configuration xmlns="urn:config:v3" xmlns:sec="urn:security">
  <defaults>
    <retry count="0" delay="PT0S"/>
    <limits max-items="18446744073709551615" enabled="false"/>
  </defaults>
  <profiles>
    <profile name="minimal">
      <include path="/etc/example.conf"/>
      <exclude path="../cache" recursive="true"/>
    </profile>
    <profile name="secure" sec:level="high">
      <include path="config&#x2F;local"/>
      <secret><![CDATA[not-expanded-&amp;-data]]></secret>
    </profile>
  </profiles>
