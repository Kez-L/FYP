<?xml version="1.0" encoding="UTF-8"?>
<configuration xmlns="urn:example:config"
              xmlns:x="urn:example:extension"
              xmlns:xi="http://www.w3.org/2001/XInclude">
  <?profile name="edge-case" enabled="yes"?>
  <!-- Configuration with alternate representations -->
  <module id="core">
    <setting name="threshold" type="integer">00042</setting>
    <setting name="enabled" type="boolean">false</setting>
    <setting name="pattern" type="regex"><![CDATA[(a|b)+\s*\d{2,4}]]></setting>
  </module>
  <x:module x:id="plugin-1">
    <x:dependency optional="true" version=">=1.0 &lt;2.0"/>
  </x:module>
  <xi:include href="missing-fragment.xml" parse="xml">
    <xi:fallback>
      <fallback reason="unavailable">Use defaults</fallback>
    </xi:fallback>
  </xi:include>
</configuration>