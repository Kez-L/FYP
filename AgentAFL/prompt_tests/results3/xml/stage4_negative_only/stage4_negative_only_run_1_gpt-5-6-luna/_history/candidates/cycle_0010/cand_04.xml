<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE scene [
  <!NOTATION png SYSTEM "image/png">
  <!ENTITY logo SYSTEM "logo.png" NDATA png>
  <!ELEMENT scene (layer*)>
  <!ELEMENT layer (sprite|text|group)*>
  <!ATTLIST layer name CDATA #IMPLIED z CDATA "0">
  <!ELEMENT group (sprite|text|group)*>
  <!ATTLIST group transform CDATA #IMPLIED>
  <!ELEMENT sprite EMPTY>
  <!ATTLIST sprite asset ENTITY #IMPLIED x CDATA #REQUIRED y CDATA #REQUIRED>
  <!ELEMENT text (#PCDATA)>
  <!ATTLIST text align (left|center|right) "left">
]>
<scene>
  <layer name="background" z="-1">
    <sprite asset="logo" x="0" y="0"/>
  </layer>
  <layer name="foreground" z="10">
    <group transform="translate(12,8) rotate(3.5)">
      <text align="center">A &lt; B &amp; C</text>
      <sprite x="128" y="64"/>
      <group transform="scale(0.5)">
        <text>nested label</text>
      </group>
    </group>
  </layer>
</scene>