<?xml version="1.0"?>
<!DOCTYPE package [
  <!ELEMENT package (manifest, payload)>
  <!ELEMENT manifest (entry+)>
  <!ELEMENT entry EMPTY>
  <!ATTLIST entry path NMTOKEN #REQUIRED kind (file|dir|link) "file" mode CDATA #IMPLIED>
  <!ELEMENT payload (chunk+)>
  <!ELEMENT chunk (#PCDATA)>
]>
<package>
  <manifest>
    <entry path="." kind="dir" mode="0755"/>
    <entry path="bin" kind="dir"/>
    <entry path="bin/run" kind="file" mode="0755"/>
    <entry path="README.txt" kind="file" mode="0644"/>
  </manifest>
  <payload>
    <chunk>#!/bin/sh&#10;echo &quot;hello&quot;</chunk>
    <chunk><![CDATA[
line A
line B
]]></chunk>
  </payload>
</package>