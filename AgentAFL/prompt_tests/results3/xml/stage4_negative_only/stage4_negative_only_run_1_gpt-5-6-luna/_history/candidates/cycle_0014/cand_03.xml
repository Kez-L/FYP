<?xml version="1.0"?>
<!DOCTYPE library [
  <!ELEMENT library (shelf*)>
  <!ELEMENT shelf (label, book*)>
  <!ELEMENT label (#PCDATA)>
  <!ELEMENT book (title, contributor+, abstract?)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT contributor (#PCDATA)>
  <!ELEMENT abstract (#PCDATA)>
  <!ATTLIST book isbn NMTOKEN #IMPLIED>
  <!ENTITY legal "Copyright &#xA9; 2026">
]>
<library>
  <shelf id="fiction">
    <label>Fiction</label>
    <book isbn="978-0-00-000001-1">
      <title>The &quot;Last&quot; Door</title>
      <contributor role="writer">A. Reader</contributor>
      <contributor role="editor">B. Proof</contributor>
      <abstract>&legal;. A short account of an impossible room.</abstract>
    </book>
  </shelf>
  <shelf id="reference">
    <label>Reference</label>
  </shelf>
  <shelf id="misc">
    <label>Miscellaneous</label>
    <book>
      <title>Symbols: &#x3C; &#x3E; &#x26; &#x22;</title>
      <contributor role="compiler">C. Curator</contributor>
    </book>
  </shelf>
</library>