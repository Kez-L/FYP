<?xml version="1.0"?>
<!DOCTYPE archive [
  <!ELEMENT archive (entry+, note?)>
  <!ELEMENT entry (title, payload, checksum)>
  <!ATTLIST entry id ID #REQUIRED kind (text|binary) "text">
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT payload (#PCDATA|part)*>
  <!ELEMENT part (#PCDATA)>
  <!ELEMENT checksum (#PCDATA)>
  <!ELEMENT note (#PCDATA)>
  <!ENTITY greeting "hello &amp; welcome">
]>
<archive>
  <entry id="e1" kind="text">
    <title>&greeting;</title>
    <payload>alpha<part>one</part>beta<part><![CDATA[x<y && z>]]></part>gamma</payload>
    <checksum>0000000000000000</checksum>
  </entry>
  <entry id="e2">
    <title>第二項目 — café</title>
    <payload><part>line
break</part><part>	indented</part></payload>
    <checksum>ffffffffffffffff</checksum>
  </entry>
  <note>trailing metadata</note>
</archive>