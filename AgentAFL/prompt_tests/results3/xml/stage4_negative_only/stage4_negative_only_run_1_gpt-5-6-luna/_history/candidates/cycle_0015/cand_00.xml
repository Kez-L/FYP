<?xml version="1.0"?>
<!DOCTYPE archive [
  <!ELEMENT archive (record+)>
  <!ELEMENT record (title, metadata, body)>
  <!ATTLIST record key ID #REQUIRED>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT metadata (author*, keyword*)>
  <!ELEMENT author (#PCDATA)>
  <!ELEMENT keyword (#PCDATA)>
  <!ELEMENT body (#PCDATA|line|emphasis)*>
  <!ELEMENT line (#PCDATA|emphasis)*>
  <!ELEMENT emphasis (#PCDATA)>
  <!ENTITY product "XML &amp; Parsing">
]>
<archive>
  <record key="r001">
    <title>&product; field notes</title>
    <metadata>
      <author xml:lang="fr">Élodie Vautrin</author>
      <author xml:lang="ja">佐藤健</author>
      <keyword>entities</keyword>
      <keyword>mixed-content</keyword>
    </metadata>
    <body>Text before<line>first <emphasis>important</emphasis> line</line>between<line><![CDATA[raw <markup> & symbols]]></line>after.</body>
  </record>
</archive>