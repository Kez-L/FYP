<?xml version="1.0"?>
<!DOCTYPE map [
  <!ELEMENT map (layer+, legend?)>
  <!ELEMENT layer (name, bounds, point*)>
  <!ATTLIST layer key NMTOKEN #REQUIRED visible (yes|no) "yes">
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT bounds (south, west, north, east)>
  <!ELEMENT south (#PCDATA)>
  <!ELEMENT west (#PCDATA)>
  <!ELEMENT north (#PCDATA)>
  <!ELEMENT east (#PCDATA)>
  <!ELEMENT point EMPTY>
  <!ATTLIST point lat CDATA #REQUIRED lon CDATA #REQUIRED label CDATA #IMPLIED>
  <!ELEMENT legend (#PCDATA|item)*>
  <!ELEMENT item (#PCDATA)>
]>
<map>
  <layer key="terrain" visible="no">
    <name>North Ridge</name>
    <bounds>
      <south>-12.50</south><west>44.10</west>
      <north>18.25</north><east>77.90</east>
    </bounds>
    <point lat="0" lon="0" label="origin"/>
    <point lat="51.5074" lon="-0.1278" label="London"/>
  </layer>
  <layer key="water">
    <name>Inlet &amp; Estuary</name>
    <bounds>
      <south="-1"/>
      <west="2"/>
      <north="3"/>
      <east="4"/>
    </bounds>
    <point lat="2.0" lon="3.0"/>
  </layer>
  <legend>Symbols: <item>ridge</item>, <item>water</item>.</legend>
</map>