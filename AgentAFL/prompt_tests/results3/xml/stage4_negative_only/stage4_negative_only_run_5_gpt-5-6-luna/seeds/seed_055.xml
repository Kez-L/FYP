<?xml version="1.0"?>
<!DOCTYPE catalog [
  <!ELEMENT catalog (entry+)>
  <!ELEMENT entry (title, summary?, price, tags)>
  <!ATTLIST entry sku ID #REQUIRED status (active|retired) "active">
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT summary (#PCDATA|b|i)*>
  <!ELEMENT b (#PCDATA)>
  <!ELEMENT i (#PCDATA)>
  <!ELEMENT price (#PCDATA)>
  <!ELEMENT tags (tag*)>
  <!ELEMENT tag (#PCDATA)>
  <!ENTITY currency "USD">
]>
<catalog>
  <entry sku="item-001">
    <title>Glass &amp; Wire</title>
    <summary>A <b>compact</b> device with <i>replaceable</i> parts.</summary>
    <price>19.95 &currency;</price>
    <tags><tag>hardware</tag><tag>repairable</tag></tags>
  </entry>
  <entry sku="item-002" status="retired">
    <title><![CDATA[Legacy <adapter>]]></title>
    <price>0.00 &currency;</price>
    <tags/>
  </entry>
</catalog>