<?xml version="1.0" standalone="yes"?>
<!DOCTYPE inventory [
  <!ELEMENT inventory (item+, audit?)>
  <!ELEMENT item (label, quantity, note?)>
  <!ATTLIST item sku ID #REQUIRED state (new|used|hold) "new">
  <!ELEMENT label (#PCDATA)>
  <!ELEMENT quantity (#PCDATA)>
  <!ELEMENT note (#PCDATA|mark)*>
  <!ELEMENT mark (#PCDATA)>
  <!ELEMENT audit EMPTY>
  <!ATTLIST audit ref IDREF #IMPLIED>
  <!ENTITY warehouse "North &amp; West">
  <!ENTITY warning "Handle with &quot;care&quot;">
]>
<inventory location="&warehouse;">
  <item sku="i-001">
    <label>Glass &amp; copper</label>
    <quantity>04</quantity>
    <note xml:space="preserve">Packed <mark>&warning;</mark> today.</note>
  </item>
  <item sku="i-002" state="hold">
    <label>Replacement part</label>
    <quantity>&#x30;7;</quantity>
  </item>
  <audit ref="i-001"/>
</inventory>