<?xml version="1.0" encoding="UTF-8"?>
<window xmlns="urn:ui:window" xmlns:evt="urn:ui:event" id="main" xml:space="preserve">
  <!-- mixed content with significant whitespace -->
  <layout orientation="horizontal">
    <panel role="navigation" collapsed="false">
      <label><![CDATA[Files & Folders]]></label>
      <items>
        <item value="one" selected="1">One</item>
        <item value="two"><![CDATA[Two <raw>]]></item>
      </items>
    </panel>
    <panel role="content">
      <evt:handler evt:type="activate" evt:phase="capture">
        <evt:script language="text">return "ok";</evt:script>
      </evt:handler>
      <message severity="warning">A <strong>notice</strong> with <br/> a break.</message>
    </panel>
  </layout>
  <state>
    <value name="zoom">1.25</value>
    <value name="theme">dark</value>
  </state>
</window>