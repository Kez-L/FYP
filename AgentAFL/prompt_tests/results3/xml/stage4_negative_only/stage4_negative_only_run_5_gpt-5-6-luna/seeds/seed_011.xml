<?xml version="1.0"?>
<!DOCTYPE map [
  <!ELEMENT map (layer+)>
  <!ELEMENT layer (node|edge|group)*>
  <!ATTLIST layer name CDATA #REQUIRED visible (yes|no) "yes">
  <!ELEMENT node EMPTY>
  <!ATTLIST node id ID #REQUIRED x CDATA #REQUIRED y CDATA #REQUIRED label CDATA #IMPLIED>
  <!ELEMENT edge EMPTY>
  <!ATTLIST edge from IDREF #REQUIRED to IDREF #REQUIRED kind CDATA "directed">
  <!ELEMENT group (node|edge|group)*>
  <!ATTLIST group id ID #REQUIRED>
]>
<map>
  <layer name="background" visible="no"/>
  <layer name="network">
    <node id="n0" x="0" y="0" label="origin"/>
    <group id="cluster-a">
      <node id="n1" x="-12.5" y="4.75"/>
      <node id="n2" x="18" y="4.75" label="出口"/>
      <edge from="n1" to="n2" kind="bridge"/>
    </group>
    <edge from="n0" to="n1"/>
    <edge from="n2" to="n0" kind="return"/>
  </layer>
</map>