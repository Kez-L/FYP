<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE catalog [
  <!ELEMENT catalog (entry+)>
  <!ELEMENT entry (title, metadata?, description)>
  <!ATTLIST entry key ID #REQUIRED status (draft|published|archived) "draft">
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT metadata EMPTY>
  <!ATTLIST metadata created CDATA #IMPLIED updated CDATA #IMPLIED>
  <!ELEMENT description (#PCDATA|code|br)*>
  <!ELEMENT code (#PCDATA)>
  <!ELEMENT br EMPTY>
  <!ENTITY product "parser">
  <!ENTITY note "A &product; sample">
]>
<catalog>
  <entry key="e1" status="published">
    <title>Entity &amp; CDATA coverage</title>
    <metadata created="2026-01-01T00:00:00Z"/>
    <description>Text before <code><![CDATA[if (a < b && c > d) {}]]></code><br/>Text after &note;.</description>
  </entry>
</catalog>