<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE map [
  <!ELEMENT map (node*)>
  <!ELEMENT node (label?, node*, value?)>
  <!ATTLIST node id ID #IMPLIED ref IDREF #IMPLIED>
  <!ELEMENT label (#PCDATA)>
  <!ELEMENT value (#PCDATA)>
]>
<map>
  <node id="root">
    <label>Root</label>
    <node id="left">
      <label>Left branch</label>
      <node id="leaf-a"><value>alpha</value></node>
      <node id="leaf-b" ref="leaf-a"><value>beta</value></node>
    </node>
    <node id="right">
      <label><![CDATA[Right & center]]></label>
      <node id="deep-1">
        <node id="deep-2">
          <node id="deep-3">
            <value>terminal</value>
          </node>
        </node>
      </node>
    </node>
  </node>
</map>