<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE catalog [
  <!ELEMENT catalog (entry+, note?)>
  <!ELEMENT entry (title, metadata, description)>
  <!ATTLIST entry code ID #REQUIRED status (draft|published|retired) "draft">
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT metadata (author*, tag*)>
  <!ELEMENT author (#PCDATA)>
  <!ELEMENT tag EMPTY>
  <!ATTLIST tag value CDATA #REQUIRED>
  <!ELEMENT description (#PCDATA|emphasis|link)*>
  <!ELEMENT emphasis (#PCDATA|link)*>
  <!ELEMENT link (#PCDATA)>
  <!ATTLIST link href CDATA #IMPLIED>
  <!ELEMENT note (#PCDATA)>
  <!ENTITY product "libxml">
  <!ENTITY mark "&#x2122;">
]>
<catalog>
  <entry code="item-a" status="published">
    <title>&product; parser &mark;</title>
    <metadata>
      <author>Ada Example</author>
      <author>R. Tester</author>
      <tag value="xml"/>
      <tag value="fuzzing"/>
    </metadata>
    <description>Text with <emphasis>nested emphasis and <link href="urn:test">a link</link></emphasis>.</description>
  </entry>
  <entry code="item-b">
    <title>Second entry</title>
    <metadata><tag value="empty-author"/></metadata>
    <description><![CDATA[Literal <markup> & characters remain here.]]></description>
  </entry>
  <note xml:space="preserve"> trailing spaces </note>
</catalog>