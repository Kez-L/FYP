<?xml version="1.0"?>
<!DOCTYPE catalog [
  <!ELEMENT catalog (entry+)>
  <!ELEMENT entry (title, summary?, meta, body)>
  <!ATTLIST entry id ID #REQUIRED refs IDREFS #IMPLIED status (draft|final|archived) "draft">
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT summary (#PCDATA|mark|code)*>
  <!ELEMENT mark (#PCDATA)>
  <!ELEMENT code (#PCDATA)>
  <!ELEMENT meta EMPTY>
  <!ATTLIST meta created CDATA #REQUIRED owner CDATA #IMPLIED>
  <!ELEMENT body (section+)>
  <!ELEMENT section (heading, paragraph+)>
  <!ATTLIST section name CDATA #REQUIRED>
  <!ELEMENT heading (#PCDATA)>
  <!ELEMENT paragraph (#PCDATA|em|br|code)*>
  <!ELEMENT em (#PCDATA)>
  <!ELEMENT br EMPTY>
  <!ENTITY product "Atlas">
  <!ENTITY notice "For &product; users only.">
]>
<catalog>
  <entry id="e1" status="final">
    <title>&product; deployment notes</title>
    <summary>Read the <mark>important</mark> parts and inspect <code>--verify</code>.</summary>
    <meta created="2026-10-01" owner="ops"/>
    <body>
      <section name="intro">
        <heading>Overview</heading>
        <paragraph>Use <em>staged</em> rollout.<br/>Then verify each node.</paragraph>
      </section>
      <section name="legal">
        <heading>Notice</heading>
        <paragraph>&notice;</paragraph>
      </section>
    </body>
  </entry>
  <entry id="e2" refs="e1" status="archived">
    <title>Archive</title>
    <meta created="2025-01-15"/>
    <body>
      <section name="history">
        <heading>Earlier release</heading>
        <paragraph>Retained for comparison.</paragraph>
      </section>
    </body>
  </entry>
</catalog>