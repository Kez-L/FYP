<?xml version="1.0"?>
<!DOCTYPE catalog [
  <!ELEMENT catalog (entry+)>
  <!ELEMENT entry (title, creator*, description?, price)>
  <!ATTLIST entry code ID #REQUIRED status (active|retired) "active">
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT creator (#PCDATA)>
  <!ELEMENT description (#PCDATA|emph|ref)*>
  <!ELEMENT emph (#PCDATA)>
  <!ELEMENT ref EMPTY>
  <!ATTLIST ref target IDREF #IMPLIED>
  <!ELEMENT price (#PCDATA)>
  <!ENTITY currency "¤">
]>
<catalog>
  <entry code="bk-001">
    <title>Parsing &amp; Validation</title>
    <creator>R. Example</creator>
    <description>A guide to <emph>structured</emph> data and <ref target="bk-001"/> references.</description>
    <price>&currency;19.95</price>
  </entry>
  <entry code="bk-002" status="retired">
    <title>Legacy Markup</title>
    <price>&currency;7.50</price>
  </entry>
</catalog>