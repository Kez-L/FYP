<?xml version="1.0"?>
<!DOCTYPE catalog [
  <!ELEMENT catalog (entry+)>
  <!ELEMENT entry (title, metadata?, description)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT metadata EMPTY>
  <!ELEMENT description (#PCDATA|em)*>
  <!ELEMENT em (#PCDATA)>
  <!ATTLIST entry key ID #REQUIRED status (draft|published|archived) "draft">
  <!ATTLIST metadata created CDATA #IMPLIED>
  <!ENTITY brand "A&amp;B Research">
  <!ENTITY mark "&#x2603;">
]>
<catalog>
  <entry key="e1" status="published">
    <title>&brand; &mark;</title>
    <metadata created="2026-10-01"/>
    <description><![CDATA[raw <markup> and ]]> characters]]> <em>outside</em> CDATA.</description>
  </entry>
  <entry key="e2">
    <title>Second entry</title>
    <description>alpha <em>beta</em> gamma</description>
  </entry>
</catalog>