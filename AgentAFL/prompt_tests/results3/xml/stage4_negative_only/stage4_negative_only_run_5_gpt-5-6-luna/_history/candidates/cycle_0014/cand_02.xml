<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE report [
  <!ELEMENT report (header, section+)>
  <!ELEMENT header (title, date, author)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT date (#PCDATA)>
  <!ELEMENT author (#PCDATA)>
  <!ELEMENT section (heading, paragraph+)>
  <!ATTLIST section number NMTOKEN #REQUIRED>
  <!ELEMENT heading (#PCDATA)>
  <!ELEMENT paragraph (#PCDATA|code|linebreak)*>
  <!ELEMENT code (#PCDATA)>
  <!ELEMENT linebreak EMPTY>
  <!ENTITY lt "<">
  <!ENTITY gt ">">
]>
<report>
  <header>
    <title>Build &amp; Release Notes</title>
    <date>2026-10-01</date>
    <author>Automation</author>
  </header>
  <section number="1">
    <heading>Changes</heading>
    <paragraph>Compilation now accepts expressions such as <code>&lt;node&gt;</code>.<linebreak/>Warnings are grouped by module.</paragraph>
    <paragraph>Literal delimiters remain text: &lt;tag&gt; and &gt;.</paragraph>
  </section>
  <section number="2">
    <heading>Compatibility</heading>
    <paragraph>Older clients may ignore unknown attributes.</paragraph>
  </section>
</report>