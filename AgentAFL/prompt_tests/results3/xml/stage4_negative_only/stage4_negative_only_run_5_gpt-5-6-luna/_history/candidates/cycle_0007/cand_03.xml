<?xml version="1.0"?>
<!DOCTYPE graph [
  <!ELEMENT graph (node*, edge*)>
  <!ELEMENT node (label?, property*)>
  <!ATTLIST node id NMTOKEN #REQUIRED kind CDATA #IMPLIED>
  <!ELEMENT label (#PCDATA)>
  <!ELEMENT property (#PCDATA)>
  <!ATTLIST property key NMTOKEN #REQUIRED>
  <!ELEMENT edge EMPTY>
  <!ATTLIST edge from NMTOKEN #REQUIRED to NMTOKEN #REQUIRED weight CDATA "1">
]>
<graph>
  <node id="n0" kind="root">
    <label>Start</label>
    <property key="color">#ff00aa</property>
    <property key="empty"/>
  </node>
  <node id="n1">
    <label><![CDATA[<middle> & central]]></label>
  </node>
  <node id="n2" kind="leaf">
    <label>End</label>
  </node>
  <node id="n3">
    <property key="note">contains &lt;escaped&gt; text</property>
  </node>
  <edge from="n0" to="n1" weight="0.25"/>
  <edge from="n1" to="n2" weight="NaN"/>
  <edge from="n2" to="n3" weight="-Infinity"/>
  <edge from="n3" to="n0" weight="1e+309"/>
</graph>