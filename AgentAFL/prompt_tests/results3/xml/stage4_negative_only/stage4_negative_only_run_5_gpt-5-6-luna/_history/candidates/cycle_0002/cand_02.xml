        </xi:fallback>
      </xi:include>
    </pkg:resource>
  </pkg:resources>
  <pkg:commands>
    <pkg:command name="install" shell="false">tool --target &quot;/opt/demo&quot;</pkg:command>
    <pkg:command name="verify"><![CDATA[checksum --strict --all]]></pkg:command>
  </pkg:commands>
</package>