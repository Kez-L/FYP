<?xml version="1.0" encoding="UTF-8"?>
<package xmlns:pkg="urn:example:package" xmlns:xi="http://www.w3.org/2001/XInclude" xml:base="https://example.invalid/releases/">
  <pkg:identity id="bundle-07">
    <pkg:name>nightly-tools</pkg:name>
    <pkg:version major="3" minor="14" patch="0"/>
  </pkg:identity>
  <pkg:resources>
    <pkg:resource media-type="text/plain" path="CHANGELOG">
      <xi:include href="changelog.xml" parse="text">
        <xi:fallback>Changelog unavailable</xi:fallback>
      </xi:include>
    </pkg:resource>
