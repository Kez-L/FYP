<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE archive [
  <!ELEMENT archive (entry+)>
  <!ELEMENT entry (title, metadata, payload)>
  <!ATTLIST entry id ID #REQUIRED kind (text|binary|mixed) "text">
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT metadata (author?, tag*)>
  <!ELEMENT author (#PCDATA)>
  <!ELEMENT tag (#PCDATA)>
  <!ELEMENT payload (#PCDATA|chunk)*>
  <!ELEMENT chunk (#PCDATA)>
]>
<archive>
  <entry id="e1" kind="mixed">
    <title>Quarterly Notes</title>
    <metadata>
      <author>R&amp;D</author>
      <tag>alpha</tag>
      <tag>unicode-λ</tag>
    </metadata>
    <payload>before<chunk><![CDATA[<not-an-element>&raw;</not-an-element>]]></chunk>after</payload>
  </entry>
  <entry id="e2">
    <title>Empty payload</title>
    <metadata/>
    <payload/>
  </entry>
</archive>