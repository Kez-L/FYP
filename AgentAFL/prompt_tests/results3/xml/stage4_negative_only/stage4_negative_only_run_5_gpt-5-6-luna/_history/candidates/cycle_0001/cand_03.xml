<?xml version="1.0"?>
<configuration>
  <environment name="test">
    <setting key="path">/var/tmp/data</setting>
    <setting key="flags">
      <value>fast</value>
      <value>safe</value>
      <value enabled="false">legacy</value>
    </setting>
  </environment>
  <environment name="production">
    <setting key="path"><![CDATA[/srv/app/<data>]]></setting>
    <secret>
      <key id="primary">redacted</key>
      <rotation>
        <interval unit="days">30</interval>
        <owner email="ops@example.invalid">Operations</owner>
      </rotation>
    </secret>
  </environment>
  <defaults>
    <retry count="3"/>
    <timeout unit="ms">1500</timeout>
  </defaults>
</configuration>