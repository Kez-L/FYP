<?xml version="1.0"?>
<!DOCTYPE document [
  <!ELEMENT document (section|separator)*>
  <!ELEMENT section (heading, section|body)>
  <!ELEMENT heading (#PCDATA)>
  <!ELEMENT body (#PCDATA|list|quote|empty)*>
  <!ELEMENT list (item+)>
  <!ELEMENT item (#PCDATA|list)*>
  <!ELEMENT quote (#PCDATA)>
  <!ELEMENT separator EMPTY>
]>
<document>
  <section id="outer">
    <heading>Recursive structure</heading>
    <section id="inner">
      <heading>Nested section</heading>
      <body>
        <list>
          <item>first</item>
          <item>second<list><item>deep</item></list></item>
        </list>
        <quote>“quoted” &amp; escaped</quote>
        <empty/>
      </body>
    </section>
  </section>
  <separator/>
  <section id="tail">
    <heading>Mixed content</heading>
    <body>prefix<quote>middle</quote>suffix</body>
  </section>
</document>