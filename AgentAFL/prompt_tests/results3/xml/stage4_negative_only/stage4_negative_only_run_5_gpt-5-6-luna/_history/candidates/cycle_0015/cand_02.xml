<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE scene [
  <!ELEMENT scene (layer+)>
  <!ELEMENT layer (object*)>
  <!ATTLIST layer name CDATA #REQUIRED visible (yes|no) "yes">
  <!ELEMENT object (label?, geometry, style?)>
  <!ATTLIST object id ID #IMPLIED kind CDATA #IMPLIED>
  <!ELEMENT label (#PCDATA)>
  <!ELEMENT geometry (point|circle|path)>
  <!ELEMENT point EMPTY>
  <!ATTLIST point x CDATA #REQUIRED y CDATA #REQUIRED>
  <!ELEMENT circle EMPTY>
  <!ATTLIST circle cx CDATA #REQUIRED cy CDATA #REQUIRED radius CDATA #REQUIRED>
  <!ELEMENT path (#PCDATA)>
  <!ELEMENT style EMPTY>
  <!ATTLIST style fill CDATA #IMPLIED stroke CDATA #IMPLIED>
]>
<scene>
  <layer name="background" visible="no"/>
  <layer name="foreground">
    <object id="shape-1" kind="circle">
      <label>outer &amp; inner</label>
      <geometry><circle cx="0" cy="0" radius="12.5"/></geometry>
      <style fill="#ffffff" stroke="none"/>
    </object>
    <object id="shape-2" kind="polyline">
      <geometry><path>0,0 10,5 20,0</path></geometry>
    </object>
  </layer>
</scene>