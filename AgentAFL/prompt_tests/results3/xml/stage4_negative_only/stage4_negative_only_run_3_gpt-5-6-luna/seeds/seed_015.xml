<?xml version="1.0"?>
<!DOCTYPE archive [
  <!ELEMENT archive (entry+)>
  <!ELEMENT entry (key, value, checksum?)>
  <!ELEMENT key (#PCDATA)>
  <!ELEMENT value (#PCDATA)>
  <!ELEMENT checksum (#PCDATA)>
  <!ATTLIST entry priority (low|normal|high) "normal">
  <!ENTITY nbsp "&#160;">
]>
<archive>
  <entry priority="high">
    <key>alpha</key>
    <value>First&nbsp;record</value>
    <checksum><![CDATA[sha256:0000<invalid-looking>]]></checksum>
  </entry>
  <entry priority="low">
    <key>omega</key>
    <value>Trailing whitespace&#x20;</value>
  </entry>
</archive>