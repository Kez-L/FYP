<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE catalog [
  <!ELEMENT catalog (section+)>
  <!ELEMENT section (title, item*)>
  <!ATTLIST section code ID #REQUIRED>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT item (name, price, details?)>
  <!ATTLIST item sku ID #REQUIRED status (active|archived) "active">
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT price (#PCDATA)>
  <!ELEMENT details (#PCDATA|em|br)*>
  <!ELEMENT em (#PCDATA)>
  <!ELEMENT br EMPTY>
  <!ENTITY currency "€">
]>
<catalog>
  <section code="hardware">
    <title>Tools &amp; Components</title>
    <item sku="sku-001">
      <name>Precision driver</name>
      <price>19.95 &currency;</price>
      <details>Small <em>magnetic</em> tip<br/>with case.</details>
    </item>
    <item sku="sku-002" status="archived">
      <name>Caliper</name>
      <price>42.00 &currency;</price>
    </item>
  </section>
</catalog>