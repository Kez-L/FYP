<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE archive [
  <!ELEMENT archive (record+)>
  <!ELEMENT record (key, value, note?)>
  <!ATTLIST record kind (alpha|beta|gamma) "alpha">
  <!ELEMENT key (#PCDATA)>
  <!ELEMENT value (#PCDATA)>
  <!ELEMENT note (#PCDATA)>
  <!ENTITY company "A &amp; B Research">
]>
<archive>
  <!-- Entity expansion and mixed whitespace -->
  <record kind="beta">
    <key>001</key>
    <value>&company; &lt;encoded&gt;</value>
    <note xml:space="preserve">  line one
  line two  </note>
  </record>
  <record>
    <key>002</key>
    <value>caf&#xE9; &quot;quoted&quot;</value>
  </record>
</archive>