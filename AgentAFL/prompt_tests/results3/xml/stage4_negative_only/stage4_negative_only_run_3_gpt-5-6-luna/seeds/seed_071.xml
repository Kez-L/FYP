<?xml version="1.0"?>
<!DOCTYPE report [
  <!ELEMENT report (header, body, footer)>
  <!ELEMENT header (title, note?)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT note (#PCDATA)>
  <!ELEMENT body (paragraph+)>
  <!ELEMENT paragraph (#PCDATA|link|break)*>
  <!ELEMENT link (#PCDATA)>
  <!ELEMENT break EMPTY>
  <!ELEMENT footer (#PCDATA)>
  <!ATTLIST link target CDATA #REQUIRED>
  <!ENTITY company "Example &amp; Sons">
]>
<report>
  <header>
    <title>Quarterly &company; Report</title>
    <note><![CDATA[Prepared for internal review]]></note>
  </header>
  <body>
    <paragraph>First line<break/>Second line with <link target="urn:ref:42">a reference</link>.</paragraph>
    <paragraph><![CDATA[Literal <tags> and ]]> characters]]></paragraph>
  </body>
  <footer>End of document.</footer>
</report>