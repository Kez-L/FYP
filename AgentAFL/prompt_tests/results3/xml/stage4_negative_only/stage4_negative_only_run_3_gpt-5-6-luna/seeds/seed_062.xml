<?xml version="1.0"?>
<?processing instruction-data?>
<configuration>
  <environment name="staging">
    <variable name="PATH">/opt/app/bin:/usr/local/bin</variable>
    <variable name="EMPTY"/>
    <variable name="QUOTED" value="&quot;alpha&quot; &amp; &apos;beta&apos;"/>
  </environment>
  <!-- The following values intentionally exercise mixed content. -->
  <pipeline>
    <step id="fetch" enabled="yes">
      <input type="uri">https://api.example.test/v2/items?limit=10&amp;sort=-name</input>
    </step>
    <step id="transform" enabled="no">
      <script language="text/x-shell"><![CDATA[
        for item in "$@"; do
          printf '%s\n' "$item"
        done
      ]]></script>
    </step>
    <step id="publish" enabled="yes">
      <destination><![CDATA[/var/lib/app/output/<daily>]]></destination>
    </step>
  </pipeline>
</configuration>