<?xml version="1.0"?>
<!DOCTYPE library [
  <!ELEMENT library (shelf, shelf, note?)>
  <!ELEMENT shelf (label, book*)>
  <!ELEMENT label (#PCDATA)>
  <!ELEMENT book (title, author+, isbn?, synopsis)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT author (#PCDATA)>
  <!ELEMENT isbn (#PCDATA)>
  <!ELEMENT synopsis (#PCDATA|emph|code)*>
  <!ELEMENT emph (#PCDATA)>
  <!ELEMENT code (#PCDATA)>
  <!ELEMENT note (#PCDATA)>
  <!ATTLIST shelf code ID #REQUIRED>
  <!ATTLIST book category (fiction|reference|poetry) "reference">
  <!ENTITY company "North &amp; South Press">
  <!ENTITY dash "&#x2014;">
]>
<library>
  <shelf code="S-α">
    <label>Collected works</label>
    <book category="poetry">
      <title>Rain &amp; Lanterns</title>
      <author>R. Chen</author>
      <author>M. Okafor</author>
      <isbn>978-0-00-000000-0</isbn>
      <synopsis>Short lines from &company;&dash; <emph>quietly</emph> arranged in <code>three</code> voices.</synopsis>
    </book>
  </shelf>
  <shelf code="S-β">
    <label>Reference</label>
    <book>
      <title>Atlas of Small Things</title>
      <author>J. Vale</author>
      <synopsis>Maps, indexes, and marginalia.</synopsis>
    </book>
  </shelf>
  <note>Edition revised in 2026.</note>
</library>