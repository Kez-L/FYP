<?xml version="1.0"?>
<!DOCTYPE archive [
  <!ELEMENT archive (entry+)>
  <!ATTLIST archive format CDATA #FIXED "sealed">
  <!ELEMENT entry (key, value, note?)>
  <!ATTLIST entry kind (text|number|flag) "text">
  <!ELEMENT key (#PCDATA)>
  <!ELEMENT value (#PCDATA)>
  <!ELEMENT note (#PCDATA)>
  <!ENTITY product "A &amp; B">
]>
<archive format="sealed">
  <entry kind="text">
    <key>display-name</key>
    <value>&product; console</value>
    <note>Retained for compatibility.</note>
  </entry>
  <entry kind="number">
    <key>retry-limit</key>
    <value>007</value>
  </entry>
  <entry kind="flag">
    <key>enabled</key>
    <value>true</value>
  </entry>
</archive>