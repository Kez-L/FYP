<configuration>
  <service name="search" enabled="yes">
    <endpoint protocol="https">
      <host>search.example.test</host>
      <port>443</port>
      <path>/api/v2/query</path>
    </endpoint>
    <limits>
      <timeout unit="ms">750</timeout>
      <retries>3</retries>
    </limits>
  </service>
  <service name="archive" enabled="no">
    <endpoint protocol="file">
      <path>/var/lib/archive</path>
    </endpoint>
  </service>
</configuration>