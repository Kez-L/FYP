<?xml version="1.0"?>
<!DOCTYPE form [
  <!ELEMENT form (header, fields, footer)>
  <!ELEMENT header (#PCDATA)>
  <!ELEMENT fields (field*)>
  <!ELEMENT field EMPTY>
  <!ATTLIST field
    name CDATA #REQUIRED
    value CDATA #IMPLIED
    enabled (true|false) "true">
  <!ELEMENT footer (#PCDATA)>
]>
<form>
  <header>Submission &amp; validation</header>
  <fields>
    <field name="empty" value=""/>
    <field name="quoted" value="&lt;tag attr=&quot;x&quot;&gt;"/>
    <field name="disabled" enabled="false"/>
  </fields>
  <footer>done</footer>
</form>