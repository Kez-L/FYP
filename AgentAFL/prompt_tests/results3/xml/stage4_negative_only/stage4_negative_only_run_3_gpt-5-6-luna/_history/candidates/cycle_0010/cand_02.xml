<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE map [
  <!ELEMENT map (node|edge)*>
  <!ELEMENT node EMPTY>
  <!ATTLIST node id ID #REQUIRED kind CDATA #IMPLIED>
  <!ELEMENT edge EMPTY>
  <!ATTLIST edge from IDREF #REQUIRED to IDREF #REQUIRED weight NMTOKEN #IMPLIED>
]>
<map>
  <node id="n-root" kind="hub"/>
  <node id="n-a" kind="leaf"/>
  <node id="n-b"/>
  <node id="n-c" kind="leaf"/>
  <edge from="n-root" to="n-a" weight="1"/>
  <edge from="n-root" to="n-b" weight="2.5"/>
  <edge from="n-b" to="n-c" weight="&#x2B;3"/>
</map>