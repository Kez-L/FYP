<?xml version="1.0"?>
<configuration xmlns:sec="urn:security" xmlns:env="urn:environment">
  <profile name="edge-case" enabled="1">
    <env:variables>
      <env:variable name="EMPTY"/>
      <env:variable name="QUOTED" value="&quot;single&apos;double&quot;"/>
      <env:variable name="UNICODE" value="λ漢字🙂"/>
    </env:variables>
    <sec:policy>
      <sec:allow resource="urn:a"/>
      <sec:deny resource="urn:b">
        <sec:reason>not applicable</sec:reason>
      </sec:deny>
    </sec:policy>
    <timeouts>
      <connect unit="ms">000000</connect>
      <read unit="s">-1</read>
      <retry unit="count">999999999999999999999999</retry>
    </timeouts>
    <switch>
      <case when="true"><result><![CDATA[yes]]></result></case>
      <case when="false"><result>no</result></case>
      <default><result>unknown</result></default>
    </switch>
  </profile>
</configuration>