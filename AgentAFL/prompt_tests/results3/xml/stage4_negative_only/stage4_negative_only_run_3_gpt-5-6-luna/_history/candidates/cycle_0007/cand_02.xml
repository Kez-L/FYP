<?xml version="1.1"?>
<!DOCTYPE catalog [
  <!ELEMENT catalog (section*)>
  <!ELEMENT section (title, product*)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT product (name, price, note?)>
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT price (#PCDATA)>
  <!ELEMENT note (#PCDATA)>
  <!ATTLIST product sku ID #REQUIRED>
  <!ENTITY currency "€">
  <!ENTITY mark "<em>special</em>">
]>
<catalog xml:lang="de">
  <section code="A">
    <title>Werkzeuge &amp; Zubehör</title>
    <product sku="p-001">
      <name>Schraubenschlüssel</name>
      <price>19.95 &currency;</price>
      <note>Preis &mark;</note>
    </product>
  </section>
  <section code="B">
    <title>Leuchten</title>
    <product sku="p-002">
      <name>Lampe&#x85;Nord</name>
      <price>7.00 &currency;</price>
    </product>
  </section>
</catalog>