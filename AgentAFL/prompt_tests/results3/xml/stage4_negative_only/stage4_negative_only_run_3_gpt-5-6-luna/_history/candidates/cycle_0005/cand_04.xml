<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE survey [
  <!ELEMENT survey (intro, question+)>
  <!ELEMENT intro (#PCDATA|strong|br)*>
  <!ELEMENT strong (#PCDATA)>
  <!ELEMENT br EMPTY>
  <!ELEMENT question (prompt, choice+, answer?)>
  <!ATTLIST question id NMTOKEN #REQUIRED multi (yes|no) "no">
  <!ELEMENT prompt (#PCDATA|em|code)*>
  <!ELEMENT em (#PCDATA)>
  <!ELEMENT code (#PCDATA)>
  <!ELEMENT choice (#PCDATA)>
  <!ATTLIST choice key NMTOKEN #REQUIRED selected (true|false) "false">
  <!ELEMENT answer (#PCDATA)>
]>
<survey xml:lang="en" xml:space="preserve">
  <intro>Choose the best answer.<br/>Some prompts contain <strong>formatted</strong> text.</intro>
  <question id="q-α" multi="no">
    <prompt>Which symbol means <code>&lt;=</code>?</prompt>
    <choice key="a">Less than</choice>
    <choice key="b" selected="true">Less than or equal to</choice>
    <choice key="c">Not equal to</choice>
    <answer>b</answer>
  </question>
  <question id="q-2" multi="yes">
    <prompt>Select all <em>safe</em> transport options.</prompt>
    <choice key="tls" selected="true">TLS</choice>
    <choice key="plain">Plain text</choice>
    <choice key="local" selected="true">Local socket</choice>
  </question>
</survey>