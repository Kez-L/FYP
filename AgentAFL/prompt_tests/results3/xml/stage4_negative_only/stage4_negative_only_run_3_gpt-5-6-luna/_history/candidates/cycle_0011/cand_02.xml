<?xml version="1.0"?>
<!DOCTYPE config [
  <!ENTITY app "fuzz-target">
  <!ENTITY percent "%">
  <!ENTITY greeting "Hello &app;">
]>
<configuration>
  <environment name="test">
    <variable key="PATH">/usr/bin:/bin</variable>
    <variable key="LIMIT">&percent;100</variable>
  </environment>
  <modules>
    <module enabled="yes">
      <name>&app;</name>
      <options>
        <option name="greeting">&greeting;</option>
        <option name="pattern"><![CDATA[[A-Z]+(?:_[0-9]+)?]]></option>
      </options>
    </module>
  </modules>
</configuration>