<?xml version="1.0"?>
<!DOCTYPE report [
  <!ENTITY % common "<!ELEMENT report (header, body, footer)>">
  %common;
  <!ELEMENT header (owner, created)>
  <!ELEMENT owner (#PCDATA)>
  <!ELEMENT created (#PCDATA)>
  <!ELEMENT body (paragraph | table | warning)*>
  <!ELEMENT paragraph (#PCDATA | link)*>
  <!ELEMENT link (#PCDATA)>
  <!ELEMENT table (row+)>
  <!ELEMENT row (cell+)>
  <!ELEMENT cell (#PCDATA)>
  <!ELEMENT warning (#PCDATA)>
  <!ELEMENT footer (#PCDATA)>
  <!ATTLIST link href CDATA #REQUIRED>
  <!ENTITY nbsp "&#160;">
]>
