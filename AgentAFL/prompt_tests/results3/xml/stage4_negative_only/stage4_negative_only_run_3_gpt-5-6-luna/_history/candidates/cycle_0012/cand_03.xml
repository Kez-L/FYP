<?xml version="1.0"?>
<configuration xmlns="urn:example:config" xmlns:sec="urn:example:security">
  <environment name="staging">
    <property key="timeout" type="duration">PT15S</property>
    <property key="retries" type="integer">03</property>
    <property key="endpoint" type="uri">https://service.example.invalid/api?v=2&amp;mode=quiet</property>
  </environment>
  <credentials sec:scheme="token">
    <sec:token expires="2027-01-01T00:00:00Z">redacted-placeholder</sec:token>
  </credentials>
  <features>
    <feature name="tracing" enabled="false"/>
    <feature name="compression" enabled="true">
      <algorithm>zstd</algorithm>
    </feature>
  </features>
  <!-- Configuration intentionally contains an empty override. -->
  <overrides/>
</configuration>