<?xml version="1.0" encoding="UTF-8"?>
<svg xmlns="http://www.w3.org/2000/svg"
     xmlns:xlink="http://www.w3.org/1999/xlink"
     width="240" height="120" viewBox="0 0 240 120">
  <title>Layered waveform</title>
  <desc>Two paths and embedded metadata</desc>
  <metadata><![CDATA[
    {"source":"synthetic","samples":[0,1,1,0,-1]}
  ]]></metadata>
  <defs>
    <linearGradient id="g" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0" stop-color="#112233"/>
      <stop offset="0.5" stop-color="rgb(128,64,0)" stop-opacity=".75"/>
      <stop offset="100%" stop-color="white"/>
    </linearGradient>
    <clipPath id="window"><rect x="8" y="8" width="224" height="104" rx="6"/></clipPath>
  </defs>
  <g id="plot" clip-path="url(#window)" transform="translate(4,2) rotate(-1 120 60)">
    <rect x="0" y="0" width="232" height="108" fill="url(#g)" stroke="none"/>
    <path d="M 4,60 C 24,8 42,112 64,60 S 104,8 124,60 S 164,112 184,60 S 224,8 236,60"
          fill="none" stroke="#fff" stroke-width="2.5" stroke-linecap="round"/>
    <circle cx="124" cy="60" r="3" fill="yellow"/>
  </g>
  <switch>
    <foreignObject x="12" y="12" width="90" height="24">
      <div xmlns="http://www.w3.org/1999/xhtml" style="font-size:10px">peak <b>0.99</b></div>
    </foreignObject>
    <text x="12" y="24">peak 0.99</text>
  </switch>
  <use xlink:href="#plot" x="0" y="0" opacity="0"/>
</svg>