<?xml version="1.1" encoding="UTF-8"?>
<configuration xmlns="urn:example:config" xml:lang="ja" xml:space="preserve">
  <profile name="夜間">
    <rule match="α/β" enabled="yes">
      <pattern><![CDATA[^\p{L}+\s+\d{2,4}$]]></pattern>
      <replacement>Δ</replacement>
    </rule>
    <rule match="emoji" enabled="no">
      <pattern>☃️ &amp; ☀️</pattern>
      <replacement>—</replacement>
    </rule>
  </profile>
  <defaults>
    <timeout unit="ms">250</timeout>
    <paths>
      <path>/var/lib/example</path>
      <path>relative/../cache</path>
    </paths>
  </defaults>
</configuration>