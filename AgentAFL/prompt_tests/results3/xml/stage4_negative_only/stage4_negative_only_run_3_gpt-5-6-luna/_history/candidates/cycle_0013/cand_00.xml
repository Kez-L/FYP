<?xml version="1.0"?>
<!DOCTYPE message [
  <!ELEMENT message (header, body, signature?)>
  <!ELEMENT header (from, to, subject)>
  <!ELEMENT from (#PCDATA)>
  <!ELEMENT to (#PCDATA)>
  <!ELEMENT subject (#PCDATA)>
  <!ELEMENT body (#PCDATA|emphasis|link)*>
  <!ELEMENT emphasis (#PCDATA)>
  <!ELEMENT link (#PCDATA)>
  <!ELEMENT signature (#PCDATA)>
  <!ATTLIST message priority (low|normal|high) "normal">
  <!ENTITY company "Example &amp; Sons">
]>
<message priority="high">
  <header>
    <from>sender@example.test</from>
    <to>receiver@example.test</to>
    <subject>Entity handling</subject>
  </header>
  <body>Hello, <emphasis>world</emphasis>! Visit <link>https://example.test/?a=1&amp;b=2</link>.
    &company; confirms delivery.
  </body>
  <signature>-- Mail System</signature>
</message>