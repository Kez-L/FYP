<?xml version="1.0"?>
<configuration xmlns="urn:example:config">
  <defaults>
    <option name="retries">3</option>
    <option name="timeout">PT5S</option>
  </defaults>
  <profiles>
    <profile name="minimal">
      <include ref="defaults"/>
      <features>
        <feature enabled="yes">logging</feature>
        <feature enabled="no">metrics</feature>
      </features>
    </profile>
    <profile name="extended">
      <include ref="defaults"/>
      <features>
        <feature enabled="yes">logging</feature>
        <feature enabled="yes">metrics</feature>
        <feature enabled="yes">tracing</feature>
      </features>
      <overrides>
        <option name="timeout">PT30S</option>
      </overrides>
    </profile>
  </profiles>
  <mapping>
    <entry key="&quot;quoted&quot;" value="A&amp;B"/>
    <entry key="path" value="/var/lib/example"/>
  </mapping>
</configuration>