<?xml version="1.0"?>
<!DOCTYPE scene [
  <!ELEMENT scene (layer+)>
  <!ELEMENT layer (object*)>
  <!ELEMENT object (transform?, shape)>
  <!ELEMENT transform EMPTY>
  <!ELEMENT shape (#PCDATA)>
  <!ATTLIST layer index NMTOKEN #REQUIRED>
  <!ATTLIST object id ID #IMPLIED>
  <!ATTLIST transform matrix CDATA #IMPLIED>
]>
<scene>
  <layer index="00">
    <object id="obj_a">
      <transform matrix="1 0 0 1 0 0"/>
      <shape>rect</shape>
    </object>
    <object id="obj_b">
      <shape>circle</shape>
    </object>
  </layer>
  <layer index="0x10">
    <!-- nested text, entities, and unusual numeric forms -->
    <object id="obj_c">
      <transform matrix="nan inf -inf 1e-309"/>
      <shape><![CDATA[polygon]]></shape>
    </object>
  </layer>
</scene>