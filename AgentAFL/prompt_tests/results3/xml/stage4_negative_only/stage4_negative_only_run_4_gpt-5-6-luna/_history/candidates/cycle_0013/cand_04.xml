<?xml version="1.0"?>
<!DOCTYPE scene [
  <!ENTITY open "(open)">
  <!ENTITY close "(close)">
  <!ENTITY label "north &amp; west">
  <!ELEMENT scene (layer+, note?)>
  <!ELEMENT layer (item*)>
  <!ATTLIST layer name NMTOKEN #REQUIRED z CDATA "0">
  <!ELEMENT item EMPTY>
  <!ATTLIST item id ID #IMPLIED kind (point|line|area) "point"
                 coords CDATA #REQUIRED visible (yes|no) "yes">
  <!ELEMENT note (#PCDATA)>
]>
<scene>
  <layer name="base" z="-1">
    <item id="i-a" kind="area" coords="0,0 10,0 10,10 0,10"/>
    <item id="i-b" kind="line" coords="0,0&#xA;10,10" visible="no"/>
  </layer>
  <layer name="labels" z="2">
    <item id="i-c" coords="5,5"/>
  </layer>
  <note>&open; region: &label; &close;</note>
</scene>