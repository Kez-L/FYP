<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE document [
  <!ELEMENT document (section)>
  <!ELEMENT section (heading, paragraph+, note?)>
  <!ATTLIST section xml:space (default|preserve) "default">
  <!ELEMENT heading (#PCDATA)>
  <!ELEMENT paragraph (#PCDATA|br|mark)*>
  <!ELEMENT br EMPTY>
  <!ELEMENT mark (#PCDATA)>
  <!ELEMENT note (#PCDATA)>
]>
<document>
  <!-- mixed content with significant whitespace -->
  <section xml:space="preserve">
    <heading>Line breaks &amp; highlighting</heading>
    <paragraph>First line<br/>second <mark>fragment</mark> and <![CDATA[ raw <markup> ]]></paragraph>
    <paragraph>Characters: &#x1F642; &#x2028; &lt; &gt; &quot;</paragraph>
    <note><![CDATA[unescaped ]]> text]]></note>
  </section>
</document>