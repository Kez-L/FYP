<?xml version="1.1" encoding="UTF-8"?>
<!DOCTYPE archive [
  <!ELEMENT archive (folder*)>
  <!ELEMENT folder (label, item*)>
  <!ATTLIST folder path CDATA #REQUIRED>
  <!ELEMENT label (#PCDATA)>
  <!ELEMENT item (#PCDATA)>
  <!ATTLIST item
    kind NMTOKEN "file"
    flags NMTOKENS #IMPLIED>
]>
<archive>
  <folder path="/tmp/α" >
    <label xml:space="default">Résumé&#x85;notes</label>
    <item kind="file" flags="hidden encrypted">alpha&#xA0;one</item>
    <item kind="link" flags="external">target&#x2028;name</item>
  </folder>
  <folder path="/var/log">
    <label>events</label>
    <item kind="device" flags="read-only">0000</item>
  </folder>
</archive>