<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE envelope [
  <!ELEMENT envelope (header, body)>
  <!ELEMENT header (kind, timestamp)>
  <!ELEMENT kind (#PCDATA)>
  <!ELEMENT timestamp (#PCDATA)>
  <!ELEMENT body (item*)>
  <!ELEMENT item (value|item)*>
  <!ATTLIST item name CDATA #IMPLIED>
  <!ELEMENT value (#PCDATA)>
]>
<envelope>
  <header>
    <kind>nested-data</kind>
    <timestamp>2026-10-01T00:00:00Z</timestamp>
  </header>
  <body>
    <item name="root">
      <item name="branch-a">
        <value>one</value>
        <item name="leaf"><value>two</value></item>
      </item>
      <item name="branch-b"><value>three &amp; four</value></item>
    </item>
  </body>
</envelope>