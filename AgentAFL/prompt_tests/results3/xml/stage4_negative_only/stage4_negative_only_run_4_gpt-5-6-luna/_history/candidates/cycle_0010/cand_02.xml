<?xml version="1.0"?>
<!DOCTYPE graph [
  <!ELEMENT graph (node+, edge*)>
  <!ELEMENT node (label?, property*)>
  <!ATTLIST node id ID #REQUIRED>
  <!ELEMENT edge EMPTY>
  <!ATTLIST edge from IDREF #REQUIRED to IDREF #REQUIRED kind CDATA #IMPLIED>
  <!ELEMENT label (#PCDATA)>
  <!ELEMENT property (#PCDATA)>
  <!ATTLIST property name NMTOKEN #REQUIRED>
]>
<graph>
  <node id="root">
    <label>Root &lt;entry&gt;</label>
    <property name="weight">1</property>
  </node>
  <node id="leaf">
    <property name="weight">0</property>
  </node>
  <edge from="root" to="leaf" kind="directed"/>
</graph>