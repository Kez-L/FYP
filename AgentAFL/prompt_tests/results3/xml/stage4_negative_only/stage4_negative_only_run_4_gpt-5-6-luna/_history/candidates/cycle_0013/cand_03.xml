]>
<package>
  <metadata>
    <format>raw</format>
    <length>0000000000000048</length>
    <flags>read-only&#x9;verified</flags>
  </metadata>
  <blob source="payload" checksum="sha256:00000000000000000000000000000000"/>
</package>