<?xml version="1.0"?>
<!DOCTYPE archive [
  <!ELEMENT archive (record+)>
  <!ELEMENT record (title, body, link*)>
  <!ATTLIST record id ID #REQUIRED ref IDREF #IMPLIED>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT body (#PCDATA|em|br)*>
  <!ELEMENT em (#PCDATA|em)*>
  <!ELEMENT br EMPTY>
  <!ELEMENT link EMPTY>
  <!ATTLIST link target IDREF #REQUIRED>
  <!ENTITY notice "Confidential &#x2014; internal use only">
]>
<archive>
  <record id="r1">
    <title>Quarterly &amp; Annual Notes</title>
    <body>Summary <em>for review</em><br/>Status: &notice;.</body>
    <link target="r2"/>
  </record>
  <record id="r2" ref="r1">
    <title>Appendix</title>
    <body><![CDATA[Literal markup: <tag attr="x"/> & not expanded]]></body>
  </record>
</archive>