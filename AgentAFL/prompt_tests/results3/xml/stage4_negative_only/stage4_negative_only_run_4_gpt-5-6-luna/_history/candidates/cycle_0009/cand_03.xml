<?xml version="1.0"?>
<!DOCTYPE archive [
  <!NOTATION bin SYSTEM "application/octet-stream">
  <!ELEMENT archive (file*)>
  <!ELEMENT file (#PCDATA)>
  <!ATTLIST file
            name CDATA #REQUIRED
            encoding NOTATION #IMPLIED
            payload ENTITY #IMPLIED>
  <!ENTITY sample SYSTEM "sample.bin" NDATA bin>
]>
<?archive mode="index"?>
<archive>
  <file name="empty" encoding="bin"/>
  <file name="linked" payload="sample">metadata</file>
</archive>