<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE dialogue [
  <!ELEMENT dialogue (scene+)>
  <!ELEMENT scene (speaker, line*)>
  <!ATTLIST scene number CDATA #REQUIRED>
  <!ELEMENT speaker (#PCDATA)>
  <!ELEMENT line (#PCDATA|pause|aside)*>
  <!ELEMENT pause EMPTY>
  <!ATTLIST pause duration CDATA "short">
  <!ELEMENT aside (#PCDATA)>
]>
<dialogue>
  <scene number="1">
    <speaker>Archivist</speaker>
    <line>Open the vault.<pause duration="long"/>Not the east door.</line>
    <line><aside>(whispered)</aside> The key is <pause/> beneath the stone.</line>
  </scene>
  <scene number="2">
    <speaker>Machine</speaker>
    <line><![CDATA[<status value="unknown"/>]]></line>
    <line>Signal: &#x1F4A1; &amp; response: &quot;ready&quot;.</line>
  </scene>
</dialogue>