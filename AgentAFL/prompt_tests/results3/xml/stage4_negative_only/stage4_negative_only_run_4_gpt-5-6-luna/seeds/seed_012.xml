<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE records [
  <!ELEMENT records (record*)>
  <!ELEMENT record (key, value, history?)>
  <!ATTLIST record keyref NMTOKEN #IMPLIED>
  <!ELEMENT key (#PCDATA)>
  <!ELEMENT value (#PCDATA|linebreak)*>
  <!ELEMENT linebreak EMPTY>
  <!ELEMENT history (event+)>
  <!ELEMENT event (#PCDATA)>
  <!ATTLIST event at CDATA #REQUIRED by CDATA #IMPLIED>
]>
<records>
  <record keyref="r_001">
    <key>temperature</key>
    <value>18.5<linebreak/>°C</value>
    <history>
      <event at="2024-02-29T23:59:59Z" by="sensor-A">calibrated</event>
      <event at="2025-01-01T00:00:00Z">reset <![CDATA[reason: "manual"]]></event>
    </history>
  </record>
  <record>
    <key>quote</key>
    <value><![CDATA[
      A literal ]]> sequence cannot appear here, so this section ends early.
    ]]></value>
  </record>
</records>