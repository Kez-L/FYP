<?xml version="1.0"?>
<!DOCTYPE envelope [
  <!ELEMENT envelope (meta, payload)>
  <!ELEMENT meta EMPTY>
  <!ATTLIST meta
    version CDATA #FIXED "2"
    mode (safe|raw) "safe">
  <!ELEMENT payload (chunk+)>
  <!ELEMENT chunk (#PCDATA)>
  <!ATTLIST chunk index NMTOKEN #REQUIRED encoding NMTOKEN "plain">
  <!ENTITY left "&#x3C;">
  <!ENTITY right "&#x3E;">
  <!ENTITY quoted "&quot;ready&quot;">
]>
<envelope>
  <meta/>
  <payload>
    <chunk index="01">literal text &amp; symbols</chunk>
    <chunk index="02" encoding="escaped">&left;tag attr=&quoted;&right;</chunk>
    <chunk index="03"><![CDATA[raw ]]> data]]></chunk>
  </payload>
</envelope>