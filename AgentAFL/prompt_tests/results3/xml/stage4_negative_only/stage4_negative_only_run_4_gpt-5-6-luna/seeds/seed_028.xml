<?xml version="1.0"?>
<!DOCTYPE catalog [
  <!ENTITY % itemattrs 'code CDATA #REQUIRED class NMTOKEN "misc"'>
  <!ELEMENT catalog (item*, note?)>
  <!ELEMENT item (name, price, description?)>
  <!ATTLIST item %itemattrs;>
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT price (#PCDATA)>
  <!ELEMENT description (#PCDATA|strong|br)*>
  <!ELEMENT strong (#PCDATA)>
  <!ELEMENT br EMPTY>
  <!ELEMENT note (#PCDATA)>
  <!ENTITY euro "&#x20AC;">
]>
<catalog>
  <item code="A-001" class="tool">
    <name>Compass</name>
    <price>19.95 &euro;</price>
    <description>Small <strong>brass</strong> instrument<br/>for travel.</description>
  </item>
  <item code="B-002">
    <name>Map</name>
    <price>4.50 &euro;</price>
  </item>
  <note>Prices include tax.</note>
</catalog>