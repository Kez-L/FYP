<?xml version="1.0"?>
<!DOCTYPE archive [
  <!ELEMENT archive (entry+)>
  <!ELEMENT entry (label, body)>
  <!ATTLIST entry key ID #REQUIRED
                ref IDREF #IMPLIED
                status (draft|final|held) "draft">
  <!ELEMENT label (#PCDATA)>
  <!ELEMENT body (#PCDATA|mark|link|br)*>
  <!ELEMENT mark (#PCDATA|mark)*>
  <!ELEMENT link (#PCDATA)>
  <!ELEMENT br EMPTY>
  <!ENTITY notice "This text came from an internal entity.">
  <!ENTITY stamp "2026-10-01T12:00:00Z">
]>
<archive>
  <entry key="e-a" status="final">
    <label>Primary record</label>
    <body>
      &notice;
      <mark>Indexed</mark>
      <br/>
      <link>urn:example:primary</link>
    </body>
  </entry>
  <entry key="e-b" ref="e-a" status="held">
    <label>Follow-up</label>
    <body>Received at <mark>&stamp;</mark>; awaiting review.</body>
  </entry>
</archive>