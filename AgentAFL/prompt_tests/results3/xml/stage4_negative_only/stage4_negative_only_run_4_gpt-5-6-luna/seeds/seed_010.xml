<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE catalog [
  <!ELEMENT catalog (entry+)>
  <!ELEMENT entry (title, description, metadata)>
  <!ATTLIST entry id ID #REQUIRED status (active|retired) "active">
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT description (#PCDATA|em|br)*>
  <!ELEMENT em (#PCDATA)>
  <!ELEMENT br EMPTY>
  <!ELEMENT metadata (tag*)>
  <!ELEMENT tag (#PCDATA)>
  <!ENTITY company "Northstar &amp; Co.">
  <!ENTITY greeting "Welcome to &company;">
]>
<catalog>
  <entry id="e1" status="active">
    <title>Field Notes</title>
    <description>A <em>compact</em> guide<br/>for observers.</description>
    <metadata>
      <tag>&greeting;</tag>
      <tag><![CDATA[alpha < beta && gamma > delta]]></tag>
    </metadata>
  </entry>
  <entry id="e2">
    <title>Retrospective</title>
    <description>Archived material<!-- preserved --></description>
    <metadata/>
  </entry>
</catalog>