<?xml version="1.0"?>
<!DOCTYPE catalog [
  <!ELEMENT catalog (entry+)>
  <!ELEMENT entry (title, description?, price)>
  <!ATTLIST entry id ID #REQUIRED status (active|archived) "active">
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT description (#PCDATA|emph|code)*>
  <!ELEMENT emph (#PCDATA)>
  <!ELEMENT code (#PCDATA)>
  <!ELEMENT price (#PCDATA)>
  <!ENTITY currency "EUR">
]>
<catalog>
  <entry id="p001" status="active">
    <title>Tea &amp; Biscuits</title>
    <description>Organic <emph>green</emph> tea in <code>250g</code> tins.</description>
    <price>12.50 &currency;</price>
  </entry>
  <entry id="p002">
    <title>Plain crackers</title>
    <price>4.75 &currency;</price>
  </entry>
</catalog>