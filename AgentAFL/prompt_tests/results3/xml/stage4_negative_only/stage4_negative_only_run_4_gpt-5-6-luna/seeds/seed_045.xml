<?xml version="1.0"?>
<!DOCTYPE archive [
  <!ELEMENT archive (entry+)>
  <!ELEMENT entry (title,body)>
  <!ATTLIST entry id ID #REQUIRED status (draft|final) "draft">
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT body (#PCDATA|em|ref)*>
  <!ELEMENT em (#PCDATA|ref)*>
  <!ELEMENT ref EMPTY>
  <!ATTLIST ref target IDREF #REQUIRED>
  <!ENTITY copyright "&#xA9; 2026">
]>
<archive>
  <entry id="e1" status="final">
    <title>Encoded &amp; Referenced</title>
    <body>Text <em>with <ref target="e1"/> markup</em> &copyright;.</body>
  </entry>
</archive>