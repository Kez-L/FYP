<?xml version="1.0"?>
<!DOCTYPE catalog [
  <!ELEMENT catalog (entry+)>
  <!ELEMENT entry (title, meta, body)>
  <!ATTLIST entry id ID #REQUIRED kind (note|warning|info) "info">
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT meta EMPTY>
  <!ATTLIST meta author CDATA #IMPLIED priority NMTOKEN "normal">
  <!ELEMENT body (#PCDATA|code|br)*>
  <!ELEMENT code (#PCDATA)>
  <!ELEMENT br EMPTY>
  <!ENTITY quoted "&#x22;quoted&#x22;">
  <!ENTITY mark "A &amp; B">
]>
<catalog>
  <entry id="e1" kind="warning">
    <title>&quoted;</title>
    <meta author="x&amp;y" priority="high"/>
    <body>Use <code>&lt;node/&gt;</code><br/>Result: &mark;.</body>
  </entry>
</catalog>