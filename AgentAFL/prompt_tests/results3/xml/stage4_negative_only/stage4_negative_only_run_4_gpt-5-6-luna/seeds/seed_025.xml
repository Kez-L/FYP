<?xml version="1.0"?>
<!DOCTYPE archive [
  <!ELEMENT archive (entry+)>
  <!ELEMENT entry (title, body, keyword*)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT body (#PCDATA|em|ref)*>
  <!ELEMENT em (#PCDATA)>
  <!ELEMENT ref EMPTY>
  <!ELEMENT keyword (#PCDATA)>
  <!ATTLIST entry id ID #REQUIRED status (draft|final|sealed) "draft">
  <!ATTLIST ref target IDREF #REQUIRED>
  <!ENTITY company "Aster &amp; Quill">
]>
<archive>
