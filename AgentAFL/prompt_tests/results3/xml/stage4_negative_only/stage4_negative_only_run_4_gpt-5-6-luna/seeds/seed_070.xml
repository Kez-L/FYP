<?xml version="1.0"?>
<!DOCTYPE archive [
  <!ELEMENT archive (entry+)>
  <!ELEMENT entry (#PCDATA|meta)*>
  <!ATTLIST entry id ID #REQUIRED category (text|binary|unknown) "text">
  <!ELEMENT meta EMPTY>
  <!ATTLIST meta key CDATA #REQUIRED value CDATA #IMPLIED>
  <!ENTITY greeting "hello &amp; welcome">
]>
<archive>
  <!-- Mixed character data with a declared ID attribute -->
  <entry id="first" category="text">&greeting; <![CDATA[raw <markup> remains text]]><meta key="lang" value="en"/>tail</entry>
  <entry id="second"><meta key="empty"/><meta key="format" value="plain"/></entry>
</archive>