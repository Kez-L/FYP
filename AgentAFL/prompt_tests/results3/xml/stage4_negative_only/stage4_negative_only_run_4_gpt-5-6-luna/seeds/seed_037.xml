<?xml version="1.0"?>
<!DOCTYPE report [
  <!ELEMENT report (section*)>
  <!ELEMENT section (heading, entry+)>
  <!ATTLIST section kind (alpha|beta|gamma) "alpha">
  <!ELEMENT heading (#PCDATA)>
  <!ELEMENT entry (#PCDATA|quote|list)*>
  <!ELEMENT quote (#PCDATA)>
  <!ELEMENT list (li+)>
  <!ELEMENT li (#PCDATA|quote)*>
]>
<report>
  <section kind="beta">
    <heading>Nested prose</heading>
    <entry>Before <quote>quoted <quote>deeply</quote> text</quote> after.</entry>
    <entry>
      <list>
        <li>first</li>
        <li>second <quote>aside</quote></li>
      </list>
    </entry>
  </section>
  <section>
    <heading>Whitespace</heading>
    <entry xml:lang="ja">文字列 — café — 🦊</entry>
  </section>
</report>