<?xml version="1.0"?>
<!DOCTYPE catalog [
  <!ELEMENT catalog (entry+)>
  <!ELEMENT entry (title, description, price)>
  <!ATTLIST entry code ID #REQUIRED status (active|retired) "active">
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT description (#PCDATA|em|br)*>
  <!ELEMENT em (#PCDATA)>
  <!ELEMENT br EMPTY>
  <!ELEMENT price (#PCDATA)>
  <!ENTITY currency "¤">
  <!ENTITY note "tax included">
]>
<catalog>
  <entry code="p-001">
    <title>Compact &amp; Reliable</title>
    <description>Small <em>portable</em> unit<br/>with a replaceable cell.</description>
    <price>19.95 &currency; (&note;)</price>
  </entry>
  <entry code="p-002" status="retired">
    <title>Legacy Model</title>
    <description><![CDATA[Discontinued <edition> with "old" packaging.]]></description>
    <price>0</price>
  </entry>
</catalog>