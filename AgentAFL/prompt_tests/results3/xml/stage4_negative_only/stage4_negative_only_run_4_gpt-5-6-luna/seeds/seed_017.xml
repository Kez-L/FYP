<configuration xmlns="urn:example:config"
               xmlns:sec="urn:example:security"
               xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
               xsi:nil="false">
  <profile name="isolated">
    <sec:permissions>
      <sec:allow action="read" resource="config"/>
      <sec:deny action="write" resource="secrets"/>
    </sec:permissions>
    <parameters>
      <parameter key="threshold" type="decimal">0.0000001</parameter>
      <parameter key="enabled" type="boolean">false</parameter>
      <parameter key="pattern" type="regex"><![CDATA[[A-Z]{2,4}\d+]]></parameter>
    </parameters>
    <fallback xmlns="">
      <value xml:lang="fr">aucune</value>
    </fallback>
  </profile>
</configuration>