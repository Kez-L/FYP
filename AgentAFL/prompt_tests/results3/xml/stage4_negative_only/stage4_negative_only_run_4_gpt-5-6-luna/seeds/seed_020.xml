<?xml version="1.0"?>
<!DOCTYPE catalog [
  <!ELEMENT catalog (item+)>
  <!ELEMENT item (title, description?, price)>
  <!ATTLIST item id ID #REQUIRED status (active|archived) "active">
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT description (#PCDATA|emph|link)*>
  <!ELEMENT emph (#PCDATA)>
  <!ELEMENT link EMPTY>
  <!ATTLIST link target CDATA #IMPLIED>
  <!ELEMENT price (#PCDATA)>
  <!ENTITY currency "&#x20AC;">
]>
<catalog>
  <item id="sku-001">
    <title>Crème brûlée</title>
    <description>Seasonal <emph>special</emph> with <link target="details"/>.</description>
    <price>19 &currency; 95</price>
  </item>
  <item id="sku-002" status="archived">
    <title>Tea &amp; biscuits</title>
    <price>7.50</price>
  </item>
</catalog>