<?xml version="1.0"?>
<!DOCTYPE catalog [
  <!ENTITY company "Acme &amp; Sons">
  <!ENTITY nbsp "&#160;">
  <!ENTITY item "replacement text">
  <!ELEMENT catalog (section+)>
  <!ELEMENT section (title, entry*)>
  <!ATTLIST section id ID #REQUIRED>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT entry (name, price, description?, related*)>
  <!ATTLIST entry sku ID #REQUIRED status (active|retired) "active">
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT price (#PCDATA)>
  <!ELEMENT description (#PCDATA|em|code)*>
  <!ELEMENT em (#PCDATA)>
  <!ELEMENT code (#PCDATA)>
  <!ELEMENT related EMPTY>
  <!ATTLIST related ref IDREF #REQUIRED>
]>
<catalog>
  <section id="hardware">
    <title>&company; &nbsp; catalog</title>
    <entry sku="p-001">
      <name>Bracket</name>
      <price>19.95</price>
      <description>Heavy <em>steel</em> bracket for <code>R-17</code>.</description>
      <related ref="p-002"/>
    </entry>
    <entry sku="p-002" status="retired">
      <name>Washer</name>
      <price>&item;</price>
    </entry>
  </section>
</catalog>