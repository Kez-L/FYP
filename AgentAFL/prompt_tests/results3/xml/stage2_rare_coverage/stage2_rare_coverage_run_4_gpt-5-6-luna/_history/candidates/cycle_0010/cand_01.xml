<?xml version="1.0"?>
<!DOCTYPE ledger [
  <!ELEMENT ledger (account+, trailer)>
  <!ELEMENT account (owner, transaction*)>
  <!ATTLIST account number ID #REQUIRED currency CDATA "EUR">
  <!ELEMENT owner (#PCDATA)>
  <!ELEMENT transaction (debit|credit)>
  <!ATTLIST transaction date CDATA #IMPLIED ref ID #IMPLIED>
  <!ELEMENT debit (#PCDATA)>
  <!ELEMENT credit (#PCDATA)>
  <!ELEMENT trailer EMPTY>
  <!ATTLIST trailer checksum CDATA #IMPLIED>
  <!ENTITY euro "&#x20AC;">
  <!ENTITY stamp "&#x2026; generated">
]>
<ledger>
  <account number="acct-1">
    <owner>Ada &amp; Lin</owner>
    <transaction date="2026-09-30" ref="tx-1">
      <credit>100 &euro;</credit>
    </transaction>
    <transaction date="2026-10-01">
      <debit>25 &euro;</debit>
    </transaction>
  </account>
  <account number="acct-2" currency="JPY">
    <owner>東京</owner>
    <transaction><credit>5000</credit></transaction>
  </account>
  <trailer checksum="&stamp;"/>
</ledger>