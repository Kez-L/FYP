<?xml version="1.0"?>
<!DOCTYPE form [
  <!ELEMENT form (section*)>
  <!ATTLIST form version NMTOKEN #FIXED "2">
  <!ELEMENT section (heading?, field*)>
  <!ATTLIST section name CDATA #IMPLIED collapsed (yes|no) "no">
  <!ELEMENT heading (#PCDATA)>
  <!ELEMENT field (label?, value?, help?)>
  <!ATTLIST field key NMTOKEN #REQUIRED required (true|false) "false">
  <!ELEMENT label (#PCDATA)>
  <!ELEMENT value (#PCDATA|line|mark)*>
  <!ELEMENT line EMPTY>
  <!ELEMENT mark (#PCDATA)>
  <!ELEMENT help (#PCDATA)>
  <!ENTITY nbsp "&#160;">
  <!ENTITY quote "&quot;">
]>
<form version="2">
  <section name="identity" collapsed="yes">
    <heading>Profile</heading>
    <field key="display-name" required="true">
      <label>Name</label>
      <value>A&nbsp;B<line/>C<mark>&quote;quoted&quote;</mark></value>
      <help>Use a public name.</help>
    </field>
  </section>
  <section name="preferences">
    <field key="theme">
      <value>dark</value>
    </field>
    <field key="locale" required="false">
      <label>Locale</label>
      <value><![CDATA[en-US]]></value>
    </field>
  </section>
</form>