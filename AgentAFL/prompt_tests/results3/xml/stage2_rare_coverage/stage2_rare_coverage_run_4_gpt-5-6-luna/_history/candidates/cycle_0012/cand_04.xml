<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE package [
  <!NOTATION bin SYSTEM "application/octet-stream">
  <!ENTITY payload SYSTEM "payload.bin" NDATA bin>
  <!ELEMENT package (manifest, resources)>
  <!ELEMENT manifest (entry+)>
  <!ELEMENT entry EMPTY>
  <!ATTLIST entry name NMTOKEN #REQUIRED href ENTITY #IMPLIED>
  <!ELEMENT resources (resource*)>
  <!ELEMENT resource (#PCDATA)>
  <!ATTLIST resource id ID #REQUIRED format NOTATION #IMPLIED>
]>
<package>
  <manifest>
    <entry name="alpha" href="payload"/>
    <entry name="beta"/>
  </manifest>
  <resources>
    <resource id="r0" format="bin">inline metadata</resource>
    <resource id="r1">text</resource>
  </resources>
</package>