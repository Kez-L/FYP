<?xml version="1.0"?>
<!DOCTYPE package [
  <!ENTITY % declarations '
    <!ELEMENT package (manifest, contents)>
    <!ELEMENT manifest (entry+)>
    <!ELEMENT entry EMPTY>
    <!ATTLIST entry name NMTOKEN #REQUIRED size NMTOKEN #IMPLIED type CDATA #IMPLIED>
    <!ELEMENT contents (file|directory|link)*>
    <!ELEMENT file (#PCDATA)>
    <!ELEMENT directory (file|directory|link)*>
    <!ELEMENT link EMPTY>
    <!ATTLIST link target CDATA #REQUIRED>
  '>
  %declarations;
  <!ENTITY copyright "Copyright &#xA9; 2026">
  <!NOTATION binary SYSTEM "application/octet-stream">
]>
<package>
  <manifest>
    <entry name="readme.txt" size="42" type="text/plain"/>
    <entry name="blob.bin" size="65535" type="application/octet-stream"/>
  </manifest>
  <contents>
    <directory>
      <file>top-level</file>
      <directory>
        <file><![CDATA[raw bytes: ]]> &copyright; </file>
        <link target="../readme.txt"/>
      </directory>
    </directory>
    <link target="/dev/null"/>
  </contents>
</package>