<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!DOCTYPE catalog [
  <!ELEMENT catalog (section+)>
  <!ELEMENT section (title, entry*)>
  <!ATTLIST section code ID #REQUIRED xml:lang NMTOKEN "en">
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT entry (name, detail?, tag*)>
  <!ATTLIST entry key ID #IMPLIED state (new|old|held) "new">
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT detail (#PCDATA|emph|link)*>
  <!ELEMENT emph (#PCDATA)>
  <!ELEMENT link (#PCDATA)>
  <!ELEMENT tag EMPTY>
  <!ATTLIST tag value CDATA #REQUIRED>
  <!ENTITY marker "catalog-&amp;-item">
]>
<catalog>
  <section code="s-main">
    <title xml:space="preserve">  Primary &marker;  </title>
    <entry key="e1" state="old">
      <name>Alpha</name>
      <detail>First <emph>important</emph> record with a <link>reference</link>.</detail>
      <tag value="one"/>
      <tag value="two"/>
    </entry>
  </section>
  <section code="s-empty" xml:lang="fr">
    <title>Éléments déjà vus</title>
  </section>
</catalog>