<?xml version="1.1"?>
<!DOCTYPE catalog [
  <!ENTITY % common "item | note">
  <!ENTITY % itemdecl "<!ELEMENT item (name, price, details?)>
                         <!ATTLIST item code ID #REQUIRED category CDATA #IMPLIED>">
  %itemdecl;
  <!ELEMENT catalog (section+)>
  <!ELEMENT section (title, (%common);*)>
  <!ATTLIST section xml:lang CDATA #IMPLIED>
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT price (#PCDATA)>
  <!ELEMENT details (#PCDATA|emph|linebreak)*>
  <!ELEMENT note (#PCDATA)>
  <!ELEMENT emph (#PCDATA)>
  <!ELEMENT linebreak EMPTY>
  <!ENTITY mark "&#x2063;">
  <!ENTITY phrase "A &mark;small&#xA;catalog">
]>
<catalog>
  <section xml:lang="en">
    <title>&phrase;</title>
    <item code="i001" category="sample">
      <name>Alpha</name>
      <price>10.00</price>
      <details>first<emph> highlighted</emph><linebreak/>second</details>
    </item>
    <note><![CDATA[raw ]]> content &amp; boundaries</note>
  </section>
</catalog>