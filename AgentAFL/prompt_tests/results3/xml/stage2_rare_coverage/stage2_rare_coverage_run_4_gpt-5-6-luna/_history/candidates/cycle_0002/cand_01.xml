<?xml version="1.0"?>
<!DOCTYPE manuscript [
  <!ELEMENT manuscript (frontmatter, body, appendix?)>
  <!ELEMENT frontmatter (title, author+)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT author (#PCDATA)>
  <!ELEMENT body (chapter+)>
  <!ELEMENT chapter (heading, paragraph+, note*)>
  <!ELEMENT heading (#PCDATA)>
  <!ELEMENT paragraph (#PCDATA|quote|code|br)*>
  <!ELEMENT quote (#PCDATA)>
  <!ELEMENT code (#PCDATA)>
  <!ELEMENT br EMPTY>
  <!ELEMENT note (#PCDATA)>
  <!ELEMENT appendix (entry*)>
  <!ELEMENT entry (#PCDATA)>
  <!ATTLIST chapter id ID #REQUIRED>
  <!ATTLIST note ref IDREF #IMPLIED>
  <!ENTITY emdash "&#x2014;">
  <!ENTITY sample "<code>&lt;token value='x'/&gt;</code>">
]>
<manuscript>
  <frontmatter>
    <title>Edges &amp; Boundaries</title>
    <author>R. Parser</author>
    <author>Σ. Node</author>
  </frontmatter>
  <body>
    <chapter id="intro">
      <heading>Opening &emdash; test</heading>
      <paragraph>Before<quote>quoted &amp; escaped</quote>after<br/>again.</paragraph>
      <paragraph>&sample;</paragraph>
      <note ref="intro">A self-referential-looking identifier.</note>
    </chapter>
  </body>
  <appendix>
    <entry>one</entry>
    <entry>two</entry>
  </appendix>
</manuscript>