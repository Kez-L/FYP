<?xml version="1.0"?>
<!DOCTYPE catalog [
  <!ELEMENT catalog (section+)>
  <!ELEMENT section (title, item*)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT item (#PCDATA|label|ref)*>
  <!ELEMENT label EMPTY>
  <!ELEMENT ref EMPTY>
  <!ATTLIST section code ID #REQUIRED>
  <!ATTLIST item kind (plain|linked|marked) "plain">
  <!ATTLIST label key CDATA #IMPLIED>
  <!ATTLIST ref target IDREF #IMPLIED>
]>
<catalog>
  <section code="s-alpha">
    <title>Mixed <label key="x"/> content</title>
    <item kind="linked">before<ref target="s-alpha"/>after</item>
    <item kind="marked"><![CDATA[<not-an-element>&still-data]]></item>
  </section>
</catalog>