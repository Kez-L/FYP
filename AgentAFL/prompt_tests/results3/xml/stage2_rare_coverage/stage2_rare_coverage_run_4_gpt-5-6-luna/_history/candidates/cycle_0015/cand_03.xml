<?xml version="1.0"?>
<!DOCTYPE report [
  <!ELEMENT report (metadata, payload)>
  <!ELEMENT metadata (field*)>
  <!ELEMENT field EMPTY>
  <!ATTLIST field key CDATA #REQUIRED value CDATA #IMPLIED>
  <!ELEMENT payload (entry+)>
  <!ELEMENT entry (label, value)>
  <!ATTLIST entry ref ID #REQUIRED>
  <!ELEMENT label (#PCDATA)>
  <!ELEMENT value (#PCDATA|code)*>
  <!ELEMENT code (#PCDATA)>
  <!ENTITY % extra "<!ELEMENT diagnostic (#PCDATA)>">
  %extra;
]>
<report>
  <metadata>
    <field key="source" value="synthetic"/>
    <field key="empty"/>
  </metadata>
  <payload>
    <entry ref="r1">
      <label>First</label>
      <value>plain <code>if (x &lt; 2) return;</code></value>
    </entry>
    <entry ref="r2">
      <label>Second</label>
      <value><![CDATA[line one
line two
]]></value>
    </entry>
  </payload>
</report>