<?xml version="1.0" encoding="UTF-8"?>
<configuration xmlns="urn:config">
  <profiles>
    <profile name="minimal">
      <inherits/>
      <setting key="enabled" value="false"/>
    </profile>
    <profile name="production">
      <inherits profile="minimal"/>
      <setting key="endpoint">
        <url scheme="https" host="example.invalid" port="443">
          <path>/v1/resource</path>
          <query>
            <parameter name="a">1</parameter>
            <parameter name="b">x&amp;y</parameter>
          </query>
        </url>
      </setting>
      <setting key="retries">
        <values>
          <value>0</value>
          <value>1</value>
          <value>2</value>
        </values>
      </setting>
    </profile>
  </profiles>
  <overrides>
    <override profile="production" key="endpoint">
      <reason><![CDATA[temporary <maintenance> window]]></reason>
      <expires at="2026-10-01T00:00:00Z"/>
    </override>
  </overrides>
</configuration>