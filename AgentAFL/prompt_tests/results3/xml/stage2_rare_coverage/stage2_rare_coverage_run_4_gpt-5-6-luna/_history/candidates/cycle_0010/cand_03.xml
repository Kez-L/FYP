<?xml version="1.0"?>
<!DOCTYPE graph [
  <!ELEMENT graph (vertex*, edge*)>
  <!ELEMENT vertex (label?, attribute*)>
  <!ATTLIST vertex id ID #REQUIRED>
  <!ELEMENT label (#PCDATA)>
  <!ELEMENT attribute (#PCDATA)>
  <!ATTLIST attribute key NMTOKEN #REQUIRED>
  <!ELEMENT edge EMPTY>
  <!ATTLIST edge from IDREF #REQUIRED to IDREF #REQUIRED weight CDATA #IMPLIED>
  <!NOTATION binary SYSTEM "application/octet-stream">
  <!ENTITY blob SYSTEM "data.bin" NDATA binary>
]>
<graph>
  <vertex id="v0">
    <label><![CDATA[root]]></label>
    <attribute key="kind">hub</attribute>
  </vertex>
  <vertex id="v1"><label>leaf &lt; one</label></vertex>
  <vertex id="v2"/>
  <edge from="v0" to="v1" weight="0.0"/>
  <edge from="v1" to="v2" weight="-1.25"/>
  <edge from="v2" to="v0" weight="NaN"/>
</graph>