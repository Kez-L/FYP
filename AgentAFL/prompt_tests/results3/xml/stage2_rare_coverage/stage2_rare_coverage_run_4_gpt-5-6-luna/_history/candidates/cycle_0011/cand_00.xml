<?xml version="1.1"?>
<!DOCTYPE manifest [
  <!ELEMENT manifest (section+, trailer?)>
  <!ELEMENT section (item*, note?)>
  <!ELEMENT item (#PCDATA|ref|empty)*>
  <!ELEMENT ref EMPTY>
  <!ELEMENT empty EMPTY>
  <!ELEMENT note (#PCDATA)>
  <!ELEMENT trailer (#PCDATA)>
  <!ATTLIST manifest version NMTOKEN #REQUIRED>
  <!ATTLIST section id ID #IMPLIED kind (alpha|beta|other) "other">
  <!ATTLIST item code CDATA #IMPLIED>
  <!ATTLIST ref target IDREF #REQUIRED>
  <!ENTITY greeting "hello &amp; goodbye">
  <!NOTATION plain SYSTEM "text/plain">
]>
<manifest version="1.1">
  <section id="s1" kind="alpha">
    <item code="A">&greeting;<ref target="s2"/><empty/></item>
    <item code="B">line one&#x85;line two</item>
    <note xml:space="preserve">  padded
text  </note>
  </section>
  <section id="s2">
    <item code="C">tail</item>
  </section>
  <trailer>done</trailer>
</manifest>