<?xml version="1.0"?>
<!DOCTYPE map [
  <!ELEMENT map ANY>
  <!ELEMENT node ANY>
  <!ATTLIST node
    name CDATA #REQUIRED
    parent IDREF #IMPLIED
    kind (branch|leaf) "leaf">
  <!ENTITY open "<node name='generated' kind='leaf'>">
  <!ENTITY close "</node>">
]>
<?build mode="test"?>
<map>
  <node name="root" kind="branch">
    <node name="left" parent="root">
      <![CDATA[raw ]]> text
      <node name="left-left" parent="left"/>
    </node>
    <node name="right" parent="root">
      &open;payload&close;
    </node>
  </node>
</map>