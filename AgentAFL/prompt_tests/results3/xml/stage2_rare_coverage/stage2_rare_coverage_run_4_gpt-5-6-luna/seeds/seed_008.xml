<?xml version="1.1"?>
<!DOCTYPE graph [
  <!ELEMENT graph (node+, edge*)>
  <!ELEMENT node (label?, property*)>
  <!ELEMENT edge EMPTY>
  <!ELEMENT label (#PCDATA)>
  <!ELEMENT property (#PCDATA)>
  <!ATTLIST node id ID #REQUIRED>
  <!ATTLIST edge from IDREF #REQUIRED to IDREF #REQUIRED weight CDATA "1">
  <!ATTLIST property key NMTOKEN #REQUIRED>
]>
<graph>
  <node id="n0">
    <label>root</label>
    <property key="empty"></property>
    <property key="unicode">line one&#x85;line two</property>
  </node>
  <node id="n1">
    <label><![CDATA[left < right && right > left]]></label>
  </node>
  <node id="n2"/>
  <edge from="n0" to="n1" weight="0"/>
  <edge from="n1" to="n2" weight="-3.14159"/>
  <edge from="n2" to="n0" weight="NaN"/>
</graph>