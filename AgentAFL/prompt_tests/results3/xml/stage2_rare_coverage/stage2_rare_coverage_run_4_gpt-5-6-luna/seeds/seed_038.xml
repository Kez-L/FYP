<?xml version="1.0"?>
<!DOCTYPE library [
  <!ELEMENT library (shelf*)>
  <!ELEMENT shelf (book|magazine|empty)*>
  <!ATTLIST shelf code ID #REQUIRED>
  <!ELEMENT book (title, author+, isbn?, summary?)>
  <!ATTLIST book edition CDATA #IMPLIED>
  <!ELEMENT magazine (title, issue, article+)>
  <!ELEMENT empty EMPTY>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT author (#PCDATA)>
  <!ELEMENT isbn (#PCDATA)>
  <!ELEMENT summary (#PCDATA|quote|em)*>
  <!ELEMENT issue (#PCDATA)>
  <!ELEMENT article (heading, paragraph+)>
  <!ELEMENT heading (#PCDATA)>
  <!ELEMENT paragraph (#PCDATA|em|quote|ref)*>
  <!ELEMENT quote (#PCDATA)>
  <!ELEMENT em (#PCDATA)>
  <!ELEMENT ref EMPTY>
  <!ATTLIST ref target IDREF #REQUIRED>
  <!ENTITY nbsp "&#160;">
  <!ENTITY open "<">
]>
<library>
  <shelf code="fiction">
    <book edition="2">
      <title>Things &amp; Other Things</title>
      <author>R. Example</author>
      <author>A. Reader</author>
      <isbn>978-0-00-000000-0</isbn>
      <summary>A <em>short</em> summary&nbsp;<quote>with a quote</quote>.</summary>
    </book>
    <empty/>
  </shelf>
  <shelf code="periodicals">
    <magazine>
      <title>Signals</title>
      <issue>10/2026</issue>
      <article>
        <heading>Boundary Cases</heading>
        <paragraph>Use <ref target="fiction"/> when comparing <em>old</em> data.</paragraph>
        <paragraph><![CDATA[Characters such as <, >, and & remain literal here.]]></paragraph>
      </article>
    </magazine>
  </shelf>
</library>