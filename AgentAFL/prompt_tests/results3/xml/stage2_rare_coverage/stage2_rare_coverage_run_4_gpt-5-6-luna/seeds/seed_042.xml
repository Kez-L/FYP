<?xml version="1.0"?>
<!DOCTYPE tree [
  <!ELEMENT tree (node)>
  <!ELEMENT node (label?, node*)>
  <!ATTLIST node
    id ID #IMPLIED
    parent IDREF #IMPLIED
    kind NMTOKENS #IMPLIED>
  <!ELEMENT label (#PCDATA)>
]>
<tree>
  <node id="root" kind="top root">
    <label>root</label>
    <node id="left" parent="root" kind="branch">
      <label>left</label>
      <node id="leaf1" parent="left" kind="terminal"/>
      <node id="leaf2" parent="left" kind="terminal">
        <label>line&#x0A;break</label>
      </node>
    </node>
    <node id="right" parent="root" kind="branch">
      <node id="leaf3" parent="right" kind="terminal"/>
    </node>
  </node>
</tree>