<?xml version="1.0"?>
<!DOCTYPE registry [
  <!NOTATION gif SYSTEM "image/gif">
  <!NOTATION png PUBLIC "-//Example//NOTATION PNG//EN" "image/png">
  <!ENTITY logo SYSTEM "logo.gif" NDATA gif>
  <!ELEMENT registry (entry*)>
  <!ELEMENT entry (label, metadata?, value)>
  <!ATTLIST entry
    id ID #REQUIRED
    alias IDREF #IMPLIED
    asset ENTITY #IMPLIED
    format NOTATION (gif|png) #IMPLIED
    flags NMTOKENS #IMPLIED>
  <!ELEMENT label (#PCDATA)>
  <!ELEMENT metadata (author|tag|tag)+>
  <!ELEMENT author (#PCDATA)>
  <!ELEMENT tag (#PCDATA)>
  <!ELEMENT value (#PCDATA|code)*>
  <!ELEMENT code (#PCDATA)>
  <!ENTITY intro "registered &amp; verified">
]>
<registry>
  <entry id="root" flags="a b c" format="gif" asset="logo">
    <label>&intro;</label>
    <metadata>
      <author>system</author>
      <tag>one</tag>
      <tag>two</tag>
    </metadata>
    <value>prefix<code>if (x &lt; y) return;</code>suffix</value>
  </entry>
  <entry id="child" alias="root" flags="single">
    <label>second</label>
    <value><![CDATA[alpha ]]> beta</value>
  </entry>
</registry>