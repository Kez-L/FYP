<?xml version="1.0"?>
<!DOCTYPE catalog [
  <!ELEMENT catalog (section+, note?)>
  <!ELEMENT section (item*)>
  <!ATTLIST section code ID #REQUIRED>
  <!ELEMENT item (label, value?, item*)>
  <!ATTLIST item key CDATA #IMPLIED state (new|old|void) "new">
  <!ELEMENT label (#PCDATA)>
  <!ELEMENT value (#PCDATA|item)*>
  <!ELEMENT note (#PCDATA)>
]>
<catalog>
  <section code="root">
    <item key="α" state="new">
      <label>first</label>
      <value><![CDATA[x < y && y > z]]></value>
      <item key="nested" state="void">
        <label>leaf</label>
      </item>
    </item>
    <item key="empty">
      <label/>
      <value>left<item key="inside"><label>right</label></item>end</value>
    </item>
  </section>
  <note>tail &amp; text</note>
</catalog>