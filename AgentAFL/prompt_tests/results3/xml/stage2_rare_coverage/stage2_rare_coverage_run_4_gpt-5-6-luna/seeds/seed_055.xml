<?xml version="1.0"?>
<!DOCTYPE catalog [
  <!ENTITY company "Example &amp; Sons">
  <!ENTITY greeting "Welcome to &company;">
  <!ELEMENT catalog (section+)>
  <!ELEMENT section (item*, note?)>
  <!ATTLIST section code ID #REQUIRED>
  <!ELEMENT item (#PCDATA|detail)*>
  <!ATTLIST item ref IDREF #IMPLIED state (new|used|archived) "new">
  <!ELEMENT detail EMPTY>
  <!ATTLIST detail key CDATA #REQUIRED value CDATA #IMPLIED>
  <!ELEMENT note (#PCDATA)>
]>
<catalog>
  <section code="s1">
    <item ref="i2">First <detail key="kind" value="primary"/> entry</item>
    <item ref="i1" state="archived">Second entry</item>
    <note>&greeting;</note>
  </section>
  <section code="s2">
    <item ref="i1">Referenced item</item>
  </section>
</catalog>