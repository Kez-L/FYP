<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE archive [
  <!ENTITY greeting "hello">
  <!ENTITY twice "&greeting; &greeting;">
  <!ELEMENT archive (header, record+)>
  <!ELEMENT header (#PCDATA)>
  <!ELEMENT record (key, value, note?)>
  <!ELEMENT key (#PCDATA)>
  <!ELEMENT value (#PCDATA|em|br)*>
  <!ELEMENT note (#PCDATA)>
  <!ELEMENT em (#PCDATA)>
  <!ELEMENT br EMPTY>
  <!ATTLIST record state (open|closed) "open">
]>
<archive>
  <header>&twice;</header>
  <record state="closed">
    <key>α&amp;β</key>
    <value>left<em>middle</em>right<br/>tail</value>
    <note>contains &lt;markup&gt;</note>
  </record>
</archive>