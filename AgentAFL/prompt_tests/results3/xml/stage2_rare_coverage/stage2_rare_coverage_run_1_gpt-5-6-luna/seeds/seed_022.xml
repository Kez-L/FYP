<?xml version="1.0"?>
<!DOCTYPE message [
  <!ELEMENT message (meta, body, attachment*)>
  <!ELEMENT meta (from, to+, timestamp)>
  <!ELEMENT from (#PCDATA)>
  <!ELEMENT to (#PCDATA)>
  <!ELEMENT timestamp (#PCDATA)>
  <!ELEMENT body (p|quote|list)*>
  <!ELEMENT p (#PCDATA|link|br)*>
  <!ELEMENT quote (#PCDATA|p)*>
  <!ELEMENT list (item+)>
  <!ELEMENT item (#PCDATA|p)*>
  <!ELEMENT link (#PCDATA)>
  <!ELEMENT br EMPTY>
  <!ELEMENT attachment EMPTY>
  <!ATTLIST attachment filename CDATA #REQUIRED media CDATA #IMPLIED>
]>
<message>
  <meta>
    <from>sender@example.test</from>
    <to>one@example.test</to>
    <to>two@example.test</to>
    <timestamp>2026-09-23T12:34:56Z</timestamp>
  </meta>
  <body>
    <p>Hello <link>world</link><br/>again.</p>
    <quote><p>Nested quotation.</p></quote>
    <list>
      <item>first</item>
      <item><p>second paragraph</p><p>continuation</p></item>
    </list>
  </body>
  <attachment filename="empty.bin" media="application/octet-stream"/>
</message>