<?xml version="1.0"?>
<!DOCTYPE envelope [
  <!ELEMENT envelope (header, body)>
  <!ELEMENT header EMPTY>
  <!ATTLIST header
    from CDATA #IMPLIED
    to CDATA #IMPLIED
    flags NMTOKENS #IMPLIED>
  <!ELEMENT body (chunk+)>
  <!ELEMENT chunk (#PCDATA)>
  <!ENTITY left "(">
  <!ENTITY right ")">
]>
<envelope>
  <header from="a&amp;b" to="receiver" flags="urgent encrypted"/>
  <body>
    <chunk>&left;first&right;</chunk>
    <chunk>second&#x0A;line&#10;end</chunk>
    <chunk>third &quot;quoted&quot; &apos;text&apos;</chunk>
  </body>
</envelope>