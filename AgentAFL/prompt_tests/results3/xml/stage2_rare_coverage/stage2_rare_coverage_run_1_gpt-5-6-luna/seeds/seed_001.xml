<?xml version="1.0"?>
<!DOCTYPE message [
  <!ENTITY greeting "Hello">
  <!ENTITY target "world">
  <!ELEMENT message (header, body, footer?)>
  <!ELEMENT header (#PCDATA)>
  <!ELEMENT body (p+)>
  <!ELEMENT p (#PCDATA|em|br)*>
  <!ELEMENT em (#PCDATA)>
  <!ELEMENT br EMPTY>
  <!ELEMENT footer (#PCDATA)>
]>
<message>
  <header>&greeting;, &target;!</header>
  <body>
    <p>Text <em>with emphasis</em><br/>after a break.</p>
    <p>Second paragraph with &lt;escaped&gt; characters.</p>
  </body>
  <footer>End</footer>
</message>