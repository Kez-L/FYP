<?xml version="1.1"?>
<!DOCTYPE map [
  <!ELEMENT map (node|value)*>
  <!ELEMENT node (key, map)>
  <!ELEMENT value (#PCDATA)>
  <!ELEMENT key (#PCDATA)>
  <!ATTLIST node id ID #IMPLIED>
  <!ENTITY nbsp "&#160;">
]>
<map>
  <node id="root">
    <key>root</key>
    <map>
      <value>first&nbsp;value</value>
      <node>
        <key>nested</key>
        <map>
          <value>line one
line two</value>
        </map>
      </node>
    </map>
  </node>
  <value><![CDATA[
  preserved
  whitespace
  ]]></value>
</map>