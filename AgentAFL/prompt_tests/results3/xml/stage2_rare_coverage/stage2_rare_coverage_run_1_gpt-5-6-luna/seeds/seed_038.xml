<?xml version="1.0"?>
<!DOCTYPE graph [
  <!ELEMENT graph (node+, edge*)>
  <!ELEMENT node (meta*)>
  <!ELEMENT meta EMPTY>
  <!ELEMENT edge EMPTY>
  <!ATTLIST node id ID #REQUIRED>
  <!ATTLIST meta key CDATA #REQUIRED value CDATA #IMPLIED>
  <!ATTLIST edge from IDREF #REQUIRED to IDREF #REQUIRED weight CDATA "1">
]>
<graph>
  <node id="n-root">
    <meta key="role" value="entry"/>
    <meta key="empty"/>
  </node>
  <node id="n-leaf">
    <meta key="quoted" value="a &quot;b&quot; c"/>
  </node>
  <edge from="n-root" to="n-leaf" weight="0"/>
  <edge from="n-leaf" to="n-root" weight="999999999999999999999999"/>
</graph>