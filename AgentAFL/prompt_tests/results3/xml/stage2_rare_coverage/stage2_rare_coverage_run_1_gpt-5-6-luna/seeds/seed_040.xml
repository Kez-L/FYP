<?xml version="1.0"?>
<!DOCTYPE catalog [
  <!ELEMENT catalog (entry+)>
  <!ELEMENT entry (name, tags?, description)>
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT tags (tag+)>
  <!ELEMENT tag (#PCDATA)>
  <!ELEMENT description (#PCDATA|em|br)*>
  <!ELEMENT em (#PCDATA)>
  <!ELEMENT br EMPTY>
  <!ATTLIST entry key ID #REQUIRED status (new|old|archived) "new">
  <!ENTITY company "A &amp; B">
  <!ENTITY note "line&#10;break">
]>
<catalog>
  <entry key="e1" status="new">
    <name>&company; &#x1F4A1;</name>
    <tags><tag>one</tag><tag>two</tag><tag>&lt;three&gt;</tag></tags>
    <description>Text <em>with emphasis</em><br/>and &note;.</description>
  </entry>
  <entry key="e2">
    <name>Second</name>
    <description><![CDATA[raw ]]> content &amp; escaped</description>
  </entry>
</catalog>