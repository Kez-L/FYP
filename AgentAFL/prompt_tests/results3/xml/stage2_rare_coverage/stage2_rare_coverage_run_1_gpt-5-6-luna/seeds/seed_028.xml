<?xml version="1.0"?>
<!DOCTYPE archive [
  <!NOTATION png SYSTEM "image/png">
  <!NOTATION svg SYSTEM "image/svg+xml">
  <!ENTITY cover SYSTEM "urn:asset:cover" NDATA png>
  <!ENTITY diagram SYSTEM "urn:asset:diagram" NDATA svg>
  <!ELEMENT archive (entry*, manifest)>
  <!ELEMENT entry (title, payload?)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT payload EMPTY>
  <!ELEMENT manifest (file+)>
  <!ELEMENT file EMPTY>
  <!ATTLIST entry key ID #REQUIRED kind (binary|text) "text">
  <!ATTLIST payload source ENTITY #IMPLIED>
  <!ATTLIST file name CDATA #REQUIRED format NOTATION (png|svg) #IMPLIED>
]>
<archive>
  <entry key="e1">
    <title>Readme</title>
    <payload/>
  </entry>
  <entry key="e2" kind="binary">
    <title>Cover image</title>
    <payload source="cover"/>
  </entry>
  <manifest>
    <file name="cover.png" format="png"/>
    <file name="diagram.svg" format="svg"/>
    <file name="notes.txt"/>
  </manifest>
</archive>