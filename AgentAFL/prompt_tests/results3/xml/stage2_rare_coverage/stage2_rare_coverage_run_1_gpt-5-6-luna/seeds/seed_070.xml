<?xml version="1.0"?>
<!DOCTYPE catalog [
  <!ELEMENT catalog (section+)>
  <!ELEMENT section (title, entry*)>
  <!ATTLIST section code ID #REQUIRED>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT entry (name, price, note?)>
  <!ATTLIST entry sku ID #REQUIRED status (active|retired) "active">
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT price (#PCDATA)>
  <!ELEMENT note (#PCDATA|emph)*>
  <!ELEMENT emph (#PCDATA)>
  <!ENTITY currency "USD">
]>
<catalog>
  <section code="main">
    <title>Hardware</title>
    <entry sku="p-001">
      <name>Adapter</name>
      <price>19.95 &currency;</price>
      <note>Compact <emph>reversible</emph> connector.</note>
    </entry>
    <entry sku="p-002" status="retired">
      <name>Bridge</name>
      <price>0.00 &currency;</price>
    </entry>
  </section>
</catalog>