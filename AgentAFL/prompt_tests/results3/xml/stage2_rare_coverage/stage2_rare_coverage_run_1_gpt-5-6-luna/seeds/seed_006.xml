<?xml version="1.0"?>
<!DOCTYPE archive [
  <!ELEMENT archive (entry+, index)>
  <!ELEMENT entry (title, tag*, payload)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT tag EMPTY>
  <!ELEMENT payload (#PCDATA|link|br)*>
  <!ELEMENT link (#PCDATA)>
  <!ELEMENT br EMPTY>
  <!ELEMENT index (ref*)>
  <!ELEMENT ref EMPTY>
  <!ATTLIST entry key ID #REQUIRED visibility (public|private) "private">
  <!ATTLIST tag name CDATA #REQUIRED>
  <!ATTLIST link href CDATA #IMPLIED>
  <!ATTLIST ref key IDREF #REQUIRED>
  <!ENTITY mark "&#x2022;">
]>
<archive>
  <entry key="e1" visibility="public">
    <title>Signals &amp; Symbols</title>
    <tag name="xml"/>
    <tag name="fuzz"/>
    <payload>alpha &mark; <link href="urn:one">first</link><br/>omega</payload>
  </entry>
  <entry key="e2">
    <title>Detached note</title>
    <payload><![CDATA[line one
line two ]]> <link>unresolved-href</link></payload>
  </entry>
  <index>
    <ref key="e2"/>
    <ref key="e1"/>
  </index>
</archive>