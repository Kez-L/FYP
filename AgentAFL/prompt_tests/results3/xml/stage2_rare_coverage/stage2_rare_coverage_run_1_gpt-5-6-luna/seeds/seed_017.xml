<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE map [
  <!ELEMENT map (layer+, legend)>
  <!ELEMENT layer (feature*)>
  <!ELEMENT feature (geometry, properties)>
  <!ELEMENT geometry (point|line|polygon)>
  <!ELEMENT point EMPTY>
  <!ELEMENT line (point+)>
  <!ELEMENT polygon (ring+)>
  <!ELEMENT ring (point+)>
  <!ELEMENT properties (property*)>
  <!ELEMENT property (#PCDATA)>
  <!ELEMENT legend (#PCDATA)>
  <!ATTLIST layer name CDATA #REQUIRED visible (true|false) "true">
  <!ATTLIST feature fid ID #REQUIRED>
  <!ATTLIST point x CDATA #REQUIRED y CDATA #REQUIRED>
  <!ATTLIST property key NMTOKEN #REQUIRED>
]>
<map>
  <layer name="roads" visible="true">
    <feature fid="road-1">
      <geometry>
        <line>
          <point x="-73.9857" y="40.7484"/>
          <point x="-73.9851" y="40.7490"/>
          <point x="-73.9842" y="40.7493"/>
        </line>
      </geometry>
      <properties>
        <property key="name">5th Avenue</property>
        <property key="surface">asphalt</property>
      </properties>
    </feature>
  </layer>
  <layer name="parks" visible="false">
    <feature fid="park-9">
      <geometry>
        <polygon>
          <ring>
            <point x="10" y="10"/>
            <point x="20" y="10"/>
            <point x="20" y="20"/>
            <point x="10" y="20"/>
            <point x="10" y="10"/>
          </ring>
        </polygon>
      </geometry>
      <properties>
        <property key="name">Jardin d'été</property>
      </properties>
    </feature>
  </layer>
  <legend>Coordinates use WGS84; empty layers are permitted.</legend>
</map>