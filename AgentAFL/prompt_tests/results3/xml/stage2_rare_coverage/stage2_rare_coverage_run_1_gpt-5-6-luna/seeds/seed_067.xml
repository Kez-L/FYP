<?xml version="1.0"?>
<!DOCTYPE map [
  <!ELEMENT map (node)>
  <!ELEMENT node (name, node*)>
  <!ELEMENT name (#PCDATA)>
  <!ATTLIST node key NMTOKEN #IMPLIED>
]>
<map>
  <node key="root">
    <name>root</name>
    <node key="left">
      <name>left</name>
      <node key="leaf-1"><name>one</name></node>
      <node key="leaf-2"><name>two</name></node>
    </node>
    <node key="right">
      <name>right</name>
      <node key="deep">
        <name>deep</name>
        <node key="bottom"><name>bottom</name></node>
      </node>
    </node>
  </node>
</map>