<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE catalog [
  <!ELEMENT catalog (section+)>
  <!ELEMENT section (title, entry*)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT entry (name, description, price?, availability)>
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT description (#PCDATA|em|code)*>
  <!ELEMENT em (#PCDATA)>
  <!ELEMENT code (#PCDATA)>
  <!ELEMENT price (#PCDATA)>
  <!ELEMENT availability EMPTY>
  <!ATTLIST section id ID #REQUIRED xml:lang NMTOKEN #IMPLIED>
  <!ATTLIST entry sku ID #REQUIRED category NMTOKEN #IMPLIED>
  <!ATTLIST availability state (in-stock|backorder|retired) "in-stock">
  <!ENTITY brand "Example &amp; Sons">
]>
<catalog>
  <section id="tools" xml:lang="en">
    <title>&brand; tools</title>
    <entry sku="item-001" category="hand">
      <name>Ratcheting &amp;ldquo;</name>
      <description>Compact <em>reversible</em> handle with <code>1/4-inch</code> drive.</description>
      <price currency="EUR">19.95</price>
      <availability state="in-stock"/>
    </entry>
    <entry sku="item-002">
      <name>Long nose pliers</name>
      <description><![CDATA[Jaw length: 42 mm; finish: matte <steel>.]]></description>
      <availability state="backorder"/>
    </entry>
  </section>
</catalog>