<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE map [
  <!ELEMENT map (node)>
  <!ELEMENT node (name, node*)>
  <!ATTLIST node kind CDATA "branch">
  <!ELEMENT name (#PCDATA)>
]>
<map>
  <node kind="root">
    <name>root</name>
    <node kind="leaf">
      <name>north</name>
    </node>
    <node kind="branch">
      <name>south</name>
      <node>
        <name>south-east</name>
        <node kind="leaf">
          <name>terminal</name>
        </node>
      </node>
      <node kind="leaf">
        <name>south-west</name>
      </node>
    </node>
  </node>
</map>