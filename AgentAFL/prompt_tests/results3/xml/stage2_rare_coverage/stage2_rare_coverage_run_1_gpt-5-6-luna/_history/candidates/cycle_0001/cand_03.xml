<?xml version="1.0"?>
<!DOCTYPE root [
  <!ELEMENT root (section*)>
  <!ELEMENT section (title, content)>
  <!ATTLIST section name CDATA #IMPLIED>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT content ANY>
  <!ENTITY local "replacement text">
]>
<root>
  <section name="first">
    <title>One</title>
    <content>
      <!-- comment containing symbols: < > & -- -->
      <node level="1">
        <node level="2">
          <node level="3">&local;</node>
        </node>
      </node>
      <?instruction a="1" b="&quot;"?>
    </content>
  </section>
  <section>
    <title>Two</title>
    <content><![CDATA[
      line one
      line two
      ]]></content>
  </section>
</root>