<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE computation [
  <!ENTITY one "1">
  <!ENTITY two "&one;&one;">
  <!ENTITY four "&two;&two;">
  <!ENTITY eight "&four;&four;">
  <!ELEMENT computation (input, steps, result)>
  <!ELEMENT input EMPTY>
  <!ELEMENT steps (step*)>
  <!ELEMENT step (operand, operator, operand)>
  <!ELEMENT operand (#PCDATA)>
  <!ELEMENT operator EMPTY>
  <!ELEMENT result (#PCDATA)>
  <!ATTLIST input value CDATA #REQUIRED radix CDATA "10">
  <!ATTLIST step number CDATA #REQUIRED>
  <!ATTLIST operator symbol CDATA #REQUIRED>
]>
<computation>
  <input value="&eight;" radix="10"/>
  <steps>
    <step number="1">
      <operand>8</operand>
      <operator symbol="*"/>
      <operand>3</operand>
    </step>
    <step number="2">
      <operand>24</operand>
      <operator symbol="-"/>
      <operand><![CDATA[ 5 ]]></operand>
    </step>
    <step number="3">
      <operand>19</operand>
      <operator symbol="mod"/>
      <operand>7</operand>
    </step>
  </steps>
  <result>5</result>
</computation>