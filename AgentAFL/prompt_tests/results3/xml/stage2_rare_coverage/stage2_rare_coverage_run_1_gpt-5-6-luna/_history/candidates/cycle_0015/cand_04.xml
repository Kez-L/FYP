<?xml version="1.0"?>
<configuration>
  <profiles>
    <profile id="minimal" enabled="yes">
      <property name="retry">0</property>
      <property name="timeout">PT0S</property>
      <modules/>
    </profile>
    <profile id="full" enabled="no">
      <property name="retry">5</property>
      <property name="timeout">PT1H2M3.004S</property>
      <modules>
        <module name="parser" version="1.2.3">
          <option key="strict">false</option>
          <option key="trace">true</option>
        </module>
        <module name="renderer" version="0.0.0">
          <option key="format">text/xml</option>
        </module>
      </modules>
    </profile>
  </profiles>
  <fallback>
    <when code="missing">
      <action>ignore</action>
    </when>
    <when code="invalid">
      <action>report</action>
      <message>configuration requires review</message>
    </when>
  </fallback>
</configuration>