<?xml version="1.1"?>
<!DOCTYPE packet [
  <!ELEMENT packet (header, body, trailer)>
  <!ELEMENT header (field*)>
  <!ELEMENT field (#PCDATA)>
  <!ELEMENT body (record*)>
  <!ELEMENT record (key, value*)>
  <!ELEMENT key (#PCDATA)>
  <!ELEMENT value (#PCDATA|part)*>
  <!ELEMENT part (#PCDATA)>
  <!ELEMENT trailer EMPTY>
  <!ATTLIST record n NMTOKEN #REQUIRED>
]>
<packet>
  <header>
    <field>alpha</field>
    <field>beta&#x85;gamma</field>
  </header>
  <body>
    <record n="r-01">
      <key>status</key>
      <value>open</value>
      <value><part>left</part>&#x2028;<part>right</part></value>
    </record>
    <record n="r-02">
      <key>payload</key>
      <value><![CDATA[raw &lt; bytes]]></value>
    </record>
  </body>
  <trailer/>
</packet>