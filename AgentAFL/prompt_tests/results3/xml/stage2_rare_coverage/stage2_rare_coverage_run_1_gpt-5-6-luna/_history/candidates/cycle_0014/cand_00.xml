<?xml version="1.0"?>
<!DOCTYPE catalog [
  <!ELEMENT catalog (section+, footer?)>
  <!ELEMENT section (title, entry*)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT entry (name, price, note?)>
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT price (#PCDATA)>
  <!ELEMENT note (#PCDATA|emph|br)*>
  <!ELEMENT emph (#PCDATA)>
  <!ELEMENT br EMPTY>
  <!ELEMENT footer (#PCDATA)>
  <!ATTLIST section code ID #IMPLIED>
  <!ATTLIST entry sku ID #REQUIRED status (new|old|hold) "new">
  <!ENTITY mark "&#x2605;">
]>
<catalog>
  <section code="s1">
    <title>Tools &amp; Parts</title>
    <entry sku="p1" status="new">
      <name>socket</name>
      <price>19.95</price>
      <note>preferred &mark; <emph>limited</emph><br/>stock</note>
    </entry>
  </section>
  <footer>End</footer>
</catalog>