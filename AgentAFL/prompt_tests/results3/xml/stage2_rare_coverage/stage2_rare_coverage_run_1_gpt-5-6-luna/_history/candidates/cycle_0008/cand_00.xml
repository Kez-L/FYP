<?xml version="1.0"?>
<!DOCTYPE library [
  <!ELEMENT library (section+, note?)>
  <!ELEMENT section (title, book*)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT book (name, author+, summary?)>
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT author (#PCDATA)>
  <!ELEMENT summary (#PCDATA|em|ref)*>
  <!ELEMENT em (#PCDATA)>
  <!ELEMENT ref EMPTY>
  <!ELEMENT note (#PCDATA)>
  <!ATTLIST book code ID #REQUIRED edition CDATA "first">
  <!ATTLIST ref target IDREF #IMPLIED>
  <!ENTITY copyright "© 2026">
  <!ENTITY intro "A &emph;small&emph; collection">
  <!ENTITY emph "compact">
]>
<library>
  <section>
    <title>&intro;</title>
    <book code="b1" edition="&copyright;">
      <name>Parsing &amp; Trees</name>
      <author>One</author>
      <author>Two</author>
      <summary>Text <em>with emphasis</em> and a <ref target="b1"/> link.</summary>
    </book>
  </section>
  <note>End &amp; review.</note>
</library>