<?xml version="1.0"?>
<!DOCTYPE catalog [
  <!ELEMENT catalog (section+)>
  <!ELEMENT section (title, entry*)>
  <!ATTLIST section code ID #REQUIRED>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT entry (name, price?, note?)>
  <!ATTLIST entry ref IDREF #IMPLIED status (new|used|archived) "new">
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT price (#PCDATA)>
  <!ELEMENT note (#PCDATA|emph)*>
  <!ELEMENT emph (#PCDATA)>
  <!ENTITY currency "€">
]>
<catalog>
  <section code="s-main">
    <title>Special offers</title>
    <entry ref="item-1" status="new">
      <name>Glass &amp; Stone</name>
      <price>19 &currency; 95</price>
      <note>Limited <emph>edition</emph> available.</note>
    </entry>
    <entry ref="item-2">
      <name>Plain item</name>
      <note><![CDATA[raw <markup> and ]] characters]]></note>
    </entry>
  </section>
</catalog>