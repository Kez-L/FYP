  <!ELEMENT entry (#PCDATA|em|br)*>
  <!ELEMENT em (#PCDATA)>
  <!ELEMENT br EMPTY>
  <!ELEMENT note (#PCDATA)>
  <!ATTLIST section code ID #REQUIRED>
  <!ATTLIST entry ref IDREF #IMPLIED>
  <!ENTITY mark "&#x2603;">
  <!ENTITY phrase "catalog &amp; index">
]>
<catalog>
  <section code="s1">
    <title>Symbols &amp; &mark;</title>
    <entry ref="s1">First <em>annotated</em> item<br/>continues.</entry>
    <entry>Second <![CDATA[raw <markup> and ]]> delimiters]]>.</entry>
  </section>
  <note>Use &phrase; when searching.</note>
</catalog>