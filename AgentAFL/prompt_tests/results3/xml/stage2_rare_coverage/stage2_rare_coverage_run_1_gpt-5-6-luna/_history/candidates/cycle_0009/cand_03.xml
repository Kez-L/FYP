<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE message [
  <!ELEMENT message (header, body, attachment*)>
  <!ELEMENT header (from, to, subject)>
  <!ELEMENT from (#PCDATA)>
  <!ELEMENT to (#PCDATA)>
  <!ELEMENT subject (#PCDATA)>
  <!ELEMENT body (#PCDATA|link)*>
  <!ELEMENT link (#PCDATA)>
  <!ELEMENT attachment EMPTY>
  <!ATTLIST attachment href CDATA #REQUIRED media CDATA #IMPLIED>
]>
<message>
  <header>
    <from>sender@example.test</from>
    <to>receiver@example.test</to>
    <subject>Entities &amp; markup</subject>
  </header>
  <body>Visit <link href="https://example.test/?a=1&amp;b=2">this link</link> now.</body>
  <attachment href="data:text/plain;base64,SGVsbG8=" media="text/plain"/>
</message>