<?xml version="1.0"?>
<!DOCTYPE universe [
  <!ENTITY greeting "hello">
  <!ENTITY recursive "&greeting;, universe">
  <!NOTATION jpg SYSTEM "image/jpeg">
  <!ELEMENT universe (region*)>
  <!ELEMENT region (world|void|world)*>
  <!ATTLIST region name CDATA #IMPLIED>
  <!ELEMENT world (continent*)>
  <!ATTLIST world id ID #IMPLIED>
  <!ELEMENT continent (#PCDATA|city)*>
  <!ATTLIST continent code CDATA #IMPLIED>
  <!ELEMENT city EMPTY>
  <!ATTLIST city name CDATA #REQUIRED population NMTOKEN #IMPLIED>
  <!ELEMENT void EMPTY>
  <!ATTLIST void kind (black-hole|empty) "empty">
]>
<universe>
  <region name="north">
    <world id="earth">
      <continent code="EU">The &recursive; <city name="Paris" population="2161000"/></continent>
      <continent code="AS">
        <city name="Tokyo" population="14000000"/>
      </continent>
    </world>
    <void kind="black-hole"/>
    <world>
      <continent code="OC"><city name="Suva"/></continent>
    </world>
  </region>
  <region name="empty"/>
</universe>