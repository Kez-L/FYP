<?xml version="1.0"?>
<!DOCTYPE catalog [
  <!ELEMENT catalog (section+)>
  <!ELEMENT section (entry*)>
  <!ATTLIST section name CDATA #REQUIRED>
  <!ELEMENT entry (title, description?, meta*)>
  <!ATTLIST entry key ID #REQUIRED status (new|old|archived) "new">
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT description (#PCDATA|em|br)*>
  <!ELEMENT em (#PCDATA)>
  <!ELEMENT br EMPTY>
  <!ELEMENT meta EMPTY>
  <!ATTLIST meta name NMTOKEN #REQUIRED value CDATA #IMPLIED>
]>
<catalog>
  <section name="alpha">
    <entry key="e1">
      <title>First &amp; only</title>
      <description>text <em>with emphasis</em><br/>after break</description>
      <meta name="empty"/>
    </entry>
    <entry key="e2" status="archived">
      <title>Quotes: &quot;single&quot;</title>
    </entry>
  </section>
</catalog>