<?xml version="1.0"?>
<!DOCTYPE catalog [
  <!ENTITY company "Northwind &amp; Sons">
  <!ENTITY label "inventory">
  <!ENTITY nested "&company; &amp; &label;">
  <!ELEMENT catalog (section+)>
  <!ELEMENT section (title, product*)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT product (name, description?, price)>
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT description (#PCDATA|emph)*>
  <!ELEMENT emph (#PCDATA)>
  <!ELEMENT price (#PCDATA)>
  <!ATTLIST section code ID #REQUIRED>
  <!ATTLIST product sku CDATA #REQUIRED status (active|retired) "active">
]>
<catalog>
  <section code="hardware">
    <title>&nested;</title>
    <product sku="A-001">
      <name>Widget &amp; Gear</name>
      <description>Compact <emph>reusable</emph> component.</description>
      <price>19.95</price>
    </product>
    <product sku="B-002" status="retired">
      <name>Bracket</name>
      <price>7.50</price>
    </product>
  </section>
</catalog>