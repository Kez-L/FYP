<?xml version="1.0"?>
<!DOCTYPE message [
  <!ENTITY greeting "hello">
  <!ENTITY wrapped "&greeting;, world">
  <!ENTITY percent "%not-used;">
  <!ELEMENT message (header, body)>
  <!ELEMENT header (from, to)>
  <!ELEMENT from (#PCDATA)>
  <!ELEMENT to (#PCDATA)>
  <!ELEMENT body (#PCDATA|line|quote)*>
  <!ELEMENT line (#PCDATA)>
  <!ELEMENT quote (#PCDATA)>
]>
<message>
  <header>
    <from>sender@example.test</from>
    <to>receiver@example.test</to>
  </header>
  <body>
    &wrapped;
    <line>one</line>
    <quote>He said: &quot;okay&quot;</quote>
    <line>three</line>
  </body>
</message>