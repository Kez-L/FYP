<?xml version="1.0"?>
<!DOCTYPE catalog [
  <!ELEMENT catalog (section+)>
  <!ELEMENT section (title, entry*)>
  <!ATTLIST section code ID #REQUIRED>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT entry (name, description?, price, availability)>
  <!ATTLIST entry ref ID #REQUIRED category CDATA #IMPLIED>
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT description (#PCDATA|em|br)*>
  <!ELEMENT em (#PCDATA)>
  <!ELEMENT br EMPTY>
  <!ELEMENT price (#PCDATA)>
  <!ELEMENT availability (#PCDATA)>
]>
<catalog>
