    </entry>
    <entry ref="item-2">
      <name>Trackball</name>
      <price>72.00</price>
      <availability>back-order</availability>
    </entry>
  </section>
  <section code="software">
    <title>Software</title>
    <entry ref="item-3" category="tools">
      <name>Parser Suite</name>
      <description>Version &quot;3.0&quot; &amp; maintenance.</description>
      <price>0</price>
