<?xml version="1.0"?>
<!DOCTYPE root [
  <!ELEMENT root (a, b, c?)>
  <!ELEMENT a (x|y|z)>
  <!ELEMENT b (#PCDATA|x|y)*>
  <!ELEMENT c ANY>
  <!ELEMENT x EMPTY>
  <!ELEMENT y EMPTY>
  <!ELEMENT z EMPTY>
  <!ATTLIST root mode (fast|slow|other) "other">
  <!ATTLIST x n CDATA #IMPLIED>
  <!ATTLIST y n CDATA #IMPLIED>
  <!NOTATION bin SYSTEM "application/octet-stream">
  <!ENTITY blob SYSTEM "urn:local:blob" NDATA bin>
]>
<root mode="fast">
  <a><z n="3"/></a>
  <b>text<x n="1"/>more<![CDATA[<b>not markup</b>]]><y n="2"/></b>
  <c>
    <nested level="1">
      <nested level="2"><leaf/></nested>
    </nested>
  </c>
</root>