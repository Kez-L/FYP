<?xml version="1.0"?>
<!DOCTYPE report [
  <!ELEMENT report (section+)>
  <!ELEMENT section (title, item*)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT item (#PCDATA|em|ref)*>
  <!ELEMENT em (#PCDATA)>
  <!ELEMENT ref EMPTY>
  <!ATTLIST section code ID #REQUIRED>
  <!ATTLIST ref target IDREF #IMPLIED>
]>
<report>
  <section code="intro">
    <title>Overview</title>
    <item>This is <em>important</em> and <ref target="missing"/>.</item>
  </section>
</report>