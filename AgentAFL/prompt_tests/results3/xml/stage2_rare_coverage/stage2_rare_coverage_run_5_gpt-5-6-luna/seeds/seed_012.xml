<?xml version="1.0"?>
<!DOCTYPE report [
  <!ELEMENT report (meta, section*)>
  <!ELEMENT meta EMPTY>
  <!ELEMENT section (heading, data)>
  <!ELEMENT heading (#PCDATA)>
  <!ELEMENT data (value|group)*>
  <!ELEMENT value (#PCDATA)>
  <!ELEMENT group (value*)>
  <!ATTLIST meta
    created CDATA #IMPLIED
    mode NMTOKEN "test"
    ref IDREF #IMPLIED>
  <!ATTLIST value kind CDATA #IMPLIED>
  <!ENTITY % common "kind CDATA #IMPLIED">
  <!ENTITY % extra "<!ATTLIST group level NMTOKEN '0'>">
  %extra;
  <!ENTITY left "(">
  <!ENTITY right ")">
]>
<report>
  <meta created="2026-10-01T00:00:00Z" mode="x:y" ref="missing"/>
  <section>
    <heading>One &lt; two &amp;&amp; three</heading>
    <data>
      <value kind="decimal">1.00000000000000000000000000000000000000001</value>
      <group level="999999999999999999999999">
        <value> </value>
        <value kind="quoted"><![CDATA[]]></value>
      </group>
    </data>
  </section>
  <section>
    <heading>Empty data</heading>
    <data/>
  </section>
</report>