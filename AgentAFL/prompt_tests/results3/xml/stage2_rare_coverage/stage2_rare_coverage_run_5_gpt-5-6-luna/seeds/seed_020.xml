<?xml version="1.0"?>
<!DOCTYPE catalog [
  <!ENTITY % feature "INCLUDE">
  <![%feature;[
    <!ELEMENT catalog (section+, footer?)>
    <!ELEMENT section (title, entry*)>
    <!ELEMENT title (#PCDATA)>
    <!ELEMENT entry (#PCDATA|em|br)*>
    <!ELEMENT em (#PCDATA|br)*>
    <!ELEMENT br EMPTY>
    <!ELEMENT footer (#PCDATA)>
    <!ATTLIST catalog version CDATA "1">
    <!ATTLIST section name ID #REQUIRED>
    <!ATTLIST entry key CDATA #IMPLIED>
  ]]>
  <!ENTITY hello "hello &amp; welcome">
  <!ENTITY nested "&#x3C;em&#x3E;encoded&#x3C;/em&#x3E;">
]>
<catalog version="2">
  <section name="alpha">
    <title>Entity test</title>
    <entry key="a">&hello; <em>world</em><br/>tail</entry>
    <entry key="b"><![CDATA[<not-an-element>&hello;</not-an-element>]]></entry>
    <entry key="c">&nested;</entry>
  </section>
  <section name="beta">
    <title xml:lang="fr">Résumé</title>
    <entry key="mixed">left<em>middle</em>right</entry>
  </section>
  <footer>done</footer>
</catalog>