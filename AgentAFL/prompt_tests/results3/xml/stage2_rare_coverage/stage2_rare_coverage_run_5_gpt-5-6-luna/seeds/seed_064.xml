<?xml version="1.0"?>
<!DOCTYPE maze [
  <!ELEMENT maze ANY>
  <!ATTLIST maze flags NMTOKENS #IMPLIED>
  <!ELEMENT corridor ANY>
  <!ELEMENT gate EMPTY>
  <!ATTLIST gate open (yes|no) "no" code CDATA #IMPLIED>
  <!ENTITY left "L">
  <!ENTITY right "R">
  <!ENTITY path "&left;-&right;-&left;">
]>
<maze flags="north&#x9;east south">
  <corridor id="c1">
    <![CDATA[
      <gate open="no"/>
      &not-an-entity;
    ]]>
    <gate open="yes" code="A&amp;B"/>
    <!-- a comment containing -- is not allowed here -->
    <?trace value="&path;"?>
  </corridor>
  <corridor>
    <gate/>
    <junction><![CDATA[alpha]]></junction>
  </corridor>
</maze>