<?xml version="1.0"?>
<!DOCTYPE report [
  <!ELEMENT report (header, data)>
  <!ELEMENT header (#PCDATA)>
  <!ELEMENT data (row+)>
  <!ELEMENT row (name, value?, note*)>
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT value (#PCDATA)>
  <!ELEMENT note (#PCDATA)>
  <!ATTLIST row code ID #REQUIRED>
  <!ENTITY one "1">
  <!ENTITY two "&one;&one;">
  <!ENTITY three "&two;&one;">
]>
<report>
  <header>generated &three; times</header>
  <data>
    <row code="r1">
      <name>first</name>
      <value>before&#x9;after&#xA;line</value>
      <note>one</note>
      <note>two &quot;quoted&quot;</note>
    </row>
    <row code="r2">
      <name>second &amp; alternate</name>
      <note/>
    </row>
  </data>
</report>