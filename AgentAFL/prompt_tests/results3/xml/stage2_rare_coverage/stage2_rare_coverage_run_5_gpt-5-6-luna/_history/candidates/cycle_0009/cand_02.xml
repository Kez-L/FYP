<?xml version="1.0"?>
<!DOCTYPE message [
  <!ELEMENT message (subject, body, attachment*)>
  <!ELEMENT subject (#PCDATA)>
  <!ELEMENT body (#PCDATA|br|link|em)*>
  <!ELEMENT br EMPTY>
  <!ELEMENT link (#PCDATA)>
  <!ELEMENT em (#PCDATA|em)*>
  <!ELEMENT attachment EMPTY>
  <!ATTLIST link href URI #REQUIRED>
  <!ATTLIST attachment name CDATA #REQUIRED size NMTOKEN #IMPLIED>
  <!ENTITY greeting "Hello, &amp; welcome">
  <!ENTITY nbsp "&#160;">
]>
<message>
  <subject>&greeting;</subject>
  <body>
    Start <em>important <em>nested</em> text</em><br/>
    Visit <link href="https://example.invalid/a?x=1&amp;y=2">the site</link>
    &nbsp;<![CDATA[<not-an-element/>]]> finish.
  </body>
  <attachment name="data.bin" size="4096"/>
</message>