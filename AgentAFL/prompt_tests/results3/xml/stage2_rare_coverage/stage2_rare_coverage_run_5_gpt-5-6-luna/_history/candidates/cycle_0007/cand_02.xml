<?xml version="1.0"?>
<!DOCTYPE graph [
  <!ELEMENT graph (node|edge)*>
  <!ELEMENT node EMPTY>
  <!ATTLIST node id ID #REQUIRED label CDATA #IMPLIED>
  <!ELEMENT edge EMPTY>
  <!ATTLIST edge from IDREF #REQUIRED to IDREF #REQUIRED weight NMTOKEN "1">
]>
<graph>
  <!-- Nodes intentionally appear in a non-topological order. -->
  <edge from="n2" to="n1" weight="0"/>
  <node id="n1" label="root"/>
  <node id="n3" label="&quot;quoted&quot; &amp; escaped"/>
  <?trace phase="edges-before-nodes"?>
  <edge from="n1" to="n3" weight="12.75"/>
  <node id="n2">
  </node>
</graph>