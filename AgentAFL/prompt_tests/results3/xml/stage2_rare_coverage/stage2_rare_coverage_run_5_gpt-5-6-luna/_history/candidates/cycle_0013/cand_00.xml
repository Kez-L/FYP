<?xml version="1.0"?>
<!DOCTYPE office [
  <!ENTITY nbsp "&#160;">
  <!ENTITY greeting "hello &amp; welcome">
  <!ELEMENT office (header, body)>
  <!ELEMENT header (title, author+)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT author EMPTY>
  <!ATTLIST author
    id ID #REQUIRED
    role (lead|editor|guest) "guest"
    xml:lang CDATA #IMPLIED
  >
  <!ELEMENT body (section+)>
  <!ELEMENT section (heading, (p|list|note)*)>
  <!ELEMENT heading (#PCDATA)>
  <!ELEMENT p (#PCDATA|em|code|br)*>
  <!ELEMENT em (#PCDATA)>
  <!ELEMENT code (#PCDATA)>
  <!ELEMENT br EMPTY>
  <!ELEMENT list (item+)>
  <!ELEMENT item (#PCDATA)>
  <!ELEMENT note (#PCDATA)>
]>
<office>
  <header>
    <title>Design&nbsp;&amp;&nbsp;Review</title>
    <author id="a1" role="lead" xml:lang="en">Ada</author>
    <author id="a2">Lin</author>
  </header>
  <body>
    <section>
      <heading>Introduction</heading>
      <p>The <em>first</em> draft uses <code>alpha</code><br/>markers.</p>
      <list>
        <item>one</item>
        <item>two</item>
      </list>
      <note xml:space="preserve">  &lt;raw&gt; &amp; text  </note>
    </section>
    <section>
      <heading>&greeting;</heading>
      <p>final&nbsp;paragraph</p>
    </section>
  </body>
</office>