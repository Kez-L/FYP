<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE museum [
  <!ELEMENT museum (wing+, note?)>
  <!ELEMENT wing (label, artifact*)>
  <!ELEMENT label (#PCDATA)>
  <!ELEMENT artifact (#PCDATA|material|mark)*>
  <!ELEMENT material (#PCDATA)>
  <!ELEMENT mark EMPTY>
  <!ELEMENT note (#PCDATA)>
  <!ATTLIST wing code ID #REQUIRED>
  <!ATTLIST artifact ref IDREF #IMPLIED state (new|old|lost) "new">
  <!ENTITY amp "&#38;">
]>
<!-- A collection containing mixed content and ID references. -->
<museum>
  <wing code="north">
    <label>Early Instruments</label>
    <artifact ref="piece-2" state="old">
      Resonant wood <material>cedar</material>
      <mark/> with an &amp; unusual grain.
    </artifact>
    <artifact ref="piece-1" state="new" xml:space="preserve"><material>brass</material> polished</artifact>
  </wing>
  <wing code="south">
    <label>Fragments</label>
    <artifact ref="piece-1">joined after restoration</artifact>
  </wing>
  <note>Inventory &amp; conservation records.</note>
</museum>