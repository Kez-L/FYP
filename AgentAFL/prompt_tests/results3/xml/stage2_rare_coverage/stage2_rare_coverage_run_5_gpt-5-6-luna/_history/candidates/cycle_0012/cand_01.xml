<?xml version="1.0"?>
<!DOCTYPE catalog [
  <!ENTITY % structure "<!ELEMENT catalog (entry+)><!ELEMENT entry (title,value?,note*)>">
  %structure;
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT value (#PCDATA)>
  <!ELEMENT note (#PCDATA|em)*>
  <!ELEMENT em (#PCDATA)>
  <!ATTLIST entry code ID #REQUIRED status (new|old|held) "new">
  <!ENTITY company "R&amp;D &quot;North&quot;">
  <!NOTATION plain SYSTEM "text/plain">
]>
<catalog>
  <entry code="first" status="new">
    <title>&company;</title>
    <value>42</value>
    <note>alpha <em>beta</em> gamma</note>
  </entry>
  <entry code="second">
    <title>delta</title>
    <note><![CDATA[<literal/>]]></note>
  </entry>
</catalog>