<?xml version="1.0"?>
<!DOCTYPE envelope [
  <!ELEMENT envelope (header, payload)>
  <!ELEMENT header (from, to, flags?)>
  <!ELEMENT from (#PCDATA)>
  <!ELEMENT to (#PCDATA)>
  <!ELEMENT flags (#PCDATA)>
  <!ELEMENT payload (item+)>
  <!ELEMENT item EMPTY>
  <!ATTLIST item kind NMTOKEN #REQUIRED data CDATA #IMPLIED>
  <!ENTITY % common "kind NMTOKEN #REQUIRED data CDATA #IMPLIED">
]>
<envelope>
  <header>
    <from>urn:sender</from>
    <to>urn:receiver</to>
    <flags><![CDATA[a|b|c]]></flags>
  </header>
  <payload>
    <item kind="α" data="&lt;encoded&gt;"/>
    <item kind="binary" data="&#x0A;&#x0D;&#x09;"/>
    <item kind="empty"/>
  </payload>
</envelope>