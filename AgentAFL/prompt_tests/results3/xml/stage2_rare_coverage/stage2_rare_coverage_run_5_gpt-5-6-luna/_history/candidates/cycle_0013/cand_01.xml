<?xml version="1.0"?>
<!DOCTYPE inventory [
  <!ENTITY % itemDecl
    "<!ELEMENT item (#PCDATA)>
     <!ATTLIST item code NMTOKEN #REQUIRED>">
  %itemDecl;
  <!ENTITY % mode "INCLUDE">
  <![%mode;[
    <!ELEMENT retired EMPTY>
    <!ATTLIST retired since CDATA #IMPLIED>
  ]]>
  <!ELEMENT inventory (group*)>
  <!ELEMENT group (label, item+, note?)>
  <!ATTLIST group name CDATA #REQUIRED>
  <!ELEMENT label (#PCDATA)>
  <!ELEMENT note (#PCDATA|em)*>
  <!ELEMENT em (#PCDATA)>
]>
<inventory>
  <group name="hardware">
    <label>Hardware</label>
    <item code="cpu">processor</item>
    <item code="ram">memory</item>
    <note>check <em>serial</em> numbers</note>
  </group>
  <group name="obsolete">
    <label>Legacy</label>
    <item code="disk">archive</item>
    <retired since="2020"/>
  </group>
</inventory>