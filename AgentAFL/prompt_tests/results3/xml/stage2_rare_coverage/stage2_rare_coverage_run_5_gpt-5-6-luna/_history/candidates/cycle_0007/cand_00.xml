<?xml version="1.0"?>
<!DOCTYPE catalog [
  <!ENTITY company "Northwind &amp; Sons">
  <!ENTITY stamp "2026-10-01">
  <!ELEMENT catalog (section+)>
  <!ELEMENT section (title, product*)>
  <!ATTLIST section code ID #REQUIRED>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT product (name, price, note?)>
  <!ATTLIST product sku ID #REQUIRED state (new|used|held) "new">
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT price (#PCDATA)>
  <!ELEMENT note (#PCDATA|emph)*>
  <!ELEMENT emph (#PCDATA)>
]>
<catalog generated="&stamp;">
  <section code="hardware">
    <title>Tools for &company;</title>
    <product sku="p-100" state="new">
      <name>Socket set</name>
      <price>19.95</price>
      <note>Includes <emph>sixteen</emph> pieces.</note>
    </product>
    <product sku="p-101" state="held">
      <name>Clamp</name>
      <price>4.50</price>
    </product>
  </section>
</catalog>