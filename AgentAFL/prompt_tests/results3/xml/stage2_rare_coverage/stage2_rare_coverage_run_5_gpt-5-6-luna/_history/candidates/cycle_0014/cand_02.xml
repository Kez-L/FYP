<?xml version="1.0"?>
<!DOCTYPE root [
  <!ELEMENT root (alpha, beta?, gamma*)>
  <!ELEMENT alpha (#PCDATA|leaf)*>
  <!ELEMENT beta ANY>
  <!ELEMENT gamma EMPTY>
  <!ELEMENT leaf (#PCDATA)>
  <!ATTLIST root mode (cold|warm|hot) "cold">
  <!ATTLIST leaf ref ID #IMPLIED>
]>
<root mode="hot">
  <alpha>
    text
    <leaf ref="one">left</leaf>
    <leaf>right &amp; center</leaf>
  </alpha>
  <beta>
    <wrapper level="3">
      <inner><![CDATA[x<y && y>z]]></inner>
      <!-- interleaved comment -->
      <?local data?>
    </wrapper>
  </beta>
  <gamma/>
  <gamma></gamma>
</root>