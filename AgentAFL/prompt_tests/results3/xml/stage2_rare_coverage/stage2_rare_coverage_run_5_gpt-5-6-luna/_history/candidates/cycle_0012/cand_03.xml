<?xml version="1.0"?>
<!DOCTYPE report [
  <!ELEMENT report (header,section+,footer)>
  <!ELEMENT header (#PCDATA)>
  <!ELEMENT section (label, line*)>
  <!ELEMENT label (#PCDATA)>
  <!ELEMENT line (#PCDATA)>
  <!ELEMENT footer (#PCDATA)>
  <!ATTLIST section number NMTOKEN #REQUIRED>
  <!ENTITY amp "&amp;">
  <!ENTITY left "&#x3C;">
  <!ENTITY right "&#x3E;">
  <!ENTITY phrase "A &amp; B">
]>
<report>
  <header xml:space="preserve">  &phrase;  </header>
  <section number="01">
    <label>first</label>
    <line>&left;tag attr="x"&right;</line>
    <line>quotes: &quot;&apos; and hex &#x41;&#65;</line>
  </section>
  <section number="02">
    <label><![CDATA[section <two>]]></label>
    <line>&amp; &amp; &amp;</line>
  </section>
  <footer>done</footer>
</report>