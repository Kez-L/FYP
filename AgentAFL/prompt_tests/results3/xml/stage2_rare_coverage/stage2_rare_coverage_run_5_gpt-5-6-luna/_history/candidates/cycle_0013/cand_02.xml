<?xml version="1.0"?>
<!DOCTYPE gallery [
  <!NOTATION gif SYSTEM "image/gif">
  <!NOTATION svg PUBLIC "-//W3C//DTD SVG 1.1//EN" "http://www.w3.org/Graphics/SVG/1.1/DTD/svg11.dtd">
  <!ENTITY banner SYSTEM "banner.gif" NDATA gif>
  <!ENTITY diagram SYSTEM "diagram.svg" NDATA svg>
  <!ELEMENT gallery (caption?, asset+, link*)>
  <!ELEMENT caption (#PCDATA)>
  <!ELEMENT asset EMPTY>
  <!ATTLIST asset
    name CDATA #REQUIRED
    source ENTITY #REQUIRED
    width NMTOKEN #IMPLIED
    height NMTOKEN #IMPLIED
  >
  <!ELEMENT link EMPTY>
  <!ATTLIST link href URI #REQUIRED>
]>
<gallery>
  <caption>Media inventory</caption>
  <asset name="header" source="banner" width="640" height="80"/>
  <asset name="architecture" source="diagram"/>
  <link href="https://example.invalid/archive"/>
</gallery>