<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE catalog [
  <!ELEMENT catalog (entry+, footer?)>
  <!ELEMENT entry (title, summary?, tag*, payload)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT summary (#PCDATA|em|code)*>
  <!ELEMENT em (#PCDATA)>
  <!ELEMENT code (#PCDATA)>
  <!ELEMENT tag EMPTY>
  <!ELEMENT payload ANY>
  <!ELEMENT footer (#PCDATA)>
  <!ATTLIST entry key ID #REQUIRED state (new|old|archived) "new">
  <!ATTLIST tag name CDATA #REQUIRED>
  <!ENTITY nbsp "&#160;">
  <!ENTITY mark "<em>generated</em>">
  <!NOTATION bin SYSTEM "application/octet-stream">
  <!ENTITY blob SYSTEM "blob.dat" NDATA bin>
]>
<catalog>
  <entry key="e1">
    <title>Alpha &amp; &quot;Omega&quot;</title>
    <summary>Text &mark; with <code>markup &lt;x&gt;</code> and&nbsp;spacing.</summary>
    <tag name="one"/>
    <tag name="two"/>
    <payload><![CDATA[
      {"items":[null,true,false,{"n":-0.0e+12}]}
    ]]></payload>
  </entry>
  <entry key="e2" state="archived">
    <title>Second</title>
    <payload>
      <nested a="&apos;" b="&quot;">&lt;raw&gt;</nested>
      <!-- a comment --><empty/>
    </payload>
  </entry>
  <footer>tail</footer>
</catalog>