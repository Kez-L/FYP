<?xml version="1.0"?>
<!DOCTYPE report [
  <!ELEMENT report (header, section+, footer?)>
  <!ELEMENT header (#PCDATA)>
  <!ELEMENT section (title, item*)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT item (#PCDATA|subitem)*>
  <!ELEMENT subitem (#PCDATA)>
  <!ELEMENT footer (#PCDATA)>
  <!ENTITY marker "A &amp; B">
]>
<report>
  <header>&marker;</header>
  <section>
    <title>First</title>
    <item>one<subitem>nested</subitem>two</item>
    <item><![CDATA[raw ]]> content</item>
  </section>
  <section>
    <title>Second</title>
  </section>
  <footer>done</footer>
</report>