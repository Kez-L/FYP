<?xml version="1.0"?>
<!DOCTYPE catalog [
  <!ELEMENT catalog (entry | note)*>
  <!ELEMENT entry (title, metadata?, description?, related*)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT metadata (author+, tag*)>
  <!ELEMENT author (#PCDATA)>
  <!ELEMENT tag EMPTY>
  <!ELEMENT description (#PCDATA | emphasis | ref)*>
  <!ELEMENT emphasis (#PCDATA)>
  <!ELEMENT ref (#PCDATA)>
  <!ELEMENT related EMPTY>
  <!ELEMENT note (#PCDATA)>
  <!ATTLIST entry
    key ID #REQUIRED
    status (draft|final|archived) "draft">
  <!ATTLIST tag value CDATA #REQUIRED>
  <!ATTLIST related target IDREF #IMPLIED>
  <!ENTITY company "A &amp; B Research">
]>
<catalog>
  <entry key="r1" status="final">
    <title>Boundary &company;</title>
    <metadata>
      <author>Élodie</author>
      <author>李明</author>
      <tag value="xml"/>
      <tag value="parser"/>
    </metadata>
    <description>Text <emphasis>with</emphasis> mixed <ref>references</ref> and a numeric entity &#x1F642;.</description>
    <related target="r2"/>
  </entry>
  <note><![CDATA[ ]]>A note containing ]]> is not represented literally.</note>
  <entry key="r2">
    <title>Second entry</title>
    <description>line one
line two&#10;line three</description>
  </entry>
</catalog>