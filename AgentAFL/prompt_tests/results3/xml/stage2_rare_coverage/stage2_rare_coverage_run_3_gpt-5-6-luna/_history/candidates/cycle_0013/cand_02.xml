<!DOCTYPE map [
  <!ELEMENT map (pair*)>
  <!ELEMENT pair (key, value)>
  <!ELEMENT key (#PCDATA)>
  <!ELEMENT value (#PCDATA|pair)*>
  <!ATTLIST pair id ID #IMPLIED parent IDREF #IMPLIED>
  <!ENTITY left "(">
  <!ENTITY right ")">
]>
<map>
  <pair id="root">
    <key>root</key>
    <value>
      <pair id="child" parent="root">
        <key>nested</key>
        <value>one &left; two &right;</value>
      </pair>
      <pair id="orphan" parent="missing">
        <key>other</key>
        <value><![CDATA[line1
line2
]]></value>
      </pair>
    </value>
  </pair>
</map>