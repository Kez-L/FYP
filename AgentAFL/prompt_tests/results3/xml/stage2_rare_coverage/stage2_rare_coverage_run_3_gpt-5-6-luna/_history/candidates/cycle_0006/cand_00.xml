<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE catalog [
  <!ELEMENT catalog (item+, note?)>
  <!ELEMENT item (title, description, media*)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT description (#PCDATA|em|code)*>
  <!ELEMENT em (#PCDATA)>
  <!ELEMENT code (#PCDATA)>
  <!ELEMENT media EMPTY>
  <!ELEMENT note (#PCDATA)>
  <!ATTLIST catalog version CDATA #REQUIRED>
  <!ATTLIST item id ID #REQUIRED status (new|used|archived) "new">
  <!ATTLIST media src CDATA #REQUIRED kind (image|audio|video) #IMPLIED>
  <!NOTATION png SYSTEM "image/png">
  <!ENTITY logo SYSTEM "logo.png" NDATA png>
]>
<catalog version="3">
  <item id="i1" status="new">
    <title>Symbols &amp; Entities</title>
    <description>Text with <em>emphasis</em>, <code>a&lt;b</code>, and spaces.</description>
    <media src="cover.png" kind="image"/>
  </item>
  <item id="i2" status="archived">
    <title>Second entry</title>
    <description><![CDATA[raw markup: <tag attr="x"/> & still text]]></description>
  </item>
  <note xml:space="preserve"> trailing
    content </note>
</catalog>