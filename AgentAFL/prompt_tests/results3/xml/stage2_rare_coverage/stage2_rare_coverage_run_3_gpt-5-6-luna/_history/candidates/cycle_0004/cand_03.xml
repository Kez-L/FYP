<?xml version="1.0"?>
<root xmlns:inc="http://www.w3.org/2001/XInclude"
      xmlns:p="urn:primary"
      xmlns:q="urn:secondary"
      p:revision="3">
  <p:record q:key="one">
    <p:value xsi:type="text" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
      <![CDATA[alpha < beta && gamma > delta]]>
    </p:value>
    <q:value q:key="nested">
      <q:part>left</q:part>
      <q:part><![CDATA[right]]></q:part>
    </q:value>
  </p:record>
  <inc:include href="fragment.xml" parse="xml">
    <inc:fallback>
      <p:record q:key="fallback">
        <p:value>embedded fallback</p:value>
      </p:record>
    </inc:fallback>
  </inc:include>
  <p:record xmlns:p="" q:key="reset">
    <local xmlns:q="urn:local" q:tag="yes">plain</local>
  </p:record>
</root>