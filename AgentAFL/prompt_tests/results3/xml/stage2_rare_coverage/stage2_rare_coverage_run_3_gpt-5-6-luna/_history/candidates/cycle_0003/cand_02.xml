<!DOCTYPE message [
  <!ENTITY greeting "hello">
  <!ENTITY twice "&greeting;, &greeting;">
  <!ENTITY quoted "&#x22;quoted&#x22;">
  <!ELEMENT message (header, body, footer?)>
  <!ELEMENT header EMPTY>
  <!ELEMENT body (#PCDATA|em|br)*>
  <!ELEMENT em (#PCDATA)>
  <!ELEMENT br EMPTY>
  <!ELEMENT footer (#PCDATA)>
  <!ATTLIST header from CDATA #IMPLIED to CDATA #IMPLIED>
]>
<message>
  <header from="sender@example.test" to="receiver@example.test"/>
  <body>&twice; <em>&quoted;</em><br/>tail</body>
  <footer>done</footer>
</message>