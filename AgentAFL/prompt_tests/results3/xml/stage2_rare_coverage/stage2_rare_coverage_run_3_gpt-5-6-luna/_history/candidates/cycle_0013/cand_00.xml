<?xml version="1.0"?>
<!DOCTYPE catalog [
  <!ENTITY hello "welcome">
  <!ENTITY twice "&hello; &hello;">
  <!ENTITY markup "<entry generated='yes'/>">
  <!NOTATION plain SYSTEM "text/plain">
  <!ELEMENT catalog (section+, footer?)>
  <!ELEMENT section (title, item*)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT item (#PCDATA|note|ref)*>
  <!ELEMENT note (#PCDATA)>
  <!ELEMENT ref EMPTY>
  <!ELEMENT footer (#PCDATA)>
  <!ATTLIST section code NMTOKEN #REQUIRED>
  <!ATTLIST item key ID #IMPLIED kind (a|b|c) "a">
  <!ATTLIST ref target IDREF #IMPLIED>
]>
<catalog>
  <section code="alpha">
    <title>&twice;</title>
    <item key="one">text<note>nested</note>tail</item>
    <item kind="c">before &lt; after <ref target="one"/></item>
  </section>
  <section code="beta">
    <title><![CDATA[raw ]]> content &amp; delimiters]]></title>
    <item><![CDATA[<not-an-element>&unexpanded;</not-an-element>]]></item>
  </section>
  <footer>done &hello;</footer>
</catalog>