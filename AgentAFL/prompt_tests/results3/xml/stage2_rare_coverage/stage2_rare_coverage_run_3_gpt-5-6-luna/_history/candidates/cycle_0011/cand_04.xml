<?xml version="1.0"?>
<!DOCTYPE graph [
  <!ELEMENT graph (node+, edge*)>
  <!ELEMENT node (label?, property*)>
  <!ATTLIST node id ID #REQUIRED kind CDATA "generic">
  <!ELEMENT label (#PCDATA)>
  <!ELEMENT property (#PCDATA)>
  <!ATTLIST property name NMTOKEN #REQUIRED>
  <!ELEMENT edge EMPTY>
  <!ATTLIST edge from IDREF #REQUIRED to IDREF #REQUIRED weight CDATA #IMPLIED>
]>
<graph>
  <node id="n-root" kind="container">
    <label>root</label>
    <property name="depth">0</property>
    <property name="empty"/>
  </node>
  <node id="n-leaf">
    <property name="depth">1</property>
  </node>
  <node id="n-special"><label>brackets [] &amp; braces {}</label></node>
  <edge from="n-root" to="n-leaf" weight="1.0"/>
  <edge from="n-root" to="n-special"/>
</graph>