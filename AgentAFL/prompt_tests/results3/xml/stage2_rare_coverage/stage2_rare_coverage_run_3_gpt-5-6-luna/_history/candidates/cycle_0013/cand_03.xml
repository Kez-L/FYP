<?xml version="1.0"?>
<!DOCTYPE report [
  <!ELEMENT report (meta, record+)>
  <!ELEMENT meta EMPTY>
  <!ELEMENT record (name, data)>
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT data (#PCDATA|blob|list)*>
  <!ELEMENT blob ANY>
  <!ELEMENT list (value*)>
  <!ELEMENT value (#PCDATA)>
  <!ATTLIST meta created CDATA "unknown" mode (fast|slow) "slow">
  <!ATTLIST record status (new|old|lost) "new" serial NMTOKEN #REQUIRED>
  <!ENTITY % extra "<!ATTLIST blob encoding CDATA #IMPLIED>">
  %extra;
]>
<report>
