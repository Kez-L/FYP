<?xml version="1.0"?>
<!DOCTYPE universe [
  <!ELEMENT universe (cluster*)>
  <!ELEMENT cluster (system*)>
  <!ELEMENT system (planet*)>
  <!ELEMENT planet (continent*)>
  <!ELEMENT continent (country*)>
  <!ELEMENT country (city*)>
  <!ELEMENT city (district*)>
  <!ELEMENT district (building*)>
  <!ELEMENT building (room*)>
  <!ELEMENT room (#PCDATA|item)*>
  <!ELEMENT item (#PCDATA)>
  <!ATTLIST cluster id CDATA #IMPLIED>
  <!ATTLIST system class CDATA #IMPLIED>
  <!ATTLIST planet name CDATA #IMPLIED>
]>
<universe>
  <cluster id="local">
    <system class="binary">
      <planet name="outer">
        <continent>
          <country>
            <city>
              <district>
                <building>
                  <room>north <item>table</item> center <item>lamp</item> south</room>
                </building>
              </district>
            </city>
          </country>
        </continent>
      </planet>
    </system>
    <system class="single">
      <planet name="inner"><continent><country><city><district><building><room>vacant</room></building></district></city></country></continent></planet>
    </system>
  </cluster>
</universe>