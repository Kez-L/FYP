<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE graph [
  <!ELEMENT graph (node+, edge*)>
  <!ELEMENT node EMPTY>
  <!ELEMENT edge EMPTY>
  <!ATTLIST node
    id ID #REQUIRED
    refs IDREFS #IMPLIED
    label CDATA "unlabeled">
  <!ATTLIST edge
    from IDREF #REQUIRED
    to IDREF #REQUIRED
    weight NMTOKEN "1">
  <!ENTITY ampersand "&amp;">
  <!ENTITY greeting "hello &ampersand; world">
]>
<graph>
  <node id="n0" label="root"/>
  <node id="n1" refs="n0" label="&greeting;"/>
  <node id="n2" refs="n0 n1"/>
  <edge from="n0" to="n1" weight="0"/>
  <edge from="n1" to="n2" weight="00000000000000000042"/>
  <edge from="n2" to="n0" weight="&#x2B;7"/>
</graph>