    ]]></payload>
    <checksum>deadbeef</checksum>
  </item>
  <item>
    <name>second</name>
    <payload>line one&#10;line two&#x0A;</payload>
    <checksum>0000</checksum>
  </item>
  <trailer/>
</archive>