<?xml version="1.0"?>
<!DOCTYPE archive [
  <!ELEMENT archive (header, item+, trailer?)>
  <!ELEMENT header (#PCDATA)>
  <!ELEMENT item (name, payload, checksum)>
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT payload (#PCDATA)>
  <!ELEMENT checksum (#PCDATA)>
  <!ELEMENT trailer EMPTY>
  <!ATTLIST item kind NMTOKEN #IMPLIED>
  <!ENTITY left "[BEGIN]">
  <!ENTITY right "[END]">
]>
