<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE catalog [
  <!ELEMENT catalog (entry+, tail?)>
  <!ELEMENT entry (title, data)>
  <!ATTLIST entry
    id ID #REQUIRED
    status (draft|final|archived) "draft"
  >
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT data (#PCDATA|note)*>
  <!ELEMENT note (#PCDATA)>
  <!ELEMENT tail EMPTY>
  <!ENTITY author "Ada &amp; Lovelace">
]>
<catalog>
  <entry id="e1" status="final">
    <title>&author;'s notes</title>
    <data>prefix<note priority="high">inline</note>suffix</data>
  </entry>
  <entry id="e2">
    <title>Second entry</title>
    <data><![CDATA[raw <markup> & symbols]]><note>after cdata</note></data>
  </entry>
  <tail/>
</catalog>