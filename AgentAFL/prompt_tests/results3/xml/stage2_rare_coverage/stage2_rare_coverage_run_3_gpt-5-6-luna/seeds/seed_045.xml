<?xml version="1.0"?>
<!DOCTYPE catalog [
  <!ELEMENT catalog (entry+, note?)>
  <!ELEMENT entry (title, meta, body)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT meta EMPTY>
  <!ELEMENT body (#PCDATA|em|br)*>
  <!ELEMENT em (#PCDATA)>
  <!ELEMENT br EMPTY>
  <!ELEMENT note (#PCDATA)>
  <!ATTLIST entry
    id ID #REQUIRED
    kind (book|media|other) "other">
  <!ATTLIST meta
    lang CDATA #IMPLIED
    rating NMTOKEN "unrated">
  <!ENTITY publisher "North &amp; South">
  <!ENTITY marker "&#x2603;">
]>
<catalog>
  <entry id="e1" kind="book">
    <title>Entities and declarations</title>
    <meta lang="en" rating="safe"/>
    <body>Published by &publisher;. <em>&marker;</em><br/>Mixed text.</body>
  </entry>
  <entry id="e2">
    <title>Second entry</title>
    <meta/>
    <body><![CDATA[raw <markup> and ]]> characters</body>
  </entry>
  <note>End of catalog</note>
</catalog>