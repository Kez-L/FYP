<?xml version="1.0"?>
<!DOCTYPE report [
  <!ELEMENT report (header, body, footer)>
  <!ELEMENT header (created, author)>
  <!ELEMENT created (#PCDATA)>
  <!ELEMENT author (#PCDATA)>
  <!ELEMENT body (paragraph+)>
  <!ELEMENT paragraph (#PCDATA|link|mark|linebreak)*>
  <!ELEMENT link (#PCDATA)>
  <!ATTLIST link href URI #IMPLIED>
  <!ELEMENT mark (#PCDATA)>
  <!ELEMENT linebreak EMPTY>
  <!ELEMENT footer (#PCDATA)>
  <!ENTITY company "Example &amp; Sons">
  <!ENTITY notice "Confidential: &company;">
]>
<report>
  <header>
    <created>2026-09-24T12:34:56Z</created>
    <author>editor@example.test</author>
  </header>
  <body>
    <paragraph>Welcome to <mark>the report</mark>.<linebreak/>See <link href="https://example.test/a?x=1&amp;y=2">details</link>.</paragraph>
    <paragraph>&notice;</paragraph>
  </body>
  <footer>End of document.</footer>
</report>