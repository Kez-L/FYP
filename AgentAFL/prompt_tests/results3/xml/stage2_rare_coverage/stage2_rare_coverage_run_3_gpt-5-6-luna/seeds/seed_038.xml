<?xml version="1.0" encoding="UTF-8"?>
<configuration xml:base="https://config.example.test/root/">
  <!-- configuration values intentionally use mixed content -->
  <profiles>
    <profile name="minimal" enabled="true">
      <paths>
        <path kind="cache">./cache</path>
        <path kind="data">data/</path>
      </paths>
      <options>
        <option key="threads" value="4"/>
        <option key="verbose">false</option>
      </options>
    </profile>
    <profile name="extended" enabled="false">
      <paths>
        <path kind="cache">../var/cache</path>
      </paths>
      <options>
        <option key="features">
          <feature>alpha</feature>
          <feature>beta</feature>
          <feature>gamma</feature>
        </option>
      </options>
    </profile>
  </profiles>
</configuration>