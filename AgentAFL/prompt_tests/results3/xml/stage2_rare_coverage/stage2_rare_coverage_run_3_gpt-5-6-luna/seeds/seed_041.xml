<?xml version="1.0"?>
<!DOCTYPE report [
  <!ELEMENT report (header, section+)>
  <!ELEMENT header (#PCDATA)>
  <!ELEMENT section (heading, item*)>
  <!ELEMENT heading (#PCDATA)>
  <!ELEMENT item (#PCDATA|ref)*>
  <!ELEMENT ref EMPTY>
  <!ATTLIST ref target IDREF #REQUIRED>
  <!ATTLIST item code ID #IMPLIED>
  <!ENTITY mark "&#x27;quoted&#x27;">
  <!ENTITY % shared "<!ENTITY injected 'parameter-entity-value'>">
  %shared;
]>
<report>
  <header>Run &mark; &injected;</header>
  <section>
    <heading>Alpha</heading>
    <item code="i1">A <ref target="i1"/> B</item>
    <item>plain text</item>
  </section>
  <section>
    <heading>Beta</heading>
    <item code="i2"><ref target="i1"/>tail</item>
  </section>
</report>