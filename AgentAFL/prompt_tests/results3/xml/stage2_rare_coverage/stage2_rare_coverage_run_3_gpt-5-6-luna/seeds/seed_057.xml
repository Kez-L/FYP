<?xml version="1.0"?>
<!DOCTYPE map [
  <!ELEMENT map (node)>
  <!ELEMENT node (node*, value?)>
  <!ELEMENT value (#PCDATA)>
  <!ATTLIST node name CDATA #IMPLIED>
  <!ENTITY nl "&#10;">
]>
<map>
  <node name="root">
    <node name="left">
      <node name="leaf-a">
        <value>one&nl;two</value>
      </node>
      <node name="leaf-b">
        <value><![CDATA[<json>{"a":[1,2,3]}</json>]]></value>
      </node>
    </node>
    <node name="right">
      <node name="empty"/>
      <node name="mixed">prefix<value>inside</value>suffix</node>
    </node>
  </node>
</map>