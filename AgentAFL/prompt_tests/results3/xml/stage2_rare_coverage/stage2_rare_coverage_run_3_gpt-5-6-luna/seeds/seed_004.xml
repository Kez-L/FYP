<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE envelope [
  <!ELEMENT envelope (message)>
  <!ELEMENT message (sender, recipient, body, attachment*)>
  <!ELEMENT sender EMPTY>
  <!ELEMENT recipient EMPTY>
  <!ELEMENT body (#PCDATA|line|emphasis)*>
  <!ELEMENT line (#PCDATA|emphasis)*>
  <!ELEMENT emphasis (#PCDATA)>
  <!ELEMENT attachment (name, data)>
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT data (#PCDATA)>
  <!ATTLIST sender address CDATA #REQUIRED>
  <!ATTLIST recipient address CDATA #REQUIRED>
]>
<envelope>
  <message>
    <sender address="a@example.test"/>
    <recipient address="b@example.test"/>
    <body>
      Hello <emphasis>world</emphasis>.
      <line>Second line with &quot;quotes&quot;.</line>
      <line><![CDATA[<not-an-element>&still-text;</not-an-element>]]></line>
    </body>
    <attachment>
      <name>sample.bin</name>
      <data>AAECAwQFBgcICQ==</data>
    </attachment>
  </message>
</envelope>