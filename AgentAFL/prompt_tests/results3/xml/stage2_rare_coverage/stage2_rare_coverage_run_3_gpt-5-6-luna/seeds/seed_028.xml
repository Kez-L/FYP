<?xml version="1.0"?>
<!DOCTYPE package [
  <!ELEMENT package (manifest, payload)>
  <!ELEMENT manifest (file+)>
  <!ELEMENT file EMPTY>
  <!ELEMENT payload ANY>
  <!ATTLIST file path CDATA #REQUIRED checksum CDATA #IMPLIED>
  <!ENTITY open "<segment>generated</segment>">
  <!ENTITY quoted "A &quot;quoted&quot; value">
  <![IGNORE[
    <!ELEMENT ignored EMPTY>
    <!ENTITY never "unused">
  ]]>
  <![INCLUDE[
    <!ELEMENT included EMPTY>
  ]]>
]>
<package>
  <manifest>
    <file path="a/b.txt" checksum="00ff"/>
    <file path="space name.dat"/>
  </manifest>
  <payload>
    &open;
    <segment><![CDATA[embedded]]></segment>
    <value>&quoted;</value>
  </payload>
</package>