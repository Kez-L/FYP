  <r:header>
    <r:sequence>00000000000000000001</r:sequence>
    <r:flags>
      <r:flag name="urgent"/>
      <r:flag name="signed" value="true"/>
    </r:flags>
  </r:header>
  <r:payload>
    <m:message m:type="notification" x:token="&quot;quoted&quot;">
      <m:sender>
        <m:name>sender</m:name>
        <m:address><![CDATA[user@example.invalid]]></m:address>
      </m:sender>
      <m:body>
        <m:line index="1">first</m:line>
        <m:line index="2">second</m:line>
        <m:line index="3"><![CDATA[third & fourth]]></m:line>
      </m:body>
    </m:message>
  </r:payload>
  <r:trailer><!-- retained comment --><r:checksum algorithm="none"/></r:trailer>
</r:envelope>