<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE catalog [
  <!ELEMENT catalog (entry+, note?)>
  <!ELEMENT entry (title, metadata, description, related*)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT metadata (author*, tag*)>
  <!ELEMENT author (#PCDATA)>
  <!ELEMENT tag EMPTY>
  <!ELEMENT description (#PCDATA|em|code|br)*>
  <!ELEMENT em (#PCDATA)>
  <!ELEMENT code (#PCDATA)>
  <!ELEMENT br EMPTY>
  <!ELEMENT related EMPTY>
  <!ELEMENT note (#PCDATA)>
  <!ATTLIST entry key ID #REQUIRED status (draft|published|archived) "draft">
  <!ATTLIST tag value CDATA #REQUIRED>
  <!ATTLIST related ref IDREF #IMPLIED>
]>
<catalog>
  <entry key="e1" status="published">
    <title>Parser &amp; Entity Tests</title>
    <metadata>
      <author>alpha</author>
      <author>beta</author>
      <tag value="xml"/>
      <tag value="fuzzing"/>
    </metadata>
    <description>Text <em>with</em> <code>markup</code><br/>and tails.</description>
    <related ref="e2"/>
  </entry>
  <entry key="e2">
    <title>Second Entry</title>
    <metadata><tag value="edge"/></metadata>
    <description><![CDATA[raw <content> & odd ]]></description>
  </entry>
  <note>finish</note>
</catalog>