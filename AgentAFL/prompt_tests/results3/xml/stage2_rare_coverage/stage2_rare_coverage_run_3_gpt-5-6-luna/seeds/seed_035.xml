<?xml version="1.0"?>
<!DOCTYPE catalog [
  <!ELEMENT catalog (section+)>
  <!ELEMENT section (title, item*)>
  <!ATTLIST section code ID #REQUIRED>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT item (name, price, description?)>
  <!ATTLIST item sku ID #REQUIRED status (active|retired) "active">
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT price (#PCDATA)>
  <!ELEMENT description (#PCDATA|em|br)*>
  <!ELEMENT em (#PCDATA)>
  <!ELEMENT br EMPTY>
]>
