<?xml version="1.0"?>
<!DOCTYPE catalog [
  <!ENTITY product "hand-crafted">
  <!ENTITY company "Example &amp; Sons">
  <!ENTITY % commonAttrs '<!ATTLIST item sku ID #REQUIRED status (new|used|archived) "new">'>
  %commonAttrs;
  <!ELEMENT catalog (section+)>
  <!ELEMENT section (title, item*, note?)>
  <!ATTLIST section code NMTOKEN #REQUIRED>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT item (#PCDATA|detail|link)*>
  <!ELEMENT detail (#PCDATA)>
  <!ELEMENT link EMPTY>
  <!ATTLIST link href URI #REQUIRED>
  <!ELEMENT note (#PCDATA)>
]>
<catalog>
  <section code="tools">
    <title>&company; &product; tools</title>
    <item sku="item-001">Hammer<detail>steel head</detail><link href="urn:item:001"/></item>
    <note>Available &amp; documented.</note>
  </section>
</catalog>