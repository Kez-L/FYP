<?xml version="1.0"?>
<!DOCTYPE document [
  <!ELEMENT document (title, paragraph*, table?, appendix?)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT paragraph (#PCDATA|em|strong|link|br)*>
  <!ELEMENT em (#PCDATA)>
  <!ELEMENT strong (#PCDATA)>
  <!ELEMENT link (#PCDATA)>
  <!ELEMENT br EMPTY>
  <!ELEMENT table (row+)>
  <!ELEMENT row (cell+)>
  <!ELEMENT cell (#PCDATA)>
  <!ELEMENT appendix (#PCDATA|section)*>
  <!ELEMENT section (#PCDATA|section)*>
  <!ATTLIST link href URI #REQUIRED>
  <!ENTITY nbsp "&#160;">
  <!ENTITY intro "This is an &quot;embedded&quot; fragment.">
]>
<document>
  <title>Parser &amp; Markup Notes</title>
  <paragraph>
    &intro; Text with <em>emphasis</em>, <strong>weight</strong>,
    a <link href="urn:example:reference">reference</link><br/>
    and a non-breaking space&nbsp;before the end.
  </paragraph>
  <paragraph><![CDATA[
    whitespace
      is
        intentionally
          irregular
  ]]></paragraph>
  <table>
    <row><cell>r1c1</cell><cell>r1c2</cell><cell>r1c3</cell></row>
    <row><cell>r2c1</cell><cell><![CDATA[r2 < c2]]></cell><cell>r2c3</cell></row>
  </table>
  <appendix>
    <section>outer <section>inner <section>deep</section></section></section>
  </appendix>
</document>