<?xml version="1.0"?>
<!DOCTYPE archive [
  <!ELEMENT archive (section+)>
  <!ELEMENT section (title, entry*)>
  <!ATTLIST section
    code ID #REQUIRED
    visibility (public|private|internal) "public">
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT entry (key, value, note?)>
  <!ATTLIST entry ref IDREF #IMPLIED>
  <!ELEMENT key (#PCDATA)>
  <!ELEMENT value (#PCDATA|em|br)*>
  <!ELEMENT em (#PCDATA)>
  <!ELEMENT br EMPTY>
  <!ELEMENT note (#PCDATA)>
  <!ENTITY company "North &amp; South">
  <!ENTITY marker "&#x2063;">
]>
<archive>
  <section code="s-main" visibility="internal">
    <title>Configuration &company;&marker;</title>
    <entry>
      <key>alpha</key>
      <value>first <em>important</em><br/>value</value>
      <note>line one&#10;line two</note>
    </entry>
    <entry ref="s-main">
      <key>omega</key>
      <value><![CDATA[raw <markup> and ]]> characters]]></value>
    </entry>
  </section>
</archive>