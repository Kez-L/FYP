<?xml version="1.0" standalone="no"?>
<!DOCTYPE report [
  <!ELEMENT report (section+, footer?)>
  <!ELEMENT section (title, paragraph+, figure?)>
  <!ATTLIST section number ID #REQUIRED>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT paragraph (#PCDATA|code|link|br)*>
  <!ELEMENT code (#PCDATA)>
  <!ELEMENT link (#PCDATA)>
  <!ATTLIST link target CDATA #IMPLIED>
  <!ELEMENT br EMPTY>
  <!ELEMENT figure EMPTY>
  <!ATTLIST figure format NOTATION (svg|txt) "txt" source ENTITY #IMPLIED>
  <!NOTATION svg SYSTEM "image/svg+xml">
  <!NOTATION txt SYSTEM "text/plain">
  <!ENTITY copyright "&#169;">
  <!ENTITY project "XML &amp; Validation">
]>
<report>
  <section number="intro">
    <title>Overview &copyright;</title>
    <paragraph>Use <code>xmllint</code> with a <link target="#appendix">link</link><br/>after it.</paragraph>
    <paragraph>Project: &project;.</paragraph>
    <figure format="svg" source="diagram"/>
  </section>
  <section number="appendix">
    <title>Appendix</title>
    <paragraph><![CDATA[<tag> remains literal here]]></paragraph>
    <paragraph>Quotes: 'single' and "double".</paragraph>
  </section>
  <footer>End</footer>
</report>