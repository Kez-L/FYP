<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE catalog [
  <!ELEMENT catalog (header, section+)>
  <!ELEMENT header (#PCDATA)>
  <!ELEMENT section (title, entry*)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT entry (#PCDATA|em|ref)*>
  <!ELEMENT em (#PCDATA)>
  <!ELEMENT ref EMPTY>
  <!ATTLIST section xml:lang NMTOKEN #IMPLIED>
  <!ATTLIST entry key ID #REQUIRED>
  <!ATTLIST ref target IDREF #REQUIRED>
  <!ENTITY notice "catalog &amp; archive">
]>
<catalog xml:base="https://example.test/root/">
  <?index mode="full"?>
  <header xml:lang="en">&notice;</header>
  <section xml:lang="fr">
    <title>Éléments &amp; références</title>
    <entry key="first">plain <em>marked</em> text<ref target="second"/></entry>
    <entry key="second"><![CDATA[raw <angle> and ]]]]><![CDATA[> content]]></entry>
  </section>
</catalog>