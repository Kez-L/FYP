<?xml version="1.0"?>
<!DOCTYPE labyrinth [
  <!ELEMENT labyrinth (node)>
  <!ELEMENT node (node|leaf)*>
  <!ELEMENT leaf EMPTY>
  <!ATTLIST node name CDATA #IMPLIED>
  <!ENTITY left "<node name='inner'><leaf/></node>">
  <!ENTITY right "<node name='outer'>&left;</node>">
  <!ENTITY loop "&loop;">
]>
<labyrinth>
  <node name="start">
    &right;
    <leaf/>
  </node>
</labyrinth>