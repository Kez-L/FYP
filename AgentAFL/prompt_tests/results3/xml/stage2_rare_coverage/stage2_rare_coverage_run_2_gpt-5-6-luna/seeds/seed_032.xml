<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE message [
  <!ELEMENT message (from, to, subject, body)>
  <!ELEMENT from (#PCDATA)>
  <!ELEMENT to (#PCDATA)>
  <!ELEMENT subject (#PCDATA)>
  <!ELEMENT body (paragraph|quote|attachment)*>
  <!ELEMENT paragraph (#PCDATA|strong|link|br)*>
  <!ELEMENT strong (#PCDATA)>
  <!ELEMENT link (#PCDATA)>
  <!ATTLIST link href CDATA #REQUIRED>
  <!ELEMENT br EMPTY>
  <!ELEMENT quote (paragraph+)>
  <!ELEMENT attachment EMPTY>
  <!ATTLIST attachment name CDATA #REQUIRED size NMTOKEN #IMPLIED>
  <!ENTITY greeting "Hello, ">
]>
<message>
  <from>sender@example.invalid</from>
  <to>receiver@example.invalid</to>
  <subject>&greeting;XML</subject>
  <body>
    <paragraph><![CDATA[Text containing <tags>, ampersands &, and ]]> markers]]></paragraph>
    <quote>
      <paragraph><strong>Nested</strong> statement<br/>with a <link href="urn:item:7">reference</link>.</paragraph>
    </quote>
    <attachment name="blob.bin" size="000000"/>
    <paragraph>final<!-- comment with -- no, this is safe --></paragraph>
  </body>
</message>