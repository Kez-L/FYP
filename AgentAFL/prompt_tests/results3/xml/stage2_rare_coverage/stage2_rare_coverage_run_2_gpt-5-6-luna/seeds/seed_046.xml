<?xml version="1.0"?>
<!DOCTYPE archive [
  <!ELEMENT archive (record+)>
  <!ELEMENT record (key, value, note?)>
  <!ELEMENT key (#PCDATA)>
  <!ELEMENT value (#PCDATA)>
  <!ELEMENT note (#PCDATA)>
  <!ENTITY company "North &amp; South">
  <!ENTITY marker "&#x1F4A5;">
  <!ENTITY pair "&company; &marker;">
]>
<archive>
  <record>
    <key>alpha</key>
    <value>&pair;</value>
    <note>quoted: &quot;yes&quot; and apostrophe: &apos;ok&apos;</note>
  </record>
  <record>
    <key>beta</key>
    <value>before <![CDATA[<raw>&data;</raw>]]> after</value>
  </record>
  <record>
    <key>gamma</key>
    <value>&company;</value>
  </record>
</archive>