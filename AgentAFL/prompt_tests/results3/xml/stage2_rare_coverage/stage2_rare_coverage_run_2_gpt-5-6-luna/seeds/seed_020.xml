<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!DOCTYPE archive [
  <!ELEMENT archive (header,section+,footer)>
  <!ELEMENT header (title,meta*)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT meta EMPTY>
  <!ATTLIST meta
    key NMTOKEN #REQUIRED
    value CDATA #IMPLIED>
  <!ELEMENT section (heading,para+,list?)>
  <!ATTLIST section
    id ID #REQUIRED
    lang NMTOKEN "en">
  <!ELEMENT heading (#PCDATA)>
  <!ELEMENT para (#PCDATA|em|strong|link|br)*>
  <!ELEMENT em (#PCDATA|em|strong|link|br)*>
  <!ELEMENT strong (#PCDATA|em|strong|link|br)*>
  <!ELEMENT link (#PCDATA)>
  <!ATTLIST link href CDATA #REQUIRED>
  <!ELEMENT br EMPTY>
  <!ELEMENT list (item+)>
  <!ELEMENT item (#PCDATA|em|strong)*>
  <!ELEMENT footer (#PCDATA)>
  <!ENTITY copyright "© 2026">
]>
<archive xml:lang="en" xml:base="https://example.invalid/data/">
  <header>
    <title>Markup &amp; Meaning</title>
    <meta key="format" value="text"/>
    <meta key="revision" value="β-2"/>
  </header>
  <section id="intro">
    <heading>Introduction</heading>
    <para>Text with <em>nested <strong>emphasis</strong></em>, a <link href="guide.xml#part">reference</link>, and a line break<br/>inside.</para>
    <para>Symbols: &lt;tag&gt;, &quot;quoted&quot;, and &copyright;.</para>
  </section>
  <section id="details" lang="fr">
    <heading>Résumé</heading>
    <para>Éléments mélangés — naïve façade — 日本語.</para>
    <list>
      <item>first</item>
      <item>second <em>annotated</em></item>
    </list>
  </section>
  <footer>End of document.</footer>
</archive>