<?xml version="1.0"?>
<!DOCTYPE manifest [
  <!ELEMENT manifest (resource*, bundle)>
  <!ELEMENT resource EMPTY>
  <!ELEMENT bundle (item+)>
  <!ELEMENT item (#PCDATA|property)*>
  <!ELEMENT property (#PCDATA)>
  <!ATTLIST resource name CDATA #REQUIRED type NOTATION #IMPLIED>
  <!ATTLIST item key NMTOKEN #REQUIRED>
  <!NOTATION png SYSTEM "image/png">
  <!NOTATION text SYSTEM "text/plain">
  <!ENTITY logo SYSTEM "logo.png" NDATA png>
]>
<manifest>
  <resource name="logo.png" type="png"/>
  <resource name="readme.txt" type="text"/>
  <bundle>
    <item key="alpha">
      text
      <property>value</property>
      tail
    </item>
    <item key="beta"><property><![CDATA[a&b<c>d]]></property></item>
  </bundle>
</manifest>