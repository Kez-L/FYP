<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE catalog [
  <!ELEMENT catalog (product*, deleted*)>
  <!ELEMENT product (name, price, dimensions?, tags)>
  <!ATTLIST product sku ID #REQUIRED state (new|used|retired) "new">
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT price (#PCDATA)>
  <!ELEMENT dimensions (width, height, depth)>
  <!ELEMENT width (#PCDATA)>
  <!ELEMENT height (#PCDATA)>
  <!ELEMENT depth (#PCDATA)>
  <!ELEMENT tags (tag*)>
  <!ELEMENT tag (#PCDATA)>
  <!ELEMENT deleted EMPTY>
  <!ATTLIST deleted ref IDREF #REQUIRED reason CDATA #IMPLIED>
]>
<catalog xml:lang="en">
  <product sku="p-001" state="new">
    <name>Glass &amp; Copper</name>
    <price currency="EUR">19.95</price>
    <dimensions>
      <width>10</width><height>20</height><depth>0.5</depth>
    </dimensions>
    <tags><tag>fragile</tag><tag>home</tag></tags>
  </product>
  <product sku="p-002" state="used">
    <name>Archive Box</name>
    <price currency="USD">0007.00</price>
    <tags/>
  </product>
  <deleted ref="p-001" reason="duplicate"/>
</catalog>