  <!ELEMENT value (#PCDATA)>
  <!ELEMENT note (#PCDATA|emph|break)*>
  <!ELEMENT emph (#PCDATA)>
  <!ELEMENT break EMPTY>
  <!ENTITY mark "&#x26;">
  <!ENTITY nested "left &mark; right">
]>
