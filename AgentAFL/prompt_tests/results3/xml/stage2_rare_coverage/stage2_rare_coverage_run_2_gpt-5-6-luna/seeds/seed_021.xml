<?xml version="1.0"?>
<!DOCTYPE catalog [
  <!ELEMENT catalog (entry*)>
  <!ELEMENT entry (name,description?,price,related*)>
  <!ATTLIST entry
    code ID #REQUIRED
    refs IDREFS #IMPLIED
    media ENTITY #IMPLIED
    kind (book|music|video) "book">
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT description (#PCDATA|keyword)*>
  <!ELEMENT keyword (#PCDATA)>
  <!ELEMENT price (#PCDATA)>
  <!ELEMENT related EMPTY>
  <!ATTLIST related target IDREF #REQUIRED>
  <!NOTATION jpeg SYSTEM "image/jpeg">
  <!ENTITY cover SYSTEM "cover.jpg" NDATA jpeg>
  <!ENTITY euro "&#x20AC;">
]>
<catalog>
  <entry code="bk-1" kind="book" refs="bk-2" media="cover">
    <name>Parsing &amp; Practice</name>
    <description>Guide to <keyword>XML</keyword> and <keyword>DTDs</keyword>.</description>
    <price>19.95 &euro;</price>
    <related target="bk-2"/>
  </entry>
  <entry code="bk-2" kind="book">
    <name>Recursive Patterns</name>
    <price>7.50 &euro;</price>
  </entry>
  <entry code="mv-1" kind="video">
    <name>Nodes in Motion</name>
    <description><keyword>document</keyword> structure</description>
    <price>12.00 &euro;</price>
  </entry>
</catalog>