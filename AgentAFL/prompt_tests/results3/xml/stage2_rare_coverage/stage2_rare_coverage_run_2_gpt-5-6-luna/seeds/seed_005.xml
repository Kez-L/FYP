  <!ENTITY payload SYSTEM "payload.bin" NDATA binary>
]>
<catalog>
  <section code="s1">
    <title>&greeting;</title>
    <item kind="marked">A &amp; B &left; C &right;</item>
    <item ref="s1" kind="quoted">before &#x2028; after</item>
  </section>
  <section code="s2">
    <title><![CDATA[Literal ]]> bracket ]]></title>
