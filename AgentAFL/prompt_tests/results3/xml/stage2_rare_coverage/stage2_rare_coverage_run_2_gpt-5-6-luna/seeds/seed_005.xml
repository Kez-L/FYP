<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE catalog [
  <!ENTITY % common "<!ELEMENT catalog (section+)><!ELEMENT section (title, item*)><!ELEMENT title (#PCDATA)><!ELEMENT item (#PCDATA)>">
  %common;
