    <title><![CDATA[Raw <title> & preserved]]></title>
    <tags><tag>one</tag><tag>two</tag><tag>three</tag></tags>
    <data>prefix &label;<chunk><![CDATA[<binary>]]></chunk>suffix</data>
  </record>
  <record key="r-β">
    <title>Second&#x20;record</title>
    <data><![CDATA[line one
line two
]]></data>
  </record>
</catalog>