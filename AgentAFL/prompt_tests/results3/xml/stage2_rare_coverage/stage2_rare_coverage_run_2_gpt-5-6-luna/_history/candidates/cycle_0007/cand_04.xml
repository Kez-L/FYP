<?xml version="1.1"?>
<!DOCTYPE scene [
  <!ELEMENT scene (layer+)>
  <!ELEMENT layer (node*)>
  <!ATTLIST layer name CDATA #REQUIRED visible (true|false) "true">
  <!ELEMENT node (name, geometry?, property*)>
  <!ATTLIST node uid ID #REQUIRED kind CDATA #IMPLIED>
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT geometry (point|box|path)>
  <!ELEMENT point EMPTY>
  <!ATTLIST point x CDATA #REQUIRED y CDATA #REQUIRED>
  <!ELEMENT box EMPTY>
  <!ATTLIST box width CDATA #REQUIRED height CDATA #REQUIRED>
  <!ELEMENT path (#PCDATA)>
  <!ELEMENT property (#PCDATA)>
  <!ATTLIST property key CDATA #REQUIRED>
  <![IGNORE[
    <!ELEMENT ignored ANY>
    <!ENTITY never "not expanded">
  ]]>
]>
<scene>
  <layer name="background" visible="false">
    <node uid="n-bg" kind="rectangle">
      <name>backdrop</name>
      <geometry><box width="000" height="-1"/></geometry>
      <property key="color">#00FF00</property>
    </node>
  </layer>
  <layer name="foreground">
    <node uid="n-1" kind="polyline">
      <name>line&#x85;break</name>
      <geometry><path>M0,0 L10,10 Z</path></geometry>
      <property key="enabled">true</property>
      <property key="label">A&#x1F;B</property>
    </node>
    <node uid="n-2">
      <name><![CDATA[raw ]]> text</name>
      <geometry><point x="NaN" y="INF"/></geometry>
    </node>
  </layer>
</scene>