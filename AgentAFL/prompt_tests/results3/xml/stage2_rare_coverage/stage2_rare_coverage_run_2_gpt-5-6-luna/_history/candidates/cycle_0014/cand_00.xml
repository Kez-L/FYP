<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE inventory [
  <!ELEMENT inventory (warehouse, note?, item*)>
  <!ELEMENT warehouse (#PCDATA)>
  <!ELEMENT note (#PCDATA)>
  <!ELEMENT item (name, quantity, price, metadata?)>
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT quantity (#PCDATA)>
  <!ELEMENT price (#PCDATA)>
  <!ELEMENT metadata (tag*)>
  <!ELEMENT tag (#PCDATA)>
  <!ATTLIST item sku ID #REQUIRED status (in-stock|backorder|retired) "in-stock">
  <!ATTLIST tag key CDATA #REQUIRED>
  <!ENTITY currency "&#x20AC;">
  <!ENTITY warehouse-name "North &amp; South Depot">
]>
<inventory>
  <warehouse>&warehouse-name;</warehouse>
  <note><![CDATA[Handle fragile items: ]]]]><![CDATA[ use padding.]]></note>
  <item sku="sku-001">
    <name>Glass vessel</name>
    <quantity>12</quantity>
    <price>19.95 &currency;</price>
    <metadata>
      <tag key="color">amber</tag>
      <tag key="size">medium</tag>
    </metadata>
  </item>
  <item sku="sku-002" status="backorder">
    <name>Replacement seal</name>
    <quantity>0</quantity>
    <price>3.50 &currency;</price>
  </item>
</inventory>