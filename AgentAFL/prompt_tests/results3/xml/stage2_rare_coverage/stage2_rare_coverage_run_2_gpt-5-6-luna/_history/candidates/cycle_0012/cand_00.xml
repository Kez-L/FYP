<?xml version="1.0"?>
<!DOCTYPE archive [
  <!ELEMENT archive (header, record+)>
  <!ELEMENT header EMPTY>
  <!ATTLIST header version CDATA #REQUIRED generated CDATA #IMPLIED>
  <!ELEMENT record (title, payload, note?)>
  <!ATTLIST record id ID #REQUIRED status (new|held|closed) "new">
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT payload (#PCDATA|item|![CDATA[]])*>
  <!ELEMENT item (#PCDATA)>
  <!ELEMENT note (#PCDATA)>
  <!ENTITY company "A &amp; B">
  <!ENTITY fragment "<item>expanded</item>">
]>
<archive>
  <header version="7" generated="false"/>
  <record id="r-alpha" status="held">
    <title>&company; &lt;sample&gt;</title>
    <payload>prefix &fragment; suffix</payload>
    <note><![CDATA[raw ]]> text ]]> and entities &amp; remain visible</note>
  </record>
  <record id="r-beta">
    <title>Second record</title>
    <payload><item>one</item><item><![CDATA[two < three & four]]></item></payload>
  </record>
</archive>