<?xml version="1.0" standalone="no"?>
<!DOCTYPE report [
  <!ELEMENT report (summary, table, footer)>
  <!ELEMENT summary (#PCDATA)>
  <!ELEMENT table (row+)>
  <!ELEMENT row (cell+)>
  <!ELEMENT cell (#PCDATA)>
  <!ELEMENT footer (#PCDATA)>
  <!ATTLIST row index NMTOKEN #REQUIRED>
  <!ENTITY % common ' xml:id ID #IMPLIED xml:lang NMTOKEN #IMPLIED'>
  <!ATTLIST cell%common; role (header|data|total) "data">
  <!ENTITY nbsp "&#160;">
  <!ENTITY ampersand "&amp;">
]>
<report>
  <summary xml:lang="en">Totals&nbsp;&ampersand; details</summary>
  <table>
    <row index="A">
      <cell role="header">Name</cell>
      <cell role="header">Value</cell>
    </row>
    <row index="B">
      <cell xml:id="name-b">North</cell>
      <cell>42</cell>
    </row>
    <row index="C">
      <cell>South</cell>
      <cell role="total">84</cell>
    </row>
  </table>
  <footer><![CDATA[End of report]]></footer>
</report>