<?xml version="1.0"?>
<!DOCTYPE media [
  <!ELEMENT media (asset+, license?)>
  <!ELEMENT asset EMPTY>
  <!ELEMENT license (#PCDATA)>
  <!ATTLIST media version NMTOKEN #REQUIRED>
  <!ATTLIST asset name CDATA #REQUIRED
                  source ENTITY #IMPLIED
                  kind NOTATION #IMPLIED>
  <!NOTATION svg SYSTEM "image/svg+xml">
  <!NOTATION png PUBLIC "-//PNG//NOTATION Portable Network Graphics//EN">
  <!ENTITY logo SYSTEM "logo.svg" NDATA svg>
  <!ENTITY icon SYSTEM "icon.png" NDATA png>
]>
<media version="2.0">
  <asset name="brand" source="logo" kind="svg"/>
  <asset name="small" source="icon" kind="png"/>
  <license>Use permitted for testing.</license>
</media>