<?xml version="1.0"?>
<!DOCTYPE message [
  <!ELEMENT message (sender, recipient, body, attachment*)>
  <!ELEMENT sender (#PCDATA)>
  <!ELEMENT recipient (#PCDATA)>
  <!ELEMENT body (#PCDATA|quote|br)*>
  <!ELEMENT quote (#PCDATA)>
  <!ELEMENT br EMPTY>
  <!ELEMENT attachment EMPTY>
  <!ATTLIST attachment
            name CDATA #REQUIRED
            kind (text|binary) "text">
  <!ENTITY greeting "Hello, ">
  <!ENTITY quoted "&lt;do-not-interpret&gt;">
]>
<message>
  <sender>robot@example.test</sender>
  <recipient>user@example.test</recipient>
  <body>&greeting;world<br/><quote>&quoted;</quote></body>
  <attachment name="readme.txt"/>
  <attachment name="blob.bin" kind="binary"/>
</message>