<?xml version="1.0"?>
<!DOCTYPE maze [
  <!ELEMENT maze (row+)>
  <!ELEMENT row (cell+)>
  <!ELEMENT cell EMPTY>
  <!ATTLIST cell
    x CDATA #REQUIRED
    y CDATA #REQUIRED
    kind (wall|path|start|finish) "path"
    exits NMTOKENS #IMPLIED>
]>
<maze width="6" height="4">
  <row y="0">
    <cell x="0" kind="start" exits="east south"/>
    <cell x="1" kind="wall"/>
    <cell x="2" kind="path" exits="west east"/>
    <cell x="3" kind="path" exits="west"/>
  </row>
  <row y="1">
    <cell x="0" kind="path" exits="north south"/>
    <cell x="1" kind="path" exits="south east"/>
    <cell x="2" kind="wall"/>
    <cell x="3" kind="path" exits="north south"/>
    <cell x="4" kind="finish" exits="west"/>
  </row>
</maze>