<?xml version="1.0"?>
<!DOCTYPE scene [
  <!ELEMENT scene (setting, actor+, action*)>
  <!ELEMENT setting (location, time)>
  <!ELEMENT location (#PCDATA)>
  <!ELEMENT time (#PCDATA)>
  <!ELEMENT actor (name, role?, prop*)>
  <!ATTLIST actor ref ID #REQUIRED>
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT role (#PCDATA)>
  <!ELEMENT prop EMPTY>
  <!ATTLIST prop kind CDATA #REQUIRED value CDATA #IMPLIED>
  <!ELEMENT action (actor-ref, line?, direction*)>
  <!ELEMENT actor-ref EMPTY>
  <!ATTLIST actor-ref ref IDREF #REQUIRED>
  <!ELEMENT line (#PCDATA)>
  <!ELEMENT direction (#PCDATA)>
]>
<scene>
  <setting>
    <location>Platform 9</location>
    <time>after midnight</time>
  </setting>
  <actor ref="a1">
    <name>Mira</name>
    <role>watcher</role>
    <prop kind="lamp" value="blue"/>
  </actor>
  <actor ref="a2">
    <name>Jon</name>
    <prop kind="ticket"/>
  </actor>
  <action>
    <actor-ref ref="a1"/>
    <line>Wait for the signal.</line>
    <direction>She turns toward the tunnel.</direction>
  </action>
  <action>
    <actor-ref ref="a2"/>
    <line>It is already here.</line>
  </action>
</scene>