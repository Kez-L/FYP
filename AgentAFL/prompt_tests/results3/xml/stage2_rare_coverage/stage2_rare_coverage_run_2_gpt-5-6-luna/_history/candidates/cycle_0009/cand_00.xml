<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE catalog [
  <!ELEMENT catalog (section+)>
  <!ELEMENT section (title, item*)>
  <!ATTLIST section code ID #REQUIRED>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT item (name, price, note?)>
  <!ATTLIST item sku ID #REQUIRED state (new|used|archived) "new">
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT price (#PCDATA)>
  <!ELEMENT note (#PCDATA|emph|break)*>
  <!ELEMENT emph (#PCDATA)>
  <!ELEMENT break EMPTY>
  <!ENTITY currency "€">
]>
<catalog>
  <section code="s-main">
    <title>Seasonal &currency; collection</title>
    <item sku="x-17" state="new">
      <name>Lantern</name>
      <price>19.95 &currency;</price>
      <note>compact <emph>brass</emph><break/> finish</note>
    </item>
    <item sku="x-18" state="used">
      <name>Compass</name>
      <price>7.50 &currency;</price>
    </item>
  </section>
</catalog>