<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE report [
  <!NOTATION bin SYSTEM "application/octet-stream">
  <!ENTITY blob SYSTEM "data:application/octet-stream;base64,AAEC" NDATA bin>
  <!ELEMENT report (header, attachment, tail)>
  <!ELEMENT header (#PCDATA)>
  <!ELEMENT attachment EMPTY>
  <!ATTLIST attachment source ENTITY #REQUIRED>
  <!ELEMENT tail (#PCDATA)>
]>
<report>
  <header>before<?audit level="verbose"?>after</header>
  <attachment source="blob"/>
  <tail><![CDATA[raw ]]> text &apos;after&apos;</tail>
</report>