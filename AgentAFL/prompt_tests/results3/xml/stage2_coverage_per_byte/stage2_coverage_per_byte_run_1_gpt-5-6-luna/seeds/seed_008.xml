<?xml version="1.0"?>
<!DOCTYPE report [
  <!ENTITY % common "INCLUDE">
  <!ELEMENT report (section*)>
  <!ELEMENT section (heading, item+)>
  <!ELEMENT heading (#PCDATA)>
  <!ELEMENT item (#PCDATA|note)*>
  <!ELEMENT note (#PCDATA)>
  <!ATTLIST section name CDATA #REQUIRED>
  <!ATTLIST item code NMTOKEN #IMPLIED>
  <![%common;[
    <!ENTITY warning "Attention: &lt;check&gt;">
  ]]>
]>
<?processing target-data?>
<report>
  <section name="alpha">
    <heading>First section</heading>
    <item code="A-1">Plain item<note>&warning;</note></item>
    <item code="A_2"><![CDATA[raw <markup> & symbols]]></item>
  </section>
  <section name="beta">
    <heading>Second</heading>
    <item>Line one
Line two</item>
  </section>
</report>