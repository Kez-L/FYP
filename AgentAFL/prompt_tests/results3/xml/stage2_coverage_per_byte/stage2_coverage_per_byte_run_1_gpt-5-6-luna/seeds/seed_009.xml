<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE inventory [
  <!ELEMENT inventory (product*)>
  <!ELEMENT product (name, price, details?)>
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT price (#PCDATA)>
  <!ELEMENT details (color|size|weight)*>
  <!ELEMENT color (#PCDATA)>
  <!ELEMENT size (#PCDATA)>
  <!ELEMENT weight (#PCDATA)>
  <!ATTLIST product sku ID #REQUIRED category CDATA #IMPLIED>
]>
<inventory>
  <product sku="p001" category="tools">
    <name>Hammer</name>
    <price currency="USD">19.95</price>
    <details>
      <color>blue</color>
      <size>medium</size>
      <weight>1.2kg</weight>
    </details>
  </product>
  <product sku="p002" category="misc">
    <name><![CDATA[Bracket ]]]]><![CDATA[> sample]]></name>
    <price>0</price>
    <details/>
  </product>
</inventory>