<?xml version="1.0" standalone="yes"?>
<!DOCTYPE archive [
  <!ELEMENT archive (header,entry+)>
  <!ELEMENT header (title,created)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT created (#PCDATA)>
  <!ELEMENT entry (name,tag*,payload)>
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT tag (#PCDATA)>
  <!ELEMENT payload (#PCDATA|link|br)*>
  <!ELEMENT link EMPTY>
  <!ELEMENT br EMPTY>
  <!ATTLIST archive version NMTOKEN #REQUIRED>
  <!ATTLIST entry id ID #REQUIRED refs IDREFS #IMPLIED state (new|held|done) "new">
  <!ATTLIST link target IDREF #REQUIRED>
  <!ENTITY copyright "&#xA9; 2026">
  <!ENTITY % audit "<!ATTLIST entry audited (yes|no) 'no'>">
  %audit;
]>
