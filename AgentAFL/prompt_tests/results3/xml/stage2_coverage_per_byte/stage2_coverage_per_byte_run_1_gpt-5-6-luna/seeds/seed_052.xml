<?xml version="1.0"?>
<!DOCTYPE package [
  <!NOTATION png SYSTEM "image/png">
  <!NOTATION text PUBLIC "-//EXAMPLE//NOTATION Plain Text//EN">
  <!ENTITY logo SYSTEM "assets/logo.png" NDATA png>
  <!ELEMENT package (header, asset+, description)>
  <!ELEMENT header (name, version)>
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT version (#PCDATA)>
  <!ELEMENT asset EMPTY>
  <!ELEMENT description (#PCDATA|em|br)*>
  <!ELEMENT em (#PCDATA)>
  <!ELEMENT br EMPTY>
  <!ATTLIST asset
    source ENTITY #REQUIRED
    format NOTATION #REQUIRED
    optional ENTITY #IMPLIED>
]>
<package>
  <header><name>bundle</name><version>3.0</version></header>
  <asset source="logo" format="png"/>
  <asset source="logo" format="png" optional="logo"/>
  <description>Use <em>carefully</em><br/>after unpacking.</description>
</package>