<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE library [
  <!ELEMENT library (shelf+)>
  <!ELEMENT shelf (book|note)*>
  <!ELEMENT book (title, author, ref*)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT author (#PCDATA)>
  <!ELEMENT ref EMPTY>
  <!ELEMENT note (#PCDATA)>
  <!ATTLIST shelf xml:lang NMTOKEN #IMPLIED>
  <!ATTLIST book isbn ID #REQUIRED category (fiction|science|other) "other">
  <!ATTLIST ref target IDREF #REQUIRED type NMTOKEN #IMPLIED>
  <!ENTITY open "<mark>">
  <!ENTITY close "</mark>">
  <!ENTITY phrase "A &amp; B">
]>
<library>
  <shelf xml:lang="fr">
    <book isbn="b17" category="science">
      <title>&open;R&amp;D &phrase;&close;</title>
      <author>Émile</author>
      <ref target="b17" type="self"/>
    </book>
    <note><![CDATA[unparsed ]]> text &lt;here&gt;</note>
  </shelf>
</library>