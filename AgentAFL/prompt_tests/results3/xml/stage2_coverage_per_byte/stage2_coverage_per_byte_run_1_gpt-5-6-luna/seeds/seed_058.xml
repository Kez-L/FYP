<?xml version="1.0"?>
<!DOCTYPE document [
  <!ELEMENT document (chapter+)>
  <!ELEMENT chapter (heading, (paragraph|table|warning)*)>
  <!ELEMENT heading (#PCDATA)>
  <!ELEMENT paragraph (#PCDATA|link|linebreak)*>
  <!ELEMENT link (#PCDATA)>
  <!ELEMENT linebreak EMPTY>
  <!ELEMENT table (row+)>
  <!ELEMENT row (cell+)>
  <!ELEMENT cell (#PCDATA)>
  <!ELEMENT warning (#PCDATA)>
  <!ATTLIST chapter number NMTOKEN #REQUIRED>
  <!ATTLIST link href CDATA #REQUIRED external (yes|no) "no">
  <!ATTLIST cell colspan NMTOKEN "1">
]>
<document>
  <chapter number="01">
    <heading>Parsing notes</heading>
    <paragraph>First line<linebreak/>second line with <link href="urn:x" external="yes">a link</link>.</paragraph>
    <table>
      <row><cell colspan="2">A &lt; B</cell><cell>C</cell></row>
      <row><cell>one</cell><cell><![CDATA[raw ]]> text</cell></row>
    </table>
    <warning xml:space="preserve">
      <![CDATA[ warning: <token> & value ]]>
    </warning>
  </chapter>
</document>