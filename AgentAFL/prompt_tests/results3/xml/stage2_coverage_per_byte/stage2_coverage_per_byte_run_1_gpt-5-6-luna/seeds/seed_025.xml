<?xml version="1.0"?>
<!DOCTYPE catalog [
  <!ENTITY % parts "
    <!ELEMENT entry (name, price, tags?)>
    <!ELEMENT name (#PCDATA)>
    <!ELEMENT price (#PCDATA)>
    <!ELEMENT tags (tag+)>
    <!ELEMENT tag (#PCDATA)>
  ">
  %parts;
  <!NOTATION jpeg SYSTEM "image/jpeg">
  <!ENTITY logo SYSTEM "logo.jpg" NDATA jpeg>
  <!ELEMENT catalog (entry|&amp;logo;)*>
  <!ATTLIST catalog
    xmlns CDATA #IMPLIED
    version NMTOKEN "1">
  <![IGNORE[
    <!ELEMENT ignored ANY>
    <!ATTLIST ignored temporary CDATA #IMPLIED>
  ]]>
]>
<catalog xmlns="urn:inventory" version="2">
  <entry>
    <name>tea &amp; honey</name>
    <price currency="EUR">4.75</price>
    <tags><tag>organic</tag><tag>loose-leaf</tag></tags>
  </entry>
</catalog>