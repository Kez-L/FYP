<?xml version="1.0"?>
<!DOCTYPE message [
  <!ELEMENT message (sender, recipients, payload)>
  <!ELEMENT sender (#PCDATA)>
  <!ELEMENT recipients (to, cc*)>
  <!ELEMENT to (#PCDATA)>
  <!ELEMENT cc (#PCDATA)>
  <!ELEMENT payload ANY>
  <!ATTLIST message format CDATA #IMPLIED>
  <!ENTITY nbsp "&#160;">
  <!ENTITY quoted "&quot;quoted&quot;">
]>
<message format="multipart">
  <sender>alice@example.test</sender>
  <recipients>
    <to>bob@example.test</to>
    <cc>carol@example.test</cc>
    <cc>&nbsp;</cc>
  </recipients>
  <payload>
    <part name="text">Hello &quoted;</part>
    <part name="binary"><![CDATA[
      A]]>B]]&gt;C
    ]]></part>
    <?trace id="7"?>
  </payload>
</message>