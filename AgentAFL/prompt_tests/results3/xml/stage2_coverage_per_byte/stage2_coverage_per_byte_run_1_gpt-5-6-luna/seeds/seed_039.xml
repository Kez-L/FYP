<?xml version="1.0" standalone="no"?>
<!DOCTYPE museum [
  <!ELEMENT museum (room+)>
  <!ELEMENT room (caption, artifact*)>
  <!ELEMENT caption (#PCDATA)>
  <!ELEMENT artifact (name, note?)>
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT note (#PCDATA|mark)*>
  <!ELEMENT mark (#PCDATA)>
  <!ATTLIST museum xmlns:m CDATA #IMPLIED>
  <!ATTLIST room number NMTOKEN #REQUIRED>
  <!ATTLIST artifact m:class (painting|tool|text) #REQUIRED
                    accession ID #REQUIRED>
  <!ATTLIST note xml:lang CDATA #IMPLIED>
  <!ENTITY museumName "The &apos;North Wing&apos;">
]>
<museum xmlns:m="urn:museum">
  <room number="IV">
    <caption>&museumName;</caption>
    <artifact m:class="painting" accession="a-01">
      <name>Blue <mark>Study</mark></name>
      <note xml:lang="fr">trait &amp; couleur</note>
    </artifact>
    <artifact m:class="text" accession="a-02">
      <name>Fragment</name>
    </artifact>
  </room>
  <room number="V"><caption><![CDATA[Closed]]></caption></room>
</museum>