<?xml version="1.0" encoding="ISO-8859-1"?>
<!DOCTYPE form [
  <!ELEMENT form (section+)>
  <!ELEMENT section (label, control*)>
  <!ATTLIST section name CDATA #REQUIRED>
  <!ELEMENT label (#PCDATA)>
  <!ELEMENT control EMPTY>
  <!ATTLIST control
    kind CDATA #REQUIRED
    value CDATA #IMPLIED
    checked (checked|unchecked) #IMPLIED
    refs IDREFS #IMPLIED>
]>
<form>
  <section name="general">
    <label>Résumé &amp; Preferences</label>
    <control kind="text" value="a&quot;b"/>
    <control kind="checkbox" checked="checked" refs="x y"/>
  </section>
  <section name="empty">
    <label><![CDATA[]]></label>
  </section>
  <section name="broken">
    <label>unfinished</label>
    <control kind="select" value="one&#x0B;two"/>
  </section>
</form>