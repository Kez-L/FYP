<?xml version="1.0"?>
<!DOCTYPE warehouse [
  <!ELEMENT warehouse (aisle*, audit)>
  <!ELEMENT aisle (bin+)>
  <!ELEMENT bin (label, item*)>
  <!ELEMENT label (#PCDATA)>
  <!ELEMENT item EMPTY>
  <!ELEMENT audit (#PCDATA)>
  <!ATTLIST warehouse xmlns CDATA #IMPLIED>
  <!ATTLIST aisle code NMTOKEN #REQUIRED>
  <!ATTLIST bin id ID #REQUIRED sealed (yes|no) "no">
  <!ATTLIST item sku CDATA #REQUIRED quantity NMTOKEN #IMPLIED>
  <!ENTITY warning "Use &quot;approved&quot; stock only">
]>
<warehouse xmlns="urn:stock">
  <aisle code="A-7">
    <bin id="b17" sealed="yes">
      <label>Odd &amp; fragile</label>
      <item sku="Q&amp;R" quantity="004"/>
      <item sku="&#x1F4E6;" quantity="1"/>
    </bin>
  </aisle>
  <audit>&warning;</audit>
</warehouse>