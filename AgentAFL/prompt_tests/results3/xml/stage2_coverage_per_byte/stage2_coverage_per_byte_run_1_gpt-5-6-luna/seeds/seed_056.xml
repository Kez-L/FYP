<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE message [
  <!ELEMENT message (header, body)>
  <!ELEMENT header (from, to, subject)>
  <!ELEMENT from (#PCDATA)>
  <!ELEMENT to (#PCDATA)>
  <!ELEMENT subject (#PCDATA)>
  <!ELEMENT body (para|quote|list)*>
  <!ELEMENT para (#PCDATA|code)*>
  <!ELEMENT quote (#PCDATA|para)*>
  <!ELEMENT list (item+)>
  <!ELEMENT item (#PCDATA|para)*>
  <!ELEMENT code (#PCDATA)>
  <!ATTLIST message uid ID #IMPLIED ref IDREFS #IMPLIED>
  <!ATTLIST from address CDATA #REQUIRED>
  <!ATTLIST to address CDATA #REQUIRED>
  <!ENTITY left "&#xAB;">
  <!ENTITY right "&#xBB;">
]>
<message uid="m42" ref="m42">
  <header>
    <from address="a@example.test">alice</from>
    <to address="b@example.test">bob</to>
    <subject>&left;status &amp; handoff&right;</subject>
  </header>
  <body>
    <para>Use <code>if (x &lt; y)</code> before deployment.</para>
    <quote><para>Nested quoted text</para></quote>
    <list>
      <item>first</item>
      <item><para>second with &#x9; spacing</para></item>
    </list>
  </body>
</message>