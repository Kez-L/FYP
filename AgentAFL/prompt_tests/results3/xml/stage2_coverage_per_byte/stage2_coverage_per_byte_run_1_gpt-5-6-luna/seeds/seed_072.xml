<!DOCTYPE canvas [
  <!ELEMENT canvas (layer+)>
  <!ELEMENT layer (shape*)>
  <!ELEMENT shape (point|label|style)*>
  <!ELEMENT point EMPTY>
  <!ELEMENT label (#PCDATA)>
  <!ELEMENT style EMPTY>
  <!ATTLIST canvas width NMTOKEN #IMPLIED height NMTOKEN #IMPLIED>
  <!ATTLIST layer name CDATA #IMPLIED opacity CDATA "1.0">
  <!ATTLIST shape kind (circle|rect|path) #REQUIRED>
  <!ATTLIST point x CDATA #REQUIRED y CDATA #REQUIRED>
  <!ATTLIST style fill CDATA #IMPLIED stroke CDATA #IMPLIED>
]>
<canvas width="640" height="480">
  <layer name="background" opacity="0">
    <shape kind="rect">
      <point x="0" y="0"/>
      <point x="640" y="480"/>
      <style fill="#000000" stroke="none"/>
    </shape>
  </layer>
  <layer name="foreground" opacity="0.75">
    <shape kind="path">
      <point x="-1" y="2"/>
      <label>curve &amp; control</label>
      <style stroke="url(#paint_1)"/>
    </shape>
  </layer>
</canvas>