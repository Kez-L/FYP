<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE media [
  <!NOTATION png SYSTEM "image/png">
  <!NOTATION txt SYSTEM "text/plain">
  <!ENTITY logo SYSTEM "logo.png" NDATA png>
  <!ENTITY note "A &quot;quoted&quot; fragment">
  <!ELEMENT media (asset*, description)>
  <!ELEMENT asset EMPTY>
  <!ATTLIST asset
    name CDATA #REQUIRED
    format NOTATION (png|txt) #IMPLIED
    source ENTITY #IMPLIED>
  <!ELEMENT description (#PCDATA)>
]>
<media>
  <asset name="icon" format="png" source="logo"/>
  <asset name="readme" format="txt"/>
  <description>&note; <![CDATA[unparsed ]]> text</description>
</media>