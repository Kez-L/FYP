<?xml version="1.0"?>
<!DOCTYPE scene [
  <!ELEMENT scene (layer*)>
  <!ELEMENT layer (shape|text|layer)*>
  <!ELEMENT shape EMPTY>
  <!ELEMENT text (#PCDATA)>
  <!ATTLIST scene xmlns:svg CDATA #FIXED "http://www.w3.org/2000/svg">
  <!ATTLIST layer name CDATA #IMPLIED visible (true|false) "true">
  <!ATTLIST shape id ID #IMPLIED points NMTOKENS #IMPLIED>
  <!ATTLIST text xml:space (default|preserve) "preserve">
]>
<scene xmlns="urn:scene" xmlns:svg="http://www.w3.org/2000/svg">
  <layer name="background" visible="false">
    <svg:rect id="r0" x="0" y="0" width="100" height="20"/>
    <shape id="s0" points="0,0 10,10 20,0"/>
    <layer name="nested">
      <text xml:space="preserve">  spaced &quot;text&quot;  </text>
      <svg:path d="M0 0 L1 1"/>
    </layer>
  </layer>
</scene>