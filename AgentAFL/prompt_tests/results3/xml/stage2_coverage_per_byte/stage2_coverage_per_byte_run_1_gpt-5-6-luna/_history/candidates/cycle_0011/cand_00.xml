<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE catalog [
  <!ENTITY % model "
    <!ELEMENT catalog (entry+)>
    <!ELEMENT entry (title, price?, note*)>
    <!ELEMENT title (#PCDATA)>
    <!ELEMENT price (#PCDATA)>
    <!ELEMENT note (#PCDATA)>
    <!ATTLIST entry
      code ID #REQUIRED
      status (new|used|archived) 'new'>
  ">
  %model;
  <!ENTITY euro "&#x20AC;">
]>
<catalog>
  <entry code="a17" status="new">
    <title>Handbook</title>
    <price>19 &euro; 95</price>
    <note>sealed</note>
  </entry>
  <entry code="b04" status="archived">
    <title>Archive box</title>
    <note><![CDATA[marked <fragile> & retained]]></note>
    <note xml:space="preserve">  trailing spaces  </note>
  </entry>
</catalog>