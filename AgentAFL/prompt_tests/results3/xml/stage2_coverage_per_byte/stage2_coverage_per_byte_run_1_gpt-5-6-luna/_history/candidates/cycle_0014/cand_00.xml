<?xml version="1.0"?>
<!DOCTYPE catalog [
  <!ENTITY % common "sku ID #REQUIRED price CDATA #IMPLIED">
  <!ELEMENT catalog (entry+, note?)>
  <!ELEMENT entry (title, detail, related*)>
  <!ATTLIST entry %common;>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT detail (#PCDATA|emph|code)*>
  <!ELEMENT emph (#PCDATA)>
  <!ELEMENT code (#PCDATA)>
  <!ELEMENT related EMPTY>
  <!ATTLIST related ref IDREF #REQUIRED>
  <!ELEMENT note (#PCDATA)>
  <!ENTITY ampersand "&#38;">
]>
<catalog>
  <entry sku="A-1" price="&amp;7">
    <title>Alpha &amp; Beta</title>
    <detail>Use <emph>care</emph> with <code>&amp;entity;</code>.</detail>
    <related ref="A-1"/>
  </entry>
  <entry sku="B-2">
    <title>Second</title>
    <detail>mixed <emph>text</emph> and <code>markup</code></detail>
  </entry>
  <note>literal &amp;ampersand; and &amp;entity;</note>
</catalog>