<?xml version="1.0"?>
<!DOCTYPE message [
  <!ELEMENT message (header, body)>
  <!ELEMENT header (from, to, subject)>
  <!ELEMENT from (#PCDATA)>
  <!ELEMENT to (#PCDATA)>
  <!ELEMENT subject (#PCDATA)>
  <!ELEMENT body (#PCDATA|quote|br)*>
  <!ELEMENT quote (#PCDATA)>
  <!ELEMENT br EMPTY>
  <!ATTLIST message priority CDATA "normal">
  <!ENTITY nbsp "&#160;">
]>
<message priority="urgent">
  <header>
    <from>alice@example.test</from>
    <to>bob@example.test</to>
    <subject>Updates &amp; questions</subject>
  </header>
  <body>
    Hello,&nbsp;<br/>
    <quote>Use &quot;safe&quot; parsing.</quote>
    More text with &#x1F600; and a trailing marker
  </body>
</message>