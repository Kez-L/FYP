<?xml version="1.0"?>
<!DOCTYPE catalog [
  <!ENTITY % commonAttrs 'xml:lang NMTOKEN #IMPLIED xml:space (default|preserve) "default"'>
  <!ENTITY copyright "&#xA9; 2026">
  <!NOTATION jpg SYSTEM "image/jpeg">
  <!ELEMENT catalog (entry+)>
  <!ELEMENT entry (title,summary?,media*)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT summary (#PCDATA|em|br)*>
  <!ELEMENT em (#PCDATA)>
  <!ELEMENT br EMPTY>
  <!ELEMENT media EMPTY>
  <!ATTLIST catalog version NMTOKEN "1">
  <!ATTLIST entry id ID #REQUIRED status (draft|published|archived) "draft">
  <!ATTLIST entry %commonAttrs;>
  <!ATTLIST media src ENTITY #REQUIRED format NOTATION (jpg) #REQUIRED>
]>
<catalog version="2">
  <entry id="e1" status="published" xml:space="preserve">
    <title>R&amp;D &copyright;</title>
    <summary>Text <em>with emphasis</em><br/>after it</summary>
    <media src="cover" format="jpg"/>
  </entry>
</catalog>