<?xml version="1.0" encoding="ISO-8859-1"?>
<!DOCTYPE envelope [
  <!ELEMENT envelope (meta?, payload)>
  <!ELEMENT meta (created, tags?)>
  <!ELEMENT created (#PCDATA)>
  <!ELEMENT tags (tag+)>
  <!ELEMENT tag (#PCDATA)>
  <!ELEMENT payload (#PCDATA)>
  <!ATTLIST payload format NOTATION (text|binary) "text">
]>
<envelope>
  <meta>
    <created>2026-09-23T00:00:00Z</created>
    <tags><tag>one</tag><tag>two</tag></tags>
  </meta>
  <payload format="binary">A&amp;B&lt;C&gt;</payload>
</envelope>