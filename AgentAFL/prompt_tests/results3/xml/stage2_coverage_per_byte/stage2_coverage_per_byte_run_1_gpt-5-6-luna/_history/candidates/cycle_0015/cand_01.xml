<?xml version="1.0"?>
<!DOCTYPE map [
  <!ELEMENT map (entry*)>
  <!ELEMENT entry (key, value)>
  <!ELEMENT key (#PCDATA)>
  <!ELEMENT value (text|number|list|missing)>
  <!ELEMENT text (#PCDATA)>
  <!ELEMENT number (#PCDATA)>
  <!ELEMENT list (value*)>
  <!ELEMENT missing EMPTY>
  <!ATTLIST entry name NMTOKEN #REQUIRED>
]>
<map>
  <entry name="alpha">
    <key>alpha</key>
    <value><text>one</text></value>
  </entry>
  <entry name="beta">
    <key>beta</key>
    <value><list>
      <value><number>001</number></value>
      <value><missing/></value>
      <value><text>two &lt; three</text></value>
    </list></value>
  </entry>
  <entry name="gamma">
    <key><![CDATA[broken-looking ]]> text</key>
    <value><number>NaN</number></value>
  </entry>
</map>