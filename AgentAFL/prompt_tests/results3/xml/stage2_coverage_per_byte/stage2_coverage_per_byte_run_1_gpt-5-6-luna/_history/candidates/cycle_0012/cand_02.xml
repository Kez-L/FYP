<?xml version="1.0"?>
<!DOCTYPE settings [
  <!ELEMENT settings (profile*, fallback?)>
  <!ELEMENT profile (option*)>
  <!ELEMENT option EMPTY>
  <!ELEMENT fallback (#PCDATA)>
  <!ATTLIST settings xmlns CDATA #IMPLIED>
  <!ATTLIST profile name NMTOKEN #REQUIRED active (yes|no) "no">
  <!ATTLIST option key NMTOKEN #REQUIRED value CDATA #IMPLIED locked (true|false) "false">
  <!ATTLIST fallback xml:lang NMTOKEN #IMPLIED>
]>
<settings xmlns="urn:settings" xmlns:ui="urn:ui">
  <profile name="desktop" active="yes">
    <option key="theme" value="dark" locked="true"/>
    <option key="font" value="Noto &quot;Sans&quot;"/>
    <ui:option key="scale" value="125%"/>
  </profile>
  <profile name="mobile">
    <option key="theme"/>
  </profile>
  <fallback xml:lang="fr">Configuration indisponible &amp; réinitialisée</fallback>
</settings>