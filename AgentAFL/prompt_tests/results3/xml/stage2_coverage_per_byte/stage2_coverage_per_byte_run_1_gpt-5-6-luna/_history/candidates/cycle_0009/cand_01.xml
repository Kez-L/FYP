<?xml version="1.1"?>
<!DOCTYPE packet [
  <!ENTITY % switch "<!ELEMENT packet (meta, body, trailer?)>">
  %switch;
  <!ELEMENT meta EMPTY>
  <!ELEMENT body (#PCDATA|item)*>
  <!ELEMENT item EMPTY>
  <!ELEMENT trailer (#PCDATA)>
  <!ATTLIST packet code NMTOKEN #IMPLIED>
  <![INCLUDE[
    <!ATTLIST item
      name NMTOKEN #REQUIRED
      enabled (yes|no) "yes">
  ]]>
]>
<packet code="A&#x85;B">
  <meta/>
  <body>alpha<item name="n_1"/>&#x1F;omega</body>
  <trailer>line one&#x85;line two</trailer>
</packet>