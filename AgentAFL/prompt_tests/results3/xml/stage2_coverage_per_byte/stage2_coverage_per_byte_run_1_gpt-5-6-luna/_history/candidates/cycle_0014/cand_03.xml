<?xml version="1.0" encoding="ISO-8859-1"?>
<!DOCTYPE form [
  <!ELEMENT form (section|separator)*>
  <!ELEMENT section (label, input*)>
  <!ATTLIST section key NMTOKEN #IMPLIED>
  <!ELEMENT label (#PCDATA)>
  <!ELEMENT input EMPTY>
  <!ATTLIST input
    name CDATA #REQUIRED
    type (text|checkbox|hidden) "text"
    checked (yes|no) "no">
  <!ELEMENT separator EMPTY>
]>
<form>
  <section key="first">
    <label>Résumé &amp; overview</label>
    <input name="q" type="text"/>
    <input name="agree" type="checkbox" checked="yes"/>
  </section>
  <separator/>
  <section>
    <label><![CDATA[raw ]]> label</label>
    <input name="token" type="hidden" checked="maybe"/>
  </section>
</form>