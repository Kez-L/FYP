<?xml version="1.0"?>
<!DOCTYPE graph [
  <!ELEMENT graph (node|edge)*>
  <!ELEMENT node EMPTY>
  <!ELEMENT edge EMPTY>
  <!ATTLIST graph xmlns:g CDATA #IMPLIED>
  <!ATTLIST node g:key NMTOKEN #REQUIRED
                refs IDREFS #IMPLIED>
  <!ATTLIST edge from IDREF #REQUIRED
                to IDREF #REQUIRED
                weight CDATA "0.0">
  <!NOTATION bin SYSTEM "application/octet-stream">
  <!ENTITY blob SYSTEM "payload.bin" NDATA bin>
]>
<graph xmlns:g="urn:graph">
  <node g:key="root" refs="leaf branch"/>
  <node g:key="leaf"/>
  <node g:key="branch"/>
  <edge from="root" to="leaf" weight="1&amp;2"/>
  <edge from="root" to="branch"/>
  <?edge hint?>
</graph>