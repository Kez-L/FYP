<?xml version="1.0"?>
<!DOCTYPE map [
  <!ELEMENT map (node)>
  <!ELEMENT node (node|leaf)*>
  <!ELEMENT leaf (#PCDATA)>
  <!ATTLIST node
    xmlns CDATA #IMPLIED
    xmlns:m CDATA #IMPLIED
    m:id NMTOKEN #IMPLIED>
  <!ATTLIST leaf role (key|value|empty) "value">
]>
<map xmlns="urn:base" xmlns:m="urn:meta">
  <node m:id="r1">
    <leaf role="key">one</leaf>
    <node xmlns:m="urn:other" m:id="r2">
      <leaf role="value">two</leaf>
      <leaf xmlns="">detached</leaf>
    </node>
    <m:leaf role="empty"/>
  </node>
</map>