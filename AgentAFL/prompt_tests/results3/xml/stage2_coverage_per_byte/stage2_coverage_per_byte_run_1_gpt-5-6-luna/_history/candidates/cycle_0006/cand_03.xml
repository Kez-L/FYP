<?xml version="1.1"?>
<!DOCTYPE report [
  <!ELEMENT report (section*)>
  <!ELEMENT section (heading, body)>
  <!ATTLIST section xml:lang NMTOKEN #IMPLIED>
  <!ELEMENT heading (#PCDATA)>
  <!ELEMENT body (line|break|table)*>
  <!ELEMENT line (#PCDATA|em|code)*>
  <!ELEMENT em (#PCDATA)>
  <!ELEMENT code (#PCDATA)>
  <!ELEMENT break EMPTY>
  <!ELEMENT table (row+)>
  <!ELEMENT row (cell+)>
  <!ELEMENT cell (#PCDATA)>
]>
<report xml:space="preserve">
  <section xml:lang="fr">
    <heading>Résumé &#x2026;</heading>
    <body>
      <line>avant <em>milieu</em> après</line>
      <break/>
      <table>
        <row><cell>A</cell><cell><![CDATA[B < C]]></cell></row>
        <row><cell>𐐷</cell><cell>fin</cell></row>
      </table>
      <line><code>if (x &lt; 2) return;</code><?note data?>tail</line>
    </body>
  </section>
</report>