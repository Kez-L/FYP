<?xml version="1.0"?>
<!DOCTYPE catalog [
  <!ENTITY % common "CDATA">
  <!ELEMENT catalog (item+, note?)>
  <!ELEMENT item (name, price, description?)>
  <!ATTLIST item id ID #REQUIRED status (new|used|archived) "new">
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT price (#PCDATA)>
  <!ELEMENT description (#PCDATA|emph)*>
  <!ELEMENT emph (#PCDATA)>
  <!ELEMENT note (#PCDATA)>
]>
<catalog>
  <item id="a1" status="archived">
    <name>alpha</name>
    <price>12.50</price>
    <description>old <emph>stock</emph></description>
  </item>
  <note>check &amp; verify</note>
</catalog>