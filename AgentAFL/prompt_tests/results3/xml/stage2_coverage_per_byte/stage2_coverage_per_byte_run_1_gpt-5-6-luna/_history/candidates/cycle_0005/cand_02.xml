<!DOCTYPE dashboard [
  <!ENTITY % common '
    <!ELEMENT widget (title, data)>
    <!ELEMENT title (#PCDATA)>
    <!ELEMENT data (#PCDATA|item|br)*>
    <!ELEMENT item EMPTY>
    <!ATTLIST item code CDATA #IMPLIED>
    <!ELEMENT br EMPTY>
  '>
  %common;
  <!ELEMENT dashboard (widget|separator)*>
  <!ELEMENT separator EMPTY>
]>
