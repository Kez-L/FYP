    <title>Rates &amp; Ratios</title>
    <data>12<item code="A&amp;B"/><br/>34<![CDATA[<raw>]]></data>
  </widget>
  <separator/>
  <widget>
    <title><?hint priority="low"?>Second</title>
    <data><item/><item code="&#x1F;"/></data>
  </widget>
</dashboard>