<?xml version="1.0"?>
<!DOCTYPE media [
  <!ELEMENT media (caption?,asset*)>
  <!ELEMENT caption (#PCDATA)>
  <!ELEMENT asset EMPTY>
  <!ATTLIST asset
    name CDATA #REQUIRED
    kind NOTATION (gif|jpeg|bin) #REQUIRED
    source ENTITY #IMPLIED
    dimensions NMTOKENS #IMPLIED>
  <!NOTATION gif SYSTEM "image/gif">
  <!NOTATION jpeg PUBLIC "-//IMAGE/JPEG//EN" "jpeg-handler">
  <!NOTATION bin SYSTEM "application/octet-stream">
  <!ENTITY logo SYSTEM "logo.gif" NDATA gif>
  <!ENTITY raw SYSTEM "blob.bin" NDATA bin>
]>
<media>
  <caption>catalog &quot;entries&quot;</caption>
  <asset name="logo.gif" kind="gif" source="logo" dimensions="64 64"/>
  <asset name="photo.jpeg" kind="jpeg" dimensions="1024&#x20;768"/>
  <asset name="data.bin" kind="bin" source="raw"/>
</media>