<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE message [
  <!ENTITY greet "hello">
  <!ENTITY % attrs "priority (low|normal|high) 'normal'">
  <!ELEMENT message (header, body, footer?)>
  <!ELEMENT header (from, to, subject)>
  <!ELEMENT from (#PCDATA)>
  <!ELEMENT to (#PCDATA)>
  <!ELEMENT subject (#PCDATA)>
  <!ELEMENT body (#PCDATA|quote|br)*>
  <!ELEMENT quote (#PCDATA|quote)*>
  <!ELEMENT br EMPTY>
  <!ELEMENT footer (#PCDATA)>
  <!ATTLIST message %attrs; ref ID #IMPLIED>
]>
<message ref="m1" priority="high">
  <header>
    <from>&greet;@example.org</from>
    <to>reader@example.net</to>
    <subject>Nested &amp; encoded</subject>
  </header>
  <body>Start<quote>Outer <quote>Inner</quote> tail</quote><br/>End</body>
  <footer>signed</footer>
</message>