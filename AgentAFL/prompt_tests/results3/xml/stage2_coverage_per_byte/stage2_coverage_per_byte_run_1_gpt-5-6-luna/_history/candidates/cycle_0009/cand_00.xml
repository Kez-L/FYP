<?xml version="1.0"?>
<!DOCTYPE dashboard [
  <!ELEMENT dashboard (widget*)>
  <!ELEMENT widget ANY>
  <!ATTLIST widget
    id ID #REQUIRED
    kind (gauge|chart|table) "gauge"
    data ENTITY #IMPLIED>
  <!NOTATION gif SYSTEM "image/gif">
  <!ENTITY logo SYSTEM "logo.gif" NDATA gif>
  <!ENTITY tick "&#x2713;">
]>
<dashboard version="2" xmlns="urn:dashboard">
  <!-- mixed content and a processing instruction -->
  <?render theme="dark" compact?>
  <widget id="w0" kind="gauge">ready &tick;</widget>
  <widget id="w1" kind="chart" data="logo">
    <![CDATA[x < y && y > z ]]> tail
    <detail xmlns="">plain</detail>
  </widget>
</dashboard>