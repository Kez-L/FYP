  <!ATTLIST node id ID #REQUIRED x CDATA #REQUIRED y CDATA #REQUIRED label CDATA #IMPLIED>
  <!ATTLIST edge from IDREF #REQUIRED to IDREF #REQUIRED weight CDATA "1">
]>
