<?xml version="1.0"?>
<!DOCTYPE archive [
  <!ELEMENT archive (meta, record*)>
  <!ELEMENT meta EMPTY>
  <!ATTLIST meta
    created CDATA #IMPLIED
    sealed (yes|no) "no">
  <!ELEMENT record (key, value, note?)>
  <!ELEMENT key (#PCDATA)>
  <!ELEMENT value (#PCDATA|mark)*>
  <!ELEMENT mark (#PCDATA)>
  <!ELEMENT note (#PCDATA)>
  <!ENTITY left "&lt;">
  <!ENTITY right "&gt;">
]>
<archive>
  <meta created="1970-01-01T00:00:00Z" sealed="yes"/>
  <record>
    <key>alpha</key>
    <value>&left;mark&right;<mark>one</mark>&right;</value>
    <note/>
  </record>
  <record>
    <key>beta</key>
    <value>before<mark><![CDATA[x]]></mark>after</value>
    <note>line1
line2&#x0D;line3</note>
  </record>
</archive>