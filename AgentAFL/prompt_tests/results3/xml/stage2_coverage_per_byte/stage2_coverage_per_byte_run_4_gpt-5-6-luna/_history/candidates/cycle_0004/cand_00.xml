<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE catalog [
  <!NOTATION png SYSTEM "image/png">
  <!ENTITY logo SYSTEM "logo.png" NDATA png>
  <!ELEMENT catalog (entry+)>
  <!ELEMENT entry (title, description?, link*)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT description (#PCDATA|em|code)*>
  <!ELEMENT em (#PCDATA)>
  <!ELEMENT code (#PCDATA)>
  <!ELEMENT link EMPTY>
  <!ATTLIST entry id ID #REQUIRED ref IDREF #IMPLIED>
  <!ATTLIST link href CDATA #REQUIRED rel (next|prev|related) "related">
]>
<catalog>
  <entry id="first">
    <title>Binary &amp; Text</title>
    <description>use <em>emphasis</em> and <code>code</code> here</description>
    <link href="next.xml" rel="next"/>
  </entry>
  <entry id="second" ref="first">
    <title>Picture &logo;</title>
    <link href="previous.xml" rel="prev"/>
  </entry>
</catalog>