<?xml version="1.0"?>
<!DOCTYPE report [
  <!ELEMENT report (title, section*)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT section (heading?, paragraph*, list?)>
  <!ELEMENT heading (#PCDATA)>
  <!ELEMENT paragraph (#PCDATA|bold|italic|code|ref)*>
  <!ELEMENT bold (#PCDATA)>
  <!ELEMENT italic (#PCDATA)>
  <!ELEMENT code (#PCDATA)>
  <!ELEMENT ref EMPTY>
  <!ELEMENT list (entry+)>
  <!ELEMENT entry (#PCDATA|paragraph)*>
  <!ATTLIST report generated CDATA #IMPLIED>
  <!ATTLIST section name CDATA #REQUIRED>
  <!ATTLIST ref target CDATA #REQUIRED>
  <!ENTITY nbsp "&#160;">
  <!ENTITY mark "<bold>important</bold>">
]>
<report generated="true">
  <title>Parser &amp; token boundaries</title>
  <section name="mixed">
    <heading>Examples</heading>
    <paragraph>Text &nbsp;<bold>strong</bold> and <italic>soft</italic>.</paragraph>
    <paragraph>Inline <code>a&amp;b&lt;c</code> <ref target="sec-2"/> tail.</paragraph>
    <list>
      <entry>first</entry>
      <entry><paragraph>nested paragraph</paragraph>second</entry>
    </list>
  </section>
  <section name="entity">
    <paragraph>Before &mark; after.</paragraph>
    <![CDATA[raw ]]> data
  </section>
</report>