<?xml version="1.0"?>
<!DOCTYPE envelope [
  <!ELEMENT envelope (header, payload)>
  <!ELEMENT header (item*)>
  <!ELEMENT item EMPTY>
  <!ELEMENT payload (text|list|blob)>
  <!ELEMENT text (#PCDATA)>
  <!ELEMENT list (value+)>
  <!ELEMENT value (#PCDATA)>
  <!ELEMENT blob (#PCDATA)>
  <!ATTLIST envelope xmlns CDATA #IMPLIED>
  <!ATTLIST item key CDATA #REQUIRED value CDATA #IMPLIED>
  <!ATTLIST payload format (plain|encoded) "plain">
  <!ENTITY left "(">
  <!ENTITY right ")">
]>
<envelope xmlns="urn:envelope">
  <header>
    <item key="trace" value="&left;abc&right;"/>
    <item key="empty"/>
  </header>
  <payload format="encoded">
    <blob><![CDATA[
      QWxwaGE+JiBCZXRh
      ]]></blob>
  </payload>
</envelope>