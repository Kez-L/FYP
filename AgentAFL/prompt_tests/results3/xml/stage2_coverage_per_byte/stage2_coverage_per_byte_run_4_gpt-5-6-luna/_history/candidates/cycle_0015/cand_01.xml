<!DOCTYPE warehouse [
  <!ENTITY % atoms "<!ELEMENT bin EMPTY><!ELEMENT crate (label?,item*)><!ELEMENT label (#PCDATA)><!ELEMENT item (#PCDATA|item)*>">
  %atoms;
  <!ELEMENT warehouse (bin|crate)+>
  <!ATTLIST warehouse xmlns:w CDATA #IMPLIED>
  <!ATTLIST bin code NMTOKEN #REQUIRED>
  <!ATTLIST crate code ID #REQUIRED sealed (yes|no) "no">
]>
<w:warehouse xmlns:w="urn:warehouse">
  <bin code="A-01"/>
  <crate code="c1" sealed="yes">
    <label>mixed &amp; nested</label>
    <item>one<item>two<item>three</item></item></item>
  </crate>
</w:warehouse>