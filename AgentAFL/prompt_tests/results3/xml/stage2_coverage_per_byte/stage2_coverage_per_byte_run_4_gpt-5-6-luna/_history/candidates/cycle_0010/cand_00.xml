<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!DOCTYPE catalog [
  <!ELEMENT catalog (p:item*, note?)>
  <!ELEMENT p:item (#PCDATA|p:tag)*>
  <!ELEMENT p:tag EMPTY>
  <!ELEMENT note (#PCDATA)>
  <!ATTLIST catalog xmlns:p CDATA #FIXED "urn:parts"
                    version NMTOKEN "v1">
  <!ATTLIST p:item id ID #REQUIRED
                  kind (new|used|refurbished) "new"
                  label CDATA "unlabeled">
  <!ATTLIST p:tag key CDATA #IMPLIED>
  <!ENTITY amp "&amp;">
  <!ENTITY fragment "<p:tag key='embedded'/>">
  <!NOTATION svg SYSTEM "image/svg+xml">
  <!ENTITY icon SYSTEM "icon.svg" NDATA svg>
]>
<catalog version="v2" xmlns:p="urn:parts">
  <p:item id="part-a" kind="used">A &amp; B &fragment;</p:item>
  <p:item id="part-b" label="quoted &amp; escaped">
    <p:tag key="x"/>
    <![CDATA[raw ]]> text
  </p:item>
  <note xml:space="preserve">line one
line two</note>
</catalog>