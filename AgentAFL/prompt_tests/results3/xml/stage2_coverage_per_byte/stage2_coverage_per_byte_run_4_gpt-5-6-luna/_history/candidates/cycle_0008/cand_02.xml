<?xml version="1.1" encoding="UTF-8"?>
<!DOCTYPE graph [
  <!ELEMENT graph (node*, edge*)>
  <!ELEMENT node (label?, data*)>
  <!ELEMENT edge EMPTY>
  <!ELEMENT label (#PCDATA)>
  <!ELEMENT data (#PCDATA|value)*>
  <!ELEMENT value (#PCDATA)>
  <!ATTLIST node id ID #REQUIRED role NMTOKENS #IMPLIED>
  <!ATTLIST edge from IDREF #REQUIRED to IDREFS #REQUIRED weight CDATA "1">
  <!ATTLIST data key CDATA #REQUIRED>
  <!NOTATION bin SYSTEM "application/octet-stream">
  <!ENTITY payload SYSTEM "missing.bin" NDATA bin>
]>
<graph>
  <node id="n0" role="root primary">
    <label>Réseau</label>
    <data key="empty"/>
    <data key="mixed">a<value>42</value>b<value><![CDATA[c]]></value>d</data>
  </node>
  <node id="n1"/>
  <edge from="n0" to="n1 n0" weight="0x10"/>
</graph>