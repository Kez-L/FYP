<?xml version="1.0"?>
<!DOCTYPE report [
  <!ELEMENT report (intro, table, appendix?)>
  <!ELEMENT intro (#PCDATA|br|strong)*>
  <!ELEMENT br EMPTY>
  <!ELEMENT strong (#PCDATA)>
  <!ELEMENT table (row+)>
  <!ELEMENT row (cell+)>
  <!ELEMENT cell (#PCDATA|strong|br)*>
  <!ELEMENT appendix (#PCDATA)>
  <!ATTLIST report xmlns CDATA #IMPLIED generated CDATA "yes">
  <!ATTLIST row number NMTOKEN #REQUIRED>
  <!ATTLIST cell colspan NMTOKEN "1" rowspan NMTOKEN "1">
]>
<report xmlns="urn:report" generated="no">
  <intro>Summary<strong>:</strong><br/>multiple lines</intro>
  <table>
    <row number="01">
      <cell colspan="2">left</cell>
      <cell>right<br/>side</cell>
    </row>
    <row number="02">
      <cell rowspan="2"><![CDATA[<not-markup>]]></cell>
      <cell>final</cell>
    </row>
  </table>
  <appendix xml:space="preserve">  trailing   spaces  </appendix>
</report>