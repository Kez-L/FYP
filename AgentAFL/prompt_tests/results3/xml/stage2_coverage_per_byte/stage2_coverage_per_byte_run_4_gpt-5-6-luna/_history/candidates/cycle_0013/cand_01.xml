<?xml version="1.1" encoding="UTF-8"?>
<!DOCTYPE packet [
  <!ELEMENT packet (header, payload, trailer)>
  <!ELEMENT header EMPTY>
  <!ELEMENT payload (#PCDATA|section|br)*>
  <!ELEMENT section (#PCDATA|section)*>
  <!ELEMENT br EMPTY>
  <!ELEMENT trailer (#PCDATA)>
  <!ATTLIST header version NMTOKEN #FIXED "1.1">
  <!ATTLIST section level (one|two|three) "one">
  <!ENTITY left "[">
  <!ENTITY right "]">
]>
<packet>
  <header version="1.1"/>
  <payload>&left;<section level="two">alpha<br/><section>nested</section>omega</section>&right;<![CDATA[ raw ]]></payload>
  <trailer>done&#x85;line</trailer>
</packet>