<?xml version="1.0"?>
<!DOCTYPE warehouse [
  <!ENTITY % common "<!ELEMENT crate (label?,item*,note?)>">
  %common;
  <!ELEMENT label (#PCDATA)>
  <!ELEMENT item (#PCDATA|part|quantity)*>
  <!ELEMENT part EMPTY>
  <!ELEMENT quantity (#PCDATA)>
  <!ELEMENT note (#PCDATA|item)*>
  <!ATTLIST warehouse xmlns CDATA #IMPLIED zone NMTOKEN #REQUIRED>
  <!ATTLIST crate code ID #REQUIRED sealed (yes|no) "no">
  <!ATTLIST item sku IDREF #IMPLIED>
  <!ATTLIST part name CDATA #REQUIRED>
  <!ENTITY left "<![CDATA[unparsed <payload> & symbols]]>">
  <!ENTITY amp "&amp;">
]>
<warehouse xmlns="urn:stock:2026" zone="north">
  <crate code="c-17" sealed="yes">
    <label>mixed &amp; marked text</label>
    <item sku="c-17">
      before<part name="bolt"/>after
      <quantity>4 &amp; &amp;</quantity>
    </item>
    <note><![CDATA[closing-looking text ]]]]><![CDATA[> remains data]]></note>
  </crate>
</warehouse>