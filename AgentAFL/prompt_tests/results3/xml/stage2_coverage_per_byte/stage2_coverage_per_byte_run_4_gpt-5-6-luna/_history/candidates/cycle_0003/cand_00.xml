<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE catalog [
  <!NOTATION jpg SYSTEM "image/jpeg">
  <!ENTITY logo SYSTEM "logo.jpg" NDATA jpg>
  <!ENTITY % common "<!ATTLIST item code CDATA #IMPLIED xml:space (default|preserve) 'default' image ENTITY #IMPLIED>">
  %common;
  <!ELEMENT catalog (item*, note?)>
  <!ELEMENT item (#PCDATA|ref)*>
  <!ELEMENT ref EMPTY>
  <!ELEMENT note (#PCDATA)>
  <!ATTLIST catalog mode (compact|full) "full">
]>
<catalog mode="compact">
  <item code="A&amp;B" image="logo">alpha<ref/>omega</item>
  <item xml:space="preserve">  padded <![CDATA[content]]> </item>
  <note>summary &#x20AC;</note>
</catalog>