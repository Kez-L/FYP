<!DOCTYPE inventory [
  <!ELEMENT inventory (warehouse+)>
  <!ELEMENT warehouse (bin*)>
  <!ATTLIST warehouse code ID #REQUIRED>
  <!ELEMENT bin (product, quantity)>
  <!ATTLIST bin location (left|right|center) "center">
  <!ELEMENT product (#PCDATA)>
  <!ELEMENT quantity (#PCDATA)>
]>
<inventory>
  <warehouse code="w1">
    <bin location="left"><product>nuts</product><quantity>0</quantity></bin>
    <bin><product>bolts</product><quantity>999999999999999999999</quantity></bin>
  </warehouse>
  <warehouse code="w2"/>
</inventory>