<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE form [
  <!ELEMENT form (field|group|submit)*>
  <!ELEMENT field EMPTY>
  <!ELEMENT group (field|hint|group)*>
  <!ELEMENT hint (#PCDATA)>
  <!ELEMENT submit EMPTY>
  <!ATTLIST form name CDATA #IMPLIED>
  <!ATTLIST field name CDATA #REQUIRED type (text|number|date) "text" value CDATA #IMPLIED>
  <!ATTLIST group id ID #IMPLIED collapsed (yes|no) "no">
  <!ATTLIST submit action CDATA #REQUIRED>
  <!ENTITY amp "&#38;">
  <!ENTITY quote "&#34;">
]>
<form name="survey">
  <group id="personal" collapsed="no">
    <field name="first" value="Ada &amp; Grace"/>
    <field name="age" type="number" value="&amp;"/>
    <hint><![CDATA[Use “ordinary” text and ]]> brackets</hint>
    <group id="nested">
      <field name="date" type="date" value="2026-10-01"/>
    </group>
  </group>
  <field name="comment" value="&quote;hello&quote; &amp; goodbye"/>
  <submit action="/send?x=1&amp;y=2"/>
</form>