<?xml version="1.0"?>
<!DOCTYPE maze [
  <!ENTITY % nodes "<!ELEMENT maze (corridor|room)+><!ELEMENT corridor (#PCDATA|door)*><!ELEMENT room (door?, treasure*)><!ELEMENT door EMPTY><!ELEMENT treasure (#PCDATA)>">
  %nodes;
  <!ENTITY % attrs "<!ATTLIST maze entrance IDREF #IMPLIED><!ATTLIST door to IDREF #REQUIRED locked (yes|no) 'no'>">
  %attrs;
  <![IGNORE[
    <!ELEMENT erased EMPTY>
    <!ATTLIST erased ghost CDATA #IMPLIED>
  ]]>
]>
<maze entrance="r1">
  <corridor>north <door to="r1" locked="yes"/> east</corridor>
  <room id="r1">
    <door to="r2"/>
    <treasure>glass &amp; stone</treasure>
  </room>
</maze>