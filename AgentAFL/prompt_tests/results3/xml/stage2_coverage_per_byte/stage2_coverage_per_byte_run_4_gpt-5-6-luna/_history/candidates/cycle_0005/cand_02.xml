<?xml version="1.0" standalone="yes"?>
<!DOCTYPE envelope [
  <!ELEMENT envelope (meta?, body)>
  <!ELEMENT meta (property*)>
  <!ELEMENT property EMPTY>
  <!ELEMENT body (message|attachment)+>
  <!ELEMENT message (#PCDATA)>
  <!ELEMENT attachment EMPTY>
  <!ATTLIST property key CDATA #REQUIRED value CDATA #IMPLIED>
  <!ATTLIST attachment name CDATA #REQUIRED type CDATA "application/octet-stream">
  <!ENTITY nbsp "&#160;">
]>
<envelope xmlns:x="urn:meta" xmlns:y="urn:data">
  <meta>
    <property key="x:priority" value="high"/>
    <property key="y:empty"/>
  </meta>
  <body>
    <message>hello&nbsp;world</message>
    <attachment name="a&amp;b.bin"/>
    <message><![CDATA[<not-an-element/>]]></message>
    <attachment name="last" type="text/plain"/>
  </body>
</envelope>