<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE matrix [
  <!ELEMENT matrix (row+)>
  <!ELEMENT row (cell+)>
  <!ELEMENT cell (#PCDATA|mark)*>
  <!ELEMENT mark (#PCDATA)>
  <!ATTLIST matrix rows NMTOKEN #REQUIRED>
  <!ATTLIST row index CDATA #REQUIRED>
  <!ATTLIST cell x CDATA #IMPLIED y CDATA #IMPLIED>
  <!ENTITY quotemark "&quot;">
]>
<matrix rows="3">
  <row index="001">
    <cell x="0" y="0">zero</cell>
    <cell x="1" y="0"><mark>A</mark> &quot;quoted&quot;</cell>
  </row>
  <row index="002">
    <cell x="0" y="1"><![CDATA[a < b]]></cell>
    <cell x="1" y="1">amp &amp; &quotemark;</cell>
    <cell x="2" y="1">line
break</cell>
  </row>
  <row index="003">
    <cell x="0" y="2">last</cell>
  </row>
</matrix>