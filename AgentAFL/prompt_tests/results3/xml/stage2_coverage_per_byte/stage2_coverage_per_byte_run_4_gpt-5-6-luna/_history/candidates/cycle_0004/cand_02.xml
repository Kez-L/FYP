<?xml version="1.1" standalone="no"?>
<!DOCTYPE package [
  <!ELEMENT package (meta, payload)>
  <!ELEMENT meta (name, checksum)>
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT checksum (#PCDATA)>
  <!ELEMENT payload (chunk+)>
  <!ELEMENT chunk (#PCDATA)>
  <!ATTLIST chunk index NMTOKEN #REQUIRED encoding (base64|hex|raw) "raw">
  <!ENTITY nl "&#x85;">
  <!ENTITY % optional "INCLUDE">
  <![%optional;[
    <!ATTLIST package xml:lang CDATA #IMPLIED>
  ]]>
]>
<package xml:lang="en">
  <meta>
    <name>sample&#xA;package</name>
    <checksum>deadbeef</checksum>
  </meta>
  <payload>
    <chunk index="0" encoding="hex">00ff&#x85;&nl;</chunk>
    <chunk index="1">tail</chunk>
  </payload>
</package>