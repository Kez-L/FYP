<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE catalog [
  <!ENTITY % common "CDATA">
  <!ELEMENT catalog (item+, note?)>
  <!ELEMENT item (name, price, details*)>
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT price (#PCDATA)>
  <!ELEMENT details (#PCDATA|em|code)*>
  <!ELEMENT em (#PCDATA)>
  <!ELEMENT code (#PCDATA)>
  <!ELEMENT note (#PCDATA)>
  <!ATTLIST catalog xmlns CDATA #IMPLIED version NMTOKEN #REQUIRED>
  <!ATTLIST item id ID #REQUIRED status (new|used|archived) "new">
  <!ATTLIST price currency (%common;) "USD">
  <!ENTITY euro "&#x20AC;">
  <!ENTITY decorated "<em>special</em> &amp; <code>sale</code>">
]>
<catalog xmlns="urn:inventory:test" version="1.0">
  <item id="i001" status="used">
    <name>Widget &lt;A&gt;</name>
    <price currency="EUR">19.95 &euro;</price>
    <details>old <em>but</em> <code>reliable</code></details>
  </item>
  <item id="i002">
    <name>Bundle</name>
    <price>&decorated;</price>
    <details><![CDATA[raw ]]> text <!-- embedded --> tail</details>
  </item>
  <note>End<?catalog instruction?>.</note>
</catalog>