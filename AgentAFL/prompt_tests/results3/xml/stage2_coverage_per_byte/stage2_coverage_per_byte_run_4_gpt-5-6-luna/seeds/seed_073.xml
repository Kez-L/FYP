<!DOCTYPE matrix [
  <!ELEMENT matrix (row*)>
  <!ELEMENT row (cell*)>
  <!ELEMENT cell (#PCDATA)>
  <!ATTLIST matrix xmlns:m URI #IMPLIED>
  <!ATTLIST row index NMTOKEN #REQUIRED>
  <!ATTLIST cell colspan NMTOKEN "1" rowspan NMTOKEN "1">
]>
<m:matrix xmlns:m="urn:grid" xmlns="urn:cells">
  <row index="00">
    <cell colspan="0">A&amp;B</cell>
    <cell rowspan="999">C</cell>
  </row>
  <row index="01"/>
  <row index="02"><cell><![CDATA[x<y]]></cell><cell>z</cell></row>
</m:matrix>