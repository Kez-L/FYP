<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE catalog [
  <!ELEMENT catalog (section+)>
  <!ELEMENT section (title, entry*)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT entry (name, price?, note?)>
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT price (#PCDATA)>
  <!ELEMENT note (#PCDATA|emph|link)*>
  <!ELEMENT emph (#PCDATA)>
  <!ELEMENT link EMPTY>
  <!ATTLIST catalog version NMTOKEN #REQUIRED>
  <!ATTLIST section id ID #IMPLIED xml:lang NMTOKEN "en">
  <!ATTLIST entry code ID #IMPLIED status (new|used|archived) "new">
  <!ATTLIST link href URI #REQUIRED>
  <!ENTITY currency "€">
]>
<catalog version="2.0">
  <section id="s-é" xml:lang="fr">
    <title>Produits &amp; services</title>
    <entry code="p1" status="used">
      <name>Café</name>
      <price>12 &currency;</price>
      <note>Très <emph>bon</emph> — voir <link href="urn:x:y"/>.</note>
    </entry>
    <entry code="p2">
      <name>Crème &lt;forte&gt;</name>
      <note><![CDATA[une valeur ]]> avec séparation</note>
    </entry>
  </section>
</catalog>