<?xml version="1.0"?>
<!DOCTYPE graph [
  <!ELEMENT graph (node+, edge*)>
  <!ELEMENT node EMPTY>
  <!ELEMENT edge EMPTY>
  <!ATTLIST graph directed (yes|no) "yes">
  <!ATTLIST node id ID #REQUIRED label CDATA #IMPLIED>
  <!ATTLIST edge from IDREF #REQUIRED to IDREF #REQUIRED weight NMTOKEN #IMPLIED>
  <!ENTITY % extra '
    <!ELEMENT annotation (#PCDATA)>
    <!ATTLIST annotation for IDREF #REQUIRED>
  '>
  %extra;
  <!ENTITY left "L&amp;R">
  <!NOTATION plain SYSTEM "text/plain">
  <!ATTLIST graph format NOTATION (plain) "plain">
]>
<graph directed="no" format="plain">
  <node id="n1" label="&left;"/>
  <node id="n2" label="second"/>
  <node id="n3"/>
  <edge from="n1" to="n2" weight="07"/>
  <edge from="n2" to="n3"/>
  <annotation for="n2">linked &lt;note&gt;</annotation>
</graph>