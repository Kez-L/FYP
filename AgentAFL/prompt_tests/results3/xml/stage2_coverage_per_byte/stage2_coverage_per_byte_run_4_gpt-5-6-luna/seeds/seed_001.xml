<?xml version="1.1"?>
<!DOCTYPE message [
  <!ELEMENT message (header, body, footer?)>
  <!ELEMENT header EMPTY>
  <!ATTLIST header priority NMTOKENS "low urgent">
  <!ELEMENT body (#PCDATA|em|br)*>
  <!ELEMENT em (#PCDATA)>
  <!ELEMENT br EMPTY>
  <!ELEMENT footer (#PCDATA)>
  <!ENTITY smile "&#x263A;">
]>
<message>
  <header priority="high urgent"/>
  <body>Hello <em>world</em><br/>&smile;</body>
  <footer>done</footer>
</message>