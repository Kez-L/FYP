<!DOCTYPE graph [
  <!ELEMENT graph (node+, edge*)>
  <!ELEMENT node (label?, property*)>
  <!ELEMENT label (#PCDATA)>
  <!ELEMENT property (#PCDATA)>
  <!ELEMENT edge EMPTY>
  <!ATTLIST node key ID #REQUIRED>
  <!ATTLIST edge from IDREF #REQUIRED to IDREF #REQUIRED weight CDATA "1.0">
  <!ENTITY quoted "&quot;quoted&quot;">
]>
<graph>
  <node key="n1">
    <label>root</label>
    <property type="text">A &quoted; value</property>
    <property type="numeric">&#49;&#50;&#51;</property>
  </node>
  <node key="n2">
    <label><![CDATA[second node]]></label>
  </node>
  <edge from="n1" to="n2" weight="0"/>
  <edge from="n2" to="n1" weight="2.5"/>
</graph>