<?xml version="1.0" standalone="no"?>
<!DOCTYPE graph [
  <!ELEMENT graph (node|edge)+>
  <!ELEMENT node (name?,tag*)>
  <!ELEMENT edge EMPTY>
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT tag (#PCDATA)>
  <!ATTLIST graph xml:lang NMTOKEN #IMPLIED>
  <!ATTLIST node id ID #REQUIRED kind CDATA #IMPLIED>
  <!ATTLIST edge from IDREF #REQUIRED to IDREF #REQUIRED weight CDATA "1.0">
  <!ATTLIST tag xml:space (default|preserve) "preserve">
  <!ENTITY nbsp "&#160;">
]>
<graph xml:lang="en-US">
  <node id="n1" kind="entry">
    <name>Root&nbsp;Node</name>
    <tag xml:space="preserve">  padded  </tag>
  </node>
  <edge from="n1" to="n2" weight="0"/>
  <node id="n2">
    <name>Second &lt;Node&gt;</name>
    <tag><![CDATA[a]]>&#x20;<![CDATA[b]]></tag>
  </node>
  <edge from="n2" to="n1" weight="+INF"/>
</graph>