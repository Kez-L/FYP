<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE catalog [
  <!ELEMENT catalog (book*)>
  <!ELEMENT book (name, author+, note?)>
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT author (#PCDATA)>
  <!ELEMENT note (#PCDATA|em|br)*>
  <!ELEMENT em (#PCDATA)>
  <!ELEMENT br EMPTY>
  <!ATTLIST catalog xml:lang NMTOKEN #IMPLIED>
  <!ATTLIST book isbn ID #REQUIRED ref IDREFS #IMPLIED>
  <!ATTLIST author role CDATA "writer">
  <!ENTITY nbsp "&#160;">
  <!ENTITY accent "&#x1F642;">
]>
<catalog xml:lang="fr">
  <book isbn="b-001" ref="b-001">
    <name>Éléments &nbsp; XML &accent;</name>
    <author role="writer">A</author>
    <author role="editor">B</author>
    <note>line one<br/>line <em>two</em> &lt; three</note>
  </book>
  <book isbn="b-002">
    <name><![CDATA[Names, commas, and ]]> brackets</name>
    <author>anonymous</author>
  </book>
</catalog>