<?xml version="1.0"?>
<!DOCTYPE report [
  <!ELEMENT report (header, section+, footer?)>
  <!ELEMENT header (processing, comment?)>
  <!ELEMENT processing (#PCDATA)>
  <!ELEMENT comment (#PCDATA)>
  <!ELEMENT section (heading, paragraph+, table?)>
  <!ELEMENT heading (#PCDATA)>
  <!ELEMENT paragraph (#PCDATA|br|code|quote)*>
  <!ELEMENT br EMPTY>
  <!ELEMENT code (#PCDATA)>
  <!ELEMENT quote (#PCDATA|paragraph)*>
  <!ELEMENT table (row+)>
  <!ELEMENT row (cell+)>
  <!ELEMENT cell (#PCDATA)>
  <!ELEMENT footer (#PCDATA)>
  <!ATTLIST report generated CDATA #IMPLIED>
  <!ATTLIST section number NMTOKEN #REQUIRED>
  <!ATTLIST cell colspan NMTOKEN "1">
  <!ENTITY lt "<">
  <!ENTITY gt ">">
  <!ENTITY nbsp "&#160;">
]>
<report generated="yes &amp; no">
  <header>
    <processing>stage <![CDATA[one]]></processing>
    <!-- comment with -- malformed? -->
  </header>
  <section number="01">
    <heading>Limits &lt; bounds</heading>
    <paragraph>Text<br/>after <code>a&amp;b</code><quote>nested <paragraph>quote</paragraph></quote>.</paragraph>
    <table>
      <row><cell colspan="2">A</cell><cell>B</cell></row>
      <row><cell>&nbsp;</cell><cell>&lt;raw&gt;</cell></row>
    </table>
  </section>
  <footer>End <?pi value?></footer>
</report>