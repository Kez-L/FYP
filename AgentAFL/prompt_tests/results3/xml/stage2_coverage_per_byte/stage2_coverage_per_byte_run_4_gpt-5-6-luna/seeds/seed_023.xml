<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE graph [
  <!ELEMENT graph (node*)>
  <!ELEMENT node (label?, edge*)>
  <!ELEMENT label (#PCDATA)>
  <!ELEMENT edge EMPTY>
  <!ATTLIST node id ID #REQUIRED kind (root|leaf|branch) "leaf">
  <!ATTLIST edge to IDREF #REQUIRED weight NMTOKEN #IMPLIED>
  <!NOTATION bin SYSTEM "application/octet-stream">
  <!ENTITY blob SYSTEM "payload.bin" NDATA bin>
]>
<graph>
  <node id="n0" kind="root">
    <label>start</label>
    <edge to="n1" weight="01"/>
    <edge to="n2"/>
  </node>
  <node id="n1">
    <label>été &amp; tea</label>
  </node>
  <node id="n2" kind="branch">
    <edge to="n1" weight="&#x2B;3"/>
  </node>
</graph>