<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE catalog [
  <!ENTITY nbsp "&#160;">
  <!ENTITY greeting "hello &amp; welcome">
  <!ELEMENT catalog (section+)>
  <!ELEMENT section (heading, item*)>
  <!ELEMENT heading (#PCDATA)>
  <!ELEMENT item (#PCDATA|em|link|br)*>
  <!ELEMENT em (#PCDATA)>
  <!ELEMENT link (#PCDATA)>
  <!ELEMENT br EMPTY>
  <!ATTLIST catalog xmlns CDATA #FIXED "urn:catalog">
  <!ATTLIST section id ID #REQUIRED xml:lang CDATA "en">
  <!ATTLIST item priority (low|normal|high) "normal">
  <!ATTLIST link href URI #REQUIRED>
]>
<catalog xmlns="urn:catalog">
  <section id="s1" xml:lang="fr">
    <heading>Résumé</heading>
    <item priority="high">caf&eacute; &greeting; <em>now</em><br/><link href="urn:x">details</link></item>
  </section>
</catalog>