<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE envelope [
  <!ENTITY hello "world">
  <!ENTITY nested "&hello;, again">
  <!ELEMENT envelope (header, payload)>
  <!ELEMENT header (#PCDATA)>
  <!ELEMENT payload (entry+)>
  <!ELEMENT entry (#PCDATA)>
  <!ATTLIST entry key ID #REQUIRED>
]>
<envelope>
  <header>&nested;</header>
  <payload>
    <entry key="e1">first &amp; second</entry>
    <entry key="e2">value &#x1F600;</entry>
  </payload>
</envelope>