<?xml version="1.1" encoding="UTF-8" standalone="yes"?>
<!DOCTYPE archive [
  <!ELEMENT archive (entry|separator)*>
  <!ELEMENT entry (title, body)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT body (#PCDATA|linebreak)*>
  <!ELEMENT linebreak EMPTY>
  <!ELEMENT separator EMPTY>
  <!ATTLIST entry xml:id ID #REQUIRED priority (low|normal|high) "normal">
]>
<archive>
  <?audit action="import"?>
  <!-- records with XML 1.1 line separators -->
  <entry xml:id="e-01" priority="high">
    <title>Résumé&#x85;2026</title>
    <body>first<linebreak/>second&#x2028;third<![CDATA[]]></body>
  </entry>
  <separator/>
  <entry xml:id="e-02">
    <title>Empty body</title>
    <body/>
  </entry>
</archive>