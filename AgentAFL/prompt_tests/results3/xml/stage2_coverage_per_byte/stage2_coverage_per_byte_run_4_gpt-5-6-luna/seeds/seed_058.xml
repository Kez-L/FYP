<?xml version="1.0"?>
<!DOCTYPE matrix [
  <!ELEMENT matrix (row+)>
  <!ELEMENT row (cell+)>
  <!ELEMENT cell (#PCDATA|cell)*>
  <!ATTLIST matrix xmlns:m CDATA #IMPLIED count NMTOKEN #REQUIRED>
  <!ATTLIST row number NMTOKEN #REQUIRED>
  <!ATTLIST cell kind (text|formula|empty) "text">
  <!ENTITY left "[" >
  <!ENTITY right "]" >
  <!ENTITY nested "&left;inner&right;">
]>
<matrix xmlns:m="urn:matrix" count="2">
  <row number="1">
    <cell kind="text">alpha &amp; beta</cell>
    <cell kind="formula">x &lt; y ? y : x</cell>
  </row>
  <row number="2">
    <cell kind="empty"/>
    <cell kind="text">before<cell kind="formula">&nested;</cell>after</cell>
  </row>
</matrix>