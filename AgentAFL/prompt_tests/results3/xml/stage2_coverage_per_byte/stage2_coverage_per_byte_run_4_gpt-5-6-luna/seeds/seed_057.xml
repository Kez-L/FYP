<?xml version="1.0"?>
<!DOCTYPE gallery [
  <!NOTATION png SYSTEM "image/png">
  <!NOTATION jpg PUBLIC "-//EXAMPLE//JPEG" "image/jpeg">
  <!ENTITY logo SYSTEM "logo.png" NDATA png>
  <!ENTITY photo SYSTEM "photo.jpg" NDATA jpg>
  <!ELEMENT gallery (caption?, image*)>
  <!ELEMENT caption (#PCDATA)>
  <!ELEMENT image EMPTY>
  <!ATTLIST gallery mode (compact|full) "full">
  <!ATTLIST image src ENTITY #REQUIRED
                 alt CDATA #IMPLIED
                 sizes NMTOKENS #IMPLIED
                 index NMTOKEN #IMPLIED>
]>
<gallery mode="compact">
  <caption>Binary references &amp; metadata</caption>
  <image src="logo" alt="logo" sizes="small medium" index="01"/>
  <image src="photo" alt="sample &lt;image&gt;" sizes="large"/>
</gallery>