<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE catalog [
  <!ELEMENT catalog (header, item+, footer?)>
  <!ELEMENT header (#PCDATA)>
  <!ELEMENT item (name, price, details?, tag*)>
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT price (#PCDATA)>
  <!ELEMENT details (#PCDATA|em|br)*>
  <!ELEMENT em (#PCDATA)>
  <!ELEMENT br EMPTY>
  <!ELEMENT tag (#PCDATA)>
  <!ELEMENT footer (#PCDATA)>
  <!ATTLIST catalog xml:lang (en|fr|de) "en" version CDATA #REQUIRED>
  <!ATTLIST item code ID #REQUIRED status (new|used|archived) "new">
  <!ATTLIST price currency CDATA #IMPLIED>
  <!ENTITY company "Example &amp; Sons">
]>
<catalog version="2" xml:lang="en">
  <header>Offers from &company;</header>
  <item code="p17" status="new">
    <name>Glass &lt;vessel&gt;</name>
    <price currency="EUR">19.95</price>
    <details>Clear <em>borosilicate</em><br/>hand-finished</details>
    <tag>kitchen</tag>
    <tag>fragile</tag>
  </item>
  <item code="p18">
    <name>Folded map</name>
    <price>4.00</price>
    <details><![CDATA[creased, annotated, and marked "north"]]></details>
  </item>
  <footer>End of list</footer>
</catalog>