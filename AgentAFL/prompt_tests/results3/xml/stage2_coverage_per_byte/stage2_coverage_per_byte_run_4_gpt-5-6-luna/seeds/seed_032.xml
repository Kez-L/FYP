<?xml version="1.0"?>
<!DOCTYPE switchboard [
  <!ENTITY % mode "IGNORE">
  <![%mode;[
    <!ELEMENT hidden EMPTY>
    <!ATTLIST hidden secret CDATA "yes">
  ]]>
  <!ELEMENT switchboard (port|message|fault)*>
  <!ELEMENT port EMPTY>
  <!ELEMENT message (#PCDATA)>
  <!ELEMENT fault (code, detail?)>
  <!ELEMENT code (#PCDATA)>
  <!ELEMENT detail (#PCDATA|line)*>
  <!ELEMENT line EMPTY>
  <!ATTLIST switchboard xmlns:net CDATA #FIXED "urn:network">
  <!ATTLIST port net:name NMTOKEN #REQUIRED net:enabled (yes|no) "yes">
  <!ATTLIST message level (info|warn|error) "info">
]>
<switchboard xmlns:net="urn:network">
  <port net:name="p0" net:enabled="no"/>
  <message level="warn">packet &amp; signal</message>
  <fault>
    <code>504</code>
    <detail>timeout<line/>retry</detail>
  </fault>
  <?route destination?>
</switchboard>