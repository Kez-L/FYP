<!DOCTYPE graph [
  <!ELEMENT graph (node*)>
  <!ELEMENT node (label?, edge*)>
  <!ELEMENT label (#PCDATA)>
  <!ELEMENT edge EMPTY>
  <!ATTLIST graph xmlns:g CDATA #FIXED "urn:graph">
  <!ATTLIST node id ID #REQUIRED rank NMTOKEN #IMPLIED>
  <!ATTLIST edge to IDREF #REQUIRED weight CDATA "1">
  <!ENTITY % optional "<!ELEMENT annotation (#PCDATA)>">
  %optional;
  <!ENTITY nbsp "&#160;">
]>
<graph xmlns:g="urn:graph" xmlns:a="urn:annotation">
  <node id="n0" rank="root">
    <label>start&nbsp;&amp;nbsp;</label>
    <edge to="n1" weight="0"/>
    <edge to="n2" weight="1.5"/>
  </node>
  <node id="n1">
    <label>middle</label>
    <annotation xmlns="">detached</annotation>
  </node>
  <node id="n2" rank="leaf">
    <g:edge to="n0" weight="&quot;"/>
  </node>
</graph>