<?xml version="1.1"?>
<!DOCTYPE packet [
  <!ELEMENT packet (header, body, trailer?)>
  <!ELEMENT header (field*)>
  <!ELEMENT field EMPTY>
  <!ELEMENT body (#PCDATA|chunk)*>
  <!ELEMENT chunk (#PCDATA)>
  <!ELEMENT trailer (#PCDATA)>
  <!ATTLIST packet xml:space (default|preserve) "default"
                  xml:lang NMTOKEN #IMPLIED>
  <!ATTLIST field name NMTOKEN #REQUIRED value CDATA #IMPLIED>
  <!ENTITY mark "&#x85;">
]>
<packet xml:space="preserve" xml:lang="fr">
  <header>
    <field name="mode" value="raw"/>
    <field name="flags" value="A&amp;B"/>
  </header>
  <body>prefix&#x1F;&mark;<chunk><![CDATA[]]></chunk>suffix</body>
  <trailer xml:space="default">&#x2028;end</trailer>
</packet>