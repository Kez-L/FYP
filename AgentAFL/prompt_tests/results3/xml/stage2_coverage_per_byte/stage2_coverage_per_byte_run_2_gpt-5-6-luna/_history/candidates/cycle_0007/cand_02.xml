<?xml version="1.0" encoding="UTF-16"?>
<!DOCTYPE map [
  <!ELEMENT map (pair*)>
  <!ELEMENT pair (key, value)>
  <!ELEMENT key (#PCDATA)>
  <!ELEMENT value (#PCDATA|pair)*>
  <!ATTLIST pair keyref IDREF #IMPLIED>
  <!ENTITY nested "x &amp; y">
]>
<map>
  <pair keyref="missing">
    <key>root</key>
    <value>
      <pair><key>inner</key><value>&nested;</value></pair>
      <pair><key><![CDATA[split]]></key><value>text</value></pair>
    </value>
  </pair>
</map>