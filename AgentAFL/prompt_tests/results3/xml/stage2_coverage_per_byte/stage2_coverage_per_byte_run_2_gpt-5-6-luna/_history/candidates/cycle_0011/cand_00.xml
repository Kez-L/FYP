<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!DOCTYPE package [
  <!ELEMENT package (header, item+, footer?)>
  <!ELEMENT header (#PCDATA|meta|flag)*>
  <!ELEMENT meta EMPTY>
  <!ELEMENT flag EMPTY>
  <!ELEMENT item (name, description, link*, checksum)>
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT description (#PCDATA|b|i|br)*>
  <!ELEMENT b (#PCDATA|i)*>
  <!ELEMENT i (#PCDATA)>
  <!ELEMENT br EMPTY>
  <!ELEMENT link EMPTY>
  <!ELEMENT checksum (#PCDATA)>
  <!ELEMENT footer (#PCDATA)>
  <!ATTLIST package xmlns CDATA #IMPLIED xml:lang CDATA #IMPLIED version NMTOKEN #REQUIRED>
  <!ATTLIST item id ID #REQUIRED state (new|ready|archived) "new" related IDREFS #IMPLIED>
  <!ATTLIST link rel (self|parent|alternate) "self" href CDATA #REQUIRED>
  <!ATTLIST meta key NMTOKEN #REQUIRED value CDATA #IMPLIED>
  <!ENTITY copyright "&#xA9; 2026">
]>
<package xmlns="urn:pkg:one" xml:lang="en" version="v2">
  <header><meta key="mode" value="&quot;test&quot;"/><flag/><?stage ready?></header>
  <item id="i1" state="ready">
    <name>Alpha</name>
    <description>Text <b>bold <i>nested</i></b><br/>tail &copyright;</description>
    <link rel="self" href="urn:item:i1"/>
    <checksum>7&amp;9</checksum>
  </item>
  <item id="i2" state="archived" related="i1">
    <name>Beta</name>
    <description><![CDATA[raw ]]> content &lt;end&gt;</description>
    <link rel="parent" href="urn:item:i1"/>
    <checksum>none</checksum>
  </item>
  <!-- footer intentionally omitted -->
</package>