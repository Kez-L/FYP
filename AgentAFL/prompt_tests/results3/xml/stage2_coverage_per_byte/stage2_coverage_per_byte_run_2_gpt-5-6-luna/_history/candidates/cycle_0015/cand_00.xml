<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE catalog [
  <!ELEMENT catalog (entry+, metadata?)>
  <!ELEMENT entry (title, description?, tag*)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT description (#PCDATA|em|strong|br)*>
  <!ELEMENT em (#PCDATA)>
  <!ELEMENT strong (#PCDATA)>
  <!ELEMENT br EMPTY>
  <!ELEMENT tag EMPTY>
  <!ELEMENT metadata EMPTY>
  <!ATTLIST catalog xml:base URI #IMPLIED xml:lang CDATA "en">
  <!ATTLIST entry id ID #REQUIRED ref IDREF #IMPLIED status (new|old|archived) "new">
  <!ATTLIST tag name CDATA #REQUIRED>
  <!ATTLIST metadata generated CDATA #IMPLIED>
]>
<catalog xml:base="urn:example:catalog" xml:lang="fr">
  <entry id="e1" status="old">
    <title>Résumé &amp; notes</title>
    <description>Text with <em>emphasis</em>, <strong>weight</strong><br/>and a reference.</description>
    <tag name="alpha"/>
  </entry>
  <entry id="e2" ref="e1">
    <title><![CDATA[Brackets ]]> and entities</title>
    <description xml:space="preserve">  padded
      <em>mixed</em>
    </description>
    <tag name="beta"/>
    <tag name="gamma"/>
  </entry>
  <metadata generated="2026-09-24"/>
</catalog>