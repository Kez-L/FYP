<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE matrix [
  <!ELEMENT matrix (row+)>
  <!ELEMENT row (cell*)>
  <!ELEMENT cell (#PCDATA)>
  <!ATTLIST row index NMTOKEN #REQUIRED>
  <!ATTLIST cell
    colspan NMTOKEN "1"
    rowspan NMTOKEN "1">
]>
<matrix xmlns:x="urn:matrix">
  <row index="0">
    <cell colspan="2">A</cell>
    <cell rowspan="3">B</cell>
  </row>
  <row index="1">
    <cell>1 &lt; 2</cell>
    <cell><![CDATA[unclosed-looking ]]> text</cell>
  </row>
  <row index="2">
    <cell colspan="0">C</cell>
    <cell>tail</cell>
  </row>
</matrix>