<?xml version="1.0"?>
<!DOCTYPE form [
  <!ELEMENT form (field+, submit)>
  <!ELEMENT field EMPTY>
  <!ELEMENT submit (#PCDATA)>
  <!ATTLIST form id ID #REQUIRED mode (compact|expanded) "compact">
  <!ATTLIST field name CDATA #REQUIRED
                  type (text|number|date) "text"
                  value CDATA #IMPLIED
                  disabled (yes|no) "no">
  <!ATTLIST submit action CDATA #REQUIRED>
  <!ENTITY nbsp "&#160;">
  <!ENTITY quote "&quot;">
]>
<form id="login" mode="expanded">
  <field name="user" type="text" value="a&amp;b" disabled="no"/>
  <field name="count" type="number" value="007"/>
  <field name="when" type="date" value="2026-09-24"/>
  <submit action="/submit?next=%2Fhome">Send&nbsp;&quote;</submit>
</form>