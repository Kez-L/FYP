<?xml version="1.0"?>
<!DOCTYPE catalog [
  <!ENTITY % common "xml:lang CDATA #IMPLIED xml:space (default|preserve) 'default'">
  <!ELEMENT catalog (section+, index?)>
  <!ELEMENT section (title, entry*)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT entry (name, value, note?)>
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT value (#PCDATA|emph|code)*>
  <!ELEMENT note (#PCDATA)>
  <!ELEMENT emph (#PCDATA)>
  <!ELEMENT code (#PCDATA)>
