  <!ATTLIST catalog %common; generated CDATA 'yes'>
  <!ATTLIST section id ID #REQUIRED kind (alpha|beta|other) 'other'>
  <!ATTLIST entry ref IDREF #IMPLIED>
  <!ENTITY mark "&#x2063;">
]>
