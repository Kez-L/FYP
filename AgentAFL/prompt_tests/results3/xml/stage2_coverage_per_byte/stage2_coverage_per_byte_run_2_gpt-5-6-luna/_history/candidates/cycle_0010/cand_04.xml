<?xml version="1.0"?>
<!DOCTYPE scene [
  <!ELEMENT scene (layer+)>
  <!ELEMENT layer (node|group|text)*>
  <!ELEMENT group (node|group|text)*>
  <!ELEMENT node EMPTY>
  <!ELEMENT text (#PCDATA)>
  <!ATTLIST scene xmlns CDATA #IMPLIED>
  <!ATTLIST layer name CDATA #REQUIRED order NMTOKENS #IMPLIED>
  <!ATTLIST group gid ID #REQUIRED transform CDATA #IMPLIED>
  <!ATTLIST node nid ID #REQUIRED class NMTOKENS #IMPLIED visible (true|false) "true">
  <!ATTLIST text lang CDATA #IMPLIED>
  <!ENTITY nbsp "&#xA0;">
]>
<scene xmlns="urn:graphics" xmlns:xlink="http://www.w3.org/1999/xlink">
  <layer name="background" order="base fill">
    <node nid="n0" class="rect solid" visible="false"/>
    <group gid="g1" transform="translate(10,20) rotate(45)">
      <node nid="n1" class="circle highlighted"/>
      <text lang="en">A &lt; B &amp;&nbsp;C</text>
    </group>
  </layer>
  <layer name="foreground">
    <group gid="g2">
      <group gid="g3"><node nid="n2"/></group>
      <text><![CDATA[raw ]]><x:emphasis xmlns:x="urn:extra">layer</x:emphasis><![CDATA[ text]]></text>
    </group>
  </layer>
</scene>