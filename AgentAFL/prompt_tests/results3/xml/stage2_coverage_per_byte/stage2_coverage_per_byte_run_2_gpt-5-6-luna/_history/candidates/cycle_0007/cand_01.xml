<!DOCTYPE message [
  <!ELEMENT message (sender, recipient, body, attachment*)>
  <!ELEMENT sender EMPTY>
  <!ELEMENT recipient EMPTY>
  <!ELEMENT body (#PCDATA|br)*>
  <!ELEMENT br EMPTY>
  <!ELEMENT attachment (#PCDATA)>
  <!ATTLIST sender address CDATA #REQUIRED>
  <!ATTLIST recipient address CDATA #REQUIRED>
  <!ATTLIST attachment type CDATA #IMPLIED>
  <!ENTITY linebreak "<br/>">
]>
<message priority="high">
  <sender address="alpha@example.test"/>
  <recipient address="beta@example.test"/>
  <body>Before &linebreak; after &amp; then <![CDATA[<literal/>]]></body>
  <attachment type="text">a&#x0D;b&#x0A;c</attachment>
</message>