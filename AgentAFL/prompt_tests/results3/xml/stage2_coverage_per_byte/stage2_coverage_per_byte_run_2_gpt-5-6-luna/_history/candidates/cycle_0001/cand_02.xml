<!DOCTYPE report [
  <!ENTITY % common "<!ELEMENT report (meta,body)">
  %common;
  <!ELEMENT meta EMPTY>
  <!ELEMENT body (line|break)*>
  <!ELEMENT line (#PCDATA)>
  <!ELEMENT break EMPTY>
  <!ATTLIST meta version NMTOKEN "v1">
  <!ENTITY tab "&#9;">
]>
<report>
  <meta version="v2"/>
  <body>
    <line>first&tab;column</line>
    <break/>
    <line>second</line>
    <break></break>
  </body>
</report>