<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE dashboard [
  <!ELEMENT dashboard (metric*, panel)>
  <!ELEMENT metric EMPTY>
  <!ELEMENT panel (title, graph?, table?)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT graph (#PCDATA|point)*>
  <!ELEMENT point EMPTY>
  <!ELEMENT table (row+)>
  <!ELEMENT row (cell+)>
  <!ELEMENT cell (#PCDATA)>
  <!ATTLIST dashboard xmlns:d CDATA #FIXED "urn:dash"
                       generated CDATA #IMPLIED>
  <!ATTLIST metric name CDATA #REQUIRED value CDATA #IMPLIED>
  <!ATTLIST point x CDATA #REQUIRED y CDATA #REQUIRED>
  <!ATTLIST row key ID #IMPLIED>
  <!ATTLIST cell span NMTOKEN "1">
  <!ENTITY tick "&#x2713;">
  <!ENTITY quoted "&quot;quoted&quot;">
]>
<dashboard xmlns:d="urn:dash" generated="now">
  <metric name="load" value="0.75"/>
  <metric name="&quot;latency&quot;" value="12&amp;3"/>
  <panel>
    <title>Status &tick; &quoted;</title>
    <graph>
      <point x="0" y="1"/>
      <point x="1" y="&#x1F;"/>
      <![CDATA[<not-an-element>&still-not-one;</not-an-element>]]>
    </graph>
    <table>
      <row key="r1"><cell>left</cell><cell span="2">right</cell></row>
    </table>
  </panel>
</dashboard>