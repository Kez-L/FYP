<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE archive [
  <!NOTATION bin SYSTEM "application/octet-stream">
  <!ENTITY logo SYSTEM "logo.bin" NDATA bin>
  <!ENTITY quote "She said: &quot;left &amp; right&quot;">
  <!ELEMENT archive (header, payload, footer)>
  <!ELEMENT header (title, owner)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT owner EMPTY>
  <!ELEMENT payload (record+)>
  <!ELEMENT record (key, value, blob?)>
  <!ELEMENT key (#PCDATA)>
  <!ELEMENT value (#PCDATA|mark)*>
  <!ELEMENT mark (#PCDATA)>
  <!ELEMENT blob EMPTY>
  <!ELEMENT footer (#PCDATA)>
  <!ATTLIST archive version NMTOKEN #REQUIRED>
  <!ATTLIST owner uid ID #REQUIRED role (reader|writer|admin) "reader">
  <!ATTLIST record rid ID #REQUIRED source ENTITY #IMPLIED>
  <!ATTLIST blob href ENTITY #REQUIRED>
]>
<archive version="v2" xmlns="urn:archive">
  <header>
    <title>&quote;</title>
    <owner uid="u-1" role="admin"/>
  </header>
  <payload>
    <record rid="r-1" source="logo">
      <key>alpha</key>
      <value>before<mark>middle</mark>after</value>
      <blob href="logo"/>
    </record>
  </payload>
  <footer>done</footer>
</archive>