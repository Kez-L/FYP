<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE matrix [
  <!ELEMENT matrix (row+)>
  <!ELEMENT row (cell+)>
  <!ELEMENT cell (#PCDATA|value)*>
  <!ELEMENT value (#PCDATA)>
  <!ATTLIST matrix rows NMTOKEN #IMPLIED>
  <!ATTLIST row index NMTOKEN #REQUIRED>
  <!ATTLIST cell state (on|off|mixed) "mixed">
]>
<matrix rows="2">
  <row index="01">
    <cell state="on"><value>1</value></cell>
    <cell state="off"><![CDATA[2 < 3 & 4]]></cell>
  </row>
  <row index="02">
    <cell><value>NaN</value><?cell-note?></cell>
    <cell state="mixed">tail</cell>
  </row>
</matrix>