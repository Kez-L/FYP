<?xml version="1.0"?>
<!DOCTYPE dashboard [
  <!ELEMENT dashboard (panel|separator)+>
  <!ELEMENT panel (caption, metric*)>
  <!ELEMENT caption (#PCDATA)>
  <!ELEMENT metric EMPTY>
  <!ELEMENT separator EMPTY>
  <!ATTLIST panel name ID #IMPLIED>
  <!ATTLIST metric
    key NMTOKEN #REQUIRED
    value CDATA #IMPLIED
    state (ok|warn|error) "ok">
  <!ATTLIST separator style CDATA "dashed">
  <![IGNORE[
    <!ELEMENT obsolete EMPTY>
    <!ENTITY hidden "this declaration is ignored">
  ]]>
]>
<dashboard>
  <panel name="cpu">
    <caption>CPU &amp; memory</caption>
    <metric key="load" value="0.75" state="warn"/>
    <metric key="cores" value="8"/>
  </panel>
  <separator style="double"/>
  <panel>
    <caption><![CDATA[Network ]]></caption>
    <metric key="status" state="ok"/>
  </panel>
</dashboard>