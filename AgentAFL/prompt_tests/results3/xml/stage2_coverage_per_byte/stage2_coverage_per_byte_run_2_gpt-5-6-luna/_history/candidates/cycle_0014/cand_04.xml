<?xml version="1.0"?>
<!DOCTYPE matrix [
  <!ELEMENT matrix (row+)>
  <!ELEMENT row (cell*)>
  <!ELEMENT cell (#PCDATA)>
  <!ATTLIST matrix xmlns:m CDATA #IMPLIED dimensions CDATA #REQUIRED>
  <!ATTLIST row index NMTOKEN #REQUIRED>
  <!ATTLIST cell colspan NMTOKEN "1" rowspan NMTOKEN "1">
  <!ENTITY quote "&quot;">
]>
<matrix xmlns:m="urn:matrix" dimensions="2x3">
  <row index="0"><cell colspan="2">A</cell><cell rowspan="2">B</cell></row>
  <row index="1"><cell>&quote;C&quote;</cell><cell><![CDATA[]]></cell></row>
  <row index="2"><cell colspan="0">D</cell></row>
</matrix>