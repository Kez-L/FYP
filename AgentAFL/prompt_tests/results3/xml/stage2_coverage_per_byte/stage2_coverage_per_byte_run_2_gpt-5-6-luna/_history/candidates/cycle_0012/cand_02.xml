<?xml version="1.1" encoding="UTF-8" standalone="yes"?>
<!DOCTYPE stream [
  <!ELEMENT stream (header, record*, trailer)>
  <!ELEMENT header (source, sequence)>
  <!ELEMENT source (#PCDATA)>
  <!ELEMENT sequence (#PCDATA)>
  <!ELEMENT record (key, value, annotation?)>
  <!ELEMENT key (#PCDATA)>
  <!ELEMENT value (#PCDATA|CDATA|token)*>
  <!ELEMENT annotation (#PCDATA)>
  <!ELEMENT trailer EMPTY>
  <!ELEMENT token (#PCDATA)>
  <!ATTLIST stream channel CDATA #REQUIRED>
  <!ATTLIST record id ID #REQUIRED level (trace|info|warn|error) "info">
  <!ATTLIST trailer count NMTOKEN #REQUIRED>
