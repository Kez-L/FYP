<?xml version="1.0"?>
<!DOCTYPE archive [
  <!ENTITY greeting "hello &amp; goodbye">
  <!ENTITY nested "<item status='generated'>&greeting;</item>">
  <!ELEMENT archive (meta, record*)>
  <!ELEMENT meta EMPTY>
  <!ELEMENT record (title, body, marker?)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT body (#PCDATA|emph|break|itemref)*>
  <!ELEMENT emph (#PCDATA)>
  <!ELEMENT break EMPTY>
  <!ELEMENT marker EMPTY>
  <!ATTLIST archive xmlns:a CDATA #IMPLIED>
  <!ATTLIST meta created CDATA "unknown" mode (cold|warm|hot) "cold">
  <!ATTLIST record key ID #REQUIRED>
  <!ATTLIST itemref ref IDREF #IMPLIED>
]>
<archive a:zone="west">
  <meta created="2026-09-24" mode="warm"/>
  <record key="r1">
    <title>Entity test</title>
    <body>before<emph>inside</emph><break/>&nested;<itemref ref="r1"/></body>
    <marker/>
  </record>
</archive>