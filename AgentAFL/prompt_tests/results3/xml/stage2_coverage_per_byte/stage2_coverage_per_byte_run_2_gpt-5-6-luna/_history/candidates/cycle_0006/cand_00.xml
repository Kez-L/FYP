<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE catalog [
  <!ELEMENT catalog (entry+)>
  <!ELEMENT entry (name, description?, link*)>
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT description (#PCDATA|em|code)*>
  <!ELEMENT em (#PCDATA)>
  <!ELEMENT code (#PCDATA)>
  <!ELEMENT link EMPTY>
  <!ATTLIST catalog xml:lang NMTOKEN "en">
  <!ATTLIST entry id ID #REQUIRED status (draft|published|archived) "draft">
  <!ATTLIST link target IDREF #IMPLIED rel CDATA "related">
  <!ENTITY mark "&#x2603;">
]>
<catalog xml:lang="fr">
  <entry id="e1" status="published">
    <name>Résumé &mark;</name>
    <description>Text with <em>emphasis</em> and <code>a&lt;b</code>.</description>
    <link target="e2" rel="next"/>
  </entry>
  <entry id="e2">
    <name>Second entry</name>
    <description><![CDATA[raw <![CDATA[ marker-like text ]] here]]></description>
  </entry>
</catalog>