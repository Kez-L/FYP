<?xml version="1.0"?>
<!DOCTYPE report [
  <!ELEMENT report (header, data)>
  <!ELEMENT header (title, author+)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT author (#PCDATA)>
  <!ELEMENT data (entry*)>
  <!ELEMENT entry (key, value?)>
  <!ELEMENT key (#PCDATA)>
  <!ELEMENT value (#PCDATA)>
  <!ATTLIST report
    format NOTATION (plain|rich) "plain"
    code NMTOKEN #IMPLIED>
  <!NOTATION plain SYSTEM "text/plain">
  <!NOTATION rich PUBLIC "-//Example//Notation Rich//EN" "https://example.test/rich">
]>
<report format="rich" code="R-7">
  <header>
    <title>Signals &amp; Records</title>
    <author>Ada</author>
    <author>Lin</author>
  </header>
  <data>
    <entry><key>empty-value</key></entry>
    <entry><key>quote</key><value><![CDATA["<&>]]></value></entry>
  </data>
</report>