<?xml version="1.0" standalone="yes"?>
<!DOCTYPE network [
  <!ELEMENT network (node*, edge*)>
  <!ELEMENT node (label?, property*)>
  <!ELEMENT label (#PCDATA)>
  <!ELEMENT property EMPTY>
  <!ELEMENT edge EMPTY>
  <!ATTLIST node key ID #REQUIRED kind CDATA #IMPLIED>
  <!ATTLIST property name CDATA #REQUIRED value CDATA #IMPLIED>
  <!ATTLIST edge from IDREF #REQUIRED to IDREF #REQUIRED weight CDATA "1">
]>
<network>
  <node key="n0" kind="hub">
    <label>Root &amp; branch</label>
    <property name="empty" value=""/>
    <property name="quoted" value="&quot;value&quot;"/>
  </node>
  <node key="n1"><property name="flag"/></node>
  <node key="n2">
    <label><![CDATA[line one
line two
line three]]></label>
  </node>
  <edge from="n0" to="n1" weight="0.0"/>
  <edge from="n1" to="n2"/>
  <edge from="n2" to="n0" weight="-4"/>
</network>