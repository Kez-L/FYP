<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE map [
  <!ELEMENT map (point*, link*)>
  <!ELEMENT point EMPTY>
  <!ELEMENT link (#PCDATA)>
  <!ATTLIST point
    ident ID #REQUIRED
    x CDATA #IMPLIED
    y CDATA #IMPLIED>
  <!ATTLIST link
    from IDREF #REQUIRED
    to IDREF #REQUIRED
    kind NMTOKENS #IMPLIED>
]>
<map xmlns="urn:cartography" xml:base="https://example.test/maps/">
  <point ident="origin" x="0" y="0"/>
  <point ident="north" x="0" y="100"/>
  <link from="origin" to="north" kind="road paved">northbound <![CDATA[route & segment]]></link>
</map>