<?xml version="1.0"?>
<!DOCTYPE envelope [
  <!ENTITY open "[[">
  <!ENTITY close "]]">
  <!ENTITY quoted "&quot;quoted&quot;">
  <!ELEMENT envelope (meta, body)>
  <!ELEMENT meta EMPTY>
  <!ELEMENT body (#PCDATA|section|br)*>
  <!ELEMENT section (#PCDATA|br)*>
  <!ELEMENT br EMPTY>
  <!ATTLIST envelope mode (test|live) "test">
  <!ATTLIST meta source CDATA #FIXED "generated">
]>
<envelope mode="live">
  <meta source="generated"/>
  <body>
    Before &open;
    <section title="&quoted;">alpha<br/>beta &amp; gamma</section>
    &close; after
  </body>
</envelope>