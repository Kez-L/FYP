<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE dashboard [
  <!ELEMENT dashboard (meta, panel+, link*)>
  <!ELEMENT meta (title, generated, checksum?)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT generated (#PCDATA)>
  <!ELEMENT checksum (#PCDATA)>
  <!ELEMENT panel (heading, item*)>
  <!ELEMENT heading (#PCDATA)>
  <!ELEMENT item (#PCDATA|emphasis|break)*>
  <!ELEMENT emphasis (#PCDATA)>
  <!ELEMENT break EMPTY>
  <!ELEMENT link EMPTY>
  <!ATTLIST dashboard revision CDATA #REQUIRED xml:lang CDATA "en">
  <!ATTLIST panel name ID #REQUIRED mode (compact|expanded) "compact">
  <!ATTLIST item key NMTOKEN #IMPLIED>
  <!ATTLIST link rel CDATA #REQUIRED href URI #IMPLIED>
  <!NOTATION svg SYSTEM "image/svg+xml">
  <!ENTITY icon SYSTEM "icon.svg" NDATA svg>
  <!ENTITY % audit " audited CDATA 'false' ">
  <!ATTLIST meta %audit;>
]>
