<?xml version="1.0"?>
<!DOCTYPE report [
  <!ENTITY % declarations "
    <!ELEMENT report (metadata, body)>
    <!ELEMENT metadata (author, created, tag*)>
    <!ELEMENT body (paragraph|table|figure)+>
    <!ELEMENT author (#PCDATA)>
    <!ELEMENT created (#PCDATA)>
    <!ELEMENT tag (#PCDATA)>
    <!ELEMENT paragraph (#PCDATA|strong|br)*>
    <!ELEMENT strong (#PCDATA)>
    <!ELEMENT br EMPTY>
    <!ELEMENT table (row+)>
    <!ELEMENT row (cell+)>
    <!ELEMENT cell (#PCDATA)>
    <!ELEMENT figure EMPTY>
  ">
  %declarations;
  <!ATTLIST report revision CDATA #IMPLIED>
  <!ATTLIST table columns NMTOKEN #REQUIRED>
  <!ATTLIST figure src ENTITY #REQUIRED>
  <!NOTATION png SYSTEM "image/png">
  <!ENTITY logo SYSTEM "logo.png" NDATA png>
]>
<report revision="7">
  <metadata>
    <author>Someone</author>
    <created>2026-09-24</created>
    <tag>xml</tag>
  </metadata>
  <body>
    <paragraph>Before <strong>bold</strong><br/>after.</paragraph>
    <table columns="2">
      <row><cell>A</cell><cell>B</cell></row>
      <row><cell>1</cell><cell>2</cell></row>
    </table>
    <figure src="logo"/>
  </body>
</report>