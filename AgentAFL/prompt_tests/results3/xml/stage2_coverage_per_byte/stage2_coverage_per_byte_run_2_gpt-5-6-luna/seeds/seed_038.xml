<!DOCTYPE matrix [
  <!ELEMENT matrix (row+)>
  <!ELEMENT row (cell+)>
  <!ELEMENT cell (#PCDATA)>
  <!ATTLIST matrix size NMTOKENS "2x2" mode (sparse|dense) #REQUIRED>
  <!ATTLIST row number NMTOKEN #REQUIRED>
  <!ATTLIST cell coordinates NMTOKENS #IMPLIED formula CDATA #IMPLIED>
  <!ENTITY left "(">
  <!ENTITY right ")">
  <!ENTITY quote "&quot;">
]>
<matrix mode="sparse" size="2 2">
  <row number="01">
    <cell coordinates="1 1" formula="&left;A1+B1&right;">&quote;alpha&quote;</cell>
    <cell coordinates="1 2">0</cell>
  </row>
  <row number="02">
    <cell coordinates="2 1">&#x2B;</cell>
    <cell coordinates="2 2" formula="SUM(1,2,3)"><![CDATA[6]]></cell>
  </row>
</matrix>