<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE archive [
  <!ELEMENT archive (entry+, trailer?)>
  <!ELEMENT entry (key, value, value*)>
  <!ELEMENT key (#PCDATA)>
  <!ELEMENT value (#PCDATA|br)*>
  <!ELEMENT br EMPTY>
  <!ELEMENT trailer (#PCDATA)>
  <!ATTLIST archive mode (fast|safe|audit) "safe">
  <!ATTLIST entry timestamp CDATA #IMPLIED>
  <!ATTLIST br kind CDATA "soft">
  <!ENTITY nbsp "&#160;">
  <!ENTITY quoted "&quot;quoted&quot;">
]>
<archive mode="audit">
  <entry timestamp="2026-09-24">
    <key>alpha</key>
    <value>one&nbsp;<br/>two</value>
    <value>&quoted;</value>
  </entry>
  <entry>
    <key>beta</key>
    <value><![CDATA[raw ]]> data &amp; more</value>
  </entry>
  <trailer>done</trailer>
</archive>