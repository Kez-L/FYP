<?xml version="1.0"?>
<!DOCTYPE report [
  <!ELEMENT report (title, section+)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT section (heading?, paragraph+, table?)>
  <!ELEMENT heading (#PCDATA)>
  <!ELEMENT paragraph (#PCDATA|em|link|break)*>
  <!ELEMENT em (#PCDATA)>
  <!ELEMENT link (#PCDATA)>
  <!ELEMENT break EMPTY>
  <!ELEMENT table (row+)>
  <!ELEMENT row (cell+)>
  <!ELEMENT cell (#PCDATA)>
  <!ATTLIST section number NMTOKEN #REQUIRED collapsed (true|false) "false">
  <!ATTLIST link href CDATA #REQUIRED rel (next|prev|source) #IMPLIED>
  <!ATTLIST cell colspan NMTOKEN "1">
  <!ENTITY intro "This &amp; that">
  <!ENTITY % extras "<!ATTLIST report edition CDATA 'draft'>">
  %extras;
]>
<report edition="final">
  <title>Inspection &amp; Results</title>
  <section number="1">
    <heading>Overview</heading>
    <paragraph>&intro;<em>important</em><break/>continued
      <link href="urn:doc:2" rel="next">read more</link>
    </paragraph>
    <table>
      <row><cell colspan="2">A</cell><cell>B</cell></row>
      <row><cell><![CDATA[<not-markup>]]></cell><cell>C</cell></row>
    </table>
  </section>
  <section number="2" collapsed="true">
    <paragraph>Only a short note.</paragraph>
  </section>
</report>