<?xml version="1.0"?>
<!DOCTYPE catalog [
  <!ELEMENT catalog (entry+)>
  <!ELEMENT entry (name, details?, link*)>
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT details (#PCDATA|em|code)*>
  <!ELEMENT em (#PCDATA)>
  <!ELEMENT code (#PCDATA)>
  <!ELEMENT link EMPTY>
  <!ATTLIST entry id ID #REQUIRED kind (book|video|other) "other">
  <!ATTLIST link href CDATA #REQUIRED rel CDATA "related">
  <!ENTITY copyright "&#169;">
]>
<catalog>
  <entry id="a1" kind="book">
    <name>XML &amp; Parsing</name>
    <details>Use <em>carefully</em> with <code>&lt;markup&gt;</code> &copyright;</details>
    <link href="urn:one" rel="self"/>
    <link href="urn:two"/>
  </entry>
</catalog>