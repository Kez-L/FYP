<?xml version="1.0"?>
<!DOCTYPE workbook [
  <!ELEMENT workbook (sheet*)>
  <!ELEMENT sheet (row*)>
  <!ELEMENT row (cell*)>
  <!ELEMENT cell (#PCDATA|formula|value)*>
  <!ELEMENT formula (#PCDATA)>
  <!ELEMENT value (#PCDATA)>
  <!ATTLIST workbook version NMTOKEN #REQUIRED>
  <!ATTLIST sheet name NMTOKEN #REQUIRED hidden (yes|no) "no">
  <!ATTLIST row index NMTOKEN #IMPLIED>
  <!ATTLIST cell type (text|number|error) "text">
  <!ENTITY nbsp "&#160;">
  <!ENTITY mark "A &amp; B">
  <!ENTITY % extra "<!ELEMENT annotation (#PCDATA)>">
  %extra;
]>
<workbook version="7">
  <sheet name="Résumé" hidden="yes">
    <row index="001">
      <cell type="text">Name&nbsp;&amp;&nbsp;Status</cell>
      <cell type="number"><value>00042</value></cell>
      <cell type="error"><formula>=SUM(A1:A4)</formula>!</cell>
    </row>
  </sheet>
  <sheet name="Data">
    <row>
      <cell><![CDATA[=IF(A1<2,"x","y")]]></cell>
      <cell>&mark;</cell>
    </row>
  </sheet>
</workbook>