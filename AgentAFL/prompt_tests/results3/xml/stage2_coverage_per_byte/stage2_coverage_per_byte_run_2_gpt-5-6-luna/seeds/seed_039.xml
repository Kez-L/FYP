<?xml version="1.0"?>
<!DOCTYPE package [
  <!ELEMENT package (manifest, content)>
  <!ELEMENT manifest (item*)>
  <!ELEMENT item EMPTY>
  <!ELEMENT content (section*)>
  <!ELEMENT section (#PCDATA|section|aside)*>
  <!ELEMENT aside (#PCDATA)>
  <!ATTLIST package xmlns:p CDATA #IMPLIED>
  <!ATTLIST item name CDATA #REQUIRED media CDATA #IMPLIED>
  <!ATTLIST section level (one|two|three) #IMPLIED>
  <!ENTITY open "[[">
  <!ENTITY close "]]">
]>
<package xmlns:p="urn:pkg" p:version="3">
  <manifest>
    <item name="cover" media="text/xml"/>
    <item name="data&amp;set" media="application/octet-stream"/>
  </manifest>
  <content>
    <section level="one">Intro <section level="two">Nested <aside>note &open;literal&close;</aside></section> end</section>
    <section level="three"><![CDATA[<not-an-element>]]><?hint ignored?></section>
  </content>
</package>