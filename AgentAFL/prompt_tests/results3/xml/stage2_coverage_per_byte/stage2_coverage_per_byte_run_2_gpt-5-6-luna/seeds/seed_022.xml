<!DOCTYPE shell [
  <!ELEMENT shell (section*)>
  <!ELEMENT section (title?, item*)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT item EMPTY>
  <!ATTLIST section name CDATA #REQUIRED>
  <!ATTLIST item key CDATA #IMPLIED state (new|old|x) #REQUIRED>
  <!ENTITY % optional "<!ELEMENT note (#PCDATA)>">
  <![IGNORE[
    <!ELEMENT ignored (never)>
    <!ATTLIST ignored flag CDATA "x">
  ]]>
  %optional;
]>
<shell>
  <section name="one">
    <title>First &apos;section&apos;</title>
    <item key="a" state="new"/>
    <item key="b" state="old"></item>
  </section>
  <section name="two"><item state="x"/></section>
</shell>