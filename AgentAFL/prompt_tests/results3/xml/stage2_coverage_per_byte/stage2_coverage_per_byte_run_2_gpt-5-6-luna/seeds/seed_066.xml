<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE dashboard [
  <!ELEMENT dashboard (widget+, footer)>
  <!ELEMENT widget (caption?, data)>
  <!ELEMENT caption (#PCDATA)>
  <!ELEMENT data (#PCDATA|value|raw)*>
  <!ELEMENT value (#PCDATA)>
  <!ELEMENT raw ANY>
  <!ELEMENT footer (#PCDATA)>
  <!ATTLIST widget id ID #REQUIRED class NMTOKENS #IMPLIED enabled (yes|no) "yes">
  <!ATTLIST value unit NMTOKEN #IMPLIED>
  <!ENTITY left "[" >
  <!ENTITY right "]" >
]>
<dashboard>
