<?xml version="1.0"?>
<!DOCTYPE manifest [
  <!ELEMENT manifest (group*)>
  <!ELEMENT group (file|alias|![IGNORE[ impossible ]]) *>
  <!ELEMENT file (#PCDATA)>
  <!ELEMENT alias EMPTY>
  <!ATTLIST manifest format NMTOKEN #FIXED "bundle">
  <!ATTLIST group name NMTOKEN #REQUIRED members ENTITIES #IMPLIED>
  <!ATTLIST file path CDATA #REQUIRED type (text|binary) #REQUIRED>
  <!ATTLIST alias target ENTITY #REQUIRED>
  <!NOTATION bin SYSTEM "application/octet-stream">
  <!ENTITY blob SYSTEM "data.bin" NDATA bin>
  <!ENTITY label "manifest &amp; entry">
  <!ENTITY % attrs " xml:lang CDATA #IMPLIED xml:space (default|preserve) 'default' ">
  <!ATTLIST file %attrs;>
]>
<manifest format="bundle">
  <group name="assets">
    <file path="a.txt" type="text" xml:lang="en">first &label;</file>
    <file path="b.dat" type="binary">010203</file>
    <alias target="blob"/>
  </group>
  <group name="empty" members=""/>
</manifest>