<?xml version="1.0"?>
<!DOCTYPE ui [
  <!ELEMENT ui (window+)>
  <!ELEMENT window (caption?, widget*)>
  <!ELEMENT caption (#PCDATA)>
  <!ELEMENT widget (label?, value?, widget*)>
  <!ELEMENT label (#PCDATA|icon)*>
  <!ELEMENT value (#PCDATA|linebreak)*>
  <!ELEMENT icon EMPTY>
  <!ELEMENT linebreak EMPTY>
  <!ATTLIST window id ID #REQUIRED state (open|closed) "open">
  <!ATTLIST widget name NMTOKEN #IMPLIED visible (yes|no) "yes">
  <!ATTLIST icon src CDATA #REQUIRED alt CDATA #IMPLIED>
]>
<ui xmlns="urn:example:ui" xmlns:x="urn:example:extra">
  <window id="main" state="open">
    <caption>Control &amp; Monitor</caption>
    <widget name="tree" x:visible="yes">
      <label><icon src="tree.svg" alt="tree"/>Nodes</label>
      <value>root<linebreak/>child</value>
      <widget name="leaf"><label>Leaf</label></widget>
    </widget>
  </window>
  <window id="aux" state="closed"><caption/></window>
</ui>