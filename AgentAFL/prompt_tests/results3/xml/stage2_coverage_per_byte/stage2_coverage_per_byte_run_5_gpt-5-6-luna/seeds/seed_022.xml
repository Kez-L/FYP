<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE map [
  <!ELEMENT map (item|group)*>
  <!ELEMENT group (item|group)*>
  <!ELEMENT item (#PCDATA)>
  <!ATTLIST map xmlns:x CDATA #FIXED "urn:example:x">
  <!ATTLIST group name CDATA #REQUIRED>
  <!ATTLIST item code NMTOKENS #IMPLIED x:flag (yes|no) "no">
  <!ENTITY nbsp "&#160;">
]>
<map xmlns="urn:example:default" xmlns:x="urn:example:x">
  <group name="outer">
    <item code="A B C" x:flag="yes">one&nbsp;two</item>
    <group name="inner">
      <item code="single">three</item>
    </group>
  </group>
  <item code="last" x:flag="no">four</item>
</map>