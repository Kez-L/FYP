<?xml version="1.0"?>
<!DOCTYPE matrix [
  <!ELEMENT matrix (row*)>
  <!ELEMENT row (cell*)>
  <!ELEMENT cell (#PCDATA)>
  <!ATTLIST row index NMTOKEN #REQUIRED>
  <!ATTLIST cell
    column NMTOKEN #REQUIRED
    kind (integer|decimal|string|empty) "string"
    ref IDREFS #IMPLIED>
]>
<matrix xmlns="urn:matrix" xmlns:r="urn:row">
  <row index="r0">
    <cell column="c0" kind="integer">-17</cell>
    <cell column="c1" kind="decimal">3.14159</cell>
  </row>
  <row index="r1">
    <cell column="c0" kind="string" ref="r0 r1">text</cell>
    <cell column="c1" kind="empty"/>
    <cell column="c2"><![CDATA[
      whitespace
      and ]]> bracket
    ]]></cell>
  </row>
  <r:row index="r2">
    <r:cell column="c0">prefixed</r:cell>
  </r:row>
</matrix>