<?xml version="1.0"?>
<!DOCTYPE matrix [
  <!ELEMENT matrix (row+)>
  <!ELEMENT row (cell*)>
  <!ELEMENT cell (#PCDATA)>
  <!ATTLIST matrix rows CDATA #IMPLIED cols CDATA #IMPLIED>
  <!ATTLIST row index NMTOKEN #IMPLIED>
  <!ATTLIST cell r NMTOKEN #IMPLIED c NMTOKEN #IMPLIED formula CDATA #IMPLIED>
  <!ENTITY amp "&amp;">
  <!ENTITY quote "&quot;">
]>
<matrix rows="2" cols="3">
  <row index="01">
    <cell r="1" c="1" formula="&quot;A&amp;B&quot;">&amp;</cell>
    <cell r="1" c="2"><![CDATA[1 < 2 && 3 > 2]]></cell>
    <cell r="1" c="3">line&#xA;break</cell>
  </row>
  <row index="02">
    <cell r="2" c="1" formula="sum(A1:C1)">42</cell>
    <cell r="2" c="2">&quote;quoted&quote;</cell>
    <cell r="2" c="3"/>
  </row>
</matrix>