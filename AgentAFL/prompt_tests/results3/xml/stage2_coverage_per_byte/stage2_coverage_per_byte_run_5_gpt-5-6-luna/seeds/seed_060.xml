<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE aquarium [
  <!ELEMENT aquarium (tank+, caretaker?)>
  <!ELEMENT tank (water, inhabitant*)>
  <!ELEMENT water (#PCDATA)>
  <!ELEMENT inhabitant EMPTY>
  <!ELEMENT caretaker (#PCDATA)>
  <!ATTLIST aquarium location NMTOKEN #REQUIRED>
  <!ATTLIST tank volume NMTOKEN #IMPLIED>
  <!ATTLIST inhabitant species NMTOKEN #REQUIRED depth CDATA "0">
]>
<aquarium location="north-wing">
  <tank volume="240L">
    <water><![CDATA[pH < 7 && salinity > 0]]></water>
    <inhabitant species="axolotl" depth="12"/>
    <inhabitant species="snail" depth="4"></inhabitant>
  </tank>
  <caretaker>Zoë<!--shift change--></caretaker>
</aquarium>