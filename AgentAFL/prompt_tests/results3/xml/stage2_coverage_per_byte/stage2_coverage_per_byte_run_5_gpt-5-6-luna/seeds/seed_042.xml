<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE map [
  <!ELEMENT map (entry*)>
  <!ELEMENT entry (key, value, value?)>
  <!ELEMENT key (#PCDATA)>
  <!ELEMENT value (#PCDATA|ref|mark)*>
  <!ELEMENT ref EMPTY>
  <!ELEMENT mark (#PCDATA)>
  <!ATTLIST entry id ID #IMPLIED parent IDREF #IMPLIED>
  <!ATTLIST ref target IDREFS #REQUIRED>
  <!ATTLIST map version NMTOKEN #FIXED "v2">
  <!ENTITY nbsp "&#160;">
  <!ENTITY arrow "&#x2192;">
]>
<map version="v2" xmlns="urn:map" xmlns:x="urn:extra">
  <entry id="root">
    <key>start</key>
    <value>one&nbsp;<mark>two</mark><ref target="leaf branch"/></value>
  </entry>
  <entry id="branch" parent="root">
    <key>x:key</key>
    <value xml:lang="ja"><x:tag>&arrow; 終了</x:tag></value>
  </entry>
  <entry id="leaf" parent="branch">
    <key><![CDATA[key]]></key>
    <value><ref target="root"/></value>
  </entry>
</map>