<?xml version="1.0"?>
<!DOCTYPE matrix [
  <!ELEMENT matrix (row+)>
  <!ELEMENT row (cell+)>
  <!ELEMENT cell (#PCDATA)>
  <!ATTLIST matrix rows CDATA #REQUIRED cols CDATA #REQUIRED>
  <!ATTLIST row index NMTOKEN #REQUIRED>
  <!ATTLIST cell index NMTOKEN #REQUIRED formula CDATA #IMPLIED>
]>
<matrix rows="2" cols="3">
  <row index="A">
    <cell index="1" formula="=SUM(B1:C1)">1</cell>
    <cell index="2">2</cell>
    <cell index="3"><![CDATA[3]]></cell>
  </row>
  <row index="B">
    <cell index="1" formula="&quot;=&quot;&amp;A1">x &lt; y</cell>
    <cell index="2">0</cell>
    <cell index="3">∞</cell>
  </row>
</matrix>