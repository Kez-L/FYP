<?xml version="1.0"?>
<!DOCTYPE report [
  <!ELEMENT report (section|section-ref)*>
  <!ELEMENT section (title, entry*)>
  <!ELEMENT section-ref EMPTY>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT entry (#PCDATA|em|br)*>
  <!ELEMENT em (#PCDATA)>
  <!ELEMENT br EMPTY>
  <!ATTLIST section id ID #IMPLIED>
  <!ATTLIST section-ref target IDREF #REQUIRED>
  <!ENTITY % feature "INCLUDE">
  <![%feature;[
    <!ENTITY marker "included">
  ]]>
]>
<report>
  <section id="intro">
    <title>First</title>
    <entry>alpha<em>bold</em>omega<br/>tail</entry>
  </section>
  <section-ref target="intro"/>
  <section id="tail">
    <title>&marker;</title>
    <entry><![CDATA[]]></entry>
  </section>
</report>