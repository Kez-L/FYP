<?xml version="1.0"?>
<!DOCTYPE catalog [
  <!ELEMENT catalog (item*)>
  <!ELEMENT item (name, details?, blob)>
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT details (#PCDATA|em|br)*>
  <!ELEMENT em (#PCDATA)>
  <!ELEMENT br EMPTY>
  <!ELEMENT blob ANY>
  <!ATTLIST item code ID #REQUIRED status (new|used|retired) "new">
  <!ENTITY note "A &amp; B &lt; C">
]>
<catalog>
  <item code="i-001" status="used">
    <name>alpha</name>
    <details>text<em>emphasis</em><br/>tail</details>
    <blob><![CDATA[x < y && y > z ]]> &note;</blob>
  </item>
  <item code="i-002">
    <name>beta</name>
    <blob>mixed <![CDATA[ ]]> content</blob>
  </item>
</catalog>