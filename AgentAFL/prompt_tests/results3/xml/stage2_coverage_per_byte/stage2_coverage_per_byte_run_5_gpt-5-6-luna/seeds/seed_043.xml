<?xml version="1.0"?>
<!DOCTYPE report [
  <!ELEMENT report (section+)>
  <!ELEMENT section (heading, body)>
  <!ELEMENT heading (#PCDATA)>
  <!ELEMENT body (#PCDATA|line|link|break)*>
  <!ELEMENT line (#PCDATA|link)*>
  <!ELEMENT link (#PCDATA)>
  <!ELEMENT break EMPTY>
  <!ATTLIST section number CDATA #REQUIRED>
  <!ATTLIST link href CDATA #IMPLIED>
  <!ENTITY open "[[">
  <!ENTITY close "]]">
]>
<report>
  <section number="01">
    <heading>Malformed boundary</heading>
    <body>alpha<line>beta<link href="urn:x">gamma</link></line><break/>delta</body>
  </section>
  <section number="02">
    <heading>unterminated
    <body>text &open; not finished &close;</body>
  </section>
</report>