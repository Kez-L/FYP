<?xml version="1.0"?>
<!DOCTYPE report [
  <!ELEMENT report (header, data)>
  <!ELEMENT header (name, value+)>
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT value (#PCDATA)>
  <!ELEMENT data (record*)>
  <!ELEMENT record (field*)>
  <!ELEMENT field (#PCDATA)>
  <!ATTLIST report generated CDATA #IMPLIED>
  <!ATTLIST record id ID #IMPLIED status (new|old|deleted) "new">
  <!ATTLIST field name CDATA #REQUIRED>
  <!ENTITY quote "&quot;">
  <!ENTITY apos "&apos;">
]>
<report generated="yes">
  <header>
    <name>mode</name>
    <value>test</value>
    <value>&quote;quoted&quote;</value>
  </header>
  <data>
    <record id="r1" status="new">
      <field name="empty"></field>
      <field name="text">one &amp; two</field>
    </record>
    <record id="r2" status="deleted"><field name="x"><![CDATA[]]></field></record>
  </data>
</report>