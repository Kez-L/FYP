<?xml version="1.1" standalone="yes"?>
<!DOCTYPE packet [
  <!ELEMENT packet (meta, data, checksum?)>
  <!ELEMENT meta EMPTY>
  <!ELEMENT data (#PCDATA)>
  <!ELEMENT checksum (#PCDATA)>
  <!ATTLIST meta
    kind NOTATION (json|text) "text"
    flags NMTOKENS #IMPLIED>
  <!NOTATION json SYSTEM "application/json">
  <!NOTATION text PUBLIC "-//Example//TEXT 1.0//EN">
  <!ENTITY quoted "&quot;&apos;&amp;&lt;&gt;">
]>
<packet>
  <meta kind="json" flags="a b c"/>
  <data><![CDATA[
    {"x": "<tag>", "y": "]]>"} 
  ]]></data>
  <checksum>&quoted;</checksum>
</packet>