<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE report [
  <!ENTITY % flags "CDATA">
  <!ELEMENT report (section|warning|section)*>
  <!ELEMENT section (metric+, table?)>
  <!ELEMENT metric EMPTY>
  <!ELEMENT table (row+)>
  <!ELEMENT row (cell+)>
  <!ELEMENT cell (#PCDATA)>
  <!ELEMENT warning (#PCDATA)>
  <!ATTLIST report generated %flags; #IMPLIED>
  <!ATTLIST section id ID #IMPLIED>
  <!ATTLIST metric name CDATA #REQUIRED unit CDATA #IMPLIED value CDATA #REQUIRED>
  <!ATTLIST table format (csv|grid|raw) "raw">
  <!ATTLIST row n NMTOKEN #IMPLIED>
  <!ATTLIST cell span NMTOKEN "1">
]>
<report generated="yes">
  <section id="cpu">
    <metric name="load" unit="%" value="99.9"/>
    <metric name="cores" value="0"/>
    <table format="grid">
      <row n="01"><cell span="2">idle</cell><cell>busy</cell></row>
      <row n="02"><cell>unknown</cell></row>
    </table>
  </section>
  <warning>threshold &gt; baseline</warning>
</report>