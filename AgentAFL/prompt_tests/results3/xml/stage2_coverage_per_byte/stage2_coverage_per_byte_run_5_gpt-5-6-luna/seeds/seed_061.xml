<?xml version="1.0"?>
<!DOCTYPE archive [
  <!ELEMENT archive (folder*)>
  <!ELEMENT folder (name, item*)>
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT item (label, digest, note?)>
  <!ELEMENT label (#PCDATA)>
  <!ELEMENT digest (#PCDATA)>
  <!ELEMENT note (#PCDATA)>
  <!ATTLIST folder key ID #IMPLIED parent IDREF #IMPLIED>
  <!ATTLIST item type NOTATION (text|binary) "text" checksum CDATA #REQUIRED>
  <!NOTATION text SYSTEM "text/plain">
  <!NOTATION binary SYSTEM "application/octet-stream">
]>
<archive>
  <folder key="root">
    <name>incoming</name>
    <item type="text" checksum="sha256:0000">
      <label>résumé.txt</label>
      <digest><![CDATA[abc<def>ghi]]></digest>
      <note>line one
line two</note>
    </item>
  </folder>
  <folder key="backup" parent="root">
    <name>old</name>
    <item type="binary" checksum="sha256:ffff">
      <label>image.bin</label>
      <digest>deadbeef</digest>
    </item>
  </folder>
</archive>