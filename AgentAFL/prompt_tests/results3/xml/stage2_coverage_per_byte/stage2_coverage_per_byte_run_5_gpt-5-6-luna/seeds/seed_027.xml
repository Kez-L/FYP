<?xml version="1.0"?>
<!DOCTYPE message [
  <!ENTITY open "<![CDATA[">
  <!ENTITY close "]]>">
  <!ENTITY amp "&#38;">
  <!ELEMENT message (routing, body)>
  <!ELEMENT routing (from, to, reply?)>
  <!ELEMENT from (#PCDATA)>
  <!ELEMENT to (#PCDATA)>
  <!ELEMENT reply (#PCDATA)>
  <!ELEMENT body (paragraph|quote|attachment)*>
  <!ELEMENT paragraph (#PCDATA|em|mark)*>
  <!ELEMENT em (#PCDATA)>
  <!ELEMENT mark (#PCDATA)>
  <!ELEMENT quote (paragraph+)>
  <!ELEMENT attachment EMPTY>
  <!ATTLIST message id ID #REQUIRED priority CDATA "normal">
  <!ATTLIST attachment href URI #REQUIRED media CDATA #IMPLIED>
]>
<message id="m42" priority="urgent">
  <routing>
    <from>alice@example.test</from>
    <to>bob@example.test</to>
    <reply>none</reply>
  </routing>
  <body>
    <paragraph>Hello <em>there</em> and <mark>again</mark>.</paragraph>
    <quote><paragraph>nested <em>text</em></paragraph><paragraph>second</paragraph></quote>
    <attachment href="urn:file:one" media="application/octet-stream"/>
    <paragraph>&open;literal markup &amp; odd boundary&close;</paragraph>
  </body>
</message>