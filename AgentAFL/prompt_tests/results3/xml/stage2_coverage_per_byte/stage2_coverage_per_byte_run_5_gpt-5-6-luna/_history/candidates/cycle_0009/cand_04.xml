<?xml version="1.1" standalone="no"?>
<!DOCTYPE graph [
  <!ELEMENT graph (node*)>
  <!ELEMENT node (name, edge*)>
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT edge EMPTY>
  <!ATTLIST node uid ID #REQUIRED>
  <!ATTLIST edge to IDREF #REQUIRED weight NMTOKEN "1">
  <!ENTITY ampersand "&#38;">
  <!ENTITY nested "left &ampersand; right">
]>
<graph xmlns:g="urn:graph" xml:base="http://example.test/root/">
  <node uid="n0">
    <name>origin</name>
    <edge to="n1" weight="01"/>
    <edge to="missing" weight="∞"/>
  </node>
  <node uid="n1">
    <name>middle &nested;</name>
    <edge to="n0"/>
  </node>
  <node uid="n2"><name xml:space="default">tail</name></node>
</graph>