<?xml version="1.0"?>
<!DOCTYPE catalog [
  <!ELEMENT catalog (item+, metadata?)>
  <!ELEMENT item (name, price, description?)>
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT price (#PCDATA)>
  <!ELEMENT description (#PCDATA|emph)*>
  <!ELEMENT emph (#PCDATA)>
  <!ELEMENT metadata EMPTY>
  <!ATTLIST item id ID #REQUIRED status (new|used|archived) "new">
]>
<catalog>
  <item id="x1" status="new">
    <name>Widget &amp; Gear</name>
    <price>12.50</price>
    <description>Compact <emph>multi-use</emph> device</description>
  </item>
  <metadata/>
</catalog>