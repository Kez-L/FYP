<?xml version="1.0"?>
<!DOCTYPE library [
  <!ELEMENT library (section+)>
  <!ELEMENT section (heading, item*)>
  <!ELEMENT heading (#PCDATA)>
  <!ELEMENT item (name, value, note?)>
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT value (#PCDATA)>
  <!ELEMENT note (#PCDATA|ref)*>
  <!ELEMENT ref EMPTY>
  <!ATTLIST section code ID #REQUIRED>
  <!ATTLIST item kind (book|map|record) "record">
  <!ATTLIST ref target IDREF #IMPLIED>
]>
<library>
  <section code="sA">
    <heading>Archives</heading>
    <item kind="book">
      <name>North Wind</name>
      <value>17</value>
      <note>stored near <ref target="sB"/> annex</note>
    </item>
  </section>
  <section code="sB">
    <heading>Maps</heading>
    <item kind="map">
      <name>Contour</name>
      <value>42</value>
    </item>
  </section>
</library>