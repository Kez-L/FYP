<!DOCTYPE archive [
  <!ENTITY % common "<!ELEMENT archive (folder+)><!ELEMENT folder (name, object*)><!ELEMENT name (#PCDATA)><!ELEMENT object EMPTY>">
  <!ENTITY % attrs "<!ATTLIST object id ID #REQUIRED type NOTATION #IMPLIED path CDATA #IMPLIED>">
  %common;
  %attrs;
  <!NOTATION jpeg PUBLIC "image/jpeg">
  <!NOTATION text SYSTEM "text/plain">
  <!ATTLIST archive version CDATA #FIXED "3">
  <!ATTLIST folder hidden (true|false) "false">
  <!ENTITY apos "&#39;">
]>
<archive version="3">
  <folder hidden="true">
    <name>root&apos;s &apos;cache&apos;</name>
    <object id="o1" type="jpeg" path="img/one.jpg"/>
    <object id="o2" type="text" path="notes&amp;more.txt"/>
  </folder>
  <folder>
    <name><![CDATA[secondary]]></name>
    <object id="o3" path="plain"/>
  </folder>
</archive>