<?xml version="1.0"?>
<!DOCTYPE catalog [
  <!ENTITY % feature "INCLUDE">
  <!ENTITY % extra "<!ELEMENT metadata (author?, keyword*)><!ELEMENT author (#PCDATA)><!ELEMENT keyword (#PCDATA)>">
  <![%feature;[
    %extra;
    <!ATTLIST item xml:lang NMTOKEN #IMPLIED xml:space (default|preserve) "default">
  ]]>
  <!ELEMENT catalog (item+)>
  <!ELEMENT item (title, metadata?, price, note?)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT price (#PCDATA)>
  <!ELEMENT note (#PCDATA|emph|ref)*>
  <!ELEMENT emph (#PCDATA)>
  <!ELEMENT ref EMPTY>
  <!ATTLIST item code ID #REQUIRED>
  <!ATTLIST ref target IDREF #IMPLIED>
]>
<catalog>
  <item code="a1" xml:lang="fr">
    <title>Résumé &amp; détails</title>
    <metadata><author>Élodie</author><keyword>xml</keyword></metadata>
    <price>19.95</price>
    <note>Voir <ref target="a1"/> <emph>ici</emph>.</note>
  </item>
</catalog>