<?xml version="1.0"?>
<!DOCTYPE catalog [
  <!ENTITY % common "&#x25; shared">
  <!ENTITY % shared " 
    <!ELEMENT catalog (section+)>
    <!ELEMENT section (title, entry*)>
    <!ELEMENT title (#PCDATA)>
    <!ELEMENT entry (#PCDATA|em|link)*>
    <!ELEMENT em (#PCDATA)>
    <!ELEMENT link EMPTY>
    <!ATTLIST section id ID #REQUIRED kind NMTOKEN "general">
    <!ATTLIST entry key ID #IMPLIED ref IDREF #IMPLIED>
    <!ATTLIST link href CDATA #REQUIRED>
  ">
  %common;
  <!ENTITY intro "A &amp; B &lt; C">
  <!NOTATION plain SYSTEM "text/plain">
]>
<catalog>
  <section id="s1" kind="mixed">
    <title>&intro;</title>
    <entry key="e1">alpha <em>bold</em> omega<link href="urn:x"/></entry>
    <entry ref="e1"><![CDATA[raw ]]> data</entry>
  </section>
</catalog>