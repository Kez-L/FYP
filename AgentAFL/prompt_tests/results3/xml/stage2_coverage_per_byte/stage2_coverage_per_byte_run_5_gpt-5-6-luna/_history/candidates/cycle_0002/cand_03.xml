<?xml version="1.0"?>
<!DOCTYPE envelope [
  <!ELEMENT envelope (header, payload)>
  <!ELEMENT header (from, to, trace?)>
  <!ELEMENT from (#PCDATA)>
  <!ELEMENT to (#PCDATA)>
  <!ELEMENT trace (#PCDATA)>
  <!ELEMENT payload ANY>
  <!ATTLIST envelope xmlns CDATA #IMPLIED>
  <!ATTLIST header priority (low|normal|high) "normal">
]>
<envelope xmlns="urn:mail" xmlns:a="urn:aux" xmlns:b="urn:aux">
  <header priority="high">
    <from a:kind="service">a@example</from>
    <to b:kind="user">b@example</to>
    <trace xmlns:a="urn:trace" a:id="t-1">x</trace>
  </header>
  <payload xmlns="">
    <data xmlns="urn:data" a:unused="yes">
      <a:item xmlns:a="urn:item">one</a:item>
      <b:item>two</b:item>
    </data>
  </payload>
</envelope>