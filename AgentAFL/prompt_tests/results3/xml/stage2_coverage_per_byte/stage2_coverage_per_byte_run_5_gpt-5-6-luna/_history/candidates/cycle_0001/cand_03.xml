<?xml version="1.0"?>
<!DOCTYPE message [
  <!ELEMENT message (header, body)>
  <!ELEMENT header (to, from, subject?)>
  <!ELEMENT body (#PCDATA|section|br)*>
  <!ELEMENT to (#PCDATA)>
  <!ELEMENT from (#PCDATA)>
  <!ELEMENT subject (#PCDATA)>
  <!ELEMENT section (#PCDATA|br)*>
  <!ELEMENT br EMPTY>
  <!ATTLIST message priority CDATA "normal">
]>
<message priority="urgent">
  <header>
    <to>receiver@example.test</to>
    <from>sender@example.test</from>
    <subject>edge case &amp; test</subject>
  </header>
  <body><section>line one<br/>line two</section>tail text