<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE envelope [
  <!ELEMENT envelope (header, payload)>
  <!ELEMENT header (source, destination, timestamp)>
  <!ELEMENT source (#PCDATA)>
  <!ELEMENT destination (#PCDATA)>
  <!ELEMENT timestamp (#PCDATA)>
  <!ELEMENT payload ANY>
  <!ELEMENT packet (data|dataRef|fragment)+>
  <!ELEMENT data (#PCDATA)>
  <!ELEMENT dataRef EMPTY>
  <!ELEMENT fragment (#PCDATA|packet)*>
  <!ATTLIST envelope xmlns:sec CDATA #IMPLIED>
  <!ATTLIST dataRef href CDATA #REQUIRED digest CDATA #IMPLIED>
  <!ENTITY left "&#x3C;">
  <!ENTITY right "&#x3E;">
]>
<envelope xmlns:sec="urn:security" sec:mode="sealed">
  <header>
    <source>node-α</source>
    <destination>node-β</destination>
    <timestamp>2026-10-01T12:34:56Z</timestamp>
  </header>
  <payload>
    <packet>
      <data>literal &left;not-an-element&right;</data>
      <dataRef href="urn:blob:7" digest="sha256:deadbeef"/>
      <fragment><packet><data>nested</data></packet></fragment>
    </packet>
  </payload>
</envelope>