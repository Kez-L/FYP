<!DOCTYPE map [
  <!ELEMENT map (entry+)>
  <!ELEMENT entry (key, value)>
  <!ELEMENT key (#PCDATA)>
  <!ELEMENT value (#PCDATA|ref)*>
  <!ELEMENT ref EMPTY>
  <!ATTLIST entry xml:space (default|preserve) "default">
  <!ATTLIST ref target IDREF #REQUIRED>
  <!ATTLIST map version NMTOKEN #FIXED "v1">
  <!ENTITY % common ' xml:base CDATA #IMPLIED'>
  <!ATTLIST entry %common;>
]>
<map version="v1" xml:base="urn:test">
  <entry xml:space="preserve">
    <key> one </key>
    <value>left<ref target="missing"/>right</value>
  </entry>
</map>