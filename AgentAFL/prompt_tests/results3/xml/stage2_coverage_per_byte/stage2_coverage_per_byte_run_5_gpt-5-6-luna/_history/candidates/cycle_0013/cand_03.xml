<?xml version="1.0"?>
<!DOCTYPE ledger [
  <!ELEMENT ledger (opening, transaction*, closing)>
  <!ELEMENT opening (#PCDATA)>
  <!ELEMENT transaction (date, account, amount, memo?)>
  <!ELEMENT date (#PCDATA)>
  <!ELEMENT account (#PCDATA)>
  <!ELEMENT amount (#PCDATA)>
  <!ELEMENT memo (#PCDATA)>
  <!ELEMENT closing (#PCDATA)>
  <!ATTLIST transaction code ID #REQUIRED cleared (true|false) #REQUIRED>
  <!ENTITY euro "&#x20AC;">
  <!ENTITY nbsp "&#160;">
]>
<ledger>
  <opening>1000.00</opening>
  <transaction code="t01" cleared="true">
    <date>2026-09-30</date>
    <account>cash</account>
    <amount>&euro;25.50</amount>
    <memo>coffee &amp; supplies</memo>
  </transaction>
  <transaction code="t02" cleared="false">
    <date>2026-10-01</date>
    <account>reserve</account>
    <amount>-10.00&nbsp;</amount>
  </transaction>
  <closing>1015.50</closing>
</ledger>