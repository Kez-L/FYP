<?xml version="1.0"?>
<!DOCTYPE catalog [
  <!ENTITY company "A &amp; B">
  <!ENTITY % common "CDATA #IMPLIED">
  <!ELEMENT catalog (entry+)>
  <!ELEMENT entry (title, description?, tag*)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT description (#PCDATA|em|br)*>
  <!ELEMENT em (#PCDATA)>
  <!ELEMENT br EMPTY>
  <!ELEMENT tag (#PCDATA)>
  <!ATTLIST entry id ID #REQUIRED status (new|old|archived) "new">
  <!ATTLIST entry owner %common;>
]>
<catalog>
  <entry id="e-1" owner="&company;">
    <title>Résumé &amp; notes</title>
    <description>alpha <em>bold</em> beta<br/>gamma</description>
    <tag>one</tag>
    <tag>two &lt; three</tag>
  </entry>
</catalog>