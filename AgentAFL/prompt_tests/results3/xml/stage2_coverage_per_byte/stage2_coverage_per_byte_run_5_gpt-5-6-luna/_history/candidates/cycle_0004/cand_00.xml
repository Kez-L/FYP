<?xml version="1.0"?>
<!DOCTYPE catalog [
  <!ELEMENT catalog (entry+, metadata)>
  <!ELEMENT entry (title, author*, note?)>
  <!ATTLIST entry
    id ID #REQUIRED
    status (new|old|archived) "new"
    xml:space (default|preserve) "default">
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT author (#PCDATA)>
  <!ELEMENT note (#PCDATA|emph)*>
  <!ELEMENT emph (#PCDATA)>
  <!ELEMENT metadata EMPTY>
  <!ATTLIST metadata generated CDATA #FIXED "yes">
  <!ENTITY copyright "© 2026">
]>
<catalog xmlns="urn:example:catalog" xmlns:m="urn:example:meta">
  <entry id="e1" status="old">
    <title>Names, entities, and &copyright;</title>
    <author>Alpha</author>
    <note xml:space="preserve">A <emph>mixed</emph> note.</note>
  </entry>
  <entry id="e2">
    <title>Second title</title>
    <author>Beta</author>
  </entry>
  <metadata m:generated="true"/>
</catalog>