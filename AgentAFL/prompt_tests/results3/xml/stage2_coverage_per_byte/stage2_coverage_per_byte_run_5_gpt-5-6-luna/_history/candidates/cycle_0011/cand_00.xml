<?xml version="1.0"?>
<!DOCTYPE catalog [
  <!ELEMENT catalog (entry+, note?)>
  <!ELEMENT entry (title, creator*, link?, description)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT creator EMPTY>
  <!ELEMENT link EMPTY>
  <!ELEMENT description (#PCDATA|em|code|br)*>
  <!ELEMENT em (#PCDATA|code)*>
  <!ELEMENT code (#PCDATA)>
  <!ELEMENT br EMPTY>
  <!ELEMENT note (#PCDATA)>
  <!ATTLIST catalog id ID #REQUIRED version NMTOKEN #IMPLIED>
  <!ATTLIST entry key ID #REQUIRED status (draft|live|retired) "draft">
  <!ATTLIST creator name CDATA #REQUIRED ref IDREF #IMPLIED>
  <!ATTLIST link href CDATA #REQUIRED type NMTOKEN #IMPLIED>
  <!NOTATION binary SYSTEM "application/octet-stream">
  <!ENTITY logo SYSTEM "logo.bin" NDATA binary>
]>
<catalog id="c-01" version="v2">
  <entry key="e-7" status="live">
    <title>Mixed <em>content</em> &amp; markup</title>
    <creator name="Ada" ref="e-7"/>
    <link href="https://example.test/a?x=1&amp;y=2" type="html"/>
    <description>alpha <em>beta <code>gamma</code></em><br/>delta</description>
  </entry>
  <note>Unparsed entity: &logo;</note>
</catalog>