<?xml version="1.0"?>
<!DOCTYPE media [
  <!ELEMENT media (track|image|clip)*>
  <!ELEMENT track EMPTY>
  <!ELEMENT image EMPTY>
  <!ELEMENT clip (#PCDATA)>
  <!ATTLIST track src ENTITY #REQUIRED kind (audio|video) #IMPLIED>
  <!ATTLIST image src ENTITY #REQUIRED alt CDATA #IMPLIED>
  <!NOTATION png SYSTEM "image/png">
  <!NOTATION ogg PUBLIC "-//Example//NOTATION Ogg//EN" "audio/ogg">
  <!ENTITY cover SYSTEM "cover.png" NDATA png>
  <!ENTITY tune SYSTEM "sound.ogg" NDATA ogg>
  <!ENTITY broken "A &amp; B &lt; C">
]>
<media>
  <image src="cover" alt="&broken;"/>
  <track src="tune" kind="audio"/>
  <clip><![CDATA[raw ]]> ]]> content</clip>
</media>