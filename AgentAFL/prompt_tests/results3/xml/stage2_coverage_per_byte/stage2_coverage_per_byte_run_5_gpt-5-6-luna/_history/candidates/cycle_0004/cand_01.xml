<?xml version="1.0"?>
<!DOCTYPE report [
  <!ENTITY % common "<!ELEMENT report (section+)><!ATTLIST report version CDATA #IMPLIED>">
  %common;
  <!ENTITY % sectionDecl "<!ELEMENT section (heading, paragraph*)>
    <!ATTLIST section code ID #REQUIRED>">
  %sectionDecl;
  <!ELEMENT heading (#PCDATA)>
  <!ELEMENT paragraph (#PCDATA|link|break)*>
  <!ELEMENT link (#PCDATA)>
  <!ELEMENT break EMPTY>
  <!ATTLIST link target IDREF #IMPLIED>
  <!ENTITY intro "internal entity text">
]>
<report version="v2">
  <section code="s-one">
    <heading>Overview</heading>
    <paragraph>Start &intro;, then <link target="s-one">continue</link><break/></paragraph>
  </section>
  <section code="s-two">
    <heading>Details</heading>
    <paragraph>Trailing content</paragraph>
  </section>
</report>