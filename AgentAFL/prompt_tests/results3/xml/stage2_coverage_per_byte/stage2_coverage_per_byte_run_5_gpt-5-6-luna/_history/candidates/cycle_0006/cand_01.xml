<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE warehouse [
  <!ELEMENT warehouse (bin+, note?)>
  <!ELEMENT bin (item*, alias?)>
  <!ELEMENT item (name, quantity, tag*)>
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT quantity (#PCDATA)>
  <!ELEMENT tag EMPTY>
  <!ELEMENT alias (#PCDATA)>
  <!ELEMENT note (#PCDATA|br)*>
  <!ELEMENT br EMPTY>
  <!ATTLIST warehouse xmlns:x CDATA #FIXED "urn:warehouse">
  <!ATTLIST bin id ID #REQUIRED zone NMTOKEN #IMPLIED>
  <!ATTLIST item sku ID #REQUIRED state (new|used|held) #IMPLIED>
  <!ATTLIST tag key CDATA #REQUIRED value CDATA #IMPLIED>
]>
<warehouse xmlns:x="urn:warehouse" x:mode="scan">
  <bin id="b-1" zone="A_9">
    <item sku="sku1" state="new">
      <name>bolt</name><quantity>12</quantity>
      <tag key="color" value="red"/>
    </item>
    <alias>overflow &amp; returns</alias>
  </bin>
  <bin id="b-2">
    <item sku="sku2">
      <name><![CDATA[washer ]]> <![CDATA[<x>&y]]></name>
      <quantity>NaN</quantity>
      <tag key="x" value="&quot;&apos;"/>
    </item>
  </bin>
  <note>line one<br/>line two<br></note>
</warehouse>