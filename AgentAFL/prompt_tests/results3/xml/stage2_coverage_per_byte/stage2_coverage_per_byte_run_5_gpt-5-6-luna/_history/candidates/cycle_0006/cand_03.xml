<?xml version="1.0"?>
<!DOCTYPE graph [
  <!ELEMENT graph (node*, edge*)>
  <!ELEMENT node (label?, property*)>
  <!ELEMENT edge EMPTY>
  <!ELEMENT label (#PCDATA)>
  <!ELEMENT property (#PCDATA)>
  <!ATTLIST graph directed (yes|no) "yes">
  <!ATTLIST node id ID #REQUIRED type NMTOKEN #IMPLIED>
  <!ATTLIST edge from IDREF #REQUIRED to IDREF #REQUIRED weight CDATA "1">
  <!ATTLIST property name NMTOKEN #REQUIRED>
  <!ENTITY marker "&#x1F;not-a-valid-XML-character">
]>
<graph directed="maybe">
  <node id="n1" type="entry">
    <label>one</label>
    <property name="empty"></property>
    <property name="symbols">a &lt; b &amp;&amp; c &gt; d</property>
  </node>
  <node id="n2"><label><![CDATA[ two ]]>]]></label></node>
  <edge from="n1" to="n2" weight="+Inf"/>
  <edge from="n2" to="missing" weight="0x10"/>
  <node id="n3"><property name="marker">&marker;</property></node>
</graph>