<?xml version="1.0"?>
<!DOCTYPE media [
  <!NOTATION png SYSTEM "image/png">
  <!ENTITY logo SYSTEM "logo.png" NDATA png>
  <!ELEMENT media (asset*, caption?)>
  <!ELEMENT asset EMPTY>
  <!ELEMENT caption (#PCDATA)>
  <!ATTLIST asset name CDATA #REQUIRED kind NOTATION (png) #REQUIRED data ENTITY #IMPLIED>
]>
<media>
  <asset name="icon" kind="png" data="logo"/>
  <asset name="empty" kind="png"/>
  <caption>binary-like &#x0D; content &amp; symbols</caption>
</media>