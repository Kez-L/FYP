<?xml version="1.1"?>
<!DOCTYPE drawing [
  <!ENTITY % shapes "(line|circle|path|use)*">
  <!ELEMENT drawing %shapes;>
  <!ELEMENT line EMPTY>
  <!ELEMENT circle EMPTY>
  <!ELEMENT path (#PCDATA)>
  <!ELEMENT use EMPTY>
  <!ATTLIST drawing xmlns CDATA #IMPLIED viewBox CDATA #IMPLIED>
  <!ATTLIST line x1 CDATA #REQUIRED y1 CDATA #REQUIRED x2 CDATA #REQUIRED y2 CDATA #REQUIRED>
  <!ATTLIST circle cx CDATA #REQUIRED cy CDATA #REQUIRED r CDATA #REQUIRED>
  <!ATTLIST path d CDATA #REQUIRED>
  <!ATTLIST use href ENTITY #IMPLIED>
  <!ENTITY unit "12">
]>
<drawing xmlns="urn:vector:test" viewBox="0 0 100 80">
  <line x1="0" y1="0" x2="&unit;" y2="20"/>
  <circle cx="40" cy="30" r="&unit;"/>
  <path d="M0,0 C10,20 20,10 30,30">literal path text</path>
  <use href="shapeRef"/>
</drawing>