<!DOCTYPE inventory [
  <!ELEMENT inventory (warehouse+)>
  <!ELEMENT warehouse (bin*)>
  <!ELEMENT bin (product*)>
  <!ELEMENT product EMPTY>
  <!ATTLIST warehouse code ID #REQUIRED>
  <!ATTLIST bin number NMTOKEN #REQUIRED>
  <!ATTLIST product sku CDATA #REQUIRED quantity NMTOKEN "0" fragile (yes|no) "no">
  <!ENTITY euro "&#x20AC;">
  <!ENTITY note "stock &euro; count">
]>
<inventory>
  <warehouse code="north">
    <bin number="A-01">
      <product sku="X&amp;1" quantity="0007" fragile="yes"/>
      <product sku="empty" quantity="0"/>
    </bin>
    <bin number="B-02">
      <product sku="&note;" quantity="12"/>
    </bin>
  </warehouse>
</inventory>