<!DOCTYPE archive [
  <!ELEMENT archive (directory, manifest)>
  <!ELEMENT directory (folder+)>
  <!ELEMENT folder (folder|file)*>
  <!ELEMENT file EMPTY>
  <!ELEMENT manifest (entry*)>
  <!ELEMENT entry EMPTY>
  <!ATTLIST archive xmlns CDATA #IMPLIED created CDATA #IMPLIED>
  <!ATTLIST folder name CDATA #REQUIRED hidden (0|1) "0">
  <!ATTLIST file name CDATA #REQUIRED kind (text|binary|link) #IMPLIED>
  <!ATTLIST entry path CDATA #REQUIRED checksum CDATA #IMPLIED>
  <!NOTATION gif SYSTEM "image/gif">
  <!ENTITY icon SYSTEM "icon.gif" NDATA gif>
  <!ENTITY % declarations "<!ATTLIST file mode NMTOKENS #IMPLIED>">
  %declarations;
]>
<archive xmlns="urn:archive" created="2026-09-24T00:00:00Z">
  <directory>
    <folder name="." hidden="0">
      <file name="readme.txt" kind="text" mode="rw r"/>
      <folder name="assets">
        <file name="logo.gif" kind="binary"/>
        <file name="current" kind="link"/>
      </folder>
    </folder>
  </directory>
  <manifest>
    <entry path="./readme.txt" checksum="sha256:abc&amp;def"/>
    <entry path="./assets/logo.gif"/>
  </manifest>
</archive>