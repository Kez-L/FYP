<!DOCTYPE envelope [
  <!ELEMENT envelope (meta, body, trailer)>
  <!ELEMENT meta (stamp?, flag*)>
  <!ELEMENT stamp (#PCDATA)>
  <!ELEMENT flag EMPTY>
  <!ELEMENT body ANY>
  <!ELEMENT trailer (#PCDATA)>
  <!ATTLIST flag code CDATA #REQUIRED>
  <!ENTITY open "<chunk>">
  <!ENTITY close "</chunk>">
  <!ENTITY data "left &amp; right">
]>
<envelope>
  <meta>
    <stamp>2026-09-24T00:00:00Z</stamp>
    <flag code="A"/>
    <flag code="B&amp;C"/>
  </meta>
  <body>
    &open;
      &data;
      <![CDATA[ raw ]]> <nested level="2"/>
    &close;
  </body>
  <trailer>done</trailer>
</envelope>