<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE catalog [
  <!ENTITY % feature "INCLUDE">
  <![%feature;[
    <!ELEMENT catalog (entry+)>
    <!ELEMENT entry (name, meta?, description)>
    <!ELEMENT name (#PCDATA)>
    <!ELEMENT meta EMPTY>
    <!ELEMENT description (#PCDATA|em|br)*>
    <!ELEMENT em (#PCDATA)>
    <!ELEMENT br EMPTY>
    <!ATTLIST entry id ID #REQUIRED status (new|old) "new">
    <!ATTLIST meta source CDATA #IMPLIED>
  ]]>
  <!ENTITY copyright "&#xA9; 2026">
]>
<catalog>
  <entry id="e1">
    <name>alpha &amp; beta</name>
    <meta source="imported"/>
    <description>Text <em>with emphasis</em><br/>and a symbol: &copyright;</description>
  </entry>
  <entry id="e2" status="old">
    <name>delta</name>
    <description><![CDATA[raw ]]> brackets ]]></description>
  </entry>
</catalog>