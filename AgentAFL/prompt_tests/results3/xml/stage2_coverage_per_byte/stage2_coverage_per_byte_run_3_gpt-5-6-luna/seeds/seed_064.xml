<?xml version="1.0" standalone="yes"?>
<!DOCTYPE matrix [
  <!ELEMENT matrix (row+)>
  <!ELEMENT row (cell+)>
  <!ELEMENT cell (#PCDATA)>
  <!ATTLIST matrix size NMTOKENS #REQUIRED>
  <!ATTLIST row index NMTOKEN #REQUIRED checksum CDATA #IMPLIED>
  <!ATTLIST cell column NMTOKEN #REQUIRED type (text|number|empty) "text">
]>
<matrix size="3 2">
  <row index="0" checksum="a&amp;b">
    <cell column="0" type="text">north</cell>
    <cell column="1">east&#x0A;west</cell>
  </row>
  <row index="1">
    <cell column="0" type="number">-17.50</cell>
    <cell column="1" type="empty"></cell>
  </row>
  <row index="2">
    <cell column="0"><![CDATA[x]]></cell>
    <cell column="1">tail</cell>
  </row>
</matrix>