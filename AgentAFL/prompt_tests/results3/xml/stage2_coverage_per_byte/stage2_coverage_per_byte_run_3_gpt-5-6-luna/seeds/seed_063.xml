<?xml version="1.0"?>
<!DOCTYPE records [
  <!ELEMENT records (record*)>
  <!ELEMENT record (key, value, audit?)>
  <!ELEMENT key (#PCDATA)>
  <!ELEMENT value (#PCDATA|line)*>
  <!ELEMENT line (#PCDATA)>
  <!ELEMENT audit (actor, stamp)>
  <!ELEMENT actor (#PCDATA)>
  <!ELEMENT stamp (#PCDATA)>
  <!ATTLIST record ident ID #IMPLIED kind (alpha|numeric|mixed) #REQUIRED>
  <!ATTLIST value format CDATA "plain">
  <!ENTITY qmark "&#x3F;">
  <!ENTITY nested "A &qmark; B">
]>
<records>
  <record ident="r01" kind="mixed">
    <key>name</key>
    <value format="rich">first<line/>second &nested;</value>
    <audit><actor>system</actor><stamp>2026-09-24</stamp></audit>
  </record>
  <record kind="numeric">
    <key>count</key>
    <value format="plain"><![CDATA[001
002
003]]></value>
  </record>
</records>