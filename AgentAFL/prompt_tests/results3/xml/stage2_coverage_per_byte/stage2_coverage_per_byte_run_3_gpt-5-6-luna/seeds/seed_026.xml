<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE dossier [
  <!ELEMENT dossier (header, payload, trail?)>
  <!ELEMENT header (title, tag*)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT tag EMPTY>
  <!ELEMENT payload (#PCDATA|left|right|mark)*>
  <!ELEMENT left (#PCDATA|mark)*>
  <!ELEMENT right (#PCDATA|mark)*>
  <!ELEMENT mark (#PCDATA)>
  <!ELEMENT trail (#PCDATA)>
  <!ATTLIST header generated CDATA #IMPLIED>
  <!ATTLIST tag key NMTOKEN #REQUIRED value CDATA #IMPLIED>
  <!ENTITY quote "&#34;">
  <!ENTITY pair "<left>L&quote;</left><right>R</right>">
  <!ENTITY % payloadattrs ' mode (plain|rich) "rich"'>
  <!ATTLIST payload %payloadattrs;>
  <!ENTITY % optional 'INCLUDE'>
  <![%optional;[
    <!ENTITY marker "&#x2026;">
  ]]>
]>
<?dossier phase="ingest"?>
<dossier>
  <header generated="yes">
    <title>R&amp;D &quot;intake&quot;</title>
    <tag key="alpha" value="one"/>
    <tag key="beta"/>
  </header>
  <payload mode="rich">start &pair; middle <mark>&marker;</mark><![CDATA[<raw/>]]> end</payload>
  <trail><!-- retained -->final</trail>
</dossier>