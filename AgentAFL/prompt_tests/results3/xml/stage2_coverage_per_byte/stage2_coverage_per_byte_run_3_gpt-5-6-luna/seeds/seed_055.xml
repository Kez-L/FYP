<?xml version="1.0"?>
<!DOCTYPE catalog [
  <!NOTATION jpeg SYSTEM "image/jpeg">
  <!ENTITY cover SYSTEM "cover.jpg" NDATA jpeg>
  <!ENTITY writer "Ada &amp; Lovelace">
  <!ELEMENT catalog (entry+, note?)>
  <!ELEMENT entry (title, author, summary)>
  <!ATTLIST entry id ID #REQUIRED cover ENTITY #IMPLIED xml:space (default|preserve) "default">
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT author (#PCDATA)>
  <!ELEMENT summary (#PCDATA|emph|br)*>
  <!ELEMENT emph (#PCDATA)>
  <!ELEMENT br EMPTY>
  <!ELEMENT note (#PCDATA)>
]>
<catalog>
  <entry id="e1" cover="cover" xml:space="preserve">
    <title>Algorithms</title>
    <author>&writer;</author>
    <summary>Foundations <emph>and</emph> <br/> machines</summary>
  </entry>
  <note><![CDATA[unparsed text <with> delimiters]]></note>
</catalog>