<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE stream [
  <!ELEMENT stream (open, record*, close)>
  <!ELEMENT open EMPTY>
  <!ATTLIST open version NMTOKEN #REQUIRED session CDATA #IMPLIED>
  <!ELEMENT record (timestamp, actor, action, detail?)>
  <!ATTLIST record level (debug|info|warn|error) "info">
  <!ELEMENT timestamp (#PCDATA)>
  <!ELEMENT actor (#PCDATA)>
  <!ELEMENT action (#PCDATA)>
  <!ELEMENT detail (#PCDATA|code|linebreak)*>
  <!ELEMENT code (#PCDATA)>
  <!ELEMENT linebreak EMPTY>
  <!ELEMENT close EMPTY>
  <!ATTLIST close status (ok|failed) #REQUIRED>
  <!ENTITY apos "&#39;">
  <!ENTITY % extra SYSTEM "missing-subset.ent">
  %extra;
]>
