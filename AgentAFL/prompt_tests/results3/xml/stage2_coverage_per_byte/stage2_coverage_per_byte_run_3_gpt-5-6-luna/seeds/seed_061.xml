<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE envelope [
  <!ELEMENT envelope (header, sections)>
  <!ELEMENT header EMPTY>
  <!ELEMENT sections (section*)>
  <!ELEMENT section (name, item*)>
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT item (#PCDATA|br|mark)*>
  <!ELEMENT br EMPTY>
  <!ELEMENT mark (#PCDATA)>
  <!ATTLIST envelope xmlns CDATA #IMPLIED>
  <!ATTLIST section key ID #REQUIRED>
  <!ATTLIST item ref IDREFS #IMPLIED>
]>
<envelope xmlns="urn:outer">
  <header xmlns="" xml:lang="fr" xml:space="preserve"/>
  <sections>
    <section key="s-a" xmlns:x="urn:x">
      <name x:label="α">Résumé</name>
      <item ref="s-a">avant<br/>milieu<mark>après</mark></item>
    </section>
    <section key="s-b" xmlns:x="">
      <name>Plain</name>
      <item ref="s-a s-b">x</item>
    </section>
  </sections>
</envelope>