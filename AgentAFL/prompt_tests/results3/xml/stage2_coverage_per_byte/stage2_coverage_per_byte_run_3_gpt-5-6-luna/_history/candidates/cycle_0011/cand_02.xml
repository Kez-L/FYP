<!DOCTYPE report [
  <!ELEMENT report (section*)>
  <!ELEMENT section (message|section)*>
  <!ELEMENT message (#PCDATA)>
  <!ATTLIST section level NMTOKEN "root">
  <!ENTITY first "one">
  <!ENTITY second "&first;:two">
  <!ENTITY quoted "a&quot;b&apos;c">
]>
<report>
  <section level="1">
    <message>&second;</message>
    <section level="1.1">
      <message><![CDATA[<not-an-element>&still-text;]]></message>
      <message>&quoted;</message>
    </section>
  </section>
  <section level="2"><message>tail &amp; end</message></section>
</report>