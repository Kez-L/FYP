<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE graph [
  <!ELEMENT graph (node|edge|meta)*>
  <!ELEMENT node EMPTY>
  <!ELEMENT edge EMPTY>
  <!ELEMENT meta (#PCDATA)>
  <!ATTLIST graph xmlns:g CDATA #FIXED "urn:graph:test" version CDATA "1">
  <!ATTLIST node id ID #REQUIRED label CDATA #IMPLIED>
  <!ATTLIST edge from IDREF #REQUIRED to IDREF #REQUIRED kind (directed|weak|loop) "directed">
  <!ENTITY % optional "<!ELEMENT annotation (#PCDATA)>">
  %optional;
]>
<g:graph xmlns:g="urn:graph:test" version="v&amp;2">
  <g:meta>nodes &lt; edges</g:meta>
  <g:node id="n0" label="root"/>
  <g:node id="n1" label="left &quot;branch&quot;"/>
  <g:node id="n2"/>
  <g:edge from="n0" to="n1"/>
  <g:edge from="n1" to="n2" kind="weak"/>
  <g:edge from="n2" to="n2" kind="loop"/>
</g:graph>