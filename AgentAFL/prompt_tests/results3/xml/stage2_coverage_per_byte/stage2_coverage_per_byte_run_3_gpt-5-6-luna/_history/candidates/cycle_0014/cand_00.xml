<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE catalog [
  <!ELEMENT catalog (header, item+, footer?)>
  <!ELEMENT header (#PCDATA)>
  <!ELEMENT item (name, price, note*)>
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT price (#PCDATA)>
  <!ELEMENT note (#PCDATA|emph|ref)*>
  <!ELEMENT emph (#PCDATA)>
  <!ELEMENT ref EMPTY>
  <!ATTLIST item id ID #REQUIRED state (new|used|hold) "new">
  <!ATTLIST ref target IDREF #IMPLIED>
  <!ENTITY euro "&#x20AC;">
  <!ENTITY mark "<emph>special</emph>">
]>
<catalog>
  <header xml:lang="fr">Résumé &euro;</header>
  <item id="i17" state="used">
    <name>Étagère</name>
    <price>19.95</price>
    <note>small <emph>wooden</emph> shelf <ref target="i17"/></note>
    <note><![CDATA[raw ]]> text</note>
  </item>
  <item id="i18"><name>Box</name><price>&mark;</price></item>
  <footer>fin</footer>
</catalog>