<!DOCTYPE stream [
  <!ELEMENT stream (record*)>
  <!ELEMENT record (key, value)>
  <!ELEMENT key (#PCDATA)>
  <!ELEMENT value (#PCDATA|part)*>
  <!ELEMENT part (#PCDATA)>
  <!ATTLIST record seq CDATA #IMPLIED>
  <!ENTITY e1 "one">
  <!ENTITY e2 "&e1;-two">
]>
<stream>
  <record seq="1">
    <key>first</key>
    <value>&e2;<part><![CDATA[three]]></part>tail</value>
  </record>
  <record seq="2">
    <key>second</key>
    <value><part>nested-ish</part>&#x41;&#65;&#13;&#10;</value>
  </record>
</stream>