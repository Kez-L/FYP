<?xml version="1.1" standalone="yes"?>
<!DOCTYPE stream [
  <!ELEMENT stream (chunk*)>
  <!ELEMENT chunk (#PCDATA|meta|escape)*>
  <!ELEMENT meta EMPTY>
  <!ELEMENT escape (#PCDATA)>
  <!ATTLIST stream mode (raw|encoded) "raw">
  <!ATTLIST chunk index CDATA #REQUIRED checksum CDATA #IMPLIED>
  <!ATTLIST meta key CDATA #REQUIRED value CDATA #REQUIRED>
  <!ENTITY left "(">
  <!ENTITY right ")">
]>
<stream mode="encoded">
  <chunk index="0" checksum="00">
    <meta key="codec" value="utf-8"/>
    <![CDATA[abc<def]]>
    <escape>&lt;![CDATA[&gt;</escape>
  </chunk>
  <chunk index="1">
    data &left;inside&right; &amp; tail
  </chunk>
</stream>