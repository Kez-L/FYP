<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE map [
  <!ELEMENT map (item*)>
  <!ELEMENT item (key, value)>
  <!ELEMENT key (#PCDATA)>
  <!ELEMENT value (#PCDATA|item)*>
  <!ATTLIST item id ID #IMPLIED parent IDREF #IMPLIED>
]>
<map>
  <item id="root">
    <key>outer</key>
    <value>
      <item id="child" parent="root">
        <key>inner</key>
        <value>text &amp; <![CDATA[raw <markup>]]></value>
      </item>
    </value>
  </item>
  <item parent="child"><key>tail</key><value/></item>
</map>