<?xml version="1.0"?>
<!DOCTYPE labyrinth [
  <!ENTITY left "<node side='L'>&amp;left;</node>">
  <!ENTITY right "<node side='R'>&amp;right;</node>">
  <!ENTITY pair "&left;&right;">
  <!ELEMENT labyrinth (branch|leaf)*>
  <!ELEMENT branch (branch|leaf|#PCDATA)*>
  <!ELEMENT leaf (#PCDATA)>
  <!ATTLIST branch depth CDATA #IMPLIED>
  <!ATTLIST leaf code CDATA #REQUIRED>
]>
<labyrinth>
  <branch depth="0">
    <leaf code="a">start</leaf>
    <branch depth="1"><leaf code="b"><![CDATA[mid]]></leaf></branch>
  </branch>
  &pair;
</labyrinth>