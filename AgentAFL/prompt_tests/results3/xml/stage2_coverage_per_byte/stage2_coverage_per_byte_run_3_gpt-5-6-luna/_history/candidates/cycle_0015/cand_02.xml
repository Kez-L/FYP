<?xml version="1.0"?>
<!DOCTYPE message [
  <!ENTITY % declarations SYSTEM "urn:unavailable:message-entities">
  %declarations;
  <!ELEMENT message (header, body, footer?)>
  <!ELEMENT header (sender, recipient, subject)>
  <!ELEMENT sender (#PCDATA)>
  <!ELEMENT recipient (#PCDATA)>
  <!ELEMENT subject (#PCDATA)>
  <!ELEMENT body (#PCDATA|line|link)*>
  <!ELEMENT line (#PCDATA)>
  <!ELEMENT link (#PCDATA)>
  <!ELEMENT footer (#PCDATA)>
  <!ATTLIST message version CDATA "1.0">
  <!ATTLIST link href URI #REQUIRED>
]>
<message version="2.0">
  <header>
    <sender>alice@example.invalid</sender>
    <recipient>bob@example.invalid</recipient>
    <subject>Update &amp; status</subject>
  </header>
  <body>
    First line.
    <line>Second line with &lt;markup&gt;.</line>
    <link href="mailto:test@example.invalid">contact</link>
  </body>
  <footer>End</footer>
</message>