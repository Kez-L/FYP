<?xml version="1.0"?>
<!DOCTYPE labyrinth [
  <!ELEMENT labyrinth (gate, corridor*)>
  <!ELEMENT gate EMPTY>
  <!ELEMENT corridor (turn|wall|exit)*>
  <!ELEMENT turn (#PCDATA)>
  <!ELEMENT wall (#PCDATA)>
  <!ELEMENT exit EMPTY>
  <!ATTLIST labyrinth route ID #IMPLIED>
  <!ATTLIST gate open (true|false) "false" key IDREF #IMPLIED>
  <!ATTLIST corridor number NMTOKEN #REQUIRED>
  <!ATTLIST turn dir (N|E|S|W) #REQUIRED>
  <!ENTITY % hidden 'IGNORE'>
  <![%hidden;[
    <!ELEMENT secret (#PCDATA)>
    <!ENTITY forbidden "should-not-expand">
  ]]>
  <!ENTITY edge "left&amp;right">
]>
<labyrinth route="r9">
  <gate open="true" key="r9"/>
  <corridor number="01">
    <turn dir="N">forward &edge;</turn>
    <wall><![CDATA[ ]]]]><![CDATA[> tricky boundary ]]></wall>
    <turn dir="E">right</turn>
    <exit/>
  </corridor>
  <corridor number="02"><turn dir="S">down</turn><!-- unclosed-looking text --></corridor>
</labyrinth>