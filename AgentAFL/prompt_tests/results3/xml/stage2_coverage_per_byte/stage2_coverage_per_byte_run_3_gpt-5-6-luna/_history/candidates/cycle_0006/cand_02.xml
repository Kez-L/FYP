<?xml version="1.1" standalone="yes"?>
<!DOCTYPE signal [
  <!ELEMENT signal (channel+, checksum?)>
  <!ELEMENT channel (name, sample*)>
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT sample (#PCDATA)>
  <!ELEMENT checksum EMPTY>
  <!ATTLIST signal level (low|medium|high) "medium" xml:lang NMTOKEN #IMPLIED>
  <!ATTLIST channel id ID #REQUIRED links IDREFS #IMPLIED>
  <!ATTLIST sample units NMTOKEN #IMPLIED>
  <!NOTATION bin SYSTEM "application/octet-stream">
  <!ENTITY blob SYSTEM "capture.bin" NDATA bin>
  <!ENTITY lf "&#xA;">
  <!ENTITY control "&#x1F;">
]>
