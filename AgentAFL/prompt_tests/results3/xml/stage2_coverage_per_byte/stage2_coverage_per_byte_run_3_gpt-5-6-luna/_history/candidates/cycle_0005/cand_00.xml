<?xml version="1.0"?>
<!DOCTYPE invoice [
  <!ELEMENT invoice (header, items, total)>
  <!ELEMENT header (issuer, recipient, issued)>
  <!ELEMENT issuer (#PCDATA)>
  <!ELEMENT recipient (#PCDATA)>
  <!ELEMENT issued (#PCDATA)>
  <!ELEMENT items (item+)>
  <!ELEMENT item (sku, label, quantity, price, discount?)>
  <!ELEMENT sku (#PCDATA)>
  <!ELEMENT label (#PCDATA)>
  <!ELEMENT quantity (#PCDATA)>
  <!ELEMENT price (#PCDATA)>
  <!ELEMENT discount (#PCDATA)>
  <!ELEMENT total (#PCDATA)>
  <!ATTLIST invoice currency (USD|EUR|JPY) "USD" xml:lang CDATA #IMPLIED>
  <!ATTLIST item index NMTOKEN #REQUIRED taxable (yes|no) "yes">
  <!ENTITY currency "&#x20AC;">
]>
<invoice currency="EUR" xml:lang="fr">
  <header>
    <issuer>Atelier &amp; Fils</issuer>
    <recipient><![CDATA[North <West> Trading]]></recipient>
    <issued>2026-09-24</issued>
  </header>
  <items>
    <item index="A-01">
      <sku>Q&amp;7</sku>
      <label>Glass &currency; mug</label>
      <quantity>2</quantity>
      <price>19.95</price>
      <discount><![CDATA[5%]]></discount>
    </item>
    <item index="A-02" taxable="no">
      <sku>R-99</sku>
      <label>Replacement lid</label>
      <quantity>1</quantity>
      <price>4.00</price>
    </item>
  </items>
  <total>43.90</total>
</invoice>