<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE package [
  <!NOTATION gif SYSTEM "image/gif">
  <!ENTITY logo SYSTEM "logo.gif" NDATA gif>
  <!ENTITY quote "He said &quot;go&quot; &amp; left">
  <!ELEMENT package (manifest, payload)>
  <!ELEMENT manifest (entry*)>
  <!ELEMENT entry EMPTY>
  <!ELEMENT payload (#PCDATA|chunk)*>
  <!ELEMENT chunk (#PCDATA)>
  <!ATTLIST package logo ENTITY #IMPLIED>
  <!ATTLIST entry name NMTOKEN #REQUIRED type CDATA "binary">
]>
<package logo="logo">
  <manifest>
    <entry name="one" type="text"/>
    <entry name="two"/>
  </manifest>
  <payload>start &quote;<chunk>middle</chunk>end</payload>
</package>