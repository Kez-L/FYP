<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE map [
  <!ELEMENT map (region+)>
  <!ELEMENT region (point|label|region)*>
  <!ELEMENT point EMPTY>
  <!ELEMENT label (#PCDATA)>
  <!ATTLIST map projection CDATA #IMPLIED>
  <!ATTLIST region name CDATA #REQUIRED bounds NMTOKENS #IMPLIED>
  <!ATTLIST point x CDATA #REQUIRED y CDATA #REQUIRED kind (start|end|waypoint) "waypoint">
]>
<map projection="local">
  <region name="outer" bounds="0 0 100 100">
    <label>north &amp; east</label>
    <point x="10" y="20" kind="start"/>
    <region name="inner" bounds="4 8 16 32">
      <point x="7" y="11"/>
      <label><![CDATA[embedded <markup> and ]]> brackets]]></label>
    </region>
  </region>
</map>