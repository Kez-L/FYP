<?xml version="1.0"?>
<!DOCTYPE report [
  <!ELEMENT report (section|section-ref)*>
  <!ELEMENT section (heading, paragraph+)>
  <!ELEMENT section-ref EMPTY>
  <!ELEMENT heading (#PCDATA)>
  <!ELEMENT paragraph (#PCDATA|link|code)*>
  <!ELEMENT link (#PCDATA)>
  <!ELEMENT code (#PCDATA)>
  <!ATTLIST section key NMTOKEN #REQUIRED>
  <!ATTLIST section-ref target IDREF #REQUIRED>
  <!ATTLIST link href CDATA #IMPLIED>
  <!ATTLIST code xml:space (default|preserve) "preserve">
]>
<report>
  <section key="intro">
    <heading>Overview</heading>
    <paragraph>Use <code>&lt;report&gt;</code> with <link href="urn:x">care</link>.</paragraph>
  </section>
  <section-ref target="missing"/>
</report>