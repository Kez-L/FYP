<?xml version="1.0"?>
<!DOCTYPE geometry [
  <!NOTATION svg SYSTEM "image/svg+xml">
  <!ENTITY drawing SYSTEM "shape.svg" NDATA svg>
  <!ELEMENT geometry (point*, polygon?, external?)>
  <!ELEMENT point EMPTY>
  <!ELEMENT polygon (point+)>
  <!ELEMENT external EMPTY>
  <!ATTLIST point x CDATA #REQUIRED y CDATA #REQUIRED label CDATA #IMPLIED>
  <!ATTLIST polygon closed (true|false) "true">
  <!ATTLIST external src ENTITY #REQUIRED>
]>
<geometry>
  <point x="0" y="0" label="origin"/>
  <point x="1e309" y="-0"/>
  <polygon closed="false">
    <point x="10" y="20"/>
    <point x="30" y="40" label="p&amp;q"/>
  </polygon>
  <external src="drawing"/>
</geometry>