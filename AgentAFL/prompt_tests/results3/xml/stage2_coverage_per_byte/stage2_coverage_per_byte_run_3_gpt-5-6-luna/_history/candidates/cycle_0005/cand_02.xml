<?xml version="1.0"?>
<!DOCTYPE report [
  <!ELEMENT report (section+)>
  <!ELEMENT section (heading, body, section*)>
  <!ELEMENT heading (#PCDATA)>
  <!ELEMENT body (#PCDATA|b|i|br|q|span)*>
  <!ELEMENT b (#PCDATA|i|span)*>
  <!ELEMENT i (#PCDATA|b|span)*>
  <!ELEMENT br EMPTY>
  <!ELEMENT q (#PCDATA|b|i|span)*>
  <!ELEMENT span (#PCDATA|b|i|span)*>
  <!ATTLIST section number CDATA #IMPLIED>
  <!ATTLIST span class CDATA #IMPLIED data CDATA #IMPLIED>
  <!ENTITY leftbracket "&#91;">
  <![INCLUDE[
    <!ENTITY rightbracket "&#93;">
  ]]>
]>
<report>
  <section number="1">
    <heading>Parsing notes</heading>
    <body>Text <b>bold <i>nested</i></b><br/><q>quoted &leftbracket;value&rightbracket;</q></body>
    <section number="1.1">
      <heading>Details</heading>
      <body><span class="code" data="a&amp;b">&lt;tag attr="x"/&gt;</span></body>
    </section>
  </section>
  <section number="2">
    <heading><![CDATA[Raw ]]> content</heading>
    <body>tail<!-- comment with -- separators? --></body>
  </section>
</report>