<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE catalog [
  <!ELEMENT catalog (entry+, note?)>
  <!ELEMENT entry (title, description, link)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT description (#PCDATA|emph|code)*>
  <!ELEMENT emph (#PCDATA)>
  <!ELEMENT code (#PCDATA)>
  <!ELEMENT link EMPTY>
  <!ELEMENT note (#PCDATA)>
  <!ATTLIST entry id ID #REQUIRED status (new|old|archived) "new">
  <!ATTLIST link href URI #REQUIRED rel NMTOKEN "related">
  <!ATTLIST note kind CDATA #IMPLIED xml:lang CDATA #IMPLIED>
  <!NOTATION png SYSTEM "image/png">
  <!ENTITY logo SYSTEM "logo.png" NDATA png>
  <!ENTITY nbsp "&#160;">
  <!ENTITY % shared "xml:lang CDATA #IMPLIED">
  <!ATTLIST description %shared;>
]>
<catalog>
  <entry id="e1">
    <title>Notation sample</title>
    <description>A <emph>small</emph> <code>catalog</code>&nbsp;entry.</description>
    <link href="urn:item:one" rel="primary"/>
  </entry>
  <entry id="e2" status="old">
    <title>Second item</title>
    <description>Text with &amp; escaped markup.</description>
    <link href="https://example.invalid/item/2"/>
  </entry>
  <note xml:lang="fr" kind="footer">Fin de la liste.</note>
</catalog>