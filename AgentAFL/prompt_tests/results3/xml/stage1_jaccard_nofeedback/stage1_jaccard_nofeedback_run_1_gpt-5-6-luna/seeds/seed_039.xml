<?xml version="1.0"?>
<!DOCTYPE matrix [
  <!ELEMENT matrix (row+)>
  <!ELEMENT row (cell*)>
  <!ELEMENT cell (#PCDATA)>
  <!ATTLIST row index CDATA #IMPLIED>
  <!ATTLIST cell r CDATA #IMPLIED c CDATA #IMPLIED>
]>
<matrix>
  <row index="0">
    <cell r="0" c="0">zero</cell>
    <cell r="0" c="1">one &amp; two</cell>
  </row>
  <row index="1">
    <cell r="1" c="0"><![CDATA[<x/>]]></cell>
    <cell r="1" c="1">text<!-- split -->continued</cell>
    <cell r="1" c="2"><?cell data?><![CDATA[&]]></cell>
  </row>
  <row index="2"/>
</matrix>