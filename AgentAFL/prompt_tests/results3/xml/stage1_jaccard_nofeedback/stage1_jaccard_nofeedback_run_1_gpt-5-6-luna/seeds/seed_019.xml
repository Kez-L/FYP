<!DOCTYPE report [
  <!ENTITY % common "<!ELEMENT metadata (author?, tag*)><!ELEMENT author (#PCDATA)><!ELEMENT tag (#PCDATA)>">
  %common;
  <!ELEMENT report (metadata, records)>
  <!ELEMENT records (record*)>
  <!ELEMENT record (key, value, value?)>
  <!ATTLIST record kind CDATA "normal">
  <!ELEMENT key (#PCDATA)>
  <!ELEMENT value (#PCDATA)>
]>
<report>
  <metadata>
    <author>anonymous</author>
    <tag>one</tag>
    <tag><![CDATA[two & three]]></tag>
  </metadata>
  <records>
    <record kind="special">
      <key>empty-value</key>
      <value/>
    </record>
    <record>
      <key>mixed</key>
      <value>left<inner xmlns="urn:x">inside</inner>right</value>
      <value>second</value>
    </record>
  </records>
</report>