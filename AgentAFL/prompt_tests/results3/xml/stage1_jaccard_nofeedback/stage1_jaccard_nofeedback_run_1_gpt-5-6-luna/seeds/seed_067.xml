<?xml version="1.0"?>
<!DOCTYPE envelope [
  <!NOTATION bin SYSTEM "application/octet-stream">
  <!ELEMENT envelope (payload)>
  <!ELEMENT payload EMPTY>
  <!ATTLIST payload
    src ENTITY #IMPLIED
    format NOTATION (bin) #IMPLIED>
  <!ENTITY blob SYSTEM "data:application/octet-stream;base64,AAEC">
]>
<envelope>
  <payload src="blob" format="bin"/>
</envelope>