<?xml version="1.0"?>
<!DOCTYPE graph [
  <!ELEMENT graph (node+)>
  <!ELEMENT node (label?, edge*)>
  <!ATTLIST node id ID #REQUIRED kind (root|leaf|cycle) "leaf">
  <!ELEMENT label (#PCDATA)>
  <!ELEMENT edge EMPTY>
  <!ATTLIST edge to IDREF #IMPLIED weight CDATA "1">
]>
<graph>
  <node id="n0" kind="root">
    <label>origin</label>
    <edge to="n1" weight="0"/>
    <edge to="n2" weight="-999999999999999999999"/>
  </node>
  <node id="n1">
    <edge to="n0"/>
  </node>
  <node id="n2" kind="cycle">
    <label><![CDATA[]]></label>
    <edge to="n2" weight="NaN"/>
  </node>
</graph>