<!DOCTYPE report [
  <!ELEMENT report (section+, footer?)>
  <!ELEMENT section (heading, item*)>
  <!ELEMENT heading (#PCDATA)>
  <!ELEMENT item (#PCDATA|note)*>
  <!ELEMENT note (#PCDATA)>
  <!ELEMENT footer (#PCDATA)>
  <!ATTLIST section name ID #REQUIRED>
  <!ENTITY warning "use &lt;carefully&gt; &amp; verify">
]>
<report>
  <section name="s1">
    <heading>First &warning;</heading>
    <item>alpha<note>embedded</note>omega</item>
    <item><![CDATA[raw ]]> text &warning;</item>
  </section>
  <section name="s2">
    <heading>Second</heading>
  </section>
  <footer>done</footer>
</report>