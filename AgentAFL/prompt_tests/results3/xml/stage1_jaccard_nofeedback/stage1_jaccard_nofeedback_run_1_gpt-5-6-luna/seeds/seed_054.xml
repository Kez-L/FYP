<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!DOCTYPE universe [
  <!ELEMENT universe (cluster)>
  <!ELEMENT cluster (node)>
  <!ELEMENT node (label, link*, payload?)>
  <!ELEMENT label (#PCDATA)>
  <!ELEMENT link EMPTY>
  <!ELEMENT payload (#PCDATA)>
  <!ATTLIST cluster name CDATA #REQUIRED>
  <!ATTLIST node state CDATA "idle">
  <!ATTLIST link target IDREF #IMPLIED weight CDATA #IMPLIED>
  <!ENTITY amp "&amp;">
  <!ENTITY quote "&quot;">
  <!ENTITY hex "&#x41;&#x42;&#x43;">
]>
<universe>
  <cluster name="outer">
    <node state="active">
      <label>Node &quote;A&quote; &amp; &hex;</label>
      <link target="n2" weight="0.000"/>
      <link target="missing" weight="-1"/>
      <payload>before &amp; after <![CDATA[<payload/>]]> end</payload>
    </node>
  </cluster>
</universe>