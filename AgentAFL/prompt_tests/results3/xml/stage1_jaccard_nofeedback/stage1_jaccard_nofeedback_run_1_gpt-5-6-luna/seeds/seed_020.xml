<?xml version="1.0"?>
<!DOCTYPE catalog [
  <!ELEMENT catalog (entry+)>
  <!ELEMENT entry (title, details?, item*)>
  <!ATTLIST entry id ID #REQUIRED status (new|old|archived) "new">
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT details (#PCDATA|em|br)*>
  <!ELEMENT em (#PCDATA)>
  <!ELEMENT br EMPTY>
  <!ELEMENT item EMPTY>
  <!ATTLIST item key CDATA #IMPLIED value CDATA #IMPLIED>
]>
<catalog>
  <entry id="e1" status="archived">
    <title>Alpha &amp; Omega</title>
    <details>before <em>inside</em><br/>after</details>
    <item key="x" value="1"/>
    <item key="y" value="&quot;two&quot;"/>
  </entry>
  <entry id="e2">
    <title><![CDATA[<not-an-element> & raw text]]></title>
    <item key="empty" value=""/>
  </entry>
</catalog>