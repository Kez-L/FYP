<?xml version="1.0"?>
<!DOCTYPE inventory [
  <!ELEMENT inventory (product+)>
  <!ELEMENT product (name, details?, price)>
  <!ATTLIST product sku ID #REQUIRED status (new|used|retired) "new">
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT details (#PCDATA|note)*>
  <!ELEMENT note (#PCDATA)>
  <!ELEMENT price (#PCDATA)>
  <!ENTITY currency "€">
]>
<inventory>
  <product sku="p001" status="used">
    <name>Widget</name>
    <details>Refurbished <note>includes &currency; tax</note> unit.</details>
    <price>19.95 &currency;</price>
  </product>
</inventory>