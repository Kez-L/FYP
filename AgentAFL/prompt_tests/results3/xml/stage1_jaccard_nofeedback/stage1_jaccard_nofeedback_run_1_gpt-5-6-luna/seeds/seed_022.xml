    <heading>Entities &nbsp; &left;tag&right;</heading>
    <paragraph>one <code>i &lt; j</code> and <link href="urn:x">two</link>.</paragraph>
  </section>
  <section>
    <heading/>
    <paragraph><![CDATA[line one
line two
]]></paragraph>
  </section>
</report>