<!DOCTYPE report [
  <!ELEMENT report (section*)>
  <!ELEMENT section (heading, paragraph*)>
  <!ATTLIST section name CDATA #IMPLIED>
  <!ELEMENT heading (#PCDATA)>
  <!ELEMENT paragraph (#PCDATA|code|link)*>
  <!ELEMENT code (#PCDATA)>
  <!ELEMENT link (#PCDATA)>
  <!ATTLIST link href URI #REQUIRED>
  <!ENTITY nbsp "&#160;">
  <!ENTITY left "<">
  <!ENTITY right ">">
]>
