<!DOCTYPE records [
  <!ELEMENT records (record*)>
  <!ELEMENT record (key, value, value?)>
  <!ELEMENT key (#PCDATA)>
  <!ELEMENT value (#PCDATA|note)*>
  <!ELEMENT note (#PCDATA)>
  <!ATTLIST record state (new|old|unknown) "unknown">
  <!ENTITY left "&#x3C;">
  <!ENTITY right "&#x3E;">
]>
<records>
  <record state="new">
    <key>alpha</key>
    <value>&left;escaped&right;<note>nested</note></value>
    <value>second</value>
  </record>
</records>