<?xml version="1.1"?>
<!DOCTYPE report [
  <!ELEMENT report (header,section+)>
  <!ELEMENT header (#PCDATA)>
  <!ELEMENT section (item*)>
  <!ELEMENT item (#PCDATA)>
  <!ATTLIST item
    code NMTOKEN #REQUIRED
    level (low|mid|high) "mid">
  <!ENTITY quote "A &quot;quoted&quot; value">
]>
<report>
  <header>&quote;</header>
  <section>
    <item code="a1" level="high">alpha</item>
    <item code="b2">beta &amp; gamma</item>
  </section>
</report>