<?xml version="1.1"?>
<!DOCTYPE report [
  <!ELEMENT report (header, section+, footer?)>
  <!ELEMENT header (#PCDATA)>
  <!ELEMENT section (title, paragraph*, list?)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT paragraph (#PCDATA|em|strong)*>
  <!ELEMENT em (#PCDATA)>
  <!ELEMENT strong (#PCDATA)>
  <!ELEMENT list (item+)>
  <!ELEMENT item (#PCDATA)>
  <!ELEMENT footer (#PCDATA)>
  <!ATTLIST section level NMTOKEN #IMPLIED>
  <!ENTITY copyright "&#169; 2026">
]>
<report>
  <header>Quarterly &copyright; report</header>
  <section level="1">
    <title>Overview</title>
    <paragraph>Plain <em>emphasized</em> and <strong>strong</strong> text.</paragraph>
    <paragraph><![CDATA[Text containing ]]> and markup-like fragments: <not-an-element>.</paragraph>
    <list>
      <item>first</item>
      <item>second &amp; final</item>
    </list>
  </section>
  <section level="2">
    <title>Empty section</title>
  </section>
  <footer>End</footer>
</report>