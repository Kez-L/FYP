<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE library [
  <!ELEMENT library (section+)>
  <!ELEMENT section (name, book+)>
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT book (title, author, summary?, code)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT author (#PCDATA)>
  <!ELEMENT summary (#PCDATA)>
  <!ELEMENT code (#PCDATA)>
  <!ATTLIST section id ID #REQUIRED>
  <!ATTLIST book isbn CDATA #IMPLIED available (yes|no) "yes">
  <!ENTITY mark "&#x2605;">
]>
<library xmlns="urn:example:library" xmlns:meta="urn:example:metadata">
  <section id="fiction">
    <name>Fiction &amp; Tales</name>
    <book isbn="978-0000000001" available="yes">
      <title>Glass &amp; &quot;Echoes&quot;</title>
      <author>R. Example</author>
      <summary><![CDATA[An unusual <story> with embedded markup-like text.]]></summary>
      <code>LIB-&mark;-001</code>
    </book>
    <book available="no">
      <title>Untitled</title>
      <author xml:lang="fr">Émile Test</author>
      <code><![CDATA[if (x < 2 && y > 1) return;]]></code>
    </book>
  </section>
</library>