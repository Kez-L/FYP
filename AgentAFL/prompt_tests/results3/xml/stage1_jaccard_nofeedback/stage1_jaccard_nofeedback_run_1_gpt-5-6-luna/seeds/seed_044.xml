<!DOCTYPE warehouse [
  <!ELEMENT warehouse (zone*)>
  <!ELEMENT zone (bin*)>
  <!ELEMENT bin (product*)>
  <!ELEMENT product (name, dimensions?, note?)>
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT dimensions EMPTY>
  <!ELEMENT note (#PCDATA)>
  <!ATTLIST zone code ID #REQUIRED>
  <!ATTLIST bin location NMTOKEN #REQUIRED capacity CDATA "0">
  <!ATTLIST product sku ID #REQUIRED quantity NMTOKEN #REQUIRED>
  <!ATTLIST dimensions width CDATA #REQUIRED height CDATA #REQUIRED depth CDATA #IMPLIED>
  <!ENTITY unit "mm">
]>
<warehouse>
  <zone code="north">
    <bin location="N-01" capacity="100">
      <product sku="p100" quantity="07">
        <name>Widget &amp; washer</name>
        <dimensions width="12" height="8" depth="3"/>
        <note>Measured in &unit;.</note>
      </product>
      <product sku="p101" quantity="0">
        <name><![CDATA[Replacement <seal>]]></name>
      </product>
    </bin>
  </zone>
  <zone code="south">
    <bin location="S-A" capacity="1">
      <product sku="p200" quantity="1">
        <name>Single item</name>
        <dimensions width="0" height="0" depth="0"/>
      </product>
    </bin>
    <bin location="S-B"/>
  </zone>
</warehouse>