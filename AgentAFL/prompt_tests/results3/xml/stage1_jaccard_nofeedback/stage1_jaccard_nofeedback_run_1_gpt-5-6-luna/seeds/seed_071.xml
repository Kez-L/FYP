<?xml version="1.0"?>
<!DOCTYPE message [
  <!ELEMENT message (header, body, attachment?)>
  <!ELEMENT header (from, to, subject)>
  <!ELEMENT body (#PCDATA|em|br)*>
  <!ELEMENT attachment EMPTY>
  <!ELEMENT from (#PCDATA)>
  <!ELEMENT to (#PCDATA)>
  <!ELEMENT subject (#PCDATA)>
  <!ELEMENT em (#PCDATA)>
  <!ELEMENT br EMPTY>
  <!ATTLIST message priority (low|normal|high) "normal">
  <!ATTLIST attachment content-type CDATA #REQUIRED>
]>
<message priority="high">
  <header>
    <from>sender@example.test</from>
    <to>receiver@example.test</to>
    <subject>Mixed content</subject>
  </header>
  <body>Hello <em>world</em><br/>after line break</body>
  <attachment content-type="application/octet-stream"/>
</message>