<!DOCTYPE message [
  <!ENTITY hello "Hello">
  <!ENTITY world "world">
  <!ENTITY pair "&hello;, &world;!">
  <!NOTATION bin SYSTEM "application/octet-stream">
  <!ELEMENT message (header, body, attachment*)>
  <!ELEMENT header (#PCDATA)>
  <!ELEMENT body (#PCDATA|part)*>
  <!ELEMENT part (#PCDATA)>
  <!ELEMENT attachment EMPTY>
  <!ATTLIST attachment name CDATA #REQUIRED type NOTATION (bin) #IMPLIED>
]>
<message>
  <header>&pair;</header>
  <body>Start<part>nested text</part>middle<part><![CDATA[raw ]]></part>end</body>
  <attachment name="data.bin" type="bin"/>
</message>