<!DOCTYPE message [
  <!ENTITY greeting "hello">
  <!ENTITY suffix "world">
  <!NOTATION bin SYSTEM "application/octet-stream">
  <!ENTITY payload SYSTEM "data:text/plain,external">
]>
<message xml:lang="en">
  <header from="sender@example.test" to="receiver@example.test"/>
  <body>&greeting;, &suffix;!</body>
  <attachment type="bin" href="payload.bin"/>
</message>