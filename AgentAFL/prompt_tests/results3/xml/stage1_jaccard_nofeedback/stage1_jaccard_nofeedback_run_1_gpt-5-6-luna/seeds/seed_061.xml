<?xml version="1.0"?>
<!DOCTYPE report [
  <!ELEMENT report (header, section+)>
  <!ELEMENT header EMPTY>
  <!ATTLIST header generated CDATA #IMPLIED>
  <!ELEMENT section (title, entry*)>
  <!ATTLIST section key ID #REQUIRED>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT entry (#PCDATA|note)*>
  <!ELEMENT note (#PCDATA)>
  <!ENTITY copyright "&#169; 2026">
]>
<report>
  <header generated="yes"/>
  <section key="intro">
    <title>Overview</title>
    <entry>First &copyright; <note>internal annotation</note></entry>
    <entry><![CDATA[raw ]]><note>text</note><![CDATA[ ]]>tail</entry>
  </section>
  <section key="details">
    <title>Details</title>
  </section>
</report>