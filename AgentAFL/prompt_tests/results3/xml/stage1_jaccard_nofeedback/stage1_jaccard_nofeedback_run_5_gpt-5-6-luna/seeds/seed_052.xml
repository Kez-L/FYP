<?xml version="1.0"?>
<!DOCTYPE report [
  <!ENTITY % common "(entry | branch)*">
  <!ENTITY % declarations "<!ELEMENT report %common;>
                            <!ELEMENT entry (#PCDATA)>
                            <!ELEMENT branch (entry|branch)*>
                            <!ATTLIST entry level NMTOKEN #IMPLIED>">
  %declarations;
  <!NOTATION txt SYSTEM "text/plain">
  <!ENTITY payload SYSTEM "payload.txt" NDATA txt>
]>
<report>
  <branch>
    <entry level="0">root</entry>
    <branch>
      <entry level="1">child</entry>
      <branch>
        <entry level="2">leaf</entry>
      </branch>
    </branch>
  </branch>
</report>