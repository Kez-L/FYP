<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE catalog [
  <!ELEMENT catalog (item+, audit?)>
  <!ELEMENT item (name, description, meta)>
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT description (#PCDATA|em|br)*>
  <!ELEMENT em (#PCDATA)>
  <!ELEMENT br EMPTY>
  <!ELEMENT meta EMPTY>
  <!ELEMENT audit (#PCDATA)>
  <!ATTLIST item id ID #REQUIRED status (new|old|archived) "new">
  <!ATTLIST meta created CDATA #IMPLIED checksum CDATA #IMPLIED>
]>
<catalog xmlns="urn:example:catalog" xmlns:m="urn:example:meta">
  <item id="i-001" status="new">
    <name>Sample &amp; Entry</name>
    <description><![CDATA[Text containing <tags>, ]] and ampersands]]><em>now</em><br/></description>
    <meta created="2026-10-01" checksum="a1b2c3"/>
  </item>
  <item id="i-002">
    <name>Second item</name>
    <description>before<em>inside</em>after</description>
    <meta m:created="never" checksum="&#x1F642;"/>
  </item>
  <audit>generated &#x9; document</audit>
</catalog>