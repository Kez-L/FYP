  </record>
  <record key="B-02">
    <name>pressure</name>
    <value><![CDATA[101.325]]><unit>kPa</unit></value>
  </record>
  <record key="C.03">
    <name>status</name>
    <value>OK</value>
    <note><![CDATA[embedded ]]> marker]]></note>
  </record>
</report>