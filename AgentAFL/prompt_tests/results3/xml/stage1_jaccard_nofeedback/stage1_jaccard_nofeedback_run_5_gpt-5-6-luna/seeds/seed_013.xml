<?xml version="1.0"?>
<!DOCTYPE report [
  <!ELEMENT report (summary, record*)>
  <!ELEMENT summary (#PCDATA)>
  <!ELEMENT record (name, value, note?)>
  <!ATTLIST record key NMTOKEN #REQUIRED>
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT value (#PCDATA|unit)*>
  <!ELEMENT unit (#PCDATA)>
  <!ELEMENT note (#PCDATA)>
  <!ENTITY % extra "note">
]>
<report>
