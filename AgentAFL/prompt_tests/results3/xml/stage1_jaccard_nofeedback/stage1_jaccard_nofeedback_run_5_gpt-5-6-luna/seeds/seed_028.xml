<?xml version="1.0"?>
<!DOCTYPE report [
  <!ELEMENT report (section+)>
  <!ELEMENT section (heading, (paragraph|table|image|section)*)>
  <!ATTLIST section id ID #IMPLIED>
  <!ELEMENT heading (#PCDATA)>
  <!ELEMENT paragraph (#PCDATA|code|break)*>
  <!ELEMENT code (#PCDATA)>
  <!ELEMENT break EMPTY>
  <!ELEMENT table (row+)>
  <!ELEMENT row (cell*)>
  <!ELEMENT cell (#PCDATA)>
  <!ELEMENT image EMPTY>
  <!ATTLIST image src ENTITY #REQUIRED alt CDATA #IMPLIED>
  <!NOTATION png SYSTEM "image/png">
  <!ENTITY logo SYSTEM "logo.png" NDATA png>
]>
<report>
  <section id="overview">
    <heading>Overview</heading>
    <paragraph>Text <code>x &lt; y</code><break/>next.</paragraph>
    <table><row><cell>A</cell><cell>B</cell></row><row><cell>1</cell></row></table>
    <image src="logo" alt="missing declaration target"/>
    <section><heading>Subsection</heading></section>
  </section>
</report>