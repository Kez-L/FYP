<?xml version="1.0"?>
<!DOCTYPE message [
  <!ELEMENT message (header, body, signature?)>
  <!ELEMENT header (from, to, subject)>
  <!ELEMENT from (#PCDATA)>
  <!ELEMENT to (#PCDATA)>
  <!ELEMENT subject (#PCDATA)>
  <!ELEMENT body (#PCDATA|quote|br)*>
  <!ELEMENT quote (#PCDATA|quote)*>
  <!ELEMENT br EMPTY>
  <!ELEMENT signature (#PCDATA)>
  <!ATTLIST message priority NMTOKENS #IMPLIED>
  <!ENTITY left "&#x3C;">
  <!ENTITY right "&#x3E;">
]>
<message priority="urgent confidential">
  <header><from>a@example</from><to>b@example</to><subject>Boundary &left;test&right;</subject></header>
  <body>Start<quote level="1">Nested <quote level="2">text</quote></quote><br/>End</body>
  <signature><![CDATA[-----BEGIN SIGNATURE-----
not-a-real-signature
-----END SIGNATURE-----]]></signature>
</message>