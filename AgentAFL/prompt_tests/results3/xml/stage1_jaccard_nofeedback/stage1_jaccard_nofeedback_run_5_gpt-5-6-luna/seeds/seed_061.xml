<?xml version="1.0"?>
<!DOCTYPE root [
  <!ENTITY % structure "<!ELEMENT root (section*)>">
  %structure;
  <!ELEMENT section (heading, paragraph+)>
  <!ELEMENT heading (#PCDATA)>
  <!ELEMENT paragraph (#PCDATA|em)*>
  <!ELEMENT em (#PCDATA)>
  <!ATTLIST section name NMTOKEN #REQUIRED>
  <!ENTITY nbsp "&#160;">
  <![INCLUDE[
    <!ENTITY included "conditionally-visible">
  ]]>
]>
<root>
  <section name="intro">
    <heading>Overview</heading>
    <paragraph>This&nbsp;is <em>important</em> text.</paragraph>
    <paragraph>&included; content follows.</paragraph>
  </section>
</root>