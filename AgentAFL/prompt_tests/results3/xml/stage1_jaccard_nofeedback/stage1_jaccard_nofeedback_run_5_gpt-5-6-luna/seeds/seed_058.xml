<!DOCTYPE root [
  <!ENTITY greeting "hello">
  <!ENTITY quoted "A &quot;quoted&quot; value">
  <!ENTITY fragment "<part role='generated'>&greeting;</part>">
  <!NOTATION plain SYSTEM "text/plain">
  <!ELEMENT root (config, payload, config?)>
  <!ELEMENT config EMPTY>
  <!ATTLIST config mode CDATA "default">
  <!ELEMENT payload ANY>
  <!ENTITY external SYSTEM "missing-resource.xml">
]>
<root>
  <config mode="&quoted;"/>
  <payload>
    &fragment;
    <mixed><![CDATA[ raw ]]> text &greeting; </mixed>
  </payload>
  <config mode="secondary"/>
</root>