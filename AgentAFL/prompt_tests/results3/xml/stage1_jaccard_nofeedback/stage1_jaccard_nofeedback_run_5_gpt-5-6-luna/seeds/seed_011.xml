<?xml version="1.0"?>
<!DOCTYPE envelope [
  <!ELEMENT envelope (header, body, footer)>
  <!ELEMENT header EMPTY>
  <!ATTLIST header xmlns CDATA #IMPLIED version CDATA #REQUIRED>
  <!ELEMENT body (section*)>
  <!ELEMENT section (section|item)*>
  <!ATTLIST section name CDATA #IMPLIED>
  <!ELEMENT item (#PCDATA)>
  <!ELEMENT footer (#PCDATA)>
]>
<envelope>
  <header xmlns="urn:example:header" version="00000000000000000000000000000001"/>
  <body xmlns="urn:example:body">
    <section name="outer">
      <item>first</item>
      <section name="inner">
        <item>second &amp; third</item>
        <section name="leaf"/>
      </section>
      <item><![CDATA[tail]]></item>
    </section>
  </body>
  <footer>done</footer>
</envelope>