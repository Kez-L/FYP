<?xml version="1.0"?>
<!DOCTYPE map [
  <!ELEMENT map (node*)>
  <!ELEMENT node (label, node*)>
  <!ATTLIST node id ID #IMPLIED ref IDREF #IMPLIED kind CDATA "branch">
  <!ELEMENT label (#PCDATA)>
  <!ENTITY amp "&#38;">
]>
<map xmlns:x="urn:x">
  <node id="root" kind="branch">
    <label>root</label>
    <node id="left" ref="right">
      <label>x:left &amp; &amp;</label>
      <node id="leaf">
        <label>leaf</label>
      </node>
    </node>
    <node id="right" kind="terminal">
      <label><![CDATA[<right>]]></label>
    </node>
  </node>
</map>