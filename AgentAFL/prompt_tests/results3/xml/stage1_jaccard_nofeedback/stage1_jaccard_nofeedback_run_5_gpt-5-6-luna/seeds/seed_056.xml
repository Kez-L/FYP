<!DOCTYPE library [
  <!ELEMENT library (section+)>
  <!ELEMENT section (heading, entry*)>
  <!ATTLIST section code ID #REQUIRED>
  <!ELEMENT heading (#PCDATA)>
  <!ELEMENT entry (name, note?, link*)>
  <!ATTLIST entry ref IDREF #IMPLIED>
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT note (#PCDATA|b|i)*>
  <!ELEMENT b (#PCDATA)>
  <!ELEMENT i (#PCDATA)>
  <!ELEMENT link EMPTY>
  <!ATTLIST link target IDREF #REQUIRED kind (local|remote) "local">
]>
<library>
  <section code="s1">
    <heading>References</heading>
    <entry ref="e2">
      <name>First entry</name>
      <note>plain <b>bold</b> and <i>italic</i></note>
      <link target="e2" kind="remote"/>
    </entry>
  </section>
  <section code="s2">
    <heading>Empty section</heading>
  </section>
</library>