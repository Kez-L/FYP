<?xml version="1.1"?>
<!DOCTYPE report [
  <!ELEMENT report (run, summary)>
  <!ELEMENT run (input, result*)>
  <!ELEMENT input (#PCDATA)>
  <!ELEMENT result (message?, value?)>
  <!ELEMENT message (#PCDATA)>
  <!ELEMENT value (#PCDATA)>
  <!ELEMENT summary (#PCDATA)>
  <!ATTLIST run id ID #REQUIRED>
  <!ATTLIST result status (ok|fail|unknown) "unknown">
  <!ENTITY left "[" >
  <!ENTITY right "]" >
]>
<report>
  <run id="r01">
    <input>sample&#x0A;with&#x9;whitespace</input>
    <result status="ok">
      <message>range &left;0..10&right;</message>
      <value>10</value>
    </result>
    <result status="fail"/>
  </run>
  <summary>completed&#xA;with mixed outcomes</summary>
</report>