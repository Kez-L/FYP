<?xml version="1.1"?>
<!DOCTYPE report [
  <!ELEMENT report (header,section*,footer?)>
  <!ELEMENT header (#PCDATA)>
  <!ELEMENT section (title,entry+)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT entry (#PCDATA|note)*>
  <!ELEMENT note (#PCDATA)>
  <!ELEMENT footer (#PCDATA)>
  <!ATTLIST section key ID #IMPLIED>
  <!ATTLIST entry level (low|medium|high) "medium">
]>
<report>
  <header>daily &amp; internal</header>
  <section key="s1">
    <title>First section</title>
    <entry level="high">text<note>nested note</note>tail</entry>
    <entry>second entry</entry>
  </section>
  <section key="s2">
    <title><![CDATA[<encoded-title>]]></title>
    <entry level="low"><note>only a note</note></entry>
  </section>
  <footer>2026-10-01</footer>
</report>