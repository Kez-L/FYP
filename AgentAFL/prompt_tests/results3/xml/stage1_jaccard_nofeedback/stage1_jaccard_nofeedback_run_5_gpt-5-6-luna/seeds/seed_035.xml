<?xml version="1.0"?>
<!DOCTYPE catalog [
  <!ELEMENT catalog (entry+)>
  <!ELEMENT entry (title, meta?, description)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT meta EMPTY>
  <!ATTLIST meta key CDATA #REQUIRED value CDATA #IMPLIED>
  <!ELEMENT description (#PCDATA|note)*>
  <!ELEMENT note (#PCDATA)>
  <!ENTITY quoted "&#x22; &amp; &#x3C;">
]>
<catalog>
  <entry>
    <title>alpha <![CDATA[<embedded>]]> omega</title>
    <meta key="mode" value="quoted &quot; value"/>
    <description>before<note>inside</note>after &quoted;</description>
  </entry>
  <entry>
    <title>second</title>
    <description><![CDATA[raw ]]> text ]]> tail</description>
  </entry>
</catalog>