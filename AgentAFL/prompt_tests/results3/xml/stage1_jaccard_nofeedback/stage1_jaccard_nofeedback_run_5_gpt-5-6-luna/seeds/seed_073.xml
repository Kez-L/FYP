<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE report [
  <!ELEMENT report (section+)>
  <!ELEMENT section (heading, block+)>
  <!ATTLIST section number NMTOKEN #REQUIRED>
  <!ELEMENT heading (#PCDATA)>
  <!ELEMENT block (p|list|table|note)>
  <!ELEMENT p (#PCDATA|link|code|break)*>
  <!ELEMENT link (#PCDATA)>
  <!ATTLIST link href CDATA #REQUIRED>
  <!ELEMENT code (#PCDATA)>
  <!ELEMENT break EMPTY>
  <!ELEMENT list (item+)>
  <!ELEMENT item (#PCDATA|p)*>
  <!ELEMENT table (row+)>
  <!ELEMENT row (cell+)>
  <!ELEMENT cell (#PCDATA)>
  <!ATTLIST cell colspan NMTOKEN "1">
  <!ELEMENT note (#PCDATA)>
  <!ENTITY dash "&#x2014;">
]>
<report>
  <section number="1">
    <heading>Input validation &amp; recovery</heading>
    <block>
      <p>Values are checked before storage<break/>and logged with a <code>trace_id</code>.</p>
    </block>
    <block>
      <list>
        <item>Parse the header</item>
        <item><p>Normalize whitespace</p><p>Reject invalid bytes</p></item>
        <item>Emit a diagnostic &dash; continue when safe</item>
      </list>
    </block>
  </section>
  <section number="2">
    <heading>Results</heading>
    <block>
      <table>
        <row><cell>case</cell><cell>status</cell><cell colspan="2">details</cell></row>
        <row><cell>A-17</cell><cell>pass</cell><cell>stable</cell><cell>low</cell></row>
      </table>
    </block>
    <block><note><![CDATA[<not-a-markup-element> remains literal]]></note></block>
  </section>
</report>