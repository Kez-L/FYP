<?xml version="1.1" standalone="yes"?>
<!DOCTYPE archive [
  <!ELEMENT archive (entry*)>
  <!ELEMENT entry (key, value?, note*)>
  <!ELEMENT key (#PCDATA)>
  <!ELEMENT value (#PCDATA)>
  <!ELEMENT note (#PCDATA|inner)*>
  <!ELEMENT inner (#PCDATA)>
  <!ATTLIST entry state (new|old|unknown) "unknown">
]>
<archive>
  <entry state="new">
    <key>k1</key>
    <value>v1</value>
    <note>plain <inner>nested</inner> text</note>
  </entry>
  <entry state="old">
    <key>k2</key>
    <note/>
    <note><![CDATA[brackets ]]> and ampersands &amp;]]></note>
  </entry>
</archive>