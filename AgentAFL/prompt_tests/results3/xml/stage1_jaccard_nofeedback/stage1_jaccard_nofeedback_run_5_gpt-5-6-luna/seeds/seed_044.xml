<?xml version="1.0"?>
<!DOCTYPE stream [
  <!ELEMENT stream (record*)>
  <!ELEMENT record (key,value,raw?)>
  <!ELEMENT key (#PCDATA)>
  <!ELEMENT value (#PCDATA)>
  <!ELEMENT raw (#PCDATA)>
  <!ATTLIST record index NMTOKEN #REQUIRED>
  <!ENTITY left "[" >
  <!ENTITY right "]" >
]>
<stream>
  <record index="1">
    <key>alpha</key>
    <value>&left;one&amp;two&right;</value>
    <raw><![CDATA[
      <![CDATA[ not nested ]]>
      ]]></raw>
  </record>
  <record index="0000000000000000000000000000000000000001">
    <key>line&#10;break</key>
    <value><![CDATA[quotes: " ' &lt; &gt;]]></value>
    <raw> leading and trailing spaces </raw>
  </record>
  <record index="3">
    <key>empty</key>
    <value/>
  </record>
</stream>