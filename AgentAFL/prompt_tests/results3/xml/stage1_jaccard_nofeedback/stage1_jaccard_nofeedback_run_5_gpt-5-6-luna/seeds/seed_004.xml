<?xml version="1.0" encoding="ISO-8859-1"?>
<!DOCTYPE manifest [
  <!NOTATION gif SYSTEM "image/gif">
  <!NOTATION txt PUBLIC "-//EXAMPLE//NOTATION Plain Text//EN">
  <!ENTITY logo SYSTEM "images/logo.gif" NDATA gif>
  <!ELEMENT manifest (file+, image?, link*)>
  <!ELEMENT file (#PCDATA)>
  <!ELEMENT image EMPTY>
  <!ELEMENT link EMPTY>
  <!ATTLIST file id ID #REQUIRED kind CDATA "text">
  <!ATTLIST image source ENTITY #REQUIRED alt CDATA #IMPLIED>
  <!ATTLIST link target IDREF #IMPLIED rel (next|prev|related) "related">
]>
<manifest>
  <file id="f1" kind="text">readme&#xA;contents</file>
  <file id="f2">secondary file</file>
  <image source="logo" alt="brand"/>
  <link target="f1" rel="related"/>
</manifest>