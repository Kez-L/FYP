<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE catalog [
  <!ELEMENT catalog (section+)>
  <!ELEMENT section (title, item*)>
  <!ATTLIST section id ID #REQUIRED xml:lang NMTOKEN "en">
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT item (name, price, description?)>
  <!ATTLIST item sku CDATA #IMPLIED status (new|used|archived) "new">
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT price (#PCDATA)>
  <!ELEMENT description (#PCDATA|em|br)*>
  <!ELEMENT em (#PCDATA)>
  <!ELEMENT br EMPTY>
  <!ENTITY currency "€">
]>
<catalog xmlns="urn:example:catalog" xmlns:x="urn:example:extra">
  <section id="s-main" xml:lang="fr">
    <title>Éléments récents</title>
    <item sku="A-001" status="new">
      <name>Crème brûlée</name>
      <price>12 &currency;</price>
      <description>Servie avec <em>vanille</em><br/>et caramel.</description>
    </item>
    <item sku="B-002">
      <name>Thé vert</name>
      <price>8 &currency;</price>
      <description><![CDATA[Notes florales & minérales <à conserver>]]></description>
    </item>
  </section>
</catalog>