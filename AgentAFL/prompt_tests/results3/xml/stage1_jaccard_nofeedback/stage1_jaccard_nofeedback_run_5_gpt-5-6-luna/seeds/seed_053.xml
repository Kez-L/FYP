<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE matrix [
  <!ELEMENT matrix (row+)>
  <!ELEMENT row (cell+)>
  <!ELEMENT cell (#PCDATA)>
  <!ATTLIST row index NMTOKEN #IMPLIED>
  <!ATTLIST cell x CDATA #IMPLIED y CDATA #IMPLIED>
]>
<matrix>
  <row index="A">
    <cell x="0" y="0">one</cell>
    <cell x="1" y="0">two &amp; more</cell>
  </row>
  <row index="B">
    <cell x="0" y="1">three</cell>
    <cell x="1" y="1"><![CDATA[four
five]]></cell>
    <cell x="2" y="1">&#65;&#x42;&#x43;</cell>
  </row>
</matrix>