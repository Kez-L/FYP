<!DOCTYPE message [
  <!ELEMENT message (header, body, footer?)>
  <!ELEMENT header (from, to)>
  <!ELEMENT from (#PCDATA)>
  <!ELEMENT to (#PCDATA)>
  <!ELEMENT body ANY>
  <!ELEMENT footer (#PCDATA)>
  <!ENTITY local "local-value">
]>
<message>
  <header>
    <from>sender@example.test</from>
    <to><![CDATA[receiver@example.test]]></to>
  </header>
  <body>
    <section id="one">
      <line>first &local;</line>
      <line><![CDATA[second <line> not markup]]></line>
    </section>
    <section id="two"><![CDATA[]]></section>
  </body>
  <footer>done</footer>
</message>