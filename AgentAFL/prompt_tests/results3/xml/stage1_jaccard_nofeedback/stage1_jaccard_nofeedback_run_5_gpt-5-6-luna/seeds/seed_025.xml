<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE inventory [
  <!ELEMENT inventory (warehouse+, audit?)>
  <!ELEMENT warehouse (item*)>
  <!ATTLIST warehouse
            code ID #REQUIRED
            region CDATA "unknown">
  <!ELEMENT item (name, description?, price)>
  <!ATTLIST item
            sku ID #REQUIRED
            state (new|used|held) "new">
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT description (#PCDATA|emph|link)*>
  <!ELEMENT emph (#PCDATA)>
  <!ELEMENT link (#PCDATA)>
  <!ELEMENT price (#PCDATA)>
  <!ELEMENT audit (#PCDATA)>
  <!ENTITY currency "€">
]>
<inventory>
  <warehouse code="w-eu-01" region="north">
    <item sku="sku-7" state="used">
      <name>Widget &amp; Cable</name>
      <description><![CDATA[<unparsed> & raw text]]><emph>special</emph><link>details</link></description>
      <price>19.95 &currency;</price>
    </item>
  </warehouse>
  <audit>checked<!-- embedded note --><?trace level="verbose"?></audit>
</inventory>