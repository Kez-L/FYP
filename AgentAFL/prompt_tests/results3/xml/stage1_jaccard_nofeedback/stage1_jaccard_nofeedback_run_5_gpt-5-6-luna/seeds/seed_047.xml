<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE scene [
  <!ELEMENT scene (layer+)>
  <!ELEMENT layer (object*)>
  <!ATTLIST layer z CDATA #REQUIRED visible (yes|no) "yes">
  <!ELEMENT object (geometry, transform?, properties?)>
  <!ATTLIST object type CDATA #REQUIRED>
  <!ELEMENT geometry EMPTY>
  <!ATTLIST geometry x CDATA #REQUIRED y CDATA #REQUIRED w CDATA #REQUIRED h CDATA #REQUIRED>
  <!ELEMENT transform EMPTY>
  <!ATTLIST transform rotate CDATA "0" scale CDATA "1,1">
  <!ELEMENT properties (property*)>
  <!ELEMENT property (#PCDATA)>
  <!ATTLIST property name CDATA #REQUIRED>
]>
<scene xmlns="urn:example:scene" units="px">
  <layer z="0" visible="yes">
    <object type="rectangle">
      <geometry x="-1.25" y="4e2" w="640" h="480"/>
      <transform rotate="359.99" scale="-1,0.5"/>
      <properties>
        <property name="fill">#00ff7f</property>
        <property name="label">edge &amp; corner</property>
      </properties>
    </object>
    <object type="path">
      <geometry x="0" y="0" w="0" h="0"/>
    </object>
  </layer>
  <layer z="10" visible="no"/>
</scene>