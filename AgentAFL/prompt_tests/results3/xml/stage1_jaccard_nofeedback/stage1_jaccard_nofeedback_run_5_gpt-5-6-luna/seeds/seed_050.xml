<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE catalog [
  <!ENTITY company "Aster &amp; Oak">
  <!ENTITY quote "He said &quot;hello&quot;">
  <!ELEMENT catalog (section+)>
  <!ELEMENT section (title, item*)>
  <!ATTLIST section id ID #REQUIRED>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT item (#PCDATA|note)*>
  <!ELEMENT note (#PCDATA)>
]>
<catalog>
  <section id="s1">
    <title>&company; inventory</title>
    <item>alpha<note>first</note>beta</item>
    <item>&quote;</item>
  </section>
  <section id="s2">
    <title>Second section</title>
    <item>numeric &#x1F642; character</item>
  </section>
</catalog>