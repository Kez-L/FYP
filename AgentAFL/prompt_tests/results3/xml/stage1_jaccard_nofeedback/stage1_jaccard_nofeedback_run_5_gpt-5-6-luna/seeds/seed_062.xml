<?xml version="1.0" encoding="UTF-8"?>
<application xmlns="urn:example:app"
             xmlns:cfg="urn:example:config"
             xml:lang="en-US"
             xml:space="preserve">
  <?build profile="fuzz"?>
  <!-- Configuration values intentionally contain mixed content. -->
  <header cfg:version="2.7" cfg:enabled="true">
    <name>Parser &amp; Validator</name>
    <description><![CDATA[
      A line with ]]> characters represented safely in a CDATA boundary:
      <![CDATA[alpha ]]]]><![CDATA[> omega
    ]]></description>
  </header>
  <settings>
    <setting key="timeout" value="00000030"/>
    <setting key="path">/tmp/a/b/../c</setting>
    <setting key="empty"/>
  </settings>
</application>