<?xml version="1.0"?>
<!DOCTYPE report [
  <!ELEMENT report (header,section+,footer?)>
  <!ELEMENT header (#PCDATA)>
  <!ELEMENT section (title,para*)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT para (#PCDATA|link)*>
  <!ELEMENT link (#PCDATA)>
  <!ELEMENT footer (#PCDATA)>
  <!ATTLIST section level (low|medium|high) "low">
  <!ENTITY notice "A &amp; B &lt; C">
  <!ENTITY % common "xml:space CDATA #IMPLIED">
  <!ATTLIST para %common;>
]>
<report>
  <header>&notice;</header>
  <section level="high">
    <title>One</title>
    <para xml:space="preserve">alpha<link href="urn:test">beta</link>gamma</para>
  </section>
  <section>
    <title>Two</title>
    <para>delta</para>
    <para>epsilon</para>
  </section>
  <footer><![CDATA[closing text]]></footer>
</report>