<?xml version="1.0"?>
<!DOCTYPE report [
  <!ENTITY % common "<!ELEMENT note (#PCDATA)><!ATTLIST note xml:lang CDATA #IMPLIED>">
  %common;
  <!ELEMENT report (section*)>
  <!ELEMENT section (title,note?)>
  <!ELEMENT title (#PCDATA)>
  <![IGNORE[
    <!ELEMENT discarded (anything)>
    <!ATTLIST discarded mode CDATA "ignored">
  ]]>
  <!ELEMENT anything (#PCDATA)>
]>
<report>
  <section>
    <title>Alpha</title>
    <note xml:lang="en">A short note.</note>
  </section>
  <section>
    <title>Beta &amp; Gamma</title>
    <note xml:lang="x-private">Line one
Line two</note>
  </section>
</report>