<?xml version="1.0"?>
<!DOCTYPE catalog [
  <!ELEMENT catalog (entry+, metadata?)>
  <!ELEMENT entry (title, details, tags?)>
  <!ATTLIST entry id ID #REQUIRED status (new|old|draft) "new">
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT details (#PCDATA|em|br)*>
  <!ELEMENT em (#PCDATA)>
  <!ELEMENT br EMPTY>
  <!ELEMENT tags (tag*)>
  <!ELEMENT tag (#PCDATA)>
  <!ELEMENT metadata ANY>
  <!ENTITY greeting "hello &amp; goodbye">
]>
<catalog>
  <entry id="e1" status="draft">
    <title>Boundary &lt; title</title>
    <details>alpha<em>mixed</em>beta<br/>gamma &greeting;</details>
    <tags><tag>one</tag><tag>two</tag></tags>
  </entry>
  <entry id="e2">
    <title><![CDATA[ ]]>]]><![CDATA[ tricky ]]>]]></title>
    <details><![CDATA[x<y && z>q]]></details>
  </entry>
  <metadata key="late">ignored</metadata>
</catalog>