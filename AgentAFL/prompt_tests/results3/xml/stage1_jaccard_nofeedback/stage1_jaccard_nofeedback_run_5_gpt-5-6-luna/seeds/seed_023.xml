<!DOCTYPE envelope [
  <!ELEMENT envelope (sender,receiver,payload)>
  <!ELEMENT sender EMPTY>
  <!ELEMENT receiver EMPTY>
  <!ELEMENT payload ANY>
  <!ATTLIST sender id ID #REQUIRED>
  <!ATTLIST receiver id ID #REQUIRED ref IDREF #IMPLIED>
  <!ENTITY open "<part name='generated'>">
  <!ENTITY close "</part>">
]>
<envelope>
  <sender id="s1"/>
  <receiver id="r1" ref="s1"/>
  <payload>
    &open;
      <value><![CDATA[&open; is literal here]]></value>
    &close;
    <part name="ordinary">
      <value>123</value>
    </part>
  </payload>
</envelope>