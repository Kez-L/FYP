<?xml version="1.0"?>
<!DOCTYPE envelope [
  <!ENTITY % common SYSTEM "http://invalid.example/common.dtd">
  <!ENTITY greeting "hello">
  <!NOTATION bin SYSTEM "application/octet-stream">
  <!ENTITY payload SYSTEM "data:text/plain,external" NDATA bin>
  <!ELEMENT envelope (header, body)>
  <!ELEMENT header (#PCDATA)>
  <!ELEMENT body (part*)>
  <!ELEMENT part (#PCDATA)>
  <!ATTLIST part ref ENTITY #IMPLIED>
]>
<envelope>
  <header>&greeting; <![CDATA[header]]></header>
  <body>
    <part ref="payload">one</part>
    <part>two &amp; three</part>
  </body>
</envelope>