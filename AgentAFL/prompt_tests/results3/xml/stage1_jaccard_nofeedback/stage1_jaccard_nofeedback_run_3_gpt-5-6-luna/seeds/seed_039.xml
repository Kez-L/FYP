]>
<envelope>
  <header stamp="2026-09-24T00:00:00Z"/>
  <body>
    <block>
      <line>one</line>
      <line>two &lt; three</line>
    </block>
    <block>
      <line><![CDATA[]]></line>
      <line>tail</line>
    </block>
  </body>
</envelope>