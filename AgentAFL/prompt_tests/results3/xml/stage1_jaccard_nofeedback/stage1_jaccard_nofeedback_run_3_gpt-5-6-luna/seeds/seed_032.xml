<!DOCTYPE root [
  <!ENTITY alpha "A">
  <!ENTITY beta "&alpha;&alpha;&alpha;">
  <!ENTITY quote "&#34;">
  <!ENTITY apos "&#39;">
  <!ELEMENT root (section|text|mixed)*>
  <!ELEMENT section (title, paragraph*)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT paragraph (#PCDATA|link|mark)*>
  <!ELEMENT link (#PCDATA)>
  <!ELEMENT mark (#PCDATA)>
  <!ELEMENT text (#PCDATA)>
]>
<root data="&quote; &apos; &beta;">
  <section>
    <title>&alpha; title</title>
    <paragraph>one <link href="a&amp;b">two</link> <mark>three</mark></paragraph>
    <paragraph><![CDATA[line one
line two
line three]]></paragraph>
  </section>
  <text>leading</text>
  <mixed>not declared as an element in the subset</mixed>
</root>