<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE catalog [
  <!ELEMENT catalog (item+)>
  <!ELEMENT item (title, details, price?)>
  <!ATTLIST item id ID #REQUIRED category NMTOKEN #IMPLIED>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT details (#PCDATA|em|code)*>
  <!ELEMENT em (#PCDATA)>
  <!ELEMENT code (#PCDATA)>
  <!ELEMENT price (#PCDATA)>
  <!ENTITY trademark "™">
]>
<catalog xmlns="urn:example:catalog" xmlns:x="urn:example:extra" xml:lang="en">
  <item id="i1" category="tools" x:flag="yes">
    <title>Hammer &amp; &trademark;</title>
    <details><![CDATA[Handle length: <unknown>; ]]><em>solid</em><code>x &lt; y</code></details>
    <price xml:space="preserve"> 19.95 </price>
  </item>
  <item id="i2">
    <title>Nested <em>content</em></title>
    <details>one<x:mark/>two<!-- embedded comment -->three</details>
  </item>
</catalog>