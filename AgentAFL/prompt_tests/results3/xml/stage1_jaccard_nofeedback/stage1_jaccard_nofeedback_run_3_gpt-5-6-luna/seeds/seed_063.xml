<!DOCTYPE graph [
  <!ENTITY node "vertex">
  <!ENTITY edge "connection">
]>
<graph directed="yes">
  <vertices>
    <vertex key="v1" label="&node;"/>
    <vertex key="v2" label="target"/>
    <vertex key="v3" label="isolated"/>
  </vertices>
  <connections>
    <link from="v1" to="v2" kind="&edge;">
      <weight>1.0</weight>
    </link>
    <link from="v2" to="v3">
      <weight>NaN</weight>
      <annotation>chain &lt; tail</annotation>
    </link>
  </connections>
</graph>