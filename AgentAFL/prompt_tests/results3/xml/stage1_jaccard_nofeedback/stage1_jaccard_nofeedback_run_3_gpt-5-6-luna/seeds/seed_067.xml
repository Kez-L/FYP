<!DOCTYPE document [
  <!ELEMENT document (section*)>
  <!ELEMENT section (title, paragraph+, section*)>
  <!ATTLIST section level NMTOKEN #IMPLIED>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT paragraph (#PCDATA|link|code)*>
  <!ELEMENT link (#PCDATA)>
  <!ATTLIST link target URI #REQUIRED>
  <!ELEMENT code (#PCDATA)>
  <!ENTITY quote "&#34;">
  <!ENTITY amp "&#38;">
]>
<document>
  <section level="1">
    <title>Nested outline</title>
    <paragraph>Use <code>&lt;tag&gt;</code> and say &quote;hello&quote;.</paragraph>
    <section level="1.1">
      <title>Links</title>
      <paragraph>A <link target="https://example.invalid/a?x=1&amp;y=2">reference</link>
        followed by &amp; more text.</paragraph>
    </section>
  </section>
  <section level="2">
    <title><![CDATA[Another section]]></title>
    <paragraph>Trailing text</paragraph>
  </section>
</document>