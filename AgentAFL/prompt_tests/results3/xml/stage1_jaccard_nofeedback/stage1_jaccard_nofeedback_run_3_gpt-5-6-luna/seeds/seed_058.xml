<?xml version="1.0"?>
<!DOCTYPE archive [
  <!ENTITY % common SYSTEM "about:invalid">
  <!ENTITY copyright "&#xA9; 2026">
  <!NOTATION bin SYSTEM "application/octet-stream">
  <!ELEMENT archive (folder|record|link)*>
  <!ELEMENT folder (folder|record|link)*>
  <!ATTLIST folder name CDATA #REQUIRED>
  <!ELEMENT record (key, value, blob?)>
  <!ELEMENT key (#PCDATA)>
  <!ELEMENT value (#PCDATA)>
  <!ELEMENT blob EMPTY>
  <!ATTLIST blob type NOTATION (bin) #REQUIRED size NMTOKEN #IMPLIED>
  <!ELEMENT link EMPTY>
  <!ATTLIST link target IDREF #REQUIRED>
]>
<archive>
  <folder name="root">
    <record>
      <key>status</key>
      <value>ready &copyright;</value>
    </record>
    <folder name="nested">
      <record>
        <key>payload</key>
        <value>opaque</value>
        <blob type="bin" size="0"/>
      </record>
    </folder>
    <link target="missing-id"/>
  </folder>
</archive>