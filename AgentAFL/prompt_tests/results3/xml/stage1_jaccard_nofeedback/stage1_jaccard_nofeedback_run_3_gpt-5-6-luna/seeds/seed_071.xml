<?xml version="1.0"?>
<!DOCTYPE report [
  <!ELEMENT report (header, section+)>
  <!ELEMENT header (#PCDATA)>
  <!ELEMENT section (item*)>
  <!ELEMENT item (#PCDATA)>
  <!ATTLIST item kind (plain|quoted|escaped) "plain">
  <!ENTITY left-bracket "[">
  <!ENTITY right-bracket "]">
  <!ENTITY phrase "inside an entity">
]>
<report>
  <header>&phrase;</header>
  <section>
    <item kind="quoted">&left-bracket;quoted&right-bracket;</item>
    <item kind="escaped">A &lt; B &amp;&amp; B &gt; C</item>
  </section>
  <section>
    <item>tail</item>
  </section>
</report>