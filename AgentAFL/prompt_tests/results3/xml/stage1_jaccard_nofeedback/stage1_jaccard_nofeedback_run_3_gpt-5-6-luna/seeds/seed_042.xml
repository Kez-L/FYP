<!DOCTYPE root [
  <!NOTATION bin SYSTEM "application/octet-stream">
  <!ENTITY logo SYSTEM "image.bin" NDATA bin>
  <!ENTITY local "line1&#10;line2&#x9;line3">
  <!ELEMENT root (header, payload, footer?)>
  <!ELEMENT header (#PCDATA)>
  <!ELEMENT payload EMPTY>
  <!ELEMENT footer (#PCDATA)>
  <!ATTLIST payload
    source ENTITY #IMPLIED
    mode (fast|safe|debug) "safe">
]>
<root>
  <header>&local;</header>
  <payload source="logo" mode="debug"/>
  <footer>after &amp; before</footer>
</root>