<?xml version="1.0"?>
<!DOCTYPE catalog [
  <!ELEMENT catalog (item+)>
  <!ELEMENT item (name, details, price)>
  <!ATTLIST item id ID #REQUIRED status (new|used|archived) "new">
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT details (#PCDATA|em|br)*>
  <!ELEMENT em (#PCDATA)>
  <!ELEMENT br EMPTY>
  <!ELEMENT price (#PCDATA)>
  <!ENTITY currency "&#x20AC;">
]>
<catalog xmlns="urn:example:catalog" xmlns:x="urn:example:extra">
  <!-- mixed content with empty elements and entity expansion -->
  <item id="i1" status="used">
    <name>Widget &amp; Cable</name>
    <details>Lightly <em>used</em><br/>with a &lt;replacement&gt; part.</details>
    <price>19.95 &currency;</price>
  </item>
  <item id="i2" x:flag="true">
    <name><![CDATA[Unusual ]]></name>
    <details><![CDATA[raw ]]> text <em>after</em></details>
    <price>0</price>
  </item>
</catalog>