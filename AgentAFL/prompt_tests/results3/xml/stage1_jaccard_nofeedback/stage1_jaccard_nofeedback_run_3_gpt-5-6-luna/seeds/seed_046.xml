<!DOCTYPE root [
  <!ELEMENT root (section | note)*>
  <!ELEMENT section (item+, section?)>
  <!ELEMENT item (#PCDATA | emphasis)*>
  <!ELEMENT emphasis (#PCDATA)>
  <!ELEMENT note (#PCDATA)>
  <!ATTLIST section name NMTOKEN #IMPLIED>
  <!ATTLIST item rank CDATA "0">
]>
<root>
  <section name="outer">
    <item rank="1">first <emphasis>important</emphasis> item</item>
    <section name="inner">
      <item rank="2">nested <![CDATA[content with ]]> marker</item>
    </section>
  </section>
  <note>tail</note>
</root>