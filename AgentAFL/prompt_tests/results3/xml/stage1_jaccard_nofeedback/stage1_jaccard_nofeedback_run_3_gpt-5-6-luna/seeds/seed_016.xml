<?xml version="1.0"?>
<!DOCTYPE envelope [
  <!ELEMENT envelope (header, body)>
  <!ELEMENT header (token?, flag*)>
  <!ELEMENT token (#PCDATA)>
  <!ELEMENT flag EMPTY>
  <!ELEMENT body ANY>
  <!ATTLIST flag name NMTOKEN #REQUIRED value CDATA "">
  <!ENTITY greeting "hello &amp; goodbye">
  <!ENTITY quoted "a &quot;b&quot; c">
]>
<envelope>
  <header>
    <token>&greeting; &quoted;</token>
    <flag name="x" value="1"/>
    <flag name="y"/>
  </header>
  <body>
    <section><p>one</p><p>two &lt; three</p></section>
  </body>
</envelope>