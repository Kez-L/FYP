<!DOCTYPE message [
  <!ELEMENT message (header, payload, signature)>
  <!ELEMENT header (from, to, timestamp)>
  <!ELEMENT from (#PCDATA)>
  <!ELEMENT to (#PCDATA)>
  <!ELEMENT timestamp (#PCDATA)>
  <!ELEMENT payload (#PCDATA|line|quote)*>
  <!ELEMENT line (#PCDATA)>
  <!ELEMENT quote (#PCDATA)>
  <!ELEMENT signature EMPTY>
  <!ATTLIST signature algorithm CDATA #REQUIRED value CDATA #IMPLIED>
  <!ENTITY greeting "Hello, &quot;reader&quot;">
]>
<message>
  <header>
    <from>sender@example.test</from>
    <to>receiver@example.test</to>
    <timestamp>2026-09-24T12:34:56Z</timestamp>
  </header>
  <payload>
    <line>&greeting;.</line>
    <quote>Less &lt; more, but 3 &gt; 2.</quote>
    <line><![CDATA[
      preserved
      whitespace
      and ]]> delimiters
    ]]></line>
  </payload>
  <signature algorithm="none"/>
</message>