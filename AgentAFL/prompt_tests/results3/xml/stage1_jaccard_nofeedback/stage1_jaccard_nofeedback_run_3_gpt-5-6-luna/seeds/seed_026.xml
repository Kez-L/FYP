<!DOCTYPE root [
  <!ELEMENT root (section+)>
  <!ELEMENT section (title, entry*)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT entry (#PCDATA|note)*>
  <!ELEMENT note (#PCDATA)>
  <!ATTLIST section kind (primary|secondary) "primary">
  <!ENTITY greeting "hello">
]>
<root>
  <section kind="secondary">
    <title>&greeting; section</title>
    <entry>first<note>nested note</note>tail</entry>
    <entry>second</entry>
  </section>
  <section>
    <title>empty entries</title>
  </section>
</root>