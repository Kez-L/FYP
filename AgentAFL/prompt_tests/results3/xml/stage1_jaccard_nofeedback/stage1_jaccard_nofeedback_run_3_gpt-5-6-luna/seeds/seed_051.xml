<!DOCTYPE envelope [
  <!ELEMENT envelope (header, body)>
  <!ELEMENT header (token?)>
  <!ELEMENT token (#PCDATA)>
  <!ELEMENT body ANY>
  <!ENTITY local "replacement">
]>
<envelope>
  <header><token>&local;</token></header>
  <body>
    <section name="one">
      <![CDATA[raw ]]> content &amp; more
      <![CDATA[<tag attr="x">]]>
    </section>
    <section name="two"><![CDATA[abc]]></section>
  </body>
</envelope>