<?xml version="1.0"?>
<!DOCTYPE catalog [
  <!ELEMENT catalog (entry+)>
  <!ELEMENT entry (title,meta?,description)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT meta EMPTY>
  <!ATTLIST meta
    key CDATA #REQUIRED
    value CDATA #IMPLIED>
  <!ELEMENT description (#PCDATA|em|br)*>
  <!ELEMENT em (#PCDATA)>
  <!ELEMENT br EMPTY>
]>
<catalog>
  <entry>
    <title>alpha &amp; omega</title>
    <meta key="priority" value="high"/>
    <description><![CDATA[raw ]]> text <em>inside</em><br/>tail</description>
  </entry>
  <entry>
    <title>second</title>
    <description>unclosed-ish &lt; markup and &#x1F; character</description>
  </entry>
</catalog>