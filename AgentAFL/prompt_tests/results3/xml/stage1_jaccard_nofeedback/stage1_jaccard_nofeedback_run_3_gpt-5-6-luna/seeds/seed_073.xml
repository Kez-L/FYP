<?xml version="1.1"?>
<!DOCTYPE envelope [
  <!ELEMENT envelope (metadata, body)>
  <!ELEMENT metadata EMPTY>
  <!ELEMENT body (message|attachment)*>
  <!ELEMENT message (#PCDATA)>
  <!ELEMENT attachment EMPTY>
  <!ATTLIST attachment name CDATA #REQUIRED size NMTOKEN #IMPLIED>
]>
<envelope>
  <metadata/>
  <body>
    <message>first&#x0A;second&#x0D;third</message>
    <attachment name="résumé.txt" size="0042"/>
    <message>after attachment</message>
  </body>
</envelope>