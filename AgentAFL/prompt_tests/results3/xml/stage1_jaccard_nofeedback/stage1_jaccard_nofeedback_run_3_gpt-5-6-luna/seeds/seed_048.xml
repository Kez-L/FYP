<!DOCTYPE envelope [
  <!ELEMENT envelope (message)>
  <!ELEMENT message (from, to, payload)>
  <!ELEMENT from (#PCDATA)>
  <!ELEMENT to (#PCDATA)>
  <!ELEMENT payload ANY>
  <!ELEMENT data (#PCDATA)>
  <!ATTLIST message id ID #REQUIRED>
]>
<envelope>
  <message id="m0">
    <from>sender@example.test</from>
    <to>receiver@example.test</to>
    <payload>
      <data><![CDATA[&lt;not-an-element&gt;]]></data>
      <data>left &lt; right &amp;&amp; right &gt; left</data>
    </payload>
  </message>
</envelope>