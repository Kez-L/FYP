<?xml version="1.0"?>
<!DOCTYPE package [
  <!ELEMENT package (manifest, content)>
  <!ELEMENT manifest (entry*)>
  <!ELEMENT entry EMPTY>
  <!ATTLIST entry path CDATA #REQUIRED media CDATA #IMPLIED>
  <!ELEMENT content (section+)>
  <!ELEMENT section (heading, paragraph*)>
  <!ELEMENT heading (#PCDATA)>
  <!ELEMENT paragraph (#PCDATA|quote|list)*>
  <!ELEMENT quote (#PCDATA)>
  <!ELEMENT list (item+)>
  <!ELEMENT item (#PCDATA)>
  <!ENTITY % switches 'INCLUDE'>
  <![%switches;[
    <!ATTLIST package version CDATA "1.0">
  ]]>
]>
<package version="2.7">
  <manifest>
    <entry path="a/b/c.txt" media="text/plain"/>
    <entry path="./data.xml"/>
  </manifest>
  <content>
    <section>
      <heading>Overview</heading>
      <paragraph>Text before <quote>quoted &lt;material&gt;</quote> and after.</paragraph>
      <paragraph>
        <list>
          <item>first</item>
          <item><![CDATA[second <item>]]></item>
        </list>
      </paragraph>
    </section>
  </content>
</package>