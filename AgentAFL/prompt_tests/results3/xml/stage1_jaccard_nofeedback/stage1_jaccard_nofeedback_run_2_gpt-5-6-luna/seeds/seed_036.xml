<!DOCTYPE envelope [
  <!ELEMENT envelope (header, payload, trailer)>
  <!ELEMENT header (version, token?)>
  <!ELEMENT version (#PCDATA)>
  <!ELEMENT token (#PCDATA)>
  <!ELEMENT payload ANY>
  <!ELEMENT trailer EMPTY>
  <!ATTLIST envelope mode (strict|loose) "strict">
  <!ENTITY left "<part>">
  <!ENTITY right "</part>">
]>
<envelope mode="loose">
  <header>
    <version>1&amp;2</version>
    <token><![CDATA[&left;not-expanded&right;]]></token>
  </header>
  <payload>&left;content&right;</payload>
  <trailer/>
</envelope>