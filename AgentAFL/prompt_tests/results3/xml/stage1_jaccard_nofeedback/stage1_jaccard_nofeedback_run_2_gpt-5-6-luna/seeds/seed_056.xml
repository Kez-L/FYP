<?xml version="1.0"?>
<!DOCTYPE envelope [
  <!ELEMENT envelope (header, payload, trailer?)>
  <!ELEMENT header EMPTY>
  <!ELEMENT payload (#PCDATA|chunk)*>
  <!ELEMENT chunk (#PCDATA)>
  <!ELEMENT trailer (#PCDATA)>
  <!ATTLIST header version NMTOKEN #REQUIRED>
  <!ENTITY marker "inside-entity">
]>
<envelope>
  <header version="v2"/>
  <payload>
    before &marker;
    <chunk><![CDATA[]]></chunk>
    <chunk>text &lt; text &amp; text</chunk>
    after
  </payload>
  <trailer>done</trailer>
</envelope>