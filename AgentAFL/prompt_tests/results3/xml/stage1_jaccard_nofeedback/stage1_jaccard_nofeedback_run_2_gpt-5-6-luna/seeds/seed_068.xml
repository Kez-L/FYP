<?xml version="1.0"?>
<!DOCTYPE report [
  <!ENTITY % common "<!ELEMENT report (summary, data)>">
  <!ENTITY % fields "<!ELEMENT data (field*)>">
  %common;
  %fields;
  <!ELEMENT summary (#PCDATA)>
  <!ELEMENT field (#PCDATA)>
  <!ATTLIST field name NMTOKEN #REQUIRED value CDATA #IMPLIED>
]>
<report>
  <summary>parameter entities in the internal subset</summary>
  <data>
    <field name="alpha" value="1">A</field>
    <field name="beta">B &amp; C</field>
    <field name="gamma" value="&#x0A;&#x09;">&#x3C;raw&#x3E;</field>
  </data>
</report>