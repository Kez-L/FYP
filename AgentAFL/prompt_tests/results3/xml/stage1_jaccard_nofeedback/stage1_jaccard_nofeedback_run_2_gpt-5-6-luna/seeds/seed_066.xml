<?xml version="1.0"?>
<!DOCTYPE message [
  <!ENTITY left  "&#x3C;">
  <!ENTITY right "&#x3E;">
  <!ENTITY quote "&#34;">
  <!ENTITY payload "&left;![CDATA[not markup &amp;]]&right;">
]>
<message xml:space="preserve">
  <header>
    <from address="sender@example.test"/>
    <to address="receiver@example.test"/>
    <subject>&quote;encoded&quote;</subject>
  </header>
  <body>
    <line>&payload;</line>
    <line><![CDATA[
      <embedded attr="1 & 2">literal</embedded>
    ]]></line>
    <attachments count="2">
      <attachment name="a.bin" type="application/octet-stream"/>
      <attachment name="b&amp;c.txt" type="text/plain"/>
    </attachments>
  </body>
</message>