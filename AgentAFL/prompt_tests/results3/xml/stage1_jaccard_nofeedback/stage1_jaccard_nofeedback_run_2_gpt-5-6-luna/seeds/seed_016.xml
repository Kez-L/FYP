<?xml version="1.0"?>
<!DOCTYPE report [
  <!ENTITY % common '
    <!ELEMENT report (header, section+)>
    <!ELEMENT header (name, revision)>
    <!ELEMENT name (#PCDATA)>
    <!ELEMENT revision (#PCDATA)>
    <!ELEMENT section (item*)>
    <!ELEMENT item (#PCDATA|note)*>
    <!ELEMENT note (#PCDATA)>
  '>
  %common;
  <!ATTLIST section code NMTOKEN #IMPLIED>
  <!ENTITY % extra '
    <!ATTLIST item priority CDATA "normal">
  '>
  %extra;
]>
<report>
  <header>
    <name>parameterized schema</name>
    <revision>r&amp;d-07</revision>
  </header>
  <section code="A_1">
    <item priority="urgent">alpha<note>nested note</note>omega</item>
    <item>beta</item>
  </section>
  <section code="B-2">
    <item><![CDATA[x]]></item>
  </section>
</report>