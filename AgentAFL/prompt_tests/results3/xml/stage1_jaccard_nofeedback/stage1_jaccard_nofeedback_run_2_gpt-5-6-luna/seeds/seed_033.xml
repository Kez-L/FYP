<?xml version="1.0"?>
<!DOCTYPE r:dashboard [
  <!ELEMENT r:dashboard (r:summary, r:panel*)>
  <!ELEMENT r:summary (#PCDATA)>
  <!ELEMENT r:panel (r:label, r:metric+, r:note?)>
  <!ELEMENT r:label (#PCDATA)>
  <!ELEMENT r:metric (#PCDATA)>
  <!ELEMENT r:note (#PCDATA)>
  <!ATTLIST r:dashboard xmlns:svg CDATA #IMPLIED>
  <!ATTLIST r:panel id ID #IMPLIED collapsed (yes|no) "no">
  <!ENTITY delta "Δ">
  <!ENTITY nbsp "&#160;">
]>
<r:dashboard xmlns:r="urn:example:report" xmlns:svg="http://www.w3.org/2000/svg"
             xml:lang="en" xml:base="https://example.test/reports/">
  <r:summary xml:space="preserve"> Status: &delta;&nbsp; nominal </r:summary>
  <r:panel id="cpu" collapsed="no">
    <r:label>CPU &amp; memory</r:label>
    <r:metric>usage=43%</r:metric>
    <r:metric>resident=128MiB</r:metric>
    <r:note><![CDATA[Use <svg:path/> only as literal text here.]]></r:note>
  </r:panel>
  <r:panel id="graph" collapsed="yes">
    <r:label>Vector preview</r:label>
    <r:metric>
      <svg:svg width="10" height="10">
        <svg:circle cx="5" cy="5" r="4"/>
      </svg:svg>
    </r:metric>
  </r:panel>
</r:dashboard>