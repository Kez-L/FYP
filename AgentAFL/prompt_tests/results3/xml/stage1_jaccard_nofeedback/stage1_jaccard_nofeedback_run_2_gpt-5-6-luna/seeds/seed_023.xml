<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE report [
  <!ENTITY % declarations '
    <!ELEMENT report (section+)>
    <!ELEMENT section (heading, paragraph+, table?)>
    <!ATTLIST section name CDATA #IMPLIED>
    <!ELEMENT heading (#PCDATA)>
    <!ELEMENT paragraph (#PCDATA|break|link)*>
    <!ELEMENT break EMPTY>
    <!ELEMENT link (#PCDATA)>
    <!ATTLIST link href URI #REQUIRED>
    <!ELEMENT table (row+)>
    <!ELEMENT row (cell+)>
    <!ELEMENT cell (#PCDATA)>
  '>
  %declarations;
]>
<report>
  <section name="overview">
    <heading>Overview</heading>
    <paragraph>First <link href="urn:test:item">reference</link><break/>continues.</paragraph>
    <paragraph>Second paragraph.</paragraph>
    <table>
      <row><cell>A</cell><cell>B</cell></row>
      <row><cell>1</cell><cell>2</cell></row>
    </table>
  </section>
</report>