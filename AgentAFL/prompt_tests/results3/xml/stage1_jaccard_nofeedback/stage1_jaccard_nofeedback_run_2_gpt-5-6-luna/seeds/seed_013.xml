<?xml version="1.0"?>
<configuration>
  <profiles>
    <profile name="default">
      <option key="mode" value="safe"/>
      <option key="limit" value="0"/>
    </profile>
    <profile name="experimental">
      <option key="mode">fast</option>
      <option key="features">
        <feature enabled="yes">streaming</feature>
        <feature enabled="no">legacy</feature>
      </option>
    </profile>
  </profiles>
  <paths>
    <path kind="input">./data/</path>
    <path kind="output"/>
  </paths>
  <empty/>
</configuration>