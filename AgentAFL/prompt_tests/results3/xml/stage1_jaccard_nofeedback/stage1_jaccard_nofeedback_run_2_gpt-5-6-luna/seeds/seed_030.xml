<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE catalog [
  <!ELEMENT catalog (section+, footer?)>
  <!ELEMENT section (title, item*)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT item (name, description?, price)>
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT description (#PCDATA|emph|code)*>
  <!ELEMENT emph (#PCDATA)>
  <!ELEMENT code (#PCDATA)>
  <!ELEMENT price (#PCDATA)>
  <!ELEMENT footer (#PCDATA)>
  <!ATTLIST catalog version NMTOKEN #REQUIRED>
  <!ATTLIST section id ID #IMPLIED>
  <!ATTLIST item ref ID #IMPLIED state (new|used|archived) "new">
  <!ENTITY company "A &amp; B Trading">
  <!ENTITY notice "Prices are subject to change.">
]>
<catalog version="2">
  <section id="featured">
    <title>&company;: featured goods</title>
    <item ref="p1">
      <name>Glass &lt;Widget&gt;</name>
      <description>Clear <emph>and</emph> durable; use <code>--safe</code>.</description>
      <price>19.95</price>
    </item>
    <item ref="p2" state="used">
      <name>Second-hand device</name>
      <description><![CDATA[Contains text like <tags>, &entities;, and ]]> safely.</description>
      <price>7.00</price>
    </item>
  </section>
  <footer>&notice;</footer>
</catalog>