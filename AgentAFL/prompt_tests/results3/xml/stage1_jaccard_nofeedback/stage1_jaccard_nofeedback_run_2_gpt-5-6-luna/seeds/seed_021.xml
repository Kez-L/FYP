<?xml version="1.0"?>
<!DOCTYPE inventory [
  <!ELEMENT inventory (warehouse+)>
  <!ELEMENT warehouse (bin*)>
  <!ATTLIST warehouse code ID #REQUIRED>
  <!ELEMENT bin (item|empty)>
  <!ATTLIST bin label CDATA #IMPLIED>
  <!ELEMENT item (#PCDATA)>
  <!ELEMENT empty EMPTY>
]>
<inventory>
  <warehouse code="west">
    <bin label="01"><item>bolt</item></bin>
    <bin label="02"><empty/></bin>
  </warehouse>
  <warehouse code="east">
    <bin><item>nut &amp; washer</item></bin>
  </warehouse>
</inventory>