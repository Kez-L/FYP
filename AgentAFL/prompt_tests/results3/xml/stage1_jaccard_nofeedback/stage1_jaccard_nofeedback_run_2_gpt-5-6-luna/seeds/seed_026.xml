<?xml version="1.0"?>
<!DOCTYPE archive [
  <!ELEMENT archive (record+)>
  <!ELEMENT record (label, payload, checksum?)>
  <!ATTLIST record code ID #REQUIRED>
  <!ELEMENT label (#PCDATA)>
  <!ELEMENT payload (#PCDATA|part)*>
  <!ELEMENT part (#PCDATA|part)*>
  <!ELEMENT checksum (#PCDATA)>
  <!ENTITY left "[" >
  <!ENTITY right "]" >
]>
<archive>
  <record code="r1">
    <label>&left;alpha&right;</label>
    <payload>one<part>two<part>three</part></part>four</payload>
    <checksum>abc&amp;123</checksum>
  </record>
  <record code="r2">
    <label>empty</label>
    <payload><![CDATA[raw &entity; text]]></payload>
  </record>
</archive>