<?xml version="1.1"?>
<!DOCTYPE message [
  <!ELEMENT message (header, body, footer?)>
  <!ELEMENT header (subject, recipient+)>
  <!ELEMENT subject (#PCDATA)>
  <!ELEMENT recipient EMPTY>
  <!ATTLIST recipient address CDATA #REQUIRED kind (to|cc|bcc) "to">
  <!ELEMENT body (#PCDATA|line|emphasis)*>
  <!ELEMENT line (#PCDATA|emphasis)*>
  <!ELEMENT emphasis (#PCDATA)>
  <!ELEMENT footer (#PCDATA)>
  <!ENTITY nbsp "&#160;">
]>
<message>
  <header>
    <subject>Quarterly &amp; Review</subject>
    <recipient address="alice@example.test"/>
    <recipient address="ops@example.test" kind="cc"/>
  </header>
  <body>First line<line>Second <emphasis>important</emphasis> line</line>Third&nbsp;line</body>
  <footer>Generated at 2026-09-24</footer>
</message>