<?xml version="1.0"?>
<!DOCTYPE archive [
  <!ELEMENT archive (record+)>
  <!ELEMENT record (title, payload)>
  <!ATTLIST record id ID #REQUIRED category NMTOKEN #IMPLIED>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT payload (#PCDATA|chunk)*>
  <!ELEMENT chunk (#PCDATA)>
  <!ENTITY label "embedded-mark">
]>
<archive>
  <record id="r1" category="alpha">
    <title>First &label; Record</title>
    <payload>prefix<chunk>one</chunk>middle<chunk>two &amp; three</chunk>suffix</payload>
  </record>
  <record id="r2">
    <title>Second Record</title>
    <payload><chunk><![CDATA[x<y>z]]></chunk></payload>
  </record>
</archive>