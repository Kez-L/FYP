<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE package [
  <!NOTATION png SYSTEM "image/png">
  <!ENTITY logo SYSTEM "logo.png" NDATA png>
  <!ENTITY text "line-one&#xA;line-two">
  <!ATTLIST asset format NOTATION (png) #IMPLIED>
]>
<package xmlns:p="urn:package" version="2.0">
  <p:manifest>
    <p:asset id="logo" format="png"/>
    <p:asset id="readme" format="text">
      <p:content>&text;</p:content>
    </p:asset>
  </p:manifest>
  <p:metadata>
    <p:entry key="quoted" value="&quot;value&quot;"/>
    <p:entry key="apostrophe" value="&apos;value&apos;"/>
  </p:metadata>
  <p:binary ref="logo"/>
</package>