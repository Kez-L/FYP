<?xml version="1.1" encoding="UTF-8"?>
<!DOCTYPE root [
  <!ELEMENT root (section+)>
  <!ELEMENT section (entry*, section?)>
  <!ELEMENT entry (#PCDATA)>
  <!ATTLIST entry key ID #IMPLIED ref IDREF #IMPLIED>
]>
<root xmlns="urn:tree" xmlns:x="urn:aux" xml:base="https://example.test/a/">
  <section id="outer">
    <entry key="first">one&#x85;two&#x2028;three</entry>
    <section id="inner" xml:lang="fr">
      <entry key="second" ref="first">deux</entry>
      <entry x:flag="yes"><![CDATA[x < y && y < z]]></entry>
    </section>
  </section>
  <section id="empty">
    <entry key="last" xml:space="default">tail</entry>
  </section>
</root>