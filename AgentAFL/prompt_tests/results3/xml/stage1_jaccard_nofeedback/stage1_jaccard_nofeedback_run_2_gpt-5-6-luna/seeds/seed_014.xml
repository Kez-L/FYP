<?xml version="1.0"?>
<!DOCTYPE packet [
  <!ELEMENT packet (header, body, footer)>
  <!ELEMENT header (field*)>
  <!ELEMENT field EMPTY>
  <!ATTLIST field name CDATA #REQUIRED value CDATA #IMPLIED>
  <!ELEMENT body (#PCDATA|section)*>
  <!ELEMENT section (line*)>
  <!ELEMENT line (#PCDATA)>
  <!ELEMENT footer EMPTY>
]>
<packet version="2">
  <header>
    <field name="source" value="sensor-7"/>
    <field name="checksum"/>
  </header>
  <body>
    <section id="A">
      <line>alpha</line>
      <line><![CDATA[beta ]]> gamma]]></line>
    </section>
    <section id="B">
      <line>delta &quot;epsilon&quot;</line>
    </section>
  </body>
  <footer/>
</packet>