<?xml version="1.0"?>
<!DOCTYPE report [
  <!ELEMENT report (section+)>
  <!ELEMENT section (header, body)>
  <!ELEMENT header (#PCDATA)>
  <!ELEMENT body (#PCDATA|note)*>
  <!ELEMENT note (#PCDATA)>
  <!ATTLIST section code ID #REQUIRED>
  <!ENTITY plain "left &lt; right &amp; center">
  <!ENTITY quoted "one &quot;two&quot; three">
  <!ENTITY % common "section">
  <!ENTITY % injected "<!ELEMENT appendix (#PCDATA)>">
  %injected;
]>
<report>
  <section code="s1">
    <header>&plain;</header>
    <body>alpha<note>&quoted;</note>omega</body>
  </section>
  <appendix>tail</appendix>
</report>