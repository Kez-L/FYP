<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE catalog [
  <!ELEMENT catalog (entry+)>
  <!ELEMENT entry (title, description, metadata?)>
  <!ATTLIST entry id ID #REQUIRED status (new|old|archived) "new">
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT description (#PCDATA|em|br)*>
  <!ELEMENT em (#PCDATA)>
  <!ELEMENT br EMPTY>
  <!ELEMENT metadata (tag*)>
  <!ELEMENT tag (#PCDATA)>
  <!ENTITY copyright "&#xA9; 2026">
]>
<catalog xmlns="urn:seed:catalog" xml:lang="en">
  <!-- mixed content, namespaces, and defaulted attributes -->
  <entry id="item-α">
    <title>Boundary &amp; Signals</title>
    <description><![CDATA[
      text before <em>markup</em> and ]]> text after
      <em>emphasis &lt;inside&gt;</em><br/>
      &copyright;
    </description>
    <metadata>
      <tag>one</tag>
      <tag><![CDATA[two & three]]></tag>
    </metadata>
  </entry>
</catalog>