<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE catalog [
  <!ELEMENT catalog (item+, metadata?)>
  <!ELEMENT item (name, description, price, tags)>
  <!ATTLIST item id ID #REQUIRED status (new|used|archived) "new">
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT description (#PCDATA|em|br)*>
  <!ELEMENT em (#PCDATA)>
  <!ELEMENT br EMPTY>
  <!ELEMENT price (#PCDATA)>
  <!ELEMENT tags (tag*)>
  <!ELEMENT tag (#PCDATA)>
  <!ELEMENT metadata EMPTY>
  <!ATTLIST metadata source CDATA "generated">
]>
<catalog xmlns="urn:example:catalog" xml:lang="en">
  <item id="i001" status="new">
    <name>R&amp;D toolkit</name>
    <description>Compact <em>parser</em><br/>with edge cases.</description>
    <price>19.95</price>
    <tags>
      <tag>xml</tag>
      <tag>fuzzing</tag>
    </tags>
  </item>
  <metadata source="seed"/>
</catalog>