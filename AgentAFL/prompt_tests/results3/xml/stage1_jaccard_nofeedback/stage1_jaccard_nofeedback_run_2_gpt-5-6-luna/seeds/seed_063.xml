<!DOCTYPE archive [
  <!ELEMENT archive (record*)>
  <!ELEMENT record (title, data, checksum)>
  <!ATTLIST record id ID #REQUIRED category CDATA "general">
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT data (#PCDATA|chunk)*>
  <!ELEMENT chunk (#PCDATA)>
  <!ELEMENT checksum (#PCDATA)>
  <!ENTITY left-bracket "&#91;">
  <!ENTITY right-bracket "&#93;">
]>
<archive>
  <record id="r1" category="binary">
    <title>Packet &quot;one&quot;</title>
    <data>
      <chunk>alpha</chunk>
      <chunk>&left-bracket;beta&amp;gamma&right-bracket;</chunk>
      <chunk><![CDATA[delta]]></chunk>
    </data>
    <checksum>sha256:00000000000000000000000000000000</checksum>
  </record>
  <record id="r2">
    <title>Empty payload</title>
    <data/>
    <checksum>none</checksum>
  </record>
</archive>