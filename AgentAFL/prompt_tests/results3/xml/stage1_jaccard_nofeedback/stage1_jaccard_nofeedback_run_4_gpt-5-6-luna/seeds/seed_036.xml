<?xml version="1.0"?>
<!DOCTYPE archive [
  <!ELEMENT archive (entry+, trailer?)>
  <!ELEMENT entry (title, payload, note?)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT payload (#PCDATA|chunk)*>
  <!ELEMENT chunk (#PCDATA)>
  <!ELEMENT note (#PCDATA)>
  <!ELEMENT trailer EMPTY>
  <!ATTLIST entry key ID #REQUIRED>
  <!ATTLIST entry state (new|old|held) "new">
  <!ENTITY mark "&#x2603;">
  <!ENTITY fragment "<chunk>embedded &amp; marked</chunk>">
]>
<archive>
  <entry key="e1" state="held">
    <title>First &mark; record</title>
    <payload>before &fragment; after</payload>
    <note xml:lang="fr">résumé</note>
  </entry>
  <entry key="e2">
    <title>Second</title>
    <payload><chunk>one</chunk><chunk><![CDATA[two]]></chunk></payload>
  </entry>
  <trailer/>
</archive>