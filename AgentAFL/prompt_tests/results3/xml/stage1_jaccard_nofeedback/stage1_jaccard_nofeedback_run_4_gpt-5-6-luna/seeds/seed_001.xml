<?xml version="1.0"?>
<!DOCTYPE archive [
  <!ELEMENT archive (record+)>
  <!ELEMENT record (name, value, note?)>
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT value (#PCDATA)>
  <!ELEMENT note (#PCDATA|em|br)*>
  <!ELEMENT em (#PCDATA)>
  <!ELEMENT br EMPTY>
  <!ATTLIST record kind (alpha|beta|gamma) "alpha">
  <!ENTITY copyright "&#169; 2026">
]>
<archive>
  <record kind="beta">
    <name>first</name>
    <value>&lt;payload&gt; &amp; &quot;quoted&quot;</value>
    <note>Use <em>carefully</em><br/>and verify &copyright;.</note>
  </record>
  <record>
    <name>second</name>
    <value><![CDATA[line one
line two
]]></value>
  </record>
</archive>