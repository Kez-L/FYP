<?xml version="1.0"?>
<!DOCTYPE report [
  <!ELEMENT report (section+, footer?)>
  <!ELEMENT section (title, paragraph*)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT paragraph (#PCDATA|em|br)*>
  <!ELEMENT em (#PCDATA|em|br)*>
  <!ELEMENT br EMPTY>
  <!ELEMENT footer (#PCDATA)>
  <!ATTLIST section code ID #REQUIRED>
  <!ATTLIST paragraph level (low|normal|high) "normal">
  <!NOTATION text SYSTEM "text/plain">
]>
<report>
  <section code="s1">
    <title>Introduction</title>
    <paragraph level="high">A <em>nested <em>emphasis</em></em><br/>line.</paragraph>
  </section>
  <section code="s2">
    <title><![CDATA[Details ]]> <![CDATA[and conclusions]]></title>
    <paragraph>tail</paragraph>
  </section>
  <footer>Generated &#x20;today</footer>
</report>