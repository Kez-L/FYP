<?xml version="1.0"?>
<!DOCTYPE report [
  <!ELEMENT report (header, section+)>
  <!ELEMENT header (title, generated)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT generated EMPTY>
  <!ELEMENT section (entry*)>
  <!ELEMENT entry (#PCDATA|value)*>
  <!ELEMENT value (#PCDATA)>
  <!ATTLIST section name CDATA #REQUIRED>
  <!ENTITY company "Northwind &amp; Partners">
  <!ENTITY % optional "<!ELEMENT appendix (#PCDATA)>">
  %optional;
]>
<report>
  <header>
    <title>&company;</title>
    <generated/>
  </header>
  <section name="first">
    <entry>plain <value>42</value> text</entry>
    <entry><![CDATA[raw ]]> data</entry>
  </section>
  <section name="empty"/>
</report>