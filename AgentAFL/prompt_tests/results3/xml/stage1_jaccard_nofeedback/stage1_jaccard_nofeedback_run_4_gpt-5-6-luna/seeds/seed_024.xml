<?xml version="1.0"?>
<!DOCTYPE envelope [
  <!ELEMENT envelope (header?, body, trailer?)>
  <!ELEMENT header EMPTY>
  <!ELEMENT body (message|attachment|message-group)+>
  <!ELEMENT message (#PCDATA|link)*>
  <!ELEMENT link EMPTY>
  <!ELEMENT attachment (#PCDATA)>
  <!ELEMENT message-group (message+)>
  <!ELEMENT trailer (#PCDATA)>
  <!ATTLIST envelope version CDATA #IMPLIED>
  <!ATTLIST header signature CDATA #IMPLIED>
  <!ATTLIST link href CDATA #REQUIRED>
  <!ENTITY nbsp "&#160;">
]>
<envelope version="2">
  <header signature="a&quot;b"/>
  <body>
    <message>Hello&nbsp;<link href="urn:test"/></message>
    <message-group>
      <message>nested one</message>
      <message>nested two<attachment>payload &amp; tail</attachment></message>
    </message-group>
    <attachment><![CDATA[
      binary-like: \x00 \xFF
    ]]></attachment>
  </body>
  <trailer>done</trailer>
</envelope>