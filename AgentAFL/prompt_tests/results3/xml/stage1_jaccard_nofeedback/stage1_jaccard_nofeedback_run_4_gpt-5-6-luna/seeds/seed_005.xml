<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE catalog [
  <!ELEMENT catalog (item+, note?)>
  <!ELEMENT item (title, details, payload)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT details (#PCDATA|em|br)*>
  <!ELEMENT em (#PCDATA)>
  <!ELEMENT br EMPTY>
  <!ELEMENT payload (#PCDATA)>
  <!ELEMENT note (#PCDATA)>
  <!ATTLIST item id ID #REQUIRED kind (alpha|beta|gamma) "alpha">
  <!ATTLIST item ref IDREF #IMPLIED>
  <!ENTITY mark "&#x2063;">
  <!ENTITY amp "&amp;">
  <!ENTITY phrase "left &mark; right">
]>
<catalog xml:lang="en" xml:base="urn:seed:one">
  <item id="i1" kind="beta">
    <title>Entities &amp; character references &#x41;</title>
    <details xml:space="preserve">A<em>&phrase;</em><br/>B&amp;C</details>
    <payload><![CDATA[<not-an-element attr="&mark;">]]></payload>
  </item>
  <item id="i2" ref="i1">
    <title>Second item</title>
    <details>mixed <em>content</em> with &amp; and &quot;quotes&quot;</details>
    <payload>tail&mark;</payload>
  </item>
  <note>catalog-end</note>
</catalog>