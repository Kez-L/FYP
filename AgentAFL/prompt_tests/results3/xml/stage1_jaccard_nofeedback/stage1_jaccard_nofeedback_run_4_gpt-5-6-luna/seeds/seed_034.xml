<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE report [
  <!ELEMENT report (header, data)>
  <!ELEMENT header (name, note?)>
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT note (#PCDATA)>
  <!ELEMENT data (row+)>
  <!ELEMENT row (cell*)>
  <!ELEMENT cell (#PCDATA)>
  <!ATTLIST row index CDATA #IMPLIED>
]>
<report>
  <header>
    <name>broken-boundary</name>
    <note><![CDATA[unterminated-looking text ]]> and entities &amp; symbols</note>
  </header>
  <data>
    <row index="0"><cell>a</cell><cell>b</cell><cell><![CDATA[c<d>e]]></cell></row>
    <row index="1"><cell>one</cell><cell>two</cell></row>
  </data>
</report>