<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE report [
  <!ELEMENT report (header, section+, footer?)>
  <!ELEMENT header (#PCDATA)>
  <!ELEMENT section (title, item*)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT item (#PCDATA)>
  <!ELEMENT footer (#PCDATA)>
  <!ATTLIST section level (low|medium|high) "low">
  <!ENTITY notice "Use &quot;quoted&quot; text &amp; symbols.">
]>
<report>
  <header>&notice;</header>
  <section level="high">
    <title>First section</title>
    <item>alpha</item>
    <item><![CDATA[beta < gamma && delta > epsilon]]></item>
  </section>
  <section level="medium">
    <title>Second section</title>
  </section>
  <footer>End</footer>
</report>