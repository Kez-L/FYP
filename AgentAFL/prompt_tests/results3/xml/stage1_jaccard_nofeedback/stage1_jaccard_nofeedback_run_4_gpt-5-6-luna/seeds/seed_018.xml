<?xml version="1.0"?>
<!DOCTYPE config [
  <!ELEMENT config (section*)>
  <!ELEMENT section (setting|section)*>
  <!ATTLIST section name CDATA #REQUIRED>
  <!ELEMENT setting EMPTY>
  <!ATTLIST setting
    key CDATA #REQUIRED
    value CDATA #IMPLIED
    enabled (yes|no) "yes"
  >
  <!ENTITY quotemark "&quot;">
]>
<config>
  <section name="outer">
    <setting key="path" value="/tmp/a&amp;b" enabled="no"/>
    <section name="inner">
      <setting key="empty"/>
      <setting key="quote" value="&quot;quoted&quot;"/>
      <setting key="unicode" value="caf&#xE9; &#x1F600;"/>
    </section>
  </section>
  <section name="&#x0A;whitespace&#x0D;">
    <setting key="spaces" value="  leading and trailing  "/>
  </section>
</config>