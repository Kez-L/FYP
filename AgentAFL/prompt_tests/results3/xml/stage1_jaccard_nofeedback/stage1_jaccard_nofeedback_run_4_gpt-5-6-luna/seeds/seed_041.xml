<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE report [
  <!ELEMENT report (header, section+)>
  <!ELEMENT header (#PCDATA)>
  <!ELEMENT section (entry*)>
  <!ELEMENT entry (#PCDATA|value)*>
  <!ELEMENT value EMPTY>
  <!ATTLIST entry kind (short|long|other) "other">
  <!ATTLIST value unit CDATA #IMPLIED>
  <!ENTITY marker "&#x3C;marker&#x3E;">
  <!NOTATION bin SYSTEM "application/octet-stream">
  <!ENTITY payload SYSTEM "sample.bin" NDATA bin>
]>
<report>
  <header>&marker;</header>
  <section>
    <entry kind="short">one<value unit="ms"/>two</entry>
    <entry kind="other">&amp;&quot;&apos;</entry>
  </section>
</report>