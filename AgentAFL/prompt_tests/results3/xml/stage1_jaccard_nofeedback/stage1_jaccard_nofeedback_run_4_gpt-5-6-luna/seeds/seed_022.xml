<?xml version="1.0" standalone="yes"?>
<!DOCTYPE media [
  <!ELEMENT media (asset+, manifest)>
  <!ELEMENT asset EMPTY>
  <!ELEMENT manifest (checksum*)>
  <!ELEMENT checksum (#PCDATA)>
  <!ATTLIST asset
            name CDATA #REQUIRED
            format (png|svg|bin) "bin"
            payload ENTITY #IMPLIED>
  <!ATTLIST manifest verified (yes|no) "no">
  <!NOTATION binary SYSTEM "application/octet-stream">
  <!ENTITY icon SYSTEM "icon.svg" NDATA binary>
]>
<media>
  <asset name="logo" format="svg" payload="icon"/>
  <asset name="blob"/>
  <manifest verified="yes">
    <checksum algorithm="sha256">not-an-attribute</checksum>
  </manifest>
</media>