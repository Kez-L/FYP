<?xml version="1.0"?>
<!DOCTYPE envelope [
  <!NOTATION jpeg SYSTEM "image/jpeg">
  <!ENTITY logo SYSTEM "logo.jpeg" NDATA jpeg>
  <!ELEMENT envelope (payload, attachment*)>
  <!ELEMENT payload EMPTY>
  <!ELEMENT attachment EMPTY>
  <!ATTLIST payload type CDATA #IMPLIED>
  <!ATTLIST attachment href ENTITY #REQUIRED>
]>
<envelope>
  <payload type="application/octet-stream"/>
  <attachment href="logo"/>
</envelope>