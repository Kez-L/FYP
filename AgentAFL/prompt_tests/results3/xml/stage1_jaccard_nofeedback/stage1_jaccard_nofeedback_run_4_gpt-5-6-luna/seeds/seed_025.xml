<?xml version="1.0"?>
<!DOCTYPE catalog [
  <!ELEMENT catalog (section+)>
  <!ELEMENT section (title, item+)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT item (name, description?, price)>
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT description (#PCDATA|emph|code)*>
  <!ELEMENT emph (#PCDATA)>
  <!ELEMENT code (#PCDATA)>
  <!ELEMENT price (#PCDATA)>
  <!ATTLIST section id ID #REQUIRED category (hardware|software|mixed) "mixed">
  <!ATTLIST item sku ID #REQUIRED related IDREFS #IMPLIED status CDATA "active">
  <!ENTITY product "libxml2">
  <!ENTITY mark "&#x2603;">
]>
<catalog>
  <section id="s-main" category="software">
    <title>&product; &mark; catalog</title>
    <item sku="p-one" status="active">
      <name>Parser</name>
      <description>Handles <emph>nested</emph> markup and <code>CDATA</code>.</description>
      <price>0.00</price>
    </item>
    <item sku="p-two" related="p-one">
      <name>Validator</name>
      <description>Checks mixed content, comments, and references.</description>
      <price>17.5</price>
    </item>
  </section>
</catalog>