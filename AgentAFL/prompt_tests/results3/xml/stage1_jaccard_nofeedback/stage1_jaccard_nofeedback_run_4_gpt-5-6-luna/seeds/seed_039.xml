<?xml version="1.0"?>
<!DOCTYPE report [
  <!ELEMENT report (section|separator)*>
  <!ELEMENT section (heading, body)>
  <!ELEMENT heading (#PCDATA)>
  <!ELEMENT body (#PCDATA|line|br)*>
  <!ELEMENT line (#PCDATA|emph)*>
  <!ELEMENT emph (#PCDATA)>
  <!ELEMENT br EMPTY>
  <!ELEMENT separator EMPTY>
  <!ATTLIST section id NMTOKEN #IMPLIED>
]>
<report>
  <section id="intro">
    <heading>Overview</heading>
    <body>
      <line>Plain <emph>emphasis</emph> and more</line>
      <br/>
      <line><![CDATA[x < y && y < z]]></line>
    </body>
  </section>
  <separator/>
  <section>
    <heading>尾部</heading>
    <body>αβγ<line>δ</line>終</body>
  </section>
</report>