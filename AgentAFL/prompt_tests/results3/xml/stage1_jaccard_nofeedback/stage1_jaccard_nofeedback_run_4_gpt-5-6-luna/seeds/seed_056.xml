<?xml version="1.0"?>
<!DOCTYPE report [
  <!ELEMENT report (header, body, footer)>
  <!ELEMENT header (title, author+)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT author (#PCDATA)>
  <!ELEMENT body (paragraph | table | note)*>
  <!ELEMENT paragraph (#PCDATA | strong | link)*>
  <!ELEMENT strong (#PCDATA)>
  <!ELEMENT link (#PCDATA)>
  <!ELEMENT table (row+)>
  <!ELEMENT row (cell+)>
  <!ELEMENT cell (#PCDATA)>
  <!ELEMENT note (#PCDATA)>
  <!ELEMENT footer (#PCDATA)>
]>
<report>
  <header>
    <title>Quarterly &amp; Final Results</title>
    <author>R&amp;D</author>
    <author>QA</author>
  </header>
  <body>
    <paragraph>First <strong>important</strong> paragraph with a <link>reference</link>.</paragraph>
    <table>
      <row><cell>name</cell><cell>value</cell></row>
      <row><cell>alpha</cell><cell>42</cell></row>
    </table>
    <note><![CDATA[Use <row> elements only inside tables.]]></note>
  </body>
  <footer>End</footer>
</report>