<?xml version="1.0"?>
<!DOCTYPE matrix [
  <!ELEMENT matrix (row+)>
  <!ELEMENT row (cell+)>
  <!ELEMENT cell (#PCDATA)>
  <!ATTLIST row index CDATA #IMPLIED>
  <!ATTLIST cell colspan CDATA "1">
  <!ENTITY quote "&quot;">
  <!ENTITY lt "&lt;">
]>
<matrix>
  <row index="0">
    <cell colspan="2">a</cell>
    <cell>b &quote; c</cell>
    <cell><![CDATA[]]></cell>
  </row>
  <row index="1">
    <cell>&lt;escaped&gt;</cell>
    <cell colspan="0">zero</cell>
  </row>
  <row index="2">
    <cell><![CDATA[split ]]]]><![CDATA[> marker]]></cell>
    <cell>after</cell>
  </row>
</matrix>