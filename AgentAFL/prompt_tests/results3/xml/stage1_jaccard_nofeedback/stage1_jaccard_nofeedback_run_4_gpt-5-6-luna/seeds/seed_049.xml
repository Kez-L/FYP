<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE form [
  <!ELEMENT form (section+)>
  <!ELEMENT section (label, field*)>
  <!ATTLIST section name CDATA #REQUIRED>
  <!ELEMENT label (#PCDATA)>
  <!ELEMENT field (#PCDATA)>
  <!ATTLIST field
    key ID #IMPLIED
    type (text|number|hidden) "text"
    required (yes|no) "no">
  <!ENTITY amp "&#38;">
  <!ENTITY nested "value-&amp;-tail">
]>
<form>
  <section name="general">
    <label>General &nested;</label>
    <field key="f1" type="text" required="yes">one</field>
    <field key="f2" type="number">42</field>
  </section>
  <section name="advanced">
    <label><![CDATA[raw ]]> &amp; encoded</label>
    <field type="hidden"/>
    <field key="f3">line1
line2</field>
  </section>
</form>