<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE knowledge [
  <!ELEMENT knowledge (topic+)>
  <!ELEMENT topic (term, definition, related*)>
  <!ATTLIST topic id ID #REQUIRED level (introductory|advanced) #IMPLIED>
  <!ELEMENT term (#PCDATA)>
  <!ELEMENT definition (#PCDATA|code|link)*>
  <!ELEMENT code (#PCDATA)>
  <!ELEMENT link (#PCDATA)>
  <!ATTLIST link target IDREF #IMPLIED href CDATA #IMPLIED>
  <!ELEMENT related EMPTY>
  <!ATTLIST related ref IDREF #REQUIRED relation (broader|narrower|see-also) #REQUIRED>
  <!ENTITY lt "&amp;lt;">
]>
<knowledge xmlns="urn:notes:knowledge"
           xmlns:doc="urn:notes:document"
           xml:base="https://notes.example.invalid/library/">
  <topic id="xml" level="introductory">
    <term>XML</term>
    <definition>A markup language for structured documents; literal syntax includes <code>&lt;element&gt;</code> and escaped characters.</definition>
    <related ref="namespaces" relation="narrower"/>
    <related ref="parsing" relation="see-also"/>
  </topic>
  <topic id="namespaces" level="advanced">
    <term>Namespaces</term>
    <definition>Names combine a URI with a local name. See <link href="chapters/ns.html#qnames">qualified names</link>.</definition>
    <related ref="xml" relation="broader"/>
  </topic>
  <topic id="parsing" level="advanced">
    <term>Parsing</term>
    <definition><![CDATA[Applications may inspect a tree, stream events, or preserve lexical details.]]></definition>
    <related ref="namespaces" relation="see-also"/>
  </topic>
  <doc:revision doc:number="12" doc:editor="M. Ito"/>
</knowledge>