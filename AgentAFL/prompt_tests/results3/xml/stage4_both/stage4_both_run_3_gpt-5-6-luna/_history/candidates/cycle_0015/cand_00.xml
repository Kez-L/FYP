<?xml version="1.1"?>
<!DOCTYPE catalog [
  <!ELEMENT catalog (section+)>
  <!ELEMENT section (title, item*)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT item (#PCDATA)>
  <!ATTLIST item code ID #REQUIRED>
  <!ENTITY company "Example &amp; Sons">
  <!ENTITY notice "Prices include &company; handling.">
]>
<catalog>
  <section>
    <title>Hardware</title>
    <item code="cpu">Central processor</item>
    <item code="ram">Memory module</item>
    <item code="disk">&notice;</item>
  </section>
  <section>
    <title>Accessories</title>
    <item code="cable">USB-C &lt;-&gt; HDMI</item>
  </section>
</catalog>