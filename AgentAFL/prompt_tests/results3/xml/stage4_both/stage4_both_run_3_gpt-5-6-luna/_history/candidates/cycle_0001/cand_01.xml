<?xml version="1.0"?>
<!DOCTYPE report [
  <!ENTITY company "Northwind &amp; Sons">
  <!ENTITY note "This text contains a &quot;quoted&quot; value.">
  <!ELEMENT report (header, body, footer)>
  <!ELEMENT header (title, meta*)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT meta EMPTY>
  <!ATTLIST meta key NMTOKEN #REQUIRED value CDATA #IMPLIED>
  <!ELEMENT body (paragraph|table|warning)*>
  <!ELEMENT paragraph (#PCDATA|strong|code|br)*>
  <!ELEMENT strong (#PCDATA)>
  <!ELEMENT code (#PCDATA)>
  <!ELEMENT br EMPTY>
  <!ELEMENT table (row+)>
  <!ELEMENT row (cell+)>
  <!ELEMENT cell (#PCDATA)>
  <!ELEMENT warning (#PCDATA)>
  <!ELEMENT footer (#PCDATA)>
]>
<report>
  <header>
    <title>&company; quarterly report</title>
    <meta key="period" value="2026-Q3"/>
    <meta key="confidential" value="false"/>
  </header>
  <body>
    <paragraph>Revenue increased <strong>12%</strong><br/> compared with <code>2025-Q3</code>.</paragraph>
    <table>
      <row><cell>Region</cell><cell>Total</cell></row>
      <row><cell>北</cell><cell>42</cell></row>
    </table>
    <warning>&note;</warning>
  </body>
  <footer>Generated automatically.</footer>
</report>