<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE drawing [
  <!ELEMENT drawing (defs?, layer+)>
  <!ELEMENT defs (gradient|filter|symbol)*>
  <!ELEMENT gradient (stop+)>
  <!ELEMENT stop EMPTY>
  <!ATTLIST stop offset CDATA #REQUIRED color CDATA #IMPLIED>
  <!ELEMENT filter (component-transfer?)>
  <!ELEMENT component-transfer EMPTY>
  <!ELEMENT symbol (path|text|use)*>
  <!ELEMENT layer (path|circle|text|use|group)*>
  <!ELEMENT group (path|circle|text|use|group)*>
  <!ELEMENT path EMPTY>
  <!ELEMENT circle EMPTY>
  <!ELEMENT text (#PCDATA)>
  <!ELEMENT use EMPTY>
  <!ENTITY copyright "©">
]>
<drawing xmlns="http://www.w3.org/2000/svg"
         xmlns:xlink="http://www.w3.org/1999/xlink"
         viewBox="0 0 640 480"
         xml:space="preserve">
  <defs>
    <gradient id="sunset">
      <stop offset="0%" color="#ffcc66"/>
      <stop offset="100%" color="#663399"/>
    </gradient>
    <filter id="soften">
      <component-transfer/>
    </filter>
    <symbol id="marker">
      <path d="M 0,-8 L 6,6 L -6,6 Z"/>
      <text y="20">north</text>
    </symbol>
  </defs>
  <layer id="background" style="isolation:isolate">
    <rect xmlns="http://www.w3.org/2000/svg"
          x="0" y="0" width="640" height="480"
          fill="url(#sunset)"/>
    <circle cx="510" cy="92" r="48" fill="#fff8dc" opacity="0.82"/>
  </layer>
  <layer id="foreground">
    <g transform="translate(320,240)" aria-label="&copyright; diagram">
      <use xlink:href="#marker" x="0" y="-80"/>
      <path d="M -180,100 C -90,-40 20,160 180,-20"
            fill="none" stroke="#102030" stroke-width="3"
            filter="url(#soften)"/>
      <text x="-110" y="150"><![CDATA[α < β && γ > δ]]></text>
    </g>
  </layer>
</drawing>