<?xml version="1.0"?>
<!DOCTYPE article [
  <!ENTITY company "North &amp; South">
  <!ENTITY % inline "emph | code | br">
  <!ELEMENT article (header, section+)>
  <!ELEMENT header (title, byline?)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT byline (#PCDATA)>
  <!ELEMENT section (title?, (#PCDATA|%inline;)*)>
  <!ELEMENT emph (#PCDATA)>
  <!ELEMENT code (#PCDATA)>
  <!ELEMENT br EMPTY>
]>
<article>
  <header>
    <title>Notes on &company;</title>
    <byline>Élodie Martin</byline>
  </header>
  <section>
    <title>First observation</title>
    Text before <emph>emphasis</emph>, then <code>r = x &lt; y</code>
    and a break<br/>followed by an entity: &company;.
  </section>
  <section>
    <title>Second observation</title>
    <code>for (i = 0; i &lt; 4; i++) { }</code>
    <!-- A comment between mixed-content nodes -->
    <emph>終わりではない</emph>
  </section>
</article>