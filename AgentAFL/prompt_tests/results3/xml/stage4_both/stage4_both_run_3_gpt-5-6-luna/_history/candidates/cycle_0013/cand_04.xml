<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE scene [
  <!ENTITY quote "&#x201C;hello&#x201D;">
  <!ENTITY ampersand "&amp;">
  <!ELEMENT scene (background, actor*, props)>
  <!ELEMENT background (#PCDATA)>
  <!ELEMENT actor (name, line*)>
  <!ATTLIST actor id ID #REQUIRED role CDATA #IMPLIED>
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT line (#PCDATA|pause|gesture)*>
  <!ELEMENT pause EMPTY>
  <!ATTLIST pause duration CDATA #IMPLIED>
  <!ELEMENT gesture (#PCDATA)>
  <!ELEMENT props (prop*)>
  <!ELEMENT prop EMPTY>
  <!ATTLIST prop key CDATA #REQUIRED value CDATA #IMPLIED>
]>
<scene>
  <background><![CDATA[
    A stage with a painted moon.
    The sequence ]]> is represented safely here.
  ]]></background>
  <actor id="a1" role="narrator">
    <name>Zoë &quote;</name>
    <line>Once upon a time<pause duration="0.25s"/>there was <gesture>silence</gesture>.</line>
    <line>Symbols: &amp; &lt; &gt; &quot; &apos; &amp;and;</line>
  </actor>
  <actor id="a2">
    <name>李明</name>
    <line><gesture>whispers</gesture> Καλημέρα</line>
  </actor>
  <props>
    <prop key="empty" value=""/>
    <prop key="flag"/>
    <prop key="path" value="C:\tmp\file"/>
  </props>
</scene>