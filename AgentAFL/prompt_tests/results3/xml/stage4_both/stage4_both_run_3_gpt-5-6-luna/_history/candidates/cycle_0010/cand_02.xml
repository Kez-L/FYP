<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE report [
  <!ELEMENT report (section+)>
  <!ELEMENT section (heading, paragraph+, table?)>
  <!ATTLIST section id ID #REQUIRED>
  <!ELEMENT heading (#PCDATA)>
  <!ELEMENT paragraph (#PCDATA|strong|i|link|break|entity-ref)*>
  <!ELEMENT strong (#PCDATA|i)*>
  <!ELEMENT i (#PCDATA)>
  <!ELEMENT link (#PCDATA)>
  <!ATTLIST link href CDATA #REQUIRED external (yes|no) "no">
  <!ELEMENT break EMPTY>
  <!ELEMENT entity-ref EMPTY>
  <!ATTLIST entity-ref name CDATA #REQUIRED>
  <!ELEMENT table (caption?, row+)>
  <!ELEMENT caption (#PCDATA)>
  <!ELEMENT row (cell+)>
  <!ATTLIST row role (header|body|footer) "body">
  <!ELEMENT cell (#PCDATA|strong|i|break)*>
  <!ATTLIST cell colspan CDATA "1" rowspan CDATA "1">
]>
<report xml:space="preserve" xml:lang="fr">
  <section id="intro">
    <heading>Résumé</heading>
    <paragraph>Une valeur <strong>importante</strong> contient <i>des accents</i><break/>et du texte.</paragraph>
    <paragraph>Voir <link href="https://example.invalid/résumé" external="yes">la référence</link>.</paragraph>
  </section>
  <section id="data">
    <heading>Mesures</heading>
    <paragraph>Symbols: &lt; &gt; &amp; &quot; &apos; — café — 東京.</paragraph>
    <table>
      <caption>Observations quotidiennes</caption>
      <row role="header">
        <cell colspan="2"><strong>Jour</strong></cell>
        <cell>Valeur</cell>
      </row>
      <row>
        <cell>lundi</cell>
        <cell rowspan="2">matin</cell>
        <cell>17.25</cell>
      </row>
      <row>
        <cell>mardi</cell>
        <cell>18.00</cell>
      </row>
      <row role="footer">
        <cell colspan="3">Fin de tableau</cell>
      </row>
    </table>
  </section>
</report>