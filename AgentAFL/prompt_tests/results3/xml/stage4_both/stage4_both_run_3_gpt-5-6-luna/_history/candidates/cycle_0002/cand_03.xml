<?xml version="1.0"?>
<!DOCTYPE form [
  <!ENTITY company "North &amp; South">
  <!ENTITY legal "All submissions are retained for 30 days.">
  <!ELEMENT form (intro, field+, consent)>
  <!ELEMENT intro (#PCDATA)>
  <!ELEMENT field (label, value, help?)>
  <!ATTLIST field name NMTOKEN #REQUIRED type (text|number|choice|multiline) #REQUIRED required (true|false) "false">
  <!ELEMENT label (#PCDATA)>
  <!ELEMENT value (#PCDATA)>
  <!ELEMENT help (#PCDATA|kbd)*>
  <!ELEMENT kbd (#PCDATA)>
  <!ELEMENT consent (statement, checkbox)>
  <!ELEMENT statement (#PCDATA)>
  <!ELEMENT checkbox EMPTY>
  <!ATTLIST checkbox checked (yes|no) #REQUIRED>
]>
<form>
  <intro>Application for &company; services.</intro>
  <field name="username" type="text" required="true">
    <label>User name</label>
    <value>delta_7</value>
    <help>Use <kbd>A-Z</kbd>, digits, or underscore.</help>
  </field>
  <field name="age" type="number">
    <label>Age</label>
    <value>0042</value>
  </field>
  <field name="comment" type="multiline">
    <label>Comment</label>
    <value><![CDATA[Line one
Line two
<not-an-element>]]></value>
    <help>&legal;</help>
  </field>
  <field name="color" type="choice">
    <label>Preferred color</label>
    <value>blue &amp; green</value>
  </field>
  <consent>
    <statement>I accept the terms.</statement>
    <checkbox checked="yes"/>
  </consent>
</form>