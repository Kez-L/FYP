<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE storyboard [
  <!ELEMENT storyboard (scene+)>
  <!ELEMENT scene (heading, shot+)>
  <!ATTLIST scene id ID #REQUIRED>
  <!ELEMENT heading (#PCDATA)>
  <!ELEMENT shot (camera, action, dialogue*)>
  <!ATTLIST shot type (wide|medium|close|insert) #REQUIRED>
  <!ELEMENT camera EMPTY>
  <!ATTLIST camera lens CDATA #IMPLIED movement CDATA #IMPLIED>
  <!ELEMENT action (#PCDATA|pause|sound)*>
  <!ELEMENT pause EMPTY>
  <!ELEMENT sound (#PCDATA)>
  <!ELEMENT dialogue (#PCDATA|stage)*>
  <!ATTLIST dialogue speaker CDATA #REQUIRED>
  <!ELEMENT stage (#PCDATA)>
  <!ENTITY hush "…">
]>
<storyboard xmlns:fx="urn:cinema:effects"
            xmlns:meta="urn:cinema:metadata">
  <meta:production meta:code="LX-204" meta:revision="7"/>
  <scene id="s01">
    <heading>EXT. SALT FLATS — DAWN</heading>
    <shot type="wide">
      <camera lens="24mm" movement="slow-pan"/>
      <action>A pale horizon appears <pause/> beneath a violet sky.</action>
      <dialogue speaker="RADIO">Base to rover, do you copy?</dialogue>
    </shot>
    <shot type="close">
      <camera lens="85mm"/>
      <action><sound>static</sound> The receiver blinks twice.</action>
      <dialogue speaker="ROVER">
        <stage>(whispered)</stage>&hush; I see the tower.
      </dialogue>
    </shot>
  </scene>
  <scene id="s02">
    <heading>INT. CONTROL ROOM — CONTINUOUS</heading>
    <shot type="insert">
      <camera lens="50mm" movement="locked"/>
      <action><![CDATA[Monitor values: TEMP < 0, SIGNAL > 80, MODE = "AUTO"]]></action>
      <dialogue speaker="TECH">Mark the coordinates.</dialogue>
    </shot>
    <shot type="medium">
      <camera lens="35mm"/>
      <action>Three operators turn toward the window.</action>
    </shot>
  </scene>
</storyboard>