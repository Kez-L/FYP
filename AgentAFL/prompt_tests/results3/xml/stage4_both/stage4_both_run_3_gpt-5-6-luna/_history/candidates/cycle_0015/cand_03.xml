<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE library [
  <!ELEMENT library (shelf*)>
  <!ELEMENT shelf (book+)>
  <!ATTLIST shelf name CDATA #IMPLIED>
  <!ELEMENT book (title, author+, summary?, review*)>
  <!ATTLIST book isbn NMTOKEN #REQUIRED available (yes|no) "yes">
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT author (#PCDATA)>
  <!ELEMENT summary (#PCDATA|emph|quote)*>
  <!ELEMENT review (#PCDATA)>
  <!ELEMENT emph (#PCDATA)>
  <!ELEMENT quote (#PCDATA)>
  <!ENTITY copyright "&#xA9;">
]>
<library>
  <shelf name="fiction">
    <book isbn="9780000000001">
      <title>The Folding Map</title>
      <author>R. Example</author>
      <author>M. Example</author>
      <summary>A journey through <emph>unfamiliar</emph> roads and <quote>borrowed time</quote>.</summary>
      <review>&copyright; A quiet, intricate story.</review>
      <review>Second opinion: 4/5</review>
    </book>
  </shelf>
  <shelf name="reference">
    <book isbn="REF-42" available="no">
      <title>Tables &amp; Transformations</title>
      <author>J. Analyst</author>
    </book>
  </shelf>
</library>