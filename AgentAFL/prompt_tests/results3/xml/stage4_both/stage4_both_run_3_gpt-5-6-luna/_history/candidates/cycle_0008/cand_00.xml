<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE ledger [
  <!ELEMENT ledger (entry*)>
  <!ELEMENT entry (date, account, amount, note?)>
  <!ATTLIST entry ref ID #IMPLIED status (posted|pending|void) "pending">
  <!ELEMENT date (#PCDATA)>
  <!ELEMENT account (#PCDATA)>
  <!ELEMENT amount (#PCDATA)>
  <!ELEMENT note (#PCDATA|em|line-break)*>
  <!ELEMENT em (#PCDATA)>
  <!ELEMENT line-break EMPTY>
  <!ENTITY currency "€">
  <!ENTITY reminder "Review &amp; reconcile">
]>
<ledger>
  <!-- entries may be revised after import -->
  <entry ref="e001" status="posted">
    <date>2026-09-24</date>
    <account>operations</account>
    <amount>&currency;1,204.50</amount>
    <note>Quarterly <em>service</em> renewal<line-break/>approved.</note>
  </entry>
  <entry ref="e002">
    <date>2026-10-01</date>
    <account>reserve</account>
    <amount>&currency;0.00</amount>
    <note>&reminder;</note>
  </entry>
</ledger>