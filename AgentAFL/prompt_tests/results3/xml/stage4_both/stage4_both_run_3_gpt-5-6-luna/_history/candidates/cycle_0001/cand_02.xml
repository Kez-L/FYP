<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE scene [
  <!ELEMENT scene (metadata, layer+)>
  <!ELEMENT metadata EMPTY>
  <!ATTLIST metadata created CDATA #REQUIRED creator CDATA #IMPLIED>
  <!ELEMENT layer (group|object|path|text)*>
  <!ATTLIST layer name CDATA #REQUIRED visible (true|false) "true">
  <!ELEMENT group (group|object|path|text)*>
  <!ATTLIST group id ID #IMPLIED transform CDATA #IMPLIED>
  <!ELEMENT object EMPTY>
  <!ATTLIST object id ID #REQUIRED x CDATA #REQUIRED y CDATA #REQUIRED>
  <!ELEMENT path (#PCDATA)>
  <!ATTLIST path closed (yes|no) "no">
  <!ELEMENT text (#PCDATA)>
  <!ATTLIST text align (left|center|right) "left">
]>
