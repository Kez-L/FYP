<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE dashboard [
  <!ENTITY brand "Asteria">
  <!ENTITY arrow "&#x2192;">
  <!ELEMENT dashboard (header, panel+, footer)>
  <!ELEMENT header (name, tagline)>
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT tagline (#PCDATA)>
  <!ELEMENT panel (title, widget+)>
  <!ATTLIST panel id ID #REQUIRED collapsed (true|false) "false">
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT widget (caption, value, detail?)>
  <!ATTLIST widget kind (gauge|sparkline|text) #REQUIRED>
  <!ELEMENT caption (#PCDATA)>
  <!ELEMENT value (#PCDATA)>
  <!ELEMENT detail (#PCDATA)>
  <!ELEMENT footer (#PCDATA)>
]>
<dashboard>
  <header>
    <name>&brand; Operations</name>
    <tagline>Signals &arrow; decisions</tagline>
  </header>
  <panel id="health" collapsed="false">
    <title>System health</title>
    <widget kind="gauge">
      <caption>Availability</caption>
      <value>99.982%</value>
      <detail><![CDATA[threshold >= 99.950]]></detail>
    </widget>
    <widget kind="sparkline">
      <caption>Latency</caption>
      <value>12,14,11,18,16,13</value>
    </widget>
  </panel>
  <panel id="alerts" collapsed="true">
    <title>Recent alerts</title>
    <widget kind="text">
      <caption>Message</caption>
      <value>Queue depth returned to normal.</value>
    </widget>
  </panel>
  <footer>Generated at 2026-09-24T12:30:00Z</footer>
</dashboard>