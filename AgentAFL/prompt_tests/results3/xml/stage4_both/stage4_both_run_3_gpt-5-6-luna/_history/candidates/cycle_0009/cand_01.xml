<?xml version="1.0"?>
<!DOCTYPE article [
  <!ELEMENT article (title, byline?, section+)>
  <!ELEMENT title (#PCDATA|italic|code)*>
  <!ELEMENT byline (author+, published?)>
  <!ELEMENT author (#PCDATA)>
  <!ELEMENT published (#PCDATA)>
  <!ELEMENT section (heading, (paragraph|list|quote|table|section)*)>
  <!ELEMENT heading (#PCDATA|italic|code)*>
  <!ELEMENT paragraph (#PCDATA|italic|bold|code|link|break)*>
  <!ELEMENT italic (#PCDATA|bold|code)*>
  <!ELEMENT bold (#PCDATA|italic|code)*>
  <!ELEMENT code (#PCDATA)>
  <!ELEMENT link (#PCDATA)>
  <!ELEMENT break EMPTY>
  <!ELEMENT list (item+)>
  <!ELEMENT item (paragraph|list|quote)*>
  <!ELEMENT quote (#PCDATA|italic|paragraph)*>
  <!ELEMENT table (row+)>
  <!ELEMENT row (cell+)>
  <!ELEMENT cell (#PCDATA|code|link)*>
  <!ATTLIST article edition CDATA #IMPLIED>
  <!ATTLIST link href CDATA #REQUIRED>
]>
<article edition="special">
  <title>Notes on <italic>recursive</italic> markup</title>
  <byline>
    <author>R. Example</author>
    <author>M. Parser</author>
    <published>2026-09-24</published>
  </byline>
  <section>
    <heading>Opening</heading>
    <paragraph>Text can contain <bold>emphasis</bold>, <code>names()</code>, and a<break/>line boundary.</paragraph>
    <quote>Markup is data when the context says so.</quote>
    <list>
      <item><paragraph>first branch</paragraph></item>
      <item>
        <paragraph>second branch</paragraph>
        <list>
          <item><paragraph>nested branch with <link href="urn:example:detail">a link</link></paragraph></item>
        </list>
      </item>
    </list>
  </section>
  <section>
    <heading>Values</heading>
    <table>
      <row><cell>key</cell><cell>value</cell></row>
      <row><cell><code>π</code></cell><cell>3.141592653589793</cell></row>
    </table>
  </section>
</article>