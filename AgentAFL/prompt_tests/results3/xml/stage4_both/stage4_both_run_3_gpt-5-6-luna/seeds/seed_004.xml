<?xml version="1.0"?>
<!DOCTYPE archive [
  <!ELEMENT archive (entry*)>
  <!ATTLIST archive format CDATA #FIXED "bundle">
  <!ELEMENT entry (name, checksum, payload)>
  <!ATTLIST entry id ID #REQUIRED kind (text|binary|empty) #REQUIRED>
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT checksum (#PCDATA)>
  <!ELEMENT payload (#PCDATA|section|linebreak)*>
  <!ELEMENT section (#PCDATA|linebreak)*>
  <!ATTLIST section title CDATA #IMPLIED>
  <!ELEMENT linebreak EMPTY>
]>
<archive format="bundle">
  <entry id="e01" kind="text">
    <name>readme.txt</name>
    <checksum>sha256:00aa11bb22cc33dd</checksum>
    <payload>
      <section title="Introduction">First line<linebreak/>Second line.</section>
      <section title="Notes"><![CDATA[Raw markup: <tag attr="x"/> & not expanded]]></section>
    </payload>
  </entry>
  <entry id="e02" kind="empty">
    <name>placeholder</name>
    <checksum>none</checksum>
    <payload/>
  </entry>
</archive>