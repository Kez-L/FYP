<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE form [
  <!ELEMENT form (heading, fieldset+)>
  <!ELEMENT heading (#PCDATA)>
  <!ELEMENT fieldset (legend, control*)>
  <!ELEMENT legend (#PCDATA)>
  <!ELEMENT control (label, value?, hint?)>
  <!ATTLIST control name NMTOKEN #REQUIRED kind (text|choice|toggle) "text">
  <!ELEMENT label (#PCDATA)>
  <!ELEMENT value (#PCDATA|option)*>
  <!ELEMENT option (#PCDATA)>
  <!ELEMENT hint (#PCDATA)>
  <!ENTITY nbsp "&#160;">
  <!ENTITY check "&#x2611;">
]>
<form>
  <heading>Account preferences &nbsp; &amp; notifications</heading>
  <fieldset>
    <legend>Identity</legend>
    <control name="display_name">
      <label>Display name</label>
      <value>Zoë &amp; Co.</value>
      <hint>Shown publicly</hint>
    </control>
    <control name="timezone" kind="choice">
      <label>Time zone</label>
      <value>
        <option>UTC</option>
        <option selected="true">Europe/Paris</option>
        <option>Asia/Tokyo</option>
      </value>
    </control>
  </fieldset>
  <fieldset>
    <legend>Alerts</legend>
    <control name="weekly" kind="toggle">
      <label>Weekly digest</label>
      <value>&check;</value>
    </control>
  </fieldset>
</form>