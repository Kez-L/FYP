<?xml version="1.0" encoding="ISO-8859-1"?>
<!DOCTYPE form [
  <!ELEMENT form (fieldset+)>
  <!ELEMENT fieldset (legend?, field*)>
  <!ELEMENT legend (#PCDATA)>
  <!ELEMENT field (label?, value, hint?)>
  <!ELEMENT label (#PCDATA)>
  <!ELEMENT value (#PCDATA)>
  <!ELEMENT hint (#PCDATA)>
  <!ATTLIST form version CDATA "1">
  <!ATTLIST field name ID #REQUIRED type (text|number|date) "text">
]>
<form version="2">
  <fieldset>
    <legend>Contact</legend>
    <field name="first" type="text">
      <label>Prénom</label>
      <value>Zoë</value>
      <hint>Use the preferred name.</hint>
    </field>
    <field name="count" type="number">
      <label>Éléments</label>
      <value>00042</value>
    </field>
  </fieldset>
  <fieldset>
    <legend>Additional data</legend>
    <field name="comment">
      <label>Comment</label>
      <value><![CDATA[<not-an-element> & still text]]></value>
      <hint>Characters such as &lt; and &amp; are preserved.</hint>
    </field>
  </fieldset>
</form>