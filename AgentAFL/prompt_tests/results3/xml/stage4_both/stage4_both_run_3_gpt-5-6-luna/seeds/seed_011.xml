<?xml version="1.0"?>
<!DOCTYPE note [
  <!ELEMENT note (header, body, footer)>
  <!ELEMENT header (subject, recipient+)>
  <!ELEMENT subject (#PCDATA)>
  <!ELEMENT recipient (#PCDATA)>
  <!ATTLIST recipient role (to|cc|bcc) "to">
  <!ELEMENT body (#PCDATA|section|linebreak)*>
  <!ELEMENT section (title, line*)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT line (#PCDATA|em|strong)*>
  <!ELEMENT em (#PCDATA)>
  <!ELEMENT strong (#PCDATA)>
  <!ELEMENT linebreak EMPTY>
  <!ELEMENT footer (#PCDATA)>
  <!ENTITY greeting "Hello">
  <!ENTITY product "XML parser">
  <!ENTITY copyright "&#169; 2026">
]>
<note>
  <header>
    <subject>&greeting; from the &product;</subject>
    <recipient role="to">reader@example.invalid</recipient>
    <recipient role="cc">archive@example.invalid</recipient>
  </header>
  <body>
    <section>
      <title>Summary</title>
      <line>This line contains <em>emphasis</em> and <strong>weight</strong>.</line>
      <linebreak/>
      <line>Reserved characters: &lt;tag&gt; &amp; quoted text.</line>
    </section>
    <section>
      <title>Details</title>
      <line><![CDATA[Literal markup: <item key="x"/> and the sequence ]] remains text.]]></line>
    </section>
  </body>
  <footer>&copyright; Internal distribution only.</footer>
</note>