<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE archive [
  <!ELEMENT archive (record+)>
  <!ELEMENT record (title, meta, body)>
  <!ATTLIST record key ID #REQUIRED>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT meta (author, tags?)>
  <!ELEMENT author (#PCDATA)>
  <!ELEMENT tags (tag+)>
  <!ELEMENT tag (#PCDATA)>
  <!ELEMENT body (#PCDATA|section|br)*>
  <!ELEMENT section (#PCDATA|strong|code)*>
  <!ELEMENT strong (#PCDATA)>
  <!ELEMENT code (#PCDATA)>
  <!ELEMENT br EMPTY>
  <!ENTITY intro "An &quot;archived&quot; entry">
]>
<archive>
  <record key="r-17">
    <title>&intro;</title>
    <meta>
      <author xml:lang="fr">Équipe de recherche</author>
      <tags>
        <tag>xml</tag>
        <tag>parser</tag>
      </tags>
    </meta>
    <body>Before<section>A <strong>nested</strong> fragment with <code>markup</code>.</section><br/>After <![CDATA[raw ]]> text.</body>
  </record>
  <record key="r-18">
    <title>Second record</title>
    <meta><author>匿名</author></meta>
    <body>Mixed <section>content</section> and ordinary text.</body>
  </record>
</archive>