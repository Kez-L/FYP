<?xml version="1.0"?>
<scene xmlns="http://www.w3.org/2000/svg"
       xmlns:svg="http://www.w3.org/2000/svg"
       xmlns:meta="urn:scene:metadata"
       viewBox="0 0 640 480"
       version="1.1">
  <title>Layered diagram</title>
  <desc><![CDATA[An SVG scene containing <escaped> markup and ampersands.]]></desc>
  <defs>
    <linearGradient id="fade" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#ffffff"/>
      <stop offset="100%" stop-color="#336699"/>
    </linearGradient>
    <clipPath id="window">
      <rect x="10" y="10" width="620" height="460" rx="12"/>
    </clipPath>
  </defs>
  <g id="background" clip-path="url(#window)">
    <rect x="0" y="0" width="640" height="480" fill="url(#fade)"/>
    <svg:circle cx="320" cy="240" r="90" fill="none" stroke="#111111"/>
  </g>
  <g id="labels" meta:revision="7">
    <text x="30" y="60" xml:space="preserve">  diagram  </text>
    <text x="30" y="92"><tspan font-weight="bold">status:</tspan> ready</text>
    <foreignObject x="40" y="120" width="240" height="80">
      <div xmlns="http://www.w3.org/1999/xhtml" lang="en">
        <p>Embedded <em>HTML</em> fragment.</p>
      </div>
    </foreignObject>
  </g>
  <?render quality="high" layers="background,labels"?>
</scene>