<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="view.xsl"?>
<!DOCTYPE archive [
  <!ELEMENT archive (metadata, record*)>
  <!ELEMENT metadata (created, description)>
  <!ELEMENT created (#PCDATA)>
  <!ELEMENT description (#PCDATA|mark|br)*>
  <!ELEMENT mark (#PCDATA)>
  <!ELEMENT br EMPTY>
  <!ELEMENT record (heading, body, attachment*)>
  <!ATTLIST record uuid ID #REQUIRED category NMTOKEN #IMPLIED>
  <!ELEMENT heading (#PCDATA)>
  <!ELEMENT body (#PCDATA|paragraph|quote|code)*>
  <!ELEMENT paragraph (#PCDATA|mark|br)*>
  <!ELEMENT quote (#PCDATA)>
  <!ELEMENT code (#PCDATA)>
  <!ELEMENT attachment EMPTY>
  <!ATTLIST attachment
    filename CDATA #REQUIRED
    media CDATA #IMPLIED
    size NMTOKEN #IMPLIED
  >
]>
<archive>
  <metadata>
    <created>2026-09-24T12:00:00Z</created>
    <description>Release notes <mark>draft</mark><br/>for internal review.</description>
  </metadata>
  <record uuid="r-17" category="migration">
    <heading>Storage transition</heading>
    <body>
      <paragraph>Move the legacy data before the <mark>maintenance window</mark>.</paragraph>
      <quote>Keep a verified copy offline.</quote>
      <code><![CDATA[rsync -a --delete old/ new/]]></code>
    </body>
    <attachment filename="plan.txt" media="text/plain" size="2048"/>
    <attachment filename="diagram.svg" media="image/svg+xml"/>
  </record>
</archive>