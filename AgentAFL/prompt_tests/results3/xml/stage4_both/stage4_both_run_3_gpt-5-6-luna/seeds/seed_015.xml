<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE catalog [
  <!ELEMENT catalog (item+, index)>
  <!ELEMENT item (label, summary, link, tags)>
  <!ATTLIST item key ID #REQUIRED state (new|active|retired) "active">
  <!ELEMENT label (#PCDATA)>
  <!ELEMENT summary (#PCDATA|term|code)*>
  <!ELEMENT term (#PCDATA)>
  <!ELEMENT code (#PCDATA)>
  <!ELEMENT link EMPTY>
  <!ATTLIST link target IDREF #REQUIRED>
  <!ELEMENT tags (tag*)>
  <!ELEMENT tag (#PCDATA)>
  <!ELEMENT index (entry*)>
  <!ELEMENT entry EMPTY>
  <!ATTLIST entry item IDREF #REQUIRED rank NMTOKEN #IMPLIED>
  <!ENTITY product "Atlas">
  <!ENTITY note "Use &product; carefully.">
]>
<catalog>
  <item key="a1" state="new">
    <label>First &product; entry</label>
    <summary>A <term>compact</term> description containing <code>catalog</code> data.</summary>
    <link target="a2"/>
    <tags><tag>alpha</tag><tag>local</tag></tags>
  </item>
  <item key="a2">
    <label>Second entry</label>
    <summary>&note;</summary>
    <link target="a1"/>
    <tags><tag>beta</tag></tags>
  </item>
  <index>
    <entry item="a1" rank="01"/>
    <entry item="a2" rank="02"/>
  </index>
</catalog>