<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE canvas [
  <!ELEMENT canvas (defs?, layer+)>
  <!ELEMENT defs (gradient*, symbol*)>
  <!ELEMENT gradient (stop+)>
  <!ELEMENT stop EMPTY>
  <!ELEMENT symbol (path|circle|text)*>
  <!ELEMENT layer (use|path|circle|text|group)*>
  <!ELEMENT group (use|path|circle|text|group)*>
  <!ELEMENT use EMPTY>
  <!ELEMENT path EMPTY>
  <!ELEMENT circle EMPTY>
  <!ELEMENT text (#PCDATA)>
  <!ATTLIST canvas width CDATA #REQUIRED height CDATA #REQUIRED>
  <!ATTLIST layer id ID #IMPLIED opacity CDATA "1">
  <!ATTLIST gradient id ID #REQUIRED x1 CDATA #IMPLIED y1 CDATA #IMPLIED x2 CDATA #IMPLIED y2 CDATA #IMPLIED>
  <!ATTLIST stop offset CDATA #REQUIRED color CDATA #REQUIRED>
  <!ATTLIST symbol id ID #REQUIRED>
  <!ATTLIST use href IDREF #REQUIRED x CDATA #IMPLIED y CDATA #IMPLIED>
  <!ATTLIST path d CDATA #REQUIRED fill CDATA #IMPLIED stroke CDATA #IMPLIED>
  <!ATTLIST circle cx CDATA #REQUIRED cy CDATA #REQUIRED r CDATA #REQUIRED fill CDATA #IMPLIED>
  <!ATTLIST text x CDATA #REQUIRED y CDATA #REQUIRED>
  <!ENTITY accent "#4b6cb7">
  <!ENTITY pale "#e8eefc">
]>
<canvas xmlns="urn:example:canvas" width="640" height="360">
  <defs>
    <gradient id="background" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" color="&accent;"/>
      <stop offset="100%" color="#182848"/>
    </gradient>
    <symbol id="marker">
      <circle cx="0" cy="0" r="8" fill="#ffffff"/>
      <circle cx="0" cy="0" r="4" fill="&accent;"/>
    </symbol>
  </defs>
  <layer id="scene">
    <path d="M0 0 H640 V360 H0 Z" fill="&pale;"/>
    <group>
      <use href="marker" x="120" y="90"/>
      <use href="marker" x="320" y="180"/>
      <path d="M120 90 C180 20 260 250 320 180 S470 80 540 260" fill="none" stroke="&accent;"/>
      <text x="32" y="332">trajectory &amp; control</text>
    </group>
  </layer>
</canvas>