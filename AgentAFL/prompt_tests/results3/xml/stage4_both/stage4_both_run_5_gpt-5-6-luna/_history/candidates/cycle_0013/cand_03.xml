<?xml version="1.0" encoding="UTF-16"?>
<!DOCTYPE itinerary [
  <!ELEMENT itinerary (traveler, journey)>
  <!ELEMENT traveler (name, contact)>
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT contact (email, phone?)>
  <!ELEMENT email (#PCDATA)>
  <!ELEMENT phone (#PCDATA)>
  <!ELEMENT journey (leg+)>
  <!ELEMENT leg (departure, arrival, service?, baggage*)>
  <!ELEMENT departure (airport, time)>
  <!ELEMENT arrival (airport, time)>
  <!ELEMENT airport (#PCDATA)>
  <!ELEMENT time (#PCDATA)>
  <!ELEMENT service (carrier, number)>
  <!ELEMENT carrier (#PCDATA)>
  <!ELEMENT number (#PCDATA)>
  <!ELEMENT baggage (#PCDATA)>
  <!ATTLIST itinerary currency CDATA #REQUIRED>
  <!ATTLIST traveler loyalty CDATA #IMPLIED>
  <!ATTLIST leg sequence NMTOKEN #REQUIRED mode (air|rail|bus) #REQUIRED>
  <!ATTLIST baggage pieces NMTOKEN "1">
  <!ENTITY city "Zürich">
]>
<itinerary currency="CHF">
  <traveler loyalty="silver">
    <name>Renée &amp; Chen</name>
    <contact>
      <email>travel@example.invalid</email>
      <phone>+41 44 555 0188</phone>
    </contact>
  </traveler>
  <journey>
    <leg sequence="1" mode="air">
      <departure>
        <airport>ZRH</airport>
        <time>2026-11-14T08:10:00+01:00</time>
      </departure>
      <arrival>
        <airport>AMS</airport>
        <time>2026-11-14T10:00:00+01:00</time>
      </arrival>
      <service>
        <carrier>Example Air</carrier>
        <number>EA 204</number>
      </service>
      <baggage pieces="2">checked</baggage>
    </leg>
    <leg sequence="2" mode="rail">
      <departure>
        <airport>AMS</airport>
        <time>2026-11-16T17:45:00+01:00</time>
      </departure>
      <arrival>
        <airport>BRU</airport>
        <time>2026-11-16T19:30:00+01:00</time>
      </arrival>
      <service>
        <carrier>Nightline</carrier>
        <number>NL-88</number>
      </service>
      <baggage>carry-on</baggage>
    </leg>
    <leg sequence="3" mode="bus">
      <departure>
        <airport>BRU</airport>
        <time>2026-11-18T06:30:00+01:00</time>
      </departure>
      <arrival>
        <airport>&city;</airport>
        <time>2026-11-18T09:20:00+01:00</time>
      </arrival>
    </leg>
  </journey>
</itinerary>