<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE registry [
  <!ELEMENT registry (namespace+, binding*)>
  <!ELEMENT namespace (prefix, uri, documentation?)>
  <!ELEMENT prefix (#PCDATA)>
  <!ELEMENT uri (#PCDATA)>
  <!ELEMENT documentation (#PCDATA)>
  <!ELEMENT binding (name, target, parameter*)>
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT target EMPTY>
  <!ELEMENT parameter (#PCDATA)>
  <!ATTLIST namespace id ID #REQUIRED>
  <!ATTLIST binding namespace IDREF #REQUIRED kind (read|write|admin) "read">
  <!ATTLIST target href URI #REQUIRED>
  <!ATTLIST parameter key NMTOKEN #REQUIRED>
  <!NOTATION binary SYSTEM "application/octet-stream">
  <!ENTITY payload SYSTEM "data.bin" NDATA binary>
]>
<registry>
  <namespace id="core">
    <prefix>c</prefix>
    <uri>urn:vendor:core</uri>
    <documentation>Primary service namespace.</documentation>
  </namespace>
  <namespace id="aux">
    <prefix>a</prefix>
    <uri>urn:vendor:auxiliary</uri>
  </namespace>
  <binding namespace="core" kind="write">
    <name>upload</name>
    <target href="urn:action:upload"/>
    <parameter key="format">binary</parameter>
    <parameter key="checksum">sha256</parameter>
  </binding>
  <binding namespace="aux" kind="admin">
    <name>inspect</name>
    <target href="urn:action:inspect"/>
    <parameter key="scope">all</parameter>
  </binding>
</registry>