<!DOCTYPE dashboard [
  <!ELEMENT dashboard (panel*)>
  <!ELEMENT panel (title, metric*)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT metric EMPTY>
  <!ATTLIST panel
    name CDATA #REQUIRED
    hidden (true|false) "false">
  <!ATTLIST metric
    key NMTOKEN #REQUIRED
    value CDATA #REQUIRED
    trend (up|down|flat) "flat">
  <!ENTITY percent "&#37;">
]>
<dashboard>
  <panel name="cpu" hidden="false">
    <title>System &amp; Health</title>
    <metric key="load_1m" value="0.73" trend="up"/>
    <metric key="memory" value="64&percent;" trend="flat"/>
  </panel>
  <panel name="network" hidden="true">
    <title><![CDATA[Packets <dropped>]]></title>
    <metric key="rx" value="1024" trend="down"/>
    <metric key="tx" value="2048"/>
  </panel>
</dashboard>