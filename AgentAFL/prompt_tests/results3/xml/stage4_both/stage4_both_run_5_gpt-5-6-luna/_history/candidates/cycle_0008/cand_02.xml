<?xml version="1.1" encoding="UTF-8" standalone="yes"?>
<!DOCTYPE ledger [
  <!ELEMENT ledger (opening, transaction*, closing)>
  <!ELEMENT opening EMPTY>
  <!ELEMENT transaction (account, amount, memo?)>
  <!ELEMENT account (#PCDATA)>
  <!ELEMENT amount (#PCDATA)>
  <!ELEMENT memo (#PCDATA)>
  <!ELEMENT closing EMPTY>
  <!ATTLIST opening balance CDATA #REQUIRED currency NMTOKEN #REQUIRED>
  <!ATTLIST transaction number NMTOKEN #REQUIRED type (credit|debit) #REQUIRED>
  <!ATTLIST closing balance CDATA #REQUIRED>
]>
<ledger>
  <opening balance="1042.75" currency="EUR"/>
  <transaction number="0001" type="debit">
    <account>supplies</account>
    <amount>17.20</amount>
    <memo>Paper, labels, and envelopes</memo>
  </transaction>
  <transaction number="0002" type="credit">
    <account>refund</account>
    <amount>4.00</amount>
  </transaction>
  <transaction number="0003" type="debit">
    <account>transport</account>
    <amount>12.50</amount>
    <memo>Bus fare &#x85; local route</memo>
  </transaction>
  <closing balance="1017.05"/>
</ledger>