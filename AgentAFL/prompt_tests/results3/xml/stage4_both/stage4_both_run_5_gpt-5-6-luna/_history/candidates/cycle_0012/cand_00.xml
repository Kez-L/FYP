<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!DOCTYPE report [
  <!ELEMENT report (header, section+, appendix?)>
  <!ELEMENT header (title, generated, owner)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT generated (#PCDATA)>
  <!ELEMENT owner (#PCDATA)>
  <!ELEMENT section (heading, paragraph+, table?)>
  <!ELEMENT heading (#PCDATA)>
  <!ELEMENT paragraph (#PCDATA|strong|code|link|br)*>
  <!ELEMENT strong (#PCDATA)>
  <!ELEMENT code (#PCDATA)>
  <!ELEMENT link (#PCDATA)>
  <!ELEMENT br EMPTY>
  <!ELEMENT table (row+)>
  <!ELEMENT row (cell+)>
  <!ELEMENT cell (#PCDATA)>
  <!ELEMENT appendix (item*)>
  <!ELEMENT item (#PCDATA)>
  <!ATTLIST section name NMTOKEN #REQUIRED>
  <!ATTLIST link href CDATA #REQUIRED>
  <!ATTLIST cell colspan NMTOKEN "1">
  <!ENTITY product "Atlas">
  <!ENTITY note "Generated for internal review">
]>
<report>
  <header>
    <title>&product; status &amp; findings</title>
    <generated>2026-10-01T12:00:00Z</generated>
    <owner>systems-team</owner>
  </header>
  <section name="overview">
    <heading>Overview</heading>
    <paragraph>The <strong>primary</strong> service is <code>ready</code>.<br/>See <link href="https://example.invalid/status">the dashboard</link>.</paragraph>
    <paragraph>&note; &lt;reviewed&gt;.</paragraph>
    <table>
      <row><cell>Region</cell><cell>State</cell><cell colspan="2">Comment</cell></row>
      <row><cell>north</cell><cell>ok</cell><cell>steady</cell></row>
      <row><cell>south</cell><cell>degraded</cell><cell>retrying</cell></row>
    </table>
  </section>
  <section name="empty">
    <heading>Deferred</heading>
    <paragraph><![CDATA[No additional narrative was supplied.]]></paragraph>
  </section>
  <appendix>
    <item>alpha</item>
    <item>beta</item>
  </appendix>
</report>