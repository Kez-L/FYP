<?xml version="1.0"?>
<!DOCTYPE report [
  <!ELEMENT report (section+, appendix*)>
  <!ELEMENT section (heading, paragraph+, table?)>
  <!ELEMENT heading (#PCDATA)>
  <!ELEMENT paragraph (#PCDATA|term|quote|linebreak)*>
  <!ELEMENT term (#PCDATA)>
  <!ELEMENT quote (#PCDATA|term)*>
  <!ELEMENT linebreak EMPTY>
  <!ELEMENT table (columns, row+)>
  <!ELEMENT columns (column+)>
  <!ELEMENT column (#PCDATA)>
  <!ELEMENT row (cell+)>
  <!ELEMENT cell (#PCDATA)>
  <!ELEMENT appendix (heading, paragraph*)>
  <!ATTLIST report generated CDATA #IMPLIED>
  <!ATTLIST section number NMTOKEN #REQUIRED>
  <!ATTLIST paragraph role (summary|detail|warning) "detail">
  <!ATTLIST term id ID #IMPLIED>
  <!ATTLIST quote source CDATA #IMPLIED>
  <!ATTLIST row key ID #IMPLIED>
  <!ATTLIST cell type (text|integer|decimal|date) "text">
  <!ENTITY dash "&#x2014;">
  <!ENTITY warning "<term id='t-warning'>caution</term>">
]>
