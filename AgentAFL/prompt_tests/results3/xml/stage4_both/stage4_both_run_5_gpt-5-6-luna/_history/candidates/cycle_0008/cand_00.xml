<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE catalog [
  <!ENTITY % entry-model "(title, value, note?)">
  <!ELEMENT catalog (section+)>
  <!ELEMENT section (label, entry+)>
  <!ELEMENT label (#PCDATA)>
  <!ELEMENT entry %entry-model;>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT value (#PCDATA)>
  <!ELEMENT note (#PCDATA)>
  <!ATTLIST section code NMTOKEN #REQUIRED>
  <!ATTLIST entry kind (fact|warning|reference) "fact"
                 ref ID #IMPLIED>
  <!ENTITY nbsp "&#160;">
  <!ENTITY mark "&#x2022;">
]>
<catalog>
  <section code="alpha">
    <label>Measurements</label>
    <entry kind="fact" ref="e1">
      <title>Mean value</title>
      <value>18.4&nbsp;units</value>
      <note>Rounded to &mark; two decimal places.</note>
    </entry>
    <entry kind="warning">
      <title>Outlier</title>
      <value>none recorded</value>
    </entry>
  </section>
  <section code="beta">
    <label>References</label>
    <entry kind="reference" ref="e2">
      <title>Source</title>
      <value>Register B-17</value>
    </entry>
  </section>
</catalog>