<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE message [
  <!ELEMENT message (header, body)>
  <!ELEMENT header (to, from, subject)>
  <!ELEMENT to (#PCDATA)>
  <!ELEMENT from (#PCDATA)>
  <!ELEMENT subject (#PCDATA)>
  <!ELEMENT body (#PCDATA|quote|list)*>
  <!ELEMENT quote (#PCDATA|quote)*>
  <!ELEMENT list (li+)>
  <!ELEMENT li (#PCDATA|link)*>
  <!ELEMENT link (#PCDATA)>
  <!ATTLIST link href CDATA #REQUIRED>
  <!ENTITY left "&lt;">
  <!ENTITY right "&gt;">
]>
<message xmlns="urn:mail">
  <header>
    <to>reader@example.test</to>
    <from>parser@example.test</from>
    <subject>Nested &left;markup&right;</subject>
  </header>
  <body>
    Intro
    <quote>Outer <quote>inner</quote> quote</quote>
    <list>
      <li>one <link href="urn:item:1">link</link></li>
      <li>two</li>
    </list>
  </body>
</message>