<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE library [
  <!ELEMENT library (shelf*)>
  <!ELEMENT shelf (book+)>
  <!ATTLIST shelf id ID #REQUIRED>
  <!ELEMENT book (title, author+, summary?)>
  <!ATTLIST book isbn CDATA #IMPLIED>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT author (#PCDATA)>
  <!ELEMENT summary (#PCDATA|em|quote)*>
  <!ELEMENT em (#PCDATA)>
  <!ELEMENT quote (#PCDATA)>
  <!ENTITY copyright "&#xA9; 2026">
]>
<library>
  <shelf id="fiction">
    <book isbn="978-0000000001">
      <title>The Quiet Meridian</title>
      <author>R. Vale</author>
      <author>M. Ilyan</author>
      <summary>A story of <em>distance</em> and <quote>return</quote>. &amp; &copyright;</summary>
    </book>
  </shelf>
  <shelf id="reference">
    <book>
      <title>Atlas of Small Waters</title>
      <author>J. Kestrel</author>
    </book>
  </shelf>
</library>