<?xml version="1.0"?>
<!DOCTYPE archive [
  <!ENTITY % feature "<!ELEMENT annotation (#PCDATA|mark|ref)*>">
  %feature;
  <![INCLUDE[
    <!ELEMENT archive (header, record+, footer)>
    <!ELEMENT header (created, owner)>
    <!ELEMENT created (#PCDATA)>
    <!ELEMENT owner (#PCDATA)>
    <!ELEMENT record (key, value, annotation*)>
    <!ELEMENT key (#PCDATA)>
    <!ELEMENT value (#PCDATA|mark|ref|br)*>
    <!ELEMENT mark (#PCDATA)>
    <!ELEMENT ref EMPTY>
    <!ATTLIST ref target IDREF #REQUIRED>
    <!ELEMENT footer (#PCDATA)>
  ]]>
  <![IGNORE[
    <!ELEMENT obsolete (#PCDATA)>
    <!ATTLIST obsolete since CDATA #IMPLIED>
  ]]>
  <!ATTLIST archive version NMTOKEN #REQUIRED>
  <!ATTLIST record id ID #REQUIRED kind (text|numeric|mixed) "text">
  <!ENTITY dash "&#x2014;">
  <!ENTITY notice "indexed &amp; verified">
]>
<archive version="v3">
  <header>
    <created>2026-10-01</created>
    <owner>catalog-system</owner>
  </header>
  <record id="r-alpha" kind="mixed">
    <key>alpha</key>
    <value>left <mark>center</mark> right<ref target="r-beta"/><br/></value>
    <annotation>Primary &notice; &dash; ready.</annotation>
  </record>
  <record id="r-beta" kind="numeric">
    <key>count</key>
    <value><![CDATA[42 < 100 && 7 > 3]]></value>
  </record>
  <footer>complete</footer>
</archive>