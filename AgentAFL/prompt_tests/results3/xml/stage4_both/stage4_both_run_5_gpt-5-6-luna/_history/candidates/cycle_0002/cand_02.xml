<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE map [
  <!ELEMENT map (layer+, legend?)>
  <!ELEMENT layer (point|line|area)+>
  <!ELEMENT point EMPTY>
  <!ELEMENT line (point+)>
  <!ELEMENT area (ring+)>
  <!ELEMENT ring (point+)>
  <!ELEMENT legend (entry+)>
  <!ELEMENT entry (label, swatch)>
  <!ELEMENT label (#PCDATA)>
  <!ELEMENT swatch EMPTY>
  <!ATTLIST layer id ID #REQUIRED visible (true|false) "true">
  <!ATTLIST point x CDATA #REQUIRED y CDATA #REQUIRED role (vertex|marker) "vertex">
  <!ATTLIST line id ID #IMPLIED closed (yes|no) "no">
  <!ATTLIST area id ID #REQUIRED>
  <!ATTLIST ring orientation (outer|inner) #REQUIRED>
  <!ATTLIST entry code NMTOKEN #REQUIRED>
  <!ATTLIST swatch color CDATA #REQUIRED>
  <!ENTITY degree "&#176;">
  <!ENTITY quote "&quot;">
]>
<map>
  <layer id="terrain" visible="true">
    <area id="lake">
      <ring orientation="outer">
        <point x="10.5" y="20.25"/>
        <point x="14.0" y="21.75"/>
        <point x="16.5" y="18.0"/>
        <point x="10.5" y="20.25"/>
      </ring>
      <ring orientation="inner">
        <point x="12" y="20"/>
        <point x="13" y="20.5"/>
        <point x="12" y="20"/>
      </ring>
    </area>
  </layer>
  <layer id="roads" visible="false">
    <line id="route-7" closed="no">
      <point x="0" y="0" role="marker"/>
      <point x="3" y="8"/>
      <point x="9" y="13"/>
    </line>
  </layer>
  <legend>
    <entry code="W">
      <label>Water &degree; &quote;blue&quote;</label>
      <swatch color="#2040c0"/>
    </entry>
  </legend>
</map>