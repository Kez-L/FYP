<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE questionnaire [
  <!ELEMENT questionnaire (metadata, page+)>
  <!ELEMENT metadata (owner, revision, keywords)>
  <!ELEMENT owner (#PCDATA)>
  <!ELEMENT revision (#PCDATA)>
  <!ELEMENT keywords (keyword+)>
  <!ELEMENT keyword (#PCDATA)>
  <!ELEMENT page (heading, instruction?, question+)>
  <!ELEMENT heading (#PCDATA)>
  <!ELEMENT instruction (#PCDATA|strong|br)*>
  <!ELEMENT strong (#PCDATA)>
  <!ELEMENT br EMPTY>
  <!ELEMENT question (prompt, option*, answer?)>
  <!ELEMENT prompt (#PCDATA|code)*>
  <!ELEMENT code (#PCDATA)>
  <!ELEMENT option (#PCDATA)>
  <!ELEMENT answer (#PCDATA)>
  <!ATTLIST questionnaire version NMTOKEN #REQUIRED>
  <!ATTLIST page number NMTOKEN #REQUIRED>
  <!ATTLIST question id ID #REQUIRED type (single|multiple|text) #REQUIRED required (yes|no) "no">
  <!ATTLIST option value NMTOKEN #REQUIRED correct (yes|no) "no">
  <!ENTITY product "Form&nbsp;Engine">
  <!ENTITY nbsp "&#160;">
]>
<questionnaire version="7.0">
  <metadata>
    <owner>Quality &amp; Safety</owner>
    <revision>2026-09-30</revision>
    <keywords>
      <keyword>inspection</keyword>
      <keyword>handover</keyword>
    </keywords>
  </metadata>
  <page number="1">
    <heading>Before departure</heading>
    <instruction>Read each <strong>required</strong> item.<br/>Use &product; &nbsp; carefully.</instruction>
    <question id="q-weather" type="single" required="yes">
      <prompt>Which signal indicates safe visibility?</prompt>
      <option value="green" correct="yes">Green</option>
      <option value="amber">Amber</option>
      <option value="red">Red</option>
    </question>
    <question id="q-comment" type="text">
      <prompt>Enter the <code>route-id</code> assigned to this trip.</prompt>
      <answer><![CDATA[route-Δ-42 / west]]></answer>
    </question>
  </page>
  <page number="2">
    <heading>Final confirmation</heading>
    <question id="q-tools" type="multiple" required="yes">
      <prompt>Which tools were inspected?</prompt>
      <option value="radio">Radio</option>
      <option value="lamp">Lamp</option>
      <option value="beacon">Beacon</option>
    </question>
  </page>
</questionnaire>