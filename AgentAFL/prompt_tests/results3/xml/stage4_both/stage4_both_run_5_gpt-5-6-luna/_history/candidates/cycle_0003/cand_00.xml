<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!DOCTYPE museum [
  <!ELEMENT museum (exhibit+, curator?, note*)>
  <!ELEMENT exhibit (title, artifact+, provenance?)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT artifact (#PCDATA|label|image)*>
  <!ELEMENT label (#PCDATA)>
  <!ELEMENT image EMPTY>
  <!ELEMENT provenance (origin, date?, transfer*)>
  <!ELEMENT origin (#PCDATA)>
  <!ELEMENT date (#PCDATA)>
  <!ELEMENT transfer (#PCDATA)>
  <!ELEMENT curator (#PCDATA)>
  <!ELEMENT note (#PCDATA)>
  <!ATTLIST museum xml:lang NMTOKEN #IMPLIED>
  <!ATTLIST exhibit accession ID #REQUIRED era CDATA #IMPLIED>
  <!ATTLIST artifact kind (painting|sculpture|textile|unknown) "unknown">
  <!ATTLIST image src URI #REQUIRED width NMTOKEN #IMPLIED height NMTOKEN #IMPLIED>
  <!ATTLIST transfer from CDATA #IMPLIED to CDATA #IMPLIED>
  <!ENTITY curatorName "Dr. Élodie Varga">
  <!ENTITY citation "Collected during the winter survey.">
]>
<museum xml:lang="fr">
  <curator>&curatorName;</curator>
  <exhibit accession="A-0042" era="late-antique">
    <title>Fragments and Light</title>
    <artifact kind="painting">Pigment <label>vermillion</label> and mineral dust <image src="urn:image:0042" width="640" height="480"/></artifact>
    <artifact kind="textile"><![CDATA[warp / weft / unfinished edge]]></artifact>
    <provenance>
      <origin>North gallery</origin>
      <date>1897-11-03</date>
      <transfer from="estate" to="museum">Acquired by exchange</transfer>
    </provenance>
  </exhibit>
  <note>&citation;</note>
</museum>