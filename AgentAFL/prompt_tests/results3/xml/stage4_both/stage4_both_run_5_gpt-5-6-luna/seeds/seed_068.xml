<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE transcript [
  <!ELEMENT transcript (header, exchange+)>
  <!ELEMENT header (subject, participants, confidentiality)>
  <!ELEMENT subject (#PCDATA)>
  <!ELEMENT participants (person+)>
  <!ELEMENT person (#PCDATA)>
  <!ELEMENT confidentiality (#PCDATA)>
  <!ELEMENT exchange (speaker, timestamp, utterance, annotation*)>
  <!ELEMENT speaker (#PCDATA)>
  <!ELEMENT timestamp (#PCDATA)>
  <!ELEMENT utterance (#PCDATA|quote|pause|term)*>
  <!ELEMENT quote (#PCDATA)>
  <!ELEMENT pause EMPTY>
  <!ELEMENT term (#PCDATA)>
  <!ELEMENT annotation (#PCDATA)>
  <!ATTLIST transcript id ID #REQUIRED language CDATA "en">
  <!ATTLIST exchange sequence NMTOKEN #REQUIRED>
  <!ATTLIST pause duration CDATA #REQUIRED>
  <!ATTLIST term type (technical|proper|uncertain) "technical">
  <!ATTLIST annotation category CDATA #REQUIRED>
  <!ENTITY speakerOne "Mara">
  <!ENTITY speakerTwo "Ivo">
]>
<transcript id="meeting-42" language="en">
  <header>
    <subject>Migration review</subject>
    <participants>
      <person>&speakerOne; Chen</person>
      <person>&speakerTwo; Novak</person>
      <person>Samir Patel</person>
    </participants>
    <confidentiality>internal</confidentiality>
  </header>
  <exchange sequence="1">
    <speaker>&speakerOne;</speaker>
    <timestamp>09:00:14</timestamp>
    <utterance>We should preserve the <term type="technical">wire format</term> during the transition.</utterance>
    <annotation category="action">Document compatibility cases.</annotation>
  </exchange>
  <exchange sequence="2">
    <speaker>&speakerTwo;</speaker>
    <timestamp>09:01:02</timestamp>
    <utterance><quote>Nothing changes at the boundary</quote><pause duration="750ms"/>unless the adapter rewrites headers.</utterance>
    <annotation category="risk">Legacy clients may omit the version field.</annotation>
  </exchange>
</transcript>