<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE observatory [
  <!ELEMENT observatory (site, session*)>
  <!ELEMENT site (name, coordinates)>
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT coordinates (latitude, longitude, altitude?)>
  <!ELEMENT latitude (#PCDATA)>
  <!ELEMENT longitude (#PCDATA)>
  <!ELEMENT altitude (#PCDATA)>
  <!ELEMENT session (instrument+, remark*)>
  <!ELEMENT instrument (reading+, calibration?)>
  <!ELEMENT reading (#PCDATA)>
  <!ELEMENT calibration (#PCDATA)>
  <!ELEMENT remark (#PCDATA|emphasis)*>
  <!ELEMENT emphasis (#PCDATA)>
  <!ATTLIST observatory xml:lang NMTOKEN #IMPLIED>
  <!ATTLIST session code ID #REQUIRED phase (dawn|day|night) "day">
  <!ATTLIST instrument type (optical|radio|magnetic) #REQUIRED>
  <!ATTLIST reading unit CDATA #IMPLIED>
  <!ATTLIST reading quality (raw|checked|estimated) "raw">
  <!ENTITY approx "approximately">
]>
<observatory xml:lang="en">
  <site>
    <name>Raven Ridge Station</name>
    <coordinates>
      <latitude>46.8127N</latitude>
      <longitude>121.7426W</longitude>
      <altitude>2140m</altitude>
    </coordinates>
  </site>
  <session code="s-01" phase="night">
    <instrument type="optical">
      <reading unit="nm" quality="checked">632.8</reading>
      <reading unit="nm">633.1</reading>
      <calibration>Reference lamp stable; drift &approx; 0.02</calibration>
    </instrument>
    <remark>Cloud cover <emphasis>thin</emphasis> above the western ridge.</remark>
  </session>
  <session code="s-02" phase="dawn">
    <instrument type="magnetic">
      <reading unit="nT" quality="estimated">48123</reading>
    </instrument>
    <remark><![CDATA[Sensor enclosure reopened after frost warning.]]></remark>
  </session>
</observatory>