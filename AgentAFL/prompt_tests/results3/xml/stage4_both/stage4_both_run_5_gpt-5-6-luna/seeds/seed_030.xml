<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE archive [
  <!ELEMENT archive (record+)>
  <!ELEMENT record (heading, body, tag*)>
  <!ELEMENT heading (#PCDATA)>
  <!ELEMENT body (#PCDATA|code|br)*>
  <!ELEMENT code (#PCDATA)>
  <!ELEMENT br EMPTY>
  <!ELEMENT tag (#PCDATA)>
  <!ATTLIST archive xml:lang NMTOKEN #IMPLIED>
  <!ATTLIST record id ID #REQUIRED status (draft|published|withdrawn) "draft">
  <!ATTLIST tag key NMTOKEN #REQUIRED>
  <!NOTATION png SYSTEM "image/png">
  <!ENTITY logo SYSTEM "archive-logo.png" NDATA png>
  <!ENTITY publisher "Northwind &amp; Sons">
  <!ENTITY revision "second edition">
]>
<archive xml:lang="en" id="collection-main">
  <!-- A record containing mixed content and entity-expanded text. -->
  <record id="r-001" status="published">
    <heading>Field notes from &publisher;</heading>
    <body>Use <code>--catalog</code> before scanning.<br/>The &revision; includes a revised index.</body>
    <tag key="topic">cataloguing</tag>
    <tag key="year">2025</tag>
  </record>
  <record id="r-002">
    <heading>Unpublished fragment</heading>
    <body><![CDATA[Literal markup: <entry status="raw"/> remains untouched.]]></body>
    <tag key="topic">preservation</tag>
  </record>
</archive>