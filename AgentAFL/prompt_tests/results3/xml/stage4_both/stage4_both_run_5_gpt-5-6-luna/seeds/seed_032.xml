<?xml version="1.0" encoding="UTF-8"?>
<package xmlns="urn:example:package"
         xmlns:xi="http://www.w3.org/2001/XInclude"
         xmlns:ext="urn:example:extension"
         version="3.4">
  <?build profile="portable"?>
  <metadata>
    <title>Portable data bundle</title>
    <creator xml:lang="ja">佐藤 京子</creator>
    <keywords>XML, parsing, interoperability</keywords>
  </metadata>
  <resources>
    <resource id="main" media-type="application/xml" checksum="sha256:00ff11">
      <xi:include href="parts/main.xml" parse="xml">
        <xi:fallback>
          <notice>Embedded fallback content.</notice>
        </xi:fallback>
      </xi:include>
    </resource>
    <resource id="readme" media-type="text/plain">
      <xi:include href="README.txt" parse="text">
        <xi:fallback><![CDATA[No external readme was supplied.]]></xi:fallback>
      </xi:include>
    </resource>
  </resources>
  <ext:embedded><![CDATA[
    function transform(node) {
      return "<result>" + node.value + "</result>";
    }
  ]]></ext:embedded>
  <links>
    <link rel="self" href="urn:bundle:portable-34"/>
    <link rel="license" href="https://example.invalid/license" xml:base="https://example.invalid/"/>
  </links>
</package>