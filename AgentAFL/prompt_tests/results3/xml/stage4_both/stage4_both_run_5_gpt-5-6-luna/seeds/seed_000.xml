<?xml version="1.0"?>
<!DOCTYPE library [
  <!ELEMENT library (book+, shelf?)>
  <!ELEMENT book (title, author+, summary?, chapter*)>
  <!ATTLIST book
    id ID #REQUIRED
    available (yes|no) "yes">
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT author (#PCDATA)>
  <!ELEMENT summary (#PCDATA|em|code)*>
  <!ELEMENT chapter (#PCDATA|section)*>
  <!ELEMENT section (#PCDATA|em|code)*>
  <!ELEMENT em (#PCDATA)>
  <!ELEMENT code (#PCDATA)>
  <!ELEMENT shelf EMPTY>
]>
<library>
  <book id="b1" available="no">
    <title>Parsing &amp; Recovery</title>
    <author>Ada Example</author>
    <author>Lin Parser</author>
    <summary>Text with <em>mixed</em> content and <code>&lt;tokens&gt;</code>.</summary>
    <chapter><section>First section</section><section>Second section</section></chapter>
  </book>
  <shelf/>
</library>