<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE canvas [
  <!ELEMENT canvas (layer+)>
  <!ELEMENT layer (group|shape|text|use)*>
  <!ELEMENT group (group|shape|text|use)*>
  <!ELEMENT shape EMPTY>
  <!ELEMENT text (#PCDATA|tspan)*>
  <!ELEMENT tspan (#PCDATA)>
  <!ELEMENT use EMPTY>
  <!ATTLIST canvas width CDATA #REQUIRED height CDATA #REQUIRED>
  <!ATTLIST layer name CDATA #IMPLIED locked (true|false) "false">
  <!ATTLIST group id ID #IMPLIED transform CDATA #IMPLIED>
  <!ATTLIST shape id ID #IMPLIED type (rect|circle|path) #REQUIRED>
  <!ATTLIST text x CDATA #IMPLIED y CDATA #IMPLIED>
  <!ATTLIST tspan dx CDATA #IMPLIED dy CDATA #IMPLIED>
  <!ATTLIST use href IDREF #REQUIRED>
  <!ENTITY nbsp "&#160;">
]>
<canvas xmlns="urn:example:graphics" width="800" height="600">
  <layer name="background">
    <shape id="frame" type="rect" x="0" y="0" width="800" height="600" fill="#101820"/>
  </layer>
  <layer name="foreground" locked="true">
    <group id="legend" transform="translate(40,32)">
      <shape id="marker" type="circle" cx="12" cy="12" r="12" fill="gold"/>
      <text x="34" y="18">Signal<tspan dx="4" dy="2">&nbsp;online</tspan></text>
      <use href="frame"/>
    </group>
    <group transform="scale(0.5)">
      <shape type="path" d="M0,0 L10,20 L30,5 Z" fill="none" stroke="white"/>
      <text x="20" y="80"><tspan>nested</tspan> labels</text>
    </group>
  </layer>
</canvas>