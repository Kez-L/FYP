<?xml version="1.0" encoding="UTF-8"?>
<svg xmlns="http://www.w3.org/2000/svg"
     xmlns:xlink="http://www.w3.org/1999/xlink"
     xmlns:ink="http://example.org/ink"
     version="1.1" width="240" height="120" viewBox="0 0 240 120"
     xml:base="https://assets.example.test/drawings/">
  <title xml:lang="en">A small annotated diagram</title>
  <desc>Shapes, gradients, foreign content, and a linked label.</desc>
  <defs>
    <linearGradient id="shade" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#ffffff"/>
      <stop offset="100%" stop-color="#336699"/>
    </linearGradient>
    <path id="curve" d="M 8 80 C 45 5, 95 115, 150 35"/>
  </defs>
  <g id="layer-main" transform="translate(4,7)" ink:layer="foreground">
    <rect x="0" y="0" width="220" height="100" rx="12" fill="url(#shade)"/>
    <use xlink:href="#curve" fill="none" stroke="#111111" stroke-width="2"/>
    <circle cx="72" cy="53" r="14" fill="#f0b400">
      <title>Control point</title>
    </circle>
    <a xlink:href="pages/next.xml" target="_blank">
      <text x="18" y="94" font-size="12">continue</text>
    </a>
  </g>
  <foreignObject x="155" y="12" width="55" height="35">
    <html xmlns="http://www.w3.org/1999/xhtml">
      <body><p class="tiny"><strong>note</strong></p></body>
    </html>
  </foreignObject>
</svg>