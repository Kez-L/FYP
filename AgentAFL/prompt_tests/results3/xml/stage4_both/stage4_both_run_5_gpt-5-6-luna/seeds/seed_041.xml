<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE drawing [
  <!ELEMENT drawing (metadata, layer+)>
  <!ELEMENT metadata (title, author?, dimensions)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT author (#PCDATA)>
  <!ELEMENT dimensions EMPTY>
  <!ELEMENT layer (group|path|text|use)*>
  <!ELEMENT group (group|path|text|use)*>
  <!ELEMENT path EMPTY>
  <!ELEMENT text (#PCDATA)>
  <!ELEMENT use EMPTY>
  <!ATTLIST layer name CDATA #REQUIRED>
  <!ATTLIST dimensions width CDATA #REQUIRED height CDATA #REQUIRED unit CDATA #IMPLIED>
  <!ATTLIST path d CDATA #REQUIRED fill CDATA #IMPLIED stroke CDATA #IMPLIED>
  <!ATTLIST text x CDATA #REQUIRED y CDATA #REQUIRED>
  <!ATTLIST use href CDATA #REQUIRED>
]>
<drawing xmlns="http://www.w3.org/2000/svg"
         xmlns:ink="http://www.inkscape.org/namespaces/inkscape"
         viewBox="0 0 640 480">
  <metadata>
    <title>Curves &amp; corners</title>
    <author><![CDATA[vector-team]]></author>
    <dimensions width="640" height="480" unit="px"/>
  </metadata>
  <layer name="background" ink:label="Backdrop">
    <path d="M0,0 H640 V480 H0 Z" fill="#101820"/>
  </layer>
  <layer name="shapes">
    <group>
      <path d="M12.5,20 C40,4 90,4 120,20" fill="none" stroke="white"/>
      <text x="24" y="96">A <![CDATA[<curve>]]> &amp; a line</text>
      <use href="#missing-symbol"/>
    </group>
  </layer>
</drawing>