<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE drawing [
  <!ELEMENT drawing (layer+)>
  <!ELEMENT layer (group|path|text|use)*>
  <!ATTLIST layer name CDATA #REQUIRED visible (yes|no) "yes">
  <!ELEMENT group (group|path|text|use)*>
  <!ATTLIST group transform CDATA #IMPLIED>
  <!ELEMENT path EMPTY>
  <!ATTLIST path d CDATA #REQUIRED fill CDATA #IMPLIED stroke CDATA #IMPLIED>
  <!ELEMENT text (#PCDATA)>
  <!ATTLIST text x CDATA #REQUIRED y CDATA #REQUIRED>
  <!ELEMENT use EMPTY>
  <!ATTLIST use href IDREF #REQUIRED>
]>
<drawing>
  <layer name="background">
    <path d="M0,0 H640 V480 H0 Z" fill="#101820"/>
  </layer>
  <layer name="geometry" visible="yes">
    <group transform="translate(32,48) rotate(-3)">
      <path d="M10 20 C40 0,80 0,110 20 S180 40,220 12" fill="none" stroke="white"/>
      <text x="14" y="92">Contour &lt;A&gt;</text>
      <use href="shape-main"/>
    </group>
  </layer>
  <layer name="labels" visible="no">
    <group>
      <path d="M2,2 L8,2 L8,8 L2,8 Z" fill="gold"/>
      <text x="4" y="12">draft</text>
    </group>
  </layer>
</drawing>