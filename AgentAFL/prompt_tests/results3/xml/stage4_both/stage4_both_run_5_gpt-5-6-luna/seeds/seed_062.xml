<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE graph [
  <!ELEMENT graph (node+, edge*)>
  <!ELEMENT node (label, property*)>
  <!ELEMENT edge (annotation?)>
  <!ELEMENT label (#PCDATA)>
  <!ELEMENT property (#PCDATA)>
  <!ELEMENT annotation (#PCDATA)>
  <!ATTLIST graph directed (true|false) "true">
  <!ATTLIST node id ID #REQUIRED type (person|place|thing) #IMPLIED>
  <!ATTLIST edge source IDREF #REQUIRED target IDREF #REQUIRED weight NMTOKEN #IMPLIED>
  <!ATTLIST property key NMTOKEN #REQUIRED>
  <!ENTITY copyright "© 2026">
]>
<graph directed="true">
  <node id="n1" type="person">
    <label>Engineer</label>
    <property key="team">platform</property>
    <property key="timezone">UTC&amp;GMT</property>
  </node>
  <node id="n2" type="place">
    <label>Datacenter</label>
    <property key="region">eu-west</property>
  </node>
  <node id="n3" type="thing">
    <label>Archive</label>
    <property key="retention">7y</property>
  </node>
  <node id="n4">
    <label>Unclassified</label>
  </node>
  <edge source="n1" target="n2" weight="4">
    <annotation>maintains</annotation>
  </edge>
  <edge source="n2" target="n3" weight="2"/>
  <edge source="n3" target="n4">
    <annotation><![CDATA[derived from historical records]]></annotation>
  </edge>
  <edge source="n4" target="n1" weight="1">
    <annotation>&copyright;</annotation>
  </edge>
</graph>