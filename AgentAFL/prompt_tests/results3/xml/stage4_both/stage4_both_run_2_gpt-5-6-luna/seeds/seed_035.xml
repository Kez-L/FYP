<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE library [
  <!ELEMENT library (section+)>
  <!ELEMENT section (title, book*)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT book (title, author+, summary?, edition*)>
  <!ELEMENT author (#PCDATA)>
  <!ELEMENT summary (#PCDATA|i|u|code)*>
  <!ELEMENT i (#PCDATA)>
  <!ELEMENT u (#PCDATA)>
  <!ELEMENT code (#PCDATA)>
  <!ELEMENT edition EMPTY>
  <!ATTLIST section id ID #REQUIRED>
  <!ATTLIST book isbn CDATA #IMPLIED available (true|false) "true">
  <!ATTLIST edition year CDATA #REQUIRED publisher CDATA #IMPLIED>
]>
<library>
  <section id="fiction">
    <title>Fiction</title>
    <book isbn="978000000001" available="true">
      <title>The Glass Orchard</title>
      <author>Marin Vale</author>
      <author>Oren Pike</author>
      <summary>A story of <i>memory</i>, <u>weather</u>, and <code>return</code>.</summary>
      <edition year="2018" publisher="North House"/>
      <edition year="2024"/>
    </book>
  </section>
  <section id="reference">
    <title>Reference</title>
    <book available="false">
      <title>Atlas of Small Rivers</title>
      <author>Kei Doran</author>
    </book>
  </section>
</library>