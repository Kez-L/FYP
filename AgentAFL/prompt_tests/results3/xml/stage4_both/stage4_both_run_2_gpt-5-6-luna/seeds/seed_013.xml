<?xml version="1.0"?>
<!DOCTYPE warehouse [
  <!ELEMENT warehouse (zone*)>
  <!ELEMENT zone (label, container*)>
  <!ELEMENT label (#PCDATA)>
  <!ELEMENT container (item|container)*>
  <!ELEMENT item EMPTY>
  <!ATTLIST zone code ID #REQUIRED>
  <!ATTLIST container kind (crate|bin|pallet) #REQUIRED>
  <!ATTLIST item sku CDATA #REQUIRED quantity CDATA #IMPLIED fragile (yes|no) "no">
  <!NOTATION jpeg SYSTEM "image/jpeg">
  <!NOTATION png SYSTEM "image/png">
  <!ENTITY logo SYSTEM "logo.png" NDATA png>
]>
<warehouse>
  <zone code="Z-A">
    <label>North &amp; loading</label>
    <container kind="pallet">
      <container kind="crate">
        <item sku="R-1" quantity="8" fragile="yes"/>
        <item sku="R-2" quantity="0"/>
      </container>
      <container kind="bin">
        <item sku="S-7" quantity="19"/>
      </container>
    </container>
  </zone>
  <zone code="Z-B">
    <label>Cold storage</label>
    <container kind="bin">
      <item sku="F-11" quantity="4" fragile="yes"/>
      <container kind="crate">
        <item sku="F-12" quantity="2" fragile="yes"/>
      </container>
    </container>
  </zone>
</warehouse>