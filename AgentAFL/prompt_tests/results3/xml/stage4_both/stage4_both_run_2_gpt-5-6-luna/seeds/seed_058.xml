  <entry key="memo-α" visibility="restricted">
    <header>
      <title>On bounded retries</title>
      <author>R. Vale</author>
      <author>M. Chen</author>
      <date>2026-09-23</date>
    </header>
    <body>
      <paragraph number="1">A retry is useful only when the failure may change.</paragraph>
      <paragraph number="2">The service returned <highlight color="amber">temporarily unavailable</highlight> after the third attempt.<break/>We recorded the response as <code language="http">503</code>.</paragraph>
      <paragraph number="3">&copyright; Keep the interval visible to operators.</paragraph>
    </body>
    <index>
      <term>backoff</term>
      <term>failure modes</term>
      <term>observability</term>
    </index>
  </entry>
