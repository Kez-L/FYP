<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE itinerary [
  <!ELEMENT itinerary (trip, disclaimer)>
  <!ELEMENT trip (destination, stop+)>
  <!ELEMENT destination (#PCDATA)>
  <!ELEMENT stop (arrival, departure, activity*)>
  <!ELEMENT arrival (#PCDATA)>
  <!ELEMENT departure (#PCDATA)>
  <!ELEMENT activity (#PCDATA|location)*>
  <!ELEMENT location EMPTY>
  <!ELEMENT disclaimer (#PCDATA)>
  <!ATTLIST itinerary xmlns CDATA #IMPLIED>
  <!ATTLIST trip id ID #REQUIRED timezone CDATA #IMPLIED>
  <!ATTLIST stop day NMTOKEN #REQUIRED overnight (yes|no) "no">
  <!ATTLIST activity kind (meal|visit|travel|rest) #REQUIRED>
  <!ATTLIST location city CDATA #REQUIRED country CDATA #REQUIRED>
  <!ENTITY dash "&#x2014;">
  <!ENTITY cafe "caf&#xE9;">
]>
<itinerary xmlns="urn:travel:plan" xmlns:x="urn:travel:extra">
  <trip id="spring-route" timezone="Europe/Paris">
    <destination>France &dash; Belgium</destination>
    <stop day="1">
      <arrival>2027-04-12T09:30:00+02:00</arrival>
      <departure>2027-04-12T18:00:00+02:00</departure>
      <activity kind="travel">Train to <location city="Paris" country="FR"/></activity>
      <activity kind="meal">Lunch at a &cafe; near the river.</activity>
      <activity kind="visit">Museum quarter</activity>
    </stop>
    <stop day="2" overnight="yes">
      <arrival>2027-04-13T08:00:00+02:00</arrival>
      <departure>2027-04-14T07:15:00+02:00</departure>
      <activity kind="travel">Regional connection</activity>
      <activity kind="rest">Hotel check-in</activity>
    </stop>
  </trip>
  <disclaimer>Times are estimates; reservations may change.</disclaimer>
</itinerary>