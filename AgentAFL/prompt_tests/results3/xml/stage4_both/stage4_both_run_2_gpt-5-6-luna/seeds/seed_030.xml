<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!DOCTYPE catalog [
  <!ELEMENT catalog (category+)>
  <!ELEMENT category (name, item*)>
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT item (sku, description, price, tags?)>
  <!ELEMENT sku (#PCDATA)>
  <!ELEMENT description (#PCDATA|em|br)*>
  <!ELEMENT em (#PCDATA)>
  <!ELEMENT br EMPTY>
  <!ELEMENT price (#PCDATA)>
  <!ELEMENT tags (tag+)>
  <!ELEMENT tag (#PCDATA)>
  <!ATTLIST category key NMTOKEN #REQUIRED>
  <!ATTLIST item code ID #REQUIRED status (active|retired) "active">
  <!ATTLIST price currency (USD|EUR|JPY) "USD">
  <!ENTITY trademark "™">
  <!ENTITY spacer " ">
]>
<catalog>
  <category key="tools">
    <name>Workshop tools</name>
    <item code="hammer-01">
      <sku>HAM-01</sku>
      <description>Forged steel <em>claw</em> hammer<br/>with ash handle.</description>
      <price currency="USD">24.50</price>
      <tags>
        <tag>hand-tool</tag>
        <tag>metal</tag>
      </tags>
    </item>
    <item code="vise-02" status="retired">
      <sku>VIS-02</sku>
      <description>Bench vise &amp; swivel base &ENTITY;</description>
      <price>89.00</price>
    </item>
  </category>
</catalog>