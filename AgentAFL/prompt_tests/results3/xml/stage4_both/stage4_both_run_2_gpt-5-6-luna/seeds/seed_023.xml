<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE geometry [
  <!ELEMENT geometry (layer+)>
  <!ELEMENT layer (point|path|group)*>
  <!ELEMENT point EMPTY>
  <!ELEMENT path (point+)>
  <!ELEMENT group (point|path|group)*>
  <!ATTLIST layer name CDATA #REQUIRED visible (true|false) "true">
  <!ATTLIST point x CDATA #REQUIRED y CDATA #REQUIRED label CDATA #IMPLIED>
  <!ATTLIST path id ID #REQUIRED closed (true|false) "false">
  <!ATTLIST group id ID #IMPLIED transform CDATA #IMPLIED>
]>
<g:geometry xmlns:g="urn:example:geometry" xmlns:meta="urn:example:metadata">
  <g:layer name="background" visible="false">
    <g:group id="frame" transform="translate(10,20) rotate(3)">
      <g:point x="0" y="0" label="origin"/>
      <g:path id="border" closed="true">
        <g:point x="0" y="0"/>
        <g:point x="100" y="0"/>
        <g:point x="100" y="80"/>
        <g:point x="0" y="80"/>
      </g:path>
    </g:group>
  </g:layer>
  <g:layer name="annotations">
    <g:path id="axis">
      <g:point x="-5" y="40" meta:unit="px"/>
      <g:point x="105" y="40" meta:unit="px"/>
    </g:path>
    <g:group transform="scale(0.5)">
      <g:point x="12.5" y="7.25" label="half"/>
    </g:group>
  </g:layer>
</g:geometry>