<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE map [
  <!ELEMENT map (title, layer+)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT layer (name, bounds, feature*)>
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT bounds EMPTY>
  <!ELEMENT feature (label?, geometry, metadata?)>
  <!ELEMENT label (#PCDATA)>
  <!ELEMENT geometry (point|path|polygon)>
  <!ELEMENT point EMPTY>
  <!ELEMENT path EMPTY>
  <!ELEMENT polygon EMPTY>
  <!ELEMENT metadata (item*)>
  <!ELEMENT item (#PCDATA)>
  <!ATTLIST layer id ID #REQUIRED visible (true|false) "true">
  <!ATTLIST bounds north CDATA #REQUIRED south CDATA #REQUIRED east CDATA #REQUIRED west CDATA #REQUIRED>
  <!ATTLIST feature id ID #REQUIRED kind (landmark|road|water|boundary) #REQUIRED>
  <!ATTLIST point lat CDATA #REQUIRED lon CDATA #REQUIRED>
  <!ATTLIST path d CDATA #REQUIRED>
  <!ATTLIST polygon points CDATA #REQUIRED>
  <!ATTLIST item key NMTOKEN #REQUIRED>
]>
<map>
  <title>Coastal Survey 2042</title>
  <layer id="terrain" visible="true">
    <name>Terrain</name>
    <bounds north="52.14" south="51.88" east="-1.02" west="-1.47"/>
    <feature id="f001" kind="landmark">
      <label>Old Observatory</label>
      <geometry>
        <point lat="52.031" lon="-1.214"/>
      </geometry>
      <metadata>
        <item key="elevation">318m</item>
        <item key="condition">restored</item>
      </metadata>
    </feature>
    <feature id="f002" kind="road">
      <label>North Ridge Track</label>
      <geometry>
        <path d="M -1.40,51.92 C -1.31,51.98 -1.27,52.04 -1.12,52.11"/>
      </geometry>
    </feature>
  </layer>
  <layer id="coastline">
    <name>Protected Shore</name>
    <bounds north="52.10" south="51.90" east="-1.08" west="-1.43"/>
    <feature id="f003" kind="boundary">
      <geometry>
        <polygon points="-1.40,51.93 -1.28,51.91 -1.10,51.98 -1.17,52.08"/>
      </geometry>
      <metadata>
        <item key="status">restricted &amp; monitored</item>
      </metadata>
    </feature>
  </layer>
</map>