<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE library [
  <!ELEMENT library (shelf+)>
  <!ELEMENT shelf (name, book*)>
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT book (title, author+, published?, description)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT author (#PCDATA)>
  <!ELEMENT published (#PCDATA)>
  <!ELEMENT description (#PCDATA|em|code|br)*>
  <!ELEMENT em (#PCDATA)>
  <!ELEMENT code (#PCDATA)>
  <!ELEMENT br EMPTY>
  <!ATTLIST shelf id ID #REQUIRED>
  <!ATTLIST book isbn CDATA #IMPLIED available (yes|no) "yes">
  <!ENTITY library-name "Riverside &amp; Municipal Library">
]>
<library>
  <shelf id="fiction">
    <name>&library-name; — Fiction</name>
    <book isbn="978-0-00-000001-1">
      <title>The Glass Meridian</title>
      <author>Amara Vale</author>
      <author>Jon Bell</author>
      <published>2019</published>
      <description>A study of <em>memory</em> and <code>place</code>.<br/>Second edition.</description>
    </book>
    <book isbn="978-0-00-000002-8" available="no">
      <title>Winter Signals</title>
      <author>M. R. Chen</author>
      <description>Short stories from the northern coast.</description>
    </book>
  </shelf>
  <shelf id="reference">
    <name>Reference</name>
    <book isbn="978-0-00-000003-5">
      <title>Atlas of Small Waters</title>
      <author>Priya Nandakumar</author>
      <published>2024</published>
      <description>Maps, notes, and field observations.</description>
    </book>
  </shelf>
</library>