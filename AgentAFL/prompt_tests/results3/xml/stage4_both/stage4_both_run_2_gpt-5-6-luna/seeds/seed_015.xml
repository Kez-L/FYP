<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE dashboard [
  <!ELEMENT dashboard (title, panel+, footer?)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT panel (label, gauge*, note?)>
  <!ELEMENT label (#PCDATA)>
  <!ELEMENT gauge EMPTY>
  <!ELEMENT note (#PCDATA|strong|br)*>
  <!ELEMENT strong (#PCDATA)>
  <!ELEMENT br EMPTY>
  <!ATTLIST panel key ID #REQUIRED theme (light|dark|contrast) "light">
  <!ATTLIST gauge name CDATA #REQUIRED value CDATA #IMPLIED>
  <!ENTITY warning "Check &lt;threshold&gt; before continuing.">
]>
<dashboard xml:lang="en" xml:base="https://example.invalid/ui/">
  <title>Operations dashboard</title>
  <panel key="cpu" theme="dark">
    <label>Processor</label>
    <gauge name="load" value="0.73"/>
    <gauge name="temperature" value="68.4"/>
    <note>Current state: <strong>stable</strong><br/> &warning;</note>
  </panel>
  <panel key="disk" theme="contrast">
    <label>Storage</label>
    <gauge name="used" value="91%"/>
    <note>Capacity requires <strong>review</strong>.</note>
  </panel>
  <footer><![CDATA[Rendered by <widget>core</widget>]]></footer>
</dashboard>