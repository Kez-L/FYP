<?xml version="1.0"?>
<!DOCTYPE archive [
  <!ELEMENT archive (collection*)>
  <!ELEMENT collection (record+)>
  <!ELEMENT record (headline, author+, binary?)>
  <!ELEMENT headline (#PCDATA)>
  <!ELEMENT author (#PCDATA)>
  <!ELEMENT binary EMPTY>
  <!ATTLIST collection name CDATA #REQUIRED>
  <!ATTLIST record id ID #REQUIRED related IDREFS #IMPLIED format (text|image|audio) "text">
  <!ATTLIST binary source ENTITY #REQUIRED>
  <!NOTATION png SYSTEM "image/png">
  <!ENTITY logo SYSTEM "logo.png" NDATA png>
  <!ENTITY % optional "INCLUDE">
  <![%optional;[
    <!ELEMENT annotation (#PCDATA)>
    <!ATTLIST record reviewed (yes|no) "no">
  ]]>
]>
<archive>
  <collection name="field-notes">
    <record id="r001" format="text" reviewed="yes">
      <headline>Observed nesting behavior</headline>
      <author>Lin</author>
      <author>Rao</author>
    </record>
    <record id="r002" related="r001" format="image" reviewed="no">
      <headline>Microscope plate</headline>
      <author>Lin</author>
      <binary source="logo"/>
    </record>
  </collection>
</archive>