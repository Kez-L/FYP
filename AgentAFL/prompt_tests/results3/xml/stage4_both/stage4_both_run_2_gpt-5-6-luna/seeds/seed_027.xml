<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!DOCTYPE notebook [
  <!ELEMENT notebook ANY>
  <!ELEMENT chapter (heading, block+)>
  <!ELEMENT heading (#PCDATA)>
  <!ELEMENT block (#PCDATA|strong|quote|separator|formula)*>
  <!ELEMENT strong (#PCDATA)>
  <!ELEMENT quote (#PCDATA|strong)*>
  <!ELEMENT separator EMPTY>
  <!ELEMENT formula (#PCDATA)>
  <!ATTLIST notebook xml:space (default|preserve) "default">
  <!ATTLIST chapter number NMTOKEN #REQUIRED>
  <!ATTLIST block type (text|warning|example) "text">
  <!ENTITY nbsp "&#160;">
  <!ENTITY open "&lt;![CDATA[">
  <!ENTITY close "]]&gt;">
]>
<notebook xml:space="preserve">
  <chapter number="01">
    <heading>Parsing notes</heading>
    <block type="text">Leading spaces remain.&nbsp;&nbsp;Trailing markers follow.</block>
    <block type="warning">Do not treat &open; as a real section; the token is literal.&close;</block>
    <block type="example">
      Call <strong>normalize()</strong>, then inspect
      <quote>the resulting tree</quote>.
      <separator/>
      <formula>x &lt;= y &amp;&amp; y != 0</formula>
    </block>
  </chapter>
  <chapter number="02">
    <heading>Encoded fragments</heading>
    <block><![CDATA[<node attr="raw">not parsed</node>]]></block>
  </chapter>
</notebook>