<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE graph [
  <!ELEMENT graph (vertex*, edge*)>
  <!ELEMENT vertex (title, metadata?)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT metadata (property*)>
  <!ELEMENT property (#PCDATA)>
  <!ELEMENT edge EMPTY>
  <!ATTLIST graph directed (true|false) "true">
  <!ATTLIST vertex id ID #REQUIRED type (person|place|event|thing) "thing">
  <!ATTLIST edge from IDREF #REQUIRED to IDREF #REQUIRED weight CDATA "1">
  <!ATTLIST property name NMTOKEN #REQUIRED>
  <!ENTITY amp " &amp; ">
]>
<graph directed="false">
  <vertex id="n1" type="person">
    <title>Ada Lovelace</title>
    <metadata>
      <property name="era">19th century</property>
      <property name="interest">mathematics</property>
    </metadata>
  </vertex>
  <vertex id="n2" type="event">
    <title>Analytical Engine notes</title>
    <metadata>
      <property name="language">English</property>
    </metadata>
  </vertex>
  <vertex id="n3" type="place">
    <title>London</title>
  </vertex>
  <edge from="n1" to="n2" weight="0.75"/>
  <edge from="n2" to="n3"/>
</graph>