<?xml version="1.0"?>
<!DOCTYPE dashboard [
  <!ELEMENT dashboard (window, window?, footer)>
  <!ELEMENT window (caption, pane+)>
  <!ELEMENT caption (#PCDATA)>
  <!ELEMENT pane (heading?, widget*)>
  <!ELEMENT heading (#PCDATA)>
  <!ELEMENT widget (label, value, hint?)>
  <!ELEMENT label (#PCDATA)>
  <!ELEMENT value (#PCDATA|strong|code|icon)*>
  <!ELEMENT hint (#PCDATA)>
  <!ELEMENT strong (#PCDATA)>
  <!ELEMENT code (#PCDATA)>
  <!ELEMENT icon EMPTY>
  <!ELEMENT footer (#PCDATA)>
  <!ATTLIST dashboard generated CDATA #IMPLIED>
  <!ATTLIST window id ID #REQUIRED mode (normal|maximized|hidden) "normal">
  <!ATTLIST pane orientation (row|column) "row">
  <!ATTLIST widget kind (number|text|status|graphic) #REQUIRED>
  <!ATTLIST icon name NMTOKEN #REQUIRED>
  <!ENTITY open "Open">
  <!ENTITY close "Close">
]>
<dashboard generated="2026-09-23T10:15:00Z">
  <window id="main" mode="maximized">
    <caption>Operations &amp; telemetry</caption>
    <pane orientation="row">
      <heading>Current state</heading>
      <widget kind="number">
        <label>Requests</label>
        <value><strong>1842</strong> today</value>
        <hint>Since midnight</hint>
      </widget>
      <widget kind="status">
        <label>Queue</label>
        <value><icon name="check"/>&open;</value>
      </widget>
    </pane>
    <pane orientation="column">
      <widget kind="text">
        <label>Command</label>
        <value><code>sync --incremental</code></value>
      </widget>
    </pane>
  </window>
  <footer>Use &close; to dismiss this panel.</footer>
</dashboard>