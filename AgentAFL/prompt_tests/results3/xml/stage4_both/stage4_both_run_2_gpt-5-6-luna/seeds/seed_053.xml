<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE itinerary [
  <!ELEMENT itinerary (route, stop+)>
  <!ELEMENT route (name, departure, arrival)>
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT departure (#PCDATA)>
  <!ELEMENT arrival (#PCDATA)>
  <!ELEMENT stop (location, depart?, arrive?, service?)>
  <!ELEMENT location (#PCDATA)>
  <!ELEMENT depart (#PCDATA)>
  <!ELEMENT arrive (#PCDATA)>
  <!ELEMENT service (#PCDATA|delay|platform)*>
  <!ELEMENT delay EMPTY>
  <!ELEMENT platform (#PCDATA)>
  <!ATTLIST itinerary date CDATA #REQUIRED>
  <!ATTLIST route mode (rail|bus|ferry) #REQUIRED>
  <!ATTLIST stop code NMTOKEN #REQUIRED sequence NMTOKEN #REQUIRED>
  <!ATTLIST delay minutes CDATA #REQUIRED reason CDATA #IMPLIED>
  <!ENTITY morning "06:30">
  <!ENTITY arrow "&#x2192;">
]>
<itinerary date="2026-09-23">
  <route mode="rail">
    <name>North Loop &arrow; Harbor</name>
    <departure>&morning;</departure>
    <arrival>09:15</arrival>
  </route>
  <stop code="NTH" sequence="1">
    <location>North Terminal</location>
    <depart>06:30</depart>
    <arrive>06:42</arrive>
    <service><platform>4</platform></service>
  </stop>
  <stop code="MKT" sequence="2">
    <location>Market Square</location>
    <depart>07:10</depart>
    <arrive>07:18</arrive>
    <service>Boarding change <delay minutes="4" reason="signal inspection"/><platform>2B</platform></service>
  </stop>
  <stop code="HBR" sequence="3">
    <location><![CDATA[Harbor Gate <east>]]></location>
    <arrive>09:15</arrive>
    <service><platform>1</platform></service>
  </stop>
</itinerary>