<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE timetable [
  <!ELEMENT timetable (day+)>
  <!ELEMENT day (opening, slot*)>
  <!ELEMENT opening EMPTY>
  <!ELEMENT slot (course, room, instructor+)>
  <!ELEMENT course (#PCDATA)>
  <!ELEMENT room (#PCDATA)>
  <!ELEMENT instructor (#PCDATA)>
  <!ATTLIST day date CDATA #REQUIRED holiday (yes|no) "no">
  <!ATTLIST opening time CDATA #REQUIRED timezone CDATA #IMPLIED>
  <!ATTLIST slot start CDATA #REQUIRED end CDATA #REQUIRED status (scheduled|cancelled|moved) "scheduled">
  <!ATTLIST course code ID #REQUIRED credits NMTOKEN #IMPLIED>
  <!ATTLIST room building CDATA #REQUIRED floor NMTOKEN #IMPLIED>
]>
<timetable>
  <day date="2026-10-01" holiday="no">
    <opening time="08:00" timezone="UTC"/>
    <slot start="09:00" end="10:30">
      <course code="XML101" credits="3">Markup Languages</course>
      <room building="A" floor="2">A-204</room>
      <instructor>Dr. Sato</instructor>
      <instructor>Prof. Ilyan</instructor>
    </slot>
    <slot start="11:00" end="12:00" status="moved">
      <course code="FZ204">Finite Systems</course>
      <room building="C" floor="1">C-118</room>
      <instructor>R. Chen</instructor>
    </slot>
  </day>
  <day date="2026-10-02" holiday="yes">
    <opening time="10:00"/>
  </day>
</timetable>