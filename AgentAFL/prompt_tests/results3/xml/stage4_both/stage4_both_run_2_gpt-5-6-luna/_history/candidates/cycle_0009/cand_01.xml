<?xml version="1.0"?>
<!DOCTYPE map [
  <!ELEMENT map (layer+, legend?)>
  <!ELEMENT layer (label, shape+)>
  <!ELEMENT label (#PCDATA)>
  <!ELEMENT shape (point|path|area)>
  <!ELEMENT point EMPTY>
  <!ELEMENT path (point+)>
  <!ELEMENT area (ring, ring*)>
  <!ELEMENT ring (point+)>
  <!ELEMENT legend (entry+)>
  <!ELEMENT entry (swatch, caption)>
  <!ELEMENT swatch EMPTY>
  <!ELEMENT caption (#PCDATA)>
  <!ATTLIST map projection CDATA #IMPLIED>
  <!ATTLIST layer name CDATA #REQUIRED visible (true|false) "true">
  <!ATTLIST shape id ID #IMPLIED>
  <!ATTLIST point lat CDATA #REQUIRED lon CDATA #REQUIRED>
  <!ATTLIST path closed (yes|no) "no">
  <!ATTLIST area fill CDATA #IMPLIED>
  <!ATTLIST swatch color CDATA #REQUIRED>
  <!ENTITY degree "&#x00B0;">
]>
<map projection="local-grid">
  <layer name="routes">
    <label>Coastal routes</label>
    <shape id="p1">
      <point lat="41.2" lon="-71.8"/>
    </shape>
    <shape id="r7">
      <path closed="yes">
        <point lat="41.2" lon="-71.8"/>
        <point lat="41.9" lon="-70.4"/>
        <point lat="42.3" lon="-69.7"/>
      </path>
    </shape>
  </layer>
  <layer name="parks" visible="false">
    <label>Protected areas</label>
    <shape id="a9" fill="green">
      <area>
        <ring>
          <point lat="40.1" lon="-72.0"/>
          <point lat="40.4" lon="-71.4"/>
          <point lat="40.0" lon="-71.1"/>
        </ring>
      </area>
    </shape>
  </layer>
  <legend>
    <entry>
      <swatch color="#227744"/>
      <caption>elevation &lt; 500&meter;</caption>
    </entry>
  </legend>
</map>