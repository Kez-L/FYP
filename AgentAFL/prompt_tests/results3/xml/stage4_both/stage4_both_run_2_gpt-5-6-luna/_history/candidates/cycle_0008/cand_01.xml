<?xml version="1.0"?>
<!DOCTYPE canvas [
  <!ELEMENT canvas (layer+)>
  <!ELEMENT layer (shape*)>
  <!ELEMENT shape EMPTY>
  <!ATTLIST canvas width NMTOKEN #REQUIRED height NMTOKEN #REQUIRED>
  <!ATTLIST layer name CDATA #IMPLIED visible (yes|no) "yes">
  <!ATTLIST shape kind (circle|rect|path|text) #REQUIRED x CDATA #IMPLIED y CDATA #IMPLIED fill CDATA #IMPLIED>
  <!ENTITY nbsp "&#160;">
]>
<canvas width="800" height="600">
  <layer name="background">
    <shape kind="rect" x="0" y="0" fill="#ffffff"/>
  </layer>
  <layer name="foreground" visible="yes">
    <shape kind="circle" x="120.5" y="88" fill="rgb(20,40,60)"/>
    <shape kind="path" x="0" y="0" fill="none"/>
    <shape kind="text" x="24" y="40" fill="black"/>
  </layer>
  <layer name="guides" visible="no"/>
</canvas>