<?xml version="1.0"?>
<!DOCTYPE dispatch [
  <!ELEMENT dispatch (sender, subject, body, attachment?)>
  <!ELEMENT sender (#PCDATA)>
  <!ELEMENT subject (#PCDATA)>
  <!ELEMENT body (#PCDATA|quote|linebreak)*>
  <!ELEMENT quote (#PCDATA)>
  <!ELEMENT linebreak EMPTY>
  <!ELEMENT attachment (filename, checksum)>
  <!ELEMENT filename (#PCDATA)>
  <!ELEMENT checksum (#PCDATA)>
  <!ATTLIST dispatch priority (low|normal|urgent) "normal">
  <!ATTLIST attachment media CDATA #REQUIRED>
  <!ENTITY organization "North &amp; South Research">
  <!ENTITY greeting "Hello, &organization;!">
  <!ENTITY less "&lt;">
  <!ENTITY greater "&gt;">
]>
<dispatch priority="urgent">
  <sender>&organization;</sender>
  <subject>Bounds &less; and &greater;</subject>
  <body>
    &greeting;
    <linebreak/>
    <quote>Use &quot;quoted&quot; values and keep apostrophes.</quote>
    <linebreak/>
    tail &amp; continuation
  </body>
  <attachment media="text/plain">
    <filename>notes.txt</filename>
    <checksum>abc&#x2D;123&#x2D;xyz</checksum>
  </attachment>
</dispatch>