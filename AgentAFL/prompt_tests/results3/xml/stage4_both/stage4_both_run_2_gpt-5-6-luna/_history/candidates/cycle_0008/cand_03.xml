<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE conversation [
  <!ELEMENT conversation (message+)>
  <!ELEMENT message (sender, recipients, content, attachment*)>
  <!ELEMENT sender (#PCDATA)>
  <!ELEMENT recipients (recipient+)>
  <!ELEMENT recipient (#PCDATA)>
  <!ELEMENT content (#PCDATA|strong|link|br)*>
  <!ELEMENT strong (#PCDATA)>
  <!ELEMENT link (#PCDATA)>
  <!ELEMENT br EMPTY>
  <!ELEMENT attachment EMPTY>
  <!ATTLIST conversation topic CDATA #IMPLIED>
  <!ATTLIST message timestamp CDATA #REQUIRED direction (in|out) #REQUIRED>
  <!ATTLIST link href URI #REQUIRED>
  <!ATTLIST attachment filename CDATA #REQUIRED size NMTOKEN #IMPLIED>
]>
