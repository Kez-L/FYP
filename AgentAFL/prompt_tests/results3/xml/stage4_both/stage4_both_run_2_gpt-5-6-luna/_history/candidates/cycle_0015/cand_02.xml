<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE catalog [
  <!ELEMENT catalog (collection+)>
  <!ELEMENT collection (heading, item*)>
  <!ELEMENT heading (#PCDATA)>
  <!ELEMENT item (name, summary, price, tags, availability)>
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT summary (#PCDATA|strong|link)*>
  <!ELEMENT strong (#PCDATA)>
  <!ELEMENT link (#PCDATA)>
  <!ELEMENT price (#PCDATA)>
  <!ELEMENT tags (tag+)>
  <!ELEMENT tag (#PCDATA)>
  <!ELEMENT availability EMPTY>
  <!ATTLIST collection code ID #REQUIRED>
  <!ATTLIST item code ID #REQUIRED featured (yes|no) "no">
  <!ATTLIST link href URI #REQUIRED>
  <!ATTLIST availability quantity CDATA #REQUIRED state (in-stock|backorder|retired) #REQUIRED>
  <!ENTITY currency "€">
]>
