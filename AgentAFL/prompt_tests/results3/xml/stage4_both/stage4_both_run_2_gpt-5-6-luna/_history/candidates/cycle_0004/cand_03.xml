<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE itinerary [
  <!ELEMENT itinerary (trip, constraints?)>
  <!ELEMENT trip (segment+)>
  <!ELEMENT segment (departure, arrival, passenger*)>
  <!ELEMENT departure (place, time)>
  <!ELEMENT arrival (place, time)>
  <!ELEMENT passenger (#PCDATA)>
  <!ELEMENT place (#PCDATA)>
  <!ELEMENT time (#PCDATA)>
  <!ELEMENT constraints (rule*)>
  <!ELEMENT rule (#PCDATA)>
  <!ATTLIST trip code ID #REQUIRED>
  <!ATTLIST segment mode (rail|air|sea|road) #REQUIRED sequence NMTOKEN #REQUIRED>
  <!ATTLIST passenger ticket NMTOKEN #REQUIRED>
  <!ATTLIST rule kind CDATA #IMPLIED>
  <!ENTITY nbsp "&#160;">
]>
<itinerary>
  <trip code="T-884">
    <segment mode="rail" sequence="01">
      <departure>
        <place>Gare du Nord</place>
        <time zone="Europe/Paris">2026-10-04T07:10:00+02:00</time>
      </departure>
      <arrival>
        <place>Bruxelles-Midi</place>
        <time zone="Europe/Brussels">2026-10-04T08:32:00+02:00</time>
      </arrival>
      <passenger ticket="P_001">Nora&nbsp;K.</passenger>
      <passenger ticket="P_002">J. Alvarez</passenger>
    </segment>
    <segment mode="air" sequence="02">
      <departure>
        <place>Brussels Airport</place>
        <time zone="UTC">2026-10-04T11:05:00Z</time>
      </departure>
      <arrival>
        <place>Lisbon</place>
        <time zone="Europe/Lisbon">2026-10-04T12:45:00+01:00</time>
      </arrival>
      <passenger ticket="P_001">Nora&nbsp;K.</passenger>
    </segment>
  </trip>
  <constraints>
    <rule kind="baggage">One cabin item only</rule>
    <rule kind="connection"><![CDATA[Minimum connection: 45 < minutes]]></rule>
  </constraints>
</itinerary>