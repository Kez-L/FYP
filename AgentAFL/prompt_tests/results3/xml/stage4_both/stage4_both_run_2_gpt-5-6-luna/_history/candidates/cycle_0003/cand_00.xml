<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE catalog [
  <!ELEMENT catalog (section+)>
  <!ELEMENT section (heading, item*)>
  <!ELEMENT heading (#PCDATA)>
  <!ELEMENT item (name, price, description?, stock)>
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT price (#PCDATA)>
  <!ELEMENT description (#PCDATA|em|code)*>
  <!ELEMENT em (#PCDATA)>
  <!ELEMENT code (#PCDATA)>
  <!ELEMENT stock EMPTY>
  <!ATTLIST section id ID #REQUIRED>
  <!ATTLIST item sku NMTOKEN #REQUIRED status (new|used|archived) "new">
  <!ATTLIST stock quantity CDATA "0">
]>
<catalog>
