      <stock quantity="42"/>
    </item>
    <item sku="B-204" status="used">
      <name>Bench vise</name>
      <price currency="EUR">73.00</price>
      <stock quantity="3"/>
    </item>
  </section>
  <section id="supplies">
    <heading>Consumables</heading>
    <item sku="C9" status="archived">
      <name>Abrasive paper</name>
      <description><![CDATA[Grades: 80 < 120 < 240]]></description>
      <stock/>
    </item>
  </section>
</catalog>