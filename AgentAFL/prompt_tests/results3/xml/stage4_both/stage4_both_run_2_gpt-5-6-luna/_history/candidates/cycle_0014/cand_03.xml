<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE logbook [
  <!ELEMENT logbook (entry+)>
  <!ELEMENT entry (timestamp, operator, event, measurements?, attachment*)>
  <!ELEMENT timestamp (#PCDATA)>
  <!ELEMENT operator (name, badge)>
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT badge (#PCDATA)>
  <!ELEMENT event (#PCDATA)>
  <!ELEMENT measurements (measurement+)>
  <!ELEMENT measurement EMPTY>
  <!ELEMENT attachment EMPTY>
  <!ATTLIST entry id ID #REQUIRED severity (info|notice|warning|critical) "info">
  <!ATTLIST measurement key NMTOKEN #REQUIRED value CDATA #REQUIRED unit CDATA #IMPLIED>
  <!ATTLIST attachment href URI #REQUIRED media CDATA #REQUIRED>
  <!NOTATION csv SYSTEM "text/csv">
  <!ENTITY % common "source CDATA #IMPLIED">
  <!ATTLIST attachment %common;>
]>
