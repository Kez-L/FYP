<?xml version="1.0"?>
<!DOCTYPE itinerary [
  <!ELEMENT itinerary (traveler, journey)>
  <!ELEMENT traveler (name, contacts)>
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT contacts (email, phone?)>
  <!ELEMENT email (#PCDATA)>
  <!ELEMENT phone (#PCDATA)>
  <!ELEMENT journey (leg+)>
  <!ELEMENT leg (departure, arrival, transport, lodging?)>
  <!ELEMENT departure (place, time)>
  <!ELEMENT arrival (place, time)>
  <!ELEMENT place (#PCDATA)>
  <!ELEMENT time (#PCDATA)>
  <!ELEMENT transport (#PCDATA)>
  <!ELEMENT lodging (hotel, nights)>
  <!ELEMENT hotel (#PCDATA)>
  <!ELEMENT nights (#PCDATA)>
  <!ATTLIST itinerary currency CDATA #IMPLIED>
  <!ATTLIST leg sequence NMTOKEN #REQUIRED>
  <!ATTLIST transport mode (rail|air|road|sea) #REQUIRED>
  <!ENTITY city "North Harbor">
]>
<itinerary currency="EUR">
  <traveler>
    <name>Lin &amp; Noor</name>
    <contacts>
      <email>dispatch@example.test</email>
      <phone>+00 555 0102</phone>
    </contacts>
  </traveler>
  <journey>
    <leg sequence="A" >
      <departure>
        <place>Old Quay</place>
        <time>2026-10-04T06:45:00+02:00</time>
      </departure>
      <arrival>
        <place>&city;</place>
        <time>2026-10-04T09:10:00+02:00</time>
      </arrival>
      <transport mode="rail">Night express</transport>
      <lodging>
        <hotel>Lantern House</hotel>
        <nights>2</nights>
      </lodging>
    </leg>
    <leg sequence="B">
      <departure>
        <place>&city;</place>
        <time>2026-10-06T14:00:00+02:00</time>
      </departure>
      <arrival>
        <place>Westmere</place>
        <time>2026-10-06T17:25:00+02:00</time>
      </arrival>
      <transport mode="road">Shared coach</transport>
    </leg>
  </journey>
</itinerary>