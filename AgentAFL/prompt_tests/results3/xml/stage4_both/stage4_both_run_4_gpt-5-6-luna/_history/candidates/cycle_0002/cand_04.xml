<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<?pipeline mode="ตรวจสอบ"?>
<!DOCTYPE transcript [
  <!ELEMENT transcript (turn+)>
  <!ELEMENT turn (speaker, utterance, annotation*)>
  <!ELEMENT speaker EMPTY>
  <!ELEMENT utterance (#PCDATA|pause|foreign|redacted)*>
  <!ELEMENT pause EMPTY>
  <!ELEMENT foreign (#PCDATA)>
  <!ELEMENT redacted (#PCDATA)>
  <!ELEMENT annotation (#PCDATA)>
  <!ATTLIST turn number CDATA #REQUIRED>
  <!ATTLIST speaker role (human|agent|system) #REQUIRED name CDATA #IMPLIED>
  <!ATTLIST pause duration CDATA #REQUIRED>
  <!ATTLIST foreign lang NMTOKEN #REQUIRED>
  <!ENTITY mark "&#x2026;">
]>
<transcript xml:lang="en">
  <turn number="1">
    <speaker role="human" name="Zoë"/>
    <utterance>Can you parse this <foreign lang="ja">XML</foreign> safely<pause duration="0.25s"/>?</utterance>
    <annotation>Contains symbols: &lt; &gt; &amp; &quot; and &apos;.</annotation>
  </turn>
  <turn number="2">
    <speaker role="agent"/>
    <utterance>Yes<mark;/>—the token was <redacted>[removed]</redacted> from the input.</utterance>
  </turn>
  <turn number="3">
    <speaker role="system" name="Δ"/>
    <utterance><![CDATA[raw characters: <node attr="x"> & no expansion]]></utterance>
  </turn>
</transcript>