<?xml version="1.0"?>
<!DOCTYPE graph [
  <!ELEMENT graph (node+)>
  <!ELEMENT node (label?, link*)>
  <!ATTLIST node
            id ID #REQUIRED
            kind CDATA "generic">
  <!ELEMENT label (#PCDATA)>
  <!ELEMENT link EMPTY>
  <!ATTLIST link
            target IDREF #REQUIRED
            weight NMTOKEN #IMPLIED
            directed (yes|no) "yes">
]>
<graph xmlns:g="urn:graph">
  <node id="n0" kind="root">
    <label xml:space="preserve"> start <g:mark>?</g:mark> end </label>
    <link target="n1" weight="0x10"/>
    <link target="n2" directed="no"/>
  </node>
  <node id="n1"><label>βeta</label></node>
  <node id="n2">
    <link target="n1"/>
  </node>
</graph>