<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE diagram [
  <!ENTITY title "Quarterly Overview">
  <!ENTITY accent "#3366cc">
  <!ELEMENT diagram (metadata, defs, layer+)>
  <!ELEMENT metadata (title, creator, created)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT creator (#PCDATA)>
  <!ELEMENT created (#PCDATA)>
  <!ELEMENT defs (linearGradient, marker)>
  <!ELEMENT linearGradient (stop+)>
  <!ELEMENT stop EMPTY>
  <!ELEMENT marker (path)>
  <!ELEMENT path EMPTY>
  <!ELEMENT layer (rect, circle, text)>
  <!ELEMENT rect EMPTY>
  <!ELEMENT circle EMPTY>
  <!ELEMENT text (#PCDATA)>
]>
<diagram xmlns="http://www.w3.org/2000/svg"
         xmlns:ink="http://www.inkscape.org/namespaces/inkscape"
         viewBox="0 0 800 500"
         version="1.1">
  <metadata>
    <title>&title;</title>
    <creator>Vector Studio &amp; Research</creator>
    <created>2026-09-24T12:30:00Z</created>
  </metadata>
  <defs>
    <linearGradient id="background" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="&accent;" stop-opacity="1"/>
      <stop offset="100%" stop-color="#ffffff" stop-opacity="0.2"/>
    </linearGradient>
    <marker id="arrow" markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto">
      <path d="M0,0 L8,4 L0,8 z" fill="#222"/>
    </marker>
  </defs>
  <layer id="overview" ink:label="Primary layer">
    <rect x="10" y="10" width="780" height="480" rx="18" fill="url(#background)"/>
    <circle cx="180" cy="240" r="72" fill="#f7d794" stroke="#222" stroke-width="3"/>
    <text x="180" y="246" text-anchor="middle">Input &lt;stream&gt;</text>
  </layer>
  <layer id="annotation">
    <text x="400" y="80" font-size="24">Signals &amp; summaries</text>
    <text x="400" y="430" xml:space="preserve">  generated   with   spacing  </text>
  </layer>
</diagram>