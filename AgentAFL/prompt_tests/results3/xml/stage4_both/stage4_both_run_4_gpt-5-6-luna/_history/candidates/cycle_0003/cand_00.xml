<?xml version="1.0"?>
<!DOCTYPE catalog [
  <!ELEMENT catalog (entry*)>
  <!ELEMENT entry (key, value, metadata?)>
  <!ELEMENT key (#PCDATA)>
  <!ELEMENT value (#PCDATA|em|br)*>
  <!ELEMENT em (#PCDATA)>
  <!ELEMENT br EMPTY>
  <!ELEMENT metadata (created, modified?)>
  <!ELEMENT created (#PCDATA)>
  <!ELEMENT modified (#PCDATA)>
  <!ATTLIST entry
    code ID #REQUIRED
    refs IDREFS #IMPLIED
    logo ENTITY #IMPLIED
    format (text|binary|mixed) "text">
  <!ATTLIST metadata source CDATA #IMPLIED>
  <!ENTITY euro "&#x20AC;">
  <!NOTATION gif SYSTEM "image/gif">
  <!ENTITY sample-logo SYSTEM "logo.gif" NDATA gif>
]>
<catalog>
  <entry code="a17" format="text">
    <key>currency</key>
    <value>Price: &euro;<em>42</em><br/>per unit</value>
    <metadata source="import">
      <created>2026-01-08</created>
      <modified>2026-09-24</modified>
    </metadata>
  </entry>
  <entry code="b04" refs="a17" logo="sample-logo" format="binary">
    <key>archive</key>
    <value>Detached payload</value>
  </entry>
</catalog>