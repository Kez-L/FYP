<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE museum [
  <!ELEMENT museum (exhibit+)>
  <!ELEMENT exhibit (title, curator, artifact+)>
  <!ATTLIST exhibit room CDATA #REQUIRED>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT curator (#PCDATA)>
  <!ELEMENT artifact (name, origin, dimensions, note?)>
  <!ATTLIST artifact accession ID #REQUIRED>
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT origin (#PCDATA)>
  <!ELEMENT dimensions (height, width, depth)>
  <!ELEMENT height (#PCDATA)>
  <!ELEMENT width (#PCDATA)>
  <!ELEMENT depth (#PCDATA)>
  <!ELEMENT note (#PCDATA)>
]>
<museum>
  <exhibit room="A-12">
    <title>Instruments of Navigation</title>
    <curator>Leila Morgan</curator>
    <artifact accession="art-7001">
      <name>Brass astrolabe</name>
      <origin>Lisbon</origin>
      <dimensions>
        <height unit="cm">18.2</height>
        <width unit="cm">17.9</width>
        <depth unit="cm">3.1</depth>
      </dimensions>
      <note>Engraved with a partial star chart.</note>
    </artifact>
    <artifact accession="art-7002">
      <name>Sounding line reel</name>
      <origin>Alexandria</origin>
      <dimensions>
        <height unit="cm">26</height>
        <width unit="cm">21</width>
        <depth unit="cm">8</depth>
      </dimensions>
    </artifact>
  </exhibit>
  <exhibit room="B-04">
    <title>Early Computing</title>
    <curator>Jonas Wei</curator>
    <artifact accession="art-7010">
      <name>Relay calculator</name>
      <origin>Manchester</origin>
      <dimensions>
        <height unit="cm">42</height>
        <width unit="cm">36</width>
        <depth unit="cm">19</depth>
      </dimensions>
    </artifact>
  </exhibit>
</museum>