<?xml version="1.0"?>
<!DOCTYPE report [
  <!ELEMENT report (metadata, body)>
  <!ELEMENT metadata (field*)>
  <!ELEMENT field EMPTY>
  <!ATTLIST field
            name CDATA #REQUIRED
            value CDATA #IMPLIED>
  <!ELEMENT body (paragraph|table|break)*>
  <!ELEMENT paragraph (#PCDATA|code|br)*>
  <!ELEMENT code (#PCDATA)>
  <!ELEMENT br EMPTY>
  <!ELEMENT table (row+)>
  <!ELEMENT row (cell+)>
  <!ELEMENT cell (#PCDATA)>
  <!ENTITY quote "&#x22;">
]>
<report xml:lang="fr" xml:base="urn:example:reports/">
  <metadata>
    <field name="owner" value="A/B"/>
    <field name="empty"/>
  </metadata>
  <body>
    <paragraph>Avant<code>&lt;tag attr=&quot;x&quot;&gt;</code><br/>Après</paragraph>
    <table>
      <row><cell>r1c1</cell><cell>r1c2 &quote;</cell></row>
      <row><cell><![CDATA[r2c1]]></cell><cell>r2c2</cell></row>
    </table>
    <?audit status="pending"?>
    <break/>
  </body>
</report>