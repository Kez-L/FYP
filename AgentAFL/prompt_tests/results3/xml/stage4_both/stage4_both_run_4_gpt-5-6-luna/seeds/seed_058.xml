<?xml version="1.0" encoding="UTF-8"?>
<envelope xmlns="http://schemas.xmlsoap.org/soap/envelope/"
          xmlns:m="urn:example:messages"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <Header>
    <m:trace correlationId="a7f3">
      <m:hop>gateway</m:hop>
      <m:hop>queue</m:hop>
    </m:trace>
    <m:credentials xsi:type="m:Token">
      <m:subject>anonymous</m:subject>
      <m:expires xsi:nil="true"/>
    </m:credentials>
  </Header>
  <Body>
    <m:submitRequest priority="high">
      <m:options>
        <m:option name="dry-run">false</m:option>
        <m:option name="retries">2</m:option>
      </m:options>
      <m:document>
        <m:section index="1">
          <m:title>Input &amp; validation</m:title>
          <m:paragraph>Use &lt;tokens&gt; and preserve whitespace.</m:paragraph>
        </m:section>
        <m:section index="2">
          <m:title>Result</m:title>
          <m:paragraph xml:space="preserve">  pending  </m:paragraph>
        </m:section>
      </m:document>
    </m:submitRequest>
  </Body>
</envelope>