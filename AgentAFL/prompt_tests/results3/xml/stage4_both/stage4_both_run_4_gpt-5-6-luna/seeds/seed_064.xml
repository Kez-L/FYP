<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <defaults>
    <retry count="3" backoff="250ms"/>
    <limits>
      <limit name="connections" value="64"/>
      <limit name="payload-bytes" value="1048576"/>
    </limits>
  </defaults>
  <profiles>
    <profile id="local" inherits="base">
      <endpoint scheme="unix" path="/var/run/example.sock"/>
      <feature name="tracing">enabled</feature>
      <feature name="compression">disabled</feature>
    </profile>
    <profile id="remote" inherits="base">
      <endpoint scheme="https" host="api.example.test" port="443">
        <header name="Accept">application/xml</header>
        <header name="X-Mode">strict</header>
      </endpoint>
      <credentials>
        <token><![CDATA[abc&def<ghi>]]></token>
      </credentials>
    </profile>
  </profiles>
  <routing>
    <route match="/v2/items/*" profile="remote" method="GET"/>
    <route match="/health" profile="local" method="HEAD"/>
  </routing>
</configuration>