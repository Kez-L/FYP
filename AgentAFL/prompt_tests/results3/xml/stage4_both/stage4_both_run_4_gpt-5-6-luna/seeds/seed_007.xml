<?xml version="1.0"?>
<!DOCTYPE map [
  <!ELEMENT map (metadata, layers)>
  <!ELEMENT metadata (property*)>
  <!ELEMENT property EMPTY>
  <!ATTLIST property name CDATA #REQUIRED value CDATA #REQUIRED>
  <!ELEMENT layers (layer+)>
  <!ELEMENT layer (bounds, feature*)>
  <!ELEMENT bounds EMPTY>
  <!ELEMENT feature (point|line|polygon)>
  <!ELEMENT point EMPTY>
  <!ELEMENT line (point+)>
  <!ELEMENT polygon (ring+)>
  <!ELEMENT ring (point+)>
  <!ATTLIST layer name CDATA #REQUIRED visible (true|false) "true">
  <!ATTLIST feature id ID #REQUIRED type (landmark|route|area) #REQUIRED>
  <!ATTLIST point x CDATA #REQUIRED y CDATA #REQUIRED>
  <!ATTLIST bounds minx CDATA #REQUIRED miny CDATA #REQUIRED maxx CDATA #REQUIRED maxy CDATA #REQUIRED>
]>
<map xmlns="urn:cartography:map" xmlns:g="urn:cartography:geometry">
  <metadata>
    <property name="projection" value="local-grid"/>
    <property name="units" value="m"/>
  </metadata>
  <layers>
    <layer name="places" visible="false">
      <bounds minx="-10.5" miny="2" maxx="90" maxy="101.25"/>
      <feature id="f-1" type="landmark">
        <point x="12.0" y="44.5"/>
      </feature>
    </layer>
    <layer name="routes">
      <bounds minx="0" miny="0" maxx="8" maxy="8"/>
      <feature id="f-2" type="route">
        <line>
          <point x="1" y="1"/>
          <point x="4" y="7"/>
          <point x="8" y="3"/>
        </line>
      </feature>
    </layer>
  </layers>
</map>