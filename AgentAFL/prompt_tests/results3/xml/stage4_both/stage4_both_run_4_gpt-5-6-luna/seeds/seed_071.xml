<?xml version="1.0"?>
<!DOCTYPE catalog [
  <!ELEMENT catalog (metadata, item*)>
  <!ELEMENT metadata (title, created, keywords?)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT created (#PCDATA)>
  <!ELEMENT keywords (keyword+)>
  <!ELEMENT keyword (#PCDATA)>
  <!ELEMENT item (name, price, availability, description?)>
  <!ATTLIST item sku ID #REQUIRED category (book|tool|other) "other">
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT price (#PCDATA)>
  <!ELEMENT availability EMPTY>
  <!ATTLIST availability status (in-stock|backorder|retired) #REQUIRED quantity CDATA "0">
  <!ELEMENT description (#PCDATA|emphasis|code)*>
  <!ELEMENT emphasis (#PCDATA)>
  <!ELEMENT code (#PCDATA)>
]>
<catalog>
  <metadata>
    <title>Workshop inventory</title>
    <created>2026-09-24</created>
    <keywords>
      <keyword>hardware</keyword>
      <keyword>reference</keyword>
    </keywords>
  </metadata>
  <item sku="sku-001" category="book">
    <name>Parsing Systems</name>
    <price currency="USD">39.95</price>
    <availability status="in-stock" quantity="12"/>
    <description>A guide to <emphasis>robust</emphasis> input handling and <code>validation</code>.</description>
  </item>
  <item sku="sku-002" category="tool">
    <name>Hexagonal wrench</name>
    <price currency="EUR">7.50</price>
    <availability status="backorder" quantity="0"/>
  </item>
</catalog>