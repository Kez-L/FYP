<?xml version="1.0"?>
<!DOCTYPE workspace [
  <!ELEMENT workspace (folder+, link*)>
  <!ELEMENT folder (name, folder*, document*)>
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT document (title, content, tag*)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT content (#PCDATA|section|break)*>
  <!ELEMENT section (#PCDATA|section|break)*>
  <!ELEMENT break EMPTY>
  <!ELEMENT tag (#PCDATA)>
  <!ELEMENT link EMPTY>
  <!ATTLIST folder id ID #REQUIRED>
  <!ATTLIST document id ID #REQUIRED status (draft|published|deleted) "draft">
  <!ATTLIST link from IDREF #REQUIRED to IDREF #REQUIRED>
  <!ENTITY nbsp "&#160;">
]>
<workspace>
  <folder id="root">
    <name>Archive &amp; Research</name>
    <folder id="papers">
      <name>Études</name>
      <document id="d1" status="published">
        <title>Parser notes</title>
        <content>First&nbsp;paragraph<section>Nested <break/>section</section>last.</content>
        <tag>xml</tag>
        <tag>fuzzing</tag>
      </document>
    </folder>
  </folder>
  <link from="d1" to="root"/>
</workspace>