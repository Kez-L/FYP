<?xml version="1.0"?>
<!DOCTYPE equation [
  <!ELEMENT equation (title?, expression, annotation*)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT expression (mi|mo|mn|mrow|mfrac|msup|mfenced)+>
  <!ELEMENT annotation (#PCDATA)>
  <!ELEMENT mi (#PCDATA|mtext)*>
  <!ELEMENT mo (#PCDATA)>
  <!ELEMENT mn (#PCDATA)>
  <!ELEMENT mrow (mi|mo|mn|mfrac|msup|mtext)+>
  <!ELEMENT mfrac (mrow, mrow)>
  <!ELEMENT msup (mi|mrow, mn|mi)>
  <!ELEMENT mfenced (mrow)>
  <!ELEMENT mtext (#PCDATA)>
  <!ATTLIST equation id ID #IMPLIED>
  <!ENTITY alpha "&#945;">
  <!ENTITY beta "&#946;">
]>
<math xmlns="http://www.w3.org/1998/Math/MathML" display="block">
  <semantics>
    <mrow>
      <mi>f</mi>
      <mo>(</mo>
      <mi>x</mi>
      <mo>)</mo>
      <mo>=</mo>
      <mfrac>
        <mrow>
          <mi>&alpha;</mi>
          <mo>+</mo>
          <msup><mi>x</mi><mn>2</mn></msup>
        </mrow>
        <mrow>
          <mn>1</mn>
          <mo>+</mo>
          <mi>&beta;</mi>
        </mrow>
      </mfrac>
    </mrow>
    <annotation encoding="application/x-tex"><![CDATA[\frac{\alpha+x^2}{1+\beta}]]></annotation>
  </semantics>
</math>