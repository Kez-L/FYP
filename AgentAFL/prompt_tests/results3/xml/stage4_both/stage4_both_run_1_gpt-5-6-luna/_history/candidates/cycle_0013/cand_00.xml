<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE inventory [
  <!ELEMENT inventory (warehouse+, summary)>
  <!ELEMENT warehouse (label, bin+)>
  <!ATTLIST warehouse id ID #REQUIRED region NMTOKEN #REQUIRED>
  <!ELEMENT label (#PCDATA)>
  <!ELEMENT bin (item*)>
  <!ATTLIST bin code NMTOKEN #REQUIRED>
  <!ELEMENT item EMPTY>
  <!ATTLIST item sku ID #REQUIRED quantity CDATA #REQUIRED state (available|reserved|damaged) "available">
  <!ELEMENT summary (#PCDATA)>
]>
<inventory>
  <warehouse id="wh-north" region="eu-west">
    <label>North distribution center</label>
    <bin code="A-01">
      <item sku="sku-100" quantity="24"/>
      <item sku="sku-101" quantity="0" state="reserved"/>
    </bin>
    <bin code="B-07"/>
  </warehouse>
  <warehouse id="wh-south" region="us-east">
    <label>South distribution center</label>
    <bin code="C-03">
      <item sku="sku-220" quantity="7" state="damaged"/>
    </bin>
  </warehouse>
  <summary>Inventory snapshot: 3 bins inspected.</summary>
</inventory>