<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE archive [
  <!ELEMENT archive (record+)>
  <!ATTLIST archive created CDATA #IMPLIED>
  <!ELEMENT record (key, payload, checksum?)>
  <!ATTLIST record id ID #REQUIRED state (new|sealed|void) "new">
  <!ELEMENT key (#PCDATA)>
  <!ELEMENT payload (#PCDATA)>
  <!ELEMENT checksum (#PCDATA)>
  <!ENTITY left "&#x3C;">
  <!ENTITY right "&#x3E;">
  <!ENTITY sample "&left;synthetic&right;">
]>
<archive created="2026-09-23">
  <record id="r001" state="sealed">
    <key>alpha</key>
    <payload><![CDATA[raw text with <tags>, ]]> and ]]> markers]]></payload>
    <checksum>9f2a</checksum>
  </record>
  <record id="r002">
    <key>beta</key>
    <payload>Entity expansion: &sample;</payload>
  </record>
</archive>