<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE note [
  <!ENTITY % common "xml:space (default|preserve) 'default'">
  <!ELEMENT note (subject, recipients, body, attachments?)>
  <!ATTLIST note %common; priority (low|normal|urgent) "normal">
  <!ELEMENT subject (#PCDATA)>
  <!ELEMENT recipients (to+, cc*)>
  <!ELEMENT to (#PCDATA)>
  <!ATTLIST to address CDATA #REQUIRED>
  <!ELEMENT cc (#PCDATA)>
  <!ATTLIST cc address CDATA #REQUIRED>
  <!ELEMENT body (#PCDATA|strong|link|br)*>
  <!ELEMENT strong (#PCDATA)>
  <!ELEMENT link (#PCDATA)>
  <!ATTLIST link href CDATA #REQUIRED>
  <!ELEMENT br EMPTY>
  <!ELEMENT attachments (attachment+)>
  <!ELEMENT attachment EMPTY>
  <!ATTLIST attachment filename CDATA #REQUIRED media-type CDATA #REQUIRED>
]>
<note priority="urgent" xml:space="preserve">
  <subject>Deployment window &amp; rollback plan</subject>
  <recipients>
    <to address="ops@example.invalid">Operations</to>
    <to address="qa@example.invalid">Quality Assurance</to>
    <cc address="audit@example.invalid">Audit</cc>
  </recipients>
  <body>
    Please verify the <strong>staging</strong> environment.<br/>
    See the <link href="https://example.invalid/runbook">runbook</link>
    before proceeding.
  </body>
  <attachments>
    <attachment filename="runbook.pdf" media-type="application/pdf"/>
    <attachment filename="checksums.txt" media-type="text/plain"/>
  </attachments>
</note>