<?xml version="1.0"?>
<!DOCTYPE document [
  <!NOTATION bin SYSTEM "application/octet-stream">
  <!ENTITY picture SYSTEM "images/pixel.bin" NDATA bin>
  <!ELEMENT document (meta, body, attachment*)>
  <!ELEMENT meta (created, flags?)>
  <!ELEMENT created (#PCDATA)>
  <!ELEMENT flags EMPTY>
  <!ATTLIST flags readonly (true|false) "false">
  <!ELEMENT body (p|list|quote)+>
  <!ELEMENT p (#PCDATA|b|i|br)*>
  <!ELEMENT b (#PCDATA)>
  <!ELEMENT i (#PCDATA)>
  <!ELEMENT br EMPTY>
  <!ELEMENT list (li+)>
  <!ELEMENT li (#PCDATA|p)*>
  <!ELEMENT quote (#PCDATA|p)*>
  <!ELEMENT attachment EMPTY>
  <!ATTLIST attachment src ENTITY #REQUIRED media CDATA #IMPLIED>
]>
<document>
  <meta>
    <created>2026-09-23T00:00:00Z</created>
    <flags readonly="true"/>
  </meta>
  <body>
    <p>one <b>two</b><br/> three <i>four</i></p>
    <list><li>first</li><li><p>second</p></li></list>
    <quote><![CDATA[quoted ]]></quote>
  </body>
  <attachment src="picture" media="image/png"/>
</document>