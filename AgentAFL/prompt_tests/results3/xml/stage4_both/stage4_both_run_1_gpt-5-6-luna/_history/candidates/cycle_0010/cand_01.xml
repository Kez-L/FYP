<?xml version="1.0"?>
<envelope xmlns="urn:example:envelope"
          xmlns:sec="urn:example:security"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:type="SignedEnvelope">
  <header>
    <transaction id="tx-2048" priority="high"/>
    <sec:credentials>
      <sec:principal>service-reader</sec:principal>
      <sec:roles>
        <sec:role>observer</sec:role>
        <sec:role>auditor</sec:role>
      </sec:roles>
    </sec:credentials>
  </header>
  <body>
    <request method="query">
      <path>/objects/alpha</path>
      <parameters>
        <parameter name="limit">25</parameter>
        <parameter name="cursor"/>
      </parameters>
    </request>
    <response status="202">
      <message xml:lang="en">Accepted</message>
    </response>
  </body>
</envelope>