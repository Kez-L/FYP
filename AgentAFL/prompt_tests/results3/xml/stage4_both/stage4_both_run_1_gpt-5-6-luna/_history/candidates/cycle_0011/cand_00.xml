<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE library [
  <!ELEMENT library (section+)>
  <!ELEMENT section (heading, book*)>
  <!ATTLIST section code NMTOKEN #REQUIRED>
  <!ELEMENT heading (#PCDATA)>
  <!ELEMENT book (title, author+, summary?, metadata?)>
  <!ATTLIST book isbn CDATA #IMPLIED format (paper|ebook|audio) "paper">
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT author (#PCDATA)>
  <!ELEMENT summary (#PCDATA)>
  <!ELEMENT metadata EMPTY>
  <!ATTLIST metadata pages CDATA #IMPLIED language CDATA "en">
  <!ENTITY publisher "Northwind Press">
]>
<library>
  <section code="fiction">
    <heading>Collected Stories</heading>
    <book isbn="978-0-00-000001-1" format="ebook">
      <title>The Glass Orchard</title>
      <author>R. Vale</author>
      <author>M. Chen</author>
      <summary xml:space="preserve">A tale of &publisher; and distant weather.</summary>
      <metadata pages="312" language="en"/>
    </book>
  </section>
  <section code="reference">
    <heading>Field Notes</heading>
    <book format="audio">
      <title>Listening to Stone</title>
      <author>Élodie Martín</author>
    </book>
  </section>
</library>