<?xml version="1.0"?>
<!DOCTYPE tree [
  <!ENTITY leaf "<leaf value='generated'/>">
  <!ENTITY pair "<branch><left/><right/></branch>">
  <!ELEMENT tree (branch|leaf|marker)+>
  <!ELEMENT branch (branch|leaf|marker|left|right)+>
  <!ELEMENT left EMPTY>
  <!ELEMENT right EMPTY>
  <!ELEMENT leaf EMPTY>
  <!ELEMENT marker (#PCDATA)>
  <!ATTLIST leaf value CDATA #IMPLIED>
]>
<tree>
  <branch id="root">
    <branch id="north">
      &leaf;
      <marker>north &lt; west</marker>
      &pair;
    </branch>
    <branch id="south">
      <left/>
      <right/>
      <leaf value="literal"/>
    </branch>
  </branch>
  <marker><![CDATA[boundary ]]> <![CDATA[ marker]]></marker>
</tree>