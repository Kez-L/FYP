<?xml version="1.0"?>
<!DOCTYPE scene [
  <!ELEMENT scene (layer+)>
  <!ATTLIST scene width NMTOKEN #REQUIRED height NMTOKEN #REQUIRED>
  <!ELEMENT layer (group|shape|text|use)*>
  <!ATTLIST layer id ID #REQUIRED z NMTOKEN "0">
  <!ELEMENT group (group|shape|text|use)*>
  <!ATTLIST group transform CDATA #IMPLIED opacity CDATA "1">
  <!ELEMENT shape EMPTY>
  <!ATTLIST shape type (rect|circle|path|line) #REQUIRED x CDATA #IMPLIED y CDATA #IMPLIED
            width CDATA #IMPLIED height CDATA #IMPLIED d CDATA #IMPLIED fill CDATA #IMPLIED>
  <!ELEMENT text (#PCDATA)>
  <!ATTLIST text x CDATA #REQUIRED y CDATA #REQUIRED anchor (start|middle|end) "start">
  <!ELEMENT use EMPTY>
  <!ATTLIST use ref IDREF #REQUIRED dx CDATA "0" dy CDATA "0">
]>
<scene width="640" height="480">
  <layer id="background" z="-1">
    <shape type="rect" x="0" y="0" width="640" height="480" fill="#101820"/>
  </layer>
  <layer id="foreground" z="1">
    <group transform="translate(24,36)" opacity="0.875">
      <shape type="circle" x="80" y="80" fill="url(#accent)"/>
      <shape type="path" d="M0 120 C40 20 180 20 240 120 Z" fill="#ffcc00"/>
      <text x="12" y="188" anchor="start">A &lt;small&gt;scene&lt;/small&gt;</text>
      <use ref="background" dx="400" dy="120"/>
    </group>
    <shape type="line" x="0" y="0" width="640" height="480" fill="none"/>
  </layer>
</scene>