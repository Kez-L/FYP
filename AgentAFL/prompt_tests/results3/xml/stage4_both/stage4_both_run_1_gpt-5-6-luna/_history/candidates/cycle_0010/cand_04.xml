<?xml version="1.0"?>
<!DOCTYPE inventory [
  <!ELEMENT inventory (warehouse+)>
  <!ELEMENT warehouse (aisle+)>
  <!ATTLIST warehouse code ID #REQUIRED>
  <!ELEMENT aisle (bin+)>
  <!ATTLIST aisle number CDATA #REQUIRED>
  <!ELEMENT bin (item*)>
  <!ATTLIST bin label CDATA #REQUIRED capacity CDATA #IMPLIED>
  <!ELEMENT item EMPTY>
  <!ATTLIST item sku ID #REQUIRED quantity NMTOKEN #REQUIRED fragile (yes|no) "no">
]>
<inventory>
  <warehouse code="north">
    <aisle number="A-01">
      <bin label="top" capacity="12">
        <item sku="sku-100" quantity="3" fragile="yes"/>
        <item sku="sku-101" quantity="0"/>
      </bin>
      <bin label="bottom">
        <item sku="sku-102" quantity="27"/>
      </bin>
    </aisle>
  </warehouse>
  <warehouse code="south">
    <aisle number="B-09">
      <bin label="overflow"/>
    </aisle>
  </warehouse>
</inventory>