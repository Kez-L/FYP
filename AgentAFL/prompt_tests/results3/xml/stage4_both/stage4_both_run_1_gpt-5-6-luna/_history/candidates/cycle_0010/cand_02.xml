<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE configuration [
  <!ELEMENT configuration (section*)>
  <!ELEMENT section (property*)>
  <!ATTLIST section name CDATA #REQUIRED enabled (true|false) "true">
  <!ELEMENT property (value|list)>
  <!ATTLIST property key CDATA #REQUIRED type (string|integer|boolean|path) "string">
  <!ELEMENT value (#PCDATA)>
  <!ELEMENT list (item*)>
  <!ELEMENT item (#PCDATA)>
  <!ENTITY local "localhost">
  <!ENTITY port "8080">
]>
<configuration>
  <section name="network">
    <property key="host" type="string"><value>&local;</value></property>
    <property key="port" type="integer"><value>&port;</value></property>
    <property key="trusted" type="boolean"><value>true</value></property>
  </section>
  <section name="paths" enabled="false">
    <property key="roots" type="path">
      <list>
        <item>/var/lib/app</item>
        <item>/tmp/cache</item>
        <item>.</item>
      </list>
    </property>
  </section>
</configuration>