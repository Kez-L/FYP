<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE catalog [
  <!ELEMENT catalog (intro, product*)>
  <!ELEMENT intro (#PCDATA)>
  <!ELEMENT product (name, description, price, tags)>
  <!ATTLIST product code ID #REQUIRED currency (EUR|USD|JPY) "EUR">
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT description (#PCDATA|em|strong|br)*>
  <!ELEMENT em (#PCDATA)>
  <!ELEMENT strong (#PCDATA)>
  <!ELEMENT br EMPTY>
  <!ELEMENT price (#PCDATA)>
  <!ELEMENT tags (tag*)>
  <!ELEMENT tag (#PCDATA)>
  <!ENTITY brand "Northwind &amp; Sons">
  <!ENTITY trademark "™">
]>
<catalog>
  <intro>Featured products from &brand; &trademark;.</intro>
  <product code="p-001" currency="USD">
    <name>Field notebook</name>
    <description>Water-resistant <strong>recycled</strong> paper.<br/>Fits in an <em>ordinary</em> pocket.</description>
    <price>14.95</price>
    <tags><tag>stationery</tag><tag>outdoor</tag></tags>
  </product>
  <product code="p-002">
    <name>Desk lamp</name>
    <description>Adjustable arm with a warm light.</description>
    <price>39.00</price>
    <tags><tag>office</tag></tags>
  </product>
</catalog>