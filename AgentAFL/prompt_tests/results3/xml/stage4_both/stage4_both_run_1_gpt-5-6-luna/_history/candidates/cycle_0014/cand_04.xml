    <file name="readme.txt" size="42">
      <checksum algorithm="sha256">8f434346648f6b96df89dda901c517a7</checksum>
      <content>Archive manifest follows.</content>
    </file>
    <folder name="drafts">
      <file name="outline.xml" executable="no">
        <content><![CDATA[<outline><item>First</item></outline>]]></content>
      </file>
      <shortcut name="latest" target="../readme.txt"/>
    </folder>
  </folder>
  <folder name="bin">
    <file name="pack" size="8192" executable="yes">
      <checksum>00000000000000000000000000000000</checksum>
    </file>
  </folder>
  <file name="empty.dat" size="0"/>
</archive>