<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE archive [
  <!ELEMENT archive (folder|file|shortcut)*>
  <!ELEMENT folder (folder|file|shortcut)*>
  <!ATTLIST folder name CDATA #REQUIRED>
  <!ELEMENT file (checksum|content?)>
  <!ATTLIST file name CDATA #REQUIRED size NMTOKEN #IMPLIED executable (yes|no) "no">
  <!ELEMENT checksum (#PCDATA)>
  <!ATTLIST checksum algorithm (sha256|md5) "sha256">
  <!ELEMENT content (#PCDATA)>
  <!ELEMENT shortcut EMPTY>
  <!ATTLIST shortcut name CDATA #REQUIRED target CDATA #REQUIRED>
]>
<archive>
