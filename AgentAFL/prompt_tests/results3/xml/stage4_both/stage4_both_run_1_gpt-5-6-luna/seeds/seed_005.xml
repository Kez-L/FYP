<?xml version="1.0"?>
<!DOCTYPE warehouse [
  <!ELEMENT warehouse (aisle+)>
  <!ATTLIST warehouse region NMTOKEN #REQUIRED>
  <!ELEMENT aisle (label, bin+)>
  <!ATTLIST aisle number NMTOKEN #REQUIRED>
  <!ELEMENT label (#PCDATA)>
  <!ELEMENT bin (description, quantity, location?)>
  <!ATTLIST bin uid ID #REQUIRED links IDREFS #IMPLIED emblem ENTITY #IMPLIED>
  <!ELEMENT description (#PCDATA|code)*>
  <!ELEMENT code (#PCDATA)>
  <!ELEMENT quantity (#PCDATA)>
  <!ELEMENT location (#PCDATA)>
  <!ENTITY nbsp "&#160;">
  <!NOTATION jpeg SYSTEM "image/jpeg">
  <!ENTITY logo SYSTEM "warehouse-logo.jpg" NDATA jpeg>
]>
<warehouse region="north">
  <aisle number="A-7">
    <label>Hardware&nbsp;&amp;&nbsp;Tools</label>
    <bin uid="b17" emblem="logo">
      <description>Metric <code>M8</code> fasteners&nbsp;and washers.</description>
      <quantity>240</quantity>
      <location>Rack 3, shelf 2</location>
    </bin>
    <bin uid="b18" links="b17">
      <description>Replacement <code>HEX</code> keys</description>
      <quantity>36</quantity>
    </bin>
  </aisle>
</warehouse>