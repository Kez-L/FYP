<?xml version="1.0"?>
<!DOCTYPE library [
  <!ELEMENT library (shelf*)>
  <!ATTLIST library lang NMTOKEN #IMPLIED>
  <!ELEMENT shelf (label, book*)>
  <!ATTLIST shelf name CDATA #REQUIRED>
  <!ELEMENT label (#PCDATA)>
  <!ELEMENT book (title, author+, summary?, link*)>
  <!ATTLIST book isbn CDATA #IMPLIED format (paper|digital|audio) "paper">
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT author (#PCDATA)>
  <!ELEMENT summary (#PCDATA|em|code)*>
  <!ELEMENT em (#PCDATA)>
  <!ELEMENT code (#PCDATA)>
  <!ELEMENT link EMPTY>
  <!ATTLIST link href CDATA #REQUIRED rel CDATA "related">
  <!ENTITY nbsp "&#160;">
  <!ENTITY mark "A &amp; B">
]>
<library lang="en">
  <shelf name="fiction">
    <label>Fiction &amp; &quot;stories&quot;</label>
    <book isbn="978-0-00-000001-1" format="digital">
      <title>The &lt;Hidden&gt; Door</title>
      <author>R. Example</author>
      <author>J. Sample</author>
      <summary>Contains <em>nested</em> terms, &nbsp;spacing, and <code>&mark;</code>.</summary>
      <link href="urn:isbn:9780000000011" rel="identifier"/>
    </book>
  </shelf>
  <shelf name="reference">
    <label>Reference</label>
    <book format="audio">
      <title>Signals</title>
      <author>Q. Reader</author>
    </book>
  </shelf>
</library>