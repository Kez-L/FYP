<?xml version="1.0" standalone="yes"?>
<!DOCTYPE catalog [
  <!ENTITY company "Northwind &amp; Sons">
  <!ENTITY note "Use &#x2192; for the next aisle.">
  <!ELEMENT catalog (section+)>
  <!ELEMENT section (name, item*)>
  <!ATTLIST section code ID #REQUIRED parent IDREF #IMPLIED>
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT item (label, price, details?)>
  <!ATTLIST item sku ID #REQUIRED tags NMTOKENS #IMPLIED state (active|held|retired) "active">
  <!ELEMENT label (#PCDATA)>
  <!ELEMENT price (#PCDATA)>
  <!ELEMENT details (#PCDATA|b|i|ref)*>
  <!ELEMENT b (#PCDATA)>
  <!ELEMENT i (#PCDATA)>
  <!ELEMENT ref (#PCDATA)>
]>
<catalog>
  <section code="hardware">
    <name>&company; Hardware</name>
    <item sku="bolt-08" tags="steel metric" state="active">
      <label>Hex bolt</label>
      <price>0.18</price>
      <details>Grade <b>8.8</b>; see <ref>&note;</ref>.</details>
    </item>
  </section>
  <section code="clearance" parent="hardware">
    <name>Clearance</name>
    <item sku="washer-02" tags="steel flat" state="held">
      <label>Washer</label>
      <price>0.05</price>
    </item>
  </section>
</catalog>