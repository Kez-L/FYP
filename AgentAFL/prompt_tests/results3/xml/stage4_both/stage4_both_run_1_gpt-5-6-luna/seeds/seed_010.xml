<?xml version="1.1"?>
<!DOCTYPE catalog [
  <!ELEMENT catalog (section+)>
  <!ATTLIST catalog xml:lang NMTOKEN #IMPLIED>
  <!ELEMENT section (title, item*)>
  <!ATTLIST section code NMTOKEN #REQUIRED>
  <!ELEMENT title (#PCDATA|mark|br)*>
  <!ELEMENT mark (#PCDATA)>
  <!ELEMENT br EMPTY>
  <!ELEMENT item (name, price, note?)>
  <!ATTLIST item id ID #REQUIRED status (new|used|reserved) "new">
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT price (#PCDATA)>
  <!ELEMENT note (#PCDATA|mark)*>
  <!ENTITY currency "&#x20AC;">
]>
