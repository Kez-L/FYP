<?xml version="1.1"?>
<!DOCTYPE catalog [
  <!ELEMENT catalog (section+)>
  <!ELEMENT section (title, item*)>
  <!ATTLIST section code ID #REQUIRED xml:lang NMTOKEN "en">
  <!ELEMENT title (#PCDATA|emph)*>
  <!ELEMENT emph (#PCDATA)>
  <!ELEMENT item (name, price?, note?)>
  <!ATTLIST item ref IDREF #IMPLIED status (new|used|archived) "new">
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT price (#PCDATA)>
  <!ELEMENT note (#PCDATA|emph|link)*>
  <!ATTLIST note target IDREF #IMPLIED>
  <!ELEMENT link EMPTY>
  <!ATTLIST link href CDATA #REQUIRED>
]>
<catalog>
  <section code="s-one" xml:lang="fr">
    <title>Résumé <emph>été</emph></title>
    <item ref="s-one">
      <name><![CDATA[alpha < beta && gamma]]></name>
      <price>12.50</price>
      <note target="s-one">Voir <link href="urn:x:y?z=1&amp;q=2"/> maintenant.</note>
    </item>
  </section>
</catalog>