<?xml version="1.0"?>
<!DOCTYPE drawing [
  <!ELEMENT drawing (metadata, canvas)>
  <!ELEMENT metadata (author, created, keywords?)>
  <!ELEMENT author (#PCDATA)>
  <!ELEMENT created (#PCDATA)>
  <!ELEMENT keywords (#PCDATA)>
  <!ELEMENT canvas (layer+)>
  <!ATTLIST canvas width CDATA #REQUIRED height CDATA #REQUIRED units (px|mm|in) "px">
  <!ELEMENT layer (shape*)>
  <!ATTLIST layer name CDATA #REQUIRED visible (yes|no) "yes">
  <!ELEMENT shape EMPTY>
  <!ATTLIST shape
    type (rect|circle|path) #REQUIRED
    x CDATA #IMPLIED
    y CDATA #IMPLIED
    fill CDATA #IMPLIED
    data CDATA #IMPLIED>
  <!NOTATION png SYSTEM "image/png">
  <!ENTITY preview SYSTEM "preview.png" NDATA png>
  <!ENTITY nbsp "&#160;">
]>
<drawing>
  <metadata>
    <author>R&amp;D &amp; Design</author>
    <created>2026-09-23T14:00:00Z</created>
    <keywords>vector, geometry, &nbsp;layout</keywords>
  </metadata>
  <canvas width="1024" height="768" units="px">
    <layer name="background">
      <shape type="rect" x="0" y="0" fill="#ffffff"/>
    </layer>
    <layer name="foreground" visible="yes">
      <shape type="circle" x="512" y="384" fill="url(#gradient)"/>
      <shape type="path" data="M 10 20 L 30 40 C 50 60 70 80 90 100"/>
    </layer>
  </canvas>
</drawing>