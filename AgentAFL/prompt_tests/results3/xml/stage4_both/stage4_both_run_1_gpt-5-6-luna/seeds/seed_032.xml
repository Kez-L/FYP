<?xml version="1.0"?>
<!DOCTYPE ledger [
  <!ELEMENT ledger (opening, transaction*, closing)>
  <!ELEMENT opening (#PCDATA)>
  <!ELEMENT transaction (debit|credit, memo?, allocation*)>
  <!ATTLIST transaction ref ID #REQUIRED account IDREF #REQUIRED>
  <!ELEMENT debit (#PCDATA)>
  <!ELEMENT credit (#PCDATA)>
  <!ELEMENT memo (#PCDATA)>
  <!ELEMENT allocation EMPTY>
  <!ATTLIST allocation cost-center NMTOKEN #REQUIRED percent NMTOKEN "100">
  <!ELEMENT closing (#PCDATA)>
]>
<ledger>
  <opening>2026-01-01T00:00:00Z</opening>
  <transaction ref="t001" account="acct-main">
    <debit>1250.00</debit>
    <memo>Quarterly service &amp; maintenance</memo>
    <allocation cost-center="ops" percent="75"/>
    <allocation cost-center="research" percent="25"/>
  </transaction>
  <transaction ref="t002" account="acct-main">
    <credit>400.50</credit>
    <allocation cost-center="ops"/>
  </transaction>
  <closing>2026-03-31T23:59:59Z</closing>
</ledger>