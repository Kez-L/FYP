<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE gallery [
  <!NOTATION png SYSTEM "image/png">
  <!NOTATION jpeg PUBLIC "-//Example//NOTATION JPEG//EN" "image/jpeg">
  <!ENTITY logo SYSTEM "assets/logo.png" NDATA png>
  <!ELEMENT gallery (caption, image+, credits?)>
  <!ATTLIST gallery xml:lang NMTOKEN #IMPLIED>
  <!ELEMENT caption (#PCDATA|em)*>
  <!ELEMENT em (#PCDATA)>
  <!ELEMENT image EMPTY>
  <!ATTLIST image
    id ID #REQUIRED
    src ENTITY #REQUIRED
    format NOTATION (png|jpeg) #REQUIRED
    alt CDATA #IMPLIED>
  <!ELEMENT credits (#PCDATA)>
]>
<gallery xml:lang="en">
  <caption>Seasonal <em>collection</em></caption>
  <image id="cover" src="logo" format="png" alt="Company mark"/>
  <image id="preview" src="logo" format="jpeg"/>
  <credits>Images supplied by the archive.</credits>
</gallery>