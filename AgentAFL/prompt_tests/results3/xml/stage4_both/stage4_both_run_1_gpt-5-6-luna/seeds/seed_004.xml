<?xml version="1.0"?>
<!DOCTYPE root [
  <!ELEMENT root (branch)>
  <!ELEMENT branch (leaf, branch?)>
  <!ATTLIST branch depth NMTOKEN #IMPLIED>
  <!ELEMENT leaf (#PCDATA)>
  <!ENTITY left "[" >
  <!ENTITY right "]" >
  <!ENTITY text "a &left;b&right; c">
]>
<root>
  <branch depth="0">
    <leaf>&text;</leaf>
    <branch depth="1">
      <leaf><![CDATA[content with ]]> and markup-like text</leaf>
      <branch depth="2">
        <leaf>tail &lt; &gt; &quot; &apos; &#x1F642;</leaf>
      </branch>
    </branch>
  </branch>
</root>