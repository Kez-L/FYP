  <!ELEMENT label (#PCDATA)>
  <!ELEMENT value (#PCDATA|unit)*>
  <!ELEMENT unit EMPTY>
  <!ATTLIST unit symbol CDATA #REQUIRED>
  <!ELEMENT note (#PCDATA)>
  <![IGNORE[
    <!ELEMENT ignored ANY>
  ]]>
]>
