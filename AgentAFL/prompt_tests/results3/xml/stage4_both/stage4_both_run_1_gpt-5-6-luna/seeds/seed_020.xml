<?xml version="1.0" standalone="yes"?>
<!DOCTYPE catalog [
  <!ENTITY % common "category CDATA #IMPLIED xml:lang NMTOKEN #IMPLIED">
  <!ENTITY nbsp "&#160;">
  <!ENTITY left "&#x2039;">
  <!ENTITY right "&#x203A;">
  <!ELEMENT catalog (section+)>
  <!ELEMENT section (name, item*)>
  <!ATTLIST section id ID #REQUIRED>
  <!ELEMENT name (#PCDATA)>
