<?xml version="1.0"?>
<!DOCTYPE log [
  <!ELEMENT log (meta, event*)>
  <!ATTLIST log source CDATA #REQUIRED>
  <!ELEMENT meta (created, owner, tags?)>
  <!ELEMENT created (#PCDATA)>
  <!ELEMENT owner (#PCDATA)>
  <!ELEMENT tags (tag+)>
  <!ELEMENT tag (#PCDATA)>
  <!ELEMENT event (message, detail?, attachment*)>
  <!ATTLIST event id ID #REQUIRED category (audit|warning|failure) "audit" severity NMTOKEN #IMPLIED>
  <!ELEMENT message (#PCDATA|mark)*>
  <!ELEMENT mark (#PCDATA)>
  <!ELEMENT detail (#PCDATA|linebreak)*>
  <!ELEMENT linebreak EMPTY>
  <!ELEMENT attachment EMPTY>
  <!ATTLIST attachment name CDATA #REQUIRED media NOTATION #IMPLIED>
  <!NOTATION text SYSTEM "text/plain">
  <!ENTITY generated "<created>2026-09-23</created>">
  <!ENTITY product "parser &amp; verifier">
]>
<log source="batch-runner">
  <meta>
    &generated;
    <owner>&product;</owner>
    <tags>
      <tag>xml</tag>
      <tag>fuzzing</tag>
      <tag>nightly</tag>
    </tags>
  </meta>
  <event id="e-001" category="audit" severity="info">
    <message>Started <mark>normalization</mark>.</message>
    <detail>Input accepted<linebreak/>No external resources requested.</detail>
    <attachment name="report.txt" media="text"/>
  </event>
  <event id="e-002" category="warning" severity="high">
    <message>Unexpected character sequence: &lt;&lt;end&gt;&gt;</message>
  </event>
</log>