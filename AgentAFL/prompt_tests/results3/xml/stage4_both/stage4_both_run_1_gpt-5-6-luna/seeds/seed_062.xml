<?xml version="1.0" encoding="UTF-8"?>
<workflow xmlns="urn:example:workflow"
          xmlns:ext="urn:example:workflow-extension"
          version="3.4"
          name="nightly-build">
  <variables>
    <variable key="workspace" value="/srv/build"/>
    <variable key="attempts" value="2"/>
  </variables>
  <graph>
    <node id="compile" type="task">
      <command><![CDATA[make all && make test]]></command>
      <on-success ref="package"/>
      <on-failure ref="notify"/>
    </node>
    <node id="package" type="task">
      <input path="dist/"/>
      <artifact name="release.tar" media-type="application/x-tar"/>
      <on-success ref="publish"/>
    </node>
    <node id="publish" type="gate" enabled="false">
      <condition language="expr">branch == "main" and signed == true</condition>
      <ext:approval required="2">
        <ext:group>release-engineering</ext:group>
        <ext:group>security</ext:group>
      </ext:approval>
    </node>
    <node id="notify" type="notification">
      <recipient channel="email">builds@example.invalid</recipient>
      <recipient channel="chat">#build-alerts</recipient>
    </node>
  </graph>
  <metadata>
    <created>2026-09-23</created>
    <owner>platform</owner>
  </metadata>
</workflow>