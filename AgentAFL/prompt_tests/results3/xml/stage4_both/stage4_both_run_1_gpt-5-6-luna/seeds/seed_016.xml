<?xml version="1.1"?>
<scene xmlns="urn:example:scene"
       xmlns:g="urn:example:geometry"
       xmlns:m="urn:example:metadata"
       xml:space="preserve">
  <?render profile="draft" antialias="false"?>
  <layer id="background" visible="true">
    <g:rectangle x="0" y="0" width="800" height="600">
      <g:fill color="#102030" opacity="0.85"/>
    </g:rectangle>
  </layer>
  <layer id="foreground">
    <object m:kind="label" transform="translate(40 72)">
      <text><![CDATA[Use <g:rectangle> literally; do not interpret.]]></text>
      <font family="monospace" size="14"/>
    </object>
    <object xmlns="" data-role="raw">
      <value>unqualified element in a cleared namespace</value>
      <meta xmlns="urn:example:metadata" m:flag="experimental"/>
    </object>
  </layer>
  <!-- preserve this processing instruction and the surrounding whitespace -->
  <?checkpoint id="layer-2"?>
</scene>