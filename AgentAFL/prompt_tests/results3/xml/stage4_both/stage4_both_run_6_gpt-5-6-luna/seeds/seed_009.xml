<?xml version="1.0"?>
<!DOCTYPE matrix [
  <!ELEMENT matrix (row+)>
  <!ELEMENT row (cell+)>
  <!ATTLIST row index NMTOKEN #REQUIRED>
  <!ELEMENT cell (#PCDATA)>
  <!ATTLIST cell
            coordinate CDATA #REQUIRED
            rowspan NMTOKEN "1"
            colspan NMTOKEN "1"
            formula CDATA #IMPLIED>
  <!ENTITY nbsp "&#160;">
  <!ENTITY left "&#x27E6;">
  <!ENTITY right "&#x27E7;">
]>
<matrix>
  <row index="0">
    <cell coordinate="A1" formula="SUM(B1:C1)">12</cell>
    <cell coordinate="B1" colspan="2">&left;wide&right;</cell>
  </row>
  <row index="1">
    <cell coordinate="A2" rowspan="2">label&nbsp;one</cell>
    <cell coordinate="B2" formula="A1*2">24</cell>
    <cell coordinate="C2">0</cell>
  </row>
  <row index="2">
    <cell coordinate="B3" formula="IF(C2&gt;0,&quot;yes&quot;,&quot;no&quot;)">yes</cell>
    <cell coordinate="C3"><![CDATA[unterminated-looking ] text]]></cell>
  </row>
</matrix>