<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE svg [
  <!ENTITY title "Coverage &amp; Diagnostics">
  <!ENTITY nbsp "&#160;">
  <!ELEMENT svg (title,desc,defs?,g+)>
  <!ATTLIST svg
    xmlns CDATA #IMPLIED
    viewBox CDATA #IMPLIED
    version CDATA #IMPLIED
  >
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT desc (#PCDATA)>
  <!ELEMENT defs (linearGradient|filter|clipPath)*>
  <!ELEMENT linearGradient (stop+)>
  <!ATTLIST linearGradient id ID #REQUIRED x1 CDATA #IMPLIED x2 CDATA #IMPLIED>
  <!ELEMENT stop EMPTY>
  <!ATTLIST stop offset CDATA #REQUIRED stop-color CDATA #IMPLIED>
  <!ELEMENT filter (feGaussianBlur|feOffset)*>
  <!ATTLIST filter id ID #REQUIRED>
  <!ELEMENT feGaussianBlur EMPTY>
  <!ATTLIST feGaussianBlur stdDeviation CDATA #IMPLIED>
  <!ELEMENT feOffset EMPTY>
  <!ATTLIST feOffset dx CDATA #IMPLIED dy CDATA #IMPLIED>
  <!ELEMENT clipPath (circle|rect|path)*>
  <!ATTLIST clipPath id ID #REQUIRED>
  <!ELEMENT g (rect|circle|path|text|foreignObject|use)*>
  <!ATTLIST g id ID #IMPLIED transform CDATA #IMPLIED>
  <!ELEMENT rect EMPTY>
  <!ATTLIST rect x CDATA #IMPLIED y CDATA #IMPLIED width CDATA #REQUIRED height CDATA #REQUIRED fill CDATA #IMPLIED>
  <!ELEMENT circle EMPTY>
  <!ATTLIST circle cx CDATA #IMPLIED cy CDATA #IMPLIED r CDATA #REQUIRED>
  <!ELEMENT path EMPTY>
  <!ATTLIST path d CDATA #REQUIRED fill CDATA #IMPLIED clip-path CDATA #IMPLIED>
  <!ELEMENT text (#PCDATA)>
  <!ATTLIST text x CDATA #IMPLIED y CDATA #IMPLIED>
  <!ELEMENT foreignObject (html:div)>
  <!ATTLIST foreignObject x CDATA #IMPLIED y CDATA #IMPLIED width CDATA #IMPLIED height CDATA #IMPLIED>
  <!ELEMENT use EMPTY>
  <!ATTLIST use href CDATA #IMPLIED xlink:href CDATA #IMPLIED>
]>
<svg xmlns="http://www.w3.org/2000/svg"
     xmlns:xlink="http://www.w3.org/1999/xlink"
     xmlns:html="http://www.w3.org/1999/xhtml"
     version="1.1" viewBox="0 0 320 180">
  <title>&title;</title>
  <desc>Vector &amp; raster &nbsp; interoperability</desc>
  <defs>
    <linearGradient id="shade" x1="0%" x2="100%">
      <stop offset="0%" stop-color="#001122"/>
      <stop offset="1" stop-color="#ddeeff"/>
    </linearGradient>
    <filter id="soft"><feGaussianBlur stdDeviation="1.25"/><feOffset dx="2" dy="3"/></filter>
    <clipPath id="window"><rect x="8" y="8" width="304" height="164"/></clipPath>
  </defs>
  <g id="scene" transform="translate(4,5) rotate(0)">
    <rect x="0" y="0" width="300" height="160" fill="url(#shade)" clip-path="url(#window)"/>
    <circle cx="80" cy="70" r="34"/>
    <path d="M10 145 C 70 90, 120 170, 190 110 S 280 80, 310 140" fill="none"/>
    <text x="18" y=" thirty">XML &amp; entities</text>
    <foreignObject x="20" y="100" width="180" height="35">
      <html:div><html:strong>embedded</html:strong>&nbsp;markup</html:div>
    </foreignObject>
    <use xlink:href="#missing-shape" x="9" y="9"/>
  </g>
</svg>