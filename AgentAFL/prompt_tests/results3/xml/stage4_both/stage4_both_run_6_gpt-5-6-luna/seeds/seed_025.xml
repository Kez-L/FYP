<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE scene [
  <!ELEMENT scene (metadata, layer+)>
  <!ELEMENT metadata EMPTY>
  <!ATTLIST metadata width CDATA #REQUIRED height CDATA #REQUIRED units (px|pt|mm) "px">
  <!ELEMENT layer (group|shape|use|text)*>
  <!ATTLIST layer name NMTOKEN #REQUIRED visible (yes|no) "yes">
  <!ELEMENT group (group|shape|use|text)*>
  <!ATTLIST group id ID #IMPLIED transform CDATA #IMPLIED>
  <!ELEMENT shape EMPTY>
  <!ATTLIST shape id ID #IMPLIED type (rect|circle|path) #REQUIRED x CDATA #IMPLIED y CDATA #IMPLIED>
  <!ELEMENT use EMPTY>
  <!ATTLIST use href IDREF #REQUIRED opacity CDATA #IMPLIED>
  <!ELEMENT text (#PCDATA|span)*>
  <!ATTLIST text x CDATA #REQUIRED y CDATA #REQUIRED>
  <!ELEMENT span (#PCDATA)>
]>
<scene xmlns="urn:vector:scene" xmlns:x="urn:vector:extensions">
  <metadata width="640" height="480" units="px"/>
  <layer name="background">
    <shape id="canvas" type="rect" x="0" y="0"/>
  </layer>
  <layer name="foreground" visible="yes">
    <group id="cluster" transform="translate(12,18) rotate(2)">
      <shape id="dot" type="circle" x="44" y="31"/>
      <use href="dot" opacity="0.5"/>
      <text x="8" y="96">Load <span>72%</span> &amp; rising</text>
    </group>
    <x:annotation x:priority="high"><![CDATA[<not-rendered>]]></x:annotation>
  </layer>
</scene>