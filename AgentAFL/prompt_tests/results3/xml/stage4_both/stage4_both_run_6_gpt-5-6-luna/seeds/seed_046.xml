<?xml version="1.0"?>
<!DOCTYPE scene [
  <!NOTATION png SYSTEM "image/png">
  <!ENTITY logo SYSTEM "logo.png" NDATA png>
  <!ENTITY nbsp "&#160;">
  <!ELEMENT scene (canvas, layers)>
  <!ATTLIST scene id ID #REQUIRED xml:base CDATA #IMPLIED>
  <!ELEMENT canvas EMPTY>
  <!ATTLIST canvas width NMTOKEN #REQUIRED height NMTOKEN #REQUIRED color CDATA #IMPLIED>
  <!ELEMENT layers (layer*)>
  <!ELEMENT layer (group|shape|text|use)*>
  <!ATTLIST layer id ID #IMPLIED visible (true|false) "true">
  <!ELEMENT group (shape|text|use|group)*>
  <!ATTLIST group transform CDATA #IMPLIED>
  <!ELEMENT shape EMPTY>
  <!ATTLIST shape kind (rect|circle|path|line) #REQUIRED x CDATA #IMPLIED y CDATA #IMPLIED fill CDATA #IMPLIED>
  <!ELEMENT text (#PCDATA)>
  <!ATTLIST text x CDATA #REQUIRED y CDATA #REQUIRED>
  <!ELEMENT use EMPTY>
  <!ATTLIST use href IDREF #REQUIRED>
]>
<scene id="s42" xml:base="https://assets.example.test/ui/">
  <canvas width="800" height="600" color="#101820"/>
  <layers>
    <layer id="background">
      <shape kind="rect" x="0" y="0" fill="#101820"/>
    </layer>
    <layer id="foreground" visible="true">
      <group transform="translate(24,36) rotate(-2)">
        <shape kind="circle" x="80" y="80" fill="#ffcc00"/>
        <text x="120" y="96">Status:&nbsp;nominal</text>
        <use href="background"/>
      </group>
    </layer>
  </layers>
</scene>