<?xml version="1.0"?>
<!DOCTYPE catalog [
  <!ELEMENT catalog (section+)>
  <!ELEMENT section (label, item*)>
  <!ATTLIST section code ID #REQUIRED>
  <!ELEMENT label (#PCDATA)>
  <!ELEMENT item (name, price, availability, options?)>
  <!ATTLIST item sku NMTOKEN #REQUIRED featured (yes|no) "no">
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT price (#PCDATA)>
  <!ATTLIST price currency CDATA #REQUIRED tax-inclusive (true|false) "false">
  <!ELEMENT availability EMPTY>
  <!ATTLIST availability quantity CDATA #REQUIRED warehouse NMTOKEN #IMPLIED>
  <!ELEMENT options (option+)>
  <!ELEMENT option (#PCDATA)>
  <!ATTLIST option key NMTOKEN #REQUIRED>
]>
<catalog>
  <section code="hardware">
    <label>Field equipment</label>
    <item sku="sensor-x9" featured="yes">
      <name>Thermal probe</name>
      <price currency="EUR" tax-inclusive="true">48.90</price>
      <availability quantity="17" warehouse="berlin"/>
      <options>
        <option key="connector">M12</option>
        <option key="range">-40..125 C</option>
      </options>
    </item>
    <item sku="mount-k2">
      <name>Universal mount</name>
      <price currency="EUR">12.00</price>
      <availability quantity="0"/>
    </item>
  </section>
  <section code="services">
    <label>Installation</label>
    <item sku="install-remote">
      <name>Remote commissioning</name>
      <price currency="USD" tax-inclusive="false">125</price>
      <availability quantity="unlimited" warehouse="global"/>
    </item>
  </section>
</catalog>