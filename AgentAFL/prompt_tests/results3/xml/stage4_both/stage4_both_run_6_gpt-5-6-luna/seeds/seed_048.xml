<?xml version="1.0"?>
<!DOCTYPE package [
  <!ENTITY % declarations "
    <!ELEMENT package (manifest, content, signatures?)>
    <!ATTLIST package id ID #REQUIRED format (bundle|archive) 'bundle'>
    <!ELEMENT manifest (entry+)>
    <!ELEMENT entry EMPTY>
    <!ATTLIST entry path CDATA #REQUIRED media CDATA #REQUIRED size NMTOKEN #IMPLIED>
    <!ELEMENT content (file|directory)+>
    <!ELEMENT file (#PCDATA)>
    <!ATTLIST file path CDATA #REQUIRED encoding (base64|text|hex) 'text'>
    <!ELEMENT directory (file|directory)*>
    <!ATTLIST directory path CDATA #REQUIRED>
    <!ELEMENT signatures (signature+)>
    <!ELEMENT signature (algorithm, digest, certificate?)>
    <!ELEMENT algorithm (#PCDATA)>
    <!ELEMENT digest (#PCDATA)>
    <!ELEMENT certificate (#PCDATA)>
  ">
  %declarations;
]>
