<?xml version="1.0"?>
<!DOCTYPE registry [
  <!ENTITY % commonAttrs "xml:lang NMTOKEN #IMPLIED xml:space (default|preserve) 'preserve'">
  <!ENTITY productName "A &amp; B Registry">
  <!ELEMENT registry (header,namespace*,record*)>
  <!ATTLIST registry %commonAttrs; revision NMTOKEN #REQUIRED>
  <!ELEMENT header (name,created,comment?)>
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT created (#PCDATA)>
  <!ELEMENT comment (#PCDATA|b|i|code)*>
  <!ELEMENT b (#PCDATA)>
  <!ELEMENT i (#PCDATA)>
  <!ELEMENT code (#PCDATA)>
  <!ELEMENT namespace EMPTY>
  <!ATTLIST namespace prefix NMTOKEN #REQUIRED uri CDATA #REQUIRED>
  <!ELEMENT record (key,value,metadata?,history?)>
  <!ATTLIST record id ID #REQUIRED state (new|active|retired) "active">
  <!ELEMENT key (#PCDATA)>
  <!ELEMENT value (#PCDATA|part|ref)*>
  <!ELEMENT part (#PCDATA)>
  <!ATTLIST part role NMTOKEN #IMPLIED>
  <!ELEMENT ref EMPTY>
  <!ATTLIST ref target IDREF #REQUIRED kind (soft|hard) "soft">
  <!ELEMENT metadata (property*)>
  <!ELEMENT property (#PCDATA)>
  <!ATTLIST property name NMTOKEN #REQUIRED type (text|integer|boolean|date) "text">
  <!ELEMENT history (event+)>
  <!ELEMENT event (actor,when,change)>
  <!ATTLIST event seq NMTOKEN #REQUIRED>
  <!ELEMENT actor (#PCDATA)>
  <!ELEMENT when (#PCDATA)>
  <!ELEMENT change (#PCDATA|add|remove)*>
  <!ELEMENT add (#PCDATA)>
  <!ELEMENT remove (#PCDATA)>
]>
