<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE package [
  <!ENTITY copyright "Copyright 2026 Example Press">
  <!ELEMENT package (manifest, payload)>
  <!ELEMENT manifest (name, publisher, license, checksum)>
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT publisher (#PCDATA)>
  <!ELEMENT license (#PCDATA)>
  <!ELEMENT checksum (#PCDATA)>
  <!ATTLIST checksum algorithm (sha1|sha256|sha512) #REQUIRED>
  <!ELEMENT payload (section+)>
  <!ELEMENT section (heading, paragraph+, table?)>
  <!ATTLIST section number NMTOKEN #REQUIRED>
  <!ELEMENT heading (#PCDATA)>
  <!ELEMENT paragraph (#PCDATA|code|link|linebreak)*>
  <!ELEMENT code (#PCDATA)>
  <!ELEMENT link (#PCDATA)>
  <!ATTLIST link href CDATA #REQUIRED>
  <!ELEMENT linebreak EMPTY>
  <!ELEMENT table (row+)>
  <!ELEMENT row (cell+)>
  <!ELEMENT cell (#PCDATA)>
]>
<package>
  <manifest>
    <name>Markup Interoperability Notes</name>
    <publisher>&copyright;</publisher>
    <license>permissive</license>
    <checksum algorithm="sha512">9f3b1d7c00ab44e8</checksum>
  </manifest>
  <payload>
    <section number="1">
      <heading>Escaping rules</heading>
      <paragraph>Use <code>&amp;lt;</code> when serializing a literal less-than sign.<linebreak/>See the <link href="https://example.invalid/spec">reference</link>.</paragraph>
      <paragraph>Names may contain accents: naïve, façade, and Ελληνικά.</paragraph>
    </section>
    <section number="2">
      <heading>Comparison</heading>
      <paragraph>Three representations are shown below.</paragraph>
      <table>
        <row><cell>source</cell><cell>encoded</cell></row>
        <row><cell>A &amp; B</cell><cell>A&amp;nbsp;B</cell></row>
        <row><cell>quote</cell><cell>&quot;value&quot;</cell></row>
      </table>
    </section>
  </payload>
</package>