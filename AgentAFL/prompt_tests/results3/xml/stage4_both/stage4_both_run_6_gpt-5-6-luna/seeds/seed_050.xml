<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="transform.xsl" media="screen"?>
<!DOCTYPE dashboard [
  <!ENTITY product "Aurora">
  <!ENTITY note "status &amp; telemetry">
  <!ELEMENT dashboard (metadata, widgets, audit-log)>
  <!ATTLIST dashboard id ID #REQUIRED generated CDATA #IMPLIED>
  <!ELEMENT metadata (title, owner, tags)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT owner EMPTY>
  <!ATTLIST owner name CDATA #REQUIRED team CDATA #IMPLIED>
  <!ELEMENT tags (tag*)>
  <!ELEMENT tag (#PCDATA)>
  <!ELEMENT widgets (chart|table|metric|panel)*>
  <!ELEMENT chart (series+)>
  <!ATTLIST chart id ID #REQUIRED caption CDATA #IMPLIED>
  <!ELEMENT series (point*)>
  <!ATTLIST series key NMTOKEN #REQUIRED color CDATA #IMPLIED>
  <!ELEMENT point EMPTY>
  <!ATTLIST point x CDATA #REQUIRED y CDATA #REQUIRED>
  <!ELEMENT table (column+, row*)>
  <!ELEMENT column EMPTY>
  <!ATTLIST column name NMTOKEN #REQUIRED type (text|number|date) "text">
  <!ELEMENT row (cell*)>
  <!ELEMENT cell (#PCDATA)>
  <!ELEMENT metric (#PCDATA)>
  <!ATTLIST metric name NMTOKEN #REQUIRED unit CDATA #IMPLIED>
  <!ELEMENT panel (heading?, content)>
  <!ELEMENT heading (#PCDATA)>
  <!ELEMENT content (#PCDATA|link|br)*>
  <!ELEMENT link (#PCDATA)>
  <!ATTLIST link href CDATA #REQUIRED>
  <!ELEMENT br EMPTY>
  <!ELEMENT audit-log (entry*)>
  <!ELEMENT entry (#PCDATA)>
  <!ATTLIST entry at CDATA #REQUIRED actor CDATA #IMPLIED>
]>
<dashboard id="dash-7" generated="2026-10-01T00:00:00Z">
