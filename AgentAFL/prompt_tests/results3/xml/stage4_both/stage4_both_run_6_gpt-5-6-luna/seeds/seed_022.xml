<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE page [
  <!ENTITY % headitems "(meta|link)*">
  <!ENTITY % inline "(text|b|i|code|br)*">
  <!ELEMENT page (head, body)>
  <!ELEMENT head (title, %headitems;)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT meta EMPTY>
  <!ATTLIST meta name NMTOKEN #IMPLIED content CDATA #IMPLIED>
  <!ELEMENT link EMPTY>
  <!ATTLIST link rel NMTOKEN #REQUIRED href CDATA #REQUIRED>
  <!ELEMENT body (article, aside?)>
  <!ELEMENT article (h1, section+)>
  <!ELEMENT h1 (#PCDATA)>
  <!ELEMENT section (h2, p+)>
  <!ELEMENT h2 (#PCDATA)>
  <!ELEMENT p %inline;>
  <!ELEMENT text (#PCDATA)>
  <!ELEMENT b (#PCDATA)>
  <!ELEMENT i (#PCDATA)>
  <!ELEMENT code (#PCDATA)>
  <!ELEMENT br EMPTY>
  <!ELEMENT aside (#PCDATA|note)*>
  <!ELEMENT note (#PCDATA)>
]>
<page xml:lang="en-US">
  <head>
    <title>Parser Notes</title>
    <meta name="viewport" content="width=device-width"/>
    <meta content="document &amp; diagnostics"/>
    <link rel="stylesheet" href="/assets/main.css"/>
  </head>
  <body>
    <article>
      <h1>Reading <code>XML</code> Streams</h1>
      <section>
        <h2>Tokens</h2>
        <p><text>Markup may contain </text><b>bold</b><text>, </text><i>italic</i><br/><text> and code.</text></p>
      </section>
      <section>
        <h2>Boundaries</h2>
        <p><![CDATA[Characters such as < and > remain literal here.]]></p>
      </section>
    </article>
    <aside><note>Keep the input deterministic.</note></aside>
  </body>
</page>