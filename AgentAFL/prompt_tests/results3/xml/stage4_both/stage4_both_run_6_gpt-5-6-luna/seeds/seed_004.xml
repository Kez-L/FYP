<?xml version="1.0"?>
<!DOCTYPE graph [
  <!ELEMENT graph (node+, edge*)>
  <!ELEMENT node (label?, property*)>
  <!ELEMENT label (#PCDATA)>
  <!ELEMENT property (#PCDATA|value)*>
  <!ELEMENT value (#PCDATA)>
  <!ELEMENT edge EMPTY>
  <!ATTLIST node id ID #REQUIRED category CDATA "generic">
  <!ATTLIST property name CDATA #REQUIRED>
  <!ATTLIST edge from IDREF #REQUIRED to IDREF #REQUIRED weight CDATA "1.0">
  <!ENTITY left "[" >
  <!ENTITY right "]" >
  <!ENTITY pair "&left;key&right;" >
]>
<graph>
  <node id="n0" category="root">
    <label>root</label>
    <property name="expression">&pair;<value>alpha</value>&right;</property>
  </node>
  <node id="n1">
    <property name="empty"/>
    <property name="quoted"><![CDATA["<&>"]]></property>
  </node>
  <edge from="n0" to="n1" weight="0.125"/>
</graph>