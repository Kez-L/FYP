<?xml version="1.0"?>
<!DOCTYPE canvas [
  <!ELEMENT canvas (layer+)>
  <!ELEMENT layer (shape|group|text)*>
  <!ATTLIST layer name CDATA #IMPLIED visible (true|false) "true">
  <!ELEMENT group (shape|text|group)*>
  <!ATTLIST group transform CDATA #IMPLIED>
  <!ELEMENT shape EMPTY>
  <!ATTLIST shape type (circle|rect|path) #REQUIRED x CDATA #IMPLIED y CDATA #IMPLIED>
  <!ELEMENT text (#PCDATA)>
  <!ATTLIST text align (left|center|right) "left">
]>
<canvas>
  <layer name="background" visible="false">
    <shape type="rect" x="0" y="0"/>
  </layer>
  <layer name="foreground">
    <group transform="translate(12,8) rotate(3)">
      <shape type="circle" x="40" y="20"/>
      <text align="center">A &amp; B</text>
      <group transform="scale(0.5)">
        <shape type="path" x="M0 0 L10 20"/>
        <text>Nested <![CDATA[vector]]> label</text>
      </group>
    </group>
  </layer>
</canvas>