<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE envelope [
  <!ENTITY company "Northstar">
  <!ENTITY payload "<item code='X-7'>embedded</item>">
  <!ELEMENT envelope (header, body, footer)>
  <!ATTLIST envelope xmlns:soap CDATA #IMPLIED soap:version NMTOKEN #IMPLIED>
  <!ELEMENT header (action, token?, timestamp)>
  <!ELEMENT action (#PCDATA)>
  <!ELEMENT token (#PCDATA)>
  <!ELEMENT timestamp (#PCDATA)>
  <!ELEMENT body (request|response)>
  <!ELEMENT request (query, parameters?)>
  <!ELEMENT response (status, result*)>
  <!ELEMENT query (#PCDATA)>
  <!ELEMENT parameters (parameter*)>
  <!ELEMENT parameter EMPTY>
  <!ATTLIST parameter name NMTOKEN #REQUIRED value CDATA #IMPLIED>
  <!ELEMENT status (#PCDATA)>
  <!ELEMENT result (#PCDATA|item)*>
  <!ELEMENT item (#PCDATA)>
  <!ATTLIST item code NMTOKEN #IMPLIED>
  <!ELEMENT footer (#PCDATA)>
]>
<envelope xmlns:soap="http://schemas.xmlsoap.org/soap/envelope/" soap:version="1.1">
  <header>
    <action>urn:&company;:inventory:lookup</action>
    <token><![CDATA[Bearer abc.def.ghi]]></token>
    <timestamp xml:lang="en">2026-10-01T00:00:00Z</timestamp>
  </header>
  <body>
    <response>
      <status>partial</status>
      <result>alpha &amp; beta</result>
      <result><item code="A1">ready</item><item code="B2">queued</item></result>
    </response>
  </body>
  <footer>Generated by &company; gateway. &lt;end&gt;</footer>
</envelope>