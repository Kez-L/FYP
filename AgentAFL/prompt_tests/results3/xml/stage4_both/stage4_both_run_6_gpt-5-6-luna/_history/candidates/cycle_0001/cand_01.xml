<?xml version="1.0"?>
<!DOCTYPE report [
  <!ELEMENT report (header, section+)>
  <!ELEMENT header (#PCDATA)>
  <!ELEMENT section (heading, entry*)>
  <!ELEMENT heading (#PCDATA)>
  <!ELEMENT entry (#PCDATA|note)*>
  <!ELEMENT note (#PCDATA)>
  <!ATTLIST section code ID #REQUIRED>
  <!ATTLIST entry kind (info|warning|error) "info">
  <!ENTITY company "Example &amp; Sons">
  <!ENTITY mark "&#x2605;">
]>
<report>
  <header>&company; &#x2014; status &mark;</header>
  <section code="s1">
    <heading>Overview</heading>
    <entry kind="warning">First <note>embedded note</note> entry.</entry>
    <entry>Second entry with &company;.</entry>
  </section>
  <section code="s2">
    <heading>Details</heading>
    <entry kind="error">Terminal condition.</entry>
  </section>
</report>