<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE scene [
  <!ENTITY company "Northwind &amp; Sons">
  <!ENTITY unit "px">
  <!ELEMENT scene (metadata, viewport, layer+)>
  <!ATTLIST scene version CDATA #REQUIRED>
  <!ELEMENT metadata (title, creator+, note?)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT creator (#PCDATA)>
  <!ELEMENT note (#PCDATA)>
  <!ELEMENT viewport EMPTY>
  <!ATTLIST viewport width CDATA #REQUIRED height CDATA #REQUIRED>
  <!ELEMENT layer (shape|group|text)+>
  <!ATTLIST layer id ID #REQUIRED hidden (true|false) "false">
  <!ELEMENT group (shape|text|group)+>
  <!ATTLIST group transform CDATA #IMPLIED>
  <!ELEMENT shape EMPTY>
  <!ATTLIST shape kind (rect|circle|path) #REQUIRED x CDATA #IMPLIED y CDATA #IMPLIED data CDATA #IMPLIED>
  <!ELEMENT text (#PCDATA)>
  <!ATTLIST text x CDATA #REQUIRED y CDATA #REQUIRED>
]>
<scene xmlns="urn:art:scene" xmlns:svg="http://www.w3.org/2000/svg" version="3.7">
  <?render profile="draft"?>
  <metadata>
    <title>Warehouse map</title>
    <creator>&company;</creator>
    <creator>Élodie Sørensen</creator>
    <note><![CDATA[Coordinates use the local grid; < and > are literal here.]]></note>
  </metadata>
  <viewport width="1280&unit;" height="720&unit;"/>
  <layer id="background">
    <shape kind="rect" x="0" y="0" data="M0 0 H1280 V720 H0 Z"/>
  </layer>
  <layer id="routes" hidden="false">
    <group transform="translate(18,24) rotate(-2)">
      <shape kind="path" data="M10 44 C80 12 160 85 240 40"/>
      <text x="34" y="62">Dock &amp; receiving</text>
    </group>
    <svg:circle cx="244" cy="66" r="9"/>
  </layer>
</scene>