<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE transform [
  <!ENTITY nsx "urn:example:transform">
  <!ELEMENT transform (params, templates, pipeline)>
  <!ATTLIST transform version NMTOKEN #REQUIRED>
  <!ELEMENT params (param*)>
  <!ELEMENT param EMPTY>
  <!ATTLIST param name NMTOKEN #REQUIRED select CDATA #IMPLIED required (yes|no) "no">
  <!ELEMENT templates (template+)>
  <!ELEMENT template (match, emit)>
  <!ATTLIST template name NMTOKEN #REQUIRED priority CDATA #IMPLIED>
  <!ELEMENT match (#PCDATA)>
  <!ELEMENT emit (literal|copy|value|choose)+>
  <!ELEMENT literal ANY>
  <!ELEMENT copy EMPTY>
  <!ATTLIST copy select CDATA #REQUIRED>
  <!ELEMENT value EMPTY>
  <!ATTLIST value select CDATA #REQUIRED>
  <!ELEMENT choose (when+, otherwise?)>
  <!ELEMENT when (literal|value|copy)*>
  <!ATTLIST when test CDATA #REQUIRED>
  <!ELEMENT otherwise (literal|value|copy)*>
  <!ELEMENT pipeline (step+)>
  <!ELEMENT step EMPTY>
  <!ATTLIST step ref IDREF #REQUIRED mode (stream|tree) "tree">
]>
<transform xmlns="&nsx;" version="3.0">
  <params>
    <param name="region" select="'eu-west'" required="yes"/>
    <param name="debug" select="false()" required="no"/>
  </params>
  <templates>
    <template name="root" priority="0.5">
      <match>/catalog/product</match>
      <emit>
        <literal><entry><source>catalog</source></entry></literal>
        <value select="@sku"/>
        <choose>
          <when test="@stock &gt; 0">
            <literal><availability>in-stock</availability></literal>
          </when>
          <otherwise>
            <literal><availability>backorder</availability></literal>
          </otherwise>
        </choose>
      </emit>
    </template>
  </templates>
  <pipeline>
    <step ref="root" mode="stream"/>
  </pipeline>
</transform>