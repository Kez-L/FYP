<?xml version="1.0"?>
<!DOCTYPE telemetry [
  <!ELEMENT telemetry (stream+)>
  <!ELEMENT stream (sample+)>
  <!ATTLIST stream id ID #REQUIRED source CDATA #REQUIRED>
  <!ELEMENT sample EMPTY>
  <!ATTLIST sample
    at CDATA #REQUIRED
    metric NMTOKEN #REQUIRED
    value CDATA #REQUIRED
    unit CDATA #IMPLIED
    status (ok|warn|error) "ok">
]>
<telemetry xmlns="urn:telemetry:raw">
  <stream id="s1" source="edge-α">
    <sample at="2026-10-01T12:00:00Z" metric="温度" value="21.4" unit="°C"/>
    <sample at="2026-10-01T12:01:00Z" metric="温度" value="21.7" unit="°C" status="warn"/>
    <sample at="2026-10-01T12:02:00Z" metric="fan_speed" value="0" unit="rpm" status="error"/>
  </stream>
  <stream id="s2" source="gateway">
    <sample at="2026-10-01T12:00:00Z" metric="voltage" value="3.300000"/>
  </stream>
</telemetry>