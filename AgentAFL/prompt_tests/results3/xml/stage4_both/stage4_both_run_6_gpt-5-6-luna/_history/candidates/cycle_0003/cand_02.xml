<?xml version="1.0"?>
<!DOCTYPE map [
  <!ELEMENT map (entry*)>
  <!ELEMENT entry (key, value)>
  <!ATTLIST entry id ID #REQUIRED parent IDREF #IMPLIED>
  <!ELEMENT key (#PCDATA)>
  <!ELEMENT value (#PCDATA|list|pair)*>
  <!ELEMENT list (value*)>
  <!ELEMENT pair (key, value)>
]>
<map>
  <entry id="root">
    <key>configuration</key>
    <value>
      <pair>
        <key>mode</key>
        <value>strict</value>
      </pair>
      <pair>
        <key>paths</key>
        <value>
          <list>
            <value>/usr/local/bin</value>
            <value>/opt/tools</value>
            <value><![CDATA[/tmp/<transient>]]></value>
          </list>
        </value>
      </pair>
    </value>
  </entry>
  <entry id="child" parent="root">
    <key>notes</key>
    <value>left <pair><key>flag</key><value>true</value></pair> right</value>
  </entry>
</map>