<?xml version="1.0" encoding="UTF-8"?>
<geometry xmlns="urn:example:geometry" dimension="3">
  <scene name="lattice">
    <transform order="SRT">
      <scale x="1.0" y="0.5" z="2.0"/>
      <rotate axis="z" degrees="45"/>
      <translate x="-3.25" y="0" z="8"/>
    </transform>
    <mesh id="m0" material-ref="glass">
      <vertices format="float32">
        <v>0 0 0</v>
        <v>1 0 0</v>
        <v>1 1 0</v>
        <v>0 1 0</v>
      </vertices>
      <faces winding="ccw">
        <face a="0" b="1" c="2"/>
        <face a="0" b="2" c="3"/>
      </faces>
      <bounds>
        <min x="0" y="0" z="0"/>
        <max x="1" y="1" z="0"/>
      </bounds>
    </mesh>
    <material id="glass" opacity="0.65" blend="alpha">
      <color space="srgb" r="0.2" g="0.7" b="1.0"/>
      <texture>
        <source uri="textures/blue.png"/>
        <mapping u="repeat" v="clamp"/>
      </texture>
    </material>
    <camera projection="perspective">
      <position x="4" y="3" z="9"/>
      <look-at x="0" y="0" z="0"/>
      <clipping near="0.01" far="1000"/>
    </camera>
  </scene>
  <metadata><![CDATA[vertices are intentionally coplanar]]></metadata>
</geometry>