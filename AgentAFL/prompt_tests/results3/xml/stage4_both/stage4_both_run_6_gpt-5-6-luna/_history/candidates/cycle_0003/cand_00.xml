<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE report [
  <!ENTITY product "A &amp; B">
  <!ENTITY quoted "&quot;quoted&quot;">
  <!ENTITY greeting "Hello, &product; — &quoted;">
  <!ELEMENT report (header, section+, footer?)>
  <!ELEMENT header (#PCDATA)>
  <!ELEMENT section (heading, paragraph+)>
  <!ATTLIST section code NMTOKEN #REQUIRED>
  <!ELEMENT heading (#PCDATA)>
  <!ELEMENT paragraph (#PCDATA|strong|code|br)*>
  <!ELEMENT strong (#PCDATA)>
  <!ELEMENT code (#PCDATA)>
  <!ELEMENT br EMPTY>
  <!ELEMENT footer (#PCDATA)>
]>
<report>
  <header>&greeting;</header>
  <section code="intro">
    <heading>Overview</heading>
    <paragraph>This is <strong>important</strong>, with <code>R&amp;D</code> details<br/>inline.</paragraph>
    <paragraph>Symbols: &#x2192; &#x2603; and escaped &lt;markup&gt;.</paragraph>
  </section>
  <section code="empty-text">
    <heading/>
    <paragraph><![CDATA[Literal entity text: &product;]]></paragraph>
  </section>
  <footer>End of report.</footer>
</report>