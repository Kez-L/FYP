<?xml version="1.0" encoding="UTF-8"?>
<dashboard xmlns="urn:example:dashboard" xmlns:ui="urn:example:ui" xml:lang="en">
  <layout direction="horizontal" gap="12">
    <panel id="left" collapsed="false">
      <header>
        <caption>Queue monitor</caption>
        <badge tone="warning">3</badge>
      </header>
      <content>
        <table striped="true">
          <columns>
            <column key="job" width="wide"/>
            <column key="owner" width="narrow"/>
            <column key="age" width="numeric"/>
          </columns>
          <rows>
            <row selected="true">
              <cell key="job">nightly-index</cell>
              <cell key="owner">s.lee</cell>
              <cell key="age">00:42</cell>
            </row>
            <row>
              <cell key="job">asset-import</cell>
              <cell key="owner">m.khan</cell>
              <cell key="age">01:07</cell>
            </row>
          </rows>
        </table>
      </content>
      <footer ui:action="refresh">
        <label>Updated <time datetime="2026-09-24T12:30:00Z">12:30 UTC</time></label>
      </footer>
    </panel>
    <panel id="right" collapsed="true">
      <header>
        <caption>Details</caption>
        <ui:button type="secondary" disabled="true">Inspect</ui:button>
      </header>
      <content>
        <message severity="info">Select a queue item to view diagnostics.</message>
        <chart type="sparkline" min="0" max="100">
          <point x="0" y="12"/>
          <point x="1" y="27"/>
          <point x="2" y="19"/>
          <point x="3" y="44"/>
        </chart>
      </content>
    </panel>
  </layout>
</dashboard>