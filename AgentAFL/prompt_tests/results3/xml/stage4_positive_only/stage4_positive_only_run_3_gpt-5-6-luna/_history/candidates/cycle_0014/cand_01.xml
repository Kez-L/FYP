<?xml version="1.0"?>
<svg xmlns="http://www.w3.org/2000/svg" xmlns:ink="http://example.invalid/ink" viewBox="-10 -10 240 140" width="480" height="280">
  <title>Layered signal diagram</title>
  <desc>A collection of paths, markers, and grouped annotations.</desc>
  <defs>
    <linearGradient id="fade" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#112233"/>
      <stop offset="100%" stop-color="#ddeeff"/>
    </linearGradient>
    <marker id="arrow" markerWidth="8" markerHeight="8" refX="6" refY="3" orient="auto">
      <path d="M0,0 L6,3 L0,6 Z" fill="currentColor"/>
    </marker>
  </defs>
  <g id="background" opacity="0.35" ink:layer="underlay">
    <rect x="0" y="0" width="220" height="120" rx="6" fill="url(#fade)"/>
    <circle cx="36" cy="31" r="12" fill="#ffffff"/>
    <ellipse cx="168" cy="86" rx="29" ry="11" fill="#778899"/>
  </g>
  <g id="routes" fill="none" stroke="#203040" stroke-width="2">
    <path d="M12 96 C44 12, 87 116, 122 45 S184 20, 214 94" marker-end="url(#arrow)"/>
    <polyline points="18,18 62,48 91,22 132,75 204,31"/>
  </g>
  <g id="labels" font-family="sans-serif" font-size="9">
    <text x="14" y="114">origin</text>
    <text x="176" y="114"><tspan fill="#cc0000">terminal</tspan><tspan dx="3">node</tspan></text>
  </g>
  <foreignObject x="74" y="83" width="70" height="22">
    <div xmlns="http://www.w3.org/1999/xhtml">
      <small>embedded note</small>
    </div>
  </foreignObject>
</svg>