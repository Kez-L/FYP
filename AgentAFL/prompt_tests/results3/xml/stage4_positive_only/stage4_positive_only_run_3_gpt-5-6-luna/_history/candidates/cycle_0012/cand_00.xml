<?xml version="1.0" encoding="UTF-8"?>
<scene xmlns="urn:example:scene" xmlns:svg="http://www.w3.org/2000/svg" viewBox="0 0 640 480">
  <metadata>
    <title>Layered diagram</title>
    <author id="u-17">Mira</author>
  </metadata>
  <canvas width="640" height="480" background="#ffffff">
    <svg:g id="background" opacity="0.85">
      <svg:rect x="12" y="18" width="240" height="96" rx="6"/>
      <svg:circle cx="410" cy="76" r="34"/>
    </svg:g>
    <layer name="foreground">
      <label x="24" y="52">A &lt; B</label>
      <connector from="node-a" to="node-b">
        <svg:path d="M20 20 C80 10, 120 90, 200 60"/>
      </connector>
      <node id="node-a" kind="input">
        <value><![CDATA[alpha & beta]]></value>
      </node>
      <node id="node-b" kind="output">
        <value>omega</value>
      </node>
    </layer>
  </canvas>
</scene>