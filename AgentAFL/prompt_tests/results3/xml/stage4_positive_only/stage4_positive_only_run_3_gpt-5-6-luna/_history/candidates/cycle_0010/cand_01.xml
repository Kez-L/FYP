<?xml version="1.0"?>
<!DOCTYPE message [
  <!ELEMENT message (header, body, attachment*)>
  <!ELEMENT header (sender, recipients, subject)>
  <!ELEMENT sender (#PCDATA)>
  <!ELEMENT recipients (recipient+)>
  <!ELEMENT recipient (#PCDATA)>
  <!ELEMENT subject (#PCDATA)>
  <!ELEMENT body (#PCDATA|quote|list)*>
  <!ELEMENT quote (#PCDATA)>
  <!ELEMENT list (item+)>
  <!ELEMENT item (#PCDATA)>
  <!ELEMENT attachment EMPTY>
  <!ATTLIST attachment name CDATA #REQUIRED media CDATA #IMPLIED>
  <!ENTITY product "XML parser">
]>
<message priority="urgent">
  <header>
    <sender>ops@example.test</sender>
    <recipients>
      <recipient>alice@example.test</recipient>
      <recipient>bob@example.test</recipient>
    </recipients>
    <subject>Review of the &product; report</subject>
  </header>
  <body>
    Please review the following material.
    <quote>All systems nominal.</quote>
    <list>
      <item>Check logs</item>
      <item>Verify backups</item>
      <item>Close ticket</item>
    </list>
  </body>
  <attachment name="summary.txt" media="text/plain"/>
</message>