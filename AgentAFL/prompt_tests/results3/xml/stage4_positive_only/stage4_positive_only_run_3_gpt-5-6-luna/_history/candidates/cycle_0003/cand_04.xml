<workflow>
  <start ref="prepare"/>
  <state name="prepare">
    <transition event="load" to="running"/>
    <transition event="cancel" to="finished"/>
  </state>
  <state name="running">
    <transition event="pause" to="paused"/>
    <transition event="complete" to="finished"/>
  </state>
  <state name="paused">
    <transition event="resume" to="running"/>
  </state>
  <state name="finished" final="yes">
    <result code="0">done</result>
  </state>
</workflow>