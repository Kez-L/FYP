<?xml version="1.0"?>
<!DOCTYPE scene [
  <!ELEMENT scene (stage, cast, dialogue, curtain)>
  <!ELEMENT stage (setting, prop*)>
  <!ELEMENT setting (#PCDATA)>
  <!ELEMENT prop (#PCDATA)>
  <!ELEMENT cast (person+)>
  <!ELEMENT person (name, role)>
  <!ATTLIST person key ID #REQUIRED>
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT role (#PCDATA)>
  <!ELEMENT dialogue (line|direction)+>
  <!ELEMENT line (#PCDATA|pause)*>
  <!ATTLIST line speaker IDREF #REQUIRED>
  <!ELEMENT pause EMPTY>
  <!ATTLIST pause duration CDATA #IMPLIED>
  <!ELEMENT direction (#PCDATA)>
  <!ELEMENT curtain EMPTY>
]>
<scene>
  <stage>
    <setting>A dim observatory under a violet sky.</setting>
    <prop>A brass telescope points toward the eastern window.</prop>
    <prop>A folded map rests on a wooden table.</prop>
  </stage>
  <cast>
    <person key="mira"><name>Mira</name><role>astronomer</role></person>
    <person key="jon"><name>Jon</name><role>visitor</role></person>
  </cast>
  <dialogue>
    <direction>The clock strikes midnight.</direction>
    <line speaker="mira">The comet returns tonight.</line>
    <line speaker="jon">Then why is the lens covered?<pause duration="2s"/></line>
    <direction>She removes the cloth without speaking.</direction>
    <line speaker="mira">Because some discoveries require patience.</line>
  </dialogue>
  <curtain/>
</scene>