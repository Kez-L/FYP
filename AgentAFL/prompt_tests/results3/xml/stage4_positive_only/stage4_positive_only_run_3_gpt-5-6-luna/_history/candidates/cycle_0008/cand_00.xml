<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE map [
  <!ELEMENT map (layer+, legend?)>
  <!ELEMENT layer (label, bounds, feature*)>
  <!ATTLIST layer name NMTOKEN #REQUIRED visible (true|false) "true">
  <!ELEMENT label (#PCDATA)>
  <!ELEMENT bounds (north, east, south, west)>
  <!ELEMENT north (#PCDATA)>
  <!ELEMENT east (#PCDATA)>
  <!ELEMENT south (#PCDATA)>
  <!ELEMENT west (#PCDATA)>
  <!ELEMENT feature (point|line|area)>
  <!ATTLIST feature id ID #REQUIRED kind NMTOKEN #REQUIRED>
  <!ELEMENT point EMPTY>
  <!ATTLIST point lat CDATA #REQUIRED lon CDATA #REQUIRED>
  <!ELEMENT line (point, point+)>
  <!ELEMENT area (ring+)>
  <!ELEMENT ring (point, point+)>
  <!ELEMENT legend (symbol+)>
  <!ELEMENT symbol (#PCDATA)>
  <!ATTLIST symbol code NMTOKEN #REQUIRED>
]>
<map xmlns="urn:example:cartography" version="3.7">
  <layer name="coastline" visible="true">
    <label>Atlantic survey</label>
    <bounds>
      <north>51.482</north>
      <east>2.104</east>
      <south>49.901</south>
      <west>-5.721</west>
    </bounds>
    <feature id="pt-001" kind="harbor">
      <point lat="50.8472" lon="-1.0879"/>
    </feature>
    <feature id="ln-014" kind="route">
      <line>
        <point lat="50.8472" lon="-1.0879"/>
        <point lat="50.3714" lon="-4.1427"/>
        <point lat="49.901" lon="-5.721"/>
      </line>
    </feature>
    <feature id="ar-003" kind="reserve">
      <area>
        <ring>
          <point lat="50.90" lon="-1.10"/>
          <point lat="50.92" lon="-1.04"/>
          <point lat="50.87" lon="-1.01"/>
          <point lat="50.90" lon="-1.10"/>
        </ring>
      </area>
    </feature>
  </layer>
  <legend>
    <symbol code="harbor">Anchorage</symbol>
    <symbol code="route">Survey route</symbol>
    <symbol code="reserve">Protected area</symbol>
  </legend>
</map>