<?xml version="1.0" encoding="UTF-8"?>
<configuration xmlns="urn:example:config" xml:base="https://config.example.test/v3/">
  <service name="gateway" enabled="true">
    <endpoint>
      <host>edge.example.test</host>
      <port>443</port>
      <protocol>https</protocol>
      <tls>
        <certificate path="certs/gateway.pem"/>
        <ciphers>
          <cipher>TLS_AES_128_GCM_SHA256</cipher>
          <cipher>TLS_CHACHA20_POLY1305_SHA256</cipher>
        </ciphers>
      </tls>
    </endpoint>
    <limits>
      <request unit="bytes">1048576</request>
      <timeout unit="milliseconds">2500</timeout>
    </limits>
  </service>
  <service name="metrics" enabled="false">
    <endpoint>
      <host>127.0.0.1</host>
      <port>9090</port>
      <protocol>http</protocol>
    </endpoint>
  </service>
  <feature-flags>
    <flag name="compression">true</flag>
    <flag name="trace">false</flag>
  </feature-flags>
</configuration>