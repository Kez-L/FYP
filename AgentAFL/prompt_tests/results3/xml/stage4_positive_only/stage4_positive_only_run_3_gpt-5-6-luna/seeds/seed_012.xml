<!DOCTYPE report [
  <!ELEMENT report (section*)>
  <!ELEMENT section (title, paragraph+, note?)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT paragraph (#PCDATA|em|br)*>
  <!ELEMENT note (#PCDATA)>
  <!ELEMENT em (#PCDATA)>
  <!ELEMENT br EMPTY>
]>
<report>
  <section id="s1">
    <title>Mixed content</title>
    <paragraph>This is <em>important</em><br/>and continues.</paragraph>
    <paragraph>Text with &amp; symbols and &lt; markup-looking text.</paragraph>
    <note>Optional annotation</note>
  </section>
  <section id="s2">
    <title>Empty note area</title>
    <paragraph><br/><em>tail</em></paragraph>
  </section>
</report>