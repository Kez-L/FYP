<?xml version="1.0" standalone="no"?>
<!DOCTYPE ledger [
  <!ELEMENT ledger (opening,transaction*,closing)>
  <!ATTLIST ledger currency CDATA "EUR">
  <!ELEMENT opening (#PCDATA)>
  <!ELEMENT transaction (date,account,amount,description?)>
  <!ATTLIST transaction id ID #REQUIRED cleared (yes|no) "no">
  <!ELEMENT date (#PCDATA)>
  <!ELEMENT account (#PCDATA)>
  <!ELEMENT amount (#PCDATA)>
  <!ELEMENT description (#PCDATA)>
  <!ELEMENT closing (#PCDATA)>
  <!ENTITY euro "&#x20AC;">
  <!ENTITY apos "&#39;">
]>
