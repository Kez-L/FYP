<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE inventory [
  <!ELEMENT inventory (warehouse+)>
  <!ELEMENT warehouse (address, bin+)>
  <!ATTLIST warehouse code ID #REQUIRED>
  <!ELEMENT address (line, city, country)>
  <!ELEMENT line (#PCDATA)>
  <!ELEMENT city (#PCDATA)>
  <!ELEMENT country (#PCDATA)>
  <!ELEMENT bin (product*)>
  <!ATTLIST bin label NMTOKEN #REQUIRED>
  <!ELEMENT product EMPTY>
  <!ATTLIST product sku ID #REQUIRED quantity NMTOKEN #REQUIRED fragile (yes|no) "no">
]>
<inventory>
  <warehouse code="wh-main">
    <address>
      <line>7 &lt;Market&gt; Road</line>
      <city>Exampleville</city>
      <country>XZ</country>
    </address>
    <bin label="A-01">
      <product sku="sku-100" quantity="12" fragile="yes"/>
      <product sku="sku-101" quantity="0"/>
    </bin>
    <bin label="B-02"/>
  </warehouse>
  <warehouse code="wh-remote">
    <address>
      <line>Harbor Lane</line>
      <city>Porttown</city>
      <country>YY</country>
    </address>
    <bin label="C-09">
      <product sku="sku-200" quantity="5"/>
    </bin>
  </warehouse>
</inventory>