<?xml version="1.0"?>
<!DOCTYPE envelope [
  <!ELEMENT envelope (meta, payload)>
  <!ELEMENT meta EMPTY>
  <!ATTLIST meta xml:lang NMTOKEN #IMPLIED>
  <!ELEMENT payload (p:entry*, tail?)>
  <!ELEMENT p:entry (#PCDATA|p:mark)*>
  <!ELEMENT p:mark EMPTY>
  <!ELEMENT tail (#PCDATA)>
]>
<envelope xmlns="urn:outer" xmlns:p="urn:payload" xml:base="urn:root">
  <meta xml:lang="fr"/>
  <payload xmlns="">
    <p:entry code="A&amp;1">one<p:mark/>two</p:entry>
    <p:entry xmlns:p="urn:alternate" p:flag="yes">three</p:entry>
    <tail xml:space="preserve">  end  </tail>
  </payload>
</envelope>