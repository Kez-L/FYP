<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE report [
  <!ENTITY company "North &amp; South Research">
  <!ENTITY status "pending">
  <!ELEMENT report (header, section+, footer?)>
  <!ELEMENT header (title, owner)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT owner (#PCDATA)>
  <!ELEMENT section (heading, paragraph+)>
  <!ELEMENT heading (#PCDATA)>
  <!ELEMENT paragraph (#PCDATA|emphasis|link)*>
  <!ELEMENT emphasis (#PCDATA)>
  <!ELEMENT link (#PCDATA)>
  <!ELEMENT footer (#PCDATA)>
  <!ATTLIST report version CDATA #REQUIRED>
  <!ATTLIST section code ID #REQUIRED>
  <!ATTLIST link href URI #IMPLIED>
]>
<report version="2.0">
  <header>
    <title>&company; status report</title>
    <owner>team-&status;</owner>
  </header>
  <section code="intro">
    <heading>Overview</heading>
    <paragraph>This is <emphasis>mixed</emphasis> content with a <link href="https://example.invalid/a?b=1&amp;c=2">link</link>.</paragraph>
  </section>
  <section code="results">
    <heading>Results</heading>
    <paragraph>First paragraph.</paragraph>
    <paragraph><![CDATA[Second paragraph with ]]> and literal markup-like text.</paragraph>
  </section>
  <footer>End of document.</footer>
</report>