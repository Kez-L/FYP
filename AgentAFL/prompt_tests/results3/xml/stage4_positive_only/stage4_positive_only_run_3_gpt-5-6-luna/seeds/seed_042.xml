<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE inventory [
  <!ENTITY company "Example &amp; Sons">
  <!ELEMENT inventory (warehouse+)>
  <!ELEMENT warehouse (location, bin*)>
  <!ATTLIST warehouse code ID #REQUIRED>
  <!ELEMENT location (#PCDATA)>
  <!ELEMENT bin (item*)>
  <!ATTLIST bin label NMTOKEN #REQUIRED>
  <!ELEMENT item (description, quantity, price?)>
  <!ATTLIST item sku ID #REQUIRED fragile (yes|no) "no">
  <!ELEMENT description (#PCDATA)>
  <!ELEMENT quantity (#PCDATA)>
  <!ELEMENT price (#PCDATA)>
]>
<inventory>
  <warehouse code="wh-east">
    <location>&company; — East Depot</location>
    <bin label="A-01">
      <item sku="sku-100" fragile="yes">
        <description>Glass reagent bottle</description>
        <quantity>12</quantity>
        <price>19.95</price>
      </item>
      <item sku="sku-101">
        <description>Fiber cable, 10m</description>
        <quantity>7</quantity>
      </item>
    </bin>
    <bin label="B-99"/>
  </warehouse>
  <warehouse code="wh-west">
    <location>West Depot</location>
    <bin label="overflow">
      <item sku="sku-200" fragile="no">
        <description><![CDATA[Replacement panel <prototype>]]></description>
        <quantity>0</quantity>
        <price>0.00</price>
      </item>
    </bin>
  </warehouse>
</inventory>