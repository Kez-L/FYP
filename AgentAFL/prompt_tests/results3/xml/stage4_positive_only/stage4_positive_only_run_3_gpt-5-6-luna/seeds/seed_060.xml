<?xml version="1.0"?>
<!DOCTYPE library [
  <!ELEMENT library (prologue?, book+, appendix?)>
  <!ELEMENT prologue (#PCDATA)>
  <!ELEMENT book (title, author+, metadata, chapter+)>
  <!ATTLIST book isbn CDATA #REQUIRED>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT author (given, family)>
  <!ELEMENT given (#PCDATA)>
  <!ELEMENT family (#PCDATA)>
  <!ELEMENT metadata (published, keywords)>
  <!ELEMENT published (#PCDATA)>
  <!ELEMENT keywords (keyword*)>
  <!ELEMENT keyword (#PCDATA)>
  <!ELEMENT chapter (number, heading, paragraph+)>
  <!ELEMENT number (#PCDATA)>
  <!ELEMENT heading (#PCDATA)>
  <!ELEMENT paragraph (#PCDATA|quote|term)*>
  <!ELEMENT quote (#PCDATA)>
  <!ELEMENT term (#PCDATA)>
  <!ELEMENT appendix (note+)>
  <!ELEMENT note (#PCDATA)>
]>
<library>
  <prologue>A small technical collection.</prologue>
  <book isbn="978-0-00-000001-1">
    <title>Signals and Systems</title>
    <author><given>Rina</given><family>Vale</family></author>
    <author><given>Omar</given><family>Chen</family></author>
    <metadata>
      <published>2024-03-18</published>
      <keywords><keyword>signal</keyword><keyword>sampling</keyword></keywords>
    </metadata>
    <chapter>
      <number>1</number>
      <heading>Discrete beginnings</heading>
      <paragraph>A sequence may contain a <term>sample</term> at every integer instant.</paragraph>
      <paragraph>As the <quote>first observation</quote> arrives, the model begins.</paragraph>
    </chapter>
    <chapter>
      <number>2</number>
      <heading>Noise</heading>
      <paragraph><![CDATA[Measurements often include values such as <0 and >0.]]></paragraph>
    </chapter>
  </book>
  <appendix><note>Revision A: terminology updated.</note></appendix>
</library>