<?xml version="1.0"?>
<map xmlns="urn:example:map" xmlns:g="urn:geo:point" version="7">
  <!-- Mixed content and namespace-qualified attributes -->
  <layer id="terrain" visible="true">
    <label xml:lang="en">Elevation &lt; 1000m</label>
    <g:point g:lat="51.0504" g:lon="-1.3470">
      <g:altitude unit="m">132.75</g:altitude>
    </g:point>
    <style>
      <color>#7f9f4a</color>
      <opacity>0.875</opacity>
      <dash sequence="5,2,1,2"/>
    </style>
  </layer>
  <layer id="water" visible="false">
    <label xml:lang="fr">Rivières &amp; lacs</label>
    <g:point g:lat="48.8566" g:lon="2.3522"/>
    <style>
      <color>#0044ff</color>
      <opacity>0.125</opacity>
    </style>
  </layer>
</map>