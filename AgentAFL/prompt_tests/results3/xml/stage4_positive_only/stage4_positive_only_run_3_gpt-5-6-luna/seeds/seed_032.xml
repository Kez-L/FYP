<?xml version="1.0"?>
<!DOCTYPE report [
  <!ENTITY product "parser">
  <!ENTITY stamp "2026-09-24">
  <!ENTITY nested "&lt;escaped&gt; &amp; text">
  <!ELEMENT report (header, section*, conclusion?)>
  <!ELEMENT header (subject, author, date)>
  <!ELEMENT subject (#PCDATA)>
  <!ELEMENT author (#PCDATA)>
  <!ELEMENT date (#PCDATA)>
  <!ELEMENT section (heading, paragraph+, list?)>
  <!ATTLIST section level NMTOKEN #REQUIRED>
  <!ELEMENT heading (#PCDATA)>
  <!ELEMENT paragraph (#PCDATA|code|link|br)*>
  <!ELEMENT code (#PCDATA)>
  <!ELEMENT link (#PCDATA)>
  <!ATTLIST link href URI #IMPLIED>
  <!ELEMENT br EMPTY>
  <!ELEMENT list (item*)>
  <!ELEMENT item (#PCDATA)>
  <!ELEMENT conclusion (#PCDATA)>
]>
<report>
  <header>
    <subject>Testing &product; behavior</subject>
    <author>QA &lt;team&gt;</author>
    <date>&stamp;</date>
  </header>
  <section level="1">
    <heading>Input handling</heading>
    <paragraph>Literal entity expansion: &nested; <br/> and inline <code>--noout</code>.</paragraph>
    <paragraph>See <link href="https://example.invalid/a?b=1&amp;c=2">reference</link>.</paragraph>
    <list>
      <item>empty values</item>
      <item>unicode: Ελληνικά / 日本語 / العربية</item>
      <item>quotes: &quot;single&quot; and &apos;double&apos;</item>
    </list>
  </section>
  <section level="2">
    <heading>Boundary notes</heading>
    <paragraph><![CDATA[Characters such as ]]> and & remain inside this section.</paragraph>
  </section>
  <conclusion>End of report.</conclusion>
</report>