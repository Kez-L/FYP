<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE archive [
  <!ELEMENT archive (entry*)>
  <!ELEMENT entry (key, value, history?)>
  <!ELEMENT key (#PCDATA)>
  <!ELEMENT value (#PCDATA|linebreak)*>
  <!ELEMENT linebreak EMPTY>
  <!ELEMENT history (change+)>
  <!ELEMENT change (#PCDATA)>
  <!ATTLIST entry key ID #REQUIRED type (text|binary|secret) "text">
  <!ATTLIST change by CDATA #REQUIRED at CDATA #REQUIRED>
  <!ENTITY nbsp "&#160;">
]>
<archive>
  <entry key="alpha" type="text">
    <key>alpha</key>
    <value>first&nbsp;value<linebreak/>after break</value>
    <history>
      <change by="admin" at="2026-01-01T00:00:00Z">created</change>
      <change by="user&amp;bot" at="2026-09-24T00:00:00Z">updated</change>
    </history>
  </entry>
  <entry key="binary" type="binary">
    <key>binary</key>
    <value>AAECAwQFBgcICQ==</value>
  </entry>
  <entry key="secret" type="secret">
    <key>secret</key>
    <value><![CDATA[&lt;not-an-element&gt;]]></value>
  </entry>
</archive>