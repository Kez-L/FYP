<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE knowledge [
  <!ELEMENT knowledge (section+)>
  <!ATTLIST knowledge lang NMTOKEN #IMPLIED>
  <!ELEMENT section (heading, intro?, entry+)>
  <!ATTLIST section id ID #REQUIRED level (primary|secondary) "primary">
  <!ELEMENT heading (#PCDATA)>
  <!ELEMENT intro (#PCDATA|ref|code)*>
  <!ELEMENT entry (term, definition, see-also?)>
  <!ATTLIST entry status (draft|published|retired) "published">
  <!ELEMENT term (#PCDATA)>
  <!ELEMENT definition (#PCDATA|ref|code|quote|list)*>
  <!ELEMENT ref (#PCDATA)>
  <!ATTLIST ref target IDREF #REQUIRED>
  <!ELEMENT code (#PCDATA)>
  <!ELEMENT quote (#PCDATA)>
  <!ELEMENT list (item+)>
  <!ELEMENT item (#PCDATA|code|ref)*>
  <!ELEMENT see-also (ref+)>
  <!ENTITY nbsp "&#160;">
  <!ENTITY product "XML &amp; Data">
]>
<knowledge lang="en">
  <section id="parsing" level="primary">
    <heading>Parsing concepts</heading>
    <intro>Reliable processing of &product; requires attention to <code>encoding</code> and <ref target="entities">entities</ref>.</intro>
    <entry status="published">
      <term>Well-formedness</term>
      <definition>A document has one root element and properly nested markup. &nbsp;Whitespace may vary.</definition>
      <see-also><ref target="entities">Entity expansion</ref></see-also>
    </entry>
    <entry status="draft">
      <term>Normalization</term>
      <definition>Line endings and attribute values are normalized before application use.
        <quote>Preserve meaning, not incidental formatting.</quote>
        <list>
          <item>Inspect character references.</item>
          <item>Compare <code>CDATA</code> sections.</item>
        </list>
      </definition>
    </entry>
  </section>
  <section id="entities">
    <heading>Entity expansion</heading>
    <entry>
      <term>General entity</term>
      <definition>Named content can be inserted with an ampersand reference.</definition>
    </entry>
  </section>
</knowledge>