<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE journal [
  <!ELEMENT journal (header, entry+)>
  <!ELEMENT header (publication, issue, editor)>
  <!ELEMENT publication (#PCDATA)>
  <!ELEMENT issue (#PCDATA)>
  <!ELEMENT editor (#PCDATA)>
  <!ELEMENT entry (date, headline, byline, paragraph+, note*)>
  <!ATTLIST entry id ID #REQUIRED status (draft|published|archived) "published">
  <!ELEMENT date (#PCDATA)>
  <!ELEMENT headline (#PCDATA)>
  <!ELEMENT byline (#PCDATA)>
  <!ELEMENT paragraph (#PCDATA|strong|code|quote|break)*>
  <!ELEMENT strong (#PCDATA)>
  <!ELEMENT code (#PCDATA)>
  <!ELEMENT quote (#PCDATA)>
  <!ELEMENT break EMPTY>
  <!ELEMENT note (#PCDATA)>
  <!ATTLIST note ref IDREF #IMPLIED>
  <!ENTITY copyright "© 2026">
]>
<journal xml:lang="en">
  <header>
    <publication>Observatory Review</publication>
    <issue>42</issue>
    <editor>R. A. Kline</editor>
  </header>
  <entry id="entry-alpha" status="published">
    <date>2026-09-24</date>
    <headline>Signals beneath the ordinary</headline>
    <byline>By Mira &amp; Sol</byline>
    <paragraph>At dawn, the instruments recorded a <strong>quiet anomaly</strong>.<break/>The operator wrote <quote>check the northern channel</quote> in the margin.</paragraph>
    <paragraph>Calibration used <code>phase&lt;threshold</code> before the final sweep.</paragraph>
    <note ref="entry-alpha">Filed with &copyright; and retained for comparison.</note>
  </entry>
</journal>