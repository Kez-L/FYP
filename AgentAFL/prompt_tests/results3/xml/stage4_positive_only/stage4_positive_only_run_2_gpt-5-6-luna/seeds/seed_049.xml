<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE lexicon [
  <!ELEMENT lexicon (entry+)>
  <!ELEMENT entry (term, pronunciation?, senses, usage*)>
  <!ATTLIST entry id ID #REQUIRED>
  <!ELEMENT term (#PCDATA)>
  <!ELEMENT pronunciation (#PCDATA)>
  <!ELEMENT senses (sense+)>
  <!ELEMENT sense (definition, example*)>
  <!ATTLIST sense number NMTOKEN #REQUIRED>
  <!ELEMENT definition (#PCDATA|foreign)*>
  <!ELEMENT foreign (#PCDATA)>
  <!ATTLIST foreign xml:lang NMTOKEN #REQUIRED>
  <!ELEMENT example (#PCDATA)>
  <!ELEMENT usage (#PCDATA)>
]>
<lexicon>
  <entry id="lex-1">
    <term>wayfarer</term>
    <pronunciation>ˈweɪˌfɛərə</pronunciation>
    <senses>
      <sense number="1">
        <definition>A person who travels, especially on foot.</definition>
        <example>The wayfarer followed the river beyond the last bridge.</example>
      </sense>
      <sense number="2">
        <definition>
          A traveler in a figurative sense;
          <foreign xml:lang="la">viator</foreign>.
        </definition>
      </sense>
    </senses>
    <usage>literary</usage>
  </entry>
  <entry id="lex-2">
    <term>threshold</term>
    <senses>
      <sense number="1">
        <definition>The sill beneath a door.</definition>
      </sense>
      <sense number="2">
        <definition>A point at which an effect begins.</definition>
        <example>Noise levels crossed the threshold.</example>
      </sense>
    </senses>
  </entry>
</lexicon>