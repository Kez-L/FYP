<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE catalog [
  <!ELEMENT catalog (collection*)>
  <!ELEMENT collection (name, product+)>
  <!ATTLIST collection id ID #REQUIRED>
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT product (sku, description, price, tags?)>
  <!ATTLIST product code ID #REQUIRED available (yes|no) "yes">
  <!ELEMENT sku (#PCDATA)>
  <!ELEMENT description (#PCDATA|em|br)*>
  <!ELEMENT em (#PCDATA)>
  <!ELEMENT br EMPTY>
  <!ELEMENT price (#PCDATA)>
  <!ELEMENT tags (tag+)>
  <!ELEMENT tag (#PCDATA)>
  <!ENTITY currency "€">
]>
<catalog>
  <collection id="c-main">
    <name>Field equipment</name>
    <product code="p-001">
      <sku>AX-17</sku>
      <description>Compact <em>weatherproof</em> case<br/>with reinforced hinges.</description>
      <price>129 &currency;</price>
      <tags><tag>outdoor</tag><tag>storage</tag></tags>
    </product>
    <product code="p-002" available="no">
      <sku>BK-42</sku>
      <description>Foldable inspection lamp</description>
      <price>74 &currency;</price>
    </product>
  </collection>
</catalog>