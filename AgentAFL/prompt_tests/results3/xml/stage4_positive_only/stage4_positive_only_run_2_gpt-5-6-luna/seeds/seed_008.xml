<?xml version="1.0"?>
<!DOCTYPE map [
  <!ELEMENT map (entry+)>
  <!ELEMENT entry (key, value, metadata?)>
  <!ATTLIST entry id ID #IMPLIED>
  <!ELEMENT key (#PCDATA)>
  <!ELEMENT value (scalar|list|object|nil)>
  <!ELEMENT scalar (#PCDATA)>
  <!ELEMENT list (item*)>
  <!ELEMENT item (scalar|list|object)>
  <!ELEMENT object (field*)>
  <!ELEMENT field (key, value)>
  <!ELEMENT nil EMPTY>
  <!ELEMENT metadata (author?, timestamp?)>
  <!ELEMENT author (#PCDATA)>
  <!ELEMENT timestamp (#PCDATA)>
  <!ENTITY nbsp "&#160;">
]>
<map xmlns:m="urn:map" m:version="2">
  <entry id="config">
    <key>settings</key>
    <value>
      <object>
        <field><key>enabled</key><value><scalar>true</scalar></value></field>
        <field><key>paths</key><value><list><item><scalar>/a</scalar></item><item><scalar>/b</scalar></item></list></value></field>
        <field><key>missing</key><value><nil/></value></field>
      </object>
    </value>
    <metadata><author>admin &nbsp;</author><timestamp>2026-01-01T00:00:00Z</timestamp></metadata>
  </entry>
</map>