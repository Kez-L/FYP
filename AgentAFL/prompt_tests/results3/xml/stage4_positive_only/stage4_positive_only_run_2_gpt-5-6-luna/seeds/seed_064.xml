<?xml version="1.0"?>
<!DOCTYPE survey [
  <!ELEMENT survey (intro, response*)>
  <!ATTLIST survey id ID #REQUIRED locale CDATA "en">
  <!ELEMENT intro (question+)>
  <!ELEMENT question (prompt, choice+)>
  <!ATTLIST question id ID #REQUIRED required (yes|no) "no">
  <!ELEMENT prompt (#PCDATA)>
  <!ELEMENT choice (#PCDATA)>
  <!ATTLIST choice value CDATA #REQUIRED>
  <!ELEMENT response (answer+, comment?)>
  <!ATTLIST response respondent ID #REQUIRED submitted CDATA #IMPLIED>
  <!ELEMENT answer EMPTY>
  <!ATTLIST answer question IDREF #REQUIRED value CDATA #REQUIRED>
  <!ELEMENT comment (#PCDATA)>
]>
<survey id="climate-pulse" locale="en-GB">
  <intro>
    <question id="q-region" required="yes">
      <prompt>Which region do you represent?</prompt>
      <choice value="coastal">Coastal</choice>
      <choice value="inland">Inland</choice>
      <choice value="highland">Highland</choice>
    </question>
    <question id="q-frequency">
      <prompt>How often are measurements collected?</prompt>
      <choice value="daily">Daily</choice>
      <choice value="weekly">Weekly</choice>
      <choice value="manual">Only when needed</choice>
    </question>
  </intro>
  <response respondent="team-a" submitted="2026-09-23T17:00:00Z">
    <answer question="q-region" value="coastal"/>
    <answer question="q-frequency" value="daily"/>
    <comment>Automated stations report at 06:00 and 18:00.</comment>
  </response>
  <response respondent="team-b">
    <answer question="q-region" value="highland"/>
    <answer question="q-frequency" value="weekly"/>
  </response>
</survey>