<?xml version="1.1"?>
<!DOCTYPE message [
  <!ELEMENT message (header, body, attachments?)>
  <!ELEMENT header (sender, recipients, subject)>
  <!ELEMENT sender EMPTY>
  <!ATTLIST sender address CDATA #REQUIRED>
  <!ELEMENT recipients (recipient+)>
  <!ELEMENT recipient EMPTY>
  <!ATTLIST recipient address CDATA #REQUIRED type (to|cc|bcc) "to">
  <!ELEMENT subject (#PCDATA)>
  <!ELEMENT body (paragraph|quote|list)+>
  <!ELEMENT paragraph (#PCDATA|strong|link|linebreak)*>
  <!ELEMENT strong (#PCDATA)>
  <!ELEMENT link (#PCDATA)>
  <!ATTLIST link href CDATA #REQUIRED>
  <!ELEMENT linebreak EMPTY>
  <!ELEMENT quote (#PCDATA)>
  <!ELEMENT list (entry+)>
  <!ELEMENT entry (#PCDATA)>
  <!ELEMENT attachments (attachment+)>
  <!ELEMENT attachment EMPTY>
  <!ATTLIST attachment name CDATA #REQUIRED size CDATA #IMPLIED>
]>
<message>
  <header>
    <sender address="editor@example.invalid"/>
    <recipients>
      <recipient address="reader@example.invalid"/>
      <recipient address="archive@example.invalid" type="cc"/>
    </recipients>
    <subject>Revision notice</subject>
  </header>
  <body>
    <paragraph>Please review the <strong>marked</strong> passages before the <link href="https://example.invalid/deadline">deadline</link>.<linebreak/></paragraph>
    <quote>Every map begins as an argument with uncertainty.</quote>
    <list>
      <entry>Check citations</entry>
      <entry>Confirm translation</entry>
    </list>
  </body>
  <attachments>
    <attachment name="notes.txt" size="2048"/>
  </attachments>
</message>