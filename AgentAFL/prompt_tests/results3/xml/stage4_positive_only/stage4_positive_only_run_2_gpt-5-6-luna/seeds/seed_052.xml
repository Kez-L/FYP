<?xml version="1.0"?>
<!DOCTYPE article [
  <!ELEMENT article (header, body, references?)>
  <!ELEMENT header (title, byline, date)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT byline (#PCDATA)>
  <!ELEMENT date (#PCDATA)>
  <!ELEMENT body (paragraph|quote|list|table)+>
  <!ELEMENT paragraph (#PCDATA|strong|code|link|break)*>
  <!ELEMENT strong (#PCDATA)>
  <!ELEMENT code (#PCDATA)>
  <!ELEMENT link (#PCDATA)>
  <!ATTLIST link href CDATA #REQUIRED>
  <!ELEMENT break EMPTY>
  <!ELEMENT quote (#PCDATA|paragraph)*>
  <!ATTLIST quote source CDATA #IMPLIED>
  <!ELEMENT list (entry+)>
  <!ELEMENT entry (#PCDATA|strong)*>
  <!ELEMENT table (row+)>
  <!ELEMENT row (cell+)>
  <!ELEMENT cell (#PCDATA)>
  <!ELEMENT references (reference+)>
  <!ELEMENT reference (#PCDATA)>
  <!ENTITY intro "A short note:">
]>
<article>
  <header>
    <title>Signals in the margin</title>
    <byline>R. Ionescu</byline>
    <date>2026-09-24</date>
  </header>
  <body>
    <paragraph>&intro; the instrument returned <strong>three</strong> distinct values.<break/>See <link href="urn:sample:chart">the chart</link> for context.</paragraph>
    <quote source="lab-notebook">
      <paragraph>Noise was lower after midnight.</paragraph>
      <paragraph>Calibration remained within tolerance.</paragraph>
    </quote>
    <list>
      <entry><strong>low</strong> frequency</entry>
      <entry>intermittent pulse</entry>
      <entry>stable baseline</entry>
    </list>
    <table>
      <row><cell>channel</cell><cell>minimum</cell><cell>maximum</cell></row>
      <row><cell>A-1</cell><cell>-0.003</cell><cell>0.014</cell></row>
      <row><cell>B-7</cell><cell>-0.011</cell><cell>0.009</cell></row>
    </table>
  </body>
  <references>
    <reference>Notebook 14, page 6</reference>
    <reference>Internal memorandum Δ-2</reference>
  </references>
</article>