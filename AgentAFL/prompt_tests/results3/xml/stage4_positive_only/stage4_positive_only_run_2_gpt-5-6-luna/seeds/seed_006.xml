<?xml version="1.0"?>
<!DOCTYPE dashboard [
  <!ELEMENT dashboard (panel*)>
  <!ELEMENT panel (title, widget+)>
  <!ATTLIST panel name NMTOKEN #REQUIRED>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT widget (label?, metric|table|sparkline)>
  <!ATTLIST widget kind (metric|table|sparkline) #REQUIRED>
  <!ELEMENT label (#PCDATA)>
  <!ELEMENT metric (#PCDATA)>
  <!ELEMENT table (row+)>
  <!ELEMENT row (cell+)>
  <!ELEMENT cell (#PCDATA)>
  <!ELEMENT sparkline EMPTY>
  <!ATTLIST sparkline points CDATA #REQUIRED>
]>
<dashboard xmlns="urn:dashboard" xmlns:x="urn:extra">
  <panel name="system">
    <title>System <x:emphasis>overview</x:emphasis></title>
    <widget kind="metric"><label>load</label><metric>0.42</metric></widget>
    <widget kind="table">
      <table>
        <row><cell>host</cell><cell>status</cell></row>
        <row><cell><![CDATA[node-1]]></cell><cell>ok</cell></row>
      </table>
    </widget>
  </panel>
  <panel name="empty">
    <title/>
    <widget kind="sparkline"><sparkline points="1,2,3,2,5"/></widget>
  </panel>
</dashboard>