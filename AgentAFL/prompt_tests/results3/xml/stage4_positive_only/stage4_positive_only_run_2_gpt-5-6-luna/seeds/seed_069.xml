<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE library [
  <!ELEMENT library (book+, reservation*)>
  <!ELEMENT book (title, author+, identifiers, synopsis?)>
  <!ATTLIST book isbn ID #REQUIRED format (paper|digital|audio) #REQUIRED>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT author (given, family)>
  <!ELEMENT given (#PCDATA)>
  <!ELEMENT family (#PCDATA)>
  <!ELEMENT identifiers (identifier+)>
  <!ELEMENT identifier (#PCDATA)>
  <!ATTLIST identifier type (isbn13|doi|internal) #REQUIRED>
  <!ELEMENT synopsis (#PCDATA|quote)*>
  <!ELEMENT quote (#PCDATA)>
  <!ELEMENT reservation (reader, book-ref, due-date)>
  <!ELEMENT reader (#PCDATA)>
  <!ELEMENT book-ref EMPTY>
  <!ATTLIST book-ref target IDREF #REQUIRED>
  <!ELEMENT due-date (#PCDATA)>
]>
<library xml:lang="en">
  <book isbn="bk-001" format="paper">
    <title>Patterns of Small Systems</title>
    <author>
      <given>Rina</given>
      <family>Vale</family>
    </author>
    <author>
      <given>Jon</given>
      <family>Mercer</family>
    </author>
    <identifiers>
      <identifier type="isbn13">9780000000001</identifier>
      <identifier type="internal">shelf-b3-17</identifier>
    </identifiers>
    <synopsis>Short essays on design, including <quote>make failure visible</quote> as a recurring principle.</synopsis>
  </book>
  <book isbn="bk-002" format="digital">
    <title>Signals in Winter</title>
    <author>
      <given>Mei</given>
      <family>Arden</family>
    </author>
    <identifiers>
      <identifier type="doi">10.5555/example.2026.02</identifier>
    </identifiers>
  </book>
  <reservation>
    <reader>alexa@example.invalid</reader>
    <book-ref target="bk-001"/>
    <due-date>2026-10-03</due-date>
  </reservation>
</library>