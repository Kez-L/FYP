<?xml version="1.0"?>
<!DOCTYPE scene [
  <!ELEMENT scene (defs?, layer+)>
  <!ATTLIST scene width CDATA #REQUIRED height CDATA #REQUIRED viewBox CDATA #IMPLIED>
  <!ELEMENT defs (gradient|pattern|filter)*>
  <!ELEMENT gradient (stop+)>
  <!ATTLIST gradient id ID #REQUIRED direction (horizontal|vertical|radial) "horizontal">
  <!ELEMENT stop EMPTY>
  <!ATTLIST stop offset CDATA #REQUIRED color CDATA #REQUIRED opacity CDATA #IMPLIED>
  <!ELEMENT pattern (rect|path|circle)*>
  <!ATTLIST pattern id ID #REQUIRED>
  <!ELEMENT filter (blur|shadow)*>
  <!ATTLIST filter id ID #REQUIRED>
  <!ELEMENT blur EMPTY>
  <!ATTLIST blur radius CDATA #REQUIRED>
  <!ELEMENT shadow EMPTY>
  <!ATTLIST shadow dx CDATA #IMPLIED dy CDATA #IMPLIED>
  <!ELEMENT layer (group|rect|circle|path|text)*>
  <!ATTLIST layer name CDATA #IMPLIED visible (true|false) "true">
  <!ELEMENT group (group|rect|circle|path|text)*>
  <!ATTLIST group transform CDATA #IMPLIED>
  <!ELEMENT rect EMPTY>
  <!ATTLIST rect x CDATA #REQUIRED y CDATA #REQUIRED width CDATA #REQUIRED height CDATA #REQUIRED fill CDATA #IMPLIED>
  <!ELEMENT circle EMPTY>
  <!ATTLIST circle cx CDATA #REQUIRED cy CDATA #REQUIRED r CDATA #REQUIRED fill CDATA #IMPLIED>
  <!ELEMENT path EMPTY>
  <!ATTLIST path d CDATA #REQUIRED stroke CDATA #IMPLIED>
  <!ELEMENT text (#PCDATA)>
  <!ATTLIST text x CDATA #REQUIRED y CDATA #REQUIRED>
  <!ENTITY accent "#5577AA">
]>
<?render mode="preview"?>
<scene width="640" height="360" viewBox="0 0 640 360">
  <defs>
    <gradient id="sky" direction="vertical">
      <stop offset="0%" color="#DDF4FF"/>
      <stop offset="100%" color="&accent;" opacity="0.8"/>
    </gradient>
    <pattern id="grid">
      <path d="M0 0 L20 0 L20 20" stroke="#CCCCCC"/>
      <rect x="0" y="0" width="20" height="20" fill="none"/>
    </pattern>
    <filter id="soft">
      <blur radius="4"/>
      <shadow dx="2" dy="3"/>
    </filter>
  </defs>
  <layer name="background">
    <rect x="0" y="0" width="640" height="360" fill="url(#sky)"/>
    <rect x="0" y="0" width="640" height="360" fill="url(#grid)"/>
  </layer>
  <layer name="objects" visible="true">
    <group transform="translate(48,72)">
      <circle cx="90" cy="80" r="54" fill="#FFCC44"/>
      <path d="M0 180 C80 90 130 120 220 180" stroke="#334455"/>
      <text x="18" y="230">dawn <![CDATA[<phase>]]> study</text>
    </group>
  </layer>
</scene>