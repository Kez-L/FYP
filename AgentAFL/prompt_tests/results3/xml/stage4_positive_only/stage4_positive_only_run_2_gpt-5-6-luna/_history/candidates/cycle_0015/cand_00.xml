<?xml version="1.0"?>
<!DOCTYPE library [
  <!ELEMENT library (branch, branch*)>
  <!ELEMENT branch (address, collection)>
  <!ATTLIST branch code ID #REQUIRED>
  <!ELEMENT address (street, city, region?, postal)>
  <!ELEMENT street (#PCDATA)>
  <!ELEMENT city (#PCDATA)>
  <!ELEMENT region (#PCDATA)>
  <!ELEMENT postal (#PCDATA)>
  <!ELEMENT collection (book*)>
  <!ELEMENT book (title, author+, published?, summary?)>
  <!ATTLIST book isbn CDATA #REQUIRED format (paper|ebook|audio) "paper">
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT author (#PCDATA)>
  <!ELEMENT published (#PCDATA)>
  <!ELEMENT summary (#PCDATA|em|br)*>
  <!ELEMENT em (#PCDATA)>
  <!ELEMENT br EMPTY>
]>
<library>
  <branch code="central">
    <address>
      <street>42 Archive Lane</street>
      <city>Northbridge</city>
      <region>West</region>
      <postal>NB4 7QZ</postal>
    </address>
    <collection>
      <book isbn="978-0000000001" format="ebook">
        <title>The Shape of Data</title>
        <author>Rina Vale</author>
        <author>Marcus Holt</author>
        <published>2024</published>
        <summary>A guide to <em>structured</em> information.<br/>Includes practical examples.</summary>
      </book>
      <book isbn="978-0000000002" format="audio">
        <title>Night Signals</title>
        <author>Jo Arlen</author>
      </book>
    </collection>
  </branch>
</library>