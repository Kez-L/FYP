<?xml version="1.0"?>
<!DOCTYPE catalog [
  <!ELEMENT catalog (section+)>
  <!ELEMENT section (item*)>
  <!ATTLIST section id ID #REQUIRED>
  <!ELEMENT item (#PCDATA|meta|value)*>
  <!ATTLIST item key CDATA #IMPLIED>
  <!ELEMENT meta EMPTY>
  <!ATTLIST meta xmlns:p CDATA #IMPLIED p:flag (yes|no) "no">
  <!ELEMENT value (#PCDATA)>
  <!ENTITY nested "<value>expanded &amp; content</value>">
]>
<catalog>
  <section id="main">
    <item key="alpha"><meta xmlns:p="urn:test" p:flag="yes"/><value><![CDATA[x<y>&z]]></value></item>
    &nested;
  </section>
</catalog>