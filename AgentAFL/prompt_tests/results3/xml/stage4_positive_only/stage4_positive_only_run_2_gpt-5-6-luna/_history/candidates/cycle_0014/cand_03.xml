<?xml version="1.0" standalone="yes"?>
<!DOCTYPE report [
  <!ELEMENT report (header, section+)>
  <!ELEMENT header (name, period, generated-by)>
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT period EMPTY>
  <!ATTLIST period from CDATA #REQUIRED to CDATA #REQUIRED>
  <!ELEMENT generated-by (#PCDATA)>
  <!ELEMENT section (heading, paragraph*, table?)>
  <!ATTLIST section id ID #REQUIRED>
  <!ELEMENT heading (#PCDATA)>
  <!ELEMENT paragraph (#PCDATA|term|linebreak)*>
  <!ELEMENT term (#PCDATA)>
  <!ELEMENT linebreak EMPTY>
  <!ELEMENT table (columns, row+)>
  <!ELEMENT columns (column+)>
  <!ELEMENT column (#PCDATA)>
  <!ELEMENT row (cell+)>
  <!ELEMENT cell (#PCDATA)>
  <!ATTLIST cell emphasis (yes|no) "no">
]>
<report xmlns="urn:example:report" xmlns:meta="urn:example:metadata">
  <header>
    <name>Incident Review</name>
    <period from="2026-09-01" to="2026-09-23"/>
    <generated-by>automated-reviewer</generated-by>
  </header>
  <section id="summary">
    <heading>Summary</heading>
    <paragraph>The service recovered after a <term>configuration rollback</term>.<linebreak/>No data was lost.</paragraph>
  </section>
  <section id="metrics">
    <heading>Observed metrics</heading>
    <table>
      <columns>
        <column>Metric</column>
        <column>Before</column>
        <column>After</column>
      </columns>
      <row>
        <cell emphasis="yes">Error rate</cell>
        <cell>4.8%</cell>
        <cell>0.2%</cell>
      </row>
      <row>
        <cell>Recovery time</cell>
        <cell>—</cell>
        <cell>13m 42s</cell>
      </row>
    </table>
    <meta:reviewer id="r-42">platform-team</meta:reviewer>
  </section>
</report>