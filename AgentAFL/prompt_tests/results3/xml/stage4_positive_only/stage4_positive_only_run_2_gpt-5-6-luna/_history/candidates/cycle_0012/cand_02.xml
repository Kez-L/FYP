<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE invoice [
  <!ELEMENT invoice (seller, buyer, lines, totals, note?)>
  <!ELEMENT seller (company, address)>
  <!ELEMENT buyer (company, address)>
  <!ELEMENT company (#PCDATA)>
  <!ELEMENT address (street, city, country)>
  <!ELEMENT street (#PCDATA)>
  <!ELEMENT city (#PCDATA)>
  <!ELEMENT country (#PCDATA)>
  <!ELEMENT lines (line+)>
  <!ELEMENT line (item, quantity, unit-price, tax)>
  <!ATTLIST line number NMTOKEN #REQUIRED>
  <!ELEMENT item (#PCDATA)>
  <!ELEMENT quantity (#PCDATA)>
  <!ELEMENT unit-price (#PCDATA)>
  <!ELEMENT tax (#PCDATA)>
  <!ELEMENT totals (subtotal, tax-total, grand-total)>
  <!ELEMENT subtotal (#PCDATA)>
  <!ELEMENT tax-total (#PCDATA)>
  <!ELEMENT grand-total (#PCDATA)>
  <!ELEMENT note (#PCDATA)>
  <!ENTITY nbsp "&#160;">
]>
