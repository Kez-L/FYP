<?xml version="1.0" encoding="UTF-8"?>
<map xmlns="urn:geo:map" xmlns:g="urn:geo:geometry">
  <layer id="terrain" visible="1">
    <g:polygon winding="even-odd">
      <g:ring role="outer">
        <g:point x="-180.0000" y="90.0000"/>
        <g:point x="0" y="0"/>
        <g:point x="180.0000" y="-90.0000"/>
        <g:point x="-180.0000" y="90.0000"/>
      </g:ring>
      <g:ring role="inner">
        <g:point x="-1" y="-1"/>
        <g:point x="1" y="-1"/>
        <g:point x="1" y="1"/>
        <g:point x="-1" y="1"/>
        <g:point x="-1" y="-1"/>
      </g:ring>
    </g:polygon>
  </layer>
  <layer id="labels" visible="0">
    <label at="0,0">center &amp; origin</label>
  </layer>
</map>