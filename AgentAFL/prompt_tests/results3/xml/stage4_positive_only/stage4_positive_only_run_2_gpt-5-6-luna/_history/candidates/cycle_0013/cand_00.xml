<?xml version="1.0"?>
<!DOCTYPE catalog [
  <!ELEMENT catalog (section+)>
  <!ELEMENT section (heading, product*)>
  <!ATTLIST section code ID #REQUIRED>
  <!ELEMENT heading (#PCDATA)>
  <!ELEMENT product (name, price, availability, description?)>
  <!ATTLIST product sku ID #REQUIRED category CDATA #IMPLIED>
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT price (#PCDATA)>
  <!ELEMENT availability EMPTY>
  <!ATTLIST availability status (in-stock|backorder|discontinued) "in-stock">
  <!ELEMENT description (#PCDATA|em|br)*>
  <!ELEMENT em (#PCDATA)>
  <!ELEMENT br EMPTY>
  <!ENTITY currency "€">
]>
<catalog>
  <section code="hardware">
    <heading>Field equipment</heading>
    <product sku="p-001" category="sensor">
      <name>Thermal probe</name>
      <price>&currency; 48.50</price>
      <availability status="in-stock"/>
      <description>Compact <em>weatherproof</em> probe<br/>with replaceable tip.</description>
    </product>
    <product sku="p-002">
      <name>Signal meter</name>
      <price>&currency; 112.00</price>
      <availability status="backorder"/>
    </product>
  </section>
  <section code="software">
    <heading>Utilities</heading>
    <product sku="p-010" category="analysis">
      <name>Trace viewer</name>
      <price>&currency; 19.95</price>
      <availability status="discontinued"/>
      <description><![CDATA[Legacy viewer: <open> -> inspect -> close]]></description>
    </product>
  </section>
</catalog>