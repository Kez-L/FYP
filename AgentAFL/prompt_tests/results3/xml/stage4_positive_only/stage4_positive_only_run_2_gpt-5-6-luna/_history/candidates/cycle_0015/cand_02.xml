<?xml version="1.0"?>
<!DOCTYPE message [
  <!ELEMENT message (header, body, attachments?)>
  <!ELEMENT header (from, to+, subject, sent)>
  <!ELEMENT from (#PCDATA)>
  <!ELEMENT to (#PCDATA)>
  <!ELEMENT subject (#PCDATA)>
  <!ELEMENT sent (#PCDATA)>
  <!ELEMENT body (p|quote|list|table)+>
  <!ELEMENT p (#PCDATA|b|i|link|br)*>
  <!ELEMENT b (#PCDATA)>
  <!ELEMENT i (#PCDATA)>
  <!ELEMENT link (#PCDATA)>
  <!ATTLIST link href CDATA #REQUIRED>
  <!ELEMENT br EMPTY>
  <!ELEMENT quote (#PCDATA|p)*>
  <!ATTLIST quote author CDATA #IMPLIED>
  <!ELEMENT list (item+)>
  <!ATTLIST list ordered (yes|no) "no">
  <!ELEMENT item (#PCDATA|p)*>
  <!ELEMENT table (row+)>
  <!ELEMENT row (cell+)>
  <!ELEMENT cell (#PCDATA)>
  <!ELEMENT attachments (file+)>
  <!ELEMENT file EMPTY>
  <!ATTLIST file name CDATA #REQUIRED media CDATA #REQUIRED size NMTOKEN #IMPLIED>
]>
<message>
  <header>
    <from>planner@example.invalid</from>
    <to>team@example.invalid</to>
    <to>archive@example.invalid</to>
    <subject>Review &amp; approval</subject>
    <sent>2026-09-24T09:15:42+00:00</sent>
  </header>
  <body>
    <p>Please review the <b>revised</b> schedule before <i>Friday</i>.<br/>Comments are welcome.</p>
    <quote author="release-coordinator">
      <p>The deployment window remains unchanged.</p>
    </quote>
    <list ordered="yes">
      <item>Validate manifests</item>
      <item>Confirm rollback contact</item>
      <item><p>Publish the final notice</p></item>
    </list>
    <table>
      <row><cell>Region</cell><cell>Window</cell></row>
      <row><cell>East</cell><cell>02:00 UTC</cell></row>
      <row><cell>West</cell><cell>04:00 UTC</cell></row>
    </table>
  </body>
  <attachments>
    <file name="schedule.csv" media="text/csv" size="418"/>
    <file name="diagram.png" media="image/png"/>
  </attachments>
</message>