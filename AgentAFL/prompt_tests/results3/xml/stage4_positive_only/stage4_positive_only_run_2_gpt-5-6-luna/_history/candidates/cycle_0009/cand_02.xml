<?xml version="1.0"?>
<questionnaire xmlns="urn:example:survey" xml:lang="en">
  <?form revision="3"?>
  <introduction>
    <![CDATA[Please answer each question as accurately as possible.]]>
  </introduction>
  <section code="habits" required="true">
    <heading>Daily routines</heading>
    <question id="q1" type="choice">
      <prompt>Which transport do you use most often?</prompt>
      <option value="rail">Rail</option>
      <option value="cycle">Bicycle</option>
      <option value="walk">Walking</option>
      <option value="other">Other: <input name="transport-other"/></option>
    </question>
    <question id="q2" type="scale" min="1" max="5">
      <prompt>How predictable is your commute?</prompt>
      <labels>
        <low>Not predictable</low>
        <high>Highly predictable</high>
      </labels>
    </question>
  </section>
  <section code="comments" required="false">
    <heading>Additional remarks</heading>
    <question id="q3" type="multiline">
      <prompt>What would improve your journey?</prompt>
      <textarea rows="4" columns="60" placeholder="Optional response"/>
    </question>
  </section>
  <submission method="post" endpoint="https://example.invalid/submit">
    <token><![CDATA[questionnaire-token-7f3c]]></token>
    <consent>yes</consent>
  </submission>
</questionnaire>