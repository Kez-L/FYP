<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE catalog [
  <!ELEMENT catalog (metadata, category+)>
  <!ELEMENT metadata (title, generated, owner)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT generated (#PCDATA)>
  <!ELEMENT owner (#PCDATA)>
  <!ELEMENT category (label, item*)>
  <!ATTLIST category key NMTOKEN #REQUIRED>
  <!ELEMENT label (#PCDATA)>
  <!ELEMENT item (summary, price, availability, detail?)>
  <!ATTLIST item code ID #REQUIRED featured (yes|no) "no">
  <!ELEMENT summary (#PCDATA)>
  <!ELEMENT price (#PCDATA)>
  <!ATTLIST price currency NMTOKEN #REQUIRED>
  <!ELEMENT availability EMPTY>
  <!ATTLIST availability quantity CDATA #REQUIRED warehouse CDATA #IMPLIED>
  <!ELEMENT detail (#PCDATA|link|emphasis)*>
  <!ELEMENT link (#PCDATA)>
  <!ATTLIST link href URI #IMPLIED>
  <!ELEMENT emphasis (#PCDATA)>
  <!ENTITY vendor "North &amp; South Supply">
]>
