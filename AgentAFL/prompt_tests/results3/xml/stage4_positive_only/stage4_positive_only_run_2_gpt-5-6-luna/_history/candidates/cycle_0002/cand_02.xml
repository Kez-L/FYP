<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE messages [
  <!ELEMENT messages (message*)>
  <!ELEMENT message (from, to, body, attachment*)>
  <!ATTLIST message ref ID #REQUIRED priority CDATA "normal">
  <!ELEMENT from (#PCDATA)>
  <!ELEMENT to (#PCDATA)>
  <!ELEMENT body (#PCDATA|quote|br)*>
  <!ELEMENT quote (#PCDATA|quote)*>
  <!ELEMENT br EMPTY>
  <!ELEMENT attachment EMPTY>
  <!ATTLIST attachment name CDATA #REQUIRED type CDATA #IMPLIED>
]>
<messages>
  <message ref="m001" priority="urgent">
    <from>alice@example.test</from>
    <to>bob@example.test</to>
    <body>Hello<br/>please see <quote>the nested <quote>reply</quote></quote>.</body>
    <attachment name="report&amp;1.txt" type="text/plain"/>
  </message>
  <message ref="m002">
    <from><![CDATA[service]]></from>
    <to>ops@example.test</to>
    <body>Line one&#xA;Line two&#x9;end</body>
  </message>
</messages>