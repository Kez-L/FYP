<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE warehouse [
  <!ELEMENT warehouse (aisle+)>
  <!ELEMENT aisle (bin+)>
  <!ATTLIST aisle name CDATA #REQUIRED>
  <!ELEMENT bin (label, product*, note?)>
  <!ATTLIST bin position NMTOKEN #IMPLIED>
  <!ELEMENT label (#PCDATA)>
  <!ELEMENT product (#PCDATA)>
  <!ELEMENT note (#PCDATA)>
  <!ENTITY company "North &amp; South Logistics">
]>
<warehouse>
  <aisle name="A">
    <bin position="01">
      <label>Fragile &company;</label>
      <product>glassware</product>
      <product>ceramic</product>
    </bin>
    <bin position="02">
      <label>Oversized</label>
      <note>Handle with care.</note>
    </bin>
  </aisle>
  <aisle name="B">
    <bin>
      <label>Returns</label>
    </bin>
  </aisle>
</warehouse>