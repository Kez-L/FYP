<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE archive [
  <!ELEMENT archive (folder*)>
  <!ELEMENT folder (folder|document|link)*>
  <!ATTLIST folder name CDATA #REQUIRED>
  <!ELEMENT document (content)>
  <!ATTLIST document id ID #REQUIRED format CDATA #IMPLIED>
  <!ELEMENT content (#PCDATA)>
  <!ELEMENT link EMPTY>
  <!ATTLIST link target IDREF #REQUIRED kind (shortcut|alias) "alias">
  <!ENTITY intro "A&amp;B: &lt;sample&gt;">
  <!ENTITY quote "He said, &quot;store it safely.&quot;">
]>
<archive>
  <folder name="root">
    <document id="doc-1" format="text">
      <content>&intro; &#x0A; &quote;</content>
    </document>
    <folder name="nested">
      <document id="doc-2">
        <content>Line one&#x0D;&#x0A;Line two&#x09;with a tab.</content>
      </document>
      <link target="doc-1" kind="shortcut"/>
    </folder>
  </folder>
</archive>