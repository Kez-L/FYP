<?xml version="1.0" encoding="UTF-8"?>
<configuration xmlns:x="urn:example:config" xmlns:y="urn:example:extension">
  <x:defaults>
    <x:option name="retries" value="3"/>
    <x:option name="timeout" value="0"/>
  </x:defaults>
  <x:profiles>
    <x:profile name="minimal">
      <x:include href="defaults.xml"/>
      <y:feature enabled="true">
        <y:flag>safe-mode</y:flag>
        <y:flag><![CDATA[raw&unescaped]]></y:flag>
      </y:feature>
    </x:profile>
    <x:profile name="full">
      <x:include href="defaults.xml"/>
      <x:option name="cache" value="yes">
        <x:value>volatile</x:value>
      </x:option>
    </x:profile>
  </x:profiles>
  <x:plugins>
    <x:plugin id="alpha" class="core"/>
  </x:plugins>
</configuration>