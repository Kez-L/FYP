<?xml version="1.0"?>
<!DOCTYPE library [
  <!ELEMENT library (book*)>
  <!ELEMENT book (author+, synopsis)>
  <!ATTLIST book isbn CDATA #IMPLIED category (fiction|history|science) "fiction">
  <!ELEMENT author (#PCDATA)>
  <!ELEMENT synopsis (#PCDATA|em|strong)*>
  <!ELEMENT em (#PCDATA)>
  <!ELEMENT strong (#PCDATA)>
  <!ENTITY intro "A &lt;short&gt; description">
]>
<library>
  <book isbn="978-0" category="science">
    <author>R. Example</author>
    <author>J. Reader</author>
    <synopsis>&intro; with <em>nested</em> emphasis and <strong>bold</strong> terms.</synopsis>
  </book>
  <book category="history">
    <author>Unknown</author>
    <synopsis>Fragments, <em>dates</em>, and archival notes.</synopsis>
  </book>
</library>