<?xml version="1.0"?>
<r:workflow xmlns:r="urn:workflow" xmlns:p="urn:people" xmlns:xlink="http://www.w3.org/1999/xlink">
  <r:phase number="1">
    <r:task owner="p:alice" xlink:type="simple" xlink:href="#review">
      <r:description>Collect input</r:description>
      <r:checkpoint completed="false"/>
    </r:task>
  </r:phase>
  <r:phase number="2">
    <r:task owner="p:bob">
      <r:description><![CDATA[Review <draft> & approve]]></r:description>
      <r:dependency ref="collect"/>
      <r:checkpoint completed="true"/>
    </r:task>
  </r:phase>
  <p:directory>
    <p:person id="p:alice"><p:name>Alice</p:name></p:person>
    <p:person id="p:bob"><p:name>Bob</p:name></p:person>
  </p:directory>
</r:workflow>