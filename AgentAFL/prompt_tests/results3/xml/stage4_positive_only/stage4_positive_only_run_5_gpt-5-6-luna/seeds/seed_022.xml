<?xml version="1.0"?>
<!DOCTYPE message [
  <!ELEMENT message (header, body, attachment*)>
  <!ELEMENT header (sender, recipient, subject)>
  <!ELEMENT sender (#PCDATA)>
  <!ELEMENT recipient (#PCDATA)>
  <!ELEMENT subject (#PCDATA)>
  <!ELEMENT body (#PCDATA|strong|br)*>
  <!ELEMENT strong (#PCDATA)>
  <!ELEMENT br EMPTY>
  <!ELEMENT attachment EMPTY>
  <!ATTLIST attachment name CDATA #REQUIRED media CDATA #REQUIRED>
]>
<message>
  <header>
    <sender>ops@example.net</sender>
    <recipient>qa@example.net</recipient>
    <subject>Nightly report</subject>
  </header>
  <body>Results are <strong>available</strong>.<br/>Please review the attached summary.</body>
  <attachment name="summary.xml" media="application/xml"/>
</message>