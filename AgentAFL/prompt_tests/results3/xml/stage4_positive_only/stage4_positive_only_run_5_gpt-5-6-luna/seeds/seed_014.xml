<?xml version="1.0"?>
<!DOCTYPE archive [
  <!ELEMENT archive (folder+)>
  <!ELEMENT folder (folder|file|link)*>
  <!ATTLIST folder name CDATA #REQUIRED>
  <!ELEMENT file (#PCDATA)>
  <!ATTLIST file name CDATA #REQUIRED size CDATA #IMPLIED>
  <!ELEMENT link EMPTY>
  <!ATTLIST link name CDATA #REQUIRED target CDATA #REQUIRED>
  <!ENTITY nbsp "&#160;">
  <!ENTITY marker "A &amp; B">
]>
<archive>
  <folder name="root">
    <file name="readme.txt" size="18">alpha &marker; beta&nbsp;</file>
    <folder name="data">
      <file name="empty.bin" size="0"></file>
      <link name="latest" target="../incoming/item-07"/>
      <folder name="nested">
        <file name="notes.xml"><![CDATA[<not-a-document>]]></file>
      </folder>
    </folder>
  </folder>
  <folder name="lost+found">
    <link name="recovered" target="/archive/root/data/empty.bin"/>
  </folder>
</archive>