<?xml version="1.0"?>
<!DOCTYPE observatory [
  <!ELEMENT observatory (header, instrument+, log)>
  <!ELEMENT header (title, location)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT location EMPTY>
  <!ATTLIST location latitude CDATA #REQUIRED longitude CDATA #REQUIRED>
  <!ELEMENT instrument (name, calibration, reading*)>
  <!ATTLIST instrument id ID #REQUIRED status (online|offline|testing) "testing">
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT calibration (#PCDATA)>
  <!ELEMENT reading (#PCDATA)>
  <!ATTLIST reading unit CDATA #IMPLIED timestamp CDATA #IMPLIED>
  <!ELEMENT log (#PCDATA)>
]>
<observatory>
  <header>
    <title>Night Survey</title>
    <location latitude="51.4779" longitude="-0.0015"/>
  </header>
  <instrument id="scope-7" status="online">
    <name>Optical Array</name>
    <calibration>2026-09-30T22:10:00Z</calibration>
    <reading unit="nm" timestamp="22:11">486.2</reading>
    <reading unit="nm" timestamp="22:12">486.7</reading>
  </instrument>
  <instrument id="meter-2">
    <name>Radiometer</name>
    <calibration>reference &lt;zero&gt;</calibration>
  </instrument>
  <log>clear sky; intermittent wind</log>
</observatory>