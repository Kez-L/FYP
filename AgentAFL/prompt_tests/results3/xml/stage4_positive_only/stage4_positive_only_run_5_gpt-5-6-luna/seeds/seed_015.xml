    </item>
    <item ref="vise">
      <label>Bench vise</label>
      <price>84.00 &currency;</price>
    </item>
  </section>
  <section code="software">
    <heading>Utilities</heading>
    <item ref="parser" category="library">
      <label>Markup parser</label>
      <price>0.00 &currency;</price>
    </item>
  </section>
</catalog>