<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE catalog [
  <!ELEMENT catalog (section+)>
  <!ELEMENT section (heading, item*)>
  <!ATTLIST section code ID #REQUIRED>
  <!ELEMENT heading (#PCDATA)>
  <!ELEMENT item (label, price, note?)>
  <!ATTLIST item ref ID #REQUIRED category CDATA #IMPLIED>
  <!ELEMENT label (#PCDATA)>
  <!ELEMENT price (#PCDATA)>
  <!ELEMENT note (#PCDATA)>
  <!ENTITY currency "€">
  <!ENTITY company "Northwind &amp; Sons">
]>
<catalog>
