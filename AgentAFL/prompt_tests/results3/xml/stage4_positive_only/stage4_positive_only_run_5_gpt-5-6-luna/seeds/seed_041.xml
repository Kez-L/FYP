<?xml version="1.0"?>
<!DOCTYPE records [
  <!ELEMENT records (header, record*)>
  <!ELEMENT header (label, note?)>
  <!ELEMENT label (#PCDATA)>
  <!ELEMENT note (#PCDATA)>
  <!ELEMENT record (key, value, tag*)>
  <!ATTLIST record id ID #REQUIRED enabled (yes|no) "yes">
  <!ELEMENT key (#PCDATA)>
  <!ELEMENT value (#PCDATA|mark|br)*>
  <!ELEMENT mark (#PCDATA)>
  <!ELEMENT br EMPTY>
  <!ELEMENT tag (#PCDATA)>
  <!ATTLIST tag name NMTOKEN #REQUIRED>
  <!ENTITY fresh "<mark>new</mark>">
  <!ENTITY nbsp "&#160;">
]>
<records>
  <header>
    <label>Inventory</label>
    <note>Values may contain inline elements.</note>
  </header>
  <record id="r1">
    <key>alpha</key>
    <value>first &fresh;&nbsp;<br/>entry</value>
    <tag name="source">imported</tag>
  </record>
  <record id="r2" enabled="no">
    <key>beta</key>
    <value><![CDATA[raw <markup> & symbols]]></value>
    <tag name="source">manual</tag>
    <tag name="state">archived</tag>
  </record>
</records>