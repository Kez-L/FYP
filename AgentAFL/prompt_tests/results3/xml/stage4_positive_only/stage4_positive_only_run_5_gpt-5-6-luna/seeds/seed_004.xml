<?xml version="1.0"?>
<!DOCTYPE message [
  <!ELEMENT message (from, to, body)>
  <!ELEMENT from (#PCDATA)>
  <!ELEMENT to (#PCDATA)>
  <!ELEMENT body (#PCDATA|em|br)*>
  <!ELEMENT em (#PCDATA)>
  <!ELEMENT br EMPTY>
]>
<message>
  <from>sender</from>
  <to>receiver</to>
  <body>Hello <em>world</em><br/>after &apos;markup&apos;.</body>
</message>