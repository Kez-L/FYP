<?xml version="1.0"?>
<!DOCTYPE message [
  <!ELEMENT message (sender, recipients, subject, body, attachment*)>
  <!ELEMENT sender EMPTY>
  <!ATTLIST sender address CDATA #REQUIRED>
  <!ELEMENT recipients (recipient+)>
  <!ELEMENT recipient EMPTY>
  <!ATTLIST recipient address CDATA #REQUIRED kind (to|cc|bcc) "to">
  <!ELEMENT subject (#PCDATA)>
  <!ELEMENT body (#PCDATA|emphasis|quote|break)*>
  <!ELEMENT emphasis (#PCDATA)>
  <!ELEMENT quote (#PCDATA)>
  <!ELEMENT break EMPTY>
  <!ELEMENT attachment (#PCDATA)>
  <!ATTLIST attachment name CDATA #REQUIRED encoding CDATA #IMPLIED>
]>
<message>
  <sender address="robot@example.net"/>
  <recipients>
    <recipient address="alice@example.net"/>
    <recipient address="ops@example.net" kind="cc"/>
  </recipients>
  <subject>Maintenance &amp; status</subject>
  <body>
    Scheduled <emphasis>downtime</emphasis> begins at 03:00.
    <break/>
    <quote>Keep the service window open.</quote>
  </body>
  <attachment name="report.txt" encoding="base64">VGhlIHJlcG9ydA==</attachment>
</message>