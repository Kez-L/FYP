<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE messages [
  <!ELEMENT messages (message*)>
  <!ELEMENT message (from, to+, subject, body, attachment*)>
  <!ATTLIST message uid ID #REQUIRED priority NMTOKEN "normal">
  <!ELEMENT from EMPTY>
  <!ATTLIST from address CDATA #REQUIRED display CDATA #IMPLIED>
  <!ELEMENT to EMPTY>
  <!ATTLIST to address CDATA #REQUIRED>
  <!ELEMENT subject (#PCDATA)>
  <!ELEMENT body (#PCDATA|quote|list|br)*>
  <!ELEMENT quote (#PCDATA|quote)*>
  <!ELEMENT list (li+)>
  <!ELEMENT li (#PCDATA)>
  <!ELEMENT br EMPTY>
  <!ELEMENT attachment (name, bytes)>
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT bytes (#PCDATA)>
]>
<messages>
  <message uid="m-001" priority="high">
    <from address="sender@example.test" display="R&amp;D"/>
    <to address="one@example.test"/>
    <to address="two@example.test"/>
    <subject>Nested &lt;markup&gt; and text</subject>
    <body>
      Please review:
      <quote>the original <quote>quoted line</quote></quote>
      <list>
        <li>first</li>
        <li>second &amp; final</li>
      </list>
      <br/>
      Thanks.
    </body>
    <attachment>
      <name>notes.txt</name>
      <bytes>0</bytes>
    </attachment>
  </message>
</messages>