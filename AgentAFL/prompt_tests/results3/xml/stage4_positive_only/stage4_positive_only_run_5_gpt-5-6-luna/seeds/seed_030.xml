<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE catalog [
  <!ELEMENT catalog (section+)>
  <!ELEMENT section (name, item*)>
  <!ATTLIST section code ID #REQUIRED>
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT item (label, price, stock)>
  <!ATTLIST item ref ID #REQUIRED related IDREF #IMPLIED>
  <!ELEMENT label (#PCDATA)>
  <!ELEMENT price (#PCDATA)>
  <!ELEMENT stock (#PCDATA)>
]>
<catalog>
  <section code="tools">
    <name>Workshop Tools</name>
    <item ref="hammer">
      <label>Claw hammer</label>
      <price currency="USD">19.95</price>
      <stock>42</stock>
    </item>
    <item ref="mallet" related="hammer">
      <label>Wooden mallet</label>
      <price currency="USD">12.50</price>
      <stock>7</stock>
    </item>
  </section>
  <section code="supplies">
    <name>Consumables</name>
    <item ref="sandpaper" related="mallet">
      <label>Fine abrasive sheets</label>
      <price currency="USD">4.75</price>
      <stock>128</stock>
    </item>
  </section>
</catalog>