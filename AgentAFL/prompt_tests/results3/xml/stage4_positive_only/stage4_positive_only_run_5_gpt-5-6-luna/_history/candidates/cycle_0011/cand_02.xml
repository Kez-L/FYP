<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE glossary [
  <!ELEMENT glossary (section+)>
  <!ELEMENT section (term+)>
  <!ATTLIST section name CDATA #REQUIRED>
  <!ELEMENT term (definition, example?)>
  <!ATTLIST term code ID #REQUIRED>
  <!ELEMENT definition (#PCDATA|ref|em)*>
  <!ELEMENT example (#PCDATA)>
  <!ELEMENT ref EMPTY>
  <!ATTLIST ref target IDREF #REQUIRED>
  <!ELEMENT em (#PCDATA)>
  <!ENTITY product "parser">
]>
<glossary>
  <section name="syntax">
    <term code="t-xml">
      <definition>The &product; reads <em>well-formed</em> documents.</definition>
      <example>Use &lt;item&gt; rather than an unclosed tag.</example>
    </term>
    <term code="t-dtd">
      <definition>Declarations describe document structure.</definition>
      <example>Internal subsets are part of the prolog.</example>
    </term>
  </section>
  <section name="links">
    <term code="t-ref">
      <definition>Cross references can point to another term.</definition>
      <example><ref target="t-xml"/></example>
    </term>
  </section>
</glossary>