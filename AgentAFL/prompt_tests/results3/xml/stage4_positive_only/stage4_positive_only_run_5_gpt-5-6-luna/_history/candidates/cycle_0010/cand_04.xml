<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE archive [
  <!ELEMENT archive (record*)>
  <!ATTLIST archive created CDATA #IMPLIED>
  <!ELEMENT record (key, payload, history)>
  <!ATTLIST record id ID #REQUIRED state (new|open|closed) "new">
  <!ELEMENT key (#PCDATA)>
  <!ELEMENT payload (text|binary|empty)>
  <!ELEMENT text (#PCDATA)>
  <!ELEMENT binary (#PCDATA)>
  <!ELEMENT empty EMPTY>
  <!ELEMENT history (change*)>
  <!ELEMENT change (actor, details?)>
  <!ATTLIST change at CDATA #REQUIRED>
  <!ELEMENT actor (#PCDATA)>
  <!ELEMENT details (#PCDATA|linebreak)*>
  <!ELEMENT linebreak EMPTY>
  <!ENTITY nbsp "&#160;">
]>
<archive created="2026-10-01">
  <record id="r-001" state="open">
    <key>Résumé&nbsp;A</key>
    <payload>
      <text>Line one<linebreak/>Line two</text>
    </payload>
    <history>
      <change at="2026-09-30T23:59:59Z">
        <actor>α-team</actor>
        <details>Initial import<linebreak/>Validated checksum.</details>
      </change>
      <change at="2026-10-01T00:00:01Z">
        <actor>β-team</actor>
      </change>
    </history>
  </record>
  <record id="r-002">
    <key>Binary sample</key>
    <payload><binary>AAECAwQFBgcICQ==</binary></payload>
    <history/>
  </record>
</archive>