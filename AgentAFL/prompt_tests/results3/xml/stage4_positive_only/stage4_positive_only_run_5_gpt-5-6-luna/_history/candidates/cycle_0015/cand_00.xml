<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE catalog [
  <!ELEMENT catalog (entry+)>
  <!ATTLIST catalog edition NMTOKEN #IMPLIED>
  <!ELEMENT entry (key, metadata?, description, tags?, payload?)>
  <!ATTLIST entry code ID #REQUIRED status (draft|active|retired) "active">
  <!ELEMENT key (#PCDATA)>
  <!ELEMENT metadata (created, modified?)>
  <!ELEMENT created (#PCDATA)>
  <!ELEMENT modified (#PCDATA)>
  <!ELEMENT description (#PCDATA|emphasis|link)*>
  <!ELEMENT emphasis (#PCDATA)>
  <!ELEMENT link (#PCDATA)>
  <!ATTLIST link href URI #REQUIRED>
  <!ELEMENT tags (tag*)>
  <!ELEMENT tag (#PCDATA)>
  <!ELEMENT payload (#PCDATA|item)*>
  <!ELEMENT item (#PCDATA)>
  <!ATTLIST item name CDATA #REQUIRED>
]>
