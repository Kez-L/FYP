<?xml version="1.0"?>
<!DOCTYPE ledger [
  <!ELEMENT ledger (account+)>
  <!ATTLIST ledger currency CDATA "USD">
  <!ELEMENT account (owner, transaction*)>
  <!ATTLIST account number ID #REQUIRED status (open|closed) "open">
  <!ELEMENT owner (#PCDATA)>
  <!ELEMENT transaction (date, amount, note?)>
  <!ATTLIST transaction kind (credit|debit) #REQUIRED>
  <!ELEMENT date (#PCDATA)>
  <!ELEMENT amount (#PCDATA)>
  <!ELEMENT note (#PCDATA|emph)*>
  <!ELEMENT emph (#PCDATA)>
  <!ENTITY nbsp "&#160;">
  <!ENTITY company "North &amp; South">
]>
<ledger currency="GBP">
  <account number="acct-main" status="open">
    <owner>&company;&nbsp;Operations</owner>
    <transaction kind="credit">
      <date>2026-09-30</date>
      <amount>1000.00</amount>
      <note>Monthly <emph>allocation</emph>.</note>
    </transaction>
    <transaction kind="debit">
      <date>2026-10-01</date>
      <amount>12.50</amount>
      <note>Service charge</note>
    </transaction>
  </account>
</ledger>