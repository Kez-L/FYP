<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE message [
  <!ELEMENT message (header, payload)>
  <!ELEMENT header (sender, recipient, subject?, flag*)>
  <!ELEMENT sender (#PCDATA)>
  <!ELEMENT recipient (#PCDATA)>
  <!ELEMENT subject (#PCDATA)>
  <!ELEMENT flag EMPTY>
  <!ATTLIST flag name CDATA #REQUIRED>
  <!ELEMENT payload (paragraph|quote|list|code)+>
  <!ELEMENT paragraph (#PCDATA|strong|italic|br)*>
  <!ELEMENT strong (#PCDATA)>
  <!ELEMENT italic (#PCDATA)>
  <!ELEMENT br EMPTY>
  <!ELEMENT quote (#PCDATA)>
  <!ELEMENT list (item+)>
  <!ELEMENT item (#PCDATA)>
  <!ELEMENT code (#PCDATA)>
  <!ENTITY greeting "Hello">
  <!ENTITY mark "&#x2605;">
]>
<message>
  <header>
    <sender>robot@example.invalid</sender>
    <recipient>operator@example.invalid</recipient>
    <subject>&greeting;, &mark;</subject>
    <flag name="automated"/>
    <flag name="priority"/>
  </header>
  <payload>
    <paragraph>First <strong>important</strong> notice.<br/>Please read <italic>carefully</italic>.</paragraph>
    <quote>Errors are data in disguise.</quote>
    <list>
      <item>Inspect the input</item>
      <item>Record the result</item>
      <item>Repeat when necessary</item>
    </list>
    <code>if (value &lt; limit) return value;</code>
  </payload>
</message>