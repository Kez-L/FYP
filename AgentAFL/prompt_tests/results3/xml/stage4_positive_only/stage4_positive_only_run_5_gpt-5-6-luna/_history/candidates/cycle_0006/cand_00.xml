<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE archive [
  <!ELEMENT archive (metadata, entry+)>
  <!ELEMENT metadata (title, author, created)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT author (#PCDATA)>
  <!ELEMENT created (#PCDATA)>
  <!ELEMENT entry (summary, body, tag*)>
  <!ATTLIST entry key ID #REQUIRED status (draft|published|retired) "draft">
  <!ELEMENT summary (#PCDATA)>
  <!ELEMENT body (#PCDATA|emphasis|link|break)*>
  <!ELEMENT emphasis (#PCDATA)>
  <!ELEMENT link (#PCDATA)>
  <!ATTLIST link href CDATA #REQUIRED>
  <!ELEMENT break EMPTY>
  <!ELEMENT tag (#PCDATA)>
  <!ENTITY legal "All rights reserved.">
]>
<archive>
  <metadata>
    <title>Field Notes</title>
    <author>Ada Lovelace</author>
    <created>1843-10-01</created>
  </metadata>
  <entry key="note-1" status="published">
    <summary>Observations from the northern road</summary>
    <body>The weather was <emphasis>unusually clear</emphasis>.<break/>
      See <link href="https://example.invalid/route">the route map</link>.
      &legal;</body>
    <tag>travel</tag>
    <tag>weather</tag>
  </entry>
</archive>