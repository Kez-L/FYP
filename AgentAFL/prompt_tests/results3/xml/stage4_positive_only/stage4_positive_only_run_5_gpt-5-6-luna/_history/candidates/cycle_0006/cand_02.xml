<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE graph [
  <!ELEMENT graph (node*)>
  <!ELEMENT node (name, edge*)>
  <!ATTLIST node id ID #REQUIRED>
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT edge EMPTY>
  <!ATTLIST edge target IDREF #REQUIRED weight NMTOKEN #IMPLIED>
]>
<graph>
  <node id="a">
    <name>Alpha</name>
    <edge target="b" weight="1.5"/>
    <edge target="c"/>
  </node>
  <node id="b">
    <name>Beta &amp; friends</name>
    <edge target="a" weight="2"/>
  </node>
  <node id="c">
    <name><![CDATA[Gamma <delta>]]></name>
  </node>
</graph>