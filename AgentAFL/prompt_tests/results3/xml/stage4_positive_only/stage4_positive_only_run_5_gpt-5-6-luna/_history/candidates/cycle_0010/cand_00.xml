<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE report [
  <!ELEMENT report (header, entries, footer?)>
  <!ATTLIST report xml:lang NMTOKEN #IMPLIED generated CDATA #IMPLIED>
  <!ELEMENT header (title, timestamp)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT timestamp (#PCDATA)>
  <!ELEMENT entries (entry+)>
  <!ELEMENT entry (label, value, note?)>
  <!ATTLIST entry key ID #REQUIRED category NMTOKEN #IMPLIED>
  <!ELEMENT label (#PCDATA)>
  <!ELEMENT value (#PCDATA|strong|br)*>
  <!ELEMENT strong (#PCDATA)>
  <!ELEMENT br EMPTY>
  <!ELEMENT note (#PCDATA)>
  <!ELEMENT footer (#PCDATA)>
  <!ENTITY mark "&#x2022;">
]>
<report xml:lang="en" generated="2026-10-01">
  <header>
    <title>Diagnostic &amp; Inventory</title>
    <timestamp>2026-10-01T12:34:56Z</timestamp>
  </header>
  <entries>
    <entry key="cpu" category="hardware">
      <label>Processor</label>
      <value>64 <strong>logical</strong> units<br/>available</value>
      <note>&mark; measured during startup</note>
    </entry>
    <entry key="memory">
      <label>Memory</label>
      <value><![CDATA[16 <units> GiB]]></value>
    </entry>
  </entries>
  <footer>End of report.</footer>
</report>