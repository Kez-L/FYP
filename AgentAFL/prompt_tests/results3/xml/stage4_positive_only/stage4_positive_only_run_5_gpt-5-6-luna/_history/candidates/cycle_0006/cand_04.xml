<?xml version="1.0"?>
<!DOCTYPE timeline [
  <!ELEMENT timeline (event*)>
  <!ELEMENT event (when, location?, detail)>
  <!ATTLIST event kind CDATA #IMPLIED>
  <!ELEMENT when (#PCDATA)>
  <!ELEMENT location (city, coordinates)>
  <!ELEMENT city (#PCDATA)>
  <!ELEMENT coordinates (latitude, longitude)>
  <!ELEMENT latitude (#PCDATA)>
  <!ELEMENT longitude (#PCDATA)>
  <!ELEMENT detail (#PCDATA|list|item)*>
  <!ELEMENT list (item+)>
  <!ELEMENT item (#PCDATA)>
]>
<timeline>
  <event kind="arrival">
    <when>2026-10-01T09:30:00+02:00</when>
    <location>
      <city>Zürich</city>
      <coordinates>
        <latitude>47.3769</latitude>
        <longitude>8.5417</longitude>
      </coordinates>
    </location>
    <detail>Train delayed by <list><item>signal failure</item><item>heavy rain</item></list></detail>
  </event>
  <event kind="departure">
    <when>2026-10-02T18:45:00Z</when>
    <detail><![CDATA[<status>confirmed</status>]]> Platform 4</detail>
  </event>
</timeline>