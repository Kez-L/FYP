<?xml version="1.0" encoding="UTF-8"?>
<configuration xmlns="urn:config" xmlns:sec="urn:security">
  <!-- Settings intentionally combine empty and nested elements. -->
  <service name="indexer" enabled="true">
    <endpoint scheme="https" host="search.example.invalid" port="443"/>
    <limits>
      <memory unit="MiB">512</memory>
      <workers min="2" max="8"/>
    </limits>
    <paths>
      <path kind="input">/var/lib/data</path>
      <path kind="output">/var/cache/results</path>
    </paths>
  </service>
  <sec:credentials>
    <sec:token expires="2030-01-01T00:00:00Z">a&amp;b&lt;c</sec:token>
    <sec:permissions>
      <sec:allow action="read"/>
      <sec:allow action="write"/>
      <sec:deny action="delete"/>
    </sec:permissions>
  </sec:credentials>
</configuration>