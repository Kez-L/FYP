<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE catalog [
  <!ELEMENT catalog (section+)>
  <!ELEMENT section (heading, entry*)>
  <!ATTLIST section name CDATA #REQUIRED>
  <!ELEMENT heading (#PCDATA)>
  <!ELEMENT entry (name, description, price, metadata?)>
  <!ATTLIST entry sku ID #REQUIRED>
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT description (#PCDATA|em|link)*>
  <!ELEMENT em (#PCDATA)>
  <!ELEMENT link (#PCDATA)>
  <!ATTLIST link href CDATA #IMPLIED>
  <!ELEMENT price (#PCDATA)>
  <!ELEMENT metadata (property*)>
  <!ELEMENT property EMPTY>
  <!ATTLIST property key CDATA #REQUIRED value CDATA #IMPLIED>
]>
<catalog>
  <section name="hardware">
    <heading>Portable Tools</heading>
    <entry sku="tool-17">
      <name>Folding Compass</name>
      <description>Precision instrument with <em>engraved</em> markings and a <link href="urn:manual:compass">reference guide</link>.</description>
      <price currency="EUR">19.95</price>
      <metadata>
        <property key="weight" value="84g"/>
        <property key="waterproof" value="true"/>
      </metadata>
    </entry>
  </section>
</catalog>