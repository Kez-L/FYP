<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE archive [
  <!ELEMENT archive (header, records)>
  <!ELEMENT header (title, created, note?)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT created (#PCDATA)>
  <!ELEMENT note (#PCDATA)>
  <!ELEMENT records (record*)>
  <!ELEMENT record (key, value, tag*)>
  <!ATTLIST record uid ID #REQUIRED state (new|ready|closed) "new">
  <!ELEMENT key (#PCDATA)>
  <!ELEMENT value (#PCDATA|bold|code)*>
  <!ELEMENT tag (#PCDATA)>
  <!ELEMENT bold (#PCDATA)>
  <!ELEMENT code (#PCDATA)>
]>
<archive>
  <header>
    <title>Configuration archive</title>
    <created>2026-10-01T12:34:56Z</created>
    <note>Values may contain <bold>mixed</bold> markup.</note>
  </header>
  <records>
    <record uid="r1" state="ready">
      <key>timeout</key>
      <value>30 <code>seconds</code></value>
      <tag>network</tag>
      <tag>runtime</tag>
    </record>
    <record uid="r2">
      <key>message</key>
      <value>Hello &amp; goodbye</value>
    </record>
  </records>
</archive>