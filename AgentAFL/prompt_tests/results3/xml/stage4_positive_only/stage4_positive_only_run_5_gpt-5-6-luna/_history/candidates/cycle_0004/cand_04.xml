<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE dashboard [
  <!ELEMENT dashboard (widget*)>
  <!ELEMENT widget (title, script?, table?)>
  <!ATTLIST widget type CDATA #REQUIRED enabled (yes|no) "yes">
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT script (#PCDATA)>
  <!ELEMENT table (row*)>
  <!ELEMENT row (cell*)>
  <!ELEMENT cell (#PCDATA)>
  <!ENTITY nbsp "&#160;">
  <!ENTITY less "&#60;">
  <!ENTITY amp "&#38;">
]>
<dashboard>
  <widget type="chart" enabled="yes">
    <title>Temperature &amp; pressure</title>
    <script><![CDATA[
      if (value < 0) {
        return "freeze";
      }
    ]]></script>
    <table>
      <row><cell>time</cell><cell>value</cell></row>
      <row><cell>08:00</cell><cell>12.4&nbsp;°C</cell></row>
      <row><cell>12:00</cell><cell>&less;15 &amp; stable</cell></row>
    </table>
  </widget>
  <widget type="notice" enabled="no">
    <title>Maintenance &amp; calibration</title>
  </widget>
</dashboard>