<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE archive [
  <!ELEMENT archive (folder|document|alias)*>
  <!ATTLIST archive generated CDATA #IMPLIED>
  <!ELEMENT folder (label, (folder|document|alias)*)>
  <!ATTLIST folder id ID #REQUIRED>
  <!ELEMENT label (#PCDATA)>
  <!ELEMENT document (title, body)>
  <!ATTLIST document id ID #REQUIRED format (plain|markup) "plain">
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT body (#PCDATA|code|br)*>
  <!ELEMENT code (#PCDATA)>
  <!ELEMENT br EMPTY>
  <!ELEMENT alias EMPTY>
  <!ATTLIST alias ref IDREF #REQUIRED>
  <!ENTITY publisher "A&amp;B Research">
]>
<archive generated="2026-10-01">
  <folder id="root">
    <label>&publisher; records</label>
    <document id="doc-1" format="markup">
      <title>Conversion Notes</title>
      <body>Use <code>--strict</code> before the first <br/>validation pass.</body>
    </document>
    <folder id="nested">
      <label>Archived material</label>
      <document id="doc-2">
        <title>Empty Case</title>
        <body/>
      </document>
      <alias ref="doc-1"/>
    </folder>
  </folder>
</archive>