<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="report.xsl"?>
<!DOCTYPE report [
  <!ELEMENT report (metadata, records)>
  <!ELEMENT metadata (created, owner)>
  <!ELEMENT created (#PCDATA)>
  <!ELEMENT owner (#PCDATA)>
  <!ELEMENT records (record*)>
  <!ELEMENT record (value, description)>
  <!ATTLIST record id ID #REQUIRED refs IDREFS #IMPLIED>
  <!ELEMENT value (#PCDATA)>
  <!ELEMENT description (#PCDATA)>
]>
<report>
  <!-- Generated from the overnight import -->
  <metadata>
    <created>2026-10-01T01:02:03Z</created>
    <owner>analyst@example.invalid</owner>
  </metadata>
  <records>
    <record id="r1">
      <value>42</value>
      <description>Initial sample</description>
    </record>
    <record id="r2" refs="r1">
      <value>7.5</value>
      <description>Follow-up &lt;measurement&gt;</description>
    </record>
    <record id="r3" refs="r1 r2">
      <value>0</value>
      <description>zero-length baseline</description>
    </record>
  </records>
</report>