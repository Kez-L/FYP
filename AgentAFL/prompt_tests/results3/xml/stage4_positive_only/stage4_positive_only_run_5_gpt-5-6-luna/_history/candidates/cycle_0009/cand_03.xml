<?xml version="1.0"?>
<!DOCTYPE graph [
  <!ELEMENT graph (node+)>
  <!ATTLIST graph directed (true|false) "true">
  <!ELEMENT node (label, edge*)>
  <!ATTLIST node id ID #REQUIRED category CDATA #IMPLIED>
  <!ELEMENT label (#PCDATA)>
  <!ELEMENT edge EMPTY>
  <!ATTLIST edge to IDREF #REQUIRED weight CDATA "1">
  <!ENTITY arrow "&#x2192;">
  <!ENTITY quoted "&quot;quoted&quot;">
]>
<graph directed="false">
  <!-- Nodes can refer to one another by ID. -->
  <node id="a" category="entry">
    <label>Start &quoted;</label>
    <edge to="b" weight="0.5"/>
    <edge to="c"/>
  </node>
  <node id="b" category="middle">
    <label>Branch &arrow; left</label>
    <edge to="c" weight="2"/>
  </node>
  <node id="c" category="exit">
    <label><![CDATA[Finish: [complete]]]></label>
  </node>
</graph>