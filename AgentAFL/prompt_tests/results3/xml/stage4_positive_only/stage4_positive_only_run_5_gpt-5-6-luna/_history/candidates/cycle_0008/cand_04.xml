<?xml version="1.0" encoding="UTF-8"?>
<scene xmlns="http://www.w3.org/2000/svg"
       xmlns:xlink="http://www.w3.org/1999/xlink"
       viewBox="0 0 320 160">
  <title>Layered scene</title>
  <defs>
    <linearGradient id="fade" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#ffffff"/>
      <stop offset="100%" stop-color="#336699"/>
    </linearGradient>
    <path id="curve" d="M 10 120 C 80 20, 180 20, 250 120"/>
  </defs>
  <g id="background" opacity="0.8">
    <rect x="0" y="0" width="320" height="160" fill="url(#fade)"/>
    <circle cx="260" cy="35" r="18" fill="#ffd84d"/>
  </g>
  <g id="foreground" transform="translate(12,8)">
    <use xlink:href="#curve" fill="none" stroke="#102030" stroke-width="3"/>
    <text x="20" y="145" font-size="14">Vector &amp; XML</text>
    <foreignObject x="180" y="90" width="110" height="45">
      <html xmlns="http://www.w3.org/1999/xhtml">
        <body><p><b>embedded</b> text</p></body>
      </html>
    </foreignObject>
  </g>
  <script type="application/ecmascript"><![CDATA[
    function annotate(node) { return node.getAttribute("id") || "none"; }
  ]]></script>
</scene>