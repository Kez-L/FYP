<?xml version="1.0"?>
<!DOCTYPE packet [
  <!ELEMENT packet (meta?, body)>
  <!ELEMENT meta (field*)>
  <!ELEMENT field EMPTY>
  <!ATTLIST field name CDATA #REQUIRED value CDATA #IMPLIED>
  <!ELEMENT body (chunk+)>
  <!ELEMENT chunk (#PCDATA)>
  <!ATTLIST chunk seq CDATA #REQUIRED encoding (plain|base64) "plain">
]>
<packet>
  <meta>
    <field name="source" value="sensor-17"/>
    <field name="priority" value="high"/>
    <field name="empty"/>
  </meta>
  <body>
    <chunk seq="0001">temperature=21.5;humidity=48%</chunk>
    <chunk seq="0002" encoding="base64">SGVsbG8gWE1M</chunk>
    <chunk seq="0003"><![CDATA[
      binary-like: \x00 \x01 &lt;not markup&gt;
    ]]></chunk>
  </body>
</packet>