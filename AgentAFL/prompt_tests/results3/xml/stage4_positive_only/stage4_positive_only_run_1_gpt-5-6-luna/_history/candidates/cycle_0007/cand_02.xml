<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE formula [
  <!ELEMENT formula (name, variables, expression, examples)>
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT variables (variable*)>
  <!ELEMENT variable EMPTY>
  <!ATTLIST variable symbol ID #REQUIRED value CDATA #REQUIRED>
  <!ELEMENT expression (#PCDATA)>
  <!ELEMENT examples (example+)>
  <!ELEMENT example (input, output)>
  <!ELEMENT input (#PCDATA)>
  <!ELEMENT output (#PCDATA)>
]>
<formula>
  <name>Quadratic response</name>
  <variables>
    <variable symbol="a" value="1"/>
    <variable symbol="b" value="-3"/>
    <variable symbol="c" value="2"/>
  </variables>
  <expression>a*x^2 + b*x + c</expression>
  <examples>
    <example>
      <input>x = 1</input>
      <output>0</output>
    </example>
    <example>
      <input>x = 4</input>
      <output>6</output>
    </example>
  </examples>
</formula>