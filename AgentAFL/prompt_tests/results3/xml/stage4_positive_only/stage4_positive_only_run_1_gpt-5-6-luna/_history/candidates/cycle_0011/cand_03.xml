<?xml version="1.0" encoding="ISO-8859-1"?>
<!DOCTYPE registry [
  <!ELEMENT registry (entry+, index)>
  <!ELEMENT entry (label, description, link*)>
  <!ATTLIST entry id ID #REQUIRED category (alpha|beta|deprecated) "alpha">
  <!ELEMENT label (#PCDATA)>
  <!ELEMENT description (#PCDATA|code|emph)*>
  <!ELEMENT code (#PCDATA)>
  <!ELEMENT emph (#PCDATA)>
  <!ELEMENT link EMPTY>
  <!ATTLIST link target IDREF #REQUIRED relation CDATA #IMPLIED>
  <!ELEMENT index (pointer+)>
  <!ELEMENT pointer EMPTY>
  <!ATTLIST pointer ref IDREF #REQUIRED>
  <!ENTITY trademark "©">
]>
<registry>
  <entry id="r1" category="alpha">
    <label>Quartz parser</label>
    <description>Fast <emph>streaming</emph> reader for <code>qz</code> records &trademark;.</description>
    <link target="r2" relation="successor"/>
  </entry>
  <entry id="r2" category="beta">
    <label>Quartz writer</label>
    <description>Produces escaped values such as &lt;token&gt; and preserves mixed text.</description>
    <link target="r1" relation="companion"/>
    <link target="r3" relation="related"/>
  </entry>
  <entry id="r3" category="deprecated">
    <label>Legacy bridge</label>
    <description><code>qz-0</code> compatibility adapter.</description>
  </entry>
  <index>
    <pointer ref="r3"/>
    <pointer ref="r1"/>
    <pointer ref="r2"/>
  </index>
</registry>