        <metadata>
          <published>2024</published>
          <pages>384</pages>
        </metadata>
        <summary><![CDATA[An orchard grows beneath the city, where every fruit remembers a different century.]]></summary>
      </book>
    </shelf>
    <shelf>
      <label>Lower West</label>
      <book available="no">
        <title>Salt Compass</title>
        <author>O. N. Reyes</author>
        <summary>North is a story people tell themselves.</summary>
      </book>
    </shelf>
  </section>
  <section code="reference">
