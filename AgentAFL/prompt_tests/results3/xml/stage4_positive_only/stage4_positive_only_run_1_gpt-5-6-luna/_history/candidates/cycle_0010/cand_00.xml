<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE library [
  <!ELEMENT library (section+)>
  <!ATTLIST library version CDATA #IMPLIED>
  <!ELEMENT section (title, shelf+)>
  <!ATTLIST section code ID #REQUIRED>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT shelf (label, book*)>
  <!ELEMENT label (#PCDATA)>
  <!ELEMENT book (title, author+, metadata?, summary?)>
  <!ATTLIST book isbn CDATA #IMPLIED available (yes|no) "yes">
  <!ELEMENT author (#PCDATA)>
  <!ELEMENT metadata (published, pages)>
  <!ELEMENT published (#PCDATA)>
  <!ELEMENT pages (#PCDATA)>
  <!ELEMENT summary (#PCDATA)>
]>
<library version="7">
