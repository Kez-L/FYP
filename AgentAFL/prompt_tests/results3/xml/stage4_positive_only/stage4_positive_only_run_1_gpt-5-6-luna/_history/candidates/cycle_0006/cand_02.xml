<?xml version="1.0"?>
<!DOCTYPE inventory [
  <!ELEMENT inventory (warehouse+)>
  <!ELEMENT warehouse (section+)>
  <!ATTLIST warehouse code NMTOKEN #REQUIRED>
  <!ELEMENT section (bin*)>
  <!ATTLIST section name CDATA #IMPLIED>
  <!ELEMENT bin (item+)>
  <!ATTLIST bin label ID #IMPLIED>
  <!ELEMENT item (description, quantity, cost)>
  <!ATTLIST item code NMTOKEN #REQUIRED state (new|used|hold) "new">
  <!ELEMENT description (#PCDATA)>
  <!ELEMENT quantity (#PCDATA)>
  <!ELEMENT cost (#PCDATA)>
  <!ENTITY copper "Cu">
  <!ENTITY euro "&#x20AC;">
  <!ENTITY notice "Handle &copper; components carefully.">
]>
<inventory>
  <warehouse code="north">
    <section name="fasteners">
      <bin label="bin-a">
        <item code="SC-01">
          <description>Machine screw &notice;</description>
          <quantity>00000017</quantity>
          <cost>12.50 &euro;</cost>
        </item>
        <item code="SC-02" state="used">
          <description>Washer</description>
          <quantity>4</quantity>
          <cost>0.08 &euro;</cost>
        </item>
      </bin>
    </section>
  </warehouse>
  <warehouse code="south">
    <section name="cables">
      <bin label="bin-z">
        <item code="CB-99" state="hold">
          <description>Shielded cable</description>
          <quantity>2</quantity>
          <cost>18 &euro;</cost>
        </item>
      </bin>
    </section>
  </warehouse>
</inventory>