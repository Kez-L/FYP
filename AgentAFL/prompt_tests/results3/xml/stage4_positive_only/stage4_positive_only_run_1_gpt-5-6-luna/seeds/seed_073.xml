<?xml version="1.0"?>
<geometry xmlns="urn:example:geometry">
  <scene background="#102030">
    <transform matrix="1 0 0 0 1 0 0 0 1">
      <group label="wireframe">
        <polyline closed="false">
          <point x="-1.5" y="0" z="2"/>
          <point x="0" y="3.14159" z="2"/>
          <point x="1.5" y="0" z="2"/>
        </polyline>
        <polygon material="glass">
          <vertex>
            <position x="0" y="0" z="0"/>
            <normal x="0" y="0" z="1"/>
            <texcoord u="0" v="0"/>
          </vertex>
          <vertex>
            <position x="4" y="0" z="0"/>
            <normal x="0" y="0" z="1"/>
            <texcoord u="1" v="0"/>
          </vertex>
          <vertex>
            <position x="4" y="4" z="0"/>
            <normal x="0" y="0" z="1"/>
            <texcoord u="1" v="1"/>
          </vertex>
        </polygon>
      </group>
    </transform>
    <camera projection="perspective">
      <position x="0" y="2" z="8"/>
      <look-at x="0" y="1" z="0"/>
    </camera>
  </scene>
  <metadata>
    <title>Triangle &amp; Frame</title>
    <description><![CDATA[Vertices are supplied in counter-clockwise order.]]></description>
  </metadata>
</geometry>