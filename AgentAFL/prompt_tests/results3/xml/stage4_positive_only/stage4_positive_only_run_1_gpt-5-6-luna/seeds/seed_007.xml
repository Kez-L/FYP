<?xml version="1.0"?>
<!DOCTYPE library [
  <!ENTITY % itemDecl "<!ELEMENT item (title, author+, summary?)>">
  %itemDecl;
  <!ELEMENT library (shelf+)>
  <!ATTLIST library generated CDATA "yes">
  <!ELEMENT shelf (label, item*)>
  <!ATTLIST shelf code ID #REQUIRED>
  <!ELEMENT label (#PCDATA)>
  <!ELEMENT title (#PCDATA|emph)*>
  <!ELEMENT author (#PCDATA)>
  <!ELEMENT summary (#PCDATA|emph|link)*>
  <!ELEMENT emph (#PCDATA)>
  <!ELEMENT link EMPTY>
  <!ATTLIST link target NMTOKEN #REQUIRED>
  <!ENTITY copyright "&#169; 2026">
]>
