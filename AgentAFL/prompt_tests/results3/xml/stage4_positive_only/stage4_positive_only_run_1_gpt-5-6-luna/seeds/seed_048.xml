<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE drawing [
  <!ELEMENT drawing (layer+)>
  <!ELEMENT layer (item+)>
  <!ATTLIST layer name CDATA #REQUIRED visible (true|false) "true">
  <!ELEMENT item (geometry, style?)>
  <!ATTLIST item kind (path|circle|text|group) #REQUIRED>
  <!ELEMENT geometry (point*, segment*, radius?, content?)>
  <!ELEMENT point EMPTY>
  <!ATTLIST point x CDATA #REQUIRED y CDATA #REQUIRED>
  <!ELEMENT segment EMPTY>
  <!ATTLIST segment from CDATA #REQUIRED to CDATA #REQUIRED>
  <!ELEMENT radius (#PCDATA)>
  <!ELEMENT content (#PCDATA)>
  <!ELEMENT style (fill?, stroke?, opacity?)>
  <!ELEMENT fill (#PCDATA)>
  <!ELEMENT stroke (#PCDATA)>
  <!ELEMENT opacity (#PCDATA)>
]>
<drawing>
  <layer name="background">
    <item kind="circle">
      <geometry>
        <point x="256" y="256"/>
        <radius>240</radius>
      </geometry>
      <style>
        <fill>#102030</fill>
        <stroke>#405060</stroke>
        <opacity>0.92</opacity>
      </style>
    </item>
  </layer>
  <layer name="constellation" visible="true">
    <item kind="path">
      <geometry>
        <point x="44" y="88"/>
        <point x="119" y="173"/>
        <point x="201" y="121"/>
        <segment from="p1" to="p2"/>
        <segment from="p2" to="p3"/>
      </geometry>
      <style>
        <stroke><![CDATA[rgba(255, 220, 120, .8)]]></stroke>
      </style>
    </item>
    <item kind="text">
      <geometry>
        <point x="212" y="116"/>
        <content>Orion Δ</content>
      </geometry>
    </item>
  </layer>
</drawing>