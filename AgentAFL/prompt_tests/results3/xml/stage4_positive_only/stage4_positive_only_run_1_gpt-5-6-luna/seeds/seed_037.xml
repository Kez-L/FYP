<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE archive [
  <!ELEMENT archive (entry*)>
  <!ELEMENT entry (key, value, tags?, payload)>
  <!ATTLIST entry id ID #REQUIRED kind CDATA #IMPLIED>
  <!ELEMENT key (#PCDATA)>
  <!ELEMENT value (#PCDATA)>
  <!ELEMENT tags (tag*)>
  <!ELEMENT tag (#PCDATA)>
  <!ELEMENT payload ANY>
]>
<archive>
  <entry id="e0" kind="empty">
    <key></key>
    <value/>
    <payload/>
  </entry>
  <entry id="e1" kind="mixed">
    <key>line&#x0A;break&#x09;tab</key>
    <value>5 &lt; 9 &amp;&amp; 9 &gt; 5</value>
    <tags>
      <tag>one</tag>
      <tag>two</tag>
      <tag><![CDATA[three & four]]></tag>
    </tags>
    <payload>
      <!-- nested commentary -->
      <chunk index="0"><![CDATA[raw <bytes> & markers]]></chunk>
      <chunk index="1">text before <inner attr="&quot;quoted&quot;">Ω</inner> text after</chunk>
    </payload>
  </entry>
  <entry id="e2">
    <key>surrogate-like text: &#x1F4A9;</key>
    <value>   surrounding whitespace   </value>
    <payload><?inside data?><item a="1" b="2"/></payload>
  </entry>
</archive>