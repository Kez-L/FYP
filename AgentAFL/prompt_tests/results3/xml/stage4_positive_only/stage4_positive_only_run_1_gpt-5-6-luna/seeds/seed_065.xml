  <!ELEMENT title (#PCDATA)>
  <!ELEMENT item (label, price, details?)>
  <!ATTLIST item sku ID #REQUIRED status (active|retired) "active">
  <!ELEMENT label (#PCDATA)>
  <!ELEMENT price (#PCDATA)>
  <!ELEMENT details (#PCDATA|note|br)*>
  <!ELEMENT note (#PCDATA)>
  <!ELEMENT br EMPTY>
  <!ENTITY currency "€">
]>
