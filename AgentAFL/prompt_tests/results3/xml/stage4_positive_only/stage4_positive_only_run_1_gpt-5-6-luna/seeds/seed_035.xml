<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE library [
  <!ELEMENT library (shelf+)>
  <!ELEMENT shelf (book*)>
  <!ATTLIST shelf code NMTOKEN #REQUIRED>
  <!ELEMENT book (title, author+, metadata?, summary)>
  <!ATTLIST book isbn CDATA #IMPLIED available (yes|no) "yes">
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT author (#PCDATA)>
  <!ELEMENT metadata (published, pages)>
  <!ELEMENT published (#PCDATA)>
  <!ELEMENT pages (#PCDATA)>
  <!ELEMENT summary (#PCDATA|emphasis|link)*>
  <!ELEMENT emphasis (#PCDATA)>
  <!ELEMENT link (#PCDATA)>
]>
<library>
  <shelf code="A-01">
    <book isbn="978-0000000001" available="yes">
      <title>The Glass Archive</title>
      <author>R. Ilyan</author>
      <author>M. Chen</author>
      <metadata>
        <published>2024-02-29</published>
        <pages>417</pages>
      </metadata>
      <summary>A record of <emphasis>fragmented</emphasis> memories and <link>unreliable maps</link>.</summary>
    </book>
  </shelf>
  <shelf code="rare">
    <book isbn="X&amp;Y&lt;7">
      <title><![CDATA[Signals & Symbols]]></title>
      <author>Élodie Nør</author>
      <summary>Stored below <emphasis>zero</emphasis> degrees.</summary>
    </book>
  </shelf>
</library>