<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE notebook [
  <!ELEMENT notebook (chapter+)>
  <!ATTLIST notebook xml:lang NMTOKEN #IMPLIED>
  <!ELEMENT chapter (heading, block+)>
  <!ATTLIST chapter number CDATA #REQUIRED>
  <!ELEMENT heading (#PCDATA)>
  <!ELEMENT block (para|list|quote|code)>
  <!ELEMENT para (#PCDATA|ref|br)*>
  <!ELEMENT ref (#PCDATA)>
  <!ATTLIST ref target IDREF #REQUIRED>
  <!ELEMENT br EMPTY>
  <!ELEMENT list (entry+)>
  <!ELEMENT entry (para)>
  <!ELEMENT quote (#PCDATA)>
  <!ELEMENT code (#PCDATA)>
]>
<notebook xml:lang="en">
  <chapter number="I">
    <heading>Small Machines</heading>
    <block>
      <para>A <ref target="motor">motor</ref> turns, pauses<br/>and turns again.</para>
    </block>
    <block>
      <list>
        <entry><para>Measure the axle.</para></entry>
        <entry><para>Mark the center.</para></entry>
      </list>
    </block>
    <block>
      <quote>Motion is a kind of memory.</quote>
    </block>
    <block>
      <code>for (step = 0; step &lt; 4; step++) { tick(); }</code>
    </block>
  </chapter>
  <chapter number="II">
    <heading>References</heading>
    <block><para id="motor">The index is deliberately compact.</para></block>
  </chapter>
</notebook>