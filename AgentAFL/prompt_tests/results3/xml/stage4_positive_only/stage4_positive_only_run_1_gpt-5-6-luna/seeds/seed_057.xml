<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE scene [
  <!ELEMENT scene (setting, actor*, action+)>
  <!ELEMENT setting (location, weather)>
  <!ELEMENT location (#PCDATA)>
  <!ELEMENT weather (#PCDATA)>
  <!ELEMENT actor (name, prop*)>
  <!ATTLIST actor code ID #REQUIRED>
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT prop (#PCDATA)>
  <!ELEMENT action (actor-ref, dialogue?, movement?, sound*)>
  <!ATTLIST action number CDATA #REQUIRED>
  <!ELEMENT actor-ref EMPTY>
  <!ATTLIST actor-ref code IDREF #REQUIRED>
  <!ELEMENT dialogue (#PCDATA|pause)*>
  <!ELEMENT pause EMPTY>
  <!ELEMENT movement (#PCDATA)>
  <!ELEMENT sound (#PCDATA)>
]>
<scene>
  <setting>
    <location>Station platform at dawn</location>
    <weather>Thin fog; intermittent rain</weather>
  </setting>
  <actor code="conductor">
    <name>Conductor Vale</name>
    <prop>brass watch</prop>
    <prop>folded timetable</prop>
  </actor>
  <actor code="traveler">
    <name>The Traveler</name>
    <prop>canvas case</prop>
  </actor>
  <action number="1">
    <actor-ref code="conductor"/>
    <movement>Checks the watch twice and looks toward the tunnel.</movement>
    <sound>clang</sound>
  </action>
  <action number="2">
    <actor-ref code="traveler"/>
    <dialogue>Is this the last departure?<pause/>I was told there would be another.</dialogue>
    <movement>Places the case beside the bench.</movement>
  </action>
  <action number="3">
    <actor-ref code="conductor"/>
    <dialogue>There is always another schedule.</dialogue>
    <sound><![CDATA[whistle: low, rising, abruptly cut]]></sound>
  </action>
</scene>