<?xml version="1.0"?>
<!DOCTYPE matrix [
  <!ELEMENT matrix (row+)>
  <!ELEMENT row (cell+)>
  <!ELEMENT cell EMPTY>
  <!ATTLIST row index NMTOKEN #REQUIRED>
  <!ATTLIST cell
    col NMTOKEN #REQUIRED
    value CDATA #IMPLIED
    selected (yes|no) "no">
]>
<matrix>
  <row index="01">
    <cell col="A" value="&quot;one&quot;" selected="yes"/>
    <cell col="B"/>
  </row>
  <row index="02">
    <cell col="A" value="two&#x0A;lines"/>
    <cell col="B" selected="no"/>
    <cell col="C" value="three"/>
  </row>
</matrix>