<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE scene [
  <!ELEMENT scene (metadata, layer+)>
  <!ELEMENT metadata (title, author?, keywords?)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT author (#PCDATA)>
  <!ELEMENT keywords (keyword*)>
  <!ELEMENT keyword (#PCDATA)>
  <!ELEMENT layer (group|shape|text)*>
  <!ATTLIST layer name CDATA #REQUIRED opacity CDATA "1.0">
  <!ELEMENT group (group|shape|text)*>
  <!ATTLIST group id ID #IMPLIED transform CDATA #IMPLIED>
  <!ELEMENT shape EMPTY>
  <!ATTLIST shape kind (circle|rect|path) #REQUIRED x CDATA #IMPLIED y CDATA #IMPLIED>
  <!ELEMENT text (#PCDATA)>
  <!ATTLIST text x CDATA #REQUIRED y CDATA #REQUIRED>
]>
<scene xmlns="urn:example:graphics" version="2.4">
  <metadata>
    <title>Night Garden</title>
    <author>Élodie &amp; Ren</author>
    <keywords>
      <keyword>luminous</keyword>
      <keyword>vector</keyword>
      <keyword>quiet</keyword>
    </keywords>
  </metadata>
  <layer name="background" opacity="0.85">
    <shape kind="rect" x="0" y="0"/>
    <group id="constellation" transform="rotate(3)">
      <shape kind="circle" x="12.5" y="8.25"/>
      <shape kind="path" x="18" y="11"/>
      <text x="4" y="22">north &lt; east</text>
    </group>
  </layer>
</scene>