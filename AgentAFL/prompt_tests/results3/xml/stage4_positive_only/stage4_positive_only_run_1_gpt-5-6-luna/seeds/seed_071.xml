<?xml version="1.0"?>
<!DOCTYPE inventory [
  <!ELEMENT inventory (warehouse*)>
  <!ELEMENT warehouse (address, bin+)>
  <!ATTLIST warehouse name CDATA #REQUIRED>
  <!ELEMENT address (street, city, region?, postal)>
  <!ELEMENT street (#PCDATA)>
  <!ELEMENT city (#PCDATA)>
  <!ELEMENT region (#PCDATA)>
  <!ELEMENT postal (#PCDATA)>
  <!ELEMENT bin (product*)>
  <!ATTLIST bin code CDATA #REQUIRED>
  <!ELEMENT product (description, quantity, dimensions?)>
  <!ATTLIST product code CDATA #REQUIRED fragile (yes|no) "no">
  <!ELEMENT description (#PCDATA)>
  <!ELEMENT quantity (#PCDATA)>
  <!ELEMENT dimensions (width, height, depth)>
  <!ELEMENT width (#PCDATA)>
  <!ELEMENT height (#PCDATA)>
  <!ELEMENT depth (#PCDATA)>
  <!ENTITY warehouse-note "Handle according to local storage policy.">
]>
<inventory>
  <warehouse name="North Depot">
    <address>
      <street>18 Meridian Way</street>
      <city>Riverside</city>
      <region>West</region>
      <postal>R4 8QZ</postal>
    </address>
    <bin code="A-01">
      <product code="cable-9" fragile="yes">
        <description>Shielded cable spool</description>
        <quantity>42</quantity>
        <dimensions>
          <width>30</width>
          <height>30</height>
          <depth>18</depth>
        </dimensions>
      </product>
    </bin>
    <bin code="B-17">
      <product code="washer-2">
        <description>Steel washers &warehouse-note;</description>
        <quantity>900</quantity>
      </product>
    </bin>
  </warehouse>
</inventory>