<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE archive [
  <!ELEMENT archive (folder*)>
  <!ELEMENT folder (name, item*)>
  <!ATTLIST folder path CDATA #IMPLIED>
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT item (label, checksum?, metadata)>
  <!ATTLIST item key ID #REQUIRED kind CDATA "file">
  <!ELEMENT label (#PCDATA)>
  <!ELEMENT checksum (#PCDATA)>
  <!ELEMENT metadata (property*)>
  <!ELEMENT property EMPTY>
  <!ATTLIST property name CDATA #REQUIRED value CDATA #IMPLIED>
]>
<archive>
  <folder path="/var/lib">
    <name>state</name>
    <item key="f1" kind="config">
      <label>settings.ini</label>
      <checksum>sha256:7f83b165</checksum>
      <metadata>
        <property name="mode" value="0644"/>
        <property name="owner" value="service"/>
      </metadata>
    </item>
    <item key="f2">
      <label>empty.log</label>
      <metadata/>
    </item>
  </folder>
  <folder>
    <name>temporary</name>
  </folder>
</archive>