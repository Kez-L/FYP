<?xml version="1.0" encoding="UTF-8"?>
<scene xmlns="urn:example:scene" xmlns:geo="urn:example:geo" version="2.1">
  <viewport width="1280" height="720" unit="px">
    <background color="#101820" opacity="0.95"/>
    <layer name="foreground" z="10">
      <shape id="star" kind="polygon">
        <geo:point x="10.5" y="4.25"/>
        <geo:point x="18" y="22"/>
        <geo:point x="2" y="11"/>
        <geo:point x="18" y="11"/>
        <geo:point x="2" y="22"/>
      </shape>
      <transform target="star">
        <translate dx="12" dy="-3"/>
        <rotate degrees="45" origin="center"/>
        <scale x="1.25" y="0.75"/>
      </transform>
      <label for="star" align="center">A &lt;bright&gt; point</label>
    </layer>
    <layer name="background" z="0" hidden="yes">
      <image href="textures/grid.png">
        <crop left="0" top="0" right="512" bottom="512"/>
      </image>
    </layer>
  </viewport>
  <metadata>
    <geo:location latitude="51.4779" longitude="-0.0015">
      <geo:altitude unit="m">46</geo:altitude>
    </geo:location>
  </metadata>
</scene>