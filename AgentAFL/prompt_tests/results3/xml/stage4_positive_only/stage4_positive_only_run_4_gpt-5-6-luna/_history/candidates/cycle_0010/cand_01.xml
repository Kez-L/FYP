<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE canvas [
  <!ELEMENT canvas (layer*)>
  <!ELEMENT layer (shape*)>
  <!ELEMENT shape EMPTY>
  <!ATTLIST canvas width CDATA #REQUIRED height CDATA #REQUIRED>
  <!ATTLIST layer name CDATA #IMPLIED visible (yes|no) "yes">
  <!ATTLIST shape type (line|circle|path) #REQUIRED>
  <!ATTLIST shape x CDATA #IMPLIED y CDATA #IMPLIED data CDATA #IMPLIED>
  <!ATTLIST shape stroke CDATA #IMPLIED>
]>
<canvas width="640" height="480">
  <layer name="background">
    <shape type="path" data="M0 0 H640 V480 H0 Z" stroke="#000000"/>
  </layer>
  <layer name="guides" visible="no">
    <shape type="line" x="0" y="0" data="640,480"/>
    <shape type="circle" x="320" y="240" y="0" stroke="none"/>
  </layer>
  <layer>
    <shape type="path" data="M10&#x9;20&#xA;L30 40 &amp; 50"/>
  </layer>
</canvas>