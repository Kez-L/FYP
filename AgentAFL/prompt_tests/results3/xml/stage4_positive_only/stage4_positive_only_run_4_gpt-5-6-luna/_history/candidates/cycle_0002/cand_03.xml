<?xml version="1.0"?>
<!DOCTYPE ledger [
  <!ELEMENT ledger (account+)>
  <!ELEMENT account (identity, opening, entry*, closing)>
  <!ATTLIST account number CDATA #REQUIRED currency NMTOKEN "EUR">
  <!ELEMENT identity (name, contact?)>
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT contact (email|phone)+>
  <!ELEMENT email (#PCDATA)>
  <!ELEMENT phone (#PCDATA)>
  <!ELEMENT opening (#PCDATA)>
  <!ELEMENT entry (date, debit?, credit?, memo?)>
  <!ATTLIST entry ref ID #REQUIRED reconciled (yes|no) "no">
  <!ELEMENT date (#PCDATA)>
  <!ELEMENT debit (#PCDATA)>
  <!ELEMENT credit (#PCDATA)>
  <!ELEMENT memo (#PCDATA)>
  <!ELEMENT closing (#PCDATA)>
]>
<ledger>
  <account number="A-009" currency="GBP">
    <identity>
      <name>R&amp;D &quot;Reserve&quot;</name>
      <contact>
        <email>finance@example.invalid</email>
        <phone>+44-000-1234</phone>
      </contact>
    </identity>
    <opening>1000.00</opening>
    <entry ref="r1" reconciled="yes">
      <date>2026-01-03</date>
      <credit>250.00</credit>
      <memo>Refund for damaged equipment.</memo>
    </entry>
    <entry ref="r2">
      <date>2026-01-04</date>
      <debit>17.5</debit>
      <memo>Stationery &#x26; labels</memo>
    </entry>
    <entry ref="r3" reconciled="no">
      <date>2026-01-05</date>
      <credit>0</credit>
    </entry>
    <closing>1232.50</closing>
  </account>
</ledger>