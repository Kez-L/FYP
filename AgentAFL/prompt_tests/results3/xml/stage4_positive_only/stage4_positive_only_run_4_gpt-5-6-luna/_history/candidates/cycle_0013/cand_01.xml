<?xml version="1.0"?>
<!DOCTYPE drawing [
  <!ELEMENT drawing (layer+)>
  <!ELEMENT layer (shape+)>
  <!ELEMENT shape (geometry, paint?, label?)>
  <!ELEMENT geometry EMPTY>
  <!ELEMENT paint (fill?, stroke?)>
  <!ELEMENT fill (#PCDATA)>
  <!ELEMENT stroke (#PCDATA)>
  <!ELEMENT label (#PCDATA|linebreak)*>
  <!ELEMENT linebreak EMPTY>
  <!ATTLIST drawing width NMTOKEN #REQUIRED height NMTOKEN #REQUIRED>
  <!ATTLIST layer name CDATA #REQUIRED visible (yes|no) "yes">
  <!ATTLIST shape id ID #REQUIRED kind (rect|circle|path|text) #REQUIRED>
  <!ATTLIST geometry x CDATA #IMPLIED y CDATA #IMPLIED w CDATA #IMPLIED h CDATA #IMPLIED d CDATA #IMPLIED>
  <!ATTLIST paint opacity CDATA "1.0">
  <!ENTITY star "&#9733;">
]>
<drawing width="640" height="480">
  <layer name="background" visible="yes">
    <shape id="s0" kind="rect">
      <geometry x="0" y="0" w="640" h="480"/>
      <paint opacity="0.25">
        <fill>#101820</fill>
        <stroke>#000000</stroke>
      </paint>
    </shape>
  </layer>
  <layer name="foreground">
    <shape id="s1" kind="path">
      <geometry d="M 10,20 C 30,40 50,10 80,25 Z"/>
      <paint>
        <fill><![CDATA[url(#gradient-1)]]></fill>
      </paint>
      <label>curve <linebreak/> &star; sample</label>
    </shape>
    <shape id="s2" kind="text">
      <geometry x="24" y="96"/>
      <label>Text containing &lt;angles&gt; and &amp; symbols</label>
    </shape>
  </layer>
</drawing>