<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE dashboard [
  <!ELEMENT dashboard (widget*)>
  <!ELEMENT widget (config, data)>
  <!ELEMENT config EMPTY>
  <!ELEMENT data (row*)>
  <!ELEMENT row (cell+)>
  <!ELEMENT cell (#PCDATA|value)*>
  <!ELEMENT value (#PCDATA)>
  <!ATTLIST dashboard generated CDATA #IMPLIED>
  <!ATTLIST widget id ID #REQUIRED type (chart|table|status) #REQUIRED>
  <!ATTLIST config refresh CDATA #IMPLIED theme CDATA "light">
  <!ATTLIST row key CDATA #IMPLIED>
  <!ATTLIST cell colspan CDATA "1" role CDATA #IMPLIED>
  <!ENTITY nbsp "&#160;">
  <!ENTITY quoted "&quot;quoted&quot;">
]>
<dashboard generated="2026-10-01T14:22:09Z">
  <widget id="w-chart" type="chart">
    <config refresh="15s" theme="dark"/>
    <data>
      <row key="jan">
        <cell role="label">January</cell>
        <cell colspan="2"><value>17</value> &nbsp;</cell>
      </row>
      <row key="feb">
        <cell role="label">February</cell>
        <cell><value>23</value></cell>
        <cell><value>19</value></cell>
      </row>
    </data>
  </widget>
  <widget id="w-status" type="status">
    <config theme="contrast"/>
    <data>
      <row>
        <cell role="message">System is &quoted;</cell>
      </row>
    </data>
  </widget>
  <widget id="w-empty" type="table">
    <config/>
    <data/>
  </widget>
</dashboard>