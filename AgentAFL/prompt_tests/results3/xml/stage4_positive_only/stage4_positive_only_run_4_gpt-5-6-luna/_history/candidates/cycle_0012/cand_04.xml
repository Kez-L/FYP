<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE geometry [
  <!ELEMENT geometry (shape*)>
  <!ELEMENT shape (point+)>
  <!ELEMENT point EMPTY>
  <!ATTLIST shape kind (line|polygon|path) #REQUIRED>
  <!ATTLIST point x CDATA #REQUIRED y CDATA #REQUIRED>
  <!ENTITY nbsp "&#160;">
]>
<geometry>
  <shape kind="line">
    <point x="0" y="0"/>
    <point x="10" y="20"/>
  </shape>
  <shape kind="polygon">
    <point x="-1.5" y="2.75"/>
    <point x="3" y="4"/>
    <point x="0" y="-9"/>
  </shape>
  <shape kind="path">
    <point x="NaN" y="INF"/>
  </shape>
  <description>Measurements&nbsp;complete</description>
</geometry>