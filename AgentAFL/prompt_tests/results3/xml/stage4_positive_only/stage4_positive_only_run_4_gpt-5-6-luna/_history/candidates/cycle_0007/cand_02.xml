<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE node [
  <!ENTITY % declarations '
    <!ELEMENT node (branch|leaf|text)*>
    <!ELEMENT branch (node*)>
    <!ELEMENT leaf EMPTY>
    <!ELEMENT text (#PCDATA)>
    <!ATTLIST branch id ID #IMPLIED>
    <!ATTLIST leaf value CDATA #REQUIRED>
  '>
  %declarations;
]>
<node>
  <branch id="root">
    <branch id="left">
      <leaf value="A"/>
      <text>between</text>
      <branch>
        <leaf value="B&amp;C"/>
      </branch>
    </branch>
    <branch id="right">
      <text>mixed <![CDATA[raw <content>]]> tail</text>
      <leaf value="&#x1F642;"/>
    </branch>
  </branch>
</node>