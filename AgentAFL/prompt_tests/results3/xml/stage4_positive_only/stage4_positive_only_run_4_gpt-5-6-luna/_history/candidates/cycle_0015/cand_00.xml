<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE library [
  <!ELEMENT library (section+)>
  <!ELEMENT section (title, book*)>
  <!ATTLIST section id ID #REQUIRED>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT book (name, author+, summary?)>
  <!ATTLIST book isbn CDATA #REQUIRED available (true|false) "true">
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT author (#PCDATA)>
  <!ELEMENT summary (#PCDATA)>
]>
<library>
  <section id="fiction">
    <title>Fiction</title>
    <book isbn="978-1-4028-9462-6">
      <name>The Glass Harbor</name>
      <author>Mira Vale</author>
      <author>Jonas Reed</author>
      <summary>A quiet mystery beneath a changing tide.</summary>
    </book>
  </section>
  <section id="reference">
    <title>Reference</title>
    <book isbn="978-0-395-19395-8" available="false">
      <name>Atlas of Small Places</name>
      <author>R. K. Stone</author>
    </book>
  </section>
</library>