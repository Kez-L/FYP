<?xml version="1.0"?>
<configuration>
  <profile name="staging">
    <endpoint>
      <protocol>https</protocol>
      <host>api.example.invalid</host>
      <port>8443</port>
      <path>/v2/events</path>
    </endpoint>
    <credentials>
      <token><![CDATA[abc<def>&ghi]]></token>
      <rotation days="30"/>
    </credentials>
    <features>
      <feature key="audit" enabled="1"/>
      <feature key="compression" enabled="0"/>
      <feature key="retries" enabled="1">
        <limit>5</limit>
      </feature>
    </features>
  </profile>
  <profile name="offline">
    <endpoint>
      <protocol>file</protocol>
      <path>/var/tmp/archive</path>
    </endpoint>
    <features/>
  </profile>
</configuration>