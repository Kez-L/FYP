<?xml version="1.1" encoding="UTF-8"?>
<!DOCTYPE catalog [
  <!ELEMENT catalog (section+)>
  <!ELEMENT section (heading, item*)>
  <!ELEMENT heading (#PCDATA)>
  <!ELEMENT item (label, price, tags?)>
  <!ELEMENT label (#PCDATA)>
  <!ELEMENT price (#PCDATA)>
  <!ELEMENT tags (tag+)>
  <!ELEMENT tag (#PCDATA)>
  <!ATTLIST item sku ID #IMPLIED currency CDATA "EUR">
]>
<catalog>
  <section>
    <heading>Oddments</heading>
    <item sku="p-01">
      <label>Glass &quot;orb&quot;</label>
      <price>12.50</price>
      <tags>
        <tag>fragile</tag>
        <tag>round</tag>
      </tags>
    </item>
    <item currency="JPY">
      <label>折り紙</label>
      <price>¥800</price>
    </item>
  </section>
</catalog>