<?xml version="1.0" encoding="UTF-8"?>
<collection xmlns="urn:math:worksheet" xmlns:m="http://www.w3.org/1998/Math/MathML"
            xml:base="https://example.invalid/worksheets/">
  <worksheet id="w-α" difficulty="mixed">
    <heading xml:lang="el">Ακολουθίες</heading>
    <problem number="1">
      <prompt>Find the limit of the following expression.</prompt>
      <m:math display="block">
        <m:mrow>
          <m:munder>
            <m:mo>lim</m:mo>
            <m:mrow><m:mi>n</m:mi><m:mo>→</m:mo><m:mi>∞</m:mi></m:mrow>
          </m:munder>
          <m:mfrac>
            <m:mrow><m:mi>n</m:mi><m:mo>+</m:mo><m:mn>1</m:mn></m:mrow>
            <m:mrow><m:mn>2</m:mn><m:mi>n</m:mi><m:mo>−</m:mo><m:mn>3</m:mn></m:mrow>
          </m:mfrac>
        </m:mrow>
      </m:math>
      <answer format="decimal" tolerance="0.001">0.5</answer>
    </problem>
    <problem number="2" status="review">
      <prompt>Choose every value satisfying the constraint.</prompt>
      <choices>
        <choice selected="false">−1</choice>
        <choice selected="true">0</choice>
        <choice selected="true">π</choice>
        <choice selected="false">∞</choice>
      </choices>
      <note>Symbols are preserved as Unicode: ≤ ≥ ≠.</note>
    </problem>
  </worksheet>
</collection>