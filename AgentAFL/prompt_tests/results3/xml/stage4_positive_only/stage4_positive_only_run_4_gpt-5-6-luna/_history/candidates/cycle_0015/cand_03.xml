  <!ELEMENT metrics (metric+)>
  <!ELEMENT metric EMPTY>
  <!ATTLIST metric name CDATA #REQUIRED value CDATA #REQUIRED unit CDATA #IMPLIED>
  <!ELEMENT note (#PCDATA)>
]>
