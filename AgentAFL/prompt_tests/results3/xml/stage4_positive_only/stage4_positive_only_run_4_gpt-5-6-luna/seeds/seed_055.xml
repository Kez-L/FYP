<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE map [
  <!ELEMENT map (continent*)>
  <!ELEMENT continent (country+)>
  <!ELEMENT country (city*, note?)>
  <!ELEMENT city (#PCDATA)>
  <!ELEMENT note (#PCDATA)>
  <!ATTLIST continent label CDATA #REQUIRED>
  <!ATTLIST country iso NMTOKEN #IMPLIED>
  <!ENTITY mark "&#x2605;">
]>
<map>
  <continent label="north">
    <country iso="NO">
      <city>Oslo</city>
      <city>Bergen</city>
      <note>Harbor &mark; district</note>
    </country>
    <country iso="IS">
      <city>Reykjavik</city>
    </country>
  </continent>
  <continent label="south"/>
</map>