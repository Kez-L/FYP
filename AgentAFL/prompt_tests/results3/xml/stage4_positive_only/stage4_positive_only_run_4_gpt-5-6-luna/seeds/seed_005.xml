<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE archive [
  <!ELEMENT archive (metadata, folder+)>
  <!ELEMENT metadata (created, owner, checksum)>
  <!ELEMENT created (#PCDATA)>
  <!ELEMENT owner EMPTY>
  <!ATTLIST owner name CDATA #REQUIRED team CDATA #IMPLIED>
  <!ELEMENT checksum (#PCDATA)>
  <!ELEMENT folder (folder|document|link)*>
  <!ATTLIST folder path CDATA #REQUIRED hidden (yes|no) "no">
  <!ELEMENT document (heading, paragraph+, tag*)>
  <!ATTLIST document id ID #REQUIRED format (text|binary|unknown) "text">
  <!ELEMENT heading (#PCDATA)>
  <!ELEMENT paragraph (#PCDATA|code|quote|br)*>
  <!ELEMENT code (#PCDATA)>
  <!ELEMENT quote (#PCDATA|code)*>
  <!ELEMENT br EMPTY>
  <!ELEMENT tag (#PCDATA)>
  <!ELEMENT link EMPTY>
  <!ATTLIST link target IDREF #REQUIRED relation CDATA #IMPLIED>
]>
<archive>
  <metadata>
    <created>2026-09-30T23:59:59Z</created>
    <owner name="Ada" team="systems"/>
    <checksum>sha256:00ff11aa</checksum>
  </metadata>
  <folder path="/" hidden="no">
    <folder path="/manuals" hidden="yes">
      <document id="d1" format="text">
        <heading>Migration Notes</heading>
        <paragraph>Move the <code>cache</code> directory first.<br/>Then verify the <quote>read-only</quote> marker.</paragraph>
        <tag>maintenance</tag>
      </document>
    </folder>
    <link target="d1" relation="references"/>
  </folder>
</archive>