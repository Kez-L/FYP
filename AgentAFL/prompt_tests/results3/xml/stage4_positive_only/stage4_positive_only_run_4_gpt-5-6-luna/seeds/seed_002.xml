<!DOCTYPE root [
  <!ELEMENT root (branch|leaf)*>
  <!ELEMENT branch (branch|leaf)*>
  <!ELEMENT leaf EMPTY>
  <!ATTLIST leaf key NMTOKEN #IMPLIED>
]>
<root xmlns:p="urn:p">
  <branch>
    <leaf key="a"/>
    <branch>
      <leaf p:key="b" xmlns:p="urn:shadow"/>
      <branch/>
    </branch>
  </branch>
  <leaf key="c"/>
</root>