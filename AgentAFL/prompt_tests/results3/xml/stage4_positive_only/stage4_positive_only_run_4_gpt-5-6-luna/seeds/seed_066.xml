<?xml version="1.0"?>
<!DOCTYPE message [
  <!ELEMENT message (from, to, subject, body, attachment*)>
  <!ELEMENT from (#PCDATA)>
  <!ELEMENT to (#PCDATA)>
  <!ELEMENT subject (#PCDATA)>
  <!ELEMENT body (#PCDATA|paragraph|quote|list)*>
  <!ELEMENT paragraph (#PCDATA|emphasis|break)*>
  <!ELEMENT quote (#PCDATA|paragraph)*>
  <!ELEMENT list (entry+)>
  <!ELEMENT entry (#PCDATA|link)*>
  <!ELEMENT emphasis (#PCDATA)>
  <!ELEMENT break EMPTY>
  <!ELEMENT attachment EMPTY>
  <!ELEMENT link (#PCDATA)>
  <!ATTLIST message id ID #REQUIRED priority CDATA "normal">
  <!ATTLIST attachment name CDATA #REQUIRED media CDATA #IMPLIED>
  <!ENTITY signature "— automated archive">
]>
<message id="m-204" priority="urgent">
  <from>robot@example.invalid</from>
  <to>reader@example.invalid</to>
  <subject>Nested content &amp; status</subject>
  <body>
    Introductory text.
    <paragraph>First <emphasis>important</emphasis> paragraph<break/>continues.</paragraph>
    <quote>
      <paragraph>Quoted material with &lt;escaped&gt; boundaries.</paragraph>
      <paragraph>Second quote &signature;</paragraph>
    </quote>
    <list>
      <entry>One</entry>
      <entry>Two <link>https://example.invalid/two</link></entry>
    </list>
    Final text.
  </body>
  <attachment name="report.txt" media="text/plain"/>
</message>