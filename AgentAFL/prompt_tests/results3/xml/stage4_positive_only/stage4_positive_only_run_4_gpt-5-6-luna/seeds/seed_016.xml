<?xml version="1.0"?>
<dashboard xmlns="urn:dashboard:v2" xmlns:cfg="urn:config">
  <cfg:options cfg:revision="17" enabled="true">
    <cfg:option name="refresh" value="00:00:30"/>
    <cfg:option name="theme" value="dark"/>
  </cfg:options>
  <widgets>
    <widget id="clock" visible="yes">
      <position x="0" y="0"/>
      <data>
        <text>UTC</text>
        <format>HH:mm:ss</format>
      </data>
    </widget>
    <widget id="graph" visible="no">
      <position x="-4" y="12"/>
      <data>
        <series name="temperature">
          <point t="2026-09-30T23:59:59Z" v="-12.5"/>
          <point t="2026-10-01T00:00:00Z" v="0"/>
        </series>
      </data>
    </widget>
  </widgets>
</dashboard>