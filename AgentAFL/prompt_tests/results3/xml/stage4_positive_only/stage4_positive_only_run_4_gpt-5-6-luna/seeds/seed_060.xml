<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE catalog [
  <!ELEMENT catalog (header, collection+)>
  <!ELEMENT header (title, generated, summary?)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT generated (#PCDATA)>
  <!ELEMENT summary (#PCDATA)>
  <!ELEMENT collection (item+)>
  <!ELEMENT item (name, description, metadata, link*)>
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT description (#PCDATA|code|strong|em)*>
  <!ELEMENT code (#PCDATA)>
  <!ELEMENT strong (#PCDATA)>
  <!ELEMENT em (#PCDATA)>
  <!ELEMENT metadata (tag*)>
  <!ELEMENT tag EMPTY>
  <!ELEMENT link (#PCDATA)>
  <!ATTLIST catalog xmlns CDATA #IMPLIED xmlns:meta CDATA #IMPLIED>
  <!ATTLIST item id ID #REQUIRED status (draft|published|retired) "draft">
  <!ATTLIST tag key CDATA #REQUIRED value CDATA #IMPLIED>
  <!ATTLIST link rel CDATA #REQUIRED href CDATA #REQUIRED>
  <!ENTITY product "parser">
]>
<catalog xmlns="urn:example:catalog" xmlns:meta="urn:example:metadata">
  <?index priority="high"?>
  <!-- The collection contains deliberately mixed textual content. -->
  <header>
    <title>Compatibility &amp; &product; notes</title>
    <generated>2026-10-01T14:07:03Z</generated>
    <summary><![CDATA[Input containing <literal> markup and ]] characters.]]></summary>
  </header>
  <collection>
    <item id="entry-1" status="published">
      <name>Boundary cases</name>
      <description>Preserve <strong>all</strong> <em>delimiters</em> around <code>&lt;tokens&gt;</code>.</description>
      <metadata>
        <tag key="owner" value="qa"/>
        <tag key="priority" value="3"/>
      </metadata>
      <link rel="self" href="urn:item:entry-1">record</link>
    </item>
    <item id="entry-2">
      <name>CDATA sample</name>
      <description><![CDATA[alpha & beta < gamma > delta]]></description>
      <metadata>
        <tag key="format"/>
      </metadata>
    </item>
  </collection>
</catalog>