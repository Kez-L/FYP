<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE dossier [
  <!ELEMENT dossier (case, evidence, decision)>
  <!ELEMENT case (number, subject, aliases?)>
  <!ELEMENT number (#PCDATA)>
  <!ELEMENT subject (#PCDATA)>
  <!ELEMENT aliases (alias+)>
  <!ELEMENT alias (#PCDATA)>
  <!ELEMENT evidence (artifact*)>
  <!ELEMENT artifact (name, digest, content?)>
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT digest (#PCDATA)>
  <!ELEMENT content (#PCDATA)>
  <!ELEMENT decision (status, reason)>
  <!ELEMENT status (#PCDATA)>
  <!ELEMENT reason (#PCDATA)>
  <!ATTLIST artifact kind (text|binary|image) "text">
  <!ATTLIST artifact ref ID #IMPLIED>
  <!ATTLIST evidence primary IDREF #IMPLIED>
  <!ENTITY office "Records &amp; Review">
  <!ENTITY note "classified material">
]>
<dossier>
  <case>
    <number>XZ-2048-77</number>
    <subject>Unusual &quot;signal&quot; report</subject>
    <aliases>
      <alias>blue lantern</alias>
      <alias>night parcel</alias>
    </aliases>
  </case>
  <evidence primary="a2">
    <artifact kind="text" ref="a1">
      <name>field-note.txt</name>
      <digest algorithm="sha256">00112233445566778899aabbccddeeff</digest>
      <content>Observed near &entity;: <![CDATA[<pulse rate="slow"/>]]></content>
    </artifact>
    <artifact kind="image" ref="a2">
      <name>frame-009.png</name>
      <digest algorithm="sha256">ffeeddccbbaa99887766554433221100</digest>
    </artifact>
  </evidence>
  <decision>
    <status>pending</status>
    <reason>Awaiting review by &office;.</reason>
  </decision>
</dossier>