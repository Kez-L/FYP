<?xml version="1.0"?>
<!DOCTYPE registry [
  <!ELEMENT registry (entry+)>
  <!ELEMENT entry (key, value, history?)>
  <!ELEMENT key (#PCDATA)>
  <!ELEMENT value (scalar|array|object|nil)>
  <!ELEMENT scalar (#PCDATA)>
  <!ELEMENT array (scalar|array|object|nil)*>
  <!ELEMENT object (property*)>
  <!ELEMENT property (key, value)>
  <!ELEMENT nil EMPTY>
  <!ELEMENT history (change+)>
  <!ELEMENT change (#PCDATA)>
  <!ATTLIST entry name CDATA #REQUIRED readonly (true|false) "false">
  <!ATTLIST scalar type (string|integer|boolean|decimal) "string">
  <!ATTLIST change when CDATA #REQUIRED by CDATA #IMPLIED>
]>
