<?xml version="1.0"?>
<!DOCTYPE drawing [
  <!ELEMENT drawing (layer+)>
  <!ELEMENT layer (group|path|text|use)*>
  <!ATTLIST layer id ID #REQUIRED opacity CDATA "1">
  <!ELEMENT group (group|path|text|use)*>
  <!ATTLIST group transform CDATA #IMPLIED>
  <!ELEMENT path EMPTY>
  <!ATTLIST path d CDATA #REQUIRED fill CDATA #IMPLIED stroke CDATA #IMPLIED>
  <!ELEMENT text (#PCDATA)>
  <!ATTLIST text x CDATA #REQUIRED y CDATA #REQUIRED>
  <!ELEMENT use EMPTY>
  <!ATTLIST use ref IDREF #REQUIRED>
]>
<drawing width="640" height="480" viewBox="0 0 640 480">
  <layer id="background" opacity="0.25">
    <path d="M0,0 L640,0 L640,480 L0,480 Z" fill="#102030"/>
  </layer>
  <layer id="foreground">
    <group transform="translate(12.5,-4) rotate(7)">
      <path d="M10 20 C 40 0, 80 0, 110 20 S 180 40, 210 20" stroke="url(#gradient)" fill="none"/>
      <text x="24" y="96">caf&#xE9; &amp; tea</text>
    </group>
    <use ref="background"/>
  </layer>
</drawing>