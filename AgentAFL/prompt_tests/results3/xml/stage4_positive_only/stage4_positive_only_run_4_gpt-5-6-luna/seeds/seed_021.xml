<?xml version="1.0"?>
<!DOCTYPE report [
  <!ELEMENT report (section+)>
  <!ELEMENT section (heading, entry*)>
  <!ATTLIST section code NMTOKEN #REQUIRED>
  <!ELEMENT heading (#PCDATA)>
  <!ELEMENT entry (#PCDATA | note)*>
  <!ELEMENT note (#PCDATA)>
  <!ATTLIST note level (low|normal|high) "normal">
]>
<report>
  <section code="A1">
    <heading>Observations</heading>
    <entry>First result <note level="high">requires review</note> before release.</entry>
    <entry>Second result contains an embedded <note>annotation</note> and trailing text.</entry>
  </section>
  <section code="B-2">
    <heading>Empty section</heading>
  </section>
  <section code="C3">
    <heading>Escaped values</heading>
    <entry><![CDATA[raw <text> with ]]> characters]]></entry>
  </section>
</report>