<?xml version="1.1"?>
<!DOCTYPE message [
  <!ENTITY greeting "Hello">
  <!ENTITY who "world">
  <!ENTITY phrase "&greeting;, &who;!">
]>
<message xmlns="urn:message" xmlns:x="urn:extra">
  <header x:priority="high">
    <subject>&phrase;</subject>
  </header>
  <body xml:space="preserve">
    <![CDATA[
      line one
      ]]> 
    <part kind="text">alpha&#x0A;beta</part>
    <!-- a comment containing -- must not be split -->
    <part kind="empty"/>
  </body>
</message>