<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE telemetry [
  <!ELEMENT telemetry (device, readings)>
  <!ELEMENT device (model, firmware)>
  <!ELEMENT model (#PCDATA)>
  <!ELEMENT firmware (#PCDATA)>
  <!ELEMENT readings (reading*)>
  <!ELEMENT reading (timestamp, value, note?)>
  <!ELEMENT timestamp (#PCDATA)>
  <!ELEMENT value (#PCDATA)>
  <!ELEMENT note (#PCDATA)>
  <!ATTLIST reading channel NMTOKEN #REQUIRED unit CDATA #IMPLIED>
  <!ENTITY nbsp "&#160;">
]>
<telemetry>
  <device>
    <model>µSense/2</model>
    <firmware>0.0.0-beta</firmware>
  </device>
  <readings>
    <reading channel="temp" unit="°C">
      <timestamp>2026-09-30T23:59:59.999999Z</timestamp>
      <value>-273.1500000001</value>
      <note>below expected&nbsp;range</note>
    </reading>
    <reading channel="pressure" unit="kPa">
      <timestamp>not-a-date</timestamp>
      <value>NaN</value>
      <note><![CDATA[raw: </reading> & <tag>]]></note>
    </reading>
    <reading channel="counter">
      <timestamp></timestamp>
      <value>18446744073709551616</value>
    </reading>
  </readings>
</telemetry>