<?xml version="1.0"?>
<!DOCTYPE package [
  <!ELEMENT package (header, payload, footer)>
  <!ELEMENT header (entry+)>
  <!ELEMENT entry EMPTY>
  <!ATTLIST entry name NMTOKEN #REQUIRED value CDATA #IMPLIED>
  <!ELEMENT payload (section+)>
  <!ELEMENT section (heading, body)>
  <!ATTLIST section code ID #REQUIRED>
  <!ELEMENT heading (#PCDATA)>
  <!ELEMENT body (#PCDATA | link | list)*>
  <!ELEMENT link (#PCDATA)>
  <!ATTLIST link href CDATA #REQUIRED>
  <!ELEMENT list (item*)>
  <!ELEMENT item (#PCDATA)>
  <!ELEMENT footer (#PCDATA)>
  <!NOTATION bin SYSTEM "application/octet-stream">
  <!ENTITY blob SYSTEM "data.bin" NDATA bin>
]>
<package>
  <header>
    <entry name="mode" value="test"/>
    <entry name="empty"/>
  </header>
  <payload>
    <section code="intro">
      <heading>Overview</heading>
      <body>This is <link href="urn:docs:start">documentation</link>.
        <list>
          <item>first</item>
          <item>second &quot;quoted&quot; item</item>
        </list>
      </body>
    </section>
    <section code="end">
      <heading>Conclusion</heading>
      <body><![CDATA[Nothing else follows.]]></body>
    </section>
  </payload>
  <footer>checksum: 0000</footer>
</package>