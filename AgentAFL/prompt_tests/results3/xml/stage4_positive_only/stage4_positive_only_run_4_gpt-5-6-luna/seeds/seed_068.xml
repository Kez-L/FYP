<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE archive [
  <!ELEMENT archive (folder*)>
  <!ELEMENT folder (folder|file|note)*>
  <!ELEMENT file (#PCDATA)>
  <!ELEMENT note (#PCDATA)>
  <!ATTLIST folder name CDATA #REQUIRED>
  <!ATTLIST file name CDATA #REQUIRED size NMTOKEN #IMPLIED checksum CDATA #IMPLIED>
  <!ATTLIST note author CDATA #IMPLIED>
  <!ENTITY left "[" >
  <!ENTITY right "]" >
]>
<archive>
  <folder name="root">
    <file name="readme.md" size="418" checksum="sha256:abc123">
      <![CDATA[# Archive

A deliberately multiline payload.
]]>
    </file>
    <folder name="empty"/>
    <folder name="nested">
      <folder name="deep">
        <note author="system">Missing file &left;placeholder&right;</note>
        <file name="data.bin" size="0"/>
      </folder>
    </folder>
    <note>Trailing note with &amp; and &lt;markup&gt;.</note>
  </folder>
</archive>