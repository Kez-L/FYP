<?xml version="1.0"?>
<!DOCTYPE archive [
  <!ELEMENT archive (collection+)>
  <!ELEMENT collection (title, entry*)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT entry (name, metadata, payload?)>
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT metadata (author*, date?, keyword*)>
  <!ELEMENT author (#PCDATA)>
  <!ELEMENT date (#PCDATA)>
  <!ELEMENT keyword (#PCDATA)>
  <!ELEMENT payload (#PCDATA|fragment)*>
  <!ELEMENT fragment (#PCDATA)>
  <!ATTLIST collection code NMTOKEN #REQUIRED>
  <!ATTLIST entry ref ID #REQUIRED relation IDREFS #IMPLIED>
  <!ATTLIST entry compressed (yes|no) "no">
  <!ENTITY separator " / ">
]>
<archive>
  <collection code="alpha">
    <title>Research notes</title>
    <entry ref="e1" compressed="yes">
      <name>Protocol &separator; draft</name>
      <metadata>
        <author>Li</author>
        <author>O'Neil</author>
        <date>2026-09-30</date>
        <keyword>parsing</keyword>
        <keyword>recovery</keyword>
      </metadata>
      <payload>
        Introductory text
        <fragment><![CDATA[<not-an-element>]]></fragment>
        trailing text
      </payload>
    </entry>
    <entry ref="e2" relation="e1">
      <name>Appendix</name>
      <metadata>
        <keyword>Δ</keyword>
      </metadata>
    </entry>
  </collection>
  <collection code="β">
    <title>Empty collection</title>
  </collection>
</archive>