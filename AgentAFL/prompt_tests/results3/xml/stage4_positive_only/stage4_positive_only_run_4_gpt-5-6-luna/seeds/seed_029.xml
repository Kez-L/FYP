<?xml version="1.0"?>
<!DOCTYPE dashboard [
  <!ENTITY nbsp "&#160;">
  <!ENTITY product "Telemetry">
  <!ELEMENT dashboard (title, panel+)>
  <!ATTLIST dashboard generated CDATA #IMPLIED>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT panel (caption, metric+, footer?)>
  <!ATTLIST panel key ID #REQUIRED collapsed (true|false) "false">
  <!ELEMENT caption (#PCDATA)>
  <!ELEMENT metric (name, value, trend)>
  <!ATTLIST metric unit CDATA #IMPLIED severity (info|warning|critical) "info">
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT value (#PCDATA)>
  <!ELEMENT trend (#PCDATA)>
  <!ELEMENT footer (#PCDATA)>
]>
<dashboard generated="2026-10-01">
  <title>&product; status&nbsp;report</title>
  <panel key="cpu">
    <caption>Compute nodes</caption>
    <metric unit="percent">
      <name>Utilization</name>
      <value>73.4</value>
      <trend>rising</trend>
    </metric>
    <metric unit="count" severity="warning">
      <name>Throttled workers</name>
      <value>4</value>
      <trend>stable</trend>
    </metric>
    <footer>Last sample: 12:00:00Z</footer>
  </panel>
  <panel key="storage" collapsed="true">
    <caption>Storage</caption>
    <metric unit="bytes" severity="critical">
      <name>Free capacity</name>
      <value>0x1f4</value>
      <trend><![CDATA[falling -> falling -> falling]]></trend>
    </metric>
  </panel>
</dashboard>