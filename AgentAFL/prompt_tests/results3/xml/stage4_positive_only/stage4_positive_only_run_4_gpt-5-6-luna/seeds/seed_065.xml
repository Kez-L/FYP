<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE warehouse [
  <!ELEMENT warehouse (location*)>
  <!ELEMENT location (aisle*)>
  <!ELEMENT aisle (bin*)>
  <!ELEMENT bin (product*)>
  <!ELEMENT product EMPTY>
  <!ATTLIST location code CDATA #REQUIRED>
  <!ATTLIST aisle number CDATA #REQUIRED>
  <!ATTLIST bin label CDATA #IMPLIED>
  <!ATTLIST product sku CDATA #REQUIRED quantity NMTOKEN #REQUIRED fragile (yes|no) "no">
]>
<warehouse>
  <location code="north">
    <aisle number="01">
      <bin label="A-01">
        <product sku="AX-7" quantity="0003"/>
        <product sku="BX-2" quantity="12" fragile="yes"/>
      </bin>
      <bin label="A-02"/>
    </aisle>
  </location>
  <location code="overflow">
    <aisle number="99">
      <bin>
        <product sku="Z-0" quantity="1"/>
      </bin>
    </aisle>
  </location>
</warehouse>