<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE archive [
  <!ELEMENT archive (folder+)>
  <!ELEMENT folder (folder* | document*)>
  <!ATTLIST folder name CDATA #REQUIRED hidden (yes|no) "no">
  <!ELEMENT document (heading, body, checksum?)>
  <!ATTLIST document path CDATA #REQUIRED media CDATA #IMPLIED>
  <!ELEMENT heading (#PCDATA)>
  <!ELEMENT body (#PCDATA | line | link)*>
  <!ELEMENT line (#PCDATA)>
  <!ELEMENT link (#PCDATA)>
  <!ELEMENT checksum (#PCDATA)>
]>
<archive>
  <folder name="2025" hidden="no">
    <folder name="drafts">
      <document path="drafts/plan.xml" media="application/xml">
        <heading>Migration plan</heading>
        <body>
          Phase one<line>Back up all records.</line>
          Phase two<line>Verify restored copies.</line>
          See <link>appendix-A</link>.
        </body>
        <checksum>sha256:abc123</checksum>
      </document>
    </folder>
    <folder name="exports">
      <document path="exports/data.csv" media="text/csv">
        <heading>Comma-separated export</heading>
        <body><![CDATA[id,name
1,"A < B"
2,"C & D"]]></body>
      </document>
    </folder>
  </folder>
</archive>