<?xml version="1.0"?>
<!DOCTYPE invoice [
  <!ELEMENT invoice (customer, address, lines, total, payment)>
  <!ATTLIST invoice number ID #REQUIRED currency (USD|EUR|JPY) "USD">
  <!ELEMENT customer (#PCDATA)>
  <!ELEMENT address (street, city, region?, postal)>
  <!ELEMENT street (#PCDATA)>
  <!ELEMENT city (#PCDATA)>
  <!ELEMENT region (#PCDATA)>
  <!ELEMENT postal (#PCDATA)>
  <!ELEMENT lines (line+)>
  <!ELEMENT line (description, quantity, unit-price)>
  <!ATTLIST line sku CDATA #REQUIRED taxable (yes|no) "yes">
  <!ELEMENT description (#PCDATA)>
  <!ELEMENT quantity (#PCDATA)>
  <!ELEMENT unit-price (#PCDATA)>
  <!ELEMENT total (#PCDATA)>
  <!ELEMENT payment EMPTY>
  <!ATTLIST payment method (card|transfer|cash) #REQUIRED confirmed (true|false) "false">
]>
<invoice number="INV-2026-0042" currency="EUR">
  <customer>Northwind &amp; Partners</customer>
  <address>
    <street>17 Rue des Lilas</street>
    <city>Lyon</city>
    <region>Auvergne-Rhône-Alpes</region>
    <postal>69002</postal>
  </address>
  <lines>
    <line sku="P-17" taxable="yes">
      <description>Replacement filter</description>
      <quantity>3</quantity>
      <unit-price>12.50</unit-price>
    </line>
    <line sku="S-03" taxable="no">
      <description>Installation service</description>
      <quantity>1</quantity>
      <unit-price>45.00</unit-price>
    </line>
  </lines>
  <total>82.50</total>
  <payment method="card" confirmed="true"/>
</invoice>