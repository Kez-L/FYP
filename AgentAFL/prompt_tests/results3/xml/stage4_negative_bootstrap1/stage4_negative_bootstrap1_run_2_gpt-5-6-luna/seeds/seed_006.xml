<?xml version="1.0"?>
<!DOCTYPE inventory [
  <!ELEMENT inventory (section+)>
  <!ELEMENT section (item*)>
  <!ATTLIST section name CDATA #REQUIRED>
  <!ELEMENT item (#PCDATA)>
  <!ATTLIST item
    id ID #REQUIRED
    link IDREF #IMPLIED
    status (cold|warm|hot) "cold"
  >
]>
<inventory>
  <section name="north">
    <item id="n1" status="hot">alpha</item>
    <item id="n2" link="n1">beta</item>
  </section>
  <section name="south">
    <item id="s1">gamma</item>
  </section>
</inventory>