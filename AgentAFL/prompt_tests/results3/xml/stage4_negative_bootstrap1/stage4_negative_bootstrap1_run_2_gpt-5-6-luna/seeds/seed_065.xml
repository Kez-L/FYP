<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE catalog [
  <!ELEMENT catalog (entry+)>
  <!ELEMENT entry (title, author+, metadata?, description)>
  <!ATTLIST entry id ID #REQUIRED category (book|paper|other) "book">
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT author (#PCDATA)>
  <!ELEMENT metadata (published?, tags?)>
  <!ELEMENT published (#PCDATA)>
  <!ELEMENT tags (tag*)>
  <!ELEMENT tag (#PCDATA)>
  <!ELEMENT description (#PCDATA|em|code|br)*>
  <!ELEMENT em (#PCDATA|code)*>
  <!ELEMENT code (#PCDATA)>
  <!ELEMENT br EMPTY>
]>
<catalog>
  <entry id="item-a" category="paper">
    <title>Parsing &amp; Validation</title>
    <author>Ada Lovelace</author>
    <author>Grace Hopper</author>
    <metadata>
      <published>1843-10-01</published>
      <tags>
        <tag>markup</tag>
        <tag>testing</tag>
      </tags>
    </metadata>
    <description>Text with <em>mixed</em> content, <code>&lt;token&gt;</code><br/>and a break.</description>
  </entry>
  <entry id="item-b">
    <title>Unadorned Entry</title>
    <author>Unknown</author>
    <description><![CDATA[Literal <characters> and ]]> markers]]></description>
  </entry>
</catalog>