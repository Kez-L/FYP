<?xml version="1.0"?>
<!DOCTYPE catalog [
  <!ELEMENT catalog (entry+, note?)>
  <!ATTLIST catalog version NMTOKEN #IMPLIED>
  <!ELEMENT entry (title, meta?, description)>
  <!ATTLIST entry id ID #REQUIRED status (draft|published|archived) "draft">
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT meta EMPTY>
  <!ATTLIST meta author CDATA #IMPLIED tags NMTOKENS #IMPLIED>
  <!ELEMENT description (#PCDATA|em|code)*>
  <!ELEMENT em (#PCDATA)>
  <!ELEMENT code (#PCDATA)>
  <!ELEMENT note (#PCDATA)>
  <!ENTITY company "North &amp; South">
  <!ENTITY mark "&#x2605;">
]>
