    <title>&company; &mark; release</title>
    <meta author="A. Writer" tags="xml parser fuzzing"/>
    <description>Text with <em>inline emphasis</em> and <code>markup</code>.</description>
  </entry>
  <entry id="e-002">
    <title>Unfinished draft</title>
    <description>Whitespace&#x9;and a numeric character reference.</description>
  </entry>
  <note>End of catalog.</note>
</catalog>