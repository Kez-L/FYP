<?xml version="1.0"?>
<!DOCTYPE catalog [
  <!ELEMENT catalog (book+)>
  <!ELEMENT book (title, author+, metadata?)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT author (#PCDATA)>
  <!ELEMENT metadata (tag*)>
  <!ELEMENT tag EMPTY>
  <!ATTLIST book isbn CDATA #REQUIRED edition CDATA "1">
  <!ATTLIST tag name CDATA #REQUIRED>
  <!ENTITY publisher "Northwind &amp; Sons">
]>
<catalog>
  <book isbn="978-0-123456-78-9" edition="2">
    <title>Parsing &amp; Validation</title>
    <author>Ada Lovelace</author>
    <author>Charles Babbage</author>
    <metadata>
      <tag name="xml"/>
      <tag name="parser"/>
      <tag name="&publisher;"/>
    </metadata>
  </book>
</catalog>