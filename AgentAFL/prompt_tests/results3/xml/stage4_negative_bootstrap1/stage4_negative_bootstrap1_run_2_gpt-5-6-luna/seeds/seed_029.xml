<?xml version="1.0"?>
<!DOCTYPE dashboard [
  <!ELEMENT dashboard (section*)>
  <!ELEMENT section (heading, widget+)>
  <!ELEMENT heading (#PCDATA)>
  <!ELEMENT widget (label?, value)>
  <!ELEMENT label (#PCDATA)>
  <!ELEMENT value (#PCDATA|code|br)*>
  <!ELEMENT code (#PCDATA)>
  <!ELEMENT br EMPTY>
  <!ATTLIST section key NMTOKEN #REQUIRED>
  <!ATTLIST widget type (text|number|status) "text">
]>
<dashboard>
  <section key="overview">
    <heading>System <code>status</code></heading>
    <widget type="status">
      <label>state</label>
      <value>ready<br/>for inspection</value>
    </widget>
  </section>
</dashboard>