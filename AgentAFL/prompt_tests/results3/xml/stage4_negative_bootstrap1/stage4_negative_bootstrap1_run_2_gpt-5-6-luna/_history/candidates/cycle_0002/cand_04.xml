<?xml version="1.0"?>
<configuration>
  <path>/var/lib/example</path>
  <option name="retries" value="03"/>
  <option name="timeout" value="0"/>
  <limits>
    <soft unit="bytes">65536</soft>
    <hard unit="bytes">1048576</hard>
  </limits>
  <rules>
    <rule>
      <match><![CDATA[[a-z]+(\.[a-z]+)?]]></match>
      <replacement>$1</replacement>
    </rule>
    <rule enabled="false">
      <match>^$</match>
      <replacement/>
    </rule>
  </rules>
</configuration>