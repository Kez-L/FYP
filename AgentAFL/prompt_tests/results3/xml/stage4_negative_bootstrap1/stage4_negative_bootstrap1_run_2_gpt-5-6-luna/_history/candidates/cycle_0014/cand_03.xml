<?xml version="1.0"?>
<!DOCTYPE report [
  <!ENTITY company "Example &amp; Sons">
  <!ENTITY note "Generated &quot;internally&quot;">
  <!ENTITY % extra "<!ELEMENT appendix (#PCDATA)>">
  %extra;
  <!ELEMENT report (section+, appendix?)>
  <!ELEMENT section (heading, paragraph+)>
  <!ATTLIST section name CDATA #IMPLIED>
  <!ELEMENT heading (#PCDATA)>
  <!ELEMENT paragraph (#PCDATA|list|itemref)*>
  <!ELEMENT list (item+)>
  <!ELEMENT item (#PCDATA)>
  <!ELEMENT itemref EMPTY>
  <!ATTLIST itemref ref NMTOKEN #REQUIRED>
]>
<report>
  <section name="intro">
    <heading>Welcome</heading>
    <paragraph>&company; presents this report.</paragraph>
    <paragraph>Confidential: &note;</paragraph>
  </section>
  <section name="details">
    <heading>Items</heading>
    <paragraph>
      A nested list follows:
      <list>
        <item>one</item>
        <item>two</item>
        <item>three</item>
      </list>
      <itemref ref="external-7"/>
    </paragraph>
  </section>
  <appendix>End of document.</appendix>
</report>