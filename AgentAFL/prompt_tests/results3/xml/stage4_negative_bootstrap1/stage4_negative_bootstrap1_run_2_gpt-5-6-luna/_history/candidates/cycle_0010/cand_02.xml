<?xml version="1.0"?>
<!DOCTYPE packet [
  <!NOTATION binary SYSTEM "application/octet-stream">
  <!ENTITY external-data SYSTEM "unused.bin" NDATA binary>
  <!ENTITY greeting "hello">
  <!ENTITY suffix "world">
  <!ELEMENT packet EMPTY>
  <!ATTLIST packet blob ENTITY #IMPLIED
                    label CDATA #IMPLIED
                    ready (yes|no) "no">
]>
<packet blob="external-data" label="&greeting;, &suffix;" ready="yes"/>