<?xml version="1.0"?>
<!DOCTYPE catalog [
  <!ELEMENT catalog (book+)>
  <!ELEMENT book (title, author+, metadata?)>
  <!ATTLIST book isbn ID #REQUIRED>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT author (#PCDATA)>
  <!ELEMENT metadata (year, tags)>
  <!ELEMENT year (#PCDATA)>
  <!ELEMENT tags (tag*)>
  <!ELEMENT tag (#PCDATA)>
]>
<catalog>
  <book isbn="bk-001">
    <title>Parsing &amp; Validation</title>
    <author>J. Doe</author>
    <author>A. Roe</author>
    <metadata>
      <year>2026</year>
      <tags><tag>xml</tag><tag>fuzzing</tag></tags>
    </metadata>
  </book>
</catalog>