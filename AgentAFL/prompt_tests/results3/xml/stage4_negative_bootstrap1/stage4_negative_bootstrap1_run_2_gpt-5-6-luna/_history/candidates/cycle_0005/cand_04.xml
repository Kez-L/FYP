<?xml version="1.0"?>
<!DOCTYPE tree [
  <!ELEMENT tree (branch|leaf)*>
  <!ELEMENT branch (branch|leaf)*>
  <!ELEMENT leaf (#PCDATA)>
  <!ATTLIST branch level NMTOKEN #IMPLIED>
]>
<tree>
  <branch level="0">
    <branch level="1">
      <leaf><![CDATA[first]]></leaf>
      <branch level="2">
        <leaf>second</leaf>
        <branch level="3">
          <leaf>third</leaf>
        </branch>
      </branch>
    </branch>
    <leaf>outside</leaf>
  </branch>
  <leaf>terminal</leaf>
</tree>