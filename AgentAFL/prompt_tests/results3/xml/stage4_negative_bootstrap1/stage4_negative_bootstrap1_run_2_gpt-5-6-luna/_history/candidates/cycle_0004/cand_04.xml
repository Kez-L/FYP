<?xml version="1.0"?>
<!DOCTYPE archive [
  <!ENTITY company "Acme Research &amp; Development">
  <!ENTITY notice "This record is retained for seven years.">
  <!ELEMENT archive (record*)>
  <!ELEMENT record (header, body, attachment*)>
  <!ATTLIST record key CDATA #REQUIRED>
  <!ELEMENT header (subject, sender, recipients)>
  <!ELEMENT subject (#PCDATA)>
  <!ELEMENT sender EMPTY>
  <!ATTLIST sender address CDATA #REQUIRED>
  <!ELEMENT recipients (recipient+)>
  <!ELEMENT recipient (#PCDATA)>
  <!ELEMENT body (#PCDATA|quote|break)*>
  <!ELEMENT quote (#PCDATA)>
  <!ELEMENT break EMPTY>
  <!ELEMENT attachment (#PCDATA)>
  <!ATTLIST attachment media CDATA #REQUIRED>
]>
<archive>
  <record key="R-001">
    <header>
      <subject>Quarterly review</subject>
      <sender address="lab@example.invalid"/>
      <recipients>
        <recipient>team@example.invalid</recipient>
        <recipient>audit@example.invalid</recipient>
      </recipients>
    </header>
    <body>
      Results from &company; are summarized below.
      <break/>
      <quote>Measure twice, archive once.</quote>
      The raw observations are included separately.
    </body>
    <attachment media="text/csv">observations-2026.csv</attachment>
  </record>
  <record key="R-002">
    <header>
      <subject>Retention policy</subject>
      <sender address="records@example.invalid"/>
      <recipients>
        <recipient>legal@example.invalid</recipient>
      </recipients>
    </header>
    <body>&notice;</body>
  </record>
</archive>