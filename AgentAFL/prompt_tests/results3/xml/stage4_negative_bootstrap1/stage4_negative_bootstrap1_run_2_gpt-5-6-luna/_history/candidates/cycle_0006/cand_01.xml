<?xml version="1.0"?>
<!DOCTYPE library [
  <!ELEMENT library (book+)>
  <!ELEMENT book (title, author+, summary?)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT author (#PCDATA)>
  <!ELEMENT summary (#PCDATA|emphasis)*>
  <!ELEMENT emphasis (#PCDATA)>
  <!ATTLIST book isbn ID #REQUIRED>
  <!ENTITY copyright "© 2026">
]>
<library>
  <book isbn="bk-001">
    <title>North Wind</title>
    <author>A. Rivera</author>
    <author>M. Chen</author>
    <summary>&copyright; <emphasis>revised</emphasis> edition.</summary>
  </book>
</library>