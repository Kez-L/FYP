<?xml version="1.0"?>
<!DOCTYPE graph [
  <!ELEMENT graph (node|edge)+>
  <!ELEMENT node EMPTY>
  <!ATTLIST node id ID #REQUIRED label CDATA #IMPLIED>
  <!ELEMENT edge EMPTY>
  <!ATTLIST edge from IDREF #REQUIRED to IDREF #REQUIRED weight NMTOKEN "1">
]>
<graph>
  <node id="n1" label="α"/>
  <node id="n2" label="β &amp; γ"/>
  <node id="n3"/>
  <edge from="n1" to="n2" weight="0.125"/>
  <edge from="n2" to="n3"/>
  <edge from="n3" to="n1" weight="99"/>
</graph>