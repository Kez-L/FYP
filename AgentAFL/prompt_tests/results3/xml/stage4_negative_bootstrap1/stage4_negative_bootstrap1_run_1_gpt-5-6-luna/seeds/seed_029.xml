<?xml version="1.0"?>
<!DOCTYPE graph [
  <!ELEMENT graph (node*, edge*)>
  <!ELEMENT node (label?, data*)>
  <!ATTLIST node id NMTOKEN #REQUIRED>
  <!ELEMENT edge EMPTY>
  <!ATTLIST edge from NMTOKEN #REQUIRED to NMTOKEN #REQUIRED directed (yes|no) "yes">
  <!ELEMENT label (#PCDATA)>
  <!ELEMENT data (#PCDATA)>
]>
<graph xmlns="urn:graph:v1" directed="mixed">
  <node id="n0">
    <label>Root</label>
    <data key="empty"></data>
    <data key="symbols">&lt;&gt;&amp;&quot;&apos;</data>
  </node>
  <node id="n-1">
    <label xml:lang="ja">ノード</label>
    <data key="multiline"><![CDATA[line one
line two
line three]]></data>
  </node>
  <node id="n2"/>
  <edge from="n0" to="n-1"/>
  <edge from="n-1" to="n2" directed="no"/>
  <edge from="n2" to="n0" directed="yes"/>
</graph>