<?xml version="1.0"?>
<!DOCTYPE form [
  <!ELEMENT form (header, fields, footer)>
  <!ELEMENT header (title, meta*)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT meta EMPTY>
  <!ATTLIST meta name CDATA #REQUIRED value CDATA #IMPLIED>
  <!ELEMENT fields (field*)>
  <!ELEMENT field (label, help?, choice*)>
  <!ATTLIST field name NMTOKEN #REQUIRED type (text|select|flag) "text">
  <!ELEMENT label (#PCDATA)>
  <!ELEMENT help (#PCDATA)>
  <!ELEMENT choice (#PCDATA)>
  <!ATTLIST choice selected (yes|no) "no">
  <!ELEMENT footer (#PCDATA)>
]>
<form>
  <header>
    <title>Preferences</title>
    <meta name="version" value="2&amp;3"/>
    <meta name="empty"/>
  </header>
  <fields>
    <field name="display_mode" type="select">
      <label>Display mode</label>
      <help>Choose one &lt;option&gt;.</help>
      <choice selected="yes">compact</choice>
      <choice>expanded</choice>
    </field>
    <field name="notifications" type="flag">
      <label>Notifications</label>
      <choice selected="no">email</choice>
      <choice selected="yes">push</choice>
    </field>
  </fields>
  <footer>End&#x9;of form</footer>
</form>