<?xml version="1.0"?>
<!DOCTYPE archive [
  <!ELEMENT archive (entry+)>
  <!ELEMENT entry (title, data, note?)>
  <!ATTLIST entry key ID #REQUIRED state (new|old|held) "new">
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT data (#PCDATA)>
  <!ELEMENT note (#PCDATA|mark)*>
  <!ELEMENT mark (#PCDATA)>
  <!ENTITY open "[">
  <!ENTITY close "]">
]>
<archive>
  <entry key="e1" state="held">
    <title>Entity &amp; DTD sample</title>
    <data><![CDATA[raw <payload> & untouched]]></data>
    <note>status &open;<mark>review</mark>&close;</note>
  </entry>
</archive>