<?xml version="1.0"?>
<!DOCTYPE report [
  <!ELEMENT report (context, measurements, conclusion?)>
  <!ELEMENT context (source, location)>
  <!ELEMENT source (#PCDATA)>
  <!ELEMENT location EMPTY>
  <!ATTLIST location latitude CDATA #REQUIRED longitude CDATA #REQUIRED>
  <!ELEMENT measurements (measurement*)>
  <!ELEMENT measurement EMPTY>
  <!ATTLIST measurement
    name CDATA #REQUIRED
    value CDATA #REQUIRED
    unit CDATA #IMPLIED>
  <!ELEMENT conclusion (#PCDATA)>
  <!ENTITY degree "&#x00B0;">
  <!ENTITY approx "approximately">
]>
<report>
  <context>
    <source>sensor-&amp;-archive</source>
    <location latitude="90.000000" longitude="-180.000000"/>
  </context>
  <measurements>
    <measurement name="temperature" value="-273.15" unit="&degree;C"/>
    <measurement name="pressure" value="1.01325e5" unit="Pa"/>
    <measurement name="count" value="000000"/>
  </measurements>
  <conclusion>&approx; stable; no anomaly detected.</conclusion>
</report>