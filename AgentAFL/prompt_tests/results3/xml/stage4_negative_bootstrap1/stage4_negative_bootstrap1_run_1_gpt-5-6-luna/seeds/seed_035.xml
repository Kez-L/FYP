<?xml version="1.0"?>
<!DOCTYPE catalog [
  <!ELEMENT catalog (entry+)>
  <!ELEMENT entry (title, summary?, price, availability)>
  <!ATTLIST entry id ID #REQUIRED category (book|music|film) "book">
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT summary (#PCDATA|em|code)*>
  <!ELEMENT em (#PCDATA)>
  <!ELEMENT code (#PCDATA)>
  <!ELEMENT price (#PCDATA)>
  <!ELEMENT availability EMPTY>
  <!ATTLIST availability region NMTOKENS #IMPLIED>
  <!ENTITY currency "¤">
]>
<catalog>
  <entry id="b17" category="book">
    <title>Parsing &amp; Practice</title>
    <summary>Notes with <em>emphasis</em>, <code>markup()</code>, and &currency;.</summary>
    <price>19.95</price>
    <availability region="EU UK"/>
  </entry>
  <entry id="m04" category="music">
    <title>Signals &lt;Noise&gt;</title>
    <price>7.00</price>
    <availability region="US CA JP"/>
  </entry>
</catalog>