<!DOCTYPE catalog [
  <!ELEMENT catalog (section+)>
  <!ELEMENT section (entry+)>
  <!ATTLIST section name ID #REQUIRED>
  <!ELEMENT entry (name, description?, price)>
  <!ATTLIST entry code ID #REQUIRED status (active|retired) "active">
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT description (#PCDATA|emph)*>
  <!ELEMENT emph (#PCDATA)>
  <!ELEMENT price (#PCDATA)>
]>
<catalog>
  <section name="hardware">
    <entry code="itm-001">
      <name>Precision &amp; Torque</name>
      <description>Compact tool with <emph>adjustable</emph> output.</description>
      <price>19.95</price>
    </entry>
    <entry code="itm-002" status="retired">
      <name>Gauge</name>
      <price>0</price>
    </entry>
  </section>
</catalog>