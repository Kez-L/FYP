<?xml version="1.0"?>
<!DOCTYPE report [
  <!ENTITY % switches "<!ELEMENT flag EMPTY><!ATTLIST flag enabled (on|off) 'off'>">
  %switches;
  <!ELEMENT report (header, section*, footer)>
  <!ELEMENT header (name, generated, flag?)>
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT generated (#PCDATA)>
  <!ELEMENT section (heading, paragraph+, table?)>
  <!ATTLIST section id ID #REQUIRED>
  <!ELEMENT heading (#PCDATA)>
  <!ELEMENT paragraph (#PCDATA|em|code)*>
  <!ELEMENT em (#PCDATA)>
  <!ELEMENT code (#PCDATA)>
  <!ELEMENT table (row+)>
  <!ELEMENT row (cell+)>
  <!ELEMENT cell (#PCDATA)>
  <!ELEMENT footer (#PCDATA)>
  <!ENTITY nbsp "&#160;">
  <!ENTITY company "North &amp; South">
]>
<report>
  <header>
    <name>&company; deployment</name>
    <generated>2026-09-23</generated>
    <flag enabled="on"/>
  </header>
  <section id="s1">
    <heading>Preparation</heading>
    <paragraph>Use <code>--dry-run</code> before <em>committing</em>.&nbsp;</paragraph>
    <paragraph>Three regions were scanned.</paragraph>
    <table>
      <row><cell>region</cell><cell>items</cell></row>
      <row><cell>west</cell><cell>14</cell></row>
      <row><cell>east</cell><cell>0</cell></row>
    </table>
  </section>
  <footer>End of report</footer>
</report>