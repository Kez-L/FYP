<?xml version="1.0"?>
<!DOCTYPE message [
  <!ELEMENT message (from,to,body,trail?)>
  <!ELEMENT from (#PCDATA)>
  <!ELEMENT to (#PCDATA)>
  <!ELEMENT body ANY>
  <!ELEMENT trail EMPTY>
  <!ATTLIST message status (new|read|archived) "new">
  <!ENTITY hello "Hello, ">
  <!ENTITY world "world!">
  <!ENTITY pair "&hello;&world;">
]>
<message status="archived">
  <from><![CDATA[user@example.org]]></from>
  <to>admin@example.org</to>
  <body>
    &pair;
    <emphasis><![CDATA[<unsafe>&text]]></emphasis>
    <br/>
    <span data-x="&#x20;&#x9;&#xD;">tail</span>
  </body>
  <trail/>
</message>