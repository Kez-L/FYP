<?xml version="1.0"?>
<!DOCTYPE archive [
  <!ELEMENT archive (record+, index?)>
  <!ELEMENT record (title, data, note?)>
  <!ATTLIST record id ID #REQUIRED ref IDREF #IMPLIED>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT data (#PCDATA)>
  <!ELEMENT note (#PCDATA|em)*>
  <!ELEMENT em (#PCDATA)>
  <!ELEMENT index (entry*)>
  <!ELEMENT entry EMPTY>
  <!ATTLIST entry target IDREF #REQUIRED>
  <!ENTITY company "Aster &amp; Finch">
  <!ENTITY mark "&#x2605;">
]>
<archive>
  <record id="r1" ref="r2">
    <title>&company; &mark; quarterly report</title>
    <data><![CDATA[alpha < beta && gamma > delta]]></data>
    <note>Reviewed by <em>operations</em>.</note>
  </record>
  <record id="r2">
    <title>Appendix</title>
    <data>Line one&#10;Line two&#13;&#10;Line three</data>
  </record>
  <index>
    <entry target="r1"/>
    <entry target="r2"/>
  </index>
</archive>