<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!DOCTYPE catalog [
  <!ELEMENT catalog (entry+)>
  <!ELEMENT entry (title, summary, details)>
  <!ATTLIST entry id ID #REQUIRED status (active|archived) "active">
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT summary (#PCDATA)>
  <!ELEMENT details (#PCDATA|em|code|br)*>
  <!ELEMENT em (#PCDATA|code)*>
  <!ELEMENT code (#PCDATA)>
  <!ELEMENT br EMPTY>
  <!ENTITY product "parser">
  <!ENTITY note "This &product; handles mixed content.">
]>
<catalog>
  <entry id="e-alpha" status="active">
    <title>Boundary Cases</title>
    <summary>&note;</summary>
    <details xml:space="preserve">Text before <em>emphasis <code>v1.0</code></em><br/>text after.</details>
  </entry>
  <entry id="e-beta" status="archived">
    <title>Quoted &amp; Escaped</title>
    <summary><![CDATA[Literal markup: <not-an-element/>]]></summary>
    <details>Line one&#10;Line two&#x0A;Line three</details>
  </entry>
</catalog>