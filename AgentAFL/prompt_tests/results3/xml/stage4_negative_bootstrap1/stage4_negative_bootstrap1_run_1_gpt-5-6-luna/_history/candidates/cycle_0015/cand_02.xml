<?xml version="1.0" encoding="UTF-8"?>
<?processing instruction-data?>
<workflow xmlns="urn:example:workflow"
          xmlns:sec="urn:example:security"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:nil="false">
  <start at="2026-09-23T00:00:00Z"/>
  <parallel id="p1">
    <task id="fetch" owner="ops">
      <input><![CDATA[
        {"endpoint":"/v1/items","limit":25}
      ]]></input>
      <retry max="3" delay="PT0.5S"/>
    </task>
    <task id="verify" owner="qa">
      <sec:policy level="restricted">
        <sec:rule action="read" resource="inventory"/>
        <sec:rule action="deny" resource="secrets"/>
      </sec:policy>
    </task>
  </parallel>
  <decision expression="count(/workflow/parallel/task) &gt; 1">
    <when value="true">
      <emit channel="audit">parallel execution enabled</emit>
    </when>
    <otherwise>
      <emit channel="audit">single execution path</emit>
    </otherwise>
  </decision>
  <end status="success"/>
</workflow>