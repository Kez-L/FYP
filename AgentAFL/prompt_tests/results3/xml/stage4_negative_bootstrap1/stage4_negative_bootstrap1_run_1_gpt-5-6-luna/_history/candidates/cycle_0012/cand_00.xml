<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE catalog [
  <!ELEMENT catalog (entry+)>
  <!ELEMENT entry (title,summary,metadata)>
  <!ATTLIST entry id ID #REQUIRED status (draft|published|archived) "draft">
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT summary (#PCDATA|mark|code)*>
  <!ELEMENT mark (#PCDATA)>
  <!ELEMENT code (#PCDATA)>
  <!ELEMENT metadata (author,related*)>
  <!ELEMENT author (#PCDATA)>
  <!ELEMENT related EMPTY>
  <!ATTLIST related ref IDREF #REQUIRED>
]>
<catalog>
  <entry id="e-001" status="published">
    <title>Entity-aware records</title>
    <summary>Text with <mark>highlighted</mark> and <code>inline code</code>.</summary>
    <metadata>
      <author>R. Example</author>
    </metadata>
  </entry>
  <entry id="e-002">
    <title>Cross references</title>
    <summary>Draft material with a <mark>pending</mark> annotation.</summary>
    <metadata>
      <author>J. Sample</author>
      <related ref="e-001"/>
    </metadata>
  </entry>
</catalog>