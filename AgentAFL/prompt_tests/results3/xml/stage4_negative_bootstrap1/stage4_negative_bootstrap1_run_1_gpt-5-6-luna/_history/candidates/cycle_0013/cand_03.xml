<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE network [
  <!ELEMENT network (node+, route*)>
  <!ELEMENT node (address*, property*)>
  <!ATTLIST node name NMTOKEN #REQUIRED>
  <!ELEMENT address (#PCDATA)>
  <!ELEMENT property (#PCDATA)>
  <!ATTLIST property key CDATA #REQUIRED>
  <!ELEMENT route (from, to, metric?, annotation?)>
  <!ELEMENT from EMPTY>
  <!ATTLIST from ref IDREF #REQUIRED>
  <!ELEMENT to EMPTY>
  <!ATTLIST to ref IDREF #REQUIRED>
  <!ELEMENT metric (#PCDATA)>
  <!ELEMENT annotation (#PCDATA)>
]>
<network>
  <node name="alpha">
    <address family="v4">192.0.2.1</address>
    <address family="v6">2001:db8::1</address>
    <property key="empty"></property>
  </node>
  <node name="beta">
    <address family="v4">198.51.100.77</address>
    <property key="quote">A &quot;quoted&quot; value</property>
  </node>
  <route>
    <from ref="alpha"/>
    <to ref="beta"/>
    <metric>00000000000000000000042</metric>
    <annotation>alpha -&gt; beta</annotation>
  </route>
</network>