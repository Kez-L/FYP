<?xml version="1.0"?>
<!DOCTYPE scene [
  <!ELEMENT scene (setting, actors, actions)>
  <!ELEMENT setting (place, time, weather?)>
  <!ELEMENT place (#PCDATA)>
  <!ELEMENT time (#PCDATA)>
  <!ELEMENT weather (#PCDATA)>
  <!ELEMENT actors (actor+)>
  <!ELEMENT actor (name, role?, prop*)>
  <!ATTLIST actor key ID #REQUIRED>
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT role (#PCDATA)>
  <!ELEMENT prop (#PCDATA)>
  <!ELEMENT actions (action+)>
  <!ELEMENT action (speaker?, line?, cue*)>
  <!ATTLIST action actor IDREF #IMPLIED>
  <!ELEMENT speaker (#PCDATA)>
  <!ELEMENT line (#PCDATA)>
  <!ELEMENT cue (#PCDATA)>
]>
<scene>
  <setting>
    <place>Room 12, below the old observatory</place>
    <time>just before dawn</time>
    <weather>rain against the eastern windows</weather>
  </setting>
  <actors>
    <actor key="actor-m">
      <name>Mara</name>
      <role>cartographer</role>
      <prop>brass compass</prop>
      <prop>folded chart</prop>
    </actor>
    <actor key="actor-s">
      <name>Soren</name>
      <role>caretaker</role>
    </actor>
  </actors>
  <actions>
    <action actor="actor-m">
      <speaker>Mara</speaker>
      <line>The needle moved before the door opened.</line>
      <cue>She places the compass on the table.</cue>
    </action>
    <action actor="actor-s">
      <speaker>Soren</speaker>
      <line>Then we should not follow it.</line>
      <cue>The lights flicker.</cue>
      <cue>Blackout.</cue>
    </action>
  </actions>
</scene>