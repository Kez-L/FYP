<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE archive [
  <!ELEMENT archive (entry+)>
  <!ELEMENT entry (title, summary?, body)>
  <!ATTLIST entry id ID #REQUIRED status (draft|published|retired) "draft">
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT summary (#PCDATA)>
  <!ELEMENT body (#PCDATA|em|code|br)*>
  <!ELEMENT em (#PCDATA)>
  <!ELEMENT code (#PCDATA)>
  <!ELEMENT br EMPTY>
  <!ENTITY product "XML &amp; Parser">
]>
<archive xml:lang="en" xml:space="preserve">
  <!-- An entity-expanded title and mixed body content. -->
  <entry id="e-001" status="published">
    <title>&product; notes</title>
    <summary>Characters such as &lt; and &gt; remain escaped.</summary>
    <body>Use <code>xmllint</code> with <em>care</em>.<br/>Second line&#x0A;with a numeric character.</body>
  </entry>
  <entry id="e-002">
    <title>Unusual spacing</title>
    <body> leading&#x9;tabs and trailing </body>
  </entry>
</archive>