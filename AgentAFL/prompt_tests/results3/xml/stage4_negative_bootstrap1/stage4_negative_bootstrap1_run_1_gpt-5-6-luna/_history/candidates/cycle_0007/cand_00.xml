<?xml version="1.0"?>
<!DOCTYPE archive [
  <!ELEMENT archive (record+)>
  <!ELEMENT record (title, payload, checksum?)>
  <!ATTLIST record id ID #REQUIRED category CDATA "general">
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT payload (#PCDATA|chunk)*>
  <!ELEMENT chunk (#PCDATA)>
  <!ELEMENT checksum (#PCDATA)>
  <!ENTITY intro "This payload contains &lt;escaped&gt; content.">
]>
<archive>
  <record id="r-001" category="binary">
    <title>Encoded sample</title>
    <payload>
      &intro;
      <chunk><![CDATA[AAECAwQFBgcICQoLDA0ODw==]]></chunk>
      <chunk>tail &amp; delimiter</chunk>
    </payload>
    <checksum>sha256:9f86d081884c7d659a2feaa0c55ad015</checksum>
  </record>
  <record id="r-002">
    <title>Second record</title>
    <payload>plain text</payload>
  </record>
</archive>