    <name>Lampe &amp; miroir</name>
    <description>Objet <emph>fragile</emph> — &note;.</description>
    <price>129.95 &currency;</price>
  </entry>
  <entry id="p-002" status="retired">
    <name><![CDATA[Boîte <ancienne>]]></name>
    <price>0</price>
  </entry>
</catalog>