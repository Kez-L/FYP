  <!ELEMENT name (#PCDATA)>
  <!ELEMENT description (#PCDATA|emph)*>
  <!ELEMENT emph (#PCDATA)>
  <!ELEMENT price (#PCDATA)>
  <!ENTITY currency "€">
  <!ENTITY note "limited-edition">
]>
<catalog xml:lang="fr" xml:space="preserve">
