<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE map [
  <!ELEMENT map (point|path|metadata)*>
  <!ELEMENT point EMPTY>
  <!ATTLIST point lat CDATA #REQUIRED lon CDATA #REQUIRED label CDATA #IMPLIED>
  <!ELEMENT path (point+)>
  <!ATTLIST path closed (yes|no) "no">
  <!ELEMENT metadata (#PCDATA)>
]>
<map xmlns="urn:geo:example" xmlns:g="urn:geo:meta" g:revision="0">
  <metadata>coordinates use decimal degrees &lt;west/east&gt;</metadata>
  <point lat="-90.000000" lon="180.000000" label="edge"/>
  <path closed="yes">
    <point lat="0" lon="0"/>
    <point lat="1.234567890123456789" lon="-179.999999999999"/>
    <point lat="0" lon="0"/>
  </path>
  <!-- comment containing -- is not allowed; this one is safe -->
  <?projection value="EPSG:4326"?>
</map>