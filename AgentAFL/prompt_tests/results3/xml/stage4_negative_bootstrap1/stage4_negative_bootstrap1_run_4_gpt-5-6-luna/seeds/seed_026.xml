<?xml version="1.0"?>
<!DOCTYPE message [
  <!ENTITY company "North &amp; South">
  <!ENTITY greeting "Hello, &company;!">
  <!ELEMENT message (header, body, footer)>
  <!ELEMENT header (from, to, subject)>
  <!ELEMENT from (#PCDATA)>
  <!ELEMENT to (#PCDATA)>
  <!ELEMENT subject (#PCDATA)>
  <!ELEMENT body (paragraph|quote|attachment)*>
  <!ELEMENT paragraph (#PCDATA|link)*>
  <!ELEMENT link (#PCDATA)>
  <!ATTLIST link href CDATA #REQUIRED>
  <!ELEMENT quote (#PCDATA)>
  <!ELEMENT attachment EMPTY>
  <!ATTLIST attachment name CDATA #REQUIRED media CDATA #IMPLIED>
  <!ELEMENT footer (#PCDATA)>
]>
<message>
  <header>
    <from>sender@example.invalid</from>
    <to>receiver@example.invalid</to>
    <subject>&greeting;</subject>
  </header>
  <body>
    <paragraph>First line<link href="mailto:a&amp;b@example.invalid">contact</link>after.</paragraph>
    <quote xml:space="preserve">
      "A quoted &lt;fragment&gt;"
    </quote>
    <attachment name="résumé.txt" media="text/plain"/>
    <paragraph>Numeric characters: &#65; &#x1F642; &#x20AC;.</paragraph>
  </body>
  <footer>-- end --</footer>
</message>