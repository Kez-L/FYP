<?xml version="1.0"?>
<!DOCTYPE message [
  <!ELEMENT message (header, body, attachments?)>
  <!ELEMENT header (from, to, subject)>
  <!ELEMENT from EMPTY>
  <!ATTLIST from address CDATA #REQUIRED>
  <!ELEMENT to EMPTY>
  <!ATTLIST to address CDATA #REQUIRED>
  <!ELEMENT subject (#PCDATA)>
  <!ELEMENT body (#PCDATA|quote|br|link)*>
  <!ELEMENT quote (#PCDATA|quote|br)*>
  <!ELEMENT br EMPTY>
  <!ELEMENT link (#PCDATA)>
  <!ATTLIST link href URI #REQUIRED rel CDATA #IMPLIED>
  <!ELEMENT attachments (attachment+)>
  <!ELEMENT attachment EMPTY>
  <!ATTLIST attachment name CDATA #REQUIRED media CDATA #IMPLIED size NMTOKEN #IMPLIED>
]>
<message>
  <header>
    <from address="sender@example.invalid"/>
    <to address="receiver@example.invalid"/>
    <subject>Re: &quot;quoted&quot; subject</subject>
  </header>
  <body>Hello,<br/>please review <quote>the nested <quote>reply</quote></quote>
    and visit <link href="mailto:test@example.invalid" rel="contact">this address</link>.
  </body>
  <attachments>
    <attachment name="report&amp;1.txt" media="text/plain" size="0"/>
    <attachment name="image.bin" media="application/octet-stream" size="4294967295"/>
  </attachments>
</message>