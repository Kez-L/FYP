<?xml version="1.0"?>
<!DOCTYPE svg [
  <!ELEMENT svg (defs?, g*)>
  <!ATTLIST svg xmlns CDATA #IMPLIED viewBox CDATA #IMPLIED>
  <!ELEMENT defs (linearGradient|path)*>
  <!ELEMENT linearGradient (stop+)>
  <!ATTLIST linearGradient id ID #REQUIRED x1 CDATA #IMPLIED y1 CDATA #IMPLIED>
  <!ELEMENT stop EMPTY>
  <!ATTLIST stop offset CDATA #REQUIRED stop-color CDATA #IMPLIED>
  <!ELEMENT path EMPTY>
  <!ATTLIST path id ID #IMPLIED d CDATA #REQUIRED>
  <!ELEMENT g (use|path|text)*>
  <!ATTLIST g transform CDATA #IMPLIED>
  <!ELEMENT use EMPTY>
  <!ATTLIST use href CDATA #IMPLIED xlink:href CDATA #IMPLIED>
  <!ELEMENT text (#PCDATA)>
]>
<svg xmlns="http://www.w3.org/2000/svg"
     xmlns:xlink="http://www.w3.org/1999/xlink"
     viewBox="0 0 100 100">
  <defs>
    <linearGradient id="fade" x1="0%" y1="0%">
      <stop offset="0" stop-color="#000"/>
      <stop offset="1" stop-color="rgba(255,0,0,.5)"/>
    </linearGradient>
    <path id="curve" d="M0,0 C10,20 40,20 100,0"/>
  </defs>
  <g transform="rotate(7 50 50)">
    <use xlink:href="#curve"/>
    <path d="M1 1 L2 3 Z" fill="url(#fade)"/>
    <text>embedded &lt;markup&gt; &amp; text</text>
  </g>
</svg>