<?xml version="1.0"?>
<!DOCTYPE catalog [
  <!ENTITY % common
    "<!ELEMENT item (title,meta?,value)>
     <!ATTLIST item code ID #REQUIRED format CDATA 'plain'>">
  %common;
  <!ELEMENT catalog (item+)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT meta EMPTY>
  <!ATTLIST meta source CDATA #IMPLIED>
  <!ELEMENT value (#PCDATA)>
  <!ENTITY hello "A &amp; B">
  <!ENTITY nested "left &hello; right">
]>
<catalog>
  <item code="i-one">
    <title>First &nested;</title>
    <meta source="generated"/>
    <value>line one
line two&#x0A;line three</value>
  </item>
  <item code="i-two" format="quoted">
    <title><![CDATA[<literal> & untouched]]></title>
    <value>before &hello; after</value>
  </item>
</catalog>