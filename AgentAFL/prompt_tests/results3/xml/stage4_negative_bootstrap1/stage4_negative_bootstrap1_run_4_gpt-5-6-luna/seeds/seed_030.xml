<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE catalog [
  <!ELEMENT catalog (section+)>
  <!ELEMENT section (title, item*)>
  <!ATTLIST section id ID #REQUIRED xml:lang NMTOKEN #IMPLIED>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT item (label, price?, description?)>
  <!ATTLIST item sku ID #REQUIRED status (new|used|archived) "new">
  <!ELEMENT label (#PCDATA)>
  <!ELEMENT price (#PCDATA)>
  <!ELEMENT description (#PCDATA|em|code)*>
  <!ELEMENT em (#PCDATA)>
  <!ELEMENT code (#PCDATA)>
  <!ENTITY currency "€">
]>
<catalog xml:base="https://example.invalid/catalog/">
  <section id="s-main" xml:lang="en">
    <title>Tools &amp; Components</title>
    <item sku="sku-17" status="new">
      <label>Hexagonal &lt;driver&gt;</label>
      <price>&currency; 12.50</price>
      <description>Compact <em>manual</em> tool with <code>0x2a</code> marking.</description>
    </item>
    <item sku="sku-18" status="used">
      <label>Replacement handle</label>
      <description/>
    </item>
  </section>
  <section id="s-empty" xml:lang="fr">
    <title>Échantillons</title>
  </section>
</catalog>