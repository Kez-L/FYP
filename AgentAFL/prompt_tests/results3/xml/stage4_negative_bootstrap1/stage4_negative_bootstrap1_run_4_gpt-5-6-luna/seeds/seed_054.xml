<?xml version="1.0"?>
<!DOCTYPE envelope [
  <!ELEMENT envelope (context?, request, response)>
  <!ELEMENT context (trace?, feature*)>
  <!ELEMENT trace (#PCDATA)>
  <!ELEMENT feature (#PCDATA)>
  <!ATTLIST feature enabled (yes|no) "yes">
  <!ELEMENT request (method, route, parameter*)>
  <!ELEMENT method (#PCDATA)>
  <!ELEMENT route (#PCDATA)>
  <!ELEMENT parameter (#PCDATA)>
  <!ATTLIST parameter key CDATA #REQUIRED>
  <!ELEMENT response (status, header*, body?)>
  <!ELEMENT status (#PCDATA)>
  <!ELEMENT header (#PCDATA)>
  <!ATTLIST header name CDATA #REQUIRED>
  <!ELEMENT body ANY>
]>
<envelope>
  <context>
    <?trace-id 9f8e7d?>
    <trace>0000-ffff</trace>
    <feature enabled="no">compression</feature>
  </context>
  <request>
    <method>POST</method>
    <route>/v1/search?x=1&amp;y=2</route>
    <parameter key="q">a&amp;b&lt;c&gt;</parameter>
    <parameter key="limit">000</parameter>
  </request>
  <response>
    <status>204</status>
    <header name="X-Empty"></header>
    <body><result/><result><![CDATA[]]></result></body>
  </response>
</envelope>