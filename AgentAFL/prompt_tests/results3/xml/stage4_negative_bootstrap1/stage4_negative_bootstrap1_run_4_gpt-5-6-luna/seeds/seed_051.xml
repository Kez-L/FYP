<?xml version="1.0"?>
<!DOCTYPE document [
  <!ELEMENT document (metadata?, content)>
  <!ELEMENT metadata (author+, tag*)>
  <!ELEMENT author (#PCDATA)>
  <!ELEMENT tag (#PCDATA)>
  <!ELEMENT content (chunk+)>
  <!ELEMENT chunk (#PCDATA|comment|code)*>
  <!ELEMENT comment (#PCDATA)>
  <!ELEMENT code (#PCDATA)>
  <!ATTLIST code language NMTOKEN #IMPLIED>
  <!ENTITY left "&#x3C;">
  <!ENTITY right "&#x3E;">
]>
<document>
  <metadata>
    <author>α</author>
    <author>β</author>
    <tag xml:lang="und">mixed</tag>
  </metadata>
  <content>
    <chunk>literal &left;tag&right;</chunk>
    <chunk><comment>nested-looking text</comment><code language="cdata">x &amp; y</code></chunk>
  </content>
</document>