<?xml version="1.0"?>
<!DOCTYPE package [
  <!ELEMENT package (manifest, content)>
  <!ATTLIST package xmlns CDATA #IMPLIED>
  <!ELEMENT manifest (file+)>
  <!ELEMENT file EMPTY>
  <!ATTLIST file path CDATA #REQUIRED media-type CDATA #REQUIRED>
  <!ELEMENT content (section+)>
  <!ELEMENT section (heading?, paragraph*, list?)>
  <!ATTLIST section id ID #IMPLIED>
  <!ELEMENT heading (#PCDATA)>
  <!ELEMENT paragraph (#PCDATA|code|mark|br)*>
  <!ELEMENT code (#PCDATA)>
  <!ELEMENT mark (#PCDATA)>
  <!ELEMENT br EMPTY>
  <!ELEMENT list (li+)>
  <!ELEMENT li (#PCDATA|paragraph|list)*>
]>
<package xmlns="urn:example:package">
  <manifest>
    <file path="doc/intro.xml" media-type="application/xml"/>
    <file path="assets/a&amp;b.bin" media-type="application/octet-stream"/>
  </manifest>
  <content>
    <section id="intro">
      <heading>Introduction</heading>
      <paragraph>One <mark>important</mark> point<br/>with <code>&lt;tag/&gt;</code>.</paragraph>
      <list>
        <li>alpha</li>
        <li>beta
          <list>
            <li>nested item</li>
          </list>
        </li>
      </list>
    </section>
  </content>
</package>