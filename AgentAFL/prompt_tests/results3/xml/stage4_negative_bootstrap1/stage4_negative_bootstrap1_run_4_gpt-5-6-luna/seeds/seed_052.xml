<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE package [
  <!ELEMENT package (manifest, data)>
  <!ELEMENT manifest (file+)>
  <!ELEMENT file EMPTY>
  <!ATTLIST file
    path NMTOKEN #REQUIRED
    type NOTATION #IMPLIED
    size NMTOKEN "0">
  <!NOTATION image SYSTEM "image-handler">
  <!NOTATION text SYSTEM "text-handler">
  <!ELEMENT data (blob*)>
  <!ELEMENT blob (#PCDATA)>
  <!ATTLIST blob encoding (base64|hex|raw) "raw">
]>
<package>
  <manifest>
    <file path="cover.svg" type="image" size="17"/>
    <file path="readme.txt" type="text"/>
  </manifest>
  <data>
    <blob encoding="hex">00ff7e</blob>
    <blob><![CDATA[AAECAwQFBgcICQ==]]></blob>
  </data>
</package>