<?xml version="1.0"?>
<!DOCTYPE stream [
  <!ELEMENT stream (event+)>
  <!ELEMENT event (timestamp, source, payload)>
  <!ATTLIST event id ID #REQUIRED type CDATA #IMPLIED>
  <!ELEMENT timestamp (#PCDATA)>
  <!ELEMENT source EMPTY>
  <!ATTLIST source host CDATA #REQUIRED port NMTOKEN #IMPLIED secure (yes|no) "no">
  <!ELEMENT payload ANY>
  <!ENTITY amp "&#38;">
  <!ENTITY weird "]]&gt; and &amp; and &lt;">
]>
<stream>
