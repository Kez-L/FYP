<?xml version="1.0"?>
<!DOCTYPE map [
  <!ELEMENT map (metadata, layers)>
  <!ELEMENT metadata (author?, keywords?)>
  <!ELEMENT author (#PCDATA)>
  <!ELEMENT keywords (keyword*)>
  <!ELEMENT keyword (#PCDATA)>
  <!ELEMENT layers (layer+)>
  <!ELEMENT layer (extent, feature*)>
  <!ATTLIST layer name NMTOKEN #REQUIRED visible (true|false) "true">
  <!ELEMENT extent (west, south, east, north)>
  <!ELEMENT west (#PCDATA)>
  <!ELEMENT south (#PCDATA)>
  <!ELEMENT east (#PCDATA)>
  <!ELEMENT north (#PCDATA)>
  <!ELEMENT feature (point|line|polygon)>
  <!ATTLIST feature id ID #REQUIRED type CDATA #IMPLIED>
  <!ELEMENT point (coordinates)>
  <!ELEMENT line (coordinates)>
  <!ELEMENT polygon (ring+)>
  <!ELEMENT ring (coordinates)>
  <!ELEMENT coordinates (#PCDATA)>
]>
<map xmlns="urn:example:geo" xmlns:gml="http://www.opengis.net/gml">
  <metadata>
    <author>Δημήτρης</author>
    <keywords>
      <keyword>latitude</keyword>
      <keyword>longitude</keyword>
      <keyword>WGS84</keyword>
    </keywords>
  </metadata>
  <layers>
    <layer name="roads" visible="false">
      <extent>
        <west>-180.000000</west>
        <south>-90</south>
        <east>180.000000</east>
        <north>90</north>
      </extent>
      <feature id="f-point" type="marker">
        <point><coordinates>0,0,0</coordinates></point>
      </feature>
      <feature id="f-line">
        <line><coordinates>-0.1,51.5 2.35,48.86 139.69,35.68</coordinates></line>
      </feature>
      <feature id="f-poly">
        <polygon>
          <ring><coordinates>0,0 1,0 1,1 0,1 0,0</coordinates></ring>
          <ring><coordinates>0.2,0.2 0.8,0.2 0.8,0.8 0.2,0.8 0.2,0.2</coordinates></ring>
        </polygon>
      </feature>
    </layer>
  </layers>
</map>