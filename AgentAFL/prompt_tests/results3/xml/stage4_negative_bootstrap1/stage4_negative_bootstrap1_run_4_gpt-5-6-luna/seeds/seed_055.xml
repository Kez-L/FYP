<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE catalog [
  <!ELEMENT catalog (product+, note?)>
  <!ELEMENT product (title, price, metadata)>
  <!ATTLIST product id ID #REQUIRED status (active|retired) "active">
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT price (#PCDATA)>
  <!ELEMENT metadata EMPTY>
  <!ATTLIST metadata ref IDREF #IMPLIED xml:space (default|preserve) "default">
  <!ELEMENT note (#PCDATA)>
  <!ENTITY currency "€">
  <!ENTITY quoted "&lt;price&gt;">
]>
<catalog>
  <product id="p001">
    <title>café &amp; thé</title>
    <price>19.95 &currency;</price>
    <metadata ref="p001"/>
  </product>
  <product id="p002" status="retired">
    <title>&quot;legacy&quot;</title>
    <price>0.00 &currency;</price>
    <metadata/>
  </product>
  <note>Displayed as &quoted;.</note>
</catalog>