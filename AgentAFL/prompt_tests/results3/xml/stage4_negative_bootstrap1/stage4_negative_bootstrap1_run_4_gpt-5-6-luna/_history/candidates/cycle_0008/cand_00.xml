<?xml version="1.1"?>
<!DOCTYPE catalog [
  <!ENTITY % common "item | section">
  <!ELEMENT catalog (section+)>
  <!ELEMENT section (title, (%common;)*)>
  <!ATTLIST section xml:lang NMTOKEN #IMPLIED id ID #REQUIRED>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT item (#PCDATA|em|ref)*>
  <!ELEMENT em (#PCDATA)>
  <!ELEMENT ref EMPTY>
  <!ATTLIST ref target IDREF #REQUIRED>
  <!ENTITY nbsp "&#160;">
  <!ENTITY euro "&#x20AC;">
]>
<catalog xml:lang="fr" id="root">
  <section id="s1">
    <title>Prix &euro;&nbsp; spécial</title>
    <item>Texte <em>accentué</em> et <ref target="s1"/>.</item>
  </section>
</catalog>