<?xml version="1.0"?>
<!DOCTYPE packet [
  <!NOTATION png SYSTEM "image/png">
  <!ENTITY logo SYSTEM "logo.png" NDATA png>
  <!ELEMENT packet (header, body, attachment?)>
  <!ELEMENT header (field*)>
  <!ELEMENT field EMPTY>
  <!ATTLIST field name CDATA #REQUIRED value CDATA #IMPLIED>
  <!ELEMENT body (#PCDATA|line|br)*>
  <!ELEMENT line (#PCDATA|b|i)*>
  <!ELEMENT b (#PCDATA)>
  <!ELEMENT i (#PCDATA)>
  <!ELEMENT br EMPTY>
  <!ELEMENT attachment EMPTY>
  <!ATTLIST attachment source ENTITY #REQUIRED media CDATA #IMPLIED>
]>
<packet>
  <header>
    <field name="x-trace" value="αβγ"/>
    <field name="empty"/>
  </header>
  <body>before<line><b>bold</b><br/><i>italic &amp; plain</i></line>after</body>
  <attachment source="logo" media="image/png"/>
</packet>