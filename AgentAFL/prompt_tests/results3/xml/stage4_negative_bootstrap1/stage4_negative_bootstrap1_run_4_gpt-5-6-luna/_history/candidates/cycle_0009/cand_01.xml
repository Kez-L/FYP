<?xml version="1.0"?>
<!DOCTYPE warehouse [
  <!ELEMENT warehouse (zone+)>
  <!ELEMENT zone (label, bin*)>
  <!ATTLIST zone code ID #REQUIRED xml:space (default|preserve) "default">
  <!ELEMENT label (#PCDATA)>
  <!ELEMENT bin (slot*)>
  <!ATTLIST bin number NMTOKEN #REQUIRED sealed (true|false) "false">
  <!ELEMENT slot (#PCDATA|mark)*>
  <!ATTLIST slot key CDATA #IMPLIED>
  <!ELEMENT mark EMPTY>
  <!ATTLIST mark type CDATA #REQUIRED>
]>
<warehouse xmlns="urn:inventory:v2" xmlns:x="urn:extra" xml:lang="ja">
  <zone code="north" xml:space="preserve">
    <label>  北側  </label>
    <bin number="A-01" sealed="true">
      <slot key="δ">one<x:mark type="fragile"/></slot>
      <slot key="ε"><mark type="cold"/>two</slot>
    </bin>
  </zone>
  <zone code="south">
    <label>south</label>
    <bin number="B_02"><slot>three</slot></bin>
  </zone>
</warehouse>