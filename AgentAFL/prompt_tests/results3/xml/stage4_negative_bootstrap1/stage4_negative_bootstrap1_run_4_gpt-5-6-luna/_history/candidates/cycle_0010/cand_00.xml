<?xml version="1.0"?>
<!DOCTYPE inventory [
  <!ELEMENT inventory (item+, note?)>
  <!ELEMENT item (title, price, details)>
  <!ATTLIST item id ID #REQUIRED format (digital|physical) "physical" image ENTITY #IMPLIED>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT price (#PCDATA)>
  <!ELEMENT details (#PCDATA|feature)*>
  <!ELEMENT feature (#PCDATA)>
  <!ELEMENT note (#PCDATA)>
  <!NOTATION png SYSTEM "image/png">
  <!ENTITY cover SYSTEM "cover.png" NDATA png>
  <!ENTITY company "North &amp; South">
  <!ENTITY mark "&#x2605;">
]>
<inventory>
  <item id="bk-001" format="physical" image="cover">
    <title>&company; &mark; Handbook</title>
    <price currency="EUR">19.95</price>
    <details>Compact <feature>reference</feature> with <feature>examples</feature>.</details>
  </item>
  <item id="bk-002" format="digital">
    <title>Signals &amp; Systems</title>
    <price currency="USD">0.00</price>
    <details><feature>PDF</feature><feature>EPUB</feature></details>
  </item>
  <note>Availability changes weekly.</note>
</inventory>