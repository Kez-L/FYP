<?xml version="1.0"?>
<!DOCTYPE message [
  <!ENTITY header "BEGIN">
  <!ENTITY footer "END">
  <!ELEMENT message (header, body, footer)>
  <!ELEMENT header (#PCDATA)>
  <!ELEMENT body (paragraph|list|break)*>
  <!ELEMENT paragraph (#PCDATA|em|quote)*>
  <!ELEMENT em (#PCDATA)>
  <!ELEMENT quote (#PCDATA|em)*>
  <!ELEMENT list (entry+)>
  <!ELEMENT entry (#PCDATA|em)*>
  <!ELEMENT break EMPTY>
  <!ELEMENT footer (#PCDATA)>
]>
<message>
  <header>&header;</header>
  <body>
    <paragraph>Alpha <em>emphasis</em> and <quote>quoted <em>text</em></quote>.</paragraph>
    <list>
      <entry>First</entry>
      <entry>Second &amp; <em>more</em></entry>
    </list>
    <break/>
    <paragraph><![CDATA[raw ]]> data <![CDATA[ ]]> after</paragraph>
  </body>
  <footer>&footer;</footer>
</message>