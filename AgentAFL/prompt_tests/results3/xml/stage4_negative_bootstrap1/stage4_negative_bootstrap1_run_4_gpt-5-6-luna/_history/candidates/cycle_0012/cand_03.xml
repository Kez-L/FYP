<?xml version="1.0"?>
<!DOCTYPE configuration [
  <!ENTITY % switches "<!ELEMENT feature EMPTY><!ATTLIST feature enabled (true|false) 'false'>">
  %switches;
  <!ELEMENT configuration (environment, feature*, credentials)>
  <!ELEMENT environment (#PCDATA)>
  <!ELEMENT credentials (username, token)>
  <!ELEMENT username (#PCDATA)>
  <!ELEMENT token (#PCDATA)>
  <!ATTLIST configuration version NMTOKEN #IMPLIED>
  <!ATTLIST credentials method (basic|bearer|none) "none">
  <![IGNORE[
    <!ELEMENT discarded ANY>
    <!ENTITY hidden "not expanded">
  ]]>
]>
<configuration version="v2.0-beta">
  <environment>staging</environment>
  <feature enabled="true"/>
  <feature/>
  <credentials method="bearer">
    <username>build-agent</username>
    <token><![CDATA[abc.def.ghi]]></token>
  </credentials>
</configuration>