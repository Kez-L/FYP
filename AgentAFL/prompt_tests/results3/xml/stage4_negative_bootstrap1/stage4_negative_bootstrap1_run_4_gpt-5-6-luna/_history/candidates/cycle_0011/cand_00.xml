<?xml version="1.1"?>
<!DOCTYPE catalog [
  <!ELEMENT catalog (section+)>
  <!ELEMENT section (title, item*)>
  <!ATTLIST section id ID #REQUIRED xml:space (default|preserve) "default">
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT item (#PCDATA|link|br)*>
  <!ELEMENT link (#PCDATA)>
  <!ATTLIST link target IDREF #IMPLIED>
  <!ELEMENT br EMPTY>
  <!ENTITY greeting "A &amp; B">
]>
<catalog>
  <section id="s-main" xml:space="preserve">
    <title>&greeting;</title>
    <item>before<link target="s-main">self</link><br/>after</item>
  </section>
</catalog>