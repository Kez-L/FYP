<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE catalog [
  <!ELEMENT catalog (section+)>
  <!ELEMENT section (title, product*)>
  <!ATTLIST section id ID #REQUIRED xml:lang NMTOKEN #IMPLIED>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT product (sku, description, price, tags?)>
  <!ATTLIST product status (active|retired|pending) "active">
  <!ATTLIST product featured (yes|no) "no">
  <!ELEMENT sku (#PCDATA)>
  <!ELEMENT description (#PCDATA|em|code)*>
  <!ELEMENT em (#PCDATA)>
  <!ELEMENT code (#PCDATA)>
  <!ELEMENT price EMPTY>
  <!ATTLIST price currency CDATA #REQUIRED amount CDATA #REQUIRED>
  <!ELEMENT tags (tag+)>
  <!ELEMENT tag (#PCDATA)>
]>
<catalog>
  <section id="hardware" xml:lang="en">
    <title>Devices</title>
    <product status="active" featured="yes">
      <sku>ZX-001</sku>
      <description>Compact <em>edge</em> unit with <code>USB-C</code> support.</description>
      <price currency="EUR" amount="0.00"/>
      <tags><tag>new</tag><tag>portable</tag></tags>
    </product>
    <product status="retired" featured="no">
      <sku>ZX-002</sku>
      <description>Legacy &quot;controller&quot; with a&amp;b diagnostics.</description>
      <price currency="JPY" amount="999999999999999999999999"/>
    </product>
  </section>
  <section id="international" xml:lang="und">
    <title>多言語 / العربية / Ελληνικά</title>
    <product status="pending">
      <sku>Ω-𐐷-7</sku>
      <description><![CDATA[<not-markup> & still raw ]]></description>
      <price currency="𐐀" amount="-0.0000000000000000001"/>
      <tags><tag>α</tag><tag>界</tag><tag>🙂</tag></tags>
    </product>
  </section>
</catalog>