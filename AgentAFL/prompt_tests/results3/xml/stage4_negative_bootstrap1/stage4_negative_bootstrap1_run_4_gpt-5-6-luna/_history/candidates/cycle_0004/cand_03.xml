  <body>
    <record code="A-1"><key>k&amp;1</key><data>first<br/>second</data></record>
    <record code="B_2"><key><![CDATA[]]></key><data>left<br/><br/>right</data><data>extra</data></record>
  </body>
  <footer>done</footer>
</document>