<?xml version="1.1"?>
<!DOCTYPE package [
  <!NOTATION png SYSTEM "image/png">
  <!ENTITY logo SYSTEM "logo.png" NDATA png>
  <!ELEMENT package (manifest, data)>
  <!ELEMENT manifest (entry*)>
  <!ELEMENT entry EMPTY>
  <!ATTLIST entry
    path CDATA #REQUIRED
    media CDATA #IMPLIED
    checksum CDATA #IMPLIED>
  <!ELEMENT data (chunk+)>
  <!ELEMENT chunk (#PCDATA|ref)*>
  <!ATTLIST chunk index NMTOKEN #REQUIRED>
  <!ELEMENT ref EMPTY>
  <!ATTLIST ref href URI #REQUIRED>
]>
<package xml:lang="en">
  <manifest>
    <entry path="images/logo.png" media="image/png" checksum="sha256:00"/>
    <entry path="notes/readme.txt" media="text/plain"/>
  </manifest>
  <data>
    <chunk index="0">line-one&#x85;line-two<ref href="images/logo.png"/></chunk>
    <chunk index="1"><![CDATA[raw <bytes> & markers]]></chunk>
  </data>
</package>