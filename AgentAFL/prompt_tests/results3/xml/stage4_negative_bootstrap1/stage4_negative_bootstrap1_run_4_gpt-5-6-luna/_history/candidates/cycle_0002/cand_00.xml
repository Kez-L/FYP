<?xml version="1.0"?>
<!DOCTYPE catalog [
  <!ELEMENT catalog (section+)>
  <!ELEMENT section (title, item*)>
  <!ATTLIST section xml:lang NMTOKEN #IMPLIED>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT item (label, value?, note*)>
  <!ATTLIST item id ID #REQUIRED status (new|old|archived) "new">
  <!ELEMENT label (#PCDATA|b|i)*>
  <!ELEMENT value (#PCDATA|unit)*>
  <!ELEMENT unit (#PCDATA)>
  <!ELEMENT note (#PCDATA|b|i)*>
  <!ELEMENT b (#PCDATA)>
  <!ELEMENT i (#PCDATA)>
  <!ENTITY mark "&#x2605;">
]>
<catalog xmlns="urn:example:catalog" xmlns:m="urn:example:meta" xml:base="https://example.invalid/data/">
  <?catalog mode="index"?>
  <!-- namespace-aware mixed content -->
  <section xml:lang="en">
    <title>Measurements &amp; &mark;</title>
    <item id="a1" status="new">
      <label><b>Temperature</b> <i>ambient</i></label>
      <value>21.5<unit>°C</unit></value>
      <note>Collected <m:source code="A-7">north wing</m:source>.</note>
    </item>
    <item id="b2" status="archived">
      <label>Pressure</label>
      <note xml:space="preserve">  retired value  </note>
    </item>
  </section>
</catalog>