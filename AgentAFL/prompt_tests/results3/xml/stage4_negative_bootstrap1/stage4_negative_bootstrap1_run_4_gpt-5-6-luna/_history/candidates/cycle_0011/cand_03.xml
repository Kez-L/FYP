<?xml version="1.0"?>
<!DOCTYPE report [
  <!ELEMENT report (header, body, footer?)>
  <!ELEMENT header (subject, generated, property*)>
  <!ELEMENT subject (#PCDATA)>
  <!ELEMENT generated (#PCDATA)>
  <!ELEMENT property EMPTY>
  <!ATTLIST property name CDATA #REQUIRED value CDATA #IMPLIED>
  <!ELEMENT body (section+)>
  <!ELEMENT section (heading?, paragraph+, list?)>
  <!ATTLIST section level NMTOKEN "1">
  <!ELEMENT heading (#PCDATA)>
  <!ELEMENT paragraph (#PCDATA|b|i|ref|linebreak)*>
  <!ELEMENT b (#PCDATA)>
  <!ELEMENT i (#PCDATA)>
  <!ELEMENT ref EMPTY>
  <!ATTLIST ref href URI #REQUIRED>
  <!ELEMENT linebreak EMPTY>
  <!ELEMENT list (item+)>
  <!ELEMENT item (#PCDATA|b|i)*>
  <!ELEMENT footer (#PCDATA)>
]>
<report>
  <header>
    <subject>Quarterly &quot;delta&quot;</subject>
    <generated>2026-10-01T00:00:00Z</generated>
    <property name="empty"/>
    <property name="owner" value="ops &amp; qa"/>
  </header>
  <body>
    <section level="2">
      <heading>Changes</heading>
      <paragraph>One <b>bold</b> <i>italic</i><linebreak/><ref href="urn:x-example"/></paragraph>
      <list><item>first</item><item>second <b>part</b></item></list>
    </section>
  </body>
  <footer>End &#x1F600;</footer>
</report>