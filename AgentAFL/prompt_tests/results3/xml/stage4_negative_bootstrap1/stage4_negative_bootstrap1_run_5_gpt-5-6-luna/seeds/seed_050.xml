<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE catalog [
  <!ELEMENT catalog (section+)>
  <!ELEMENT section (title, entry*)>
  <!ATTLIST section code ID #REQUIRED>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT entry (label, value, note?)>
  <!ATTLIST entry key CDATA #REQUIRED kind (text|number|flag) "text">
  <!ELEMENT label (#PCDATA)>
  <!ELEMENT value (#PCDATA|em|br)*>
  <!ELEMENT note (#PCDATA)>
  <!ELEMENT em (#PCDATA)>
  <!ELEMENT br EMPTY>
]>
<catalog>
  <section code="alpha">
    <title>Mixed Content</title>
    <entry key="x1">
      <label>markup</label>
      <value>left <em>center</em><br/> right &amp; beyond</value>
      <note>contains &lt; escaped delimiters &gt;</note>
    </entry>
  </section>
  <section code="omega">
    <title>Empty Section</title>
  </section>
</catalog>