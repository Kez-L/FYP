<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <?origin subsystem="parser"?>
  <profiles>
    <profile name="minimal">
      <option enabled="true">alpha</option>
      <option enabled="false"><![CDATA[beta < gamma]]></option>
    </profile>
    <profile name="extended">
      <inherits from="minimal"/>
      <parameters>
        <parameter key="threshold" type="integer">00042</parameter>
        <parameter key="pattern" type="regex">[A-Z]+(?:-[0-9]+)?</parameter>
        <parameter key="empty" type="string"/>
      </parameters>
    </profile>
  </profiles>
  <!-- A comment between sibling sections -->
  <outputs>
    <output format="xml" path="results.xml">
      <filter>status = "ready" and count &gt; 0</filter>
    </output>
    <output format="text" path="results.txt"/>
  </outputs>
</configuration>