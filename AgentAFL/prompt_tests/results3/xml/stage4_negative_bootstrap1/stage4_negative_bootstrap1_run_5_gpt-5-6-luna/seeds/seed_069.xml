<?xml version="1.0" standalone="yes"?>
<!DOCTYPE report [
  <!ELEMENT report (header, section*, footer)>
  <!ELEMENT header (title, author)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT author EMPTY>
  <!ATTLIST author name CDATA #REQUIRED role CDATA "unknown">
  <!ELEMENT section (heading?, paragraph+)>
  <!ATTLIST section id ID #IMPLIED>
  <!ELEMENT heading (#PCDATA)>
  <!ELEMENT paragraph (#PCDATA|code|br)*>
  <!ELEMENT code (#PCDATA)>
  <!ELEMENT br EMPTY>
  <!ELEMENT footer (#PCDATA)>
]>
<report>
  <header>
    <title>Parser Notes</title>
    <author name="A. &amp; B" role="qa"/>
  </header>
  <section id="intro">
    <heading>Overview</heading>
    <paragraph>Text before <code>token</code><br/>text after.</paragraph>
  </section>
  <section>
    <paragraph><![CDATA[<literal node="x"/>]]></paragraph>
    <paragraph>second paragraph</paragraph>
  </section>
  <footer>— end —</footer>
</report>