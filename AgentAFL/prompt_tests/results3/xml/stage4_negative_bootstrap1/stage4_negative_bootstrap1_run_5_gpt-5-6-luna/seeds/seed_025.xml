<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE catalog [
  <!ELEMENT catalog (entry+)>
  <!ELEMENT entry (title, price, note?)>
  <!ATTLIST entry code ID #REQUIRED ref IDREF #IMPLIED>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT price (#PCDATA)>
  <!ELEMENT note (#PCDATA)>
  <!ENTITY company "A&amp;B Research">
  <!ENTITY quoted "Use &quot;quoted&quot; values">
]>
<catalog>
  <entry code="a7">
    <title>&company; annual report</title>
    <price currency="EUR">19.95</price>
    <note>&quoted;</note>
  </entry>
  <entry code="b7" ref="a7">
    <title>Replacement parts</title>
    <price currency="JPY">2400</price>
  </entry>
</catalog>