<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE catalog [
  <!ELEMENT catalog (entry+)>
  <!ELEMENT entry (title, creator*, description?, link*)>
  <!ATTLIST entry id ID #REQUIRED status (draft|published|retired) "draft">
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT creator (#PCDATA)>
  <!ELEMENT description (#PCDATA|term)*>
  <!ELEMENT term (#PCDATA)>
  <!ELEMENT link EMPTY>
  <!ATTLIST link rel CDATA #REQUIRED target IDREF #IMPLIED>
  <!ENTITY euro "&#x20AC;">
  <!ENTITY quoted "&quot;inside&quot;">
  <!ENTITY % extra "edition CDATA #IMPLIED">
  <!ATTLIST entry %extra;>
]>
<catalog>
  <entry id="bk1" status="published" edition="third">
    <title>Parsing &euro; &amp; entities</title>
    <creator>Ada</creator>
    <description>Text with <term>&quoted;</term> and references.</description>
    <link rel="related" target="bk2"/>
  </entry>
  <entry id="bk2">
    <title>Second record</title>
    <creator>Lin</creator>
    <link rel="source" target="bk1"/>
  </entry>
</catalog>