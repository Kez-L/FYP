<?xml version="1.0"?>
<!DOCTYPE archive [
  <!ELEMENT archive (record+)>
  <!ELEMENT record (key, value, reference?)>
  <!ATTLIST record uid ID #REQUIRED>
  <!ELEMENT key (#PCDATA)>
  <!ELEMENT value (#PCDATA|part)*>
  <!ELEMENT part (#PCDATA)>
  <!ELEMENT reference EMPTY>
  <!ATTLIST reference target IDREF #REQUIRED>
  <!ENTITY greeting "hello &amp; welcome">
  <!ENTITY mark "&#x2605;">
]>
<archive>
  <record uid="r1">
    <key>first</key>
    <value>&greeting;<part>one</part>&mark;</value>
    <reference target="r2"/>
  </record>
  <record uid="r2">
    <key>second</key>
    <value><![CDATA[raw ]]> <part>two</part></value>
  </record>
</archive>