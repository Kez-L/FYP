<?xml version="1.1" encoding="UTF-8"?>
<!DOCTYPE ledger [
  <!ELEMENT ledger (header, transaction*)>
  <!ELEMENT header EMPTY>
  <!ATTLIST header timestamp CDATA #REQUIRED>
  <!ELEMENT transaction (debit?, credit?, memo?)>
  <!ATTLIST transaction number NMTOKEN #REQUIRED status CDATA "pending">
  <!ELEMENT debit EMPTY>
  <!ATTLIST debit account CDATA #REQUIRED amount CDATA #REQUIRED>
  <!ELEMENT credit EMPTY>
  <!ATTLIST credit account CDATA #REQUIRED amount CDATA #REQUIRED>
  <!ELEMENT memo (#PCDATA|em|br)*>
  <!ELEMENT em (#PCDATA)>
  <!ELEMENT br EMPTY>
]>
