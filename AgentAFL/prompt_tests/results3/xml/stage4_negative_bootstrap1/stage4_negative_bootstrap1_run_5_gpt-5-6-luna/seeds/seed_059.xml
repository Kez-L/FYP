<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE envelope [
  <!ENTITY % declarations "<!ELEMENT envelope (header, payload, trailer)>">
  %declarations;
  <!ELEMENT header (token, timestamp)>
  <!ELEMENT token (#PCDATA)>
  <!ELEMENT timestamp (#PCDATA)>
  <!ELEMENT payload ANY>
  <!ELEMENT trailer (#PCDATA)>
]>
<envelope>
  <header>
    <token>abc&amp;xyz</token>
    <timestamp>2026-10-01T00:00:00Z</timestamp>
  </header>
  <payload xmlns="urn:payload">
    <record><![CDATA[{"a":[1,2,3],"b":null}]]></record>
    <record>
      <key>k</key>
      <value>v</value>
    </record>
  </payload>
  <trailer>ok</trailer>
</envelope>