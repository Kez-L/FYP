<?xml version="1.0"?>
<!DOCTYPE archive [
  <!ELEMENT archive (header, records, signature?)>
  <!ELEMENT header EMPTY>
  <!ATTLIST header created CDATA #REQUIRED>
  <!ELEMENT records (record*)>
  <!ELEMENT record (key, value, binary?)>
  <!ATTLIST record kind CDATA #IMPLIED>
  <!ELEMENT key (#PCDATA)>
  <!ELEMENT value (#PCDATA|part)*>
  <!ELEMENT part (#PCDATA)>
  <!ELEMENT binary (#PCDATA)>
  <!ELEMENT signature (#PCDATA)>
  <!ENTITY left "[" >
  <!ENTITY right "]" >
]>
<archive>
  <header created="2026-10-01T00:00:00Z"/>
  <records>
    <record kind="text">
      <key>name</key>
      <value>before<part>middle</part>after</value>
    </record>
    <record kind="encoded">
      <key>payload</key>
      <value>&left;opaque&amp;value&right;</value>
      <binary><![CDATA[
AAECAwQFBgcICQ==
]]></binary>
    </record>
  </records>
  <signature>sha256:unavailable</signature>
</archive>