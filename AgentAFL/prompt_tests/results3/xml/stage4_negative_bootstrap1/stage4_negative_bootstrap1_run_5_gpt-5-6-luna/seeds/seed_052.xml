<?xml version="1.1"?>
<!DOCTYPE graph [
  <!ELEMENT graph (node*)>
  <!ELEMENT node (name, edge*)>
  <!ATTLIST node id ID #REQUIRED>
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT edge EMPTY>
  <!ATTLIST edge to IDREF #REQUIRED weight NMTOKEN #IMPLIED directed (yes|no) "yes">
]>
<graph>
  <node id="n-root">
    <name>root</name>
    <edge to="n-leaf" weight="0"/>
    <edge to="n-leaf" directed="no"/>
  </node>
  <node id="n-leaf">
    <name>leaf</name>
    <edge to="n-root" weight="1.5"/>
  </node>
</graph>