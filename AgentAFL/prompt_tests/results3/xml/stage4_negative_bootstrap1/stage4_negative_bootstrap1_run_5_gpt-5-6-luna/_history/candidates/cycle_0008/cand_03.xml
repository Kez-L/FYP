<?xml version="1.0"?>
<!DOCTYPE graph [
  <!ELEMENT graph (node*, edge*)>
  <!ELEMENT node (label?, property*)>
  <!ATTLIST node id ID #REQUIRED>
  <!ELEMENT label (#PCDATA)>
  <!ELEMENT property (#PCDATA)>
  <!ATTLIST property key NMTOKEN #REQUIRED>
  <!ELEMENT edge EMPTY>
  <!ATTLIST edge from IDREF #REQUIRED to IDREF #REQUIRED weight CDATA #IMPLIED>
]>
<graph>
  <node id="n-root">
    <label>root</label>
    <property key="empty"></property>
    <property key="quoted">a &quot;b&quot; c</property>
  </node>
  <node id="n-leaf"/>
  <node id="n-unicode">
    <label>π ∑ 漢字</label>
  </node>
  <edge from="n-root" to="n-leaf" weight="1e309"/>
  <edge from="n-leaf" to="n-unicode"/>
</graph>