<?xml version="1.0" encoding="UTF-8"?>
<r:request xmlns:r="urn:acme:request"
          xmlns:d="urn:acme:data"
          xmlns:xlink="http://www.w3.org/1999/xlink"
          xml:base="https://example.invalid/api/">
  <r:header>
    <r:token xml:space="preserve">  K-17-XY  </r:token>
    <r:flags>
      <r:flag enabled="1">cache</r:flag>
      <r:flag enabled="0">trace</r:flag>
    </r:flags>
  </r:header>
  <r:body>
    <d:record key="alpha" xlink:type="simple" xlink:href="records/alpha">
      <d:value><![CDATA[ left < middle & right ]]></d:value>
      <d:tags>
        <d:tag>one</d:tag>
        <d:tag>two</d:tag>
      </d:tags>
    </d:record>
    <d:record key="omega">
      <d:value>終端</d:value>
    </d:record>
  </r:body>
</r:request>