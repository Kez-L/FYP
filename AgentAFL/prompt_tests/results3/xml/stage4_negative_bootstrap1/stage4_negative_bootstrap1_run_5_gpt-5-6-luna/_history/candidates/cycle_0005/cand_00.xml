<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE catalog [
  <!ELEMENT catalog (book+)>
  <!ELEMENT book (title, author+, summary?)>
  <!ATTLIST book
    id ID #REQUIRED
    category (fiction|reference|poetry) "fiction"
    related IDREF #IMPLIED>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT author (#PCDATA)>
  <!ELEMENT summary (#PCDATA|emph|quote)*>
  <!ELEMENT emph (#PCDATA)>
  <!ELEMENT quote (#PCDATA)>
  <!ENTITY library "Central Archive">
  <!ENTITY mark "&#xA9;">
]>
<catalog>
  <book id="b1" category="reference">
    <title>XML &amp; Parsing</title>
    <author>&library;</author>
    <summary>Notes on <emph>tree construction</emph> and <quote>entity expansion</quote> &mark;</summary>
  </book>
  <book id="b2" related="b1">
    <title>Fragments</title>
    <author>R. Example</author>
  </book>
</catalog>