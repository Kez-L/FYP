<?xml version="1.0"?>
<!DOCTYPE vault [
  <!ELEMENT vault (section*)>
  <!ELEMENT section (record|note|section)*>
  <!ELEMENT record EMPTY>
  <!ELEMENT note (#PCDATA)>
  <!ATTLIST section name CDATA #IMPLIED>
  <!ATTLIST record key CDATA #REQUIRED>
  <!ATTLIST record value CDATA #IMPLIED>
]>
<vault>
  <section name="outer">
    <record key="a" value="1"/>
    <section name="inner">
      <note>unterminated-looking text &amp; safely escaped</note>
      <record key="b"/>
    </section>
    <note><![CDATA[This CDATA closes here]]></note>
  </section>
  <section name="tail">
    <record key="c" value="3"></record>
  </section>
</vault