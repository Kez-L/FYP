<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE form [
  <!ELEMENT form (field|choice|repeat|help)*>
  <!ELEMENT field EMPTY>
  <!ATTLIST field name CDATA #REQUIRED value CDATA #IMPLIED disabled (yes|no) "no">
  <!ELEMENT choice (option+)>
  <!ATTLIST choice name CDATA #REQUIRED>
  <!ELEMENT option (#PCDATA)>
  <!ATTLIST option value CDATA #REQUIRED selected (yes|no) "no">
  <!ELEMENT repeat (field*)>
  <!ATTLIST repeat count CDATA #IMPLIED>
  <!ELEMENT help (#PCDATA)>
  <!ENTITY nbsp "&#160;">
]>
<form version="2" mode="interactive">
  <field name="username" value="&lt;guest&gt;"/>
  <choice name="color">
    <option value="r">red</option>
    <option value="g" selected="yes">green &nbsp; shade</option>
    <option value="b">blue</option>
  </choice>
  <repeat count="2">
    <field name="token" value="A&#x0D;&#x0A;B"/>
    <field name="secret" disabled="yes"/>
  </repeat>
  <help>Use &amp; to join values; use &quot;quotes&quot; carefully.</help>
</form>