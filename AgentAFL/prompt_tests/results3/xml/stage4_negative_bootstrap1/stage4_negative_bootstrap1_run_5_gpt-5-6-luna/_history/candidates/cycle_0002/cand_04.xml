<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE package [
  <!ELEMENT package (manifest, payload, signature)>
  <!ELEMENT manifest (entry+)>
  <!ELEMENT entry EMPTY>
  <!ATTLIST entry path CDATA #REQUIRED size CDATA #IMPLIED checksum CDATA #IMPLIED>
  <!ELEMENT payload (chunk*)>
  <!ELEMENT chunk (#PCDATA)>
  <!ATTLIST chunk index CDATA #REQUIRED>
  <!ELEMENT signature (algorithm, digest)>
  <!ELEMENT algorithm (#PCDATA)>
  <!ELEMENT digest (#PCDATA)>
]>
<package>
  <manifest>
    <entry path="bin/tool" size="128" checksum="a1b2c3"/>
    <entry path="share/doc/readme.txt" size="0"/>
    <entry path="config/defaults.xml" checksum="deadbeef"/>
  </manifest>
  <payload>
    <chunk index="0">first segment</chunk>
    <chunk index="1">second segment</chunk>
    <chunk index="2">final segment</chunk>
  </payload>
  <signature>
    <algorithm>sha256</algorithm>
    <digest>0123456789abcdef0123456789abcdef</digest>
  </signature>
</package>