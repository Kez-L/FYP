<!DOCTYPE report [
  <!ELEMENT report (header, body, footer)>
  <!ELEMENT header (#PCDATA)>
  <!ELEMENT body (entry+)>
  <!ELEMENT entry (title, data)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT data (#PCDATA|br)*>
  <!ELEMENT br EMPTY>
  <!ELEMENT footer (#PCDATA)>
  <!ENTITY nbsp "&#160;">
  <!ENTITY stamp "A &nbsp; B">
]>
<report>
  <header>Run &quot;nightly&quot;</header>
  <body>
    <entry><title>one</title><data>left<br/>right &stamp;</data></entry>
    <entry><title>two</title><data><![CDATA[raw ]]> &amp; <![CDATA[ text]]></data></entry>
  </body>
  <footer>&stamp;</footer>
</report>