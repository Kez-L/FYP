<?xml version="1.0"?>
<!DOCTYPE envelope [
  <!ELEMENT envelope (meta?, payload)>
  <!ELEMENT meta (item*)>
  <!ELEMENT item EMPTY>
  <!ATTLIST item name NMTOKEN #REQUIRED value CDATA #IMPLIED>
  <!ELEMENT payload ANY>
  <!ENTITY left "[" >
  <!ENTITY right "]" >
]>
<envelope>
  <meta>
    <item name="mode" value="stream"/>
    <item name="retry" value="3"/>
  </meta>
  <payload>
    <message priority="high">&left;hello&right;</message>
    <chunks>
      <chunk index="0">A</chunk>
      <chunk index="1"/>
      <chunk index="2"><![CDATA[B&C]]></chunk>
    </chunks>
  </payload>
</envelope>