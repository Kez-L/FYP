<?xml version="1.0"?>
<!DOCTYPE package [
  <!ELEMENT package (manifest, payload)>
  <!ELEMENT manifest (file*)>
  <!ELEMENT file EMPTY>
  <!ATTLIST file path CDATA #REQUIRED kind CDATA "binary">
  <!ELEMENT payload (chunk+)>
  <!ELEMENT chunk (#PCDATA)>
]>
<package>
  <manifest>
    <file path="a/../one.bin" kind="binary"/>
    <file path="./two.txt" kind="text"/>
    <file path="" kind="empty"/>
  </manifest>
  <payload>
    <chunk><![CDATA[AAECAwQF]]></chunk>
    <chunk>text &amp; entities &#10; across lines</chunk>
    <chunk><![CDATA[]]></chunk>
  </payload>
</package>