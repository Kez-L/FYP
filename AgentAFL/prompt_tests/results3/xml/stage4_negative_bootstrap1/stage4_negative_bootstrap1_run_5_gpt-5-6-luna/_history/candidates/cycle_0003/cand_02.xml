<?xml version="1.0"?>
<!DOCTYPE report [
  <!ELEMENT report (header, section*)>
  <!ELEMENT header (title, period)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT period EMPTY>
  <!ATTLIST period from CDATA #REQUIRED to CDATA #REQUIRED>
  <!ELEMENT section (heading, paragraph+, table?)>
  <!ATTLIST section id ID #IMPLIED>
  <!ELEMENT heading (#PCDATA)>
  <!ELEMENT paragraph (#PCDATA|strong|code|br)*>
  <!ELEMENT strong (#PCDATA)>
  <!ELEMENT code (#PCDATA)>
  <!ELEMENT br EMPTY>
  <!ELEMENT table (row+)>
  <!ELEMENT row (cell+)>
  <!ELEMENT cell (#PCDATA)>
]>
<report>
  <header>
    <title>Quarterly &amp; Operational Report</title>
    <period from="2026-07-01" to="2026-09-30"/>
  </header>
  <section id="overview">
    <heading>Overview</heading>
    <paragraph>Demand remained <strong>steady</strong>.<br/>Exceptions are listed in <code>appendix-a</code>.</paragraph>
    <paragraph><![CDATA[Raw note: <not-an-element> & still text]]></paragraph>
    <table>
      <row><cell>Region</cell><cell>Count</cell><cell>Rate</cell></row>
      <row><cell>North</cell><cell>18</cell><cell>0.92</cell></row>
      <row><cell>South</cell><cell>7</cell><cell>0.81</cell></row>
    </table>
  </section>
</report>