<?xml version="1.0"?>
<!DOCTYPE catalog [
  <!ENTITY % common "<!ELEMENT catalog (book+,magazine*)>">
  %common;
  <!ELEMENT book (author, name, summary?, link*)>
  <!ELEMENT magazine (name, issue)>
  <!ELEMENT author (#PCDATA)>
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT summary (#PCDATA|code)*>
  <!ELEMENT code (#PCDATA)>
  <!ELEMENT link EMPTY>
  <!ELEMENT issue (#PCDATA)>
  <!ATTLIST book isbn NMTOKEN #REQUIRED>
  <!ATTLIST link href URI #REQUIRED rel CDATA "related">
  <!ATTLIST magazine month NMTOKEN #REQUIRED>
  <!ENTITY % optional "<!ELEMENT supplement (#PCDATA)>">
  <![IGNORE[
    %optional;
  ]]>
]>
<catalog>
  <book isbn="978-0-00-000000-0">
    <author>A &amp; B</author>
    <name>Parsing &lt;XML&gt;</name>
    <summary>Text with <code>inline()</code> notation.</summary>
    <link href="urn:book:one"/>
    <link href="#local" rel="citation"/>
  </book>
  <magazine month="2026-10">
    <name>Markup Quarterly</name>
    <issue>42</issue>
  </magazine>
</catalog>