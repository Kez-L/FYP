<?xml version="1.0"?>
<!DOCTYPE envelope [
  <!ELEMENT envelope (routing, message)>
  <!ELEMENT routing (source, destination, hops?)>
  <!ELEMENT source (#PCDATA)>
  <!ELEMENT destination (#PCDATA)>
  <!ELEMENT hops (hop+)>
  <!ELEMENT hop (#PCDATA)>
  <!ELEMENT message (subject, body)>
  <!ELEMENT subject (#PCDATA)>
  <!ELEMENT body (#PCDATA|br|table)*>
  <!ELEMENT br EMPTY>
  <!ELEMENT table (row+)>
  <!ELEMENT row (cell+)>
  <!ELEMENT cell (#PCDATA)>
]>
<envelope>
  <routing>
    <source>node-A</source>
    <destination>node-Z</destination>
    <hops><hop>node-C</hop><hop>node-F</hop></hops>
  </routing>
  <message>
    <subject>Boundary test</subject>
    <body>Start<br/>middle<table><row><cell>1</cell><cell>2</cell></row><row><cell><![CDATA[x]]></cell></row></table>end</body>
  </message>
</envelope>