<?xml version="1.0"?>
<envelope xmlns="urn:example:rpc" xmlns:h="urn:example:headers" xmlns:m="urn:example:meta">
  <!-- Header entries intentionally use a different namespace. -->
  <h:header>
    <h:request id="r-17" retry="2">
      <m:trace>
        <m:span name="parse" sampled="true"/>
        <m:span name="store" sampled="false"/>
      </m:trace>
      <h:signature algorithm="none"/>
    </h:request>
  </h:header>
  <body>
    <batch atomic="false">
      <operation name="rename">
        <argument><![CDATA[old/name]]></argument>
        <argument>new/name</argument>
      </operation>
      <operation name="delete">
        <argument path="/tmp/cache" recursive="1"/>
      </operation>
    </batch>
  </body>
</envelope>