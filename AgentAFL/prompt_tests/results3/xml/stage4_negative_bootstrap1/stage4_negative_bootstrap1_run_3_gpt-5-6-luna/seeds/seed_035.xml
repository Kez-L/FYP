<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE archive [
  <!ELEMENT archive (record+, footer)>
  <!ELEMENT record (title, body)>
  <!ATTLIST record key ID #REQUIRED status (draft|final|retired) "draft">
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT body (#PCDATA|em|ref)*>
  <!ELEMENT em (#PCDATA)>
  <!ELEMENT ref EMPTY>
  <!ATTLIST ref target IDREF #REQUIRED>
  <!ELEMENT footer (#PCDATA)>
  <!ENTITY notice "Internal archival notice">
]>
<archive>
  <record key="r17" status="final">
    <title>Field Notes</title>
    <body>Observed <em>unusual</em> behavior; see <ref target="r18"/>.</body>
  </record>
  <record key="r18">
    <title>Supplement</title>
    <body>&notice; &#x2192; retained.</body>
  </record>
  <footer>End of collection</footer>
</archive>