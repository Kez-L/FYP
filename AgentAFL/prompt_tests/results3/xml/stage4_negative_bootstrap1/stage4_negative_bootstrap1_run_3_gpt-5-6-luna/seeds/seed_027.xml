<?xml version="1.0"?>
<!DOCTYPE form [
  <!ELEMENT form (section+)>
  <!ELEMENT section (heading, field*)>
  <!ATTLIST section name CDATA #REQUIRED>
  <!ELEMENT heading (#PCDATA)>
  <!ELEMENT field (label, input, help?)>
  <!ATTLIST field id ID #REQUIRED required (yes|no) "no">
  <!ELEMENT label (#PCDATA)>
  <!ELEMENT input EMPTY>
  <!ATTLIST input type (text|number|date) #REQUIRED value CDATA #IMPLIED>
  <!ELEMENT help (#PCDATA)>
  <!ENTITY nbsp "&#160;">
]>
<form>
  <section name="account">
    <heading>Account &nbsp; details</heading>
    <field id="username" required="yes">
      <label>User name</label>
      <input type="text" value="guest"/>
      <help>Use letters, digits, or a dash.</help>
    </field>
    <field id="birthdate">
      <label>Date of birth</label>
      <input type="date"/>
    </field>
  </section>
  <section name="limits">
    <heading>Limits</heading>
    <field id="quota">
      <label>Maximum value</label>
      <input type="number" value="0x10"/>
    </field>
  </section>
</form>