<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE telemetry [
  <!ELEMENT telemetry (device, sample*)>
  <!ELEMENT device EMPTY>
  <!ATTLIST device
    id ID #REQUIRED
    model CDATA #IMPLIED
    enabled (true|false) "true">
  <!ELEMENT sample (timestamp, reading, annotation?)>
  <!ATTLIST sample ref IDREF #IMPLIED>
  <!ELEMENT timestamp (#PCDATA)>
  <!ELEMENT reading (#PCDATA)>
  <!ATTLIST reading unit CDATA #REQUIRED quality CDATA "unknown">
  <!ELEMENT annotation (#PCDATA)>
]>
<telemetry>
  <device id="sensor-main" model="X&amp;Y" enabled="true"/>
  <sample ref="sensor-main">
    <timestamp>2026-09-24T00:00:00.000+00:00</timestamp>
    <reading unit="°C" quality="nominal">21.75</reading>
    <annotation>steady <![CDATA[<signal/>]]> output</annotation>
  </sample>
  <sample>
    <timestamp>2026-09-24T00:01:00Z</timestamp>
    <reading unit="%" quality="calibrating">99.999</reading>
  </sample>
</telemetry>