<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE catalog [
  <!ELEMENT catalog (item+, note?)>
  <!ELEMENT item (name, price, description)>
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT price (#PCDATA)>
  <!ELEMENT description (#PCDATA|em|code)*>
  <!ELEMENT em (#PCDATA)>
  <!ELEMENT code (#PCDATA)>
  <!ELEMENT note (#PCDATA)>
  <!ATTLIST catalog version NMTOKEN #REQUIRED>
  <!ATTLIST item id ID #REQUIRED refs IDREFS #IMPLIED>
  <!ATTLIST item status (draft|active|retired) "active">
  <!ENTITY euro "&#x20AC;">
  <!ENTITY % common-attrs "xml:lang NMTOKEN #IMPLIED">
  <!ATTLIST description %common-attrs;>
]>
