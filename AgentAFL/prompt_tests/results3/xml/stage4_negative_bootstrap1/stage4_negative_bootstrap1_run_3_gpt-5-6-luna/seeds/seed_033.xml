<?xml version="1.0"?>
<!DOCTYPE records [
  <!ELEMENT records (record*)>
  <!ELEMENT record (key, value, tags, history)>
  <!ATTLIST record id ID #REQUIRED state CDATA "new">
  <!ELEMENT key (#PCDATA)>
  <!ELEMENT value (#PCDATA|linebreak)*>
  <!ELEMENT linebreak EMPTY>
  <!ELEMENT tags (tag*)>
  <!ELEMENT tag (#PCDATA)>
  <!ELEMENT history (event+)>
  <!ELEMENT event (#PCDATA)>
]>
<records>
  <record id="r17" state="active">
    <key>temperature</key>
    <value>18<linebreak/>.5 °C</value>
    <tags>
      <tag>sensor</tag>
      <tag>outdoor</tag>
      <tag priority="ignored">calibrated</tag>
    </tags>
    <history>
      <event>installed</event>
      <event>sampled at 06:00</event>
      <event><![CDATA[maintenance <pending> & review]]></event>
    </history>
  </record>
  <record id="r18">
    <key>pressure</key>
    <value>1013<linebreak/>.25 hPa</value>
    <tags/>
    <history>
      <event>created</event>
    </history>
  </record>
  <record id="r19" state="retired">
    <key>comment</key>
    <value>Use &quot;stable&quot; values only.</value>
    <tags><tag>text</tag></tags>
    <history>
      <event>opened</event>
      <event>closed</event>
    </history>
  </record>
</records>