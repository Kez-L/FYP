<?xml version="1.0"?>
<drawing xmlns="http://www.w3.org/2000/svg"
         xmlns:xlink="http://www.w3.org/1999/xlink"
         viewBox="0 0 320 180">
  <title>Layered composition</title>
  <desc>A compact drawing containing groups, paths, and text.</desc>
  <defs>
    <linearGradient id="shade" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#112233"/>
      <stop offset="50%" stop-color="rgb(120,80,40)"/>
      <stop offset="100%" stop-color="#ddeeff" stop-opacity="0.25"/>
    </linearGradient>
    <clipPath id="window">
      <rect x="12" y="18" width="296" height="144" rx="9"/>
    </clipPath>
  </defs>
  <g id="background" clip-path="url(#window)" opacity="0.92">
    <rect width="320" height="180" fill="url(#shade)"/>
    <circle cx="260" cy="42" r="24" fill="#fff" fill-opacity=".7"/>
    <path d="M0 135 C40 95,80 168,120 126 S205 106,320 145"
          fill="none" stroke="#123456" stroke-width="3"/>
  </g>
  <g id="labels" font-family="sans-serif">
    <text x="24" y="48" font-size="19">A &amp; B</text>
    <text x="24" y="75" rotate="3 6 9">vector <tspan dx="4" dy="8">text</tspan></text>
  </g>
  <use xlink:href="#window" x="0" y="0" fill="none" stroke="#000"/>
</drawing>