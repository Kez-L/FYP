<?xml version="1.0"?>
<!DOCTYPE library [
  <!ELEMENT library (book+)>
  <!ELEMENT book (title, author+, summary?, metadata)>
  <!ATTLIST book id ID #REQUIRED category (fiction|reference|history) "reference">
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT author (name, affiliation?)>
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT affiliation (#PCDATA)>
  <!ELEMENT summary (#PCDATA|emph|quote)*>
  <!ELEMENT emph (#PCDATA)>
  <!ELEMENT quote (#PCDATA)>
  <!ELEMENT metadata (published, pages)>
  <!ELEMENT published (#PCDATA)>
  <!ELEMENT pages (#PCDATA)>
  <!ENTITY copyright "© Archive Press">
]>
<library>
  <book id="b-17" category="history">
    <title>Maps of the Forgotten Coast</title>
    <author>
      <name>Rhea Solano</name>
      <affiliation>Institute of Cartographic Memory</affiliation>
    </author>
    <author>
      <name>Jon Bell</name>
    </author>
    <summary>A study of <emph>vanished</emph> harbors and <quote>roads that ended at the sea</quote>.</summary>
    <metadata>
      <published>1842</published>
      <pages>512</pages>
    </metadata>
  </book>
  <book id="b-18">
    <title>Collected Field Notes</title>
    <author><name>M. K. Ibarra</name></author>
    <metadata><published>&copyright;</published><pages>96</pages></metadata>
  </book>
</library>