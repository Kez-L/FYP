<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE journal [
  <!ELEMENT journal (entry+)>
  <!ELEMENT entry (title, body, attachment*)>
  <!ATTLIST entry id ID #REQUIRED date CDATA #IMPLIED>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT body (#PCDATA|em|link|break)*>
  <!ELEMENT em (#PCDATA)>
  <!ELEMENT link (#PCDATA)>
  <!ATTLIST link href CDATA #REQUIRED>
  <!ELEMENT break EMPTY>
  <!ELEMENT attachment (#PCDATA)>
  <!ATTLIST attachment type CDATA "text/plain">
  <!ENTITY notice "This text came from an internal entity.">
]>
<journal>
  <entry id="e1" date="2026-09-24">
    <title>Field Notes</title>
    <body>Observations include <em>wind</em> and <link href="urn:note:17">dust</link><break/>after sunset.</body>
    <attachment type="text/plain">&notice;</attachment>
  </entry>
  <entry id="e2">
    <title>Closing Remark</title>
    <body><![CDATA[Literal markup: <not-an-element> & still text.]]></body>
  </entry>
</journal>