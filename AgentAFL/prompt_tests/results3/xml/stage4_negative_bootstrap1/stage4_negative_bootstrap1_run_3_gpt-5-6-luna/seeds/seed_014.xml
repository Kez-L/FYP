<!DOCTYPE envelope [
  <!ELEMENT envelope (payload)>
  <!ELEMENT payload (#PCDATA|part)*>
  <!ELEMENT part (#PCDATA)>
  <!ATTLIST part kind (alpha|beta|gamma) "alpha">
]>
<envelope>
  <payload>
    Before
    <part kind="beta">A &amp; B</part>
    <![CDATA[<not-an-element attr="&">]]>
    <part kind="gamma">After</part>
    Tail
  </payload>
</envelope>