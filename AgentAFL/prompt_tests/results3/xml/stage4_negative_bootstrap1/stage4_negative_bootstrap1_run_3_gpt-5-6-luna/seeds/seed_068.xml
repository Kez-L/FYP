<?xml version="1.0"?>
<!DOCTYPE archive [
  <!ELEMENT archive (metadata, records)>
  <!ELEMENT metadata (title, created, tags)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT created (#PCDATA)>
  <!ELEMENT tags (tag*)>
  <!ELEMENT tag (#PCDATA)>
  <!ELEMENT records (record*)>
  <!ELEMENT record (key, value, history?)>
  <!ATTLIST record kind NMTOKEN #REQUIRED>
  <!ELEMENT key (#PCDATA)>
  <!ELEMENT value (#PCDATA)>
  <!ELEMENT history (change*)>
  <!ELEMENT change (#PCDATA)>
  <!ATTLIST change by CDATA #IMPLIED at CDATA #IMPLIED>
]>
