      <key>alpha</key>
      <value>one</value>
      <history>
        <change by="operator" at="2026-09-20">created</change>
        <change by="system" at="2026-09-21">normalized</change>
      </history>
    </record>
    <record kind="scalar">
      <key>threshold</key>
