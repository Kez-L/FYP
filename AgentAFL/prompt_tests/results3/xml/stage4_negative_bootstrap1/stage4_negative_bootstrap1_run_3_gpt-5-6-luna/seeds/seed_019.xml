<?xml version="1.0"?>
<!DOCTYPE envelope [
  <!ELEMENT envelope (header, payload, trailer)>
  <!ELEMENT header EMPTY>
  <!ATTLIST header session CDATA #REQUIRED>
  <!ELEMENT payload (chunk+)>
  <!ELEMENT chunk (#PCDATA|data)*>
  <!ELEMENT data (#PCDATA)>
  <!ELEMENT trailer EMPTY>
  <!ENTITY left "&#x5B;">
  <!ENTITY right "&#x5D;">
]>
<envelope>
  <header session="s&amp;1"/>
  <payload>
    <chunk>&left;<data><![CDATA[raw ]]]]><![CDATA[> text]]></data>&right;</chunk>
    <chunk>
      line one
      <data>line &lt; two</data>
      line three
    </chunk>
  </payload>
  <trailer/>
</envelope>