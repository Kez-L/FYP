<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE catalog [
  <!ELEMENT catalog (section+)>
  <!ELEMENT section (item+)>
  <!ATTLIST section name CDATA #REQUIRED>
  <!ELEMENT item (name, description, price)>
  <!ATTLIST item sku ID #REQUIRED available (yes|no) "yes">
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT description (#PCDATA|em|code)*>
  <!ELEMENT em (#PCDATA)>
  <!ELEMENT code (#PCDATA)>
  <!ELEMENT price (#PCDATA)>
  <!ENTITY currency "€">
  <!ENTITY notice "Limited release">
]>
<catalog>
  <section name="tools">
    <item sku="tool-001" available="yes">
      <name>Parser &amp; Probe</name>
      <description>Handles <em>structured</em> input with <code>--safe</code> mode.</description>
      <price>19.95 &currency;</price>
    </item>
    <item sku="tool-002">
      <name>Signal Clamp</name>
      <description>&notice; — inspect values before storage.</description>
      <price>7.50 &currency;</price>
    </item>
  </section>
</catalog>