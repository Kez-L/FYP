<?xml version="1.1"?>
<configuration xmlns="urn:config" xmlns:q="urn:qualified">
  <q:defaults xml:space="preserve">
    <q:value key="path">/var/tmp/data</q:value>
    <q:value key="limit">00000000000000000000000000000000000000000000000001</q:value>
  </q:defaults>
  <module name="parser" active="yes">
    <option key="mode">strict</option>
    <option key="mask">&#x1F600;</option>
    <option key="empty"></option>
  </module>
  <module name="output" active="no">
    <option key="format"><![CDATA[<json>{"ok":true}</json>]]></option>
  </module>
</configuration>