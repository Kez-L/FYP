<?xml version="1.0" encoding="UTF-8"?>
<configuration xmlns="urn:app:config" xmlns:sec="urn:app:security">
  <profile name="staging">
    <include href="defaults.xml"/>
    <setting key="timeout" type="duration">PT1H15M</setting>
    <setting key="enabled" type="boolean">false</setting>
    <setting key="threshold" type="decimal">-0.00075</setting>
    <credentials>
      <sec:method algorithm="sha-256">
        <sec:token encoding="base64">QWJjMTIzIT8=</sec:token>
      </sec:method>
    </credentials>
  </profile>
  <profile name="minimal">
    <setting key="path" type="path">/var/tmp/app &amp; logs</setting>
  </profile>
</configuration>