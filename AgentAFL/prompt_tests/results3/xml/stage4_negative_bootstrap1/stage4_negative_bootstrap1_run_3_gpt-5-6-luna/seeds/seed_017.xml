<?xml version="1.0"?>
<!DOCTYPE library [
  <!ELEMENT library (shelf+)>
  <!ELEMENT shelf (book*, note?)>
  <!ATTLIST shelf code ID #REQUIRED>
  <!ELEMENT book (title, author+, summary?)>
  <!ATTLIST book ref ID #IMPLIED category (fiction|reference|other) "other">
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT author (#PCDATA)>
  <!ELEMENT summary (#PCDATA|quote)*>
  <!ELEMENT quote (#PCDATA)>
  <!ELEMENT note (#PCDATA)>
  <!ENTITY nbsp "&#160;">
  <!ENTITY mark "&#x2605;">
]>
<library>
  <shelf code="west">
    <book ref="b7" category="fiction">
      <title>The &mark; Archive</title>
      <author>A. One</author>
      <author>B. Two</author>
      <summary>Fragments <quote>kept &nbsp; intact</quote> across editions.</summary>
    </book>
    <note>Inventory checked.</note>
  </shelf>
  <shelf code="east">
    <book category="reference">
      <title>Indexes</title>
      <author>Catalog Office</author>
    </book>
  </shelf>
</library>