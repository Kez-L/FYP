<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE ledger [
  <!ELEMENT ledger (account*)>
  <!ELEMENT account (opening, transaction*, closing)>
  <!ATTLIST account number NMTOKEN #REQUIRED currency CDATA "XXX">
  <!ELEMENT opening (#PCDATA)>
  <!ELEMENT transaction (date, debit?, credit?, note?)>
  <!ATTLIST transaction kind (debit|credit|adjustment) "adjustment">
  <!ELEMENT date (#PCDATA)>
  <!ELEMENT debit (#PCDATA)>
  <!ELEMENT credit (#PCDATA)>
  <!ELEMENT note (#PCDATA)>
  <!ELEMENT closing (#PCDATA)>
]>
<ledger>
  <account number="000-α" currency="EUR">
    <opening>12.50</opening>
    <transaction kind="credit">
      <date>2026-02-29</date>
      <credit>1.00</credit>
      <note>leap-day boundary</note>
    </transaction>
    <transaction kind="debit">
      <date>2026-03-01</date>
      <debit>0.001</debit>
    </transaction>
    <transaction>
      <date>0000-00-00</date>
      <note><![CDATA[adjustment with <raw> markers]]></note>
    </transaction>
    <closing>13.499</closing>
  </account>
</ledger>