<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE archive [
  <!ELEMENT archive (record+)>
  <!ELEMENT record (title, body, link*)>
  <!ATTLIST record id ID #REQUIRED kind (note|report|draft) "note">
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT body (#PCDATA|em|code|br)*>
  <!ELEMENT em (#PCDATA)>
  <!ELEMENT code (#PCDATA)>
  <!ELEMENT br EMPTY>
  <!ELEMENT link EMPTY>
  <!ATTLIST link target IDREF #REQUIRED relation CDATA "related">
  <!ENTITY copyright "© 2026">
]>
<archive>
  <record id="r1" kind="report">
    <title>Parser &amp; Entity Survey</title>
    <body>Alpha <em>bold</em> text<br/><code>&lt;token&gt;</code> &copyright;</body>
    <link target="r2" relation="follow-up"/>
  </record>
  <record id="r2">
    <title>Conclusion</title>
    <body><![CDATA[Literal markup: <x attr="y"/> and ]]></body>
  </record>
</archive>