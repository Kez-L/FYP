<?xml version="1.0"?>
<!DOCTYPE document [
  <!ELEMENT document (metadata, content)>
  <!ELEMENT metadata (author, keywords)>
  <!ELEMENT author (#PCDATA)>
  <!ELEMENT keywords (keyword*)>
  <!ELEMENT keyword (#PCDATA)>
  <!ELEMENT content (paragraph+)>
  <!ELEMENT paragraph (#PCDATA|link|quote)*>
  <!ELEMENT link (#PCDATA)>
  <!ATTLIST link href CDATA #REQUIRED>
  <!ELEMENT quote (#PCDATA)>
]>
<document>
  <metadata>
    <author>Åsa &amp; Chen</author>
    <keywords><keyword>XML</keyword><keyword>parsing</keyword></keywords>
  </metadata>
  <content>
    <paragraph>Opening <link href="https://example.test/a?x=1&amp;y=2">reference</link>.</paragraph>
    <paragraph><quote>Nested quotation</quote> follows ordinary text.</paragraph>
  </content>
</document>