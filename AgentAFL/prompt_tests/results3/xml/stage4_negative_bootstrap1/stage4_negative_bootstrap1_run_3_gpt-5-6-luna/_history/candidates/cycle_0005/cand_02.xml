<?xml version="1.1" encoding="UTF-8"?>
<!DOCTYPE transport [
  <!ELEMENT transport (header, payload, trailer)>
  <!ELEMENT header (source, destination, timestamp)>
  <!ELEMENT source (#PCDATA)>
  <!ELEMENT destination (#PCDATA)>
  <!ELEMENT timestamp (#PCDATA)>
  <!ELEMENT payload (chunk+)>
  <!ELEMENT chunk (#PCDATA)>
  <!ATTLIST chunk sequence NMTOKEN #REQUIRED compressed (yes|no) "no">
  <!ELEMENT trailer EMPTY>
  <!ATTLIST trailer status CDATA #IMPLIED>
]>
<transport>
  <header>
    <source>α-node</source>
    <destination>β-node</destination>
    <timestamp>2026-09-24T12:34:56+05:30</timestamp>
  </header>
  <payload>
    <chunk sequence="001" compressed="yes"><![CDATA[H4sIAAAAAA==]]></chunk>
    <chunk sequence="002">résumé — 数据 — 🚀</chunk>
    <chunk sequence="003" compressed="no">tail &amp; checksum</chunk>
  </payload>
  <trailer status="complete"/>
</transport>