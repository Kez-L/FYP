<?xml version="1.0"?>
<!DOCTYPE archive [
  <!ELEMENT archive (folder+, note?)>
  <!ELEMENT folder (entry*)>
  <!ATTLIST folder id ID #REQUIRED mode (open|sealed) "open">
  <!ELEMENT entry (title, data, checksum?)>
  <!ATTLIST entry key CDATA #REQUIRED>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT data (#PCDATA|part)*>
  <!ELEMENT part (#PCDATA)>
  <!ELEMENT checksum (#PCDATA)>
  <!ELEMENT note (#PCDATA)>
  <!ENTITY marker "A&amp;B&lt;C&gt;">
]>
<archive>
  <folder id="f1">
    <entry key="alpha">
      <title>First &marker;</title>
      <data>prefix<part>middle</part>suffix</data>
      <checksum>7f9e</checksum>
    </entry>
  </folder>
  <folder id="f2" mode="sealed"/>
  <note>archive-end</note>
</archive>