<?xml version="1.0"?>
<workspace xmlns:xi="http://www.w3.org/2001/XInclude"
           xmlns:cfg="urn:workspace:config"
           xml:base="file:///var/tmp/workspace/">
  <!-- Deliberately mixed content and namespace transitions -->
  <project name="delta" xml:lang="en">
    <summary>Build notes: <strong>ready</strong> for review.</summary>
    <cfg:options>
      <cfg:option name="jobs" value="4"/>
      <cfg:option name="cache" value="enabled"/>
      <cfg:paths>
        <cfg:path kind="source">src/main</cfg:path>
        <cfg:path kind="test">tests/unit</cfg:path>
      </cfg:paths>
    </cfg:options>
    <files>
      <file path="README.md" checksum="00000000">
        <metadata size="128" mode="0644"/>
