      <file path="assets/data.bin" checksum="deadbeef">
        <metadata size="0" mode="0600"/>
      </file>
      <file path="generated.xml">
        <xi:include href="fragments/generated.xml" parse="xml">
          <xi:fallback>
            <placeholder reason="missing">No generated fragment</placeholder>
          </xi:fallback>
        </xi:include>
      </file>
    </files>
    <commands>
      <command shell="sh"><![CDATA[printf '%s\n' "hello <world>"]]></command>
      <command shell="python">print("é")</command>
    </commands>
  </project>
</workspace>