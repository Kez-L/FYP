<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE report [
  <!ELEMENT report (header, section*)>
  <!ELEMENT header (#PCDATA)>
  <!ELEMENT section (title, para+)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT para (#PCDATA|br|ref)*>
  <!ELEMENT br EMPTY>
  <!ELEMENT ref (#PCDATA)>
  <!ATTLIST ref target ENTITY #REQUIRED>
  <!ENTITY logo SYSTEM "logo.bin" NDATA png>
  <!NOTATION png SYSTEM "image/png">
  <!ENTITY company "North &amp; South">
]>
<report>
  <header>&company; — quarterly review</header>
  <section id="intro">
    <title>Scope</title>
    <para>Measurements were collected<ref target="logo"> in three regions</ref>.<br/>No values were discarded.</para>
  </section>
  <section id="remarks">
    <title><![CDATA[Exceptions / edge cases]]></title>
    <para xml:space="default">A literal sequence such as <ref target="logo">A &lt; B</ref> is retained.</para>
  </section>
</report>