<?xml version="1.0"?>
<!DOCTYPE catalog [
  <!ELEMENT catalog (product*)>
  <!ELEMENT product (label, details, cost)>
  <!ATTLIST product sku ID #REQUIRED>
  <!ELEMENT label (#PCDATA)>
  <!ELEMENT details (#PCDATA|em|br)*>
  <!ELEMENT em (#PCDATA)>
  <!ELEMENT br EMPTY>
  <!ELEMENT cost (#PCDATA)>
  <!ENTITY % optional
    "<!ELEMENT badge (#PCDATA)>
     <!ATTLIST product badge CDATA #IMPLIED>">
  %optional;
  <!ENTITY currency "&#x20AC;">
]>
<catalog>
  <product sku="p001" badge="featured">
    <label>Widget</label>
    <details>small <em>blue</em><br/>replacement part</details>
    <cost>19.95 &currency;</cost>
    <badge>limited</badge>
  </product>
  <product sku="p002">
    <label>Bracket</label>
    <details>plain text only</details>
    <cost>0</cost>
  </product>
</catalog>