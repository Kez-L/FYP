<?xml version="1.0"?>
<!DOCTYPE catalog [
  <!ELEMENT catalog (section+, footer?)>
  <!ELEMENT section (heading, entry*)>
  <!ELEMENT heading (#PCDATA)>
  <!ELEMENT entry (#PCDATA|em|link|![CDATA[raw]])*>
  <!ELEMENT em (#PCDATA)>
  <!ELEMENT link (#PCDATA)>
  <!ELEMENT footer (#PCDATA)>
  <!ATTLIST catalog
    xmlns CDATA #FIXED "urn:catalog"
    version NMTOKEN "v1"
  >
  <!ATTLIST section
    xml:id ID #REQUIRED
    priority (low|normal|high) "normal"
  >
  <!ATTLIST link
    target URI #IMPLIED
  >
  <!ENTITY nbsp "&#160;">
]>
<catalog xmlns="urn:catalog" xmlns:x="urn:extra" version="v2">
  <section xml:id="intro" priority="high">
    <heading>Overview</heading>
    <entry>Text with <em>emphasis</em>, a <link target="urn:item:7">reference</link>, and &nbsp; padding.</entry>
    <entry><![CDATA[<literal angle brackets> & escaped text]]></entry>
    <?catalog-check level="strict"?>
  </section>
  <section xml:id="details">
    <heading x:label="extended">Details</heading>
    <entry>alpha<!-- embedded comment -->beta</entry>
  </section>
  <footer>End of catalog</footer>
</catalog>