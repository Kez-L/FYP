<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE graph [
  <!ELEMENT graph (node*, edge*)>
  <!ATTLIST graph directed (true|false) "true">
  <!ELEMENT node (label?, meta*)>
  <!ATTLIST node id ID #REQUIRED type CDATA #IMPLIED>
  <!ELEMENT label (#PCDATA)>
  <!ELEMENT meta (#PCDATA)>
  <!ATTLIST meta key NMTOKEN #REQUIRED>
  <!ELEMENT edge EMPTY>
  <!ATTLIST edge from IDREF #REQUIRED to IDREF #REQUIRED weight CDATA #IMPLIED>
  <!ENTITY arrow "&#x2192;">
  <!ENTITY % edgeinfo "<!ATTLIST edge note CDATA #IMPLIED>">
  %edgeinfo;
]>
<graph directed="false">
  <node id="n1" type="entry">
    <label>Start &arrow;</label>
    <meta key="color">red</meta>
    <meta key="empty"></meta>
  </node>
  <node id="n2">
    <label><![CDATA[Middle <node>]]></label>
  </node>
  <node id="n3"><meta key="quoted">&quot;end&quot;</meta></node>
  <edge from="n1" to="n2" weight="1.0" note="first"/>
  <edge from="n2" to="n3" weight="2&amp;3"/>
</graph>