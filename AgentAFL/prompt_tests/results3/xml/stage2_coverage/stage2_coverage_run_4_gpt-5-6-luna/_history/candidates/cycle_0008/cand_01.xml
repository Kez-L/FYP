<?xml version="1.0"?>
<!DOCTYPE warehouse [
  <!ENTITY % switches "<!ATTLIST warehouse mode CDATA 'closed'>">
  %switches;
  <![INCLUDE[
    <!ELEMENT warehouse (zone*)>
    <!ELEMENT zone (bin+)>
    <!ATTLIST zone code NMTOKEN #REQUIRED>
    <!ELEMENT bin (item*)>
    <!ATTLIST bin label CDATA #IMPLIED>
    <!ELEMENT item (#PCDATA)>
    <!ATTLIST item sku ID #IMPLIED>
  ]]>
  <![IGNORE[
    <!ELEMENT discarded EMPTY>
    <!ENTITY unused "ignored">
  ]]>
]>
<warehouse mode="open">
  <zone code="A-1">
    <bin label="upper"><item sku="x1">bolt</item><item>nut</item></bin>
    <bin label="lower"/>
  </zone>
  <zone code="B-7"><bin><item sku="x2">washer</item></bin></zone>
</warehouse>