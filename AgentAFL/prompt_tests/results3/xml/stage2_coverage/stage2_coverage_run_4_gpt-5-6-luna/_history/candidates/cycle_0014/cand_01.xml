<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE workspace [
  <!ELEMENT workspace (item|group)+>
  <!ELEMENT item (#PCDATA)>
  <!ELEMENT group (label, item*)>
  <!ELEMENT label (#PCDATA)>
  <!ATTLIST workspace xml:lang NMTOKEN "en">
  <!ATTLIST item key ID #REQUIRED state (new|open|closed) "new">
  <!ATTLIST group id ID #REQUIRED members IDREFS #IMPLIED>
  <!ENTITY open-bracket "&#x5B;">
  <!ENTITY close-bracket "&#x5D;">
]>
<workspace xml:lang="fr">
  <group id="g-main" members="i-one i-two">
    <label>Primary &open-bracket; group &close-bracket;</label>
    <item key="i-one" state="open">First item</item>
    <item key="i-two">Second item</item>
  </group>
  <item key="i-three" state="closed">Standalone item</item>
</workspace>