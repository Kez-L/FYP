<?xml version="1.0"?>
<!DOCTYPE scene [
  <!NOTATION png SYSTEM "image/png">
  <!ENTITY logo SYSTEM "logo.png" NDATA png>
  <!ENTITY greeting "hello">
  <!ENTITY nested "(&greeting;,&greeting;)">
  <!ELEMENT scene (actor*, prop*, caption)>
  <!ELEMENT actor EMPTY>
  <!ATTLIST actor
    name CDATA #REQUIRED
    role (lead|extra|silent) "extra"
    portrait ENTITY #IMPLIED
  >
  <!ELEMENT prop (#PCDATA)>
  <!ELEMENT caption (#PCDATA|span)*>
  <!ELEMENT span (#PCDATA)>
  <!ATTLIST span class NMTOKEN #IMPLIED>
]>
<scene xmlns="urn:stage" xmlns:x="urn:props">
  <actor name="Ada" role="lead" portrait="logo"/>
  <actor name="Echo" role="silent"/>
  <prop x:type="set">&nested;</prop>
  <prop x:type="number">42</prop>
  <caption>Opening <span class="quiet">(&greeting;)</span> scene</caption>
</scene>