<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE gallery [
  <!ELEMENT gallery (caption, image, caption?, image*)>
  <!ELEMENT caption (#PCDATA|strong|i)*>
  <!ELEMENT strong (#PCDATA)>
  <!ELEMENT i (#PCDATA)>
  <!ELEMENT image EMPTY>
  <!ATTLIST gallery xmlns CDATA #IMPLIED>
  <!ATTLIST image
    src CDATA #REQUIRED
    width NMTOKEN #IMPLIED
    height NMTOKEN #IMPLIED
  >
]>
<gallery xmlns="urn:example:gallery" xml:base="./assets/">
  <caption><strong>Snow</strong> <i>and</i> stone</caption>
  <image src="snow&amp;stone.png" width="640" height="480"/>
  <caption><![CDATA[ ]]></caption>
  <image src="nested/é.png"/>
  <image src="data.bin" width="0" height="000"/>
  <!-- a comment between sibling empty elements -->
  <?render profile="thumbnail" gamma="1.0"?>
</gallery>