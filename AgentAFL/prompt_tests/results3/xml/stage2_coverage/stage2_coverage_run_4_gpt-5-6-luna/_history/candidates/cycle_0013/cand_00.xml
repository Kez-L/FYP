<?xml version="1.0"?>
<!DOCTYPE museum [
  <!ENTITY % common "(painting|sculpture|installation)">
  <!ELEMENT museum (wing+, curator?)>
  <!ELEMENT wing (name, exhibit*)>
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT exhibit (%common;)>
  <!ELEMENT painting (#PCDATA)>
  <!ELEMENT sculpture (#PCDATA)>
  <!ELEMENT installation (#PCDATA|part)*>
  <!ELEMENT part (#PCDATA)>
  <!ELEMENT curator (#PCDATA)>
  <!ATTLIST wing code ID #REQUIRED>
  <!ATTLIST exhibit year NMTOKEN #IMPLIED>
  <!ENTITY ampersand "&amp;">
  <!ENTITY note "catalog &amp; inventory">
]>
<museum>
  <wing code="west">
    <name xml:lang="en">Modern &amp; Contemporary</name>
    <exhibit year="2024"><painting>Blue &amp; &quot;Gold&quot;</painting></exhibit>
    <exhibit year="2025"><installation>assembled <part>north</part><part>south</part> &amp; east</installation></exhibit>
  </wing>
  <wing code="east">
    <name><![CDATA[Classical <works>]]></name>
    <exhibit><sculpture>&note; &#x2603;</sculpture></exhibit>
  </wing>
  <curator>R&amp;D &amp; preservation</curator>
</museum>