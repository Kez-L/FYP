<?xml version="1.0" standalone="yes"?>
<!DOCTYPE report [
  <!ELEMENT report (section*)>
  <!ATTLIST report xml:space (default|preserve) "default">
  <!ELEMENT section (heading, paragraph+, list?)>
  <!ATTLIST section number NMTOKEN #REQUIRED>
  <!ELEMENT heading (#PCDATA|mark)*>
  <!ELEMENT paragraph (#PCDATA|mark|break)*>
  <!ELEMENT list (item+)>
  <!ELEMENT item (#PCDATA|mark)*>
  <!ELEMENT mark (#PCDATA)>
  <!ELEMENT break EMPTY>
  <!ENTITY nbsp "&#160;">
  <!ENTITY amp "&#38;">
]>
<report xml:space="preserve">
  <section number="01">
    <heading>Use <mark>carefully</mark>&nbsp;</heading>
    <paragraph>First line<break/>second line &amp; more.</paragraph>
    <paragraph><![CDATA[raw <markup> remains literal]]> and <mark>ends</mark>.</paragraph>
    <list>
      <item>one</item>
      <item>two &amp; three</item>
    </list>
  </section>
  <section number="02">
    <heading>Empty list boundary</heading>
    <paragraph>text</paragraph>
  </section>
</report>