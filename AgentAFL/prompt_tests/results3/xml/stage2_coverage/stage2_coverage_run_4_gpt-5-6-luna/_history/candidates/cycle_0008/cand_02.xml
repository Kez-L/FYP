<?xml version="1.0"?>
<!DOCTYPE scene [
  <!ELEMENT scene (layer*)>
  <!ELEMENT layer (shape|group)*>
  <!ATTLIST layer xmlns CDATA #IMPLIED name CDATA #REQUIRED>
  <!ELEMENT group (shape|group)*>
  <!ATTLIST group id ID #IMPLIED>
  <!ELEMENT shape EMPTY>
  <!ATTLIST shape kind (circle|path|text) #REQUIRED points CDATA #IMPLIED>
]>
<scene xmlns="urn:graphics:scene" xmlns:g="urn:graphics:geometry">
  <layer name="background">
    <g:shape kind="path" g:points="0,0 10,0 10,10"/>
    <group id="foreground">
      <shape kind="circle" points="5,5"/>
      <g:shape kind="text" points="2,8"/>
    </group>
  </layer>
  <layer name="labels"><shape kind="text" points="&quot;A&quot;"/></layer>
</scene>