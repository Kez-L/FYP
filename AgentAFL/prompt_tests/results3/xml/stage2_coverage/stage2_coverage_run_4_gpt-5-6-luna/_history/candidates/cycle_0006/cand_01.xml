<?xml version="1.0"?>
<!DOCTYPE packet [
  <!ELEMENT packet (meta, payload, signature?)>
  <!ELEMENT meta (origin, timestamp)>
  <!ELEMENT origin EMPTY>
  <!ATTLIST origin zone NMTOKEN #REQUIRED address CDATA #IMPLIED>
  <!ELEMENT timestamp (#PCDATA)>
  <!ELEMENT payload ANY>
  <!ELEMENT signature EMPTY>
  <!ATTLIST signature algorithm (sha1|sha256|none) "none" value CDATA #IMPLIED>
  <!ENTITY left "[">
  <!ENTITY right "]">
  <!ENTITY quoted "&lt;payload&gt;">
]>
<packet>
  <meta>
    <origin zone="edge-01" address="urn:node:alpha"/>
    <timestamp>2026-10-01T00:00:00Z</timestamp>
  </meta>
  <payload type="application/xml">&left;raw&amp;escaped&right; &quoted;</payload>
  <signature algorithm="sha256" value=""/>
</packet>