<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE catalog [
  <!ENTITY % common "id ID #REQUIRED xml:lang NMTOKEN 'en'">
  <!ELEMENT catalog (entry+, note?)>
  <!ELEMENT entry (name, summary, details?, link*)>
  <!ATTLIST entry
    %common;
    category (book|film|music|other) "other"
  >
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT summary (#PCDATA|em|code)*>
  <!ELEMENT details (#PCDATA|em|code|br)*>
  <!ELEMENT link EMPTY>
  <!ATTLIST link href URI #REQUIRED rel CDATA "related">
  <!ELEMENT em (#PCDATA)>
  <!ELEMENT code (#PCDATA)>
  <!ELEMENT br EMPTY>
  <!ELEMENT note (#PCDATA)>
  <!ENTITY mark "&#x2022;">
  <!ENTITY quoted "&quot;catalog&quot;">
]>
<catalog xml:base="https://example.invalid/root/">
  <entry id="e1" category="book">
    <name>Symbols &amp; Names</name>
    <summary>Alpha &mark; <em>beta</em> <code>&quoted;</code></summary>
    <details><![CDATA[raw <text> with ] characters]]><br/>tail</details>
    <link href="one.xml"/>
    <link href="two.xml" rel="alternate"/>
  </entry>
  <entry id="e2" xml:lang="de" category="other">
    <name>Überraschung</name>
    <summary>line one
line two&#x0A;line three</summary>
  </entry>
  <note>after entries</note>
</catalog>