<?xml version="1.0"?>
<!DOCTYPE catalog [
  <!NOTATION image SYSTEM "image/png">
  <!ENTITY cover SYSTEM "cover.png" NDATA image>
  <!ELEMENT catalog (section+)>
  <!ELEMENT section (title, item*)>
  <!ATTLIST section code ID #REQUIRED>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT item (#PCDATA|link|emph)*>
  <!ATTLIST item ref IDREF #IMPLIED media ENTITY #IMPLIED>
  <!ELEMENT link (#PCDATA)>
  <!ATTLIST link target CDATA #REQUIRED>
  <!ELEMENT emph (#PCDATA|link)*>
]>
<catalog>
  <section code="main">
    <title>Mixed content &amp; references</title>
    <item ref="missing">Before <emph>inside <link target="_blank">link</link></emph> after</item>
    <item media="cover">Unparsed resource</item>
  </section>
</catalog>