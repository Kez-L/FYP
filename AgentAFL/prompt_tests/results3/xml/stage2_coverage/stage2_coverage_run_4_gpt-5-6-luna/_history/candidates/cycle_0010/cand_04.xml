<?xml version="1.0"?>
<!DOCTYPE archive [
  <!ELEMENT archive (folder|record|alias)+>
  <!ELEMENT folder (folder|record|alias)*>
  <!ELEMENT record (key, payload, checksum?)>
  <!ELEMENT alias EMPTY>
  <!ELEMENT key (#PCDATA)>
  <!ELEMENT payload (#PCDATA|chunk|separator)*>
  <!ELEMENT chunk (#PCDATA)>
  <!ELEMENT separator EMPTY>
  <!ELEMENT checksum (#PCDATA)>
  <!ATTLIST folder name CDATA #REQUIRED hidden (yes|no) "no">
  <!ATTLIST record key-id ID #REQUIRED tags NMTOKENS #IMPLIED>
  <!ATTLIST alias target IDREF #REQUIRED>
  <!ATTLIST chunk encoding (plain|hex|base64) "plain">
  <!ATTLIST separator width NMTOKEN "1">
  <!ENTITY left-bracket "[">
  <!ENTITY right-bracket "]">
  <!ENTITY linebreak "&#x0D;&#x0A;">
]>
<archive>
  <folder name="2026" hidden="no">
    <record key-id="a17" tags="urgent external">
      <key>report-17</key>
      <payload>
        <chunk encoding="plain">begin &left-bracket;section&right-bracket;</chunk>
        <separator width="2"/>
        <chunk encoding="hex">4A6F7921</chunk>
        <chunk><![CDATA[raw << bytes >> remain]]></chunk>
      </payload>
      <checksum>9f02&linebreak;ab77</checksum>
    </record>
    <alias target="a17"/>
  </folder>
  <folder name="empty-folder"/>
  <record key-id="z9">
    <key>orphan</key>
    <payload>single text node</payload>
  </record>
</archive>