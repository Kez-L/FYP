<?xml version="1.0"?>
<!DOCTYPE dashboard [
  <!ELEMENT dashboard (section*)>
  <!ELEMENT section (heading, widget+)>
  <!ELEMENT heading (#PCDATA)>
  <!ELEMENT widget (caption?, value|table|markup)>
  <!ELEMENT caption (#PCDATA)>
  <!ELEMENT value (#PCDATA)>
  <!ELEMENT table (row+)>
  <!ELEMENT row (cell+)>
  <!ELEMENT cell (#PCDATA)>
  <!ELEMENT markup (#PCDATA|token)*>
  <!ELEMENT token (#PCDATA)>
  <!ATTLIST section xml:lang NMTOKEN #IMPLIED>
  <!ATTLIST widget id ID #REQUIRED role (metric|grid|note) "note">
  <!ENTITY badge "<token>ready</token>">
  <!ENTITY amp "&#38;">
]>
<ui:dashboard xmlns:ui="urn:interface:dashboard"
              xmlns:data="urn:interface:data"
              xml:base="https://example.invalid/ui/">
  <ui:section xml:lang="en-US">
    <ui:heading>Runtime <data:unit>overview</data:unit></ui:heading>
    <ui:widget id="cpu" role="metric">
      <ui:caption>Load</ui:caption>
      <ui:value>42% &amp; stable</ui:value>
    </ui:widget>
    <ui:widget id="grid" role="grid">
      <ui:table>
        <ui:row><ui:cell>alpha</ui:cell><ui:cell>βeta</ui:cell></ui:row>
        <ui:row><ui:cell><![CDATA[x < y && y > z]]></ui:cell><ui:cell>9&badge;</ui:cell></ui:row>
      </ui:table>
    </ui:widget>
  </ui:section>
</ui:dashboard>