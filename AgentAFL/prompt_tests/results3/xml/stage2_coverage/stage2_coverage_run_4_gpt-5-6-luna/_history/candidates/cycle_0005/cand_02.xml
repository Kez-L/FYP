<?xml version="1.0"?>
<!DOCTYPE message [
  <!ELEMENT message (meta, body, attachment*)>
  <!ELEMENT meta (sender, recipient+, reply-to?)>
  <!ELEMENT sender (#PCDATA)>
  <!ELEMENT recipient (#PCDATA)>
  <!ELEMENT reply-to (#PCDATA)>
  <!ELEMENT body (paragraph+, list?)>
  <!ELEMENT paragraph (#PCDATA|strong|link|br)*>
  <!ELEMENT strong (#PCDATA)>
  <!ELEMENT link (#PCDATA)>
  <!ATTLIST link href CDATA #REQUIRED>
  <!ELEMENT br EMPTY>
  <!ELEMENT list (item+)>
  <!ELEMENT item (#PCDATA|link)*>
  <!ELEMENT attachment EMPTY>
  <!ATTLIST attachment
    filename CDATA #REQUIRED
    media-type CDATA #REQUIRED
    size NMTOKEN #IMPLIED
  >
]>
<message>
  <meta>
    <sender>robot@example.invalid</sender>
    <recipient>one@example.invalid</recipient>
    <recipient>two@example.invalid</recipient>
    <reply-to>archive@example.invalid</reply-to>
  </meta>
  <body>
    <paragraph>Hello <strong>team</strong>.<br/>Please review the <link href="urn:case:42">case</link>.</paragraph>
    <paragraph>Symbols: &lt; &gt; &amp; &quot; &apos; and &#x20AC;.</paragraph>
    <list>
      <item>first</item>
      <item>second <link href="https://example.invalid/help">reference</link></item>
    </list>
  </body>
  <attachment filename="summary.txt" media-type="text/plain" size="128"/>
</message>