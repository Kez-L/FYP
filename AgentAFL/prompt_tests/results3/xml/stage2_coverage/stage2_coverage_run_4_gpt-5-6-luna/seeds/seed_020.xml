<?xml version="1.0"?>
<!DOCTYPE catalog [
  <!ENTITY % commonAttrs ' xml:lang NMTOKEN "en" xml:space (default|preserve) "default" '>
  <!ENTITY publisher "North &amp; South Press">
  <!NOTATION jpeg SYSTEM "image/jpeg">
  <!ENTITY cover SYSTEM "cover.jpg" NDATA jpeg>
  <!ELEMENT catalog (book+, supplement?)>
  <!ELEMENT book (title, author+, description?, coverref?)>
  <!ATTLIST book
    isbn ID #REQUIRED
    genre (fiction|essay|reference) "fiction"
    %commonAttrs;
  >
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT author (#PCDATA)>
  <!ELEMENT description (#PCDATA|em|quote)*>
  <!ELEMENT em (#PCDATA)>
  <!ELEMENT quote (#PCDATA)>
  <!ELEMENT coverref EMPTY>
  <!ATTLIST coverref image ENTITY #IMPLIED>
  <!ELEMENT supplement (entry*)>
  <!ELEMENT entry (#PCDATA)>
]>
<catalog>
  <book isbn="b-001" genre="essay" xml:lang="en">
    <title>Contours of &publisher;</title>
    <author>Ada North</author>
    <author>Sam South</author>
    <description xml:space="preserve">A <em>layered</em> account with <quote>short quotations</quote>.</description>
    <coverref image="cover"/>
  </book>
  <supplement>
    <entry>Index</entry>
    <entry>Errata</entry>
  </supplement>
</catalog>