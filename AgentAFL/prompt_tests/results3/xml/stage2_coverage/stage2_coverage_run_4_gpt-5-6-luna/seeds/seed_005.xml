<?xml version="1.0"?>
<!DOCTYPE archive [
  <!ELEMENT archive (section*)>
  <!ELEMENT section (title, record*)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT record (#PCDATA|label|![CDATA[ignored]])*>
  <!ELEMENT label (#PCDATA)>
  <!ATTLIST section
    id ID #REQUIRED
    xml:lang NMTOKEN "en"
  >
  <!ATTLIST record
    ref IDREF #IMPLIED
    kind (plain|marked|empty) "plain"
  >
]>
<archive>
  <section id="s-1" xml:lang="fr">
    <title>Résumé &amp; notes</title>
    <record kind="marked">before<label>inside</label>after</record>
    <record ref="missing" kind="empty"><![CDATA[]]></record>
  </section>
  <section id="s-2">
    <title>Second section</title>
    <record>line one
line two&#xA;line three</record>
  </section>
</archive>