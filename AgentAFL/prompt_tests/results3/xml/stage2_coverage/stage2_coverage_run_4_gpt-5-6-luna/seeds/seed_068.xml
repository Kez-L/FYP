<?xml version="1.0"?>
<!DOCTYPE media [
  <!NOTATION png SYSTEM "image/png">
  <!NOTATION text SYSTEM "text/plain">
  <!ENTITY mark "&#x2022;">
  <!ENTITY title "Encoded &amp; title">
  <!ELEMENT media (collection, manifest)>
  <!ELEMENT collection (asset*)>
  <!ELEMENT asset (caption|data)*>
  <!ELEMENT caption (#PCDATA)>
  <!ELEMENT data EMPTY>
  <!ELEMENT manifest (#PCDATA)>
  <!ATTLIST asset
    id ID #REQUIRED
    format NOTATION (png|text) #IMPLIED
    related IDREF #IMPLIED
  >
  <!ATTLIST data
    source ENTITY #IMPLIED
  >
]>
<media>
  <collection>
    <asset id="cover" format="png">
      <caption>&title; &mark; cover</caption>
      <data source="cover-file"/>
    </asset>
    <asset id="note" format="text" related="cover">
      <caption><![CDATA[plain <caption> data]]></caption>
      <data/>
    </asset>
  </collection>
  <manifest>cover &amp; note entries</manifest>
</media>