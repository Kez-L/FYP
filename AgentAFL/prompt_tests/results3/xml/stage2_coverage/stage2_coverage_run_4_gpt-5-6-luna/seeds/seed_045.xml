<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE catalog [
  <!ELEMENT catalog (entry+)>
  <!ELEMENT entry (title, meta?, description)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT meta EMPTY>
  <!ELEMENT description (#PCDATA|link|emphasis)*>
  <!ELEMENT link (#PCDATA)>
  <!ELEMENT emphasis (#PCDATA)>
  <!ATTLIST entry
    id ID #REQUIRED
    refs IDREFS #IMPLIED
    kind (book|map|other) "other"
    cover ENTITY #IMPLIED>
  <!ATTLIST meta
    format NMTOKENS #IMPLIED>
  <!ENTITY copyright "&#xA9; 2026">
  <!NOTATION png SYSTEM "image/png">
  <!ENTITY cover-image SYSTEM "cover.png" NDATA png>
]>
<catalog>
  <entry id="r1" kind="book" cover="cover-image">
    <title>Signals &amp; Symbols</title>
    <meta format="hardcopy illustrated"/>
    <description>
      A study of <emphasis>encoded</emphasis> marks,
      with a <link>cross-reference</link>.
      &copyright;
    </description>
  </entry>
  <entry id="r2" refs="r1" kind="map">
    <title>North / South</title>
    <description><![CDATA[coordinates: [12.50, -7.25] <unstable>]]></description>
  </entry>
</catalog>