<?xml version="1.0"?>
<!DOCTYPE dashboard [
  <!ELEMENT dashboard (panel+)>
  <!ELEMENT panel (caption, metric*)>
  <!ELEMENT caption (#PCDATA|em|strong)*>
  <!ELEMENT metric EMPTY>
  <!ELEMENT em (#PCDATA)>
  <!ELEMENT strong (#PCDATA)>
  <!ATTLIST panel
    key NMTOKEN #REQUIRED
    hidden (yes|no) "no"
  >
  <!ATTLIST metric
    name CDATA #REQUIRED
    value CDATA #IMPLIED
    unit CDATA "none"
  >
]>
<dashboard xmlns="urn:dashboard" xmlns:v="urn:value">
  <panel key="cpu" hidden="no">
    <caption>Load <strong>critical</strong> at <em>midnight</em></caption>
    <metric name="user" value="99.9" unit="%"/>
    <metric name="system" v:value="kernel" unit="ticks"/>
  </panel>
  <panel key="empty">
    <caption/>
  </panel>
</dashboard>