<?xml version="1.0"?>
<!DOCTYPE graph [
  <!ELEMENT graph (node+, edge*)>
  <!ELEMENT node (label?, data*)>
  <!ATTLIST node id ID #REQUIRED kind NMTOKEN #IMPLIED>
  <!ELEMENT label (#PCDATA)>
  <!ELEMENT data (#PCDATA|data)*>
  <!ATTLIST data key CDATA #REQUIRED>
  <!ELEMENT edge EMPTY>
  <!ATTLIST edge from IDREF #REQUIRED to IDREF #REQUIRED weight CDATA "1.0">
]>
<graph>
  <node id="n0" kind="root">
    <label>root</label>
    <data key="nested">a<data key="inner">b</data>c</data>
  </node>
  <node id="n1"/>
  <node id="n2"><data key="empty"></data></node>
  <edge from="n0" to="n1" weight="NaN"/>
  <edge from="n1" to="orphan"/>
</graph>