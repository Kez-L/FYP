<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE pulse [
  <!ENTITY % declarations
    "<!ELEMENT pulse (sample|note)*>
     <!ATTLIST pulse level NMTOKEN 'low' source CDATA #IMPLIED>">
  %declarations;
  <![INCLUDE[
    <!ELEMENT sample (#PCDATA)>
    <!ATTLIST sample at NMTOKEN #IMPLIED unit (ms|s|hz) "ms">
  ]]>
  <![INCLUDE[
    <!ELEMENT note (#PCDATA|mark)*>
    <!ELEMENT mark (#PCDATA)>
    <!ATTLIST mark color CDATA #IMPLIED>
  ]]>
  <!ENTITY quoted "He said &quot;measure twice&quot;">
  <!ENTITY fragment "<mark color='amber'>check</mark>">
]>
<pulse level="high" source="sensor-7">
  <sample at="0012" unit="ms">17.5</sample>
  <note>threshold <mark color="red">exceeded</mark></note>
  <sample at="0013">18&#x2E;0</sample>
  <note>&quoted;: &fragment;</note>
</pulse>