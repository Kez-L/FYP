<?xml version="1.0"?>
<!DOCTYPE report [
  <!ENTITY % mode "(summary|detail)">
  <!ELEMENT report (header, body, footer)>
  <!ELEMENT header (#PCDATA)>
  <!ELEMENT body (entry+)>
  <!ELEMENT entry (key, value, extra*)>
  <!ELEMENT key (#PCDATA)>
  <!ELEMENT value (#PCDATA)>
  <!ELEMENT extra (#PCDATA)>
  <!ELEMENT footer (#PCDATA)>
  <!ATTLIST entry mode %mode; "summary">
]>
<report>
  <header>daily &quot;delta&quot;</header>
  <body>
    <entry mode="detail">
      <key>temperature</key>
      <value>18.75</value>
      <extra>min=-2</extra>
      <extra>max=31</extra>
    </entry>
    <entry>
      <key>status</key>
      <value>nominal</value>
    </entry>
  </body>
  <footer>generated at 23:59:59</footer>
</report>