<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE media [
  <!ELEMENT media (title, asset+, note?)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT asset EMPTY>
  <!ELEMENT note (#PCDATA|link)*>
  <!ELEMENT link (#PCDATA)>
  <!ATTLIST media xmlns:m CDATA #IMPLIED>
  <!ATTLIST asset
    m:type NMTOKEN #REQUIRED
    src ENTITY #REQUIRED
    width NMTOKEN #IMPLIED
    height NMTOKEN #IMPLIED
  >
  <!NOTATION png SYSTEM "image/png">
  <!NOTATION svg SYSTEM "image/svg+xml">
  <!ENTITY logo SYSTEM "logo.png" NDATA png>
  <!ENTITY icon SYSTEM "icon.svg" NDATA svg>
]>
<media xmlns:m="urn:media">
  <title>Assets &quot;A/B&quot;</title>
  <asset m:type="raster" src="logo" width="001024" height="000768"/>
  <asset m:type="vector" src="icon" width="auto" height="auto"/>
  <note>See <link>external references</link> and <![CDATA[CDATA boundaries]]>.</note>
</media>