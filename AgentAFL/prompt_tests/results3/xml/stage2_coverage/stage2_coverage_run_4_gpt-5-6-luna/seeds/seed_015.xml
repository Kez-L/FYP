<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE catalog [
  <!ENTITY % declarations "
    <!ELEMENT catalog (entry+)>
    <!ELEMENT entry (name, summary, flag?)>
    <!ATTLIST entry code NMTOKEN #REQUIRED>
    <!ELEMENT name (#PCDATA)>
    <!ELEMENT summary (#PCDATA|em|ref)*>
    <!ELEMENT em (#PCDATA)>
    <!ELEMENT ref EMPTY>
    <!ATTLIST ref target NMTOKEN #REQUIRED>
    <!ELEMENT flag EMPTY>
    <!ATTLIST flag level (low|medium|high) 'low'>
  ">
  %declarations;
  <!ENTITY marker "<flag level='high'/>">
  <!ENTITY note "generated &amp; indexed">
]>
<catalog>
  <entry code="A_17">
    <name>North &amp; South</name>
    <summary>plain <em>highlighted</em> text<ref target="B_04"/> &note;</summary>
    &marker;
  </entry>
  <entry code="B_04">
    <name>Second item</name>
    <summary><![CDATA[content with <tags> and ]]> delimiters</summary>
    <flag/>
  </entry>
</catalog>