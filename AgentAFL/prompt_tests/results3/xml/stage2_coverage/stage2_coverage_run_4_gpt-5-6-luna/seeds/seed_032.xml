<?xml version="1.0"?>
<!DOCTYPE root [
  <!ENTITY % common "<!ELEMENT root (x|y),z?>">
  %common;
  <!ELEMENT x EMPTY>
  <!ELEMENT y (#PCDATA)>
  <!ELEMENT z (a,b?)>
  <!ELEMENT a EMPTY>
  <!ELEMENT b EMPTY>
  <!ATTLIST root mode CDATA "fallback">
  <!ATTLIST x flag (on|off) #IMPLIED>
]>
<root mode="&quot;odd&quot;">
  <y>text</y>
  <z><a/><b/></z>
</root>