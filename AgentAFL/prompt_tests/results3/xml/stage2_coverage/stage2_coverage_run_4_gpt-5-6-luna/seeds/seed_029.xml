<?xml version="1.0"?>
<!DOCTYPE archive [
  <!ENTITY % common '<!ELEMENT archive (entry*)><!ATTLIST archive format CDATA #IMPLIED>'>
  %common;
  <!ELEMENT entry (name, path, bytes, checksum?, note?)>
  <!ATTLIST entry id ID #IMPLIED status (new|old|deleted) "new">
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT path (#PCDATA)>
  <!ELEMENT bytes (#PCDATA)>
  <!ELEMENT checksum EMPTY>
  <!ATTLIST checksum type NMTOKEN #REQUIRED value CDATA #REQUIRED>
  <!ELEMENT note (#PCDATA|line)*>
  <!ELEMENT line EMPTY>
  <!ATTLIST line n NMTOKEN #IMPLIED>
]>
<archive format="tar">
  <entry id="f1" status="new">
    <name>α.txt</name>
    <path>/tmp/../α.txt</path>
    <bytes>00000000000000000001</bytes>
    <checksum type="sha256" value="deadbeef"/>
    <note>first<line n="1"/>second</note>
  </entry>
  <entry status="deleted">
    <name>gone</name>
    <path/>
    <bytes>-1</bytes>
  </entry>
</archive>