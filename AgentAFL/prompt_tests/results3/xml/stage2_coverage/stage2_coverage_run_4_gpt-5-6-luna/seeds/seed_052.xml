<?xml version="1.0" standalone="yes"?>
<!DOCTYPE dashboard [
  <!ELEMENT dashboard (meta, panel+)>
  <!ELEMENT meta EMPTY>
  <!ATTLIST meta
    version NMTOKEN #FIXED "v1"
    generated CDATA #IMPLIED
  >
  <!ELEMENT panel (heading?, widget*)>
  <!ATTLIST panel
    key ID #REQUIRED
    hidden (true|false) "false"
  >
  <!ELEMENT heading (#PCDATA)>
  <!ELEMENT widget (value, threshold?)>
  <!ATTLIST widget
    type (gauge|text|spark) #REQUIRED
    ref IDREF #IMPLIED
  >
  <!ELEMENT value (#PCDATA|unit)*>
  <!ELEMENT unit (#PCDATA)>
  <!ELEMENT threshold (#PCDATA)>
  <!ENTITY nbsp "&#160;">
  <!ENTITY open-brace "{">
  <!ENTITY close-brace "}">
]>
<dashboard>
  <meta version="v1" generated="2026-10-01T00:00:00Z"/>
  <panel key="main">
    <heading>Health &amp; Status</heading>
    <widget type="gauge" ref="secondary">
      <value>98<unit>%</unit>&nbsp;</value>
      <threshold>80</threshold>
    </widget>
    <widget type="text"><value><![CDATA[<unescaped> & bytes]]></value></widget>
  </panel>
  <panel key="secondary" hidden="true">
    <widget type="spark"><value>&open-brace;x=1&close-brace;</value></widget>
  </panel>
</dashboard>