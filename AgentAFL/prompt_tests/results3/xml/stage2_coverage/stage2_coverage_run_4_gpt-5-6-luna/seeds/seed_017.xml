<?xml version="1.0"?>
<!DOCTYPE gallery [
  <!NOTATION svg SYSTEM "image/svg+xml">
  <!NOTATION png PUBLIC "-//PNG//" "https://example.invalid/png">
  <!ENTITY cover SYSTEM "cover.svg" NDATA svg>
  <!ENTITY thumbnail SYSTEM "thumb.png" NDATA png>
  <!ELEMENT gallery (caption, image*, collection?)>
  <!ELEMENT caption (#PCDATA)>
  <!ELEMENT image EMPTY>
  <!ATTLIST image
    source ENTITY #REQUIRED
    width NMTOKEN #IMPLIED
    height NMTOKEN #IMPLIED
    format NOTATION (svg|png) #IMPLIED
  >
  <!ELEMENT collection (image+)>
  <!ATTLIST collection label CDATA #REQUIRED>
]>
<gallery>
  <caption>Referenced assets &amp; alternates</caption>
  <image source="cover" width="640" height="480" format="svg"/>
  <image source="thumbnail" format="png"/>
  <collection label="variants">
    <image source="cover" width="128"/>
  </collection>
</gallery>