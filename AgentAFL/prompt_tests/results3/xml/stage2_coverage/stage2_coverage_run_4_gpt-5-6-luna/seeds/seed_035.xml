<?xml version="1.0"?>
<!DOCTYPE catalog [
  <!NOTATION image SYSTEM "image/png">
  <!ENTITY logo SYSTEM "logo.png" NDATA image>
  <!ELEMENT catalog (entry+, footer?)>
  <!ELEMENT entry (title, description, asset*)>
  <!ATTLIST entry id ID #REQUIRED status (new|old|archived) "new">
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT description (#PCDATA|em|br)*>
  <!ELEMENT em (#PCDATA)>
  <!ELEMENT br EMPTY>
  <!ELEMENT asset EMPTY>
  <!ATTLIST asset href ENTITY #REQUIRED>
  <!ELEMENT footer (#PCDATA)>
]>
<catalog>
  <entry id="e1">
    <title>One</title>
    <description>Plain <em>mixed</em> text<br/>after.</description>
    <asset href="logo"/>
  </entry>
  <footer>End</footer>
</catalog>