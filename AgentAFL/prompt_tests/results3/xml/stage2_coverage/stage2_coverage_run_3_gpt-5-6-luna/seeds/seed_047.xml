<?xml version="1.0"?>
<!DOCTYPE report [
  <!ELEMENT report (section+)>
  <!ELEMENT section (heading, item*)>
  <!ELEMENT heading (#PCDATA)>
  <!ELEMENT item (#PCDATA|link|code)*>
  <!ELEMENT link (#PCDATA)>
  <!ELEMENT code (#PCDATA)>
  <!ATTLIST report xml:lang NMTOKEN #IMPLIED>
  <!ATTLIST section id ID #REQUIRED xml:space (default|preserve) "default">
  <!ATTLIST link href CDATA #REQUIRED rel (external|local) "local">
]>
<report xml:lang="en-US">
  <section id="intro" xml:space="preserve">
    <heading>  Introduction  </heading>
    <item>Use <code>--noout</code> to inspect the document.</item>
    <item>Visit <link href="https://example.org/a?x=1&amp;y=2" rel="external">the reference</link>.</item>
  </section>
  <section id="details">
    <heading>Details</heading>
    <item><![CDATA[raw <markup> and ]] characters]]></item>
    <item>Line one&#xA;line two&#x9;tab.</item>
  </section>
</report>