<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<!DOCTYPE vessel [
  <!ENTITY % optional "IGNORE">
  <![%optional;[
    <!ELEMENT hidden EMPTY>
    <!ATTLIST hidden forbidden CDATA #IMPLIED>
  ]]>
  <!ELEMENT vessel (header, payload, footer)>
  <!ELEMENT header EMPTY>
  <!ELEMENT payload (#PCDATA)>
  <!ELEMENT footer EMPTY>
  <!ATTLIST vessel
    xmlns:vh CDATA #IMPLIED
    state (armed|idle|sealed) "idle"
    checksum CDATA #IMPLIED
  >
  <!ATTLIST header
    source CDATA #FIXED "sensor"
    revision NMTOKEN #IMPLIED
  >
  <!ENTITY left "&lt;left&gt;">
  <!ENTITY right "&gt;right&lt;">
]>
