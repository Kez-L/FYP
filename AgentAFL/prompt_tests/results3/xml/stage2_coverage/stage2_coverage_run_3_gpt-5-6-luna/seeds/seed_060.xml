<?xml version="1.0"?>
<!DOCTYPE catalog [
  <!ELEMENT catalog (section+)>
  <!ELEMENT section (title, item*)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT item (name, price, description?)>
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT price (#PCDATA)>
  <!ELEMENT description (#PCDATA|em|code)*>
  <!ELEMENT em (#PCDATA)>
  <!ELEMENT code (#PCDATA)>
  <!ATTLIST catalog version CDATA #REQUIRED>
  <!ATTLIST section id ID #REQUIRED kind (books|tools|misc) "misc">
  <!ATTLIST item sku NMTOKEN #REQUIRED available (yes|no) "yes">
  <!ENTITY company "A &amp; B Trading">
  <!ENTITY mark "&#x2122;">
  <!ENTITY nested "&company; &mark;">
]>
<catalog version="2">
  <section id="s1" kind="books">
    <title>&company; catalog</title>
    <item sku="BK-001" available="yes">
      <name>Parsing &mark;</name>
      <price>19.95</price>
      <description>Useful <em>XML</em> and <code>DTD</code> notes.</description>
    </item>
  </section>
  <section id="s2">
    <title>Miscellaneous</title>
    <item sku="X_2" available="no">
      <name>Empty description</name>
      <price>0</price>
    </item>
  </section>
</catalog>