<?xml version="1.0"?>
<!DOCTYPE catalog [
  <!NOTATION jpeg SYSTEM "image/jpeg">
  <!ENTITY cover SYSTEM "cover.jpg" NDATA jpeg>
  <!ELEMENT catalog (entry+)>
  <!ELEMENT entry (title, metadata?, description)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT metadata EMPTY>
  <!ELEMENT description (#PCDATA|em|br)*>
  <!ELEMENT em (#PCDATA)>
  <!ELEMENT br EMPTY>
  <!ATTLIST catalog edition NMTOKEN #REQUIRED>
  <!ATTLIST entry code ID #REQUIRED cover ENTITY #IMPLIED>
  <!ATTLIST metadata year NMTOKEN #IMPLIED>
]>
<catalog edition="2026">
  <entry code="bk01" cover="cover">
    <title>Signals &amp; Symbols</title>
    <metadata year="0026"/>
    <description>Words with <em>embedded emphasis</em><br/>and a closing mark.</description>
  </entry>
</catalog>