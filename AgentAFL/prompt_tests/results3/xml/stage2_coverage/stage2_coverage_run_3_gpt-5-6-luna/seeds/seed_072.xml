<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE archive [
  <!ELEMENT archive (record*)>
  <!ATTLIST archive xmlns:r CDATA #FIXED "urn:records">
  <!ELEMENT record (r:key, r:value, metadata?)>
  <!ATTLIST record
    uid CDATA #REQUIRED
    kind (text|binary|link) #REQUIRED
  >
  <!ELEMENT metadata (tag*)>
  <!ELEMENT tag EMPTY>
  <!ATTLIST tag
    name CDATA #REQUIRED
    value CDATA #IMPLIED
  >
  <!ELEMENT r:key (#PCDATA)>
  <!ELEMENT r:value (#PCDATA|r:fragment)*>
  <!ELEMENT r:fragment (#PCDATA)>
  <!ENTITY open "&#x3C;">
  <!ENTITY close "&#x3E;">
]>
