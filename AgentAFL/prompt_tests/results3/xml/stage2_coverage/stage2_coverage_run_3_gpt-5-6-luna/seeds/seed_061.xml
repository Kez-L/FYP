        <row><cell>/api</cell><cell>3</cell><cell>47</cell></row>
      </table>
    </widget>
    <widget><note><b>Notice:</b> <i>&warning;</i></note></widget>
  </panel>
  <panel name="empty" collapsed="true"/>
