<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE dashboard [
  <!ELEMENT dashboard (meta, panel+, footer)>
  <!ELEMENT meta EMPTY>
  <!ELEMENT panel (heading, widget*)>
  <!ELEMENT heading (#PCDATA)>
  <!ELEMENT widget (value|table|note)>
  <!ELEMENT value (#PCDATA)>
  <!ELEMENT table (row+)>
  <!ELEMENT row (cell+)>
  <!ELEMENT cell (#PCDATA)>
  <!ELEMENT note (#PCDATA|b|i)*>
  <!ELEMENT b (#PCDATA)>
  <!ELEMENT i (#PCDATA)>
  <!ELEMENT footer (#PCDATA)>
  <!ATTLIST dashboard generated CDATA #IMPLIED>
  <!ATTLIST meta charset CDATA #FIXED "UTF-8" timestamp CDATA #IMPLIED>
  <!ATTLIST panel name NMTOKEN #REQUIRED collapsed (true|false) "false">
  <!ATTLIST widget key ID #IMPLIED>
  <!ATTLIST value unit (ms|bytes|count) #IMPLIED>
  <!ATTLIST cell span NMTOKEN "1">
  <!ENTITY nbsp "&#160;">
  <!ENTITY warning "Use &lt;safe&gt; values &amp; escape quotes">
]>
