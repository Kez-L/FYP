<?xml version="1.0"?>
<!DOCTYPE map [
  <!ELEMENT map (layer|group|point)*>
  <!ELEMENT layer (group|point)*>
  <!ATTLIST layer xmlns:geo CDATA #FIXED "urn:geo">
  <!ELEMENT group (point|group)*>
  <!ATTLIST group name CDATA #IMPLIED>
  <!ELEMENT point EMPTY>
  <!ATTLIST point geo:x CDATA #REQUIRED geo:y CDATA #REQUIRED>
  <!ENTITY west "12.5">
  <!ENTITY north "48.25">
]>
<map xmlns:geo="urn:geo" xmlns="urn:map">
  <layer>
    <group name="outer">
      <point geo:x="&west;" geo:y="&north;"/>
      <group name="nested">
        <point geo:x="-0.001" geo:y="+0"/>
      </group>
    </group>
  </layer>
  <point geo:x="NaN" geo:y="INF"/>
</map>