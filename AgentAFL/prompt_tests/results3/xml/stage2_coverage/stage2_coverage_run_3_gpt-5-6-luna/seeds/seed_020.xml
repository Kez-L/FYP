<?xml version="1.0"?>
<!DOCTYPE catalog [
  <!NOTATION png SYSTEM "image/png">
  <!ENTITY logo SYSTEM "assets/logo.png" NDATA png>
  <!ELEMENT catalog (entry*)>
  <!ELEMENT entry (#PCDATA|meta|img)*>
  <!ELEMENT meta EMPTY>
  <!ELEMENT img EMPTY>
  <!ATTLIST entry code ID #REQUIRED xml:lang NMTOKEN #IMPLIED>
  <!ATTLIST meta key CDATA #REQUIRED value CDATA #IMPLIED>
  <!ATTLIST img src ENTITY #REQUIRED alt CDATA "">
]>
<catalog xml:base="https://example.test/data/">
  <entry code="e-1" xml:lang="en">
    intro <meta key="kind" value="binary"/> payload
    <img src="logo" alt="&quot;mark&quot;"/>
  </entry>
  <entry code="e-2"><![CDATA[raw <markup> & bytes]]></entry>
</catalog>