<?xml version="1.0"?>
<!DOCTYPE catalog [
  <!ELEMENT catalog (item+, note?)>
  <!ELEMENT item (title, price, tag*)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT price (#PCDATA)>
  <!ELEMENT tag EMPTY>
  <!ELEMENT note (#PCDATA)>
  <!ATTLIST item
    id ID #REQUIRED
    related IDREFS #IMPLIED
    state (new|used|archived) "new"
    xml:lang NMTOKEN #IMPLIED
    cover ENTITY #IMPLIED>
  <!ATTLIST tag
    key CDATA #REQUIRED
    value CDATA #IMPLIED>
  <!ENTITY amp "&#38;">
  <!ENTITY currency "EUR">
  <!NOTATION jpeg SYSTEM "image/jpeg">
  <!ENTITY cover SYSTEM "cover.jpg" NDATA jpeg>
]>
<catalog>
  <item id="i001" state="new" cover="cover">
    <title>R&amp;D &amp; Field Notes</title>
    <price>19.95 &currency;</price>
    <tag key="format" value="print"/>
    <tag key="special" value="a&amp;b"/>
  </item>
  <item id="i002" related="i001" state="used" xml:lang="fr">
    <title>Archives</title>
    <price>7.50 &currency;</price>
  </item>
  <note xml:space="preserve">catalog &amp; inventory</note>
</catalog>