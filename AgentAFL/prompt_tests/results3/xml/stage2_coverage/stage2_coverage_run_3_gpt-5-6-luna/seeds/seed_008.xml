<?xml version="1.0"?>
<!DOCTYPE form [
  <!ENTITY label "User &amp; Token">
  <!ELEMENT form (field+, note?)>
  <!ELEMENT field EMPTY>
  <!ATTLIST field
    name NMTOKEN #REQUIRED
    value CDATA ""
    refs IDREFS #IMPLIED
    enabled (yes|no) "yes">
  <!ELEMENT note (#PCDATA)>
  <!ATTLIST note xml:space (default|preserve) "default">
]>
<form>
  <field name="user" value="alice" enabled="yes"/>
  <field name="token" value="&label;" refs="user"/>
  <field name="multi_name" value="a&#x20;b&#x9;c" enabled="no"/>
  <note xml:space="preserve">  leading
    whitespace &amp; entities  </note>
</form>