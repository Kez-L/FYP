<?xml version="1.0"?>
<!DOCTYPE report [
  <!ELEMENT report (section*)>
  <!ELEMENT section (heading, block+)>
  <!ATTLIST section xml:lang NMTOKEN "und">
  <!ELEMENT heading (#PCDATA)>
  <!ELEMENT block (#PCDATA|br|quote|list)*>
  <!ELEMENT br EMPTY>
  <!ELEMENT quote (#PCDATA)>
  <!ELEMENT list (item+)>
  <!ELEMENT item (#PCDATA|br)*>
  <!ENTITY intro "before">
  <!ENTITY nested "&intro; <quote>inside</quote> after">
]>
<report>
  <section xml:lang="en-US">
    <heading>Mixed report</heading>
    <block>&nested;<br/>tail<list><item>one</item><item>two<br/>two-b</item></list></block>
  </section>
  <section xml:lang="">
    <heading><![CDATA[heading ]]> with markup</heading>
    <block><quote>quoted &amp; escaped</quote><!-- boundary --></block>
  </section>
</report>