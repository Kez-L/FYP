<?xml version="1.0"?>
<!DOCTYPE catalog [
  <!ELEMENT catalog (section+)>
  <!ELEMENT section (title, entry*)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT entry (key, value, note?)>
  <!ELEMENT key (#PCDATA)>
  <!ELEMENT value (#PCDATA|item)*>
  <!ELEMENT item EMPTY>
  <!ELEMENT note (#PCDATA)>
  <!ATTLIST section code NMTOKEN #REQUIRED>
  <!ATTLIST entry priority (low|normal|high) "normal" xml:lang NMTOKEN #IMPLIED>
  <!ATTLIST item kind CDATA #IMPLIED amount CDATA #IMPLIED>
  <!ENTITY mark "&#x2022;">
  <!ENTITY wrapped "<item kind='generated' amount='&quot;7&quot;'/>">
]>
<catalog>
  <section code="A-01">
    <title>alpha &amp; omega</title>
    <entry priority="high" xml:lang="en">
      <key><![CDATA[compound/key]]></key>
      <value>left &mark; <item kind="inline" amount="0"/> right</value>
      <note><![CDATA[embedded ]]> marker ]]></note>
    </entry>
    <entry><key>second</key><value>&wrapped;</value></entry>
  </section>
  <section code="B_02">
    <title>empty section title</title>
  </section>
</catalog>