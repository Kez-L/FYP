    <key type="binary"><![CDATA[00ff00]]></key>
    <value>prefix<item index="000">zero</item><item index="1">&empty;</item>suffix</value>
    <metadata>
      <created>2026-09-24T00:00:00Z</created>
      <tag>one</tag>
      <tag>two &amp; three</tag>
    </metadata>
  </record>
  <record uid="r2" state="deleted">
    <key>missing</key>
    <value>&amp; &lt; &gt; &quot; &apos; &amp;</value>
  </record>
</registry>