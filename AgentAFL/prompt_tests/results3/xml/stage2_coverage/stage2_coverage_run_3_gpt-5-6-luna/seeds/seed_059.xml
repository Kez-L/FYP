<?xml version="1.0"?>
<!DOCTYPE registry [
  <!ELEMENT registry (record*)>
  <!ELEMENT record (key, value, metadata?)>
  <!ELEMENT key (#PCDATA)>
  <!ELEMENT value (#PCDATA|item)*>
  <!ELEMENT item (#PCDATA)>
  <!ELEMENT metadata (created?, tag*)>
  <!ELEMENT created (#PCDATA)>
  <!ELEMENT tag (#PCDATA)>
  <!ATTLIST record uid ID #REQUIRED state (new|old|deleted) #REQUIRED>
  <!ATTLIST key type (string|number|binary) "string">
  <!ATTLIST item index NMTOKEN #IMPLIED>
  <!ENTITY empty "">
  <!ENTITY amp "&amp;">
]>
<registry>
