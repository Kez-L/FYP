<?xml version="1.0"?>
<!DOCTYPE graph [
  <!ELEMENT graph (vertex+)>
  <!ELEMENT vertex (label, edge*)>
  <!ELEMENT label (#PCDATA)>
  <!ELEMENT edge EMPTY>
  <!ATTLIST graph xmlns:g CDATA #FIXED "urn:graph" root ID #REQUIRED>
  <!ATTLIST vertex id ID #REQUIRED kind (input|middle|output) #IMPLIED>
  <!ATTLIST edge to IDREF #REQUIRED weight CDATA "1.0" directed (yes|no) "yes">
  <!ENTITY amp "&amp;">
  <!ENTITY brackets "&lt;edge&gt;">
]>
<g:graph xmlns:g="urn:graph" root="v0">
  <g:vertex id="v0" kind="input">
    <g:label>start &amp; ready</g:label>
    <g:edge to="v1" weight="0.25"/>
    <g:edge to="v2" directed="no"/>
  </g:vertex>
  <g:vertex id="v1" kind="middle">
    <g:label>middle &amp; &lt;node&gt;</g:label>
    <g:edge to="v2" weight="2e0"/>
  </g:vertex>
  <g:vertex id="v2" kind="output">
    <g:label>end</g:label>
  </g:vertex>
</g:graph>