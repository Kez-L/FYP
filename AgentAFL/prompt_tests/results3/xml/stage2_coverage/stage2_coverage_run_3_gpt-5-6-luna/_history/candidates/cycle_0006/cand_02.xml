<?xml version="1.0"?>
<!DOCTYPE report [
  <!ENTITY % switches '
    <!ENTITY open "&#x5B;">
    <!ENTITY close "&#x5D;">
  '>
  %switches;
  <!ENTITY % optional "<!ELEMENT appendix (entry*)>">
  %optional;
  <!ELEMENT report (summary, data, appendix?)>
  <!ELEMENT summary (#PCDATA)>
  <!ELEMENT data (row*)>
  <!ELEMENT row (cell, cell, cell?)>
  <!ELEMENT cell (#PCDATA|value)*>
  <!ELEMENT value EMPTY>
  <!ELEMENT entry (label, value?)>
  <!ELEMENT label (#PCDATA)>
  <!ATTLIST report generated CDATA #IMPLIED>
  <!ATTLIST row n NMTOKEN #REQUIRED>
  <!ATTLIST cell kind (text|number|empty) "text">
  <!ATTLIST value v CDATA #IMPLIED>
  <![IGNORE[
    <!ELEMENT ignored EMPTY>
    <!ENTITY ghost "not-expanded">
  ]]>
]>
