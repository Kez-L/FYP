<?xml version="1.0"?>
<!DOCTYPE recursive [
  <!ELEMENT recursive (#PCDATA|branch|leaf)*>
  <!ELEMENT branch (#PCDATA|leaf|branch)*>
  <!ELEMENT leaf (#PCDATA)>
  <!ATTLIST branch depth NMTOKEN #IMPLIED>
  <!ENTITY a "A-&b;-Z">
  <!ENTITY b "B-&c;-Y">
  <!ENTITY c "C-&a;-X">
  <!ENTITY markup "<branch depth='entity'><leaf>expanded</leaf></branch>">
  <!ENTITY nbsp "&#160;">
]>
<recursive>
  prefix &nbsp; &markup; middle &a; suffix
  <branch depth="0"><leaf><![CDATA[&a; is literal here]]></leaf></branch>
</recursive>