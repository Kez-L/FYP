<?xml version="1.0"?>
<!DOCTYPE canvas [
  <!ELEMENT canvas (layer+)>
  <!ELEMENT layer (shape*)>
  <!ELEMENT shape EMPTY>
  <!ATTLIST canvas width NMTOKEN #REQUIRED height NMTOKEN #REQUIRED>
  <!ATTLIST layer z NMTOKEN #IMPLIED visible (yes|no) "yes">
  <!ATTLIST shape kind (line|circle|polygon) #REQUIRED points CDATA #IMPLIED>
  <!ATTLIST shape stroke CDATA #IMPLIED fill CDATA #IMPLIED>
]>
<canvas width="0000000000000000000000000000000000000000000001" height="NaN">
  <layer z="&#x2D;1" visible="no"/>
  <layer z="0">
    <shape kind="line" points="0,0 10,10" stroke="#000000" fill="none"/>
    <shape kind="circle" points="5,5,3" stroke="rgba(1,2,3,4)" fill="&#35;fff"/>
    <shape kind="polygon" points="0,0&#x20;1,0&#x20;1,1&#x20;0,1"/>
  </layer>
  <layer z="999999999999999999999999999999999999999999999999">
    <shape kind="line"/>
  </layer>
</canvas>