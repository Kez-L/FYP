<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE catalog [
  <!NOTATION jpeg SYSTEM "image/jpeg">
  <!ENTITY logo SYSTEM "logo.jpg" NDATA jpeg>
  <!ENTITY % commonAttrs '
    xml:lang NMTOKEN #IMPLIED
    xml:base CDATA #IMPLIED
  '>
  <!ELEMENT catalog (section+, note?)>
  <!ATTLIST catalog
    version NMTOKEN #REQUIRED
    %commonAttrs;
  >
  <!ELEMENT section (title, item*)>
  <!ATTLIST section code ID #REQUIRED>
  <!ELEMENT title (#PCDATA|emph)*>
  <!ELEMENT emph (#PCDATA)>
  <!ELEMENT item (name, price, description?)>
  <!ATTLIST item
    sku ID #REQUIRED
    image ENTITY #IMPLIED
    status (new|used|retired) "new"
  >
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT price (#PCDATA)>
  <!ELEMENT description (#PCDATA|emph|br)*>
  <!ELEMENT br EMPTY>
  <!ELEMENT note (#PCDATA)>
  <!ENTITY company "A &amp; B Supply">
  <!ENTITY legal "All prices include &company;.">
]>
<catalog version="2" xml:lang="en">
  <?audit source="seed"?>
  <section code="hardware">
    <title>Tools <emph>and</emph> parts</title>
    <item sku="sku-17" image="logo" status="used">
      <name>Adjustable wrench</name>
      <price>19.95</price>
      <description>Forged steel<br/>minor surface wear</description>
    </item>
    <item sku="sku-18">
      <name>Hex key set</name>
      <price>7.50</price>
    </item>
  </section>
  <note>&legal;</note>
</catalog>