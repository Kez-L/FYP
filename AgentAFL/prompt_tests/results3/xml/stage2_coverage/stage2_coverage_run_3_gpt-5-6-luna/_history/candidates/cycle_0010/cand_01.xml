<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE archive [
  <!ENTITY % common "(header, record+, trailer)">
  <!ELEMENT archive %common;>
  <!ELEMENT header (name, created)>
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT created (#PCDATA)>
  <!ELEMENT record (key, value, note?)>
  <!ELEMENT key (#PCDATA)>
  <!ELEMENT value ANY>
  <!ELEMENT note (#PCDATA)>
  <!ELEMENT trailer EMPTY>
  <!ATTLIST archive format (compact|expanded) "expanded">
  <!ATTLIST record uid ID #REQUIRED status (new|held|done) "new">
]>
<archive format="compact">
  <header>
    <name>delta</name>
    <created>2026-09-24T00:00:00Z</created>
  </header>
  <record uid="r-a" status="held">
    <key>alpha</key>
    <value><part index="1">A</part><part index="2">B</part></value>
    <note>pending review</note>
  </record>
  <record uid="r-b">
    <key>beta</key>
    <value>plain text</value>
  </record>
  <trailer/>
</archive>