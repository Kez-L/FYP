<?xml version="1.0"?>
<!DOCTYPE archive [
  <!ELEMENT archive (folder*)>
  <!ELEMENT folder (folder|file|description)*>
  <!ELEMENT file EMPTY>
  <!ELEMENT description (#PCDATA)>
  <!ATTLIST folder name CDATA #REQUIRED level NMTOKEN #IMPLIED>
  <!ATTLIST file name CDATA #REQUIRED size CDATA #IMPLIED kind (text|binary|link) "text">
  <!ENTITY nbsp "&#160;">
  <!ENTITY quote "&quot;">
  <!ENTITY literal "<not-an-element>">
  <!NOTATION bin SYSTEM "application/octet-stream">
  <!ENTITY payload SYSTEM "data.bin" NDATA bin>
]>
<archive>
  <folder name="root" level="0">
    <description>Files&nbsp;and &quote;notes&quote;</description>
    <file name="readme.txt" size="12" kind="text"/>
    <file name="image.bin" kind="binary"/>
    <folder name="nested">
      <description>&literal;</description>
    </folder>
  </folder>
</archive>