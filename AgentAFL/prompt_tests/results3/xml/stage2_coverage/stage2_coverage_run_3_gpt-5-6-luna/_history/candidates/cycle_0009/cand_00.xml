<?xml version="1.0"?>
<!DOCTYPE catalog [
  <!ELEMENT catalog (entry|note)*>
  <!ELEMENT entry (title, details?, link*)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT details (#PCDATA|emph|code)*>
  <!ELEMENT emph (#PCDATA)>
  <!ELEMENT code (#PCDATA)>
  <!ELEMENT link EMPTY>
  <!ELEMENT note (#PCDATA)>
  <!ATTLIST catalog xml:lang NMTOKEN #IMPLIED version CDATA "1">
  <!ATTLIST entry key ID #REQUIRED status (new|old|draft) "new">
  <!ATTLIST link href CDATA #REQUIRED rel NMTOKENS #IMPLIED>
  <!ENTITY brand "A &amp; B">
  <!ENTITY % extras "<!ELEMENT appendix (#PCDATA)>">
  %extras;
]>
