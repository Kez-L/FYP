<?xml version="1.0"?>
<!DOCTYPE shell [
  <!ELEMENT shell (header, body, trailer)>
  <!ELEMENT header (meta*)>
  <!ELEMENT meta EMPTY>
  <!ELEMENT body (section+)>
  <!ELEMENT section (heading, block*)>
  <!ELEMENT heading (#PCDATA)>
  <!ELEMENT block (#PCDATA|quote|line)*>
  <!ELEMENT quote (#PCDATA|line)*>
  <!ELEMENT line EMPTY>
  <!ELEMENT trailer (#PCDATA)>
  <!ATTLIST shell xmlns:p CDATA #FIXED "urn:parts" version CDATA #IMPLIED>
  <!ATTLIST meta p:key NMTOKEN #REQUIRED p:value CDATA #IMPLIED>
  <!ATTLIST section id ID #IMPLIED level (low|mid|high) "mid">
  <!ENTITY nbsp "&#160;">
  <!ENTITY phrase "left &nbsp; right">
]>
<shell xmlns:p="urn:parts" version="v&amp;1">
  <header>
    <meta p:key="alpha" p:value="&phrase;"/>
    <meta p:key="beta"/>
  </header>
  <body>
    <section id="s-a" level="high">
      <heading>First</heading>
      <block>one<line/>two<quote>three<line/>four</quote>five</block>
    </section>
    <section>
      <heading>Second &amp; final</heading>
      <block><![CDATA[x < y && z > q]]></block>
    </section>
  </body>
  <trailer>done</trailer>
</shell>