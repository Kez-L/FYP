<?xml version="1.0"?>
<!DOCTYPE matrix [
  <!ELEMENT matrix (row+)>
  <!ELEMENT row (cell+)>
  <!ELEMENT cell (#PCDATA|formula)*>
  <!ELEMENT formula EMPTY>
  <!ATTLIST matrix dimensions CDATA #IMPLIED>
  <!ATTLIST row index NMTOKEN #REQUIRED>
  <!ATTLIST cell coordinate CDATA #IMPLIED type (number|string|blank) "string">
  <!ATTLIST formula expression CDATA #REQUIRED result CDATA #IMPLIED>
  <!ENTITY amp "&amp;">
  <!ENTITY quote "&quot;">
  <!ENTITY recursive "&recursive;">
]>
<matrix dimensions="3x2">
  <row index="0">
    <cell coordinate="A1" type="number">001</cell>
    <cell coordinate="B1" type="string">A &amp; B <formula expression="SUM(A1)" result="1"/></cell>
  </row>
  <row index="1">
    <cell coordinate="A2" type="blank"/>
    <cell coordinate="B2"><![CDATA[raw <xml> data]]></cell>
  </row>
  <row index="2">
    <cell type="number">-0.0&#x09;NaN</cell>
    <cell coordinate="B3" type="string">&quote;quoted&quote; &amp;recursive;</cell>
  </row>
</matrix>