<?xml version="1.0"?>
<!DOCTYPE message [
  <!ELEMENT message (sender, recipients, subject, body)>
  <!ELEMENT sender (#PCDATA)>
  <!ELEMENT recipients (to+, cc*)>
  <!ELEMENT to (#PCDATA)>
  <!ELEMENT cc (#PCDATA)>
  <!ELEMENT subject (#PCDATA)>
  <!ELEMENT body (#PCDATA|quote|attachment|br)*>
  <!ELEMENT quote (#PCDATA|quote)*>
  <!ELEMENT attachment EMPTY>
  <!ELEMENT br EMPTY>
  <!ATTLIST message id ID #REQUIRED priority (low|normal|high) "normal">
  <!ATTLIST attachment name CDATA #REQUIRED size NMTOKEN #IMPLIED>
  <!ENTITY signature "&#x0A;--&#x0A;automated sender">
]>
<message id="m42" priority="high">
  <sender>sender@example.test</sender>
  <recipients>
    <to>one@example.test</to>
    <to>two@example.test</to>
    <cc>audit@example.test</cc>
  </recipients>
  <subject>Re: &quot;status&quot;</subject>
  <body>
    Opening line<br/>
    <quote>Earlier text <quote>nested quotation</quote> continues.</quote>
    <attachment name="report&#x2E;dat" size="18446744073709551615"/>
    Closing line&signature;
  </body>
</message>