<?xml version="1.0"?>
<!DOCTYPE screenplay [
  <!ELEMENT screenplay (act+)>
  <!ELEMENT act (heading, scene+)>
  <!ATTLIST act number NMTOKEN #REQUIRED>
  <!ELEMENT heading (#PCDATA)>
  <!ELEMENT scene (setting, cue*)>
  <!ATTLIST scene id ID #REQUIRED>
  <!ELEMENT setting (#PCDATA)>
  <!ELEMENT cue (speaker, line+)>
  <!ATTLIST cue ref IDREF #IMPLIED>
  <!ELEMENT speaker (#PCDATA)>
  <!ELEMENT line (#PCDATA|pause|aside)*>
  <!ELEMENT pause EMPTY>
  <!ATTLIST pause seconds CDATA "1">
  <!ELEMENT aside (#PCDATA)>
  <!ENTITY dash "&#x2014;">
  <!ENTITY quote "&quot;">
]>
<screenplay>
  <act number="I">
    <heading>Arrival</heading>
    <scene id="s1">
      <setting>Interior, late evening</setting>
      <cue ref="s1">
        <speaker>MARA</speaker>
        <line>I thought you said &quote;never again&quote;.</line>
        <line>There was a pause<pause seconds="0"/>then silence.</line>
        <line><aside>whispered</aside>We have until midnight &dash; no longer.</line>
      </cue>
    </scene>
  </act>
  <act number="II">
    <heading>Departure</heading>
    <scene id="s2">
      <setting>Exterior, dawn</setting>
      <cue>
        <speaker>ION</speaker>
        <line>Open the gate.</line>
      </cue>
    </scene>
  </act>
</screenplay>