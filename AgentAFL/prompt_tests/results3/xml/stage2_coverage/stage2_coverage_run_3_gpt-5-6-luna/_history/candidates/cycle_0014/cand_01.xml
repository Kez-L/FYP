<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE stream [
  <!ELEMENT stream (record*)>
  <!ELEMENT record (meta, data, checksum)>
  <!ELEMENT meta EMPTY>
  <!ELEMENT data (#PCDATA)>
  <!ELEMENT checksum (#PCDATA)>
  <!ATTLIST record id ID #REQUIRED previous IDREF #IMPLIED>
  <!ATTLIST meta timestamp CDATA #IMPLIED flags NMTOKENS #IMPLIED>
  <!ATTLIST data encoding (plain|base64|escaped) "plain">
  <!ENTITY lt "<">
  <!ENTITY gt ">">
  <!ENTITY pair "&lt;pair&gt;">
]>
<stream xmlns="urn:stream" xmlns:x="urn:extra">
  <record id="r1">
    <meta timestamp="1970-01-01T00:00:00Z" flags="a b c"/>
    <data encoding="escaped">before &lt;tag&gt; &amp; after</data>
    <checksum>0000</checksum>
  </record>
  <record id="r2" previous="r1">
    <meta flags="single"/>
    <data encoding="plain"><![CDATA[
      line one
      line two
      ]]>tail</data>
    <checksum>x&#13;y&#10;z</checksum>
  </record>
  <record id="r3" previous="unknown">
    <meta x:mode="odd" timestamp=""/>
    <data encoding="base64">&pair;</data>
    <checksum><![CDATA[--]]></checksum>
  </record>
</stream>