<?xml version="1.0"?>
<!DOCTYPE catalog [
  <!ELEMENT catalog (entry+, note?)>
  <!ELEMENT entry (title, price, description)>
  <!ATTLIST entry code ID #REQUIRED status (new|used|archived) "new">
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT price (#PCDATA)>
  <!ELEMENT description (#PCDATA|emph|ref)*>
  <!ELEMENT emph (#PCDATA)>
  <!ELEMENT ref EMPTY>
  <!ATTLIST ref target IDREF #REQUIRED>
  <!ELEMENT note (#PCDATA)>
  <!ENTITY copyright "©">
  <!ENTITY mark "<emph>special</emph>">
]>
<catalog>
  <entry code="p-17">
    <title>Odd &amp; Useful</title>
    <price>19.95</price>
    <description>A &copyright; <emph>compact</emph> device &mark; <ref target="p-17"/></description>
  </entry>
  <note>catalog-end</note>
</catalog>