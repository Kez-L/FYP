<?xml version="1.0"?>
<!DOCTYPE report [
  <!ELEMENT report (header, body, footer?)>
  <!ELEMENT header (#PCDATA)>
  <!ELEMENT body (section+)>
  <!ELEMENT section (title, paragraph*)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT paragraph (#PCDATA|em|strong)*>
  <!ELEMENT em (#PCDATA)>
  <!ELEMENT strong (#PCDATA)>
  <!ELEMENT footer EMPTY>
  <!ATTLIST section name ID #IMPLIED>
  <!ATTLIST footer stamp CDATA "none">
  <!ENTITY quote "&#34;quoted&#34;">
]>
<report>
  <header>&quote;</header>
  <body>
    <section name="first">
      <title>Alpha</title>
      <paragraph>plain <em>italic</em> and <strong>bold</strong>.</paragraph>
    </section>
    <section name="second">
      <title>Beta</title>
      <paragraph><![CDATA[line one
line two]]></paragraph>
    </section>
  </body>
  <footer/>
</report>