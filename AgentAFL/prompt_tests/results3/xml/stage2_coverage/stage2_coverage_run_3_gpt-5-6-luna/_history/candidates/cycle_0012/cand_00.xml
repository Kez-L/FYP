<?xml version="1.0"?>
<!DOCTYPE archive [
  <!ELEMENT archive (section+)>
  <!ELEMENT section (title, entry*)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT entry (#PCDATA|link|emphasis)*>
  <!ELEMENT link EMPTY>
  <!ELEMENT emphasis (#PCDATA)>
  <!ATTLIST section name NMTOKEN #REQUIRED>
  <!ATTLIST link href URI #IMPLIED>
  <!ENTITY intro "A &lt;carefully&gt; encoded introduction.">
  <!ENTITY nested "&intro; More text.">
]>
<archive>
  <section name="alpha">
    <title>&nested;</title>
    <entry>before <emphasis>inside</emphasis> after<link href="urn:x:y"/></entry>
    <entry><![CDATA[raw ]]> characters &amp; delimiters]]></entry>
  </section>
  <section name="omega">
    <title>Final</title>
  </section>
</archive>