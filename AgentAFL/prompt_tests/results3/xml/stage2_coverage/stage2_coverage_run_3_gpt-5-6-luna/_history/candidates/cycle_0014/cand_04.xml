<?xml version="1.0"?>
<!DOCTYPE timeline [
  <!ELEMENT timeline (event | gap | marker)*>
  <!ELEMENT event (when, label, details?)>
  <!ELEMENT gap EMPTY>
  <!ELEMENT marker EMPTY>
  <!ELEMENT when (#PCDATA)>
  <!ELEMENT label (#PCDATA)>
  <!ELEMENT details (#PCDATA|ref)*>
  <!ELEMENT ref EMPTY>
  <!ATTLIST event id ID #IMPLIED kind (start|stop|update) #REQUIRED>
  <!ATTLIST gap duration CDATA #REQUIRED reason CDATA #IMPLIED>
  <!ATTLIST marker name NMTOKEN #REQUIRED/>
  <!ATTLIST when zone CDATA #IMPLIED>
  <!ATTLIST ref target IDREF #REQUIRED>
  <!ENTITY open "(">
  <!ENTITY close ")">
  <!ENTITY nbsp "&#160;">
]>
<timeline xmlns:t="urn:timeline" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <event id="e0" kind="start">
    <when zone="UTC">2026-09-24T00:00:00Z</when>
    <label>boot &open;phase&close;</label>
    <details>initialized <ref target="e2"/> &nbsp;</details>
  </event>
  <gap duration="PT0S" reason="unspecified"/>
  <marker name="checkpoint"/>
  <event id="e1" kind="update">
    <when>not-a-date&#x0D;</when>
    <label><![CDATA[status ]]>changed<![CDATA[ ]]>again</label>
    <details><ref target="missing"/><t:ref target="e0"/></details>
  </event>
  <event id="e2" kind="stop">
    <when zone="">end</when>
    <label>final &amp; done</label>
  </event>
</timeline>