<?xml version="1.0"?>
<!DOCTYPE journal [
  <!ELEMENT journal (entry*)>
  <!ELEMENT entry (#PCDATA|em|ref)*>
  <!ELEMENT em (#PCDATA)>
  <!ELEMENT ref EMPTY>
  <!ATTLIST entry id ID #REQUIRED author CDATA #IMPLIED>
  <!ATTLIST ref target IDREF #REQUIRED kind (citation|link|footnote) "link">
  <!ENTITY sep " — ">
]>
<journal xmlns:lit="urn:literature" xml:lang="en">
  <?index mode="full"?>
  <!-- mixed content with namespace transitions -->
  <entry id="e1" author="A. Writer">A beginning&sep;<em>not an ending</em>
    <ref target="e2" kind="citation"/>.</entry>
  <entry id="e2" xmlns="urn:entry" lit:edition="draft">
    Plain text, <em>emphasis</em>, and a
    <ref target="e1"/> back-reference.
  </entry>
  <entry id="e3" xmlns="" xml:space="preserve"><![CDATA[
    whitespace, brackets ] ]>, and literal markup: <fake/>
  ]]></entry>
</journal>