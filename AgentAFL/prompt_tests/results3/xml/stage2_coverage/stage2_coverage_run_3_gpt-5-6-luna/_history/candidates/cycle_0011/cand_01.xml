<?xml version="1.1"?>
<!DOCTYPE packets [
  <!ELEMENT packets (packet+)>
  <!ELEMENT packet (header, body, trailer)>
  <!ELEMENT header EMPTY>
  <!ELEMENT body (chunk|body)*>
  <!ELEMENT chunk (#PCDATA)>
  <!ELEMENT trailer EMPTY>
  <!ATTLIST packet sequence NMTOKEN #REQUIRED channel CDATA #IMPLIED>
  <!ATTLIST header flags CDATA #IMPLIED stamp CDATA #IMPLIED>
  <!ATTLIST chunk id ID #IMPLIED next IDREF #IMPLIED>
  <!ENTITY % attrs '<!ATTLIST body mode (raw|folded) "folded">'>
  %attrs;
  <!ENTITY amp "&#38;">
  <!ENTITY wide "A&#x1F642;B">
]>
<packets>
  <packet sequence="0001" channel="Δ">
    <header flags="a&#x9;b" stamp="2026-09-24T00:00:00Z"/>
    <body mode="raw">
      <chunk id="c1" next="c2">one &amp; two</chunk>
      <body mode="folded"><chunk id="c2">&wide;</chunk></body>
    </body>
    <trailer/>
  </packet>
</packets>