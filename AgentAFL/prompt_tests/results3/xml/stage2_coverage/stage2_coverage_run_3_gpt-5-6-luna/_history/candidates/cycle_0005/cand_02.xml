<?xml version="1.0"?>
<!DOCTYPE document [
  <!ELEMENT document (section+)>
  <!ELEMENT section (title, body)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT body (#PCDATA|br|ref)*>
  <!ELEMENT br EMPTY>
  <!ELEMENT ref EMPTY>
  <!ATTLIST document xmlns CDATA #IMPLIED>
  <!ATTLIST section xml:id ID #REQUIRED kind CDATA #IMPLIED>
  <!ATTLIST ref target IDREF #REQUIRED>
]>
<document xmlns="urn:outer" xmlns:x="urn:cross" xml:lang="fr">
  <section xml:id="s1" kind="intro">
    <title>Résumé &amp; détails</title>
    <body>Texte<br/><x:ref target="s2" x:flag="yes"/>suite</body>
  </section>
  <section xml:id="s2">
    <title xmlns="urn:inner">Nested namespace</title>
    <body xmlns:x="urn:changed"><ref target="s1"/></body>
  </section>
</document>