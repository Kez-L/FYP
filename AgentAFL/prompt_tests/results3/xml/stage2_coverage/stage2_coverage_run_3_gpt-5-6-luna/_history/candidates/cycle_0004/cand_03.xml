<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE scene [
  <!ELEMENT scene (header, actor*, script)>
  <!ELEMENT header (title, author)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT author (#PCDATA)>
  <!ELEMENT actor EMPTY>
  <!ELEMENT script (line+)>
  <!ELEMENT line (#PCDATA|cue|pause)*>
  <!ELEMENT cue EMPTY>
  <!ELEMENT pause EMPTY>
  <!ATTLIST actor name CDATA #REQUIRED entrance (left|right|center) "center">
  <!ATTLIST line speaker CDATA #REQUIRED number NMTOKEN #IMPLIED>
  <!ATTLIST cue type (light|sound|set) #REQUIRED value CDATA #IMPLIED>
  <!ENTITY stage "the old theatre">
  <!ENTITY quote "&quot;">
]>
<scene xml:base="https://example.invalid/play/">
  <header>
    <title>Night at &stage;</title>
    <author>R. Example</author>
  </header>
  <actor name="Mira" entrance="left"/>
  <actor name="Keeper"/>
  <script>
    <line speaker="Mira" number="001">Is this <cue type="light" value="blue"/> still alive?</line>
    <line speaker="Keeper">Only in &quote;memory&quote;.</line>
    <line speaker="Mira">Then wait<cue type="pause"/><![CDATA[...]]>
      <cue type="sound" value="bell"/> begin.</line>
  </script>
  <?rehearse pass="two"?>
</scene>