<?xml version="1.0"?>
<!DOCTYPE matrix [
  <!ELEMENT matrix (row+)>
  <!ELEMENT row (cell+)>
  <!ELEMENT cell (#PCDATA)>
  <!ATTLIST matrix axis CDATA #IMPLIED>
  <!ATTLIST row index NMTOKEN #REQUIRED>
  <!ATTLIST cell kind (text|number|flag) "text" span NMTOKENS #IMPLIED>
  <!ENTITY amp "&amp;">
  <!ENTITY nested "A &amp; B &amp; C">
  <!ENTITY quote "left &quot; middle &apos; right">
]>
<matrix axis="r,c">
  <row index="zero">
    <cell kind="number" span="one two">001</cell>
    <cell kind="text">&nested;</cell>
    <cell kind="flag">true</cell>
  </row>
  <row index="one">
    <cell><![CDATA[raw ]]> text <![CDATA[ ]]> tail</cell>
    <cell kind="text">&quote; &amp; &#x1F642;</cell>
  </row>
</matrix>