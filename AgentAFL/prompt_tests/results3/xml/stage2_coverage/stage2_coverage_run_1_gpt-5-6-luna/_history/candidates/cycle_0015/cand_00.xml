<?xml version="1.0"?>
<!DOCTYPE package [
  <!ELEMENT package (metadata, payload)>
  <!ELEMENT metadata (name, checksum?, property*)>
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT checksum (#PCDATA)>
  <!ELEMENT property EMPTY>
  <!ELEMENT payload EMPTY>
  <!ATTLIST package xmlns:sec CDATA #FIXED "urn:security"
                    version NMTOKEN #REQUIRED>
  <!ATTLIST property key NMTOKEN #REQUIRED value CDATA #IMPLIED>
  <!ATTLIST payload source ENTITY #IMPLIED>
  <!NOTATION binary SYSTEM "application/octet-stream">
  <!ENTITY archive SYSTEM "archive.bin" NDATA binary>
]>
<package xmlns:sec="urn:security" version="2.7">
  <metadata>
    <name>sample</name>
    <checksum>sha256:0000000000000000</checksum>
    <property key="mode" value="sealed"/>
    <property key="owner"/>
  </metadata>
  <payload source="archive"/>
</package>