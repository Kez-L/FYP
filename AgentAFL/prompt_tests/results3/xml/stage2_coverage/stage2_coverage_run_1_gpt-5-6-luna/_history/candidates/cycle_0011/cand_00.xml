<?xml version="1.0"?>
<!DOCTYPE catalog [
  <!ELEMENT catalog (section+, note?)>
  <!ELEMENT section (title, entry*)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT entry (#PCDATA|link|emph)*>
  <!ELEMENT link EMPTY>
  <!ELEMENT emph (#PCDATA|emph)*>
  <!ELEMENT note (#PCDATA)>
  <!ATTLIST section id ID #REQUIRED>
  <!ATTLIST link href CDATA #REQUIRED target (self|external) "self">
  <!ENTITY copyright "&#xA9;">
]>
<catalog>
  <section id="s1">
    <title>References &copyright;</title>
    <entry>Plain <emph>mixed</emph> text<link href="urn:item:1"/>after the link.</entry>
    <entry><emph>Nested <emph>emphasis</emph></emph></entry>
  </section>
  <section id="s2">
    <title>Second section</title>
  </section>
  <note>Trailing note with &amp; and &lt; markup.</note>
</catalog>