<?xml version="1.0"?>
<!DOCTYPE tree [
  <!ENTITY % branchdecl "<!ELEMENT branch (leaf|branch)*>">
  %branchdecl;
  <!ELEMENT tree (branch)>
  <!ELEMENT leaf (#PCDATA)>
  <!ATTLIST tree root ID #REQUIRED>
  <!ATTLIST branch ref IDREF #IMPLIED count NMTOKEN "0">
  <!ATTLIST leaf kind (left|right|middle) #IMPLIED>
  <!ENTITY open "[" >
  <!ENTITY close "]" >
]>
<tree root="root-node">
  <branch ref="root-node" count="00">
    <leaf kind="left">&open;first&close;</leaf>
    <branch count="7">
      <leaf kind="middle">second</leaf>
      <leaf kind="right"/>
    </branch>
  </branch>
</tree>