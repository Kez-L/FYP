<?xml version="1.0"?>
<!DOCTYPE catalog [
  <!ELEMENT catalog (section+, note?)>
  <!ELEMENT section (title, entry*)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT entry (#PCDATA|link|emph)*>
  <!ELEMENT link EMPTY>
  <!ELEMENT emph (#PCDATA|emph)*>
  <!ELEMENT note (#PCDATA)>
  <!ATTLIST catalog xml:lang (en|fr|de) "en" edition CDATA #IMPLIED>
  <!ATTLIST section id ID #REQUIRED>
  <!ATTLIST link href URI #REQUIRED target (local|external) "local">
  <!ENTITY copyright "&#xA9; 2026">
]>
<catalog xml:lang="en" edition="draft">
  <section id="s-main">
    <title>Parser &amp; Namespace Tests</title>
    <entry>plain <emph>nested <emph>emphasis</emph></emph> text</entry>
    <entry><link href="urn:example:one" target="external"/>after-link</entry>
    <entry><![CDATA[characters such as <tag> and &entity; remain literal]]></entry>
  </section>
  <section id="s-extra">
    <title>Second Section</title>
    <entry>Copyright: &copyright;</entry>
  </section>
  <note xml:space="preserve"> trailing spaces </note>
</catalog>