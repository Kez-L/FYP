<?xml version="1.0"?>
<!DOCTYPE labyrinth [
  <!ELEMENT labyrinth (north|south|east|west)+>
  <!ELEMENT north (#PCDATA|turn)*>
  <!ELEMENT south (#PCDATA|turn)*>
  <!ELEMENT east (#PCDATA|turn)*>
  <!ELEMENT west (#PCDATA|turn)*>
  <!ELEMENT turn EMPTY>
  <!ATTLIST turn to (north|south|east|west) #REQUIRED count NMTOKEN "0">
  <!ENTITY % directions "<!ATTLIST labyrinth entry CDATA #IMPLIED>">
  %directions;
  <!ENTITY one "1">
  <!ENTITY two "&one;&one;">
  <!ENTITY four "&two;&two;">
]>
<labyrinth entry="spiral">
  <north>start<turn to="east" count="&four;"/>after</north>
  <east><turn to="south" count="&two;"/><![CDATA[&four;]]></east>
  <south>exit &amp; return</south>
</labyrinth>