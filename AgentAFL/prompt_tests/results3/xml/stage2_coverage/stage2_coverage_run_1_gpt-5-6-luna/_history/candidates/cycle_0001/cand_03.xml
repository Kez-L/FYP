<!DOCTYPE envelope [
  <!ELEMENT envelope (header, body)>
  <!ELEMENT header (token, token?)>
  <!ELEMENT token (#PCDATA)>
  <!ELEMENT body (chunk*)>
  <!ELEMENT chunk (#PCDATA|chunk)*>
]>
<envelope>
  <header>
    <token>one</token>
    <token><![CDATA[two]]></token>
  </header>
  <body>
    <chunk>outer<chunk>inner</chunk>tail</chunk>
    <chunk>&#xD;&#xA;&#x9;</chunk>
  </body>
</envelope>