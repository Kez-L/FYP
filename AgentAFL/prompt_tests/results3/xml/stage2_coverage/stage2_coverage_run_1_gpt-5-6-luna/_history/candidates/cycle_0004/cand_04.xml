<?xml version="1.0"?>
<!DOCTYPE archive [
  <!ELEMENT archive (chapter+)>
  <!ELEMENT chapter (title, section+)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT section (heading, paragraph+, quote?)>
  <!ELEMENT heading (#PCDATA)>
  <!ELEMENT paragraph (#PCDATA|term|line-break)*>
  <!ELEMENT term (#PCDATA)>
  <!ELEMENT line-break EMPTY>
  <!ELEMENT quote (#PCDATA|paragraph)*>
  <!ATTLIST chapter number NMTOKEN #REQUIRED>
  <!ATTLIST section id ID #REQUIRED>
  <!ATTLIST term key NMTOKEN #REQUIRED>
  <!ENTITY intro "A &lt;parser&gt; sees markup, not prose.">
  <!ENTITY nested "&intro; Again: &amp; safely.">
]>
<archive xml:lang="en">
  <chapter number="I">
    <title>Boundaries</title>
    <section id="s-one">
      <heading>Entity expansion</heading>
      <paragraph>&intro;</paragraph>
      <paragraph>Nested text: &nested;<line-break/>after the break.</paragraph>
      <paragraph>A <term key="lt">&lt;</term> sign and a <term key="gt">&gt;</term> sign.</paragraph>
      <quote>
        <paragraph>Quoted <emphasis>markup</emphasis> is not declared.</paragraph>
      </quote>
    </section>
    <section id="s-two">
      <heading><![CDATA[CDATA / comments]]></heading>
      <paragraph>Before<!-- embedded comment -->after</paragraph>
      <paragraph><![CDATA[raw ]]> characters &amp; entities]]></paragraph>
    </section>
  </chapter>
</archive>