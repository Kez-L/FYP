<?xml version="1.0"?>
<!DOCTYPE manifest [
  <!ELEMENT manifest (package, signature?, resource*)>
  <!ELEMENT package (name, files)>
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT files (file*)>
  <!ELEMENT file EMPTY>
  <!ELEMENT signature (digest, certificate)>
  <!ELEMENT digest (#PCDATA)>
  <!ELEMENT certificate (#PCDATA)>
  <!ELEMENT resource (location, checksum?)>
  <!ELEMENT location (#PCDATA)>
  <!ELEMENT checksum (#PCDATA)>
  <!ATTLIST manifest generated CDATA #IMPLIED>
  <!ATTLIST package id ID #REQUIRED format (zip|tar|dir) #REQUIRED>
  <!ATTLIST file path CDATA #REQUIRED mode NMTOKEN "0644" executable (yes|no) "no">
  <!ATTLIST resource type NOTATION (binary|text) #IMPLIED>
  <!NOTATION binary SYSTEM "application/octet-stream">
  <!NOTATION text SYSTEM "text/plain">
  <!ENTITY copyright "Copyright &#169; 2026">
]>
<manifest generated="yes">
  <package id="pkg-main" format="dir">
    <name>sample-package</name>
    <files>
      <file path="bin/run" mode="0755" executable="yes"/>
      <file path="data/a&amp;b.txt" mode="0640"/>
      <file path="empty" mode="0000"/>
    </files>
  </package>
  <signature>
    <digest><![CDATA[sha256:00<11>22]]></digest>
    <certificate>&copyright;</certificate>
  </signature>
  <resource type="text">
    <location>docs/README</location>
    <checksum>none</checksum>
  </resource>
</manifest>