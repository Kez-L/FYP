<!DOCTYPE report [
  <!ELEMENT report (section*)>
  <!ELEMENT section (heading, item*)>
  <!ELEMENT heading (#PCDATA)>
  <!ELEMENT item (#PCDATA|note|br)*>
  <!ELEMENT note (#PCDATA)>
  <!ELEMENT br EMPTY>
  <!ENTITY % common "xml:lang CDATA #IMPLIED xml:space (default|preserve) 'default'">
  <!ATTLIST section
    %common;
    code CDATA #REQUIRED>
]>
