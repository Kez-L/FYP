<?xml version="1.0"?>
<!DOCTYPE catalog [
  <!ELEMENT catalog (entry+)>
  <!ELEMENT entry (title, meta?, data)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT meta EMPTY>
  <!ELEMENT data ANY>
  <!ATTLIST entry
    id ID #REQUIRED
    status (new|old|archived) "new">
  <!ATTLIST meta
    key CDATA #IMPLIED
    value CDATA #IMPLIED>
]>
<catalog>
  <entry id="e1">
    <title>alpha &amp; beta</title>
    <meta key="source" value="import"/>
    <data><![CDATA[<not-an-element>&still-raw;</not-an-element>]]></data>
  </entry>
  <entry id="e2" status="archived">
    <title>line one
line two</title>
    <data>mixed <em>content</em> with &quot;quotes&quot;</data>
  </entry>
</catalog>