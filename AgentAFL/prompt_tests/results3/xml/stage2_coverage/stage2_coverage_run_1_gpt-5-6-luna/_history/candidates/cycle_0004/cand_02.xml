<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE map [
  <!ELEMENT map (point|route|legend)*>
  <!ELEMENT point EMPTY>
  <!ELEMENT route (from, to, via*)>
  <!ELEMENT from (#PCDATA)>
  <!ELEMENT to (#PCDATA)>
  <!ELEMENT via (#PCDATA)>
  <!ELEMENT legend (symbol+)>
  <!ELEMENT symbol (#PCDATA)>
  <!ATTLIST point x CDATA #REQUIRED y CDATA #REQUIRED label CDATA #IMPLIED>
  <!ATTLIST route id ID #REQUIRED color CDATA "black">
  <!ATTLIST symbol glyph CDATA #REQUIRED>
  <!NOTATION png SYSTEM "image/png">
  <!ENTITY icon SYSTEM "map.png" NDATA png>
  <!ENTITY greeting "Coordinates: &lt;x,y&gt;">
]>
<map xmlns="urn:cartography:v2" xmlns:g="urn:geo" xml:base="maps/">
  <point x="-73.9857" y="40.7484" label="tower"/>
  <g:point x="51.5007" y="-0.1246" label="clock"/>
  <route id="r-main" color="red">
    <from>tower</from>
    <to>clock</to>
    <via>ocean</via>
    <via><![CDATA[checkpoint <temporary>]]></via>
  </route>
  <legend>
    <symbol glyph="★">primary &greeting;</symbol>
    <symbol glyph="&amp;">alternate</symbol>
  </legend>
  <g:attachment href="map.png" notation="png"/>
</map>