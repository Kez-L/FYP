<?xml version="1.0"?>
<!DOCTYPE catalog [
  <!ELEMENT catalog (item | comment | empty)*>
  <!ELEMENT item (title, description?, price)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT description (#PCDATA|b|i|line)*>
  <!ELEMENT b (#PCDATA)>
  <!ELEMENT i (#PCDATA)>
  <!ELEMENT line EMPTY>
  <!ELEMENT price (#PCDATA)>
  <!ELEMENT comment (#PCDATA)>
  <!ATTLIST item sku ID #REQUIRED category NMTOKENS #IMPLIED featured (yes|no) "no">
  <!ATTLIST price currency (USD|EUR|JPY) #REQUIRED>
  <!ENTITY nbsp "&#160;">
  <!ENTITY quote "&quot;">
  <!ENTITY phrase "salt &amp; pepper">
]>
<catalog>
  <item sku="p-001" category="food pantry" featured="yes">
    <title>Mixed &quote;goods&quote;</title>
    <description>
      <b>Fresh</b><line/><i>seasonal</i> produce&nbsp;and &phrase;.
    </description>
    <price currency="EUR">12.50</price>
  </item>
  <comment><![CDATA[The sequence ]]> is split across CDATA sections.]]></comment>
  <empty/>
  <item sku="p-002" category="tools">
    <title>Plain item</title>
    <price currency="JPY">900</price>
  </item>
</catalog>