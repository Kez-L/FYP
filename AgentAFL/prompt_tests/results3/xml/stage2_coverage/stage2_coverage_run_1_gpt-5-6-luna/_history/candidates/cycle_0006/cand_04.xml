<?xml version="1.1"?>
<!DOCTYPE matrix [
  <!ELEMENT matrix (axis, axis, cells)>
  <!ELEMENT axis (point+)>
  <!ATTLIST axis direction (x|y) #REQUIRED>
  <!ELEMENT point EMPTY>
  <!ATTLIST point
    id ID #REQUIRED
    label CDATA #IMPLIED>
  <!ELEMENT cells (cell*)>
  <!ELEMENT cell EMPTY>
  <!ATTLIST cell
    x IDREF #REQUIRED
    y IDREF #REQUIRED
    value CDATA #IMPLIED
    flags NMTOKENS #IMPLIED>
  <!ENTITY nbsp "&#160;">
  <!ENTITY newline "&#x85;">
]>
<matrix>
  <axis direction="x">
    <point id="x1" label="zero"/>
    <point id="x2" label="one &nbsp;"/>
    <point id="x3" label="two"/>
  </axis>
  <axis direction="y">
    <point id="y1" label="first"/>
    <point id="y2" label="second"/>
  </axis>
  <cells>
    <cell x="x1" y="y1" value="0" flags="origin sparse"/>
    <cell x="x2" y="y1" value="1"/>
    <cell x="x3" y="y1" value="2 &newline;"/>
    <cell x="x1" y="y2" value="3" flags="computed"/>
    <cell x="x2" y="y2" value="4"/>
    <cell x="x3" y="y2" value="5 &amp; final"/>
  </cells>
</matrix>