<?xml version="1.0"?>
<!DOCTYPE network [
  <!ENTITY % nodeDecl "<!ELEMENT node EMPTY><!ATTLIST node key ID #REQUIRED label CDATA #IMPLIED>">
  %nodeDecl;
  <!ELEMENT network (node|edge|annotation)*>
  <!ELEMENT edge EMPTY>
  <!ATTLIST edge from IDREF #REQUIRED to IDREF #REQUIRED weight CDATA "1">
  <!ELEMENT annotation (#PCDATA)>
  <!ENTITY first "&second;">
  <!ENTITY second "&first;">
]>
<network>
  <node key="n1" label="alpha"/>
  <node key="n2" label="beta"/>
  <edge from="n1" to="n2" weight="0x10"/>
  <annotation><![CDATA[graph & topology]]></annotation>
  <node key="n3" label="&first;"/>
</network>