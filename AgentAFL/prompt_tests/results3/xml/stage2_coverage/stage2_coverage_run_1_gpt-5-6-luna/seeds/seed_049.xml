<?xml version="1.0"?>
<!DOCTYPE network [
  <!ELEMENT network (node+, link*)>
  <!ELEMENT node (label?, address*)>
  <!ELEMENT label (#PCDATA)>
  <!ELEMENT address EMPTY>
  <!ELEMENT link EMPTY>
  <!ATTLIST node id ID #REQUIRED class CDATA #IMPLIED>
  <!ATTLIST address scheme (ipv4|ipv6|dns) #REQUIRED value CDATA #REQUIRED>
  <!ATTLIST link from IDREF #REQUIRED to IDREF #REQUIRED weight NMTOKEN "1">
]>
<network>
  <node id="n0" class="edge">
    <label>root&#x0A;node</label>
    <address scheme="ipv4" value="127.0.0.1"/>
    <address scheme="ipv6" value="::1"/>
  </node>
  <node id="n1">
    <label><![CDATA[<branch>&value;</branch>]]></label>
    <address scheme="dns" value="xn--example-9za.invalid"/>
  </node>
  <link from="n0" to="n1" weight="0000000000000000000000000000000000007"/>
</network>