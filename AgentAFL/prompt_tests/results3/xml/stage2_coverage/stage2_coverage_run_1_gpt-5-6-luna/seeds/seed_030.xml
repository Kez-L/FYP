<?xml version="1.0"?>
<!DOCTYPE catalog [
  <!ELEMENT catalog (entry*, note)>
  <!ELEMENT entry (name, data, link*)>
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT data (#PCDATA|emph|br)*>
  <!ELEMENT emph (#PCDATA)>
  <!ELEMENT br EMPTY>
  <!ELEMENT link EMPTY>
  <!ELEMENT note (#PCDATA)>
  <!ATTLIST entry
    id ID #REQUIRED
    refs IDREFS #IMPLIED
    mode (cold|hot) "cold"
    asset ENTITY #IMPLIED
    xml:space (default|preserve) "default">
  <!ATTLIST link rel NMTOKENS #IMPLIED target IDREF #IMPLIED>
  <!NOTATION blob SYSTEM "application/octet-stream">
  <!ENTITY payload "A&amp;B &lt;encoded&gt;">
  <!ENTITY asset SYSTEM "urn:catalog:asset" NDATA blob>
]>
<catalog xmlns:meta="urn:metadata" meta:version="0.0">
  <?catalog instruction?>
  <entry id="first" refs="second" asset="asset" mode="hot" xml:space="preserve">
    <name><![CDATA[primary <entry> name]]></name>
    <data>before &payload; <emph>inside</emph><br/>after</data>
    <link rel="related alternate" target="second"/>
  </entry>
  <entry id="second">
    <name>secondary</name>
    <data><!-- embedded comment --><![CDATA[]]></data>
  </entry>
  <note xml:lang="x-klingon">end &#x20AC;</note>
</catalog>