<?xml version="1.0"?>
<!DOCTYPE dashboard [
  <!ELEMENT dashboard (widget*)>
  <!ELEMENT widget (label, metric?, table?)>
  <!ELEMENT label (#PCDATA)>
  <!ELEMENT metric (#PCDATA)>
  <!ELEMENT table (row+)>
  <!ELEMENT row (column+)>
  <!ELEMENT column (#PCDATA)>
  <!ATTLIST dashboard refresh CDATA "30" theme (light|dark|custom) "light">
  <!ATTLIST widget id ID #REQUIRED enabled (yes|no) "yes" class NMTOKENS #IMPLIED>
  <!ATTLIST metric unit CDATA #IMPLIED>
  <!ATTLIST row number NMTOKEN #REQUIRED>
  <!ENTITY amp "&amp;">
  <!ENTITY nested "A &amp; B">
]>
<dashboard refresh="0" theme="custom">
  <widget id="w.cpu" enabled="no" class="system primary">
    <label>CPU &amp; Memory</label>
    <metric unit="percent">99.9</metric>
    <table>
      <row number="01"><column>core</column><column>value</column></row>
      <row number="02"><column>0</column><column>&nested;</column></row>
    </table>
  </widget>
  <widget id="w.empty" class="unused">
    <label><![CDATA[empty metric]]></label>
  </widget>
  <widget id="w.note" enabled="yes">
    <label>Markers: &lt;start&gt; &amp; &quot;end&quot;</label>
    <metric>text &amp; symbols</metric>
  </widget>
</dashboard>