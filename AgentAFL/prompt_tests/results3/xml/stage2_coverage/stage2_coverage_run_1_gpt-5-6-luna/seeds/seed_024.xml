<!DOCTYPE package [
  <!NOTATION png SYSTEM "image/png">
  <!ENTITY logo SYSTEM "logo.png" NDATA png>
  <!ENTITY % feature "INCLUDE">
  <!ELEMENT package (manifest, body, checksum?)>
  <!ELEMENT manifest (file+)>
  <!ELEMENT file EMPTY>
  <!ATTLIST file
    name CDATA #REQUIRED
    type NOTATION (png|text) #IMPLIED
    data ENTITY #IMPLIED>
  <!ELEMENT body (part|separator)*>
  <!ELEMENT part (#PCDATA|highlight)*>
  <!ELEMENT highlight (#PCDATA)>
  <!ELEMENT separator EMPTY>
  <!ELEMENT checksum (#PCDATA)>
  <![%feature;[
    <!ATTLIST package format (v1|v2) "v2">
  ]]>
]>
<package format="v1">
  <manifest>
    <file name="logo.png" type="png" data="logo"/>
    <file name="readme.txt" type="text"/>
  </manifest>
  <body>
    <part>start <highlight>middle</highlight> end</part>
    <separator/>
    <part><![CDATA[<literal>tag</literal> & not markup]]></part>
  </body>
  <checksum>sha256:0000&amp;ffff</checksum>
</package>