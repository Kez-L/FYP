<?xml version="1.0"?>
<!DOCTYPE scene [
  <!ELEMENT scene (layer+)>
  <!ELEMENT layer (object*)>
  <!ELEMENT object (label?, geometry, metadata*)>
  <!ELEMENT label (#PCDATA)>
  <!ELEMENT geometry (point|box|path)>
  <!ELEMENT point EMPTY>
  <!ELEMENT box EMPTY>
  <!ELEMENT path (point+)>
  <!ELEMENT metadata (#PCDATA)>
  <!ATTLIST layer z CDATA #REQUIRED visible (true|false) "true">
  <!ATTLIST object key ID #REQUIRED kind CDATA #IMPLIED>
  <!ATTLIST point x CDATA #REQUIRED y CDATA #REQUIRED>
  <!ATTLIST box left CDATA #REQUIRED top CDATA #REQUIRED right CDATA #REQUIRED bottom CDATA #REQUIRED>
  <!ATTLIST path closed (yes|no) "no">
  <!ENTITY pi "3.14159">
]>
<scene>
  <layer z="0" visible="false">
    <object key="background" kind="rectangle">
      <geometry><box left="0" top="0" right="640" bottom="480"/></geometry>
      <metadata>color=#000000</metadata>
    </object>
  </layer>
  <layer z="1">
    <object key="shape" kind="polyline">
      <label>points &lt; &amp; paths</label>
      <geometry>
        <path closed="yes">
          <point x="0" y="0"/>
          <point x="10.5" y="-2"/>
          <point x="20" y="&#x2B;3"/>
        </path>
      </geometry>
      <metadata>circle approximation uses pi=&pi;</metadata>
    </object>
    <object key="marker">
      <geometry><point x="NaN" y="INF"/></geometry>
    </object>
  </layer>
</scene>