<?xml version="1.0"?>
<!DOCTYPE map [
  <!ELEMENT map (region*)>
  <!ELEMENT region (label, point+, boundary?)>
  <!ELEMENT label (#PCDATA)>
  <!ELEMENT point EMPTY>
  <!ELEMENT boundary (#PCDATA)>
  <!ATTLIST map xmlns CDATA #IMPLIED>
  <!ATTLIST region code NMTOKEN #REQUIRED xml:base URI #IMPLIED>
  <!ATTLIST point x CDATA #REQUIRED y CDATA #REQUIRED role (start|stop|turn) "turn">
  <!ENTITY degree "&#176;">
]>
<map xmlns="urn:geo:map" xmlns:g="urn:geo:point">
  <region code="north" xml:base="https://example.invalid/north">
    <label>North &degree; sector</label>
    <point g:lat="51.5" g:lon="-0.1" x="10" y="20" role="start"/>
    <point g:lat="51.6" g:lon="-0.2" x="30" y="40"/>
    <boundary xmlns="">
      This element has no default namespace and contains ordinary text.
    </boundary>
  </region>
  <region code="south">
    <label xml:lang="fr">Région sud</label>
    <point x="0" y="0" role="stop"/>
  </region>
</map>