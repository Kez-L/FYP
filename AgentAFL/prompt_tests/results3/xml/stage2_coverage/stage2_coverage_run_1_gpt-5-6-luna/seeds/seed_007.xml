<?xml version="1.0"?>
<!DOCTYPE map [
  <!ENTITY % switches "<!ELEMENT map (node|alias)*>">
  %switches;
  <!ELEMENT node (node|label|data)*>
  <!ATTLIST node xmlns CDATA #IMPLIED name CDATA #REQUIRED>
  <!ELEMENT alias EMPTY>
  <!ATTLIST alias target IDREF #REQUIRED>
  <!ELEMENT label (#PCDATA)>
  <!ELEMENT data (#PCDATA)>
  <!ENTITY left "L">
  <!ENTITY right "R">
]>
<map xmlns="urn:example:map" xmlns:x="urn:example:extra">
  <node name="root" id="base">
    <label>&left;&right;</label>
    <node name="branch">
      <label>nested</label>
      <data x:kind="bytes">00 7F FF</data>
      <alias target="base"/>
    </node>
    <node name="empty"/>
  </node>
</map>