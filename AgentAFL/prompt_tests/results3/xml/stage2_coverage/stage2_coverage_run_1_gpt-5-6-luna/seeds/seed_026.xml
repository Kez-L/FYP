<?xml version="1.0"?>
<!DOCTYPE report [
  <!ENTITY % common '<!ELEMENT report (title,body)>
    <!ELEMENT title (#PCDATA)>
    <!ELEMENT body (section+)>
    <!ELEMENT section (heading,para*)>
    <!ELEMENT heading (#PCDATA)>
    <!ELEMENT para (#PCDATA|code|br)*>
    <!ELEMENT code (#PCDATA)>
    <!ELEMENT br EMPTY>
    <!ATTLIST section level (one|two|three) "one">'>
  %common;
  <!ENTITY % optional "<!ELEMENT appendix (#PCDATA)>">
  <![INCLUDE[
    %optional;
    <!ATTLIST report appendix IDREF #IMPLIED>
  ]]>
  <!ENTITY amp "&amp;">
  <!ENTITY word "left-&amp;-right">
]>
<report appendix="extra">
  <title>Conditional sections &amp; parameter entities</title>
  <body>
    <section level="two">
      <heading>Overview</heading>
      <para>A &word; boundary <code>&lt;tag&gt;</code><br/>tail</para>
    </section>
    <section>
      <heading>Details</heading>
      <para>Numeric &#x1F642; and decimal &#128512; &amp; &amp;</para>
    </section>
  </body>
  <appendix>ignored by the body grammar but declared in the subset</appendix>
</report>