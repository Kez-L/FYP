<?xml version="1.0"?>
<!DOCTYPE network [
  <!ELEMENT network (node|link)*>
  <!ELEMENT node (label?, property*)>
  <!ELEMENT link EMPTY>
  <!ELEMENT label (#PCDATA)>
  <!ELEMENT property (#PCDATA)>
  <!ATTLIST node key ID #IMPLIED role NMTOKENS #IMPLIED>
  <!ATTLIST link from IDREF #REQUIRED to IDREF #REQUIRED weight CDATA "0">
  <!ATTLIST property name CDATA #REQUIRED>
  <!ENTITY % attrs '<!ATTLIST property xml:space (default|preserve) "default">'>
  %attrs;
]>
<network xmlns="urn:net" xmlns:x="urn:x" xml:lang="en">
  <node key="n1" role="source primary">
    <label>left&#x2028;right</label>
    <property name="x">one</property>
    <property name="y"><![CDATA[raw ]]> &amp; <![CDATA[ text]]></property>
  </node>
  <node key="n2" role="sink"/>
  <link from="n1" to="n2" weight="-0.0"/>
  <x:node key="n3" x:flag="yes">
    <x:label>foreign namespace</x:label>
  </x:node>
</network>