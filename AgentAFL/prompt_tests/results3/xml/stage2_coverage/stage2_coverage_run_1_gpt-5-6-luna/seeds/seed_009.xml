<?xml version="1.0"?>
<!DOCTYPE scene [
  <!NOTATION png SYSTEM "image/png">
  <!NOTATION text SYSTEM "text/plain">
  <!ENTITY icon SYSTEM "missing-image.png" NDATA png>
  <!ELEMENT scene (layer*)>
  <!ELEMENT layer (shape|use|comment)*>
  <!ATTLIST layer z CDATA "0">
  <!ELEMENT shape EMPTY>
  <!ATTLIST shape kind (line|circle|polygon) #REQUIRED points CDATA #IMPLIED>
  <!ELEMENT use EMPTY>
  <!ATTLIST use href URI #REQUIRED>
  <!ELEMENT comment (#PCDATA)>
  <!ATTLIST comment author CDATA #IMPLIED>
]>
<scene>
  <layer z="10">
    <shape kind="line" points="0,0 10,10"/>
    <shape kind="polygon" points="0,0;5,8;9,1"/>
    <use href="#shape-unknown"/>
    <comment author="&quot;renderer&quot;">unresolved reference &amp; fallback</comment>
  </layer>
  <layer>
    <comment><![CDATA[
      text containing ]]> is intentionally split ]]></comment>
    <shape kind="circle" points="4,4;2"/>
  </layer>
</scene>