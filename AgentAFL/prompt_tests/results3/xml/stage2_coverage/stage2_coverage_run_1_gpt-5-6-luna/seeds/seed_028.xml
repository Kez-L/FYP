    name NMTOKEN #REQUIRED
    datatype (string|integer|boolean) "string">
  <!ELEMENT value (#PCDATA)>
  <!ELEMENT text (#PCDATA)>
  <!ELEMENT fragment ANY>
  <!ENTITY open "&#x7B;">
  <!ENTITY close "&#x7D;">
]>
