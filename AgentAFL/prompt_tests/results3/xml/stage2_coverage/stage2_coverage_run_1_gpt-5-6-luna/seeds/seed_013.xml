<!DOCTYPE svgroot [
  <!ELEMENT svgroot (shape+)>
  <!ELEMENT shape (caption?, geometry)>
  <!ELEMENT caption (#PCDATA)>
  <!ELEMENT geometry EMPTY>
  <!ATTLIST shape
    id ID #IMPLIED
    class NMTOKENS #IMPLIED>
  <!ATTLIST geometry
    x CDATA "0"
    y CDATA "0"
    points CDATA #REQUIRED>
]>
<svgroot xmlns="urn:vector" xmlns:x="urn:extra">
  <shape id="s-1" class="hot highlighted">
    <caption>x &lt; y &amp; y &gt; z</caption>
    <geometry points="0,0 10,20 30,5" x="-1" y="+2"/>
  </shape>
  <shape class="single">
    <geometry points="&#x0A;1,2&#x0D;3,4"/>
  </shape>
</svgroot>