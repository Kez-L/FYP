<?xml version="1.0"?>
<!DOCTYPE catalog [
  <!ENTITY % common "sku ID #REQUIRED category CDATA #IMPLIED">
  <!ELEMENT catalog (section+)>
  <!ELEMENT section (item+, note?)>
  <!ATTLIST section name NMTOKEN #REQUIRED>
  <!ELEMENT item (title, price, metadata*)>
  <!ATTLIST item %common;>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT price (#PCDATA)>
  <!ELEMENT metadata EMPTY>
  <!ATTLIST metadata key CDATA #REQUIRED value CDATA #IMPLIED>
  <!ELEMENT note (#PCDATA|em|strong)*>
  <!ELEMENT em (#PCDATA)>
  <!ELEMENT strong (#PCDATA)>
]>
<catalog>
  <section name="hardware">
    <item sku="A-17" category="tools">
      <title>Threaded spindle</title>
      <price>19.95</price>
      <metadata key="unit" value="metric"/>
      <metadata key="origin"/>
    </item>
    <note>Limited <em>seasonal</em> stock and <strong>special</strong> handling.</note>
  </section>
  <section name="misc">
    <item sku="B-04">
      <title>Glass &amp; wire</title>
      <price>0.004</price>
    </item>
  </section>
</catalog>