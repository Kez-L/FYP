<?xml version="1.0"?>
<!DOCTYPE catalog [
  <!ELEMENT catalog (entry+, footer?)>
  <!ELEMENT entry (name, meta, value)>
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT meta EMPTY>
  <!ELEMENT value (#PCDATA|part)*>
  <!ELEMENT part (#PCDATA)>
  <!ELEMENT footer (#PCDATA)>
  <!ATTLIST catalog version NMTOKEN #REQUIRED>
  <!ATTLIST entry id ID #REQUIRED status (new|old|hold) "new">
  <!ATTLIST meta key NMTOKEN #REQUIRED data CDATA #IMPLIED>
  <!ENTITY left "[" >
  <!ENTITY right "]" >
]>
<catalog version="v1">
  <entry id="e&amp;1" status="hold">
    <name>alpha &lt; beta</name>
    <meta key="odd-key" data="a&#x0D;b&#x0A;c"/>
    <value>&left;<part>one</part><![CDATA[&middle;]]><part>two</part>&right;</value>
  </entry>
  <footer>tail</footer>
</catalog>