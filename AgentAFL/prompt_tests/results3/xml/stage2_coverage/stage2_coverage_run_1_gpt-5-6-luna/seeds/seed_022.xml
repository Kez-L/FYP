<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE graph [
  <!ELEMENT graph (node|edge)*>
  <!ELEMENT node EMPTY>
  <!ATTLIST node
    key ID #REQUIRED
    label CDATA #IMPLIED
    links IDREFS #IMPLIED>
  <!ELEMENT edge EMPTY>
  <!ATTLIST edge
    from IDREF #REQUIRED
    to IDREF #REQUIRED
    weight NMTOKEN "1">
  <!ENTITY % switches "<!ATTLIST graph mode (strict|loose) 'loose'>">
  %switches;
]>
<graph mode="strict">
  <node key="n&amp;1" label="unexpanded"/>
  <node key="n2" label="line&#xA;break" links="n1 n2"/>
  <edge from="n1" to="n2" weight="01"/>
  <?graph-processing instruction?>
  <!-- comment with -- forbidden-looking text -->
</graph>