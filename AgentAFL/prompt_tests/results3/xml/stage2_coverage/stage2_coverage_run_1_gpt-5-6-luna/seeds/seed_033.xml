<?xml version="1.0"?>
<!DOCTYPE matrix [
  <!ELEMENT matrix ANY>
  <!ELEMENT row ANY>
  <!ELEMENT cell (#PCDATA)>
  <!ATTLIST cell kind (text|number|empty) "text">
  <!ENTITY % discarded "<!ELEMENT hidden EMPTY><!ATTLIST hidden flag CDATA #IMPLIED>">
  <![IGNORE[
    <!ELEMENT ignored (never)>
    <!ENTITY ignoredEntity "discarded">
  ]]>
]>
<matrix xmlns:q="">
  <row index="1">
    <cell kind="number">42</cell>
    <cell kind="text"><![CDATA[1 < 2 && 3 > 2]]></cell>
  </row>
  <row index="2">
    <cell first="a" first="b">duplicate</cell>
  </row>
</matrix>