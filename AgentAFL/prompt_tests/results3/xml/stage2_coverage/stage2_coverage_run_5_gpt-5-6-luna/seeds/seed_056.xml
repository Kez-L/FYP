<?xml version="1.0"?>
<!DOCTYPE message [
  <!ELEMENT message (header, body, footer)>
  <!ELEMENT header (from, to, subject)>
  <!ELEMENT from EMPTY>
  <!ELEMENT to EMPTY>
  <!ELEMENT subject (#PCDATA)>
  <!ELEMENT body (#PCDATA|quote|br|link)*>
  <!ELEMENT quote (#PCDATA|quote)*>
  <!ELEMENT br EMPTY>
  <!ELEMENT link (#PCDATA)>
  <!ELEMENT footer (#PCDATA)>
  <!ATTLIST from address CDATA #REQUIRED>
  <!ATTLIST to address CDATA #REQUIRED>
  <!ATTLIST link href URI #REQUIRED>
  <!ENTITY intro "The following text contains &lt;markup&gt; and a tab&#x9;.">
]>
<message xml:lang="fr" xml:space="preserve">
  <header>
    <from address="alpha@example.test"/>
    <to address="beta@example.test"/>
    <subject>&quot;Re: status&quot;</subject>
  </header>
  <body>
    &intro;
    <br/>
    <quote>Outer <quote>nested quotation</quote> end.</quote>
    <link href="https://example.test/a?x=1&amp;y=2">follow-up</link>
  </body>
  <footer>— fin —</footer>
</message>