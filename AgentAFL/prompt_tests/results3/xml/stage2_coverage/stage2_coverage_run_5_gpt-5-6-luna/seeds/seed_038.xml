<?xml version="1.0"?>
<!DOCTYPE scene [
  <!ELEMENT scene (layer+)>
  <!ELEMENT layer (group|object|text)*>
  <!ATTLIST layer name CDATA #REQUIRED visible (true|false) "true">
  <!ELEMENT group (object|group)*>
  <!ATTLIST group transform CDATA #IMPLIED>
  <!ELEMENT object EMPTY>
  <!ATTLIST object id ID #REQUIRED kind CDATA #IMPLIED>
  <!ELEMENT text (#PCDATA)>
  <!ATTLIST text xml:space (default|preserve) "default">
]>
<scene>
  <layer name="background" visible="false"/>
  <layer name="foreground">
    <group transform="translate(1,2) rotate(45)">
      <object id="o1" kind="circle"/>
      <group transform="">
        <text xml:space="preserve">  padded
text  </text>
        <object id="o2"/>
      </group>
    </group>
  </layer>
</scene>