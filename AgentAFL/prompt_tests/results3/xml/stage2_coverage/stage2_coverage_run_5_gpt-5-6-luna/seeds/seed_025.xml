<?xml version="1.0"?>
<!DOCTYPE catalog [
  <!ENTITY % common "CDATA #IMPLIED">
  <!ELEMENT catalog (section+)>
  <!ELEMENT section (item*, note?)>
  <!ATTLIST section
    name NMTOKEN #REQUIRED
    active (yes|no) "yes">
  <!ELEMENT item (#PCDATA|label|value)*>
  <!ATTLIST item
    id ID #REQUIRED
    ref IDREFS #IMPLIED
    kind (alpha|numeric|mixed) "mixed">
  <!ELEMENT label (#PCDATA)>
  <!ELEMENT value (#PCDATA|emph)*>
  <!ELEMENT emph (#PCDATA)>
  <!ELEMENT note (#PCDATA)>
  <!ATTLIST note %common;>
]>
<catalog>
  <section name="main">
    <item id="i1" kind="alpha">
      <label>A</label>
      <value>left<emph>middle</emph>right</value>
    </item>
    <item id="i2" ref="i1" kind="numeric">
      <label>42</label>
      <value>1&amp;2&lt;3</value>
    </item>
    <note>tail</note>
  </section>
</catalog>