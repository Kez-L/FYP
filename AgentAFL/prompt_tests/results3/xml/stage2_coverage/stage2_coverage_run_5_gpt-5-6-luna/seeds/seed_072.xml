<?xml version="1.0"?>
<!DOCTYPE report [
  <!ELEMENT report (header, body, footer)>
  <!ELEMENT header (meta*)>
  <!ELEMENT meta EMPTY>
  <!ATTLIST meta name CDATA #REQUIRED value CDATA #IMPLIED>
  <!ELEMENT body (paragraph|table|quote|separator)*>
  <!ELEMENT paragraph (#PCDATA|link|mark)*>
  <!ELEMENT link (#PCDATA)>
  <!ATTLIST link href URI #REQUIRED>
  <!ELEMENT mark (#PCDATA)>
  <!ELEMENT table (row+)>
  <!ELEMENT row (cell+)>
  <!ELEMENT cell (#PCDATA|mark)*>
  <!ATTLIST cell span NMTOKEN "1">
  <!ELEMENT quote (#PCDATA|paragraph)*>
  <!ELEMENT separator EMPTY>
  <!ELEMENT footer (#PCDATA)>
]>
<report>
  <header>
    <meta name="author" value="A &amp; B"/>
    <meta name="revision"/>
  </header>
  <body>
    <paragraph>Start <link href="urn:x:test">linked</link> and <mark>marked</mark>.</paragraph>
    <table>
      <row><cell span="2">wide</cell></row>
      <row><cell>left</cell><cell>right &#13; edge</cell></row>
    </table>
    <separator/>
    <quote><paragraph><![CDATA[quoted <text> with ]]> inside]]></paragraph></quote>
  </body>
  <footer>done</footer>
</report>