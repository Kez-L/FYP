<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE catalog [
  <!ELEMENT catalog (section+)>
  <!ELEMENT section (title, item*)>
  <!ATTLIST section code ID #REQUIRED xml:lang NMTOKEN #IMPLIED>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT item (#PCDATA|em|link)*>
  <!ATTLIST item ref IDREF #IMPLIED status (new|used|archived) "new">
  <!ELEMENT em (#PCDATA)>
  <!ELEMENT link EMPTY>
  <!ATTLIST link href CDATA #REQUIRED>
  <!ENTITY mark "&#x2603;">
]>
<catalog xml:lang="fr">
  <section code="s1">
    <title>Résumé &amp; index &mark;</title>
    <item status="used">Texte <em>accentué</em> et <link href="urn:x"/> fin.</item>
  </section>
  <section code="s2" xml:lang="ja">
    <title>雪と風</title>
    <item ref="s1">référence</item>
  </section>
</catalog>