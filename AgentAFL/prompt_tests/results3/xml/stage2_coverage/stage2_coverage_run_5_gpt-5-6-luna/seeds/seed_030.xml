<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE catalog [
  <!ENTITY % common "<!ELEMENT entry (title,meta?,body)>">
  %common;
  <!ELEMENT catalog (section+)>
  <!ELEMENT section (entry|section)*>
  <!ATTLIST section code ID #IMPLIED>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT meta EMPTY>
  <!ATTLIST meta
    key NMTOKEN #REQUIRED
    value CDATA #IMPLIED>
  <!ELEMENT body (#PCDATA|em|br)*>
  <!ELEMENT em (#PCDATA|em)*>
  <!ELEMENT br EMPTY>
  <!ENTITY mark "&#x2063;">
]>
<catalog>
  <section code="root">
    <entry>
      <title>Alpha &mark; report</title>
      <meta key="status" value="draft"/>
      <body>left<em>nested <em>emphasis</em></em><br/>right</body>
    </entry>
    <section>
      <entry>
        <title><![CDATA[<literal> & boundaries]]></title>
        <body><![CDATA[first]]>&amp;<![CDATA[second]]></body>
      </entry>
    </section>
  </section>
</catalog>