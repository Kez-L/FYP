<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE catalog [
  <!ELEMENT catalog (section+)>
  <!ELEMENT section (title, item*)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT item (name, price, note?)>
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT price (#PCDATA)>
  <!ELEMENT note (#PCDATA|emph|code)*>
  <!ELEMENT emph (#PCDATA)>
  <!ELEMENT code (#PCDATA)>
  <!ATTLIST catalog xml:lang NMTOKEN #IMPLIED>
  <!ATTLIST section id ID #REQUIRED>
  <!ATTLIST item sku ID #REQUIRED status (active|retired) "active">
  <!ENTITY euro "&#x20AC;">
  <!ENTITY mark "<emph>limited</emph>">
]>
<catalog xml:lang="en">
  <section id="s1">
    <title>Odd &amp; Useful</title>
    <item sku="p-01" status="active">
      <name>Widget</name>
      <price>19.95 &euro;</price>
      <note>Seasonal <emph>offer</emph>; use <code>--fast</code> &mark;.</note>
    </item>
    <item sku="p-02" status="retired">
      <name><![CDATA[Bracket <test>]]></name>
      <price>0</price>
    </item>
  </section>
</catalog>