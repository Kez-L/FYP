<?xml version="1.0"?>
<!DOCTYPE drawing [
  <!ELEMENT drawing (layer+)>
  <!ELEMENT layer (group|shape|text)*>
  <!ELEMENT group (group|shape|text)*>
  <!ELEMENT shape EMPTY>
  <!ELEMENT text (#PCDATA)>
  <!ATTLIST drawing width NMTOKEN #REQUIRED height NMTOKEN #REQUIRED>
  <!ATTLIST layer name CDATA #REQUIRED visible (yes|no) "yes">
  <!ATTLIST group id ID #IMPLIED transform CDATA #IMPLIED>
  <!ATTLIST shape kind (rect|circle|path) #REQUIRED data CDATA #REQUIRED>
  <!ATTLIST text x NMTOKEN #REQUIRED y NMTOKEN #REQUIRED>
]>
<drawing xmlns:g="urn:geometry" width="800" height="600">
  <layer name="background" visible="no">
    <shape kind="rect" data="0,0,800,600"/>
  </layer>
  <layer name="foreground">
    <g:group id="grp-main" transform="translate(4 8)">
      <shape kind="circle" data="40,40,18"/>
      <g:group transform="scale(2)">
        <shape kind="path" data="M0 0 L10 20 Z"/>
        <text x="12" y="30">A &amp; B</text>
      </g:group>
    </g:group>
  </layer>
</drawing>