<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE graph [
  <!ELEMENT graph (node+, edge*)>
  <!ELEMENT node EMPTY>
  <!ELEMENT edge EMPTY>
  <!ATTLIST node
    id ID #REQUIRED
    label CDATA #IMPLIED
    refs IDREFS #IMPLIED>
  <!ATTLIST edge
    from IDREF #REQUIRED
    to IDREF #REQUIRED
    weight CDATA "1">
]>
<graph xmlns="urn:graph" xmlns:x="urn:extra" x:version="v1">
  <node id="root" label="A&amp;B"/>
  <node id="leaf" label="&quot;quoted&quot;" refs="root"/>
  <node id="isolated" refs="root leaf"/>
  <edge from="root" to="leaf" weight="0"/>
  <edge from="leaf" to="root" weight="-3.14"/>
</graph>