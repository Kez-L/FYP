<?xml version="1.0"?>
<!DOCTYPE world [
  <!ELEMENT world (region*)>
  <!ELEMENT region (label, city*)>
  <!ELEMENT label (#PCDATA)>
  <!ELEMENT city (name, landmark*, population?)>
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT landmark (#PCDATA)>
  <!ELEMENT population (#PCDATA)>
  <!ATTLIST region id ID #REQUIRED>
  <!ATTLIST city class (capital|port|village) "village">
  <!NOTATION map SYSTEM "application/x-map">
  <!ENTITY mapfile SYSTEM "maps/current.map" NDATA map>
]>
<world>
  <region id="north">
    <label xml:lang="en">Northern &amp; Islands</label>
    <city class="capital">
      <name>Northport</name>
      <landmark>Old Gate</landmark>
      <landmark>River &lt;Bridge&gt;</landmark>
      <population>1048576</population>
    </city>
    <city class="village">
      <name>Snowfield</name>
    </city>
  </region>
  <region id="south">
    <label xml:lang="fr">Région méridionale</label>
    <city class="port">
      <name>Baie-sur-Mer</name>
      <population>00042</population>
    </city>
  </region>
</world>