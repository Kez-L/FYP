<?xml version="1.0"?>
<!DOCTYPE catalog [
  <!ELEMENT catalog (section+)>
  <!ELEMENT section (title, item*)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT item (#PCDATA|price|note)*>
  <!ELEMENT price (#PCDATA)>
  <!ELEMENT note (#PCDATA)>
  <!ATTLIST section code ID #REQUIRED status (open|closed|draft) "open">
  <!ATTLIST item sku NMTOKEN #IMPLIED featured (yes|no) "no">
  <!ENTITY currency "€">
  <!ENTITY mark "<em>special</em>">
]>
<catalog>
  <section code="s1" status="draft">
    <title>Seasonal &amp; Miscellaneous</title>
    <item sku="A_01" featured="yes">
      citrus
      <price>12 &currency;</price>
      <note>limited &mark;</note>
    </item>
    <item sku="B-02">
      plain text
      <price>0</price>
    </item>
  </section>
  <section code="s2">
    <title>Empty inventory</title>
  </section>
</catalog>