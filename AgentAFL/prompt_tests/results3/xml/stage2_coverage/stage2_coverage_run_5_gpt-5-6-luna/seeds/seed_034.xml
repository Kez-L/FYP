<?xml version="1.0" encoding="UTF-16"?>
<!DOCTYPE matrix [
  <!ELEMENT matrix (row+)>
  <!ELEMENT row (cell+)>
  <!ATTLIST row number NMTOKEN #REQUIRED>
  <!ELEMENT cell (#PCDATA|formula)*>
  <!ATTLIST cell
    coordinate CDATA #IMPLIED
    kind (input|output|empty) "input">
  <!ELEMENT formula (#PCDATA)>
]>
<matrix>
  <row number="A">
    <cell coordinate="A1" kind="input">7</cell>
    <cell coordinate="B1"><formula><![CDATA[sum(A1:A3)]]></formula></cell>
  </row>
  <row number="B">
    <cell kind="empty"/>
    <cell coordinate="B2" kind="output">x<formula>+</formula>y</cell>
  </row>
  <row number="C">
    <cell coordinate="C3"><![CDATA[]]><![CDATA[tail]]></cell>
  </row>
</matrix>