<?xml version="1.0"?>
<!DOCTYPE catalog [
  <!ENTITY % itemdecl "<!ELEMENT item (name,price,details?)><!ATTLIST item code ID #REQUIRED status (new|used|refurbished) 'new'>">
  %itemdecl;
  <!ELEMENT catalog (section+)>
  <!ELEMENT section (title,item+)>
  <!ATTLIST section id ID #REQUIRED xml:lang NMTOKEN #IMPLIED>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT price (#PCDATA)>
  <!ELEMENT details (#PCDATA|em|strong)*>
  <!ELEMENT em (#PCDATA)>
  <!ELEMENT strong (#PCDATA)>
  <!ENTITY mark "A &amp; B">
]>
<catalog>
  <section id="s1" xml:lang="en">
    <title>Inventory</title>
    <item code="i1" status="new">
      <name>&mark;</name>
      <price>19.95</price>
      <details>boxed <strong>and</strong> <em>sealed</em></details>
    </item>
  </section>
</catalog>