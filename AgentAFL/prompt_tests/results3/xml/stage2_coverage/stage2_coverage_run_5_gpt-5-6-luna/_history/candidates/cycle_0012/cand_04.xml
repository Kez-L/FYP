<?xml version="1.0"?>
<!DOCTYPE dashboard [
  <!ELEMENT dashboard (widget+)>
  <!ELEMENT widget (label?, value?, action*)>
  <!ELEMENT label (#PCDATA)>
  <!ELEMENT value (#PCDATA|unit)*>
  <!ELEMENT unit (#PCDATA)>
  <!ELEMENT action (#PCDATA)>
  <!ATTLIST dashboard refresh NMTOKEN "30">
  <!ATTLIST widget id ID #REQUIRED type CDATA #REQUIRED enabled (true|false) "true">
  <!ATTLIST action event (click|hover|submit) #REQUIRED target IDREF #IMPLIED>
  <!ENTITY nbsp "&#160;">
  <!ENTITY quote "&#34;">
]>
<dashboard xmlns:x="urn:widgets" refresh="005">
  <widget id="cpu" type="gauge">
    <label>CPU usage</label>
    <value>87<unit>%</unit></value>
    <action event="hover" target="cpu">details</action>
  </widget>
  <widget id="msg" type="text" enabled="false">
    <label>Notice&nbsp;</label>
    <value>Use &quote;safe mode&quote; &amp; retry</value>
  </widget>
  <x:widget id="submit" type="button">
    <x:label>Send</x:label>
    <x:action event="click">dispatch</x:action>
  </x:widget>
</dashboard>