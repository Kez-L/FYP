<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE itinerary [
  <!ELEMENT itinerary (departure, route, arrival)>
  <!ATTLIST itinerary xml:space (default|preserve) "default">
  <!ELEMENT departure EMPTY>
  <!ATTLIST departure station NMTOKEN #REQUIRED at CDATA #REQUIRED>
  <!ELEMENT route (stop+, instruction*)>
  <!ELEMENT stop EMPTY>
  <!ATTLIST stop city CDATA #REQUIRED platform NMTOKEN #IMPLIED>
  <!ELEMENT instruction (#PCDATA|strong|br)*>
  <!ELEMENT strong (#PCDATA)>
  <!ELEMENT br EMPTY>
  <!ELEMENT arrival EMPTY>
  <!ATTLIST arrival station NMTOKEN #REQUIRED at CDATA #REQUIRED>
]>
<itinerary xml:space="preserve">
  <departure station="A-01" at="08:05"> </departure>
  <route>
    <stop city="München" platform="4"/>
    <stop city="東京" platform="B"/>
    <instruction>Board <strong>before</strong><br/>the signal &gt; changes.</instruction>
    <instruction><![CDATA[Keep spacing:
  exactly as written]]></instruction>
  </route>
  <arrival station="Z-9" at="19:40"/>
</itinerary>