<?xml version="1.0"?>
<!DOCTYPE catalog [
  <!ELEMENT catalog (entry*)>
  <!ELEMENT entry (title, meta?, value)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT meta EMPTY>
  <!ELEMENT value (#PCDATA|emph|br)*>
  <!ELEMENT emph (#PCDATA)>
  <!ELEMENT br EMPTY>
  <!ATTLIST entry id ID #REQUIRED status (new|old|archived) "new">
  <!ATTLIST meta key CDATA #IMPLIED>
]>
<catalog>
  <entry id="e1">
    <title>α &amp; Ω</title>
    <meta key="empty"/>
    <value>left<emph>middle</emph><br/>right</value>
  </entry>
  <entry id="e2" status="archived">
    <title><![CDATA[x < y && y > z]]></title>
    <value>one<emph><![CDATA[two]]></emph>three</value>
  </entry>
</catalog>