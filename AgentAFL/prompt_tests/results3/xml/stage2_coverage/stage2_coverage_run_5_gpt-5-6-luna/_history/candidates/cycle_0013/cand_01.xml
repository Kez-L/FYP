<?xml version="1.0"?>
<!DOCTYPE root [
  <!ENTITY % declarations '
    <!ELEMENT root (header, body, footer)>
    <!ELEMENT header EMPTY>
    <!ATTLIST header xml:lang NMTOKEN "und" mode (a|b|c) "b">
  '>
  %declarations;
  <!ELEMENT body (section+)>
  <!ELEMENT section (heading, paragraph*)>
  <!ELEMENT heading (#PCDATA)>
  <!ELEMENT paragraph (#PCDATA|em|br)*>
  <!ELEMENT em (#PCDATA)>
  <!ELEMENT br EMPTY>
  <!ELEMENT footer (#PCDATA)>
  <!ENTITY nbsp "&#160;">
  <!ENTITY quote "&quot;">
]>
<root xmlns="urn:root" xmlns:x="urn:extra">
  <header xml:lang="en-US" mode="c"/>
  <body>
    <section>
      <heading>One</heading>
      <paragraph>hello <em>world</em>&nbsp;<br/>again</paragraph>
      <paragraph>&quote;quoted&#x2F;text&quot;</paragraph>
    </section>
    <section>
      <heading>x:y</heading>
      <paragraph><![CDATA[ ]]>tail</paragraph>
    </section>
  </body>
  <footer>done</footer>
</root>