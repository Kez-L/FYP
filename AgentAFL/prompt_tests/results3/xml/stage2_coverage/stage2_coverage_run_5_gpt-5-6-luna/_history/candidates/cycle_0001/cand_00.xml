<?xml version="1.0"?>
<!DOCTYPE catalog [
  <!ELEMENT catalog (section+)>
  <!ELEMENT section (title, item*)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT item (#PCDATA|emph)*>
  <!ELEMENT emph (#PCDATA)>
  <!ATTLIST section id ID #REQUIRED kind (open|closed) "open">
  <!ENTITY note "catalog &amp; index">
]>
<catalog>
  <section id="s1" kind="open">
    <title>&note;</title>
    <item>alpha <emph>one</emph> and beta</item>
    <item>symbols: &lt; &gt; &quot; &apos;</item>
  </section>
  <section id="s2">
    <title>second section</title>
    <item><![CDATA[raw text ]]> with a delimiter fragment</item>
  </section>
</catalog>