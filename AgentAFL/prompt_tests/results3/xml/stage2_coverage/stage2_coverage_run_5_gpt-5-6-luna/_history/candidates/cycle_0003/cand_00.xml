<?xml version="1.0"?>
<!DOCTYPE catalog [
  <!NOTATION png SYSTEM "image/png">
  <!ENTITY logo SYSTEM "logo.png" NDATA png>
  <!ELEMENT catalog (header, product*, footer)>
  <!ELEMENT header (#PCDATA)>
  <!ELEMENT product (name, price, image?)>
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT price (#PCDATA)>
  <!ELEMENT image EMPTY>
  <!ATTLIST product
    sku ID #REQUIRED
    status (new|used|archived) "new">
  <!ATTLIST image
    src ENTITY #REQUIRED
    alt CDATA #IMPLIED>
  <!ELEMENT footer (#PCDATA)>
]>
<catalog>
  <header xml:lang="en">Inventory &amp; availability</header>
  <product sku="p001" status="new">
    <name>Glass &lt;Bottle&gt;</name>
    <price currency="EUR">19.95</price>
    <image src="logo" alt="brand mark"/>
  </product>
  <product sku="p002" status="used">
    <name><![CDATA[Vintage ]]>Radio</name>
    <price currency="JPY">&#x5186;4200</price>
  </product>
  <footer>End of catalog</footer>
</catalog>