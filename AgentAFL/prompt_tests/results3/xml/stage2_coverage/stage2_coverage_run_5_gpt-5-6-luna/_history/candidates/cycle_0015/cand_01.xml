<?xml version="1.0"?>
<!DOCTYPE map [
  <!ELEMENT map (node+)>
  <!ELEMENT node (label, node*)>
  <!ELEMENT label (#PCDATA)>
  <!ATTLIST node key ID #REQUIRED ref IDREFS #IMPLIED>
  <!ENTITY left "west &amp; blue">
  <!ENTITY right "east &quot;red&quot;">
]>
<map>
  <node key="root" ref="a b">
    <label>&left;</label>
    <node key="a">
      <label>one</label>
    </node>
    <node key="b" ref="root">
      <label>&right;</label>
      <node key="c">
        <label>three &#x20; parts</label>
      </node>
    </node>
  </node>
</map>