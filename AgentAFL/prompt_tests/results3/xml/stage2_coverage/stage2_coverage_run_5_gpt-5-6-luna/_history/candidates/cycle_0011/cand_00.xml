<?xml version="1.0"?>
<!DOCTYPE catalog [
  <!ENTITY title "Fuzz &amp; Explore">
  <!ENTITY writer "A. Researcher">
  <!ENTITY % commonAttrs '<!ATTLIST entry xml:lang NMTOKEN "en" status (draft|final|archived) "draft">'>
  <!ELEMENT catalog (header, section+)>
  <!ELEMENT header (title, author, note?)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT author (#PCDATA)>
  <!ELEMENT note (#PCDATA|em|code)*>
  <!ELEMENT section (entry+)>
  <!ATTLIST section id ID #REQUIRED label CDATA #IMPLIED>
  <!ELEMENT entry (name, summary?, details?)>
  <!ATTLIST entry ref IDREF #IMPLIED>
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT summary (#PCDATA|em)*>
  <!ELEMENT details (para|code|em)*>
  <!ELEMENT para (#PCDATA|em|code|link)*>
  <!ELEMENT code (#PCDATA)>
  <!ELEMENT em (#PCDATA)>
  <!ELEMENT link (#PCDATA)>
  %commonAttrs;
]>
<catalog xml:base="urn:seed:catalog">
  <header>
    <title>&title;</title>
    <author>&writer;</author>
    <note>Use <em>carefully</em> with <code>&lt;tokens&gt;</code>.</note>
  </header>
  <section id="s-main" label="α">
    <entry ref="s-main" status="final">
      <name>First &amp; Primary</name>
      <summary>Short <em>annotated</em> summary.</summary>
      <details>
        <para>Line one <link>urn:item:1</link></para>
        <code>if (x &lt; 2) return &quot;ok&quot;;</code>
      </details>
    </entry>
  </section>
</catalog>