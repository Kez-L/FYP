<?xml version="1.0"?>
<!DOCTYPE message [
  <!ELEMENT message (header, body, trailer?)>
  <!ELEMENT header (from, to, subject)>
  <!ELEMENT from (#PCDATA)>
  <!ELEMENT to (#PCDATA)>
  <!ELEMENT subject (#PCDATA)>
  <!ELEMENT body (paragraph|quote|br|list)*>
  <!ELEMENT paragraph (#PCDATA|em|strong|br)*>
  <!ELEMENT quote (#PCDATA|paragraph)*>
  <!ELEMENT br EMPTY>
  <!ELEMENT list (entry+)>
  <!ELEMENT entry (#PCDATA|em)*>
  <!ELEMENT em (#PCDATA)>
  <!ELEMENT strong (#PCDATA)>
  <!ELEMENT trailer (#PCDATA)>
  <!ATTLIST message priority (low|normal|high) "normal">
  <!ATTLIST quote source CDATA #IMPLIED>
]>
<message priority="high">
  <header>
    <from>alpha@example.test</from>
    <to>beta@example.test</to>
    <subject>Line &quot;one&quot; &amp; line two</subject>
  </header>
  <body>
    <paragraph>Hello <em>there</em><br/>This is <strong>mixed</strong> content.</paragraph>
    <quote source="archive">
      <paragraph>Nested quotation.</paragraph>
      <paragraph>Second <em>fragment</em>.</paragraph>
    </quote>
    <list>
      <entry>first</entry>
      <entry>second &apos;entry&apos;</entry>
    </list>
  </body>
  <trailer>done</trailer>
</message>