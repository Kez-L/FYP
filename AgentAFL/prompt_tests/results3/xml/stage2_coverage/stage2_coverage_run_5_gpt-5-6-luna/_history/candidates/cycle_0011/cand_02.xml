<?xml version="1.0"?>
<!DOCTYPE scene [
  <!NOTATION png SYSTEM "image/png">
  <!ENTITY logo SYSTEM "logo.png" NDATA png>
  <!ENTITY nbsp "&#160;">
  <!ELEMENT scene (metadata, layer*)>
  <!ELEMENT metadata (name, description?)>
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT description (#PCDATA|linebreak)*>
  <!ELEMENT linebreak EMPTY>
  <!ELEMENT layer (group|shape|use)*>
  <!ATTLIST layer id ID #REQUIRED z NMTOKEN #IMPLIED>
  <!ELEMENT group (shape|group|use)*>
  <!ATTLIST group transform CDATA #IMPLIED>
  <!ELEMENT shape (point*)>
  <!ATTLIST shape type (circle|rect|path) #REQUIRED fill CDATA "none" source ENTITY #IMPLIED>
  <!ELEMENT point EMPTY>
  <!ATTLIST point x CDATA #REQUIRED y CDATA #REQUIRED>
  <!ELEMENT use EMPTY>
  <!ATTLIST use href IDREF #REQUIRED>
]>
<scene xmlns="urn:graphics:scene" viewBox="0 0 640 480">
  <metadata>
    <name>Vector &amp; Raster</name>
    <description>Coordinates follow<linebreak/>a local origin.&nbsp;</description>
  </metadata>
  <layer id="background" z="0">
    <shape type="rect" fill="#fff"/>
  </layer>
  <layer id="foreground" z="1">
    <group transform="translate(10,20) scale(2)">
      <shape type="circle" source="logo">
        <point x="12.5" y="8"/>
        <point x="19" y="14"/>
      </shape>
      <use href="background"/>
    </group>
  </layer>
</scene>