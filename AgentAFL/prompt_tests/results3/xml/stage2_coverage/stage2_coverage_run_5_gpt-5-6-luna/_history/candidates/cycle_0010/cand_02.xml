<?xml version="1.1" encoding="UTF-8"?>
<!DOCTYPE museum [
  <!ELEMENT museum (artifact*)>
  <!ELEMENT artifact (description|location|owner)*>
  <!ELEMENT description (#PCDATA|emphasis)*>
  <!ELEMENT emphasis (#PCDATA)>
  <!ELEMENT location EMPTY>
  <!ELEMENT owner EMPTY>
  <!ATTLIST artifact xml:space (default|preserve) "default">
  <!ATTLIST location lat CDATA #REQUIRED lon CDATA #REQUIRED>
  <!ATTLIST owner since NMTOKEN #IMPLIED>
  <!ENTITY ampersand "&#38;">
]>
<museum xml:space="preserve">
  <artifact>
    <description>Stone <emphasis>fragment</emphasis> &amp; bronze</description>
    <location lat="+00.000" lon="-000.000"/>
    <owner since="0042"/>
  </artifact>
  <artifact xml:space="default">
    <description><![CDATA[
      <![CDATA[ deliberately nested-looking text ]]>
    ]]></description>
    <location lat="NaN" lon="INF"/>
  </artifact>
</museum>