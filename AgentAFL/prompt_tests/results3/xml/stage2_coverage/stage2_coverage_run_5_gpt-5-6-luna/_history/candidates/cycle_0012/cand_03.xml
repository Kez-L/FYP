<?xml version="1.0"?>
<!DOCTYPE archive [
  <!ELEMENT archive (entry*)>
  <!ELEMENT entry (meta, payload)>
  <!ELEMENT meta (tag*)>
  <!ELEMENT tag (#PCDATA)>
  <!ELEMENT payload (#PCDATA|chunk|![CDATA[]])*>
  <!ELEMENT chunk (#PCDATA)>
  <!ATTLIST entry id ID #REQUIRED checksum CDATA #IMPLIED>
  <!ENTITY open "[[">
  <!ENTITY close "]]">
  <!ENTITY sample "&open;not a real section&close;">
]>
<archive>
  <entry id="e001" checksum="sha256:00ff">
    <meta>
      <tag>binary</tag>
      <tag>compressed</tag>
    </meta>
    <payload>
      prefix
      <![CDATA[ raw <bytes> & entities ]]>
      <chunk>middle &#x1F; fragment</chunk>
      &sample;
      suffix
    </payload>
  </entry>
  <entry id="e002">
    <meta/>
    <payload><![CDATA[]]></payload>
  </entry>
</archive>