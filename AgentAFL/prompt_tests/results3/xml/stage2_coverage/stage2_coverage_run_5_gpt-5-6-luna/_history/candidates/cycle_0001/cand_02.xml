<?xml version="1.0"?>
<!DOCTYPE envelope [
  <!ENTITY greeting "Hello, ">
  <!ENTITY who "world">
  <!ENTITY phrase "&greeting;&who;!">
  <!ENTITY % extra "<!ELEMENT annotation (#PCDATA)>">
  %extra;
  <!ELEMENT envelope (message, annotation?, payload)>
  <!ELEMENT message (#PCDATA)>
  <!ELEMENT payload (chunk+)>
  <!ELEMENT chunk (#PCDATA)>
  <!ATTLIST payload format CDATA "text">
]>
<envelope>
  <message>&phrase;</message>
  <annotation>generated by an internal subset</annotation>
  <payload format="mixed">
    <chunk>first&#x0A;line</chunk>
    <chunk><![CDATA[second ]]>line</chunk>
    <chunk>third &amp; final</chunk>
  </payload>
</envelope>