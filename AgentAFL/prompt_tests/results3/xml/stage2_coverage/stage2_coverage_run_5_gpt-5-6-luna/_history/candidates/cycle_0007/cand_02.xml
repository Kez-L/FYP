<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE dashboard [
  <!ELEMENT dashboard (widget*)>
  <!ELEMENT widget (label, value, note?)>
  <!ATTLIST widget
    id ID #REQUIRED
    refs IDREFS #IMPLIED
    class (gauge|text|spark) #REQUIRED
    xml:space (default|preserve) "default">
  <!ELEMENT label (#PCDATA)>
  <!ELEMENT value (#PCDATA|unit)*>
  <!ELEMENT unit EMPTY>
  <!ATTLIST unit name CDATA #REQUIRED>
  <!ELEMENT note (#PCDATA|linebreak)*>
  <!ELEMENT linebreak EMPTY>
]>
<dashboard xmlns="urn:dash" xmlns:x="urn:extra">
  <widget id="w0" class="gauge" refs="w2 w3" x:mode="live">
    <label xml:lang="fr">Température</label>
    <value>21<unit name="C"/></value>
    <note>stable<linebreak/>within range</note>
  </widget>
  <widget id="w2" class="text" xml:space="preserve">
    <label> spaced </label>
    <value><![CDATA[<42 & rising>]]></value>
  </widget>
</dashboard>