<?xml version="1.0"?>
<!DOCTYPE report [
  <!ENTITY % base "CDATA #IMPLIED">
  <!ELEMENT report (summary, rows)>
  <!ELEMENT summary (#PCDATA)>
  <!ELEMENT rows (row*)>
  <!ELEMENT row (cell, cell, cell?)>
  <!ELEMENT cell (#PCDATA|value)*>
  <!ELEMENT value EMPTY>
  <!ATTLIST report format (brief|full) "full">
  <!ATTLIST row key ID #IMPLIED>
  <!ATTLIST cell role NMTOKEN #IMPLIED>
  <!ATTLIST value %base;>
  <![IGNORE[
    <!ELEMENT ignored EMPTY>
    <!ENTITY hidden "not expanded">
  ]]>
  <![INCLUDE[
    <!ENTITY visible "visible &amp; text">
  ]]>
]>
<report format="brief">
  <summary>&visible;</summary>
  <rows>
    <row key="r1">
      <cell role="name">A<value/>B</cell>
      <cell role="count">1</cell>
      <cell/>
    </row>
    <row>
      <cell role="name">C</cell>
      <cell role="count">&lt;2&gt;</cell>
    </row>
  </rows>
</report>