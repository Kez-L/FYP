<?xml version="1.0"?>
<!DOCTYPE scene [
  <!ELEMENT scene (layer+)>
  <!ELEMENT layer (object*)>
  <!ELEMENT object (label?, geometry)>
  <!ELEMENT label (#PCDATA)>
  <!ELEMENT geometry (point|box|path)>
  <!ELEMENT point EMPTY>
  <!ELEMENT box EMPTY>
  <!ELEMENT path (#PCDATA)>
  <!ATTLIST scene version CDATA #FIXED "2">
  <!ATTLIST layer name CDATA #REQUIRED visible (true|false) "true">
  <!ATTLIST object id ID #IMPLIED transform CDATA #IMPLIED>
  <!ATTLIST point x CDATA #REQUIRED y CDATA #REQUIRED>
  <!ATTLIST box x CDATA #REQUIRED y CDATA #REQUIRED width CDATA #REQUIRED height CDATA #REQUIRED>
  <!ATTLIST path closed (yes|no) "no">
]>
<scene version="2">
  <layer name="background" visible="false">
    <object id="o0">
      <geometry><box x="-1" y="0" width="640" height="480"/></geometry>
    </object>
  </layer>
  <layer name="foreground">
    <object id="o1" transform="rotate(45)">
      <label>points &lt; paths</label>
      <geometry><point x="1.0" y="2e3"/></geometry>
    </object>
    <object>
      <geometry><path closed="yes"><![CDATA[M 0 0 L 10 10 Z]]></path></geometry>
    </object>
  </layer>
</scene>