<?xml version="1.0"?>
<!DOCTYPE report [
  <!ENTITY % feature "INCLUDE">
  <!ENTITY % optional "<!ELEMENT diagnostics (metric|message)*><!ELEMENT metric (#PCDATA)><!ELEMENT message (#PCDATA)>">
  <!ELEMENT report (prologue, content, appendix?)>
  <!ELEMENT prologue (heading, owner, keywords?)>
  <!ELEMENT heading (#PCDATA)>
  <!ELEMENT owner (#PCDATA)>
  <!ELEMENT keywords (keyword+)>
  <!ELEMENT keyword (#PCDATA)>
  <!ELEMENT content (chapter+)>
  <!ELEMENT chapter (heading, paragraph+, table?)>
  <!ATTLIST chapter number NMTOKEN #REQUIRED>
  <!ELEMENT paragraph (#PCDATA|strong|quote|break)*>
  <!ELEMENT strong (#PCDATA)>
  <!ELEMENT quote (#PCDATA|strong)*>
  <!ELEMENT break EMPTY>
  <!ELEMENT table (row+)>
  <!ELEMENT row (cell+)>
  <!ELEMENT cell (#PCDATA|strong)*>
  <!ELEMENT appendix (diagnostics)>
  <!ATTLIST appendix xml:space (default|preserve) "preserve">
  <![%feature;[
    %optional;
  ]]>
]>
<report xml:lang="fr">
  <prologue>
    <heading>Étude &amp; Résultats</heading>
    <owner>Équipe Δ</owner>
    <keywords>
      <keyword>parser</keyword>
      <keyword>sécurité</keyword>
    </keywords>
  </prologue>
  <content>
    <chapter number="I">
      <heading>Entrée</heading>
      <paragraph>Une <strong>valeur</strong> suivie d’un <quote>exemple</quote>.<break/>Fin.</paragraph>
      <table>
        <row><cell>A</cell><cell><strong>B</strong></cell></row>
        <row><cell>1</cell><cell>2 &lt; 3</cell></row>
      </table>
    </chapter>
    <chapter number="II">
      <heading>Sortie</heading>
      <paragraph><![CDATA[<opaque>content & data</opaque>]]></paragraph>
    </chapter>
  </content>
  <appendix>
    <diagnostics>
      <metric>0x00ff</metric>
      <message>completed</message>
    </diagnostics>
  </appendix>
</report>