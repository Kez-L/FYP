<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE graph [
  <!ELEMENT graph (node+, edge*)>
  <!ELEMENT node (label, property*)>
  <!ATTLIST node id ID #REQUIRED>
  <!ELEMENT label (#PCDATA)>
  <!ELEMENT property EMPTY>
  <!ATTLIST property name NMTOKEN #REQUIRED value CDATA #IMPLIED>
  <!ELEMENT edge EMPTY>
  <!ATTLIST edge from IDREF #REQUIRED to IDREF #REQUIRED weight NMTOKEN "1">
]>
<graph>
  <node id="n-root">
    <label>root</label>
    <property name="empty" value=""/>
  </node>
  <node id="n-β">
    <label>branch &#x1F333;</label>
    <property name="flag"/>
    <property name="quote" value="&quot;left&quot;"/>
  </node>
  <edge from="n-root" to="n-β" weight="0.75"/>
  <edge from="n-β" to="n-root"/>
</graph>