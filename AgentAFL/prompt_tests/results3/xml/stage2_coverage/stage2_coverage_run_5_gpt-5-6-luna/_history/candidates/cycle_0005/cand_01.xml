<?xml version="1.1"?>
<!DOCTYPE packet [
  <!ELEMENT packet (header, body, trailer)>
  <!ELEMENT header (field+)>
  <!ELEMENT field (#PCDATA)>
  <!ELEMENT body (section*)>
  <!ELEMENT section (line|section)*>
  <!ELEMENT line (#PCDATA|emph)*>
  <!ELEMENT emph (#PCDATA)>
  <!ELEMENT trailer EMPTY>
  <!ATTLIST packet version CDATA #FIXED "1.1">
  <!ATTLIST field name NMTOKEN #REQUIRED>
  <!ATTLIST section level NMTOKEN #IMPLIED>
  <!ENTITY nbsp "&#160;">
  <!ENTITY quote "&quot;">
]>
<packet version="1.1">
  <header>
    <field name="source">sensor &quote;A&quote;</field>
    <field name="flags">x&nbsp;y</field>
  </header>
  <body>
    <section level="1">
      <line>one <emph>bold</emph> two</line>
      <section level="2">
        <line><![CDATA[raw ]]> text <emph>inside</emph></line>
      </section>
    </section>
    <section>
      <line>last</line>
    </section>
  </body>
  <trailer/>
</packet>