<?xml version="1.0"?>
<!DOCTYPE catalog [
  <!ELEMENT catalog (item+, note?)>
  <!ELEMENT item (title, price, details)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT price (#PCDATA)>
  <!ELEMENT details (#PCDATA|link|ref)*>
  <!ELEMENT link EMPTY>
  <!ELEMENT ref EMPTY>
  <!ATTLIST item
    sku ID #REQUIRED
    state (new|used|retired) "new"
    xmlns:shop CDATA #FIXED "urn:shop:v2">
  <!ATTLIST link href URI #IMPLIED>
  <!ATTLIST ref target IDREF #IMPLIED>
  <!NOTATION bin SYSTEM "application/octet-stream">
  <!ENTITY blob SYSTEM "data.bin" NDATA bin>
  <!ENTITY mark "&#x3C;synthetic&#x3E;">
]>
