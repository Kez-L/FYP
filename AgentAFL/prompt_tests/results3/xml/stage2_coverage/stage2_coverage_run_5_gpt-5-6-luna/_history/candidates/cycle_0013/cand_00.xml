    <price>19.99</price>
    <details>
      before &mark;
      <link href="urn:x?y=1&amp;z=2"/>
      <ref target="p-001"/>
      after
    </details>
  </item>
  <item sku="p-002" state="retired">
    <title><![CDATA[x]]]]><![CDATA[>y]]></title>
    <price>0</price>
    <details><link/><ref/></details>
  </item>
  <note>catalog-end</note>
</catalog>