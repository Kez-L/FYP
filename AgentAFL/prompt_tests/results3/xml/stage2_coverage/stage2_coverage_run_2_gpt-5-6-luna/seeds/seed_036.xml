<?xml version="1.0"?>
<!DOCTYPE report [
  <!ELEMENT report (section+)>
  <!ELEMENT section (heading,para+)>
  <!ATTLIST section xml:lang NMTOKEN #IMPLIED>
  <!ELEMENT heading (#PCDATA)>
  <!ELEMENT para (#PCDATA|ref|quote|list)*>
  <!ELEMENT ref EMPTY>
  <!ATTLIST ref target IDREF #REQUIRED>
  <!ELEMENT quote (#PCDATA)>
  <!ELEMENT list (item+)>
  <!ELEMENT item (#PCDATA)>
  <!ATTLIST item id ID #IMPLIED>
  <!NOTATION gif SYSTEM "image/gif">
  <!ENTITY logo SYSTEM "logo.gif" NDATA gif>
  <!ENTITY % optional "INCLUDE">
  <![%optional;[
    <!ELEMENT appendix (#PCDATA)>
  ]]>
]>
<report>
  <section xml:lang="en">
    <heading>Overview</heading>
    <para>See <ref target="x1"/> and <quote>quoted text</quote>.</para>
    <para>
      <list>
        <item id="x1">first</item>
        <item>second</item>
      </list>
    </para>
  </section>
  <section xml:lang="fr">
    <heading>Résumé</heading>
    <para>élève — café — naïve</para>
  </section>
</report>