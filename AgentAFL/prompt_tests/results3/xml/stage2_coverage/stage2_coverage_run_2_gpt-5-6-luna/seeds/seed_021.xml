<?xml version="1.0"?>
<!DOCTYPE matrix [
  <!ELEMENT matrix (row+)>
  <!ELEMENT row (cell+)>
  <!ELEMENT cell (#PCDATA)>
  <!ATTLIST row index NMTOKEN #REQUIRED>
  <!ATTLIST cell
    kind NMTOKENS #IMPLIED
    ref IDREF #IMPLIED>
  <!ENTITY nbsp "&#160;">
  <!ENTITY quote "&#34;">
]>
<matrix xmlns="urn:matrix" xmlns:m="urn:meta">
  <row index="r0">
    <cell kind="numeric primary" ref="r0">0</cell>
    <cell kind="numeric">&nbsp;</cell>
    <cell kind="quoted">&quote;</cell>
  </row>
  <row index="r1">
    <cell kind="numeric" ref="missing">-1</cell>
    <cell><![CDATA[1 < 2 && 3 > 2]]></cell>
    <cell kind="text"><m:annotation xml:lang="en">edge</m:annotation></cell>
  </row>
</matrix>