<?xml version="1.0"?>
<!DOCTYPE archive [
  <!ELEMENT archive (folder+)>
  <!ATTLIST archive created CDATA #IMPLIED format (flat|tree) "tree">
  <!ELEMENT folder (folder|file|alias)*>
  <!ATTLIST folder name NMTOKEN #REQUIRED hidden (yes|no) "no">
  <!ELEMENT file (data?,metadata?)>
  <!ATTLIST file id ID #REQUIRED name CDATA #REQUIRED type NOTATION #IMPLIED mode NMTOKEN "0644">
  <!ELEMENT data (#PCDATA|line|escape)*>
  <!ELEMENT line (#PCDATA)>
  <!ELEMENT escape EMPTY>
  <!ATTLIST escape code NMTOKEN #REQUIRED>
  <!ELEMENT metadata (tag*)>
  <!ELEMENT tag (#PCDATA)>
  <!ATTLIST tag key NMTOKEN #REQUIRED>
  <!ELEMENT alias EMPTY>
  <!ATTLIST alias target IDREF #REQUIRED>
  <!NOTATION plain SYSTEM "text/plain">
  <!NOTATION json SYSTEM "application/json">
  <!ENTITY nbsp "&#160;">
  <!ENTITY path "var&slash;cache">
  <!ENTITY slash "/">
]>
