<?xml version="1.0"?>
<!DOCTYPE timeline [
  <!ELEMENT timeline (event | gap | event*)*>
  <!ELEMENT event (when, description)>
  <!ELEMENT gap EMPTY>
  <!ELEMENT when (#PCDATA)>
  <!ELEMENT description (#PCDATA|link)*>
  <!ELEMENT link (#PCDATA)>
  <!ATTLIST event id ID #IMPLIED kind CDATA #REQUIRED>
  <!ATTLIST gap duration NMTOKEN #REQUIRED>
  <!ENTITY emph "<link>important</link>">
]>
<timeline>
  <event kind="start" id="e0">
    <when>00:00</when>
    <description>begin <link href="urn:x">now</link></description>
  </event>
  <gap duration="00:05"/>
  <event kind="update">
    <when>00:05</when>
    <description>status: &emph; and <![CDATA[ literal <link> ]]></description>
  </event>
  <event kind="end"><when>00:10</when><description>done</description></event>
</timeline>