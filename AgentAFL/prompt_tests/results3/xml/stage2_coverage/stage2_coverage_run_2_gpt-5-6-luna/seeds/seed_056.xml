<?xml version="1.0"?>
<!DOCTYPE archive [
  <!ELEMENT archive (folder+)>
  <!ATTLIST archive xml:lang CDATA #IMPLIED>
  <!ELEMENT folder (label, folder*, record*)>
  <!ATTLIST folder key ID #REQUIRED hidden (true|false) "false">
  <!ELEMENT label (#PCDATA)>
  <!ELEMENT record (title, metadata, body)>
  <!ATTLIST record ref ID #REQUIRED format NOTATION #REQUIRED>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT metadata (tag*)>
  <!ELEMENT tag EMPTY>
  <!ATTLIST tag name CDATA #REQUIRED value CDATA #IMPLIED>
  <!ELEMENT body (#PCDATA|link|code|break)*>
  <!ELEMENT link (#PCDATA)>
  <!ATTLIST link target IDREF #REQUIRED>
  <!ELEMENT code (#PCDATA)>
  <!ELEMENT break EMPTY>
  <!NOTATION markdown SYSTEM "text/markdown">
  <!NOTATION plain SYSTEM "text/plain">
  <!ENTITY legal "Copyright &amp; retention policy">
]>
<archive xml:lang="fr">
  <folder key="root">
    <label>Dossiers &amp; index</label>
    <folder key="research" hidden="false">
      <label>Recherche</label>
      <record ref="r-01" format="markdown">
        <title>Notes de terrain</title>
        <metadata>
          <tag name="owner" value="Léa"/>
          <tag name="status"/>
        </metadata>
        <body><![CDATA[Mesure initiale: 17 < 19]]><break/>
          Voir <link target="r-02">la calibration</link> et <code>sample --dry-run</code>.
        </body>
      </record>
      <record ref="r-02" format="plain">
        <title>Calibration</title>
        <metadata><tag name="license" value="internal"/></metadata>
        <body>&legal;: validé.</body>
      </record>
    </folder>
  </folder>
</archive>