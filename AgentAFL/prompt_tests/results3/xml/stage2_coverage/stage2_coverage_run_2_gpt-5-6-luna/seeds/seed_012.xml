<?xml version="1.0"?>
<!DOCTYPE media [
  <!NOTATION png SYSTEM "image/png">
  <!NOTATION txt PUBLIC "-//EXAMPLE//TEXT Plain//EN" "text/plain">
  <!ENTITY cover SYSTEM "cover.png" NDATA png>
  <!ENTITY readme SYSTEM "readme.txt" NDATA txt>
  <!ELEMENT media (asset*, reference*)>
  <!ELEMENT asset EMPTY>
  <!ATTLIST asset
    name CDATA #REQUIRED
    kind NOTATION (png|txt) #IMPLIED
    source ENTITY #IMPLIED>
  <!ELEMENT reference (#PCDATA)>
  <!ATTLIST reference target IDREF #IMPLIED>
]>
<media>
  <asset name="cover.png" kind="png" source="cover"/>
  <asset name="readme.txt" kind="txt" source="readme"/>
  <reference target="missing">external resources are not loaded</reference>
</media>