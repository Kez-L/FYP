<?xml version="1.0"?>
<!DOCTYPE library [
  <!ENTITY % common "xml:lang CDATA #IMPLIED xml:space (default|preserve) 'default'">
  <!ELEMENT library (section+)>
  <!ATTLIST library version CDATA #FIXED "2">
  <!ELEMENT section (title, book*)>
  <!ATTLIST section id ID #REQUIRED %common;>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT book (author+, synopsis?, keyword*)>
  <!ATTLIST book isbn NMTOKEN #REQUIRED available (yes|no) "yes">
  <!ELEMENT author (#PCDATA)>
  <!ELEMENT synopsis (#PCDATA|em|quote)*>
  <!ELEMENT em (#PCDATA)>
  <!ELEMENT quote (#PCDATA)>
  <!ELEMENT keyword (#PCDATA)>
  <!ENTITY copyright "&#169; archive">
]>
<library version="2">
  <section id="fiction" xml:lang="en" xml:space="preserve">
    <title>Fiction &amp; Folklore</title>
    <book isbn="A-17" available="yes">
      <author>R. Vale</author>
      <author>M. Chen</author>
      <synopsis>A tale of <em>quiet</em> roads and <quote>unmapped</quote> stars.</synopsis>
      <keyword>journey</keyword>
      <keyword>&copyright;</keyword>
    </book>
  </section>
</library>