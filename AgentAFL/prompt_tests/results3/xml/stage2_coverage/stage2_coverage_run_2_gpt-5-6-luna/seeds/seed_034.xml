<?xml version="1.0"?>
<!DOCTYPE questionnaire [
  <!ELEMENT questionnaire (intro, question+)>
  <!ELEMENT intro (#PCDATA|strong|br)*>
  <!ELEMENT strong (#PCDATA)>
  <!ELEMENT br EMPTY>
  <!ELEMENT question (prompt, choice*, answer?)>
  <!ATTLIST question id ID #REQUIRED required (true|false) "false">
  <!ELEMENT prompt (#PCDATA|code|math)*>
  <!ELEMENT code (#PCDATA)>
  <!ELEMENT math ANY>
  <!ELEMENT choice (#PCDATA|hint)*>
  <!ATTLIST choice value NMTOKEN #REQUIRED score CDATA "0">
  <!ELEMENT hint (#PCDATA)>
  <!ELEMENT answer (#PCDATA)>
  <!ENTITY le "&#60;=">
  <!ENTITY rarr "&#x2192;">
]>
<questionnaire xmlns:q="urn:quiz">
  <intro>Choose carefully<strong>—some fields are required.</strong><br/>Use &lt; and &gt; as text.</intro>
  <question id="q-one" required="true">
    <prompt>What is <code>2 &amp; 2</code> <math><mi>x</mi><mo>&le;</mo><mn>4</mn></math>?</prompt>
    <choice value="a" score="1">four<hint>basic arithmetic</hint></choice>
    <choice value="b">five</choice>
    <answer> a &rarr; correct </answer>
  </question>
  <question id="q-two">
    <prompt><![CDATA[Which token looks like </prompt> ]]></prompt>
    <choice value="xml" score="2">markup</choice>
    <choice value="text" score="-1">plain</choice>
  </question>
</questionnaire>