<?xml version="1.0"?>
<!DOCTYPE map [
  <!ELEMENT map (node|edge|metadata)*>
  <!ELEMENT node (label?,property*)>
  <!ATTLIST node id ID #REQUIRED kind NMTOKEN "generic">
  <!ELEMENT label (#PCDATA)>
  <!ELEMENT property (#PCDATA|value)*>
  <!ATTLIST property name NMTOKEN #REQUIRED>
  <!ELEMENT value (#PCDATA)>
  <!ELEMENT edge EMPTY>
  <!ATTLIST edge from IDREF #REQUIRED to IDREF #REQUIRED weight CDATA "1.0" directed (yes|no) "yes">
  <!ELEMENT metadata EMPTY>
  <!ATTLIST metadata key CDATA #REQUIRED value CDATA #IMPLIED>
  <!NOTATION bin SYSTEM "application/octet-stream">
  <!ENTITY sample "line one&#10;line two &amp; more">
]>
<map>
  <metadata key="format" value="graph"/>
  <node id="n0" kind="root">
    <label>Root</label>
    <property name="note"><value>&sample;</value></property>
  </node>
  <node id="n1"><label>Leaf</label><property name="rank"><value>3</value></property></node>
  <node id="n2" kind="isolated"/>
  <edge from="n0" to="n1" weight="0.25"/>
  <edge from="n1" to="n2" directed="no"/>
</map>