  <!ELEMENT receiver (#PCDATA)>
  <!ELEMENT payload ANY>
  <!ELEMENT trailer EMPTY>
  <!ATTLIST envelope mode (sync|async) "sync">
  <!ENTITY left "[[">
  <!ENTITY right "]]">
]>
