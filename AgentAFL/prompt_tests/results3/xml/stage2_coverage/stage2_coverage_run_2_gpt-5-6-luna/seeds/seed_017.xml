<?xml version="1.1"?>
<!DOCTYPE report [
  <!ELEMENT report (title, rows, totals)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT rows (row*)>
  <!ELEMENT row (name, value, comment?)>
  <!ATTLIST row
    number NMTOKEN #REQUIRED
    kind (integer|decimal|text) #REQUIRED>
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT value (#PCDATA)>
  <!ELEMENT comment (#PCDATA)>
  <!ELEMENT totals (total+)>
  <!ELEMENT total (#PCDATA)>
  <!ATTLIST total for IDREF #IMPLIED>
  <!ENTITY nbsp "&#160;">
  <!ENTITY nested "left-&nbsp;-middle-&nbsp;-right">
]>
<report>
  <title>Values &nested;</title>
  <rows>
    <row number="A-01" kind="integer">
      <name>count</name>
      <value>00000000000000000000042</value>
      <comment>line&#x85;break&#x2028;boundary</comment>
    </row>
    <row number="A-02" kind="decimal">
      <name>ratio</name>
      <value>-0.0000000000000000000007</value>
    </row>
    <row number="A-03" kind="text">
      <name>literal</name>
      <value>quotes: &quot;single&quot; and &apos;double&apos;</value>
    </row>
  </rows>
  <totals>
    <total for="A-01">42</total>
    <total for="A-02">-7e-22</total>
  </totals>
</report>