<?xml version="1.0"?>
<!DOCTYPE report [
  <!ELEMENT report (header,section+)>
  <!ELEMENT header (title,meta*)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT meta EMPTY>
  <!ATTLIST meta key NMTOKEN #REQUIRED value CDATA #IMPLIED>
  <!ELEMENT section (heading?,para|list|table)*>
  <!ATTLIST section xml:lang NMTOKEN #IMPLIED>
  <!ELEMENT heading (#PCDATA)>
  <!ELEMENT para (#PCDATA|em|link|quote)*>
  <!ELEMENT em (#PCDATA)>
  <!ELEMENT link (#PCDATA)>
  <!ATTLIST link href URI #REQUIRED>
  <!ELEMENT quote (#PCDATA)>
  <!ELEMENT list (item+)>
  <!ELEMENT item (#PCDATA|para)*>
  <!ELEMENT table (row+)>
  <!ELEMENT row (cell+)>
  <!ELEMENT cell (#PCDATA|em)*>
  <!ATTLIST cell colspan NMTOKEN "1">
]>
<report>
  <header>
    <title>Quarterly &amp; Unusual Results</title>
    <meta key="owner" value="research"/>
    <meta key="empty" value=""/>
  </header>
  <section xml:lang="en">
    <heading>Overview</heading>
    <para>Text with <em>nested emphasis</em> and <link href="urn:x:test">a link</link>.</para>
    <list>
      <item>first</item>
      <item><para>second <quote>quoted</quote></para></item>
    </list>
  </section>
  <section>
    <table>
      <row><cell colspan="2">A</cell><cell>B</cell></row>
      <row><cell>1</cell><cell><em>2</em></cell><cell>3</cell></row>
    </table>
  </section>
</report>