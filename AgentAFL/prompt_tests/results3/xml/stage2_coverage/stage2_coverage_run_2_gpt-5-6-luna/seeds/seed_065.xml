<?xml version="1.0"?>
<!DOCTYPE map [
  <!ELEMENT map (layer+, legend?)>
  <!ELEMENT layer (point|path|label)*>
  <!ATTLIST layer name NMTOKEN #REQUIRED opacity CDATA "1.0">
  <!ELEMENT point EMPTY>
  <!ATTLIST point x CDATA #REQUIRED y CDATA #REQUIRED color (red|green|blue) "red">
  <!ELEMENT path (point+)>
  <!ATTLIST path closed (yes|no) "no">
  <!ELEMENT label (#PCDATA|b|i)*>
  <!ELEMENT b (#PCDATA)>
  <!ELEMENT i (#PCDATA)>
  <!ELEMENT legend (entry+)>
  <!ELEMENT entry (#PCDATA)>
  <!ATTLIST entry key ID #REQUIRED>
  <!ENTITY arrow "&#x2192;">
]>
<map>
  <layer name="roads" opacity="0.75">
    <path closed="yes">
      <point x="0" y="0" color="blue"/>
      <point x="12.5" y="-4" color="green"/>
      <point x="12.5" y="18" color="red"/>
    </path>
    <label>Main &arrow; route</label>
  </layer>
  <layer name="markers">
    <point x="-1" y="3"/>
    <label><b>north</b> and <i>west</i></label>
  </layer>
  <legend>
    <entry key="r1">roads</entry>
    <entry key="m1">markers &amp; signs</entry>
  </legend>
</map>