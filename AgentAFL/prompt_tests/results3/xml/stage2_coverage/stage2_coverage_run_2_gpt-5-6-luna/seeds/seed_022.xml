<?xml version="1.0"?>
<!DOCTYPE form [
  <!ELEMENT form (header, fieldset+, submit?)>
  <!ELEMENT header (#PCDATA|linebreak)*>
  <!ELEMENT linebreak EMPTY>
  <!ELEMENT fieldset (legend?, field*)>
  <!ELEMENT legend (#PCDATA)>
  <!ELEMENT field (label?, input, hint?)>
  <!ELEMENT label (#PCDATA)>
  <!ELEMENT input EMPTY>
  <!ELEMENT hint (#PCDATA)>
  <!ELEMENT submit EMPTY>
  <!ATTLIST fieldset name CDATA #REQUIRED>
  <!ATTLIST field name CDATA #IMPLIED>
  <!ATTLIST input
    type (text|number|checkbox|hidden) "text"
    value CDATA #IMPLIED
    disabled (true|false) "false">
  <!ATTLIST submit action CDATA #REQUIRED>
]>
<form>
  <header>Registration<linebreak/>Please complete all sections.</header>
  <fieldset name="identity">
    <legend>Identity</legend>
    <field name="nickname">
      <label>Nickname</label>
      <input type="text" value="A &quot;quoted&quot; name"/>
      <hint>Optional &lt;display&gt; name</hint>
    </field>
    <field name="age"><label>Age</label><input type="number" value="0007"/></field>
  </fieldset>
  <fieldset name="flags">
    <field name="verified"><input type="checkbox" value="yes" disabled="true"/></field>
    <field name="token"><input type="hidden" value="&apos;raw&apos;"/></field>
  </fieldset>
  <submit action="/save?mode=xml"/>
</form>