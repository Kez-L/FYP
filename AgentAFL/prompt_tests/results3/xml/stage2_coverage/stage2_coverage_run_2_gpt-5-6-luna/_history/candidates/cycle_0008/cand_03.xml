<?xml version="1.0"?>
<!DOCTYPE map [
  <!ELEMENT map (node*)>
  <!ELEMENT node (label, node*)>
  <!ATTLIST node id ID #IMPLIED
                parent IDREF #IMPLIED
                flags NMTOKENS #IMPLIED>
  <!ELEMENT label (#PCDATA)>
  <!ENTITY nbsp "&#160;">
  <!ENTITY weird "&#x41;&#65;&#x3f;">
]>
<map>
  <node id="root" flags="top visible">
    <label>Root&nbsp;&weird;</label>
    <node id="n1" parent="root" flags="leaf">
      <label>One</label>
    </node>
    <node id="n2" parent="root">
      <label>Two &lt; two</label>
      <node id="n2a" parent="n2" flags="leaf">
        <label><![CDATA[unescaped ]]> text <![CDATA[ ]]></label>
      </node>
    </node>
  </node>
</map>