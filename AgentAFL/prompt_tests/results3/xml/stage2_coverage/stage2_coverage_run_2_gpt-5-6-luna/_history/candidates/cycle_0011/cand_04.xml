<?xml version="1.0"?>
<!DOCTYPE museum [
  <!ELEMENT museum (room+)>
  <!ELEMENT room (label, exhibit*)>
  <!ATTLIST room number NMTOKEN #REQUIRED theme CDATA #IMPLIED>
  <!ELEMENT label (#PCDATA)>
  <!ELEMENT exhibit (name, date?, material, description)>
  <!ATTLIST exhibit id ID #REQUIRED featured (yes|no) "no">
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT date (#PCDATA)>
  <!ELEMENT material EMPTY>
  <!ATTLIST material type CDATA #REQUIRED origin CDATA #IMPLIED>
  <!ELEMENT description (#PCDATA|link|linebreak)*>
  <!ELEMENT link (#PCDATA)>
  <!ATTLIST link href URI #REQUIRED>
  <!ELEMENT linebreak EMPTY>
  <!NOTATION png SYSTEM "image/png">
  <!ENTITY emblem SYSTEM "emblem.png" NDATA png>
]>
<museum xml:base="https://museum.example/archive/">
  <room number="A-1" theme="Origins">
    <label>Early Instruments</label>
    <exhibit id="stone-1" featured="yes">
      <name>Resonant Stone</name>
      <date>circa 4000 BCE</date>
      <material type="basalt" origin="river basin"/>
      <description>Found near the eastern ridge.<linebreak/>
        See <link href="notes/stone-1.html">field notes</link> for details.
      </description>
    </exhibit>
  </room>
  <room number="B-7" theme="Signals">
    <label>Light and Sound</label>
    <exhibit id="bell-9">
      <name>Bronze Bell</name>
      <material type="bronze"/>
      <description><![CDATA[The inscription reads: <listen carefully>.]]></description>
    </exhibit>
  </room>
</museum>