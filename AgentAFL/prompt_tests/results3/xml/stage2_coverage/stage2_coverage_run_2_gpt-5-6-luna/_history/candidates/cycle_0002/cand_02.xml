<?xml version="1.0"?>
<!DOCTYPE matrix [
  <!ELEMENT matrix (row+)>
  <!ELEMENT row (cell*)>
  <!ELEMENT cell (#PCDATA)>
  <!ATTLIST matrix xmlns CDATA #IMPLIED>
  <!ATTLIST row index CDATA #REQUIRED>
  <!ATTLIST cell colspan NMTOKEN "1" rowspan NMTOKEN "1">
]>
<matrix xmlns="urn:grid">
  <row index="0"><cell colspan="2">A</cell><cell>B</cell></row>
  <row index="1">
    <cell rowspan="0"><![CDATA[x<y && z>q]]></cell>
    <cell colspan="3">C&amp;D</cell>
  </row>
  <row index="2"><?row-end?><cell>tail</cell></row>
</matrix>