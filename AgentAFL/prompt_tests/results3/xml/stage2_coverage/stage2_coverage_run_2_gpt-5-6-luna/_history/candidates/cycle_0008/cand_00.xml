<?xml version="1.0"?>
<!DOCTYPE catalog [
  <!ELEMENT catalog (entry*)>
  <!ELEMENT entry (name,price?,description|image)>
  <!ATTLIST entry code ID #REQUIRED status (new|used|archived) "new">
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT price (#PCDATA)>
  <!ELEMENT description (#PCDATA|b|i|br)*>
  <!ELEMENT b (#PCDATA)>
  <!ELEMENT i (#PCDATA)>
  <!ELEMENT br EMPTY>
  <!ELEMENT image EMPTY>
  <!ATTLIST image src CDATA #REQUIRED alt CDATA #IMPLIED>
  <!ENTITY currency "€">
  <!ENTITY stamp "A &amp; B &lt; C">
]>
<catalog>
  <entry code="p1" status="new">
    <name>Widget &amp; Gear</name>
    <price>&currency; 19.95</price>
    <description>Small <b>blue</b> <i>part</i><br/>with &stamp;.</description>
  </entry>
  <entry code="p2">
    <name>Replacement</name>
    <image src="img?id=2&amp;v=7" alt="replacement"/>
  </entry>
</catalog>