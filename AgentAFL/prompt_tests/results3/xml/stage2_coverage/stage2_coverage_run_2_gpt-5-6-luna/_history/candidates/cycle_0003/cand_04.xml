<?xml version="1.0"?>
<!DOCTYPE packet [
  <!ELEMENT packet (meta, body, checksum?)>
  <!ELEMENT meta EMPTY>
  <!ATTLIST meta
    version CDATA #REQUIRED
    flags NMTOKENS #IMPLIED>
  <!ELEMENT body (chunk|gap)*>
  <!ELEMENT chunk (#PCDATA)>
  <!ELEMENT gap EMPTY>
  <!ATTLIST gap width NMTOKEN "0">
  <!ELEMENT checksum (#PCDATA)>
  <!ENTITY amp "&#38;">
]>
<packet>
  <meta version="0x00" flags="a  b c"/>
  <body>
    <chunk>prefix &amp; middle</chunk>
    <gap width="000000000000000000000000000000000000000000000000000001"/>
    <chunk><![CDATA[raw ]]>&amp;<![CDATA[ text]]></chunk>
    <gap/>
    <chunk>suffix</chunk>
  </body>
  <checksum>&amp;ENTITY; &amp; &#x1F600;</checksum>
</packet>