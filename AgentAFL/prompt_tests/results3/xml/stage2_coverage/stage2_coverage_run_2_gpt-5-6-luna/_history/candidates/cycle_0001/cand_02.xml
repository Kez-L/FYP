<!DOCTYPE report [
  <!ELEMENT report (header, body, footer?)>
  <!ELEMENT header (#PCDATA)>
  <!ELEMENT body (entry|note|entry)*>
  <!ELEMENT entry (#PCDATA)>
  <!ELEMENT note (#PCDATA)>
  <!ELEMENT footer (#PCDATA)>
  <!ENTITY open "<entry>generated">
  <!ENTITY close "</entry>">
]>
<report>
  <header>daily</header>
  <body>
    &open; one &close;
    <note><![CDATA[&open; is not expanded here]]></note>
    <entry>two &amp; three</entry>
  </body>
  <footer/>
</report>