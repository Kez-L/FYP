<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE map [
  <!ELEMENT map (layer*)>
  <!ELEMENT layer (node|edge|group)*>
  <!ELEMENT group (node|edge|group)*>
  <!ELEMENT node (#PCDATA)>
  <!ELEMENT edge EMPTY>
  <!ATTLIST layer name CDATA #REQUIRED>
  <!ATTLIST group id ID #REQUIRED>
  <!ATTLIST node id ID #REQUIRED class NMTOKENS #IMPLIED>
  <!ATTLIST edge from IDREF #REQUIRED to IDREF #REQUIRED weight CDATA "1.0">
  <!ENTITY open "[" >
  <!ENTITY close "]" >
]>
<map xmlns="urn:graph" xmlns:g="urn:graph:meta">
  <layer name="roads">
    <node id="n1" class="road primary">Central &open;hub&close;</node>
    <group id="cluster">
      <node id="n2">North</node>
      <node id="n3">South</node>
      <edge from="n2" to="n3" weight="0"/>
    </group>
    <edge from="n1" to="n2" g:weight="9"/>
  </layer>
  <layer name="empty"/>
</map>