<?xml version="1.0"?>
<!DOCTYPE catalog [
  <!ENTITY % common "<!ELEMENT item (#PCDATA|price|meta)*>">
  %common;
  <!ELEMENT catalog (section+)>
  <!ELEMENT section (title, item*)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT price (#PCDATA)>
  <!ELEMENT meta EMPTY>
  <!ATTLIST catalog version NMTOKEN #IMPLIED>
  <!ATTLIST section code ID #REQUIRED>
  <!ATTLIST item sku ID #IMPLIED state (new|used|hold) "new">
  <!ATTLIST meta key CDATA #REQUIRED>
]>
<catalog version="v&amp;2">
  <section code="s1">
    <title>Tools <?note inside?> and parts</title>
    <item sku="i-1" state="used">hammer<price>12.50</price><meta key="origin"/></item>
    <item><meta key="empty"/><![CDATA[raw ]]> text</item>
  </section>
</catalog>