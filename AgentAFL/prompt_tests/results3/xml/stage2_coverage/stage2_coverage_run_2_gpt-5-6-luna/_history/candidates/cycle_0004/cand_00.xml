<?xml version="1.0"?>
<!DOCTYPE catalog [
  <!ELEMENT catalog (section+, checksum)>
  <!ELEMENT section (heading, entry*)>
  <!ATTLIST section
    name NMTOKEN #REQUIRED
    mode (compact|expanded) "compact">
  <!ELEMENT heading (#PCDATA)>
  <!ELEMENT entry (key, description?, metadata)>
  <!ATTLIST entry
    id ID #REQUIRED
    state (draft|published|retired) "draft">
  <!ELEMENT key (#PCDATA)>
  <!ELEMENT description (#PCDATA|link|quote)*>
  <!ELEMENT link (#PCDATA)>
  <!ATTLIST link href CDATA #IMPLIED>
  <!ELEMENT quote (#PCDATA)>
  <!ELEMENT metadata (flag*)>
  <!ELEMENT flag EMPTY>
  <!ATTLIST flag name NMTOKEN #REQUIRED value CDATA #IMPLIED>
  <!ELEMENT checksum (#PCDATA)>
  <!ENTITY marker "&#x5B;generated&#x5D;">
]>
<catalog>
  <section name="alpha" mode="expanded">
    <heading>Configuration &marker;</heading>
    <entry id="e1" state="published">
      <key>one</key>
      <description>before <link href="urn:x?a=1&amp;b=2">jump</link>
        <quote>nested quotation</quote> after</description>
      <metadata>
        <flag name="enabled" value="yes"/>
        <flag name="empty"/>
      </metadata>
    </entry>
  </section>
  <section name="omega">
    <heading>Final section</heading>
  </section>
  <checksum>0000-ffff</checksum>
</catalog>