<?xml version="1.0"?>
<!DOCTYPE report [
  <!ELEMENT report (header, body, footer?)>
  <!ELEMENT header (title, created)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT created (#PCDATA)>
  <!ELEMENT body (section*)>
  <!ELEMENT section (heading?, paragraph*)>
  <!ELEMENT heading (#PCDATA)>
  <!ELEMENT paragraph (#PCDATA|code|quote|img)*>
  <!ELEMENT code (#PCDATA)>
  <!ELEMENT quote (#PCDATA)>
  <!ELEMENT img EMPTY>
  <!ATTLIST img src CDATA #REQUIRED alt CDATA #IMPLIED>
  <!ELEMENT footer (#PCDATA)>
  <!ENTITY note "unclosed-looking text: &lt;tag&gt;">
]>
<report>
  <header>
    <title>Delayed failure test</title>
    <created>2026-09-24</created>
  </header>
  <body>
    <section>
      <heading>Mixed material</heading>
      <paragraph>before <code>if (a &lt; b) return;</code>
        <quote>&note;</quote>
        <img src="diagram.svg" alt="diagram"/>
        after</paragraph>
    </section>
    <section>
      <paragraph><![CDATA[raw bytes: [ [ { } ] ]]></paragraph>
      <paragraph>entity follows: &ghost;</paragraph>
    </section>
  </body>
  <footer>trailing content</footer>
</report>