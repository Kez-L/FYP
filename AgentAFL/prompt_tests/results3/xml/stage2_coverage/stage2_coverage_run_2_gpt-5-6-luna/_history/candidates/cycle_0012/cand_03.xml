<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE recipe [
  <!ELEMENT recipe (identity, ingredients, directions, nutrition?)>
  <!ELEMENT identity (name, origin?, aliases*)>
  <!ATTLIST identity id ID #REQUIRED difficulty (easy|moderate|hard) #IMPLIED>
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT origin (#PCDATA)>
  <!ELEMENT aliases (#PCDATA)>
  <!ELEMENT ingredients (ingredient+)>
  <!ELEMENT ingredient (#PCDATA)>
  <!ATTLIST ingredient amount CDATA #IMPLIED unit CDATA #IMPLIED optional (true|false) "false">
  <!ELEMENT directions (step+)>
  <!ELEMENT step (instruction, timer?)>
  <!ATTLIST step number NMTOKEN #REQUIRED>
  <!ELEMENT instruction (#PCDATA|em|ingredient-ref)*>
  <!ELEMENT em (#PCDATA)>
  <!ELEMENT ingredient-ref EMPTY>
  <!ATTLIST ingredient-ref ref IDREF #REQUIRED>
  <!ELEMENT timer EMPTY>
  <!ATTLIST timer minutes NMTOKEN #REQUIRED>
  <!ELEMENT nutrition (fact+)>
  <!ELEMENT fact (#PCDATA)>
  <!ATTLIST fact key (energy|protein|salt|fiber) #REQUIRED>
  <!ENTITY degree "&#176;C">
]>
<recipe>
  <identity id="ravioli-9" difficulty="moderate">
    <name>Garden ravioli</name>
    <origin>North &amp; South</origin>
    <aliases>Ravioli verde</aliases>
  </identity>
  <ingredients>
    <ingredient id="pasta" amount="250" unit="g">fresh pasta sheets</ingredient>
    <ingredient id="herb" amount="40" unit="g">basil and mint</ingredient>
    <ingredient id="oil" amount="2" unit="tbsp" optional="true">olive oil</ingredient>
  </ingredients>
  <directions>
    <step number="1">
      <instruction>Blend the <ingredient-ref ref="herb"/> with <em>half</em> the oil.</instruction>
    </step>
    <step number="2">
      <instruction>Fold the <ingredient-ref ref="pasta"/> around the filling.</instruction>
      <timer minutes="7"/>
    </step>
    <step number="3">
      <instruction>Boil until tender at 96&degree;C.</instruction>
    </step>
  </directions>
  <nutrition>
    <fact key="energy">410 kcal</fact>
    <fact key="fiber">6 g</fact>
  </nutrition>
</recipe>