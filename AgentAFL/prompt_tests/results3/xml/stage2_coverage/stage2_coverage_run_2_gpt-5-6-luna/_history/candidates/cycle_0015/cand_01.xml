<?xml version="1.0"?>
<!DOCTYPE matrix [
  <!ENTITY % feature "INCLUDE">
  <![%feature;[
    <!ELEMENT matrix (row+)>
    <!ELEMENT row (cell+)>
    <!ATTLIST row number NMTOKEN #REQUIRED>
    <!ELEMENT cell (#PCDATA|formula)*>
    <!ATTLIST cell kind (text|number|date) "text">
    <!ELEMENT formula (#PCDATA)>
  ]]>
  <!NOTATION png SYSTEM "image/png">
  <!ENTITY logo SYSTEM "https://example.invalid/logo.png" NDATA png>
  <!ATTLIST cell source ENTITY #IMPLIED>
]>
<matrix>
  <row number="01">
    <cell kind="text">alpha</cell>
    <cell kind="number">42</cell>
    <cell kind="text">before <formula>SUM(A1:A2)</formula> after</cell>
  </row>
  <row number="02">
    <cell kind="date" source="logo">2026-09-24</cell>
    <cell>line one&#10;line two</cell>
  </row>
</matrix>