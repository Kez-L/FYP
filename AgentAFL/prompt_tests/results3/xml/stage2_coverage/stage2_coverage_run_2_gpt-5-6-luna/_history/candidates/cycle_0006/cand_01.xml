<?xml version="1.1"?>
<!DOCTYPE matrix [
  <!ELEMENT matrix (row+)>
  <!ELEMENT row (cell+)>
  <!ELEMENT cell (#PCDATA|br|formula)*>
  <!ELEMENT br EMPTY>
  <!ELEMENT formula (#PCDATA)>
  <!ATTLIST matrix xmlns CDATA #IMPLIED>
  <!ATTLIST row index CDATA #REQUIRED>
  <!ATTLIST cell colspan CDATA "1" rowspan CDATA "1">
  <!ENTITY nbsp "&#160;">
  <!ENTITY quote "&quot;">
]>
<matrix xmlns="urn:tables:v2" xmlns:x="urn:extra">
  <row index="A">
    <cell colspan="2">left<br/>middle<formula>x &lt; y</formula>&nbsp;</cell>
    <cell rowspan="3">right &quote;</cell>
  </row>
  <row index="B">
    <cell x:flag="yes">one</cell>
    <cell><![CDATA[raw ]]> text <![CDATA[ ]]> tail</cell>
  </row>
</matrix>