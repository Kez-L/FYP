<?xml version="1.0"?>
<!DOCTYPE envelope [
  <!ELEMENT envelope (sender,recipient,body,attachment*)>
  <!ELEMENT sender EMPTY>
  <!ATTLIST sender id ID #REQUIRED>
  <!ELEMENT recipient EMPTY>
  <!ATTLIST recipient ref IDREF #REQUIRED kind (to|cc|bcc) "to">
  <!ELEMENT body (#PCDATA|paragraph|signature)*>
  <!ELEMENT paragraph (#PCDATA|strong|code|break)*>
  <!ELEMENT strong (#PCDATA)>
  <!ELEMENT code (#PCDATA)>
  <!ELEMENT break EMPTY>
  <!ELEMENT signature (#PCDATA)>
  <!ELEMENT attachment EMPTY>
  <!ATTLIST attachment name CDATA #REQUIRED media CDATA #IMPLIED digest CDATA #IMPLIED>
]>
<envelope>
  <sender id="origin-7"/>
  <recipient ref="origin-7" kind="cc"/>
  <recipient ref="missing-target" kind="bcc"/>
  <body>
    Intro <paragraph><strong>Alert</strong><break/>Use <code>&lt;safe&gt;</code>.</paragraph>
    <signature>-- end --</signature>
  </body>
  <attachment name="a&amp;b.bin" media="application/octet-stream" digest=""/>
</envelope>